<drv mrk="glasgov.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc mrk="glasgov.0o.urbo">
    <dif>
      Plej granda <ref tip="lst" lst="voko:urboj" cel="urb.0o.ARKI">urbo</ref>
      de <ref tip="malprt" cel="skot.0lando">Skotlando</ref>, fondita en la 6a jc:
      situo:  (<frm>55&#730;52&minute; N  04&#730;16&minute; W</frm>):
      <ekz>
        la transporta muzeo en <tld/>o
        <fnt>
          <aut>last</aut>
          <vrk><url ref="&Monato;/2008/009648.php">Arta futuro</url></vrk>
          <bib>Monato</bib>
          <lok>2008/12, p. 22</lok>
        </fnt>;
      </ekz>
      <ekz>
        la unua &leftquot;moderna&rightquot; skotgaela romano, <nom>D&ugrave;n &Aacute;luinn</nom>,
        estis eldonita en <tld/>o en 1912
        <fnt>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2003/007935.html">Ne plu krios la koko</url></vrk>
          <bib>Monato</bib>
          <lok>2003/10, p. 16</lok>
        </fnt>;
      </ekz>
      <ekz>
        prezentado de la nostalgia kanto <nom>Lowlands</nom> sub la pontoj de la rivero
        <nom>Clyde</nom> en
        <tld/>o
        <fnt>
          <aut>R&ouml;ssler Franz-Georg</aut>
          <vrk><url ref="&Monato;/2011/010305.php">Skulpta&jcirc;oj kantataj</url></vrk>
          <bib>Monato</bib>
          <lok>2011/04, p. 26</lok>
        </fnt>;
      </ekz>
      <ekz>
        aliaj elektitaj urboj, kiuj la&ubreve; la gvidlibro nepre vidindas, estas Bejruto,
        &Ccirc;ikago, <tld/>o, Lisbono, Meksiko, Sao-Pa&ubreve;lo, &Scirc;anhajo, Varsovio kaj Zuriko
        <fnt>
          <aut>pp</aut>
          <vrk><url ref="&Monato;/2008/009658.php">Antverpeno inter la pintaj 10 urboj</url></vrk>
          <bib>Monato</bib>
          <lok>2008/12, p. 19</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Glasgow</trd>
    <trd lng="en">Glasgow</trd>
    <trd lng="fr">Glasgow</trd>
    <trd lng="zh">&#26684;&#25289;&#26031;&#21733; <pr>g&eacute;l&amacron;s&#299;g&emacron;</pr></trd>
</snc>
