<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: korint.xml,v 1.8 2026/11/04 20:00:21 afido Exp $">
    <kap>
      <rad>Korint</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="korint.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc mrk="korint.0o.GEOG">
    <dif>
      Greka <ref tip="lst" lst="voko:urboj" cel="urb.haven0o">havenurbo</ref> &ccirc;e markolo,
      70 km okcidente de Ateno:
      <ekz>
        li foriris el Ateno kaj alvenis en <tld/>on
        <fnt>
          <bib>NT</bib>
          <lok>La agoj 18:1</lok>
        </fnt>;
      </ekz>
      <ekz>
        anta&ubreve; nelonge mi venis el <tld/>o, kie mi administras la kristanan komunumon
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XVII</lok>
        </fnt>;
      </ekz>
      <ekz>
        la lingvoj de <tld/>o, Lakonio, Sicilio (Sirakuzo)
        <fnt>
          <bib>Ret</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_K;&c_a;&c_r;&c_y;&c_n;&c_f;</trd>
    <trd lng="de">Korinth</trd>
    <trd lng="en">Corinth</trd>
    <trd lng="fr">Corinthe</trd>
    <trd lng="nl">Korinthe</trd>
    <trd lng="pl">Korynt</trd>
    <trd lng="zh">&#21733;&#26519;&#22810; <pr>G&emacron;l&iacute;ndu&#333;</pr></trd>
</snc>
  <trd lng="ca">Corint</trd>
  <trd lng="cv">&c_K;&c_o;&c_r;&c_i;&c_n;&c_f;</trd>
  <trd lng="es">Corinto</trd>
  <trd lng="ja">&#12467;&#12522;&#12531;&#12488;&#12473;</trd>
  <trd lng="oc">Corint</trd>
</drv>

<drv mrk="korint.0a">
  <kap>
    <tld lit="k"/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        la maljuna <nom>Scaurus</nom> <klr>[amas]</klr> sian <tld lit="k"/>an vazon, kiu nokte
        staras apud lia lito
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro I</lok>
        </fnt>;
      </ekz>
      <ekz>
        statuoj <klr>[&#8230;]</klr> el origita <tld lit="k"/>a kupro
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro X</lok>
        </fnt>;
      </ekz>
      <ekz>
        A&hcirc;ajo ne estos perdita, mi ordonos trafosi <tld lit="k"/>an istmon
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XXX</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_y;&c_n;&c_f;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">corinti</trd>
  <trd lng="de">korinthisch</trd>
  <trd lng="nl">korinthisch</trd>
  <trd lng="oc">corintian</trd>
  <trd lng="pl">koryncki</trd>
</drv>

<drv mrk="korint.0ano">
  <kap>
    <tld lit="k"/>ano
  </kap>
  <snc>
    <dif>
      Enlo&gcirc;anto de <tld/>o:
      <ekz>
        multaj <tld/>anoj, a&ubreve;dinte, kredis kaj bapti&gcirc;is
        <fnt>
          <bib>NT</bib>
          <lok>La agoj 18:8</lok>
        </fnt>;
      </ekz>
      <ekz>
        kelkaj kajeroj de la katolika novtestamenta traduko jam aperis: 3 kajeroj kun
        enkonduko, Evangelio la&ubreve; Mateo kaj la du leteroj al la <tld/>anoj
        <fnt>
          <bib>EeP</bib>
          <lok>Dua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_y;&c_n;&c_f;&c_ja;&c_n;&c_ib;&c_n;</trd>
  <trd lng="ca">corinti</trd>
  <trd lng="de">Korinther</trd>
  <trd lng="nl">korinthi&euml;r</trd>
  <trd lng="oc">corintian</trd>
  <trd lng="pl">Koryntczyk</trd>
  <trd lng="zh">&#21733;&#26519;&#26031; <pr>g&emacron;l&iacute;ns&#299;</pr></trd>
</drv>

<drv mrk="korint.0a_ordo">
  <kap>
    <tld/>a ordo
  </kap>
  <snc>
    <dif>
      Stilo (faklingve <ref tip="vid" cel="ord.0o.ARKI">ordo<sncref/></ref>) de
      antikva greka konstruarto kun difinitaj proporcioj, formoj kaj ri&ccirc;aj ornamoj
      de konstrueroj, precipe de kolonoj:
      <ekz>
        la <tld lit="k"/>a ordo <klr>[&#8230;]</klr> diferenci&gcirc;as per precipe ri&ccirc;a dekoracio
        kaj kornico ornamita de du vicoj da akantaj folioj al kiuj sekvas iaj
        helikfiguroj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=267112">Korinta ordo</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_y;&c_n;&c_f;&c_s;&c_k;&c_ib;
  <ind>&c_o;&c_r;&c_d;&c_e;&c_r;</ind></trd>
  <trd lng="ca">ordre corinti</trd>
  <trd lng="cv">&c_k;&c_o;&c_r;&c_i;&c_n;&c_f; &c_o;&c_r;&c_d;&c_je;&c_r;&#1239;</trd>
  <trd lng="de">korinthische Ordnung</trd>
  <trd lng="en">Corinthian order</trd>
  <trd lng="fr">ordre corinthien</trd>
  <trd lng="grc">&Kappa;&omikron;&rho;&jota;&ny;&theta;&jota;&alfa;&kappa;&omikron_ton;&sigma_fina;
  &rho;&ypsilon;&theta;&my;&omikron_ton;&sigma_fina;</trd>
  <trd lng="lat">Ordo Corinthius</trd>
  <trdgrp lng="oc">
    <trd>&ograve;rdre corintian</trd>,
    <trd>ordi corintian</trd>
  </trdgrp>
  <trd lng="pl">porz&aogonek;dek <ind>koryncki</ind></trd>
  <trdgrp lng="zh">
    <trd>&#31185;&#26031;&#26519;&#26609;&#24335; <pr>k&emacron;s&#299;l&iacute;nzh&ugrave;sh&igrave;</pr></trd>,
    <trd>&#31185;&#26519;&#26031;&#26609;&#24335; <pr>k&emacron;l&iacute;ns&#299;zh&ugrave;sh&igrave;</pr></trd>
  </trdgrp>
</drv>
</art>

