<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: piroklast.xml,v 1.1 2026/10/06 06:13:40 afido Exp $">
    <kap>
      <rad>piroklast</rad>/o
    </kap>

<drv mrk="piroklast.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MIN</uzo>
  <snc>
    <dif>
      Rompopeceto (<ref tip="super" cel="klast.0o">klasto</ref>) en
      vulkana sedimento esti&gcirc;inta per <tld/>a fluo, t.e. dispersa&jcirc;o el gasoj kaj solidaj eroj:
      <ekz>
        altaj montoj <klr>[kreitaj]</klr> per alternado de tavoloj de <tld/>oj
        kaj lafaj fluoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=4488"
              >Vulkano</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        en la sekva tago <klr>[&#x2026;]</klr> <tld/>a fluo atingas la murojn de Pompejo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=25494"
              >Pompejo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      <fnt><bib>PIV2</bib></fnt> prezentas sub klasto la radik&scirc;paran terminon vulkanklasto.
      <aut>Wolfram Diestel</aut>
    </rim>
    <trd lng="de">Pyroklast</trd>
    <trd lng="fr">pyroclast</trd>
  </snc>
</drv>

  </art>


