<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: riport.xml,v 1.2 2026/10/26 12:53:10 afido Exp $">
    <kap>
      <rad>riport</rad>/o
    </kap>

<drv mrk="riport.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">TEKS</uzo>
    <dif>
      <ref tip="super" cel="sxablo.0o.TEK">&Scirc;ablono</ref> uzata &ccirc;e teksado
      redonanta la skemon de ripeti&gcirc;anta plekto:
      <ekz>
        por krei <tld/>on de kepra plekto, necesas minimume tri varperoj kaj tri
        vefteroj; tiel ekestas kepro trifadena
        <fnt>
          <aut>Marie Bartovsk&aacute;</aut>
          <vrk><url ref="https://scienca-revuo.info/article/1338"
              >La bazaj teksaj plektoj</url></vrk>
          <lok>Scienca Revuo, n-ro 109-110 (1974)</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/a/a8/Vichykaro_Patrone.png/330px-Vichykaro_Patrone.png"
      prm="CC BY-SA 4.0"
      ><tld/>o por kradita (motivo Vichy) plekto
        <fnt>
          <aut>Madame, propra verko</aut>
          <lok><url ref="&WCW;/File:Vichykaro_Patrone.png"
              >https://commons.wikimedia.org/wiki/File:Vichykaro_Patrone.png</url></lok>
        </fnt>
    </bld>
    <trd lng="da">rapport</trd>
    <trd lng="de">Rapport <klr>(Textil)</klr></trd>
    <trdgrp lng="en">
      <trd>weaving draft</trd>,
      <trd>pattern repeat</trd>
    </trdgrp>
    <trd lng="pt">rapport</trd>
  </snc>
</drv>

  </art>

