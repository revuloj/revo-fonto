<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: uve.xml,v 1.1 2026/11/27 21:36:25 afido Exp $">
    <kap>
      <rad>uve</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="uve.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">ANA</uzo>
  <snc>
    <dif>
      Pigmentita membrano &ccirc;irka&ubreve; la <ref tip="malprt" cel="okul.0o.ANA">okul</ref>globo
      situanta inter sklero kaj retino
      (<trd lng="la">Tunica media bulbi</trd>), konsistanta el koroido, ciliaro kaj  iriso:
      <ekz>
        uveito estas inflamo de la <tld/>o;
      </ekz>
      <ekz>
        ka&ubreve;zo <klr>[de lunblindeco]</klr> povas esti <klr>[&#x2026;]</klr> limfocitoj kaj
        eosinofilaj granulocitoj en la <tld/>o
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=954669"
              >Lunblindeco</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Uvea</trd>,
      <trd>mittlere Augenhaut</trd>
    </trdgrp>
    <trd lng="en">uvea</trd>
    <trd lng="fr">uv&eacute;e</trd>
    <trd lng="ru">&c_s;&c_o;&c_s;&c_u;&c_d;&c_i;&c_s;&c_t;&c_a;&c_ja; &c_o;&c_b;&c_o;&c_l;&c_o;&c_ch;&c_k;&c_a; &c_g;&c_l;&c_a;&c_z;&c_a;</trd>
    <trd lng="uk">&c_s;&c_u;&c_d;&c_i;&c_n;&c_n;&c_a; &c_o;&c_b;&c_o;&c_l;&c_o;&c_n;&c_k;&c_a; &c_o;&c_k;&c_a;</trd>
  </snc>
</drv>

  </art>


