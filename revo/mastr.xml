<drv mrk="mastr.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="mastr.0o.KOMUNE">
    <dif>
      Tiu, kiu posedas, ordonas kaj disponas:
      <ekz>
	bona servisto de bona <tld/>o;
      </ekz><ekz>
	li estas sia propra <tld/>ino
	<klr>(li vivas fra&ubreve;le)</klr>
	<fnt><bib>PrV</bib></fnt>;
      </ekz><ekz>
	hundo fidela al sia <tld/>o;
      </ekz><ekz>
	trezoro sen <tld/>o;
      </ekz><ekz>
        li fari&gcirc;os <tld/>o super la trezoroj de oro, ar&gcirc;ento, kaj &ccirc;iuj
        grandvalora&jcirc;oj de Egiptujo
        <fnt>
          <bib>MT</bib>
          <lok>&Dan; 11:43</lok>
        </fnt>;
      </ekz><ekz>
	Romo fari&gcirc;is <tld/>o de la mondo;
      </ekz><ekz>
        materiala <tld/>o de tiu &ccirc;i lingvo estas la tuta mondo
        <fnt>
          <vrk><url ref="&Viki;/Deklaracio_pri_Esperanto">Deklaracio
          pri la esenco de la Esperantismo de la 9-a de A&ubreve;gusto 1905</url></vrk>
        </fnt>;
      </ekz><ekz>
	la spiritaj <tld/>oj de la lingvo
        <fnt>
          <vrk><url ref="&Viki;/Deklaracio_pri_Esperanto">Deklaracio
          pri la esenco de la Esperantismo de la 9-a de A&ubreve;gusto 1905</url></vrk>
        </fnt>;
      </ekz><ekz>
	la tutan <tld/>econ pri Esperanto <klr>[Zamenhof]</klr> transdonis al
	la esperantistoj mem
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Oka Kongreso Esperantista en Krakovo en
          la 11a de a&ubreve;gusto 1912</vrk>
        </fnt>.
      </ekz>
    </dif>

    <subsnc mrk="mastr.0o.servista">
      <dif>
	Homo havanta <ref cel="serv.0isto">serviston</ref>, rilate al
        tiu servisto:
        <ekz>
          Rekoninte sian junan <tld/>on, kiu staras tute sana fumante
          sian cigaron, la fidela servisto ekpu&scirc;is krion pro miro
          <fnt><bib>KPr</bib></fnt>;
        </ekz><ekz>
          La <tld/>o mortis, la <tld/>ino trovi&gcirc;is en premita situacio,
          la servistino fari&gcirc;is nenecesa
          <fnt><bib>Fab3</bib>, <lok>Juda knabino</lok></fnt>;
        </ekz><ekz>
    	  <tld/>o en vojo, servantoj en &gcirc;ojo
	  <klr>(vd <ref tip="vid" cel="kat.0o">kato</ref>)</klr>
	  <fnt><bib>PrV</bib></fnt>;
        </ekz><ekz>
          &Ccirc;e <tld/>o &scirc;telisto la servantoj ne &scirc;telas
          <fnt><bib>PrV</bib></fnt>.
        </ekz>
      </dif>
      <ref tip="sin" cel="sinjor.0o.mastro">sinjoro<sncref/></ref>
      <trdgrp lng="ru">
        <trd>&c_h;&c_o;&c_z;&c_ja;&c_i;&c_n;</trd>,
        <trd>&c_b;&c_a;&c_r;&c_i;&c_n;</trd>,
        <trd>&c_g;&c_o;&c_s;&c_p;&c_o;&c_d;&c_i;&c_n;</trd>
      </trdgrp>
    </subsnc>

    <subsnc mrk="mastr.0o.butika">
      <dif>
	Estro de hotelo gastejo, komercejo:
        <ekz>
          li trovi&gcirc;is &gcirc;uste anta&ubreve; drinkejo, li volis eniri, sed en la
          sama momento la drinkej<tld/>o volis eliri
          <fnt>
            <bib>Fab4</bib>
            <lok>Kion la patro faras, estas &ccirc;iam &gcirc;usta</lok>
          </fnt>;
        </ekz><ekz>
          la gasto pagis sian kalkulon kaj ku&scirc;i&gcirc;is, la <tld/>o nokte
          &scirc;teliris en la stalon, elkondukis la <klr>[&#8230;]</klr> azenon
          <fnt>
            <bib>ElektFab</bib>
            <lok>Tablo kovru vin, la orazeno kaj bastono el sako</lok>
          </fnt>;
        </ekz><ekz>
          la knabo eniris en gastejon kaj demandis la <tld/>on, &ccirc;u li
          povas akcepti la bestojn por la nokto
          <fnt><bib>ElektFab</bib> <lok>Du fratoj</lok></fnt>;
        </ekz><ekz>
          la lo&gcirc;ejoj de la <tld/>o kaj voja&gcirc;antoj okupis tri eta&gcirc;ojn,
          malsupre estis drinkejo kaj restoracio
          <fnt><bib>Far1</bib> <lok>&Ccirc;apitro 19a</lok></fnt>.
        </ekz>
      </dif>
      <trdgrp lng="de">
        <trd>Wirt</trd>,
        <trd>Ladeninhaber</trd>
      </trdgrp>
      <trd lng="nl">baas</trd>
    </subsnc>
    <subsnc mrk="mastr.0o.fabrika">
      <dif>
	Estro de fabriko a&ubreve; laborejo:
        <ekz>
          la teksa industrio submeti&gcirc;is al la postuloj de la britaj
          <tld/>oj
          celantaj avide profitigi la proprajn teksejojn en
          nord-okcidenta Anglio
          <fnt>
            <bib>Monato</bib>
            <aut>Paul GUBBINS</aut>
            <vrk><url ref="&Monato;/2004/008223.html">&Ccirc;e-telefone
            ... kiu?</url></vrk>
          </fnt>.
        </ekz>
      </dif>
      <trdgrp lng="de">
        <trd>Gesch&auml;ftsf&uuml;hrer</trd>,
        <trd>Betriebswirt</trd>,
        <trd>Fabrikant</trd>
      </trdgrp>
      <trd lng="nl">baas</trd>
    </subsnc>
    <trdgrp lng="nl">
      <trd>heer</trd>,
      <trd>meester</trd>
    </trdgrp>
