<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: furi.xml,v 1.27 2026/08/12 03:08:03 revo Exp $">
<kap>
<ofc>1</ofc>
<rad>furi</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="furi.0o">
  <kap><tld/>o</kap>
  <snc mrk="furi.0o.MIT">
    <uzo tip="fak">MIT</uzo>
    <dif>
      Infera <ref tip="super" cel="di.0ino">diino</ref> de ven&gcirc;o:
      <ekz>
        la tri <tld/>oj;
      </ekz>
      <ekz>
        li kurlevas sin nokte, certigante, ke lin pelas <tld lit="F"/>oj
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XVIII</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;ian spiriton kaptis mallumaj <tld/>oj, elkovi&gcirc;intaj sur la fundo de &scirc;ia
        ribeli&gcirc;inta interno
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        mortigo! tuta infero da <tld/>oj flugas &ccirc;irka&ubreve; tiu &ccirc;i vorto
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Kvara</lok>
        </fnt>!
      </ekz>
      <ekz>
        mi atakos, bato post bato, skuo post skuo, tiun &ccirc;i kadukan vivon, &gcirc;is venos la
        lasta el la anaro da <tld/>oj, la malespero
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>!
      </ekz>
     </dif>
    <trd lng="ca">f&uacute;ria<klr tip="amb"> (mitologia)</klr></trd>
    <trd lng="pt">F&uacute;ria</trd>
  </snc>
  <snc mrk="furi.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Furioza <ref tip="super" cel="vir.0ino">virino</ref>:
      <ekz>
        ni ofte fari&gcirc;as <tld/>oj ka&ubreve;ze de nia dezirego de amo
        <fnt>
          <bib>Marta</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        lia edzino, kiu estis furioze &jcirc;aluza, senkompate batis min &ccirc;iutage, &scirc;i estis ia
        <tld/>o
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro XXIV</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">f&uacute;ria<klr tip="amb"> (fig.)</klr></trd>
      <trdgrp lng="pt">
      <trd>f&uacute;ria</trd>,
      <trd>mulher furiosa</trd>,
    </trdgrp>
  </snc>
  <adm>
    Uskleco. <aut>MB</aut>
  </adm>
  <trd lng="be">&c_f;&c_u;&c_r;&c_y;&c_ja;</trd>
  <trdgrp lng="cs">
    <trd>f&uacute;rie</trd>,
    <trd>l&iacute;tice</trd>,
    <trd>sa&ncaron;</trd>,
    <trd>zl&aacute; &zcaron;ena</trd>
  </trdgrp>
  <trd lng="de">Furie</trd>
  <trdgrp lng="en">
    <trd>fury</trd>,
    <trd>goddess of vengeance</trd>
  </trdgrp>
  <trd lng="es">furia</trd>
  <trd lng="fr">furie<klr tip="ind"> (divinit&eacute;, personne
  furieuse)</klr></trd>
  <trd lng="hu">f&uacute;ria</trd>
  <trdgrp lng="ja">
    <trd>&#x5FA9;&#x8B90;&#x306E;&#x5973;&#x795E;  <pr>&#x3075;&#x304F;&#x3057;&#x3085;&#x3046;&#x306E;&#x3081;&#x304C;&#x307F;</pr></trd>,
    <trd>&#x72C2;&#x66B4;&#x306A;&#x5973;  <pr>&#x304D;&#x3087;&#x3046;&#x307C;&#x3046;&#x306A;&#x304A;&#x3093;&#x306A;</pr></trd>,
    <trd>&#x9B3C;&#x5973;  <pr>&#x304D;&#x3058;&#x3087;</pr></trd>
  </trdgrp>
  <trd lng="nl">furie</trd>
  <trd lng="pl">furia</trd>
  <trd lng="ro">furie</trd>
  <trd lng="ru">&c_f;&c_u;&c_r;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>f&uacute;ria</trd>,
    <trd>zl&aacute; &zcaron;ena</trd>
  </trdgrp>
  <trd lng="uk">&c_f;&c_u;&c_r;&c_ib;&c_ja;</trd>
</drv>
</art>
