<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: nandin.xml,v 1.11 2026/09/14 19:19:05 revo Exp $">
<kap>
  <rad>nandin</rad>/o <fnt><bib>NePiv</bib></fnt>
</kap>

<drv mrk="nandin.0o">
  <kap><tld/>o</kap>
  <snc mrk="nandin.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      &Ccirc;iamverda <ref tip="super" cel="arb.0o.BOT">arbeto</ref> el
      Hindujo, &Ccirc;inujo, Japanujo,
      kun plumformaj folioj, blankaj-flavaj floroj, ru&gcirc;aj
      globofruktetoj,
      unuspecia genro el familio berberisacoj
      (<trd lng="la">Nandina domestica</trd>):
      <ekz>
        oni kune metis pinon, bambuon, umeon, <tld/>on kaj ornambrasikon
        en unu poto
        <fnt>
        <aut>Vastalto</aut>,
        <vrk><url ref="http://www.vastalto.com/blog/">Akvosfero</url></vrk>,
        <lok>Pinornamoj por la nova jaro, 2005-12-25</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/7/7b/Ranunculales_-_Nandina_domestica_3.jpg/500px-Ranunculales_-_Nandina_domestica_3.jpg"
      prm="CC BY-SA 2.5"
      >bran&ccirc;oj kun bur&gcirc;onoj kaj fruktoj de <tld/>o (Nandina domestica)
        <fnt>
          <aut>Em&odblac;ke D&eacute;nes</aut>
          <lok><url ref="&WCW;/File:Ranunculales_-_Nandina_domestica_3.jpg"
              >https://commons.wikimedia.org/wiki/File:Ranunculales_-_Nandina_domestica_3.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_n;&c_a;&c_n;&c_d;&c_y;&c_n;&c_a;</trd>
  <trd lng="ca">nandina</trd>
  <trdgrp lng="de">
    <trd>Himmelsbambus</trd>,
    <trd>Nandine</trd>
  </trdgrp>
  <trd lng="fa">&a_n;&f_y; &a_m;&a_q;&a_d;&a_s;</trd>
  <trd lng="fr">nandina<klr tip="amb"> (bot.)</klr></trd>
  <trd lng="ja">&#x30CA;&#x30F3;&#x30C6;&#x30F3;</trd>
  <trd lng="nl">hemelse bamboe</trd>
  <trd lng="pl">nandina domowa</trd>
  <trd lng="pt">nandina</trd>
  <trd lng="ro">acas&abreve; nandina</trd>
  <trdgrp lng="zh">
    <trd>&#x5357;&#x5929;&#x7AFA; <pr>n&aacute;nti&amacron;nzh&uacute;</pr></trd>,
    <trd>&#x5357;&#x5929;&#x7AF9; <pr>n&aacute;nti&amacron;nzh&uacute;</pr></trd>,
    <trd>&#x5357;&#x5929;&#x7AF9;&#x5C5E; <pr>n&aacute;nti&amacron;nzh&uacute;sh&#x1D4;</pr></trd>,
    <trd>&#x5357;&#x5929;&#x7AF9;&#x5C6C; <pr>n&aacute;nti&amacron;nzh&uacute;sh&#x1D4;</pr></trd>
  </trdgrp>
</drv>
</art>

