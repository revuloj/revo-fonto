<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: kirilic.xml,v 1.7 2026/10/29 20:00:20 afido Exp $">
    <kap>
      <rad>Kirilic</rad>/o
    </kap>

<drv mrk="kirilic.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">LIN</uzo>
  <snc mrk="kirilic.0o.alfabeto">
    <dif>
      La <ref cel="ciril.0a">cirila</ref> <ref tip="super" cel="alfabe.0o">alfabeto</ref>,
      esti&gcirc;inta en la 10a jarcento &ccirc;e la kortego de la
      bulgara caro en Preslavo kaj uzata nuntempe en multnombraj
      orient- kaj sudslavaj lingvoj:
      <ekz>
        <tld/>o estas, maldetale, la mezgreka alfabeto kompletigita por la bezonoj de
        la slava fonetiko dum Glagolico &scirc;ajnas intence eviti ion ajn similan al la
        alfabeto greka (a&ubreve; Latina)
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 1 (51)</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o devenas rekte el la greka kaj hebrea, dum inter la Latina kaj la
        greka ni trovas la etruskan, kiu iom konfuzis la literojn
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 4 (54)</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>kyrillisches Alphabet</trd>,
      <trd>Kyrilliza</trd>
    </trdgrp>
    <trd lng="en">Cyrillic script</trd>
    <trd lng="fr">alphabet cyrillique</trd>
    <trd lng="pl">Cyrylica</trd>
    <trdgrp lng="zh">
    <trd>&#20420;&#35486;&#23383;&#27597; <pr>&eacute;y&#468;z&igrave;m&#468;</pr></trd>,
    <trd>&#35199;&#35041;&#29246;&#23383;&#27597;
    <pr>x&#299;l&#464;&ecaron;rz&igrave;m&#468;</pr></trd>,
    <trd>&#35199;&#37324;&#23572;&#23383;&#27597;
    <pr>X&#299;l&#464;&ecaron;rz&igrave;m&#468;</pr></trd>
  </trdgrp>
</snc>
<trdgrp lng="be">
  <trd>&c_k;&c_ib;&c_r;&c_y;&c_l;&c_ib;&c_c;&c_a;</trd>,
  <trd>&c_k;&c_ib;&c_r;&c_y;&c_l;&c_ib;&c_ch;&c_n;&c_y;
  &c_a;&c_l;&c_mol;&c_f;&c_a;&c_b;&c_e;&c_t;</trd>,
  <trd>&c_k;&c_ib;&c_r;&c_y;&c_l;&c_ib;&c_ch;&c_n;&c_a;&c_ja; &c_a;&c_z;&c_b;&c_u;&c_k;&c_a;</trd>,
  <trd>&c_k;&c_ib;&c_r;&c_y;&c_l;&c_ib;&c_ch;&c_n;&c_a;&c_je;
  &c_p;&c_ib;&c_s;&c_mol;&c_m;&c_o;</trd>
</trdgrp>
  <trd lng="ca">alfabet cir&iacute;l&middot;lic</trd>
  <trd lng="es">alfabeto cir&iacute;lico</trd>
</drv>
</art>

