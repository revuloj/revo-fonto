<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: makiav.xml,v 1.20 2026/09/20 18:45:00 revo Exp $">
<kap>
  <rad>makiavel</rad>/a
  <fnt><bib>PVEF</bib></fnt>
</kap>

<drv mrk="makiav.M0o">
  <kap>
    <tld lit="M"/>o
  </kap>
  <uzo tip="fak">PERS</uzo>
  <snc mrk="makiav.M0o.PERS">
    <dif>
      Nikolo <tld lit="M"/>o (itale: <trd lng="it">Niccol&ograve; di Bernardo dei Machiavelli</trd>,
      1469 - 1527), itala <ref tip="lst" lst="voko:historiaj_personoj"
      cel="diplom1.0o">diplomato</ref>, a&ubreve;toro de &leftquot;La Princo&rightquot;, politika manlibro
      pri apliko de potenco:
      <ekz>
        mi timas, ke nenio de Makiavelo estas en mi
        <fnt>
          <aut>A. E. van Vogt, trad. Geo</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/9995/0027.php"
              >La Interplaneda Misio</url></vrk>
          <lok>&Ccirc;apitro XXVII</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Machiavelli</trd>
  <trd lng="en">Machiavelli</trd>
  <trd lng="fr">Machiavel</trd>
</drv>

<drv mrk="makiav.0a">
  <kap>
    <tld/>a
  </kap>
  <snc mrk="makiav.0a.senskrupula">
    <dif>
      Strebanta al potenco sen atento pri moralo,
      aganta sen skrupuloj:
      <ekz>
        &scirc;i komencis la abomenan efektivigon de <tld/>a plano, nome, iom
        post iom veneni
        la malfeli&ccirc;an izoli&gcirc;intan konkurantinon
        <fnt>
          <aut>Francisco C&acirc;ndido Xavier, trad. L. C. Porto Carreiro
          Neto</aut>
          <vrk><url ref="https://www.febnet.org.br/ba/file/livro%20em%20esperanto/Antauxdumiljaroj.pdf">Anta&ubreve;&nbsp;du Mil Jaroj</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        kadre de kompleksa agadplano, sagaca a&ubreve; <tld/>a la&ubreve; la
        vidpunkto, la turka
        prezidanto <nom>Recep Tayyip Erdogan</nom> konsentis multigi la
        marajn patrolojn
        <fnt>
          <aut>Hans Kundnani , Astrid Ziebarth</aut>
          <vrk><url ref="http://neniammilitointerni.over-blog.com/2017/01/februaro-2017-le-monde-diplomatique-en-esperanto.html">Inter Germanujo kaj Turkujo, la demando pri
              rifu&gcirc;intoj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="skrupu.sen0a">senskrupula</ref>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_k;&c_ib;&c_ja;&c_v;&c_e;&c_l;&c_ib;&c_je;&c_w;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">maquiav&egrave;l&middot;lic</trd>
  <trdgrp lng="de">
    <trd>machiavellistisch</trd>,
    <trd>v&ouml;llig <ind>skrupellos</ind></trd>
  </trdgrp>
  <trd lng="en">Machiavellian</trd>
  <trd lng="fr">maquiav&eacute;lique</trd>
  <trdgrp lng="hu">
    <trd>machiavellis</trd>,
    <trd>machiavellisztikus</trd>,
    <trd>g&aacute;tl&aacute;stalan</trd>
    <trd>k&iacute;m&eacute;letlen</trd>,
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30DE;&#x30AD;&#x30A2;&#x30D9;&#x30EA;&#x7684;&#x306A; <pr>&#x30DE;&#x30AD;&#x30A2;&#x30D9;&#x30EA;&#x3066;&#x304D;&#x306A;</pr></trd>,
    <trd>&#x6A29;&#x8B00;&#x8853;&#x6570;&#x306E; <pr>&#x3051;&#x3093;&#x307C;&#x3046;&#x3058;&#x3085;&#x3063;&#x3059;&#x3046;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="nl">machiavellistisch</trd>
  <trdgrp lng="pl">
    <trd>machiawelski</trd>,
    <trd>przebieg&lstroke;y</trd>,
    <trd>podst&eogonek;pny</trd>
  </trdgrp>
  <trd lng="pt">maquiav&eacute;lico</trd>
  <trdgrp lng="ro">
    <trd>viclean</trd>,
    <trd>insidios</trd>
  </trdgrp>
  <trd lng="ru">&c_m;&c_a;&c_k;&c_i;&c_a;&c_v;&c_je;&c_l;&c_l;&c_i;&c_je;&c_v;&c_s;&c_k;&c_i;&c_j;</trd>
  <trdgrp lng="uk">
    <trd>&c_m;&c_a;&c_k;&c_ib;&c_a;&c_v;&c_je;&c_l;&c_l;&c_ib;&c_v;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>,
    <trd>&c_v;&c_ib;&c_r;&c_o;&c_l;&c_o;&c_m;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_p;&c_ib;&c_d;&c_s;&c_t;&c_u;&c_p;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
</drv>
</art>
