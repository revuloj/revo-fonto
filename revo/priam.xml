<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: priam.xml,v 1.1 2026/10/19 13:00:59 afido Exp $">
    <kap>
      <rad>Priam</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="priam.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">MIT</uzo>
    <dif>
      Re&gcirc;o de <ref tip="malprt" cel="troj.0o">Trojo</ref> dum la trojaj militoj:
      <ekz>
        Orfe ku&scirc;os ruste la armilo, &parsl; Mortos for la gento de <tld/>o
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>!
      </ekz>
      <ekz>
        l&#x2019; infera Pirro ser&ccirc;as nun <tld/>on
        <fnt>
          <bib>Hamlet</bib>
          <lok>Hamleto</lok>
        </fnt>;
      </ekz>
      <ekz>
        li enviis <tld/>on kaj nomis lin feli&ccirc;ulo tial &gcirc;uste, ke li povis rigardi la
        brulegon kaj pereon de sia naski&gcirc;a urbo
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XXXVIII</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Priamos</trd>
    <trd lng="en">Priam</trd>
    <trd lng="fr">Priam</trd>
    <trd lng="grc">&Pi;&rho;&jota_ton;&alfa;&my;&omikron;&sigma_fina;</trd>
    <trd lng="ru">&c_P;&c_r;&c_i;&c_a;&c_m;</trd>
  </snc>
</drv>

  </art>


