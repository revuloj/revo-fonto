<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: pikl.xml,v 1.1 2026/10/07 08:35:58 afido Exp $">
    <kap>
      <rad>pikl</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="pikl.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KUI</uzo>
  <snc>
    <dif>
      Legompeco a&ubreve; frukto konservita en vinagro kun spicoj:
      <ekz>
        rakledo kun terpomoj kaj <tld/>oj
        <fnt>
          <vrk><url ref="http://mulhouse.esperanto.free.fr/unikodo/zf2008.htm"
              >la 13an de decembro 2008</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        <ind>miksitaj <tld/>oj</ind> estas acideta alman&gcirc;a&jcirc;o el diversaj fruktoj kaj legomoj kiuj
        estas marinitaj kun kapsikoj kaj aliaj spicoj en akregusta vinagro
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=460238"
              >Miksitaj pikloj</url></lok>
        </fnt>;
        <trdgrp lng="de">
          <trd>Mixed Pickles</trd>
          <trd>Pickles</trd>
          <trd>sauer eingelegtes <ind>Gem&uuml;se</ind></trd>
        </trdgrp>
        <trd lng="en">mixed pickles</trd>
      </ekz>
      <ekz>
        odoro de hamburgero <klr>[&#x2026;]</klr>, li preska&ubreve; povas gusti la sukoplenan viandon
        kun <tld/>oj kaj froma&gcirc;o kaj ke&ccirc;upo
        <fnt>
          <aut>Myrtis Smith</aut>
          <vrk><url ref="https://libro.ee/file.php?id=4426"
              >Malpura Hamburgero</url></vrk>
          <lok>Easy Esperanto Reader</lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      Ne konfuzu kun <ref cel="pekl.0ajxo">pekla&jcirc;o</ref>, t.e. io konservita per salo (ne per vinagro).
    </rim>
    <trd lng="de">in Essig <ind>Eingelegtes</ind></trd>
    <trd lng="en">pickle</trd>
    <trd lng="fr"><ind>cornichon</ind> etc.</trd>
  </snc>
</drv>

  </art>


