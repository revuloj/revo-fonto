<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: led.xml,v 1.31 2026/11/03 20:00:20 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>led</rad>/o
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="led.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="led.0o.LED">
    <dif>
      Felo preparita por industriaj uzoj: &scirc;uoj, rimenoj kaj aliaj:
      <ekz>
        el fremda <tld/>o oni tran&ccirc;as lar&gcirc;e
        <klr>(oni estas malavara se oni ne pagas la kostojn.
        <ref tip="vid" cel="posx.0o">po&scirc;o</ref>)</klr>
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="fel.0o">felo</ref>,
      <ref cel="hauxt.0o">ha&ubreve;to</ref>,
      <ref cel="pelt.0o">pelto</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_s;&c_k;&c_u;&c_r;&c_a;
  <klr>(&c_v;&c_y;&c_r;&c_a;&c_b;&c_l;&c_je;&c_n;&c_a;&c_ja;)</klr></trd>
  <trd lng="bg">&c_k;&c_o;&c_zh;&c_a;</trd>
  <trd lng="bo">&t_ka;&t_naro;&t_tsheg;&t_ba;&t_tsheg;</trd>
  <trd lng="br">l&ecirc;r</trd>
  <trdgrp lng="ca">
    <trd>cuir</trd>,
    <trd>cuiro</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>k&uring;&zcaron;e vy&ccaron;in&ecaron;n&aacute;</trd>,
    <trd>use&ncaron;</trd>
  </trdgrp>
  <trd lng="de">Leder</trd>
  <trd lng="el">&delta;&epsilon_ton;&rho;&my;&alfa;</trd>
  <trd lng="en">leather</trd>
  <trd lng="es">cuero</trd>
  <trd lng="fr">cuir</trd>
  <trd lng="hu">b&odblac;r <klr>(kidolgozott)</klr></trd>
  <trd lng="id">kulit<klr> (yg disamak)</klr></trd>
  <trd lng="it">cuoio</trd>
  <trdgrp lng="ja">
    <trd>&#12394;&#12417;&#12375;&#38761;  <pr>&#12394;&#12417;&#12375;&#12364;&#12431;</pr></trd>,
    <trd>&#38761;  <pr>&#12388;&#12367;&#12426;&#12363;&#12431;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>leder</trd>,
    <trd>leer</trd>
  </trdgrp>
  <trd lng="pl">sk&oacute;ra <klr tip="amb">wyprawiona</klr></trd>
  <trd lng="pt">couro</trd>
  <trd lng="ru">&c_k;&c_o;&c_zh;&c_a;
  <klr>(&c_v;&c_y;&c_d;&c_je;&c_l;&c_a;&c_n;&c_n;&c_a;&c_ja;)</klr></trd>
  <trd lng="sk">ko&zcaron;a <klr>(vypracovan&aacute;)</klr> reme&ncaron;</trd>
  <trd lng="uk">&c_sh;&c_k;&c_ib;&c_r;&c_a; (&c_v;&c_i;&c_r;&c_o;&c_b;&c_l;&c_je;&c_n;&c_a;)</trd>
  <trdgrp lng="zh">
    <trd>&#30382;&#38761; <pr>p&iacute;g&eacute;</pr></trd>,
    <trd>&#30382; <pr>p&iacute;</pr></trd>,
    <trd>&#38761; <pr>g&eacute;</pr></trd>,
    <trd>&#38859; <pr>w&eacute;i</pr></trd>,
    <trd>&#38886; <pr>w&eacute;i</pr></trd>,
    <trd>&#38841; <pr>ku&ograve;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="led.grajno0o">
  <kap>grajno<tld/>o</kap>
  <snc mrk="led.grajno0o.LED">
    <dif>
      Malglata <tld/>o, kvaza&ubreve; kovrita per grajnoj:
      <ekz>
        &scirc;i &jcirc;etis anta&ubreve; si <klr>[&#8230;]</klr> sakon el grajno<tld/>o, kiun &scirc;i portis
        &scirc;ultrozone
        <fnt>
          <aut>E. About, trad. G. Moch</aut>
          <vrk><url ref="&Gutenberg;files/65835/65835-0.txt">La Re&gcirc;o de la Montoj</url></vrk>
          <lok>1909</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_sh;&c_ch;&c_y;&c_g;&c_r;&c_y;&c_n;</trd>
  <trd lng="ca">xagr&iacute;</trd>
  <trd lng="cs">zrnit&aacute; k&uring;&zcaron;e</trd>
  <trd lng="de">Chagrinleder</trd>
  <trdgrp lng="fr">
    <trd>cuir grenu</trd>,
    <trd>chagrin<klr tip="ind"> (cuir)</klr></trd>
  </trdgrp>
  <trd lng="hu">szemcs&eacute;s <ind>b&odblac;r</ind></trd>
  <trdgrp lng="ja">
    <trd>&#31890;&#36215;&#12394;&#12417;&#12375;&#38761;  <pr>&#12388;&#12406;&#12362;&#12371;&#12394;&#12417;&#12375;&#12364;&#12431;</pr></trd>,
    <trd>&#12471;&#12515;&#12464;&#12522;&#12540;&#12531;</trd>
  </trdgrp>
  <trd lng="nl">chagrijnleer</trd>
  <trdgrp lng="pl">
    <trd>sk&oacute;ra <klr tip="amb">licowa</klr></trd>,
    <trd>zamsz</trd>
  </trdgrp>
  <trd lng="pt">chagr&eacute;m</trd>
  <trdgrp lng="ru">
    <trd>&c_sh;&c_a;&c_g;&c_r;&c_je;&c_n;&c_je;&c_v;&c_a;&c_ja; &c_k;&c_o;&c_zh;&c_a;</trd>,
    <trd>&c_sh;&c_a;&c_g;&c_r;&c_je;&c_n;&c_mol;</trd>
  </trdgrp>
  <trd lng="sk">zrnit&aacute; ko&zcaron;a <klr>(&scaron;agr&eacute;n)</klr></trd>
</drv>
</art>
