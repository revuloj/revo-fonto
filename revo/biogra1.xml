<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: biogra1.xml,v 1.32 2026/08/14 13:59:44 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>biografi</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="biogra1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BELE</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="verk.0o.propra">Verko</ref>
      rakontanta pri la tuta vivo de iu persono:
      <ekz>
        mi anka&ubreve; legas <klr>[&#x2026;]</klr> <tld/>ojn de gloraj artistoj tiaj, kiaj Rafaelo,
        Mi&hcirc;aelo-Angelo
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>;
      </ekz>
      <ekz>
        leginda ampleksa <tld/>o <klr>[&#x2026;]</klr> de la
        a&ubreve;toro
        <fnt>
          <aut>Franz-Georg R&ouml;ssler</aut>:
          <vrk>Profite voja&gcirc;u kun Edwin</vrk>
          <bib>Monato</bib>
          <lok>1994/06, p. 21</lok>
        </fnt>;
      </ekz>
      <ekz>
        iam en lia <tld/>o estu skribitaj la jenaj vortoj: &leftquot;filo de simpla regimenta
        kuracisto, kiu tamen frue divenis lin kaj &scirc;paris nenion por lia eduko&rightquot;
        <fnt>
          <bib>PatrojFiloj</bib>
          <lok>XXI</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="biogra.0o">biografo</ref>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>vivpriskribo</ke>,
    <ke><ref cel="histor.viv0o">vivhistorio</ref></ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_b;&c_ib;&c_ja;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja;</trd>,
    <trd>&c_zh;&c_y;&c_c;&c_mol;&c_c;&c_ja;&c_p;&c_ib;&c_s;</trd>
  </trdgrp>
  <trd lng="bg">&c_b;&c_i;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trd lng="bo">&t_ra;&t_nata;&t_ma;&t_tsheg;&t_tha;&t_ra;&t_tsheg;</trd>
  <trd lng="ca">biografia</trd>
  <trdgrp lng="cs">
    <trd>biografie</trd>,
    <trd>&zcaron;ivotopis</trd>
  </trdgrp>
  <trd lng="de">Biografie</trd>
  <trd lng="en">biography</trd>
  <trd lng="es">biograf&iacute;a</trd>
  <trdgrp lng="fa">
    <trd>&a_z;&a_n;&a_d;&f_g;&f_y;&zwnj;&a_n;&a_A;&a_m;&a_h;</trd>,
    <trd>&a_sh;&a_r;&a_H; &a_H;&a_A;&a_l;<klr tip="ind"> (&a_z;&a_n;&a_d;&f_g;&f_y;&zwnj;&a_n;&a_A;&a_m;&a_h;)</klr></trd>,
    <trd>&a_b;&f_y;&a_w;&f_g;&a_r;&a_A;&a_f;&f_y;</trd>
  </trdgrp>
  <trd lng="fr">biographie</trd>
  <trd lng="he">&bet;&yod;&vav;&gimel;&resh;&pe;&yod;&he;</trd>
  <trdgrp lng="hu">
    <trd>&eacute;letrajz</trd>,
    <trd>biogr&aacute;fia</trd>
  </trdgrp>
  <trd lng="id">biografi</trd>
  <trd lng="ja">&#x4F1D;&#x8A18;  <pr>&#x3067;&#x3093;&#x304D;</pr></trd>
  <trd lng="nl">biografie</trd>
  <trd lng="pl">biografia</trd>
  <trd lng="ru">&c_b;&c_i;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>biografia</trd>,
    <trd>&zcaron;ivotopis</trd>
  </trdgrp>
  <trd lng="uk">&c_b;&c_ib;&c_o;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja;</trd>
</drv>

<drv mrk="biogra1.mem0o">
  <kap>mem<tld/>o</kap>
  <uzo tip="fak">BELE</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="verk.0o.propra">Verko</ref>
      rakonta pri la propra vivo de la verkinto:
      <ekz>
        la nova libro de <nom>Stefan Maul</nom> ne estas mem<tld/>o &ndash; almena&ubreve; tion li mem asertas
        <fnt>
          <bib>Monato</bib>
          <aut>Kalle Kniivil&auml;</aut>
          <vrk><url ref="&Monato;/2006/008869.php"
              >Idealismaj rebriletoj malanta&ubreve; la skeptika fasado</url></vrk>
          <lok>2006</lok>
        </fnt>;
      </ekz>
      <ekz>
        aperis la mem<tld/>o de <nom>Edson Arantes do Nascimiento</nom>, fama brazila futbalisto
        <fnt>
          <bib>EeP</bib>
          <lok>Dua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="sin">
      <ref cel="auxtob.0o">a&ubreve;tobiografio</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_a;&c_w;&c_t;&c_a;&c_b;&c_ib;&c_ja;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja;</trd>
  <trd lng="bg">&c_a;&c_v;&c_t;&c_o;&c_b;&c_i;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trd lng="ca">autobiografia</trd>
  <trd lng="cs">vlastn&iacute; &zcaron;ivotopis</trd>
  <trd lng="de">Autobiografie</trd>
  <trd lng="en">autobiography</trd>
  <trd lng="es">autobiograf&iacute;a</trd>
  <trdgrp lng="fa">
    <trd>&a_kh;&a_w;&a_d;&a_z;&a_n;&a_d;&f_g;&f_y;&zwnj;&a_n;&a_A;&a_m;&a_h;</trd>,
    <trd>&a_H;&a_s;&a_b; &a_H;&a_A;&a_l;</trd>,
    <trd>&a_A;&a_t;&a_w;&a_b;&f_y;&a_w;&f_g;&a_r;&a_A;&a_f;&f_y;</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>autobiographie</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>&ouml;n&eacute;letrajz</trd>,
    <trd>autobiogr&aacute;fia</trd>
  </trdgrp>
  <trd lng="id">autobiografi</trd>
  <trd lng="ja">&#x81EA;&#x4F1D;  <pr>&#x3058;&#x3067;&#x3093;</pr></trd>
  <trd lng="nl">autobiografie</trd>
  <trd lng="pl">autobiografia</trd>
  <trd lng="ru">&c_a;&c_v;&c_t;&c_o;&c_b;&c_i;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>autobiografia</trd>,
    <trd>vlastn&yacute; &zcaron;ivotopis</trd>
  </trdgrp>
  <trd lng="uk">&c_a;&c_v;&c_t;&c_o;&c_b;&c_ib;&c_o;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja;</trd>
</drv>
</art>
