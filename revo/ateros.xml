<vortaro>
<art mrk="$Id: ateros.xml,v 1.1 2026/11/08 16:41:10 afido Exp $">
<kap>
    <rad>ateroskleroz</rad>/o <fnt><bib>PIV3</bib></fnt>
</kap>
<drv mrk="ateros.0o">
  <kap><tld/>o</kap>
  <snc mrk="ateros.0o.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      malsano, en kiu graso akumuli&gcirc;as en la vejnoj kaj arterioj, obstrukciante la sangofluon
      <ekz>
        la precipaj ka&ubreve;zoj de <tld/>o  estas uzado de granda kvanto da animalaj grasoj,
        malmovi&gcirc;emeco, malutilaj kutimoj, heredeco
       <fnt>
        <aut>Vladimir Lemelev</aut>
        <vrk><url ref="&Monato;/2000/007245.html">Mikroboj provokas neinfektajn malsanojn &scirc;an&gcirc;i&gcirc;i al
        infektaj</url></vrk>
        <bib>Monato</bib>
        <lok>2000/01, p. 16</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Atherosklerose</trd>
  <trd lng="en">atherosclerosis</trd>
  <trd lng="fr">ath&eacute;roscl&eacute;rose</trd>
  <trdgrp lng="nl">
    <trd>atherosclerose</trd>,
    <trd>aderverkalking</trd>
  </trdgrp>
  <trd lng="ro">ateroscleroz&abreve;</trd>
</drv>
</art>


