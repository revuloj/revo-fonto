<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: granit.xml,v 1.31 2026/09/25 17:31:35 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>granit</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="granit.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="granit.0o.MIN">
    <uzo tip="fak">MIN</uzo>
    <dif>
      Tre malmola erupcia <ref tip="super" cel="rok.0ajxo.GEOL">roka&jcirc;o</ref> konsistanta el miksa&jcirc;o da glimo,
      kvarco kaj feldspato:
      <ekz>
        minejoj de <tld/>o kaj sienito
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro X</lok>
        </fnt>;
      </ekz>
      <ekz>
        tri leonoj pasantaj skulptitaj en la <tld/>o
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Kvina</lok>
        </fnt>;
      </ekz>
      <ekz>
        la monto <klr>[&#x2026;]</klr> konsistis el &scirc;tono simila al <tld/>o
        <fnt><bib>DOz</bib>, <lok>&leftquot;la valo de vo&ccirc;oj&rightquot;</lok></fnt>.
      </ekz>
      <ekz>
        via memoro estas kiel la <tld/>o, sur kiu ni skribas la historion
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="sub" cel="grejs.0o.granito">grejso<sncref/></ref>
    <refgrp tip="vid">
      <ref cel="gnejs.0o">gnejso</ref>
    </refgrp>
    <bld
      lok="&WCU;/thumb/7/71/Bianco_Sardo_Granit_mit_polierter_Oberfl&auml;che.jpg/500px-Bianco_Sardo_Granit_mit_polierter_Oberfl&auml;che.jpg"
      prm="CC BY-SA 4.0"
      >polurita surfaco de <tld/>o (blanka - feldspato, diafane griza - kvarco)
        <fnt>
          <aut>The stone gate, propra verko</aut>
          <lok><url ref="&WCW;/File:Bianco_Sardo_Granit_mit_polierter_Oberfl%C3%A4che.jpg"
              >https://commons.wikimedia.org/wiki/File:Bianco_Sardo_Granit_mit_polierter_Oberfl&auml;che.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="en">granite <klr>(mineralogy)</klr></trd>
  </snc>
  <trd lng="be">&c_g;&c_r;&c_a;&c_n;&c_ib;&c_t;</trd>
  <trd lng="ca">granit</trd>
  <trdgrp lng="cs">
    <trd>granit</trd>,
    <trd>&zcaron;ula</trd>
  </trdgrp>
  <trd lng="de">Granit</trd>
  <trd lng="es">granito</trd>
  <trdgrp lng="fr">
    <trd>granit</trd>,
    <trd>granite</trd>
  </trdgrp>
  <trd lng="hu">gr&aacute;nit</trd>
  <trdgrp lng="ja">
    <trd>&#x82B1;&#x5D17;&#x5CA9;  <pr>&#x304B;&#x3053;&#x3046;&#x304C;&#x3093;</pr></trd>,
    <trd>&#x5FA1;&#x5F71;&#x77F3;  <pr>&#x307F;&#x304B;&#x3052;&#x3044;&#x3057;</pr></trd>
  </trdgrp>
  <trd lng="nl">graniet</trd>
  <trd lng="pl">granit</trd>
  <trd lng="pt">granito</trd>
  <trd lng="ro">granit</trd>
  <trd lng="ru">&c_g;&c_r;&c_a;&c_n;&c_i;&c_t;</trd>
  <trd lng="sk">&zcaron;ula</trd>
  <trd lng="sv">granit</trd>
  <trd lng="tr">granit</trd>
  <trd lng="uk">&c_gu;&c_r;&c_a;&c_n;&c_ib;&c_t;</trd>
  <trdgrp lng="zh">
    <trd>&#x82B1;&#x5C97;&#x5CA9; <pr>hu&amacron;g&#x1CE;ngy&aacute;n</pr></trd>,
    <trd>&#x82B1;&#x5C97;&#x5CA9; <pr>hu&amacron;g&amacron;ngy&aacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="granit.0a">
  <kap><tld/>a</kap>
  <snc mrk="granit.0a.MIN">
    <dif>
      El <tld/>o:
      <ekz>
        <tld/>aj pavimeroj, muroj;
      </ekz>
      <ekz>
        <klr>[jen]</klr> &scirc;tonoj kalkaj, sablaj kaj <tld/>aj
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        <ctl>Sur kampo <tld/>a</ctl>
        <klr>(romano de <nom>Nemere Istv&aacute;n</nom>)</klr>
        <fnt><aut>Nemere Istv&aacute;n</aut>, <vrk>Sur kampo granita. &ndash;
        Budape&scirc;to: Hungara Esperanto-Asocio, 1983</vrk></fnt>;
      </ekz>
      <ekz>
        e&ccirc; guto malgranda, konstante frapante, traboras la monton <tld/>an
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_g;&c_r;&c_a;&c_n;&c_ib;&c_t;&c_n;&c_y;</trd>
    <trd lng="ca">gran&iacute;tic</trd>
    <trd lng="en">granite <klr>(mineralogy)</klr></trd>
    <trdgrp lng="fr">
      <trd>en <ind>granit</ind></trd>,
      <trd>granitique</trd>
    </trdgrp>
    <trd lng="hu">gr&aacute;nit-</trd>
    <trd lng="nl">granieten</trd>
    <trd lng="pl">granitowy</trd>
    <trdgrp lng="pt">
     <trd>de <ind>granito</ind></trd>,
     <trd>gran&iacute;tico<klr tip="ind"> (adj.)</klr></trd>
    </trdgrp>
    <trd lng="ru">&c_g;&c_r;&c_a;&c_n;&c_i;&c_t;&c_n;&c_y;&c_j;</trd>
  </snc>
  <snc mrk="granit.0a.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Obstinega:
      <ekz>
        lia <ind><tld/>a kapo</ind> ne enlasas alian opinion.
        <trd lng="be">&c_g;&c_a;&c_l;&c_a;&c_v;&c_a; &c_d;&c_u;&c_b;&c_o;&c_v;&c_a;&c_ja;</trd>
        <trd lng="fr">t&ecirc;te dure<klr tip="ind"> (obstin&eacute;e)</klr></trd>
        <trd lng="hu">fafej</trd>
        <trdgrp lng="nl">
          <trd>een stijve <ind>kop</ind></trd>,
          <trd>een harde <ind>kop</ind></trd>
        </trdgrp>
        <trd lng="pt">muito <ind>obstinado</ind><klr tip="ind">
        (adj.)</klr></trd>
        <trd lng="tr">ta&scedil; kafa</trd>
      </ekz>
    </dif>
    <trd lng="be">&c_u;&c_p;&c_a;&c_r;&c_t;&c_y;</trd>
    <trd lng="ca">testarrut</trd>
    <trd lng="en">granite <klr>(figurative)</klr></trd>
    <trd lng="hu">k&odblac;kem&eacute;ny</trd>
    <trd lng="nl">koppig</trd>
    <trd lng="pl">twardog&lstroke;owy</trd>
    <trd lng="ru">&c_t;&c_v;&c_je;&c_r;&c_d;&c_o;&c_k;&c_a;&c_m;&c_je;&c_n;&c_n;&c_y;&c_j;</trd>
  </snc>
  <trdgrp lng="cs">
    <trd>granitov&yacute;</trd>,
    <trd>ze &zcaron;uly</trd>,
    <trd>&zcaron;ulov&yacute;</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x82B1;&#x5D17;&#x5CA9;&#x306E;  <pr>&#x304B;&#x3053;&#x3046;&#x304C;&#x3093;&#x306E;</pr></trd>,
    <trd>&#x5FA1;&#x5F71;&#x77F3;&#x3067;&#x3067;&#x304D;&#x305F;  <pr>&#x307F;&#x304B;&#x3052;&#x3044;&#x3057;&#x3067;&#x3067;&#x304D;&#x305F;</pr></trd>,
    <trd>&#x56FA;&#x3044;  <pr>&#x304B;&#x305F;&#x3044;</pr></trd>
  </trdgrp>
  <trd lng="sk">&zcaron;ulov&yacute;</trd>
  <trd lng="uk">&c_gu;&c_r;&c_a;&c_n;&c_ib;&c_t;&c_n;&c_i;&c_j;</trd>
</drv>
</art>
