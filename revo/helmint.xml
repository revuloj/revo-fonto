<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: helmint.xml,v 1.1 2026/11/21 19:45:10 afido Exp $">
    <kap>
      <rad>helmint</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="helmint.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc mrk="helmint.0o.MED">
    <dif>
      Ajna <ref tip="super" cel="parazi.0o.EKOL">parazita</ref>
      vermo (tenio, nematodo k.m.p.):
      <ekz>
        infekto per <tld/>a larvo
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>oj interesis, dum la lastaj cent jaroj, en &ccirc;iam pli alta grado la
        kuracistojn, veterinarojn kaj biologojn
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Helminthe</trd>
    <trd lng="en">helminth</trd>
    <trd lng="fr">helminthe</trd>
    <trd lng="uk">&c_g;&c_je;&c_l;&c_mol;&c_m;&c_ib;&c_n;&c_t;</trd>
  </snc>
</drv>

  </art>


