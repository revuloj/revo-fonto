    <kap>
      <rad>Bordoz</rad>/o
    </kap>

<drv mrk="bordoz.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc mrk="bordoz.0o.urbo">
    <dif>
      Universitata <ref tip="lst" lst="voko:urboj" cel="urb.0o">urbo</ref> &ccirc;e
      <ref tip="prt" cel="garon.0o">Garono</ref> en la sudokcidento de
      <ref tip="malprt" cel="franc.F0ujo">Francujo</ref>,&ccirc;. 45&#8239;km
      for de la atlantika bordo, situo: (<frm>44&#730;50&minute;N  0&#730;34&minute;E</frm>):
      <ekz>
        letero <klr>[&#8230;]</klr> sendita de vinfirmao al <tld/>o
        <fnt>
          <bib>Monato</bib>
          <vrk><url ref="&Monato;/2001/007065.php">Filatelo: VIPE 2000, a&ubreve; &ccirc;u la po&scirc;tmarkoj
          malaperos?</url></vrk>
          <lok>2000/09, p. 18</lok>
        </fnt>;
      </ekz>
      <ekz>
        la vinkonkurso <klr>[&#8230;]</klr> unuafoje &gcirc;i estas organizita en meze&ubreve;ropa
        lando,
        post Lisbono, Mastri&hcirc;to, <tld/>o <klr>[&#8230;]</klr>
        <fnt>
          <bib>Monato</bib>
          <aut>Julius Hauser</aut>
          <vrk><url ref="&Monato;/2013/011055.php">Je via sano!</url></vrk>
          <lok>2013/08, p. 14</lok>
        </fnt>;
      </ekz>
      <ekz>
        fluge al <tld/>o, Francio, kaj tiam al Parizo
        <fnt>
          <bib>Monato</bib>
          <aut>Douglas Draper</aut>
          <vrk><url ref="&Monato;/2006/009022.php">Pedale pacen</url></vrk>
          <lok>2006/10, p. 13</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_B;&c_a;&c_r;&c_d;&c_o; <klr tip="amb">(&c_g;&c_o;&c_r;&c_a;&c_d;)</klr></trd>
    <trd lng="de">Bordeaux</trd>
    <trd lng="en">Bordeaux</trd>
    <trd lng="fr">Bordeaux</trd>
    <trd lng="nl">Bordeaux</trd>
    <trd lng="pl">Bordeaux</trd>
    <trd lng="zh">&#27874;&#23572;&#22810; <pr>b&#333;&ecaron;rdu&#333;</pr></trd>
</snc>
  <trd lng="ca">Bordeus</trd>
  <trd lng="cv">&c_B;&c_o;&c_r;&c_d;&c_o;</trd>
  <trd lng="es">Burdeos</trd>
  <trd lng="ja">&#12508;&#12523;&#12489;&#12540;</trd>
  <trd lng="oc">Bord&egrave;u</trd>
 </drv>
