<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: turmen.xml,v 1.31 2026/08/28 18:39:11 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>turment</rad>/i
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="turmen.0i">
  <kap><ofc>*</ofc><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="turmen.0i.korpe">
    <dif>
      <ref tip="super" cel="sufer.0igi">Suferigi</ref> iun per kruelaj korpaj suferoj:
      <ekz>
        malbonaj infanoj amas <tld/>i bestojn
        <fnt><bib>F</bib>, <lok>&FE; 33</lok></fnt>;
      </ekz>
      <ekz>
        mian kromedzinon ili <tld/>is tiel, ke &scirc;i mortis
        <fnt>
          <bib>MT</bib>
          <lok>Ju&gcirc;istoj 20:5</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi <tld/>is mian animon per fasto
        <fnt>
          <bib>MT</bib>
          <lok>Psalmaro 35:13</lok>
        </fnt>;
      </ekz>
      <ekz>
        la oficiroj <klr>[&#8230;]</klr> <tld/>is la soldatojn
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>;
      </ekz>
      <ekz>
        malsato kaj soifo <tld/>is la knabon, li estis <klr>[&#8230;]</klr> preska&ubreve; sveninta
        <fnt>
          <bib>Fab1</bib>
          <lok>Kupra porko</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;in terure <tld/>is la frosto
        <fnt><bib>Fab1</bib>, <lok>Elinjo-fingreto</lok></fnt>;
      </ekz>
      <ekz>
        se malsato <tld/>as, lupo timon ne sentas
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_m;&c_u;&c_ch;&c_y;&c_c;&c_mol;</trd>,
      <trd>&c_k;&c_a;&c_t;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd><baz>aniaya</baz>menganiaya</trd>,
      <trd><baz>sakit</baz>menyakiti</trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>martelen</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>dokucza&cacute;</trd>,
      <trd>dr&eogonek;czy&cacute;</trd>,
      <trd>gn&eogonek;bi&cacute;</trd>,
      <trd>katowa&cacute;</trd>,
      <trd>m&eogonek;czy&cacute;</trd>
    </trdgrp>
  </snc>
  <snc mrk="turmen.0i.anime">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Suferigi iun per moralaj suferoj:
      <ekz>
        ia neordinara maltrankvilo <tld/>as la maljunulon
        <fnt>
          <bib>PatrojFiloj</bib>
          <lok>XXVII</lok>
        </fnt>;
      </ekz>
      <ekz>
        sub la influo de diversaj a&ubreve;ditaj opinioj <klr>[ili]</klr> <tld/>i&gcirc;as per
        konstantaj duboj
        <fnt>
          <bib>EE</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> ekturmentis nin per la postulo redoni <klr>[&ccirc;ion]</klr>
        <fnt>
          <bib>Hamlet</bib>
          <lok>Hamleto</lok>
        </fnt>;
      </ekz>
      <ekz>
        tro da bono ne <tld/>as
        <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        kiun mal&gcirc;ojo ne <tld/>is, tiu &gcirc;ojon ne sentas
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="cxagre.0i">&ccirc;agreni</ref>,
      <ref cel="cxikan.0i">&ccirc;ikani</ref>,
      <ref cel="dolor.0igi">dolorigi</ref>,
      <ref cel="trankv.mal0igi">maltrankviligi</ref>
    </refgrp>
    <trdgrp lng="be">
      <trd>&c_m;&c_u;&c_ch;&c_y;&c_c;&c_mol;</trd>,
      <trd>&c_n;&c_je;&c_p;&c_a;&c_k;&c_o;&c_ib;&c_c;&c_mol;</trd>,
      <trd>&c_k;&c_r;&c_o;&c_ib;&c_c;&c_mol;
      <klr>(&c_s;&c_e;&c_r;&c_c;&c_a;,
      &c_d;&c_u;&c_sh;&c_u;)</klr></trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd><baz>usik</baz>mengusik</trd>,
      <trd><baz>ganggu</baz>mengganggu</trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>kwellen</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>dokucza&cacute;</trd>,
      <trd>dr&eogonek;czy&cacute;</trd>,
      <trd>gn&eogonek;bi&cacute;</trd>,
      <trd>m&eogonek;czy&cacute;</trd>,
      <trd>n&eogonek;ka&cacute;</trd>,
      <trd>trapi&cacute;</trd>
    </trdgrp>
  </snc>
  <trdgrp lng="cs">
    <trd>mo&rcaron;it</trd>,
    <trd>mu&ccaron;it</trd>,
    <trd>sou&zcaron;it</trd>,
    <trd>su&zcaron;ovat</trd>,
    <trd>tr&aacute;pit</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>qu&auml;len</trd>,
    <trd>peinigen</trd>,
    <trd>martern</trd>
  </trdgrp>
  <trd lng="en">torment</trd>
  <trdgrp lng="es">
    <trd>atormentar</trd>,
    <trd>mortificar</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>faire souffrir</trd>,
    <trd>tenailler</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>gy&ouml;t&ouml;r</trd>,
    <trd>k&iacute;noz</trd>,
    <trd>sanyargat</trd>
  </trdgrp>
  <trd lng="id"><baz>siksa</baz>menyiksa</trd>
  <trdgrp lng="ja">
    <trd>&#x6FC0;&#12375;&#12356;&#x82E6;&#x75DB;&#12434;&#x4E0E;&#12360;&#x308B;
    <pr>&#x306F;&#12370;&#12375;&#12356;&#x304F;&#12388;&#12358;&#12434;&#12354;&#x305F;&#12360;&#x308B;</pr></trd>,
    <trd>&#x82E6;&#12375;&#12417;&#x308B;  <pr>&#x304F;&#x308B;&#12375;&#12417;&#x308B;</pr></trd>,
    <trd>&#12356;&#12376;&#12417;&#x308B;</trd>,
    <trd>&#12373;&#12356;&#x306A;&#12416;</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>atormentar</trd>,
    <trd>torturar</trd>,
    <trd>supliciar</trd>,
    <trd>mortificar</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_m;&c_u;&c_ch;&c_i;&c_t;&c_mol;</trd>,
    <trd>&c_i;&c_s;&c_t;&c_ja;&c_z;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_t;&c_je;&c_r;&c_z;&c_a;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>tr&aacute;pi&tcaron;</trd>,
    <trd>tr&yacute;zni&tcaron;</trd>,
    <trd>t&yacute;ra&tcaron; <klr>(du&scaron;evne i&nbsp;telesne)</klr></trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_m;&c_u;&c_ch;&c_i;&c_t;&c_i;</trd>,
    <trd>&c_k;&c_a;&c_t;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_m;&c_o;&c_r;&c_d;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x714E;&#x71AC; <pr>ji&amacron;n&aacute;o</pr></trd>,
    <trd>&#25240;&#x78E8; <pr>zh&eacute;m&oacute;</pr></trd>,
    <trd>&#x63C9;&#25619; <pr>r&oacute;ucuo</pr></trd>,
    <trd>&#x63C9;&#x78E8; <pr>r&oacute;umo</pr></trd>,
    <trd>&#x65BD;&#34384; <pr>sh&imacron;nu:&egrave;</pr></trd>,
    <trd>&#x4E7E;&#33879;&#24613; <pr>g&amacron;nzh&aacute;oj&iacute;</pr></trd>,
    <trd>&#x5E72;&#30528;&#24613; <pr>g&amacron;nzh&aacute;oj&iacute;</pr></trd>,
    <trd>&#26497;&#x75DB;&#x82E6; <pr>j&iacute;t&ograve;ngk&#x1D4;</pr></trd>,
    <trd>&#26997;&#x75DB;&#x82E6; <pr>j&iacute;t&ograve;ngk&#x1D4;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="turmen.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Da&ubreve;re suferiga:
      <ekz>
        &scirc;i forpu&scirc;adis ilin de si kiel ion <klr>[&#8230;]</klr> tro
        pezan por &scirc;iaj fortoj, tro <tld/>an por &scirc;ia koro
        <fnt><bib>Marta</bib></fnt>;
      </ekz>
      <ekz>
        en aliaj okazoj ekzistas <tld/>a sento de sekeco kaj la okuloj
        povas esti malfermataj nur kun malfacileco
        <fnt><bib>FK</bib>, <lok>5, el la vivo kaj sciencoj, kronika
        katara konjunktivito, (el la libro de profesoro E.
        Fuchs)</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_p;&c_a;&c_k;&c_u;&c_t;&c_l;&c_ib;&c_v;&c_y;</trd>,
    <trd>&c_p;&c_a;&c_k;&c_u;&c_t;&c_n;&c_y;</trd>,
    <trd>&c_m;&c_a;&c_r;&c_d;&c_o;&c_w;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="cs">mu&ccaron;iv&yacute;</trd>
  <trdgrp lng="de">
    <trd>qu&auml;lend</trd>,
    <trd>peinigend</trd>,
    <trd>qualvoll</trd>
  </trdgrp>
  <trd lng="es">tormentoso</trd>
  <trd lng="fr">tourmentant</trd>
  <trdgrp lng="hu">
    <trd>gy&ouml;tr&odblac;</trd>,
    <trd>k&iacute;nz&oacute;</trd>,
    <trd>gy&ouml;trelmes</trd>
  </trdgrp>
  <trd lng="id"><baz>siksa</baz>menyiksa</trd>
  <trdgrp lng="ja">
    <trd>&#x82E6;&#12375;&#12417;&#x308B;  <pr>&#x304F;&#x308B;&#12375;&#12417;&#x308B;</pr></trd>,
    <trd>&#x60A9;&#x307E;&#12377;  <pr>&#x306A;&#12420;&#x307E;&#12377;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
     <trd>dokuczliwy</trd>,
     <trd>dr&eogonek;cz&aogonek;cy</trd>,
     <trd>m&eogonek;cz&aogonek;cy</trd>,
     <trd>uci&aogonek;&zdot;liwy</trd>
  </trdgrp>
  <trd lng="ru">&c_m;&c_u;&c_ch;&c_i;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_y;&c_j;</trd>
  <trd lng="sk">mu&ccaron;iv&yacute;</trd>
  <trd lng="uk">&c_b;&c_o;&c_l;&c_ib;&c_s;&c_n;&c_i;&c_j;</trd>
</drv>

<drv mrk="turmen.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Suferoj ricevataj de iu a&ubreve; io:
      <ekz>
        <tld/>oplenaj formala&jcirc;oj;
      </ekz>
      <ekz>
        la bramano ne povis elporti la <tld/>ojn, ricevatajn de sia
        edzino
        <fnt><bib>FK</bib>, <lok>2, fabeloj kaj legendoj, Karagara,
        hinda
        fabelo, rakontis F. V. L.</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_m;&c_u;&c_ch;&c_e;&c_n;&c_mol;&c_n;&c_je;</trd>,
    <trd>&c_p;&c_a;&c_k;&c_u;&c_t;&c_a;</trd>,
    <trd>&c_m;&c_a;&c_r;&c_d;&c_a;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>muka</trd>,
    <trd>sou&zcaron;en&iacute;</trd>,
    <trd>tr&aacute;pen&iacute;</trd>,
    <trd>tr&yacute;ze&ncaron;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Qual</trd>,
    <trd>Pein</trd>,
    <trd>Marter</trd>
  </trdgrp>
  <trd lng="es">tormento</trd>
  <trdgrp lng="fr">
    <trd>affres</trd>,
    <trd>tourment</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>gy&ouml;trelem</trd>,
    <trd>k&iacute;n</trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>siksa</trd>,
    <trd>siksaan</trd>,
    <trd>aniaya</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x8CAC;&#x82E6;  <pr>&#x305B;&#12417;&#x304F;</pr></trd>,
    <trd>&#x82E6;&#x75DB;  <pr>&#x304F;&#12388;&#12358;</pr></trd>,
    <trd>&#x82E6;&#x60A9;  <pr>&#x304F;&#x306E;&#12358;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>dolegliwo&sacute;&cacute;</trd>,
    <trd>udr&eogonek;ka</trd>,
    <trd>katusze</trd>,
    <trd>m&eogonek;ka</trd>,
    <trd>utrapienie</trd>,
    <trd>zgryzota</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_m;&c_u;&#769;&c_k;&c_a;</trd>,
    <trd>&c_m;&c_u;&c_ch;&c_je;&c_n;&c_i;&c_je;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>tr&aacute;penie</trd>,
    <trd>tr&yacute;znenie</trd>,
    <trd>t&yacute;ranie</trd>
  </trdgrp>
  <trd lng="uk">&c_m;&c_u;&c_k;&c_a;</trd>
  <trd lng="zh">&#x837C;&#x6BD2; <pr>t&uacute;d&uacute;</pr></trd>
</drv>

<drv mrk="turmen.0egi">
  <kap><tld/>egi</kap>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      Ka&ubreve;zi grandajn dolorojn:
      <ekz>
        per kapricoj &scirc;i &ccirc;iujn <tld/>egis kaj fine
        for&jcirc;etis, a&ubreve; ili mem
        fu&gcirc;is de &scirc;i
        <fnt><bib>SatirRak</bib>, <lok>tria pre&gcirc;o de
        Pygmalion</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="martir.0o">martiro</ref>,
      <ref cel="tortur.0i">torturi</ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_a;&c_t;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_m;&c_a;&c_r;&c_d;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>mo&rcaron;it</trd>,
    <trd>mu&ccaron;it</trd>,
    <trd>sou&zcaron;it</trd>,
    <trd>su&zcaron;ovat</trd>,
    <trd>tr&aacute;pit</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>foltern</trd>,
    <trd>martern</trd>
  </trdgrp>
  <trd lng="fr">tourmenter</trd>
  <trd lng="hu">hal&aacute;lra <ind>gy&ouml;t&ouml;r</ind></trd>
  <trd lng="id">sangat menyiksa</trd>
  <trdgrp lng="pl">
    <trd>pastwi&cacute; si&eogonek;</trd>,
    <trd>torturowa&cacute;</trd>,
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_i;&c_s;&c_t;&c_ja;&c_z;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_p;&c_y;&c_t;&c_a;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>tr&aacute;pi&tcaron;</trd>,
    <trd>tr&yacute;zni&tcaron;</trd>,
    <trd>t&yacute;ra&tcaron; <klr>(du&scaron;evne i&nbsp;telesne)</klr></trd>
  </trdgrp>
</drv>

<drv mrk="turmen.0igxi">
  <kap><tld/>i&gcirc;i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc>
    <dif>
      Esti trafata de suferoj:
      <ekz>
        kiel gravedulino <klr>[&#8230;]</klr> <tld/>i&gcirc;as kaj krias en
        siaj doloroj
        <fnt><bib>MT</bib>, <lok>&Jes; 26:17</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_p;&c_a;&c_k;&c_u;&c_t;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_m;&c_u;&c_ch;&c_y;&c_c;&c_c;&c_a;</trd>
  </trdgrp>
  <trd lng="de">sich <ind>qu&auml;len</ind></trd>
  <trd lng="fr">souffrir</trd>
  <trdgrp lng="hu">
    <trd>gy&ouml;tr&odblac;dik</trd>,
    <trd>k&iacute;nl&oacute;dik</trd>,
    <trd>senyved</trd>
  </trdgrp>
  <trd lng="es">atormentarse</trd>
  <trdgrp lng="id">
    <trd><baz>derita</baz>menderita</trd>,
    <trd><baz>siksa</baz>tersiksa</trd>,
    <trd><baz>aniaya</baz>teraniaya</trd>,
    <trd><baz>sakit</baz>tersakiti</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x82E6;&#x60A9;&#12377;&#x308B;  <pr>&#x304F;&#x306E;&#12358;&#12377;&#x308B;</pr></trd>,
    <trd>&#x82E6;&#12375;&#12416;  <pr>&#x304F;&#x308B;&#12375;&#12416;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>dr&eogonek;czy&cacute; si&eogonek;</trd>,
    <trd>zamartwia&cacute; si&eogonek;</trd>,
    <trd>m&eogonek;czy&cacute; si&eogonek;</trd>,
    <trd>trapi&cacute; si&eogonek;</trd>
  </trdgrp>
  <trd lng="ru">&c_m;&c_u;&c_ch;&c_i;&c_t;&c_mol;&c_s;&c_ja;</trd>
  <trd lng="uk">&c_m;&c_u;&c_ch;&c_i;&c_t;&c_i;&c_s;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#x53D7;&#x7F6A; <pr>sh&ograve;uzu&igrave;</pr></trd>,
    <trd>&#x53D7;&#x82E6; <pr>sh&ograve;uk&#x1D4;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="turmen.el0i">
  <kap>el<tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="turmen.el0i.plene">
    <dif>
      Plene <tld/>i &gcirc;is senrezisto a&ubreve; senespero:
      <ekz>
        per sen&ccirc;esa enlo&gcirc;igado de soldatoj li tute nin
        el<tld/>is, ni ne scias jam kiel nin savi
        <fnt><bib>Revizoro</bib>, <lok>akto 4a, sceno 10a</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="cxikan.0i.gxeni">&ccirc;ikani<sncref/></ref>,
      <ref cel="plag.0i">plagi</ref>
    </refgrp>
    <trdgrp lng="be">
      <trd>&c_z;&c_m;&c_u;&c_ch;&c_y;&c_c;&c_mol;</trd>,
      <trd>&c_v;&c_y;&c_m;&c_u;&c_ch;&c_y;&c_c;&c_mol;</trd>
    </trdgrp>
    <trd lng="fr">&eacute;puiser par la souffrance</trd>
