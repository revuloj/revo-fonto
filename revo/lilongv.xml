<drv mrk="lilongv.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&Ccirc;efurbo</ref> de
      <ref tip="malprt" cel="malavi.M0o">Malavio</ref>,
      situo: (<frm>13&#730;59&minute;S  33&#730;47&minute;E</frm>):
      <ekz>
        Lilongvo <klr>[&#8230;]</klr> estis fondita en 1947
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=25800">Lilongvo</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        pinta Konferenco de la komerca regiono okazinta en la malavia &ccirc;efurbo <tld/>o
        sankciis la traktaton kaj proklamis la oficialan fondi&gcirc;on de la Komuna
        Merkato por Orienta kaj Suda Afriko
        <fnt>
          <bib>CRI&#8239;</bib>
          <vrk><url ref="https://esperanto.cri.cn/1/2005/08/03/1@27760.htm">Komuna Merkato por
          Orienta kaj Suda Afriko</url></vrk>
          <lok>2005-08-03</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Lilongwe</trd>
    <trd lng="en">Lilongwe</trd>
    <trd lng="fr">Lilongwe</trd>
    <trd lng="pl">Lilongwe</trd>
    <trd lng="ru">&c_L;&c_i;&c_l;&c_o;&c_n;&c_g;&c_v;&c_je;</trd>
  </snc>
  <trd lng="be">&c_L;&c_ib;&c_l;&c_o;&c_n;&c_g;&c_v;&c_e;</trd>
  <trd lng="ca">Lilongwe</trd>
  <trd lng="es">Lilongwe</trd>
  <trd lng="ja">&#12522;&#12525;&#12531;&#12464;&#12454;&#12455;</trd>
  <trdgrp lng="zh">
    <trd>&#21033;&#38534;&#22317; <pr>L&igrave;l&oacute;nggu&#299;</pr></trd>,
    <trd>&#37324;&#26391;&#23041; <pr>L&#464;l&#462;ngw&emacron;i</pr></trd>
  </trdgrp>
 </drv>
