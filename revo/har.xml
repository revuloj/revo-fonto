  <snc mrk="har.sen0igi.kosmetike">
    <dif>
      Forigi maldezirindajn <tld/>ojn de iu korpoparto, precipe por
      celoj kosmetikaj a&ubreve; medicinaj:
      <ekz>
        sen<tld/>igi gambojn, brovojn
      </ekz><ekz>
        liaj brakoj estis nudaj <klr>&#8230;</klr> zorgeme sen<tld/>igitaj,
        glataj, sed tro muskolaj, veraj brakoj de soldato
       <fnt><bib>QuV</bib>, <lok>&Ccirc;ap. 7&#170;</lok></fnt>;
      </ekz><ekz>
        en Belgio, lando kiu nomas sin libera kaj evoluinta, virino
        kiu diras &leftquot;ne&rightquot; kontra&ubreve; sen<tld/>igo estos punata &ccirc;iamaniere,
        &gcirc;is &scirc;i obeos la &leftquot;normon&rightquot;
        <fnt>
          <aut>Pa&ubreve;l Peeraerts</aut>
          <vrk>Kia na&ubreve;za normo?</vrk> <bib>Monato</bib>
          <lok>&#8470;011789</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ru">
      <trd>&c_u;&c_d;&c_a;&c_l;&c_ja;&c_t;&c_mol; &c_v;&c_o;&c_l;&c_o;&c_s;&c_y;</trd>,
      <trd>&c_v;&c_y;&c_shch;&c_i;&c_p;&c_y;&c_v;&c_a;&c_t;&c_mol;
      &c_v;&c_o;&c_l;&c_o;&c_s;&c_y;</trd>,
      <trd>&c_s;&c_g;&c_o;&c_n;&c_ja;&c_t;&c_mol; &c_v;&c_o;&c_l;&c_o;&c_s;</trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_v;&c_y;&c_d;&c_a;&c_l;&c_ja;&c_c;&c_mol;
