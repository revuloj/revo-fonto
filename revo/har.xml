<drv mrk="har.0lako">
  <kap>
    <tld/>lako,
    <var><kap><tld/>&scirc;pruca&jcirc;o</kap></var>
  </kap>
  <snc mrk="har.0lako.KOS">
    <dif>
      <ref cel="kosmet.0ajxo.KOS">Kosmetika&jcirc;o</ref>
      &scirc;prucigata sur la kapharojn por ilin rigidigi
      kaj teni en arta friza&jcirc;o:
      <ekz>
        la nuna prezidento tondigas siajn harojn je 3-4 semajnoj kaj ne uzas <tld/>lakon
        <fnt>
          <aut>-</aut>
          <vrk><url ref="http://www.aneb.espereto.com/esp-fajr/ef.txt">Koncize pri &ccirc;io</url></vrk>
          <lok> Esperanta Fajrero, 2001:1</lok>
        </fnt>;
      </ekz><ekz>
        en multaj <tld/>&scirc;pruca&jcirc;oj trovi&gcirc;as formaldehido kaj tio estas altgrade venena
        <fnt>
          <aut>[A. Oberndorfer]</aut>
          <vrk><url
          ref="http://esperantaretradio.blogspot.com/2017/03/biologiaj-gluiloj-el-la-naturo.html?view=snapshot">Biologiaj
          gluiloj el la naturo</url></vrk>
          <lok>Esperanta retradio, 2017-03-09</lok>
        </fnt>.
