<drv mrk="har.0aro">
  <kap><ofc>*</ofc><tld/>aro</kap>
  <snc mrk="har.0aro.FRIZ">
    <dif>
      Tuto de la kapaj <tld/>oj de iu homo,
      de la <tld/>oj de iu besto:
      <ekz>
        korve nigra <tld/>aro
        <fnt><bib>Kiso</bib> <lok>Poetoj kaj homoj</lok></fnt>;
      </ekz>
      <ekz>
        blanka <tld/>aro
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        flavblonda <tld/>aro
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        sunora <tld/>aro
        <fnt>
          <bib>HsT</bib>
          <lok>La nepo</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;io &ccirc;e li, lia vesto, lia viza&gcirc;o, lia <tld/>aro estis griza kiel &scirc;tono
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Minejo de l' Bildoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i skuis la tran&ccirc;itan <tld/>aron kaj klinis la kapon flanken
        <fnt>
          <bib>HsT</bib>
          <lok>Kuni&gcirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        ludema buklo de &scirc;ia ka&scirc;tankolora <tld/>aro falis sur &scirc;ian glatan frunton
        <fnt>
          <bib>Monato</bib>
          <aut>Julian Modest</aut>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_v;&c_a;&c_l;&c_a;&c_s;&c_y;</trd>,
      <trd>&c_v;&c_a;&c_l;&c_a;&c_s;&c_ja;&c_n;&c_o;&c_je; &c_p;&c_o;&c_k;&c_r;&c_y;&c_v;&c_a;</trd>
    </trdgrp>
    <trdgrp lng="br">
      <trd>blev</trd>,
      <trd>blevenn<klr> [bestoj]</klr>
        <klr tip="ind"> (hollad blev ar bronneged)</klr></trd>,
      <trd>pennad blev</trd>
    </trdgrp>
    <trdgrp lng="ca">
      <trd>cabellera</trd>,
      <trd>pelatge</trd>
    </trdgrp>
    <trd lng="cv">&#1195;&#1267;&#1195;</trd>
    <trdgrp lng="en">
      <trd>hair <klr tip="amb">(person)</klr></trd>,
      <trd>coat <klr tip="amb">(animal)</klr></trd>
    </trdgrp>
    <trdgrp lng="es">
      <trd>cabellera</trd>,
      <trd>pelaje<klr tip="ind"> (animal)</klr></trd>
    </trdgrp>
    <trdgrp lng="fr">
      <trd>chevelure</trd>,
      <trd>cheveux</trd>,
      <trd>pelage<klr tip="ind"> (d'un animal)</klr></trd>
    </trdgrp>
    <trd lng="hu">haj</trd>
    <trdgrp lng="id">
      <trd>rambut<klr> (manusia)</klr></trd>,
      <trd>bulu<klr> (hewan)</klr></trd>
    </trdgrp>
    <trdgrp lng="it">
      <trd>chioma</trd>,
      <trd>capelli</trd>,
      <trd>capigliatura</trd>,
      <trd>manto<klr> (di animali)</klr></trd>,
      <trd>pelame<klr> (di animali)</klr></trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>haardos</trd>,
      <trd>haar</trd>
    </trdgrp>
    <trd lng="pl">ow&lstroke;osienie</trd>
    <trd lng="ro">p&abreve;rul</trd>
    <trd lng="ru">&c_sh;&c_je;&c_v;&c_je;&c_l;&c_ju;&c_r;&c_a;</trd>
    <trd lng="sv">h&aring;r</trd>
  </snc>
  <snc mrk="har.0aro.peruko">
    <uzo tip="stl">ARK</uzo>
    <dif>
      <ref tip="dif" cel="peruk.0o">Peruko</ref>:
      <ekz>
