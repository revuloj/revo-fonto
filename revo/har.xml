    <uzo tip="stl">FRAZ</uzo>
    <dif>
      Stariganta la <tld/>ojn sur la korpo pro emocio;
      <ref tip="vid" cel="terur.0a">terura</ref>,
      miriga, tre <ref cel="nervoz.0iga">nervoziga</ref> a&ubreve; iel <ref cel="sxok.0a">&scirc;oka</ref>:
      <ekz>
        la punoj, la&ubreve; la priskribo, estis <tld/>starigaj
        <fnt><aut>A. L&ouml;wenstein</aut>, <vrk>La &scirc;tona
        urbo</vrk>,
          <lok>1999</lok></fnt>;
      </ekz><ekz>
        sur tiu pa&gcirc;o oni legas multajn <tld/>hirtigajn aferojn kaj groteskajn opiniojn
        <fnt>
          <aut>A. K&uuml;nzli</aut>,
          <vrk>en: <url ref="http://www.liberafolio.org/2009/bjalistoko3c/">
              Probal Dasgupta volas mezuri...</url></vrk>,
          <lok>libera folio, 2009-07-29</lok>
