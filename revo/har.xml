<drv mrk="har.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="har.0o.mamulo">
    <uzo tip="fak">ANA</uzo>
    <dif>
      <ref tip="super" cel="filame.0o">Filamento</ref> kreskanta el
      la ha&ubreve;to de <ref tip="malprt" cel="mam.0uloj">mamuloj</ref>
      kaj pli-malpli dense kovranta ilian korpon
      <ekz>
        <tld/>o estas tre maldika
        <fnt><bib>F</bib> <lok>&FE; 33</lok></fnt>;
      </ekz>
      <ekz>
        &scirc;i kombas al si la <tld/>ojn per ar&gcirc;enta kombilo
        <fnt>
          <bib>F</bib>
          <lok>&FE; 34</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Else</nom> havis ne&gcirc;blankan ha&ubreve;ton kaj linkolorajn harojn
        <fnt>
          <bib>Fab4</bib>
          <lok>Historio el la dunoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        flaveblondaj <tld/>oj
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        helka&scirc;tanaj <tld/>oj
        <fnt>
          <bib>CKv</bib>
          <lok>5</lok>
        </fnt>;
      </ekz>
      <ekz>
        altkreska viro kun longaj ru&gcirc;aj <tld/>oj kaj longa ru&gcirc;blonda barbo
        <fnt>
          <bib>ChR</bib>
          <lok>Veli morten</lok>
        </fnt>;
      </ekz>
      <ekz>
        nigraj ondaj <tld/>oj
        <fnt>
          <bib>ChB</bib>
          <lok>5</lok>
        </fnt>;
      </ekz>
      <ekz>
        grizaj <tld/>oj
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        ar&gcirc;entkoloraj <tld/>oj
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Kvina</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>oj de nedifinita koloro, glate frizitaj
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        la fra&ubreve;lineto ru&gcirc;i&gcirc;is &gcirc;is la <tld/>oj kaj oreloj
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        virino kun <klr>[&#8230;]</klr> disliberigitaj <tld/>oj
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        fajro<tld/>a furio
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Tria</lok>
        </fnt>;
      </ekz>
      <ekz>
        vi devas razi viajn pubajn <tld/>ojn
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        nekombitaj hirtaj <tld/>oj
        <fnt>
          <bib>ChV</bib>
          <lok>17</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> metis <tld/>fiksan substancon por teni la <tld/>ojn en
        neordinara pozicio
        <fnt>
          <bib>ChV</bib>
          <lok>6</lok>
        </fnt>;
      </ekz>
      <ekz>
        liaj buklaj <tld/>oj &scirc;ajne ne ofte perceptis la kontakton kun &scirc;ampuo
        <fnt>
          <bib>ChV</bib>
          <lok>27</lok>
        </fnt>;
      </ekz>
      <ekz>
        la lupo <klr>[&#8230;]</klr> man&gcirc;os vin kun ha&ubreve;to kaj <tld/>oj
        <fnt>
          <bib>ElektFab</bib>
          <lok>La sep kapridoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;u vi ne estas vundita? &ndash; <klr>[&#8230;ne,]</klr> mi ne perdis e&ccirc; unu haron
        <fnt>
          <bib>ElektFab</bib>
          <lok>La kura&gcirc;a tajloreto</lok>
        </fnt>;
      </ekz>
      <ekz>
        ni &ccirc;iuj <klr>[&#8230;]</klr> el&scirc;irus al ni la <tld/>ojn super via &ccirc;erko
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Unua</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi estis jam kun mia ha&ubreve;to kaj <tld/>oj forvendita al la anatomio
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>!
      </ekz>
      <ekz>
        en la sepa tago li forrazos &ccirc;iujn siajn harojn, sian kapon kaj sian barbon kaj
        la brovojn de siaj okuloj
        <fnt>
          <bib>MT</bib>
          <lok>Levidoj 14:9</lok>
        </fnt>;
      </ekz>
      <ekz>
        en tiu tago oni unuafoje tondis la <tld/>ojn, <klr>[&#8230;]</klr> kaj kiu sentis
        deziron, lavis sin
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>;
      </ekz>
      <ekz>
        se &ccirc;e iu elfalis la <tld/>oj sur la kapo, li estas sen<tld/>ulo
        <fnt>
          <bib>MT</bib>
          <lok>Levidoj 13:40</lok>
        </fnt>;
      </ekz>
      <ekz>
        li prenos la <tld/>ojn de sia konsekrita kapo
        <fnt>
          <bib>MT</bib>
          <lok>Nombroj 6:18</lok>
        </fnt>;
      </ekz>
      <ekz>
        decidema homo, &mdash; soldata koro, <ind><tld/>oj sur la lango</ind>
        <klr>(scias defendi sin en disputo)</klr>
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>!
        <trd lng="de"><ind>Haar</ind>e auf den Z&auml;hnen</trd>
      </ekz>
      <ekz>
        la aserto povus hirtigi la <tld/>ojn de iuj
        <fnt>
          <bib>Kon11</bib>
          <lok>Recenzo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FRAZ</uzo>
        <ind>disfendi, dissplitigi harojn</ind>
        <klr>(subtila&ccirc;e diskuti)</klr>;
        <trd lng="br">spazha&ntilde; laou</trd>
        <trd lng="de">Haare <ind>spalten</ind></trd>
        <trd lng="fr">couper les <ind>cheveux</ind> en quatre</trd>
        <trd lng="id"><baz>debat</baz>memperdebatkan hal-hal sepele</trd>
        <trdgrp lng="ru">
          <trd>&c_k;&c_o;&c_p;&c_a;&c_t;&c_mol;&c_s;&c_ja; &c_v;
          <ind>&c_m;&c_je;&c_l;&c_o;&c_ch;&c_a;&c_h;</ind></trd>,
          <trd>&c_b;&c_u;&c_k;&c_v;&c_o;&c_je;&c_d;&c_s;&c_t;&c_v;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>,
          <trd>&c_z;&c_a;&c_n;&c_u;&c_d;&c_s;&c_t;&c_v;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
        </trdgrp>
      </ekz>
      <ekz>
        <uzo tip="stl">FRAZ</uzo>
        <ind>mia vivo estas sur <tld/>eto</ind>
        <klr>(estas en ekstrema dan&gcirc;ero)</klr>
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto kvara</lok>
        </fnt>;
        <trd lng="de">mein Leben h&auml;ngt am seidenen <ind>Faden</ind></trd>
      </ekz>
      <ekz>
        de zorgoj, ne de jaroj, blanki&gcirc;as la <tld/>oj
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FRAZ</uzo>
        li estas <ind><tld/>plena</ind> kiel urso.
        <trd lng="br">blevek</trd>
        <trd lng="fr">poilu</trd>
        <trdgrp lng="id">
          <trd><baz>bulu</baz>berbulu</trd>,
          <trd><baz>rambut</baz>berambut</trd>,
          <trd>penuh bulu</trd>,
          <trd>penuh rambut</trd>
        </trdgrp>
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="bukl.0o">buklo</ref>,
      <ref cel="faden.0o">fadeno</ref>,
      <ref cel="fibr.0o">fibro</ref>,
