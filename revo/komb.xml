<vortaro>
<art mrk="$Id: komb.xml,v 1.46 2026/10/25 11:17:38 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>komb</rad>/i
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="komb.0i">
  <kap><ofc>*</ofc><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      Malkonfuzi, purigi, ordigi per <tld/>ilo:
      <ekz>
        <tld/>i la harojn, la barbon; <tld/>i sin, la hundon;
      </ekz>
      <ekz>
        &scirc;i <tld/>as al si la harojn per ar&gcirc;enta <tld/>ilo
        <fnt>
          <bib>F</bib>
          <lok>&FE; 34</lok>
        </fnt>;
      </ekz>
      <ekz>
        lino <tld/>ita
        <fnt>
          <bib>MT</bib>
          <lok>Jesaja 19:9</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;ia &ccirc;ambristino &scirc;in <tld/>is
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Dekkvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        li &ccirc;iam <tld/>is la&ubreve; la kranio &gcirc;is la nuko
        <fnt>
          <bib>IdO</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        glate <tld/>ita kapo
        <fnt>
          <bib>StU</bib>
          <lok>Al Romo</lok>
        </fnt>;
      </ekz>
      <ekz>
        min estis rigardantaj brilantaj en duonlumo okuloj, ne<tld/>itaj barboj kaj
        duonmalfermitaj bu&scirc;oj
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i prenas falsan hararon violkoloran, alte <tld/>itan
        <fnt>
          <bib>SkandalJozef</bib>
          <lok>Eldiras babilema negrino</lok>
        </fnt>;
      </ekz>
      <ekz>
        la ar&gcirc;entblanka hararo estis supren<tld/>ita
        <fnt>
          <bib>VRA</bib>
          <lok>Helmer Grundstr&ouml;m</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[je tiu]</klr> tago de la monato ni devas anta&ubreve;en<tld/>i nian hararon
        <fnt>
          <bib>VaK</bib>
          <lok>Dekunua &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Wells</nom> provis <tld/>i sin per la fingroj
        <fnt>
          <bib>Monato</bib>
          <vrk><url ref="&Monato;/2003/007991.html"
              >Espero</url></vrk>
          <lok>2003</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_r;&c_y;&c_ch;&c_a;&c_s;&c_a;&c_c;&c_mol;</trd>
  <trdgrp lng="bg">
    <trd>&c_r;&c_je;&c_sh;&c_a;</trd>,
    <trd>&c_s;&c_r;&c_je;&c_s;&c_v;&c_a;&c_m;</trd>
  </trdgrp>
  <trd
  lng="bo">&t_ra;&t_gata;&t_yata;&t_shabchu;&t_ga;&t_tsheg;&t_sha;&t_da;&t_tsheg;&t_ra;&t_gata;&t_yata;&t_ga;&t_tsheg;</trd>
  <trdgrp lng="cs">
    <trd>&ccaron;esat</trd>,
    <trd>&ccaron;esat <klr>(vlasy)</klr></trd>
  </trdgrp>
  <trd lng="de">k&auml;mmen</trd>
  <trd lng="en">comb</trd>
  <trd lng="es">peinar</trd>
  <trd lng="fr">peigner<klr tip="ind"> (cheveux, poils)</klr></trd>
  <trd lng="hu">f&eacute;s&uuml;l</trd>
  <trd lng="id"><baz>sisir</baz>menyisir</trd>
  <trdgrp lng="ja">
    <trd>&#x3059;&#x304F;</trd>,
    <trd>&#x304F;&#x3057;&#x3051;&#x305A;&#x308B;</trd>
  </trdgrp>
  <trd lng="nl">kammen</trd>
  <trd lng="pl">czesa&cacute;</trd>
  <trdgrp lng="pt">
    <trd>pentear</trd>,
    <trd>cardar</trd>
  </trdgrp>
  <trd lng="ro">piept&abreve;na</trd>
  <trd lng="ru">&c_p;&c_r;&c_i;&c_ch;&c_je;&c_s;&c_a;&c_t;&c_mol;</trd>
  <trdgrp lng="sk">
    <trd>u&ccaron;esa&tcaron;</trd>,
    <trd>&ccaron;esa&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_ch;&c_je;&c_s;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_p;&c_r;&c_i;&c_ch;&c_ib;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_z;&c_a;&c_ch;&c_ib;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x68B3; <pr>sh&umacron;</pr></trd>,
    <trd>&#x68B3;&#x5934; <pr>sh&umacron;t&oacute;u</pr></trd>,
    <trd>&#x6809; <pr>zh&igrave;</pr></trd>,
    <trd>&#x68B3;&#x7406; <pr>sh&umacron;l&#x1D0;</pr></trd>,
    <trd>&#x7B13; <pr>p&iacute;</pr></trd>,
    <trd>&#x7BE6; <pr>b&igrave;</pr></trd>,
    <trd>&#x7CBE;&#x7D21; <pr>j&imacron;ngf&#x1CE;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="komb.0ajxo">
  <kap>
    <tld/>a&jcirc;o
  </kap>
  <snc>
    <dif>
      Tio kion oni kombas a&ubreve; kombis (hararo, friza&jcirc;o, fibra&jcirc;o k.a.):
      <ekz>
        ni parolas pri &scirc;ia <tld/>a&jcirc;o
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro LVI</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de"><klr>(gek&auml;mmte)</klr> Frisur</trd>
</drv>

<drv mrk="komb.0ilo">
  <kap><tld/>ilo</kap>
  <snc mrk="komb.0ilo.ordigi">
    <dif>
      Ilo kun longaj maldikaj dentoj por
      malkonfuzi, purigi, ordigi harojn, lanon, fibrojn ks:
      <ekz>
        mi posedas bototirilon kaj <tld/>ilon
        <fnt>
          <bib>Fab3</bib>
          <lok>Kolumo</lok>
        </fnt>;
      </ekz>
      <ekz>
        Mikelo donis al li la <tld/>ilon, kaj <nom>Stanislas</nom> tiel lerte aran&gcirc;is siajn harojn,
        ke post kelka tempo lia kapo estis kovrita per la plej belegaj nigraj bukloj
        <fnt>
          <bib>IdO</bib>
          <lok>Tria Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        tekso<tld/>ilo similas ordinaran <tld/>ilon, konsistante el vico da <ind><tld/>ilero</ind>j,
        sed &gcirc;i estas amba&ubreve;flanke fermita
        <fnt>
          <aut>Marie Bartovsk&aacute;</aut>
          <vrk><url ref="https://scienca-revuo.info/article/1448"
              >La teksokombilo  </url></vrk>
          <lok>Scienca Revuo, 1972 n-ro 95, artikolo 1448</lok>
        </fnt>;
        <trd lng="de">Zinke <klr>(vom Kamm)</klr></trd>
      </ekz>
      <ekz>
        kiu kapon posedas, <tld/>ilon jam trovos
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="bros.0o">broso</ref>
    </refgrp>
    <trd lng="be">&c_r;&c_a;&c_s;&c_ch;&c_o;&c_s;&c_k;&c_a;</trd>
    <trd lng="en">comb</trd>
    <trd lng="ru">&c_r;&c_a;&c_s;&c_ch;&c_jo;&c_s;&c_k;&c_a;</trd>
  </snc>
  <snc mrk="komb.0ilo.ornami">
    <dif>
      Analoga ilo, kiun uzas la virinoj por fiksi a&ubreve; ornami sian
      hararon:
      <ekz>
        iliaj longaj blondaj haroj estis interfiksitaj per oraj <tld/>iloj
        <fnt>
          <bib>Fab1</bib>
          <lok>Vojkamarado</lok>
        </fnt>;
      </ekz>
      <ekz>
        apena&ubreve; la sor&ccirc;istino enigis la <tld/>ilon en la harojn, la veneno komencis efiki
        kaj la knabino falis senkonscia
        <fnt>
          <bib>ElektFab</bib>
          <lok>Ne&gcirc;ulino</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="agraf.0o.krocxilo">agrafo<sncref/></ref>,
      <ref cel="kramp.0o.PV">krampo<sncref/></ref>
    </refgrp>
    <trdgrp lng="be">
      <trd>&c_g;&c_r;&c_e;&c_b;&c_je;&c_n;&c_mol;</trd>,
      <trd>&c_g;&c_r;&c_a;&c_b;&c_je;&c_n;&c_je;&c_c;</trd>,
      <trd>&c_g;&c_r;&c_a;&c_b;&c_je;&c_n;&c_mol;&c_ch;&c_y;&c_k;</trd>
    </trdgrp>
    <trd lng="de">Einsteckkamm</trd>
    <trd lng="en">comb</trd>
  </snc>
  <trd lng="bg">&c_g;&c_r;&c_je;&c_b;&c_je;&c_n;</trd>
  <trd lng="bo">&t_ra;&t_gata;&t_yata;&t_shabchu;&t_ga;&t_tsheg;&t_sha;&t_da;&t_tsheg;</trd>
  <trd lng="cs">h&rcaron;eben na &ccaron;es&aacute;n&iacute;</trd>
  <trd lng="de">Kamm</trd>
  <trd lng="es">peine</trd>
  <trd lng="fr">peigne</trd>
  <trd lng="hu">f&eacute;s&udblac;</trd>
  <trd lng="id">sisir</trd>
  <trdgrp lng="ja">
    <trd>&#x304F;&#x3057;</trd>,
    <trd>&#x3059;&#x304D;&#x3050;&#x3057;</trd>
  </trdgrp>
  <trd lng="ku">&scedil;eh</trd>
  <trd lng="nl">kam</trd>
  <trd lng="pl">grzebie&nacute;</trd>
  <trd lng="ro">pieptene </trd>
  <trd lng="ru">&c_g;&c_r;&c_je;&c_b;&c_je;&c_n;&c_mol;</trd>
  <trd lng="sk">hrebe&ncaron; <klr>(na &ccaron;esanie)</klr></trd>
  <trdgrp lng="uk">
    <trd>&c_g;&c_r;&c_je;&c_b;&c_ib;&c_n;&c_mol;</trd>,
    <trd>&c_g;&c_r;&c_je;&c_b;&c_ib;&c_n;&c_je;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x68B3; <pr>sh&umacron;</pr></trd>,
    <trd>&#x7B13; <pr>p&iacute;</pr></trd>,
    <trd>&#x68B3;&#x5B50; <pr>sh&umacron;zi</pr></trd>,
    <trd>&#x7BE6; <pr>b&igrave;</pr></trd>,
    <trd>&#x5C0F;&#x6392;&#x9AA8; <pr>xi&#x1CE;op&aacute;ig&#x1D4;</pr></trd>,
    <trd>&#x6809; <pr>zh&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="komb.0isto">
  <kap>
    <tld/>isto
  </kap>
