<drv mrk="komb.mal0i">
  <kap>mal<tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      Malordigi la <tld/>itajn harojn:
      <ekz>
        la vento vin mal<tld/>is;
      </ekz>
      <ekz>
        mal<tld/>ita harkrono
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Kvara</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="komb.dis0i.harojn">diskombi</ref>
  </snc>
  <trdgrp lng="be">
    <trd>&c_r;&c_a;&c_s;&c_t;&c_r;&c_a;&c_p;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_s;&c_k;&c_u;&c_d;&c_l;&c_a;&c_c;&c_ib;&c_c;&c_mol;</trd>,
    <trd>&c_p;&c_a;&c_k;&c_a;&c_l;&c_m;&c_a;&c_c;&c_ib;&c_c;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_s;&c_k;&c_a;&c_l;&c_m;&c_a;&c_c;&c_ib;&c_c;&c_mol;</trd>,
    <trd>&c_u;&c_z;&c_l;&c_a;&c_h;&c_m;&c_a;&c_c;&c_ib;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>cuchat</trd>,
    <trd>rozcuchat</trd>
  </trdgrp>
  <trd lng="de">verstrubbeln</trd>
  <trdgrp lng="en">
    <trd>tousle</trd>,
    <trd>dishevel</trd>
  </trdgrp>
  <trd lng="es">despeinar</trd>
  <trdgrp lng="fr">
    <trd>d&eacute;coiffer</trd>,
    <trd>d&eacute;peigner</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>&ouml;sszek&oacute;col</trd>,
    <trd>sz&eacute;tborzol</trd>
  </trdgrp>
  <trd lng="id"><baz>acak</baz>mengacak rambut</trd>
  <trd lng="ja">&#x304B;&#x304D;&#x4E71;&#x3059;  <pr>&#x304B;&#x304D;&#x307F;&#x3060;&#x3059;</pr></trd>
  <trd lng="nl">in de <ind>war</ind> doen</trd>
  <trdgrp lng="pl">
    <trd>targa&cacute;</trd>,
    <trd>potarga&cacute;</trd>
  </trdgrp>
  <trdgrp lng="ro">
    <trd>toart&abreve;</trd>,
    <trd> sf&acirc;&scomma;ia</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_r;&c_a;&c_s;&c_t;&c_r;&c_je;&c_p;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_l;&c_o;&c_h;&c_m;&c_a;&c_t;&c_i;&c_t;&c_mol;</trd>
  </trdgrp>
  <trd lng="sk">postrapati&tcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_r;&c_o;&c_z;&c_t;&c_r;&c_ib;&c_p;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_r;&c_o;&c_z;&c_k;&c_u;&c_j;&c_o;&c_v;&c_d;&c_zh;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_s;&c_k;&c_u;&c_j;&c_o;&c_v;&c_d;&c_zh;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
</drv>

<drv mrk="komb.dis0i">
  <kap>dis<tld/>i</kap>
  <snc mrk="komb.dis0i.harojn">
    <dif>
      <tld lit="K"/>i disen:
      <ekz>
        mi vidis nur la meze dis<tld/>itan friza&jcirc;on
        <fnt>
          <bib>VaK</bib>
          <lok>Na&ubreve;a &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        li pasigis la manon ree kaj ree tra la hararo, tiel ke post kelka tempo li i&gcirc;is
        tute dis<tld/>ita, kun plej komika efekto
        <fnt>
          <bib>CKv</bib>
          <lok>17</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>aufbauschen</trd>,
      <trd>toupieren</trd>
    </trdgrp>
  </snc>
  <snc mrk="komb.dis0i.TEK">
    <uzo tip="fak">TEK</uzo>
    <dif>
      <tld lit="K"/>i per speciala <tld/>ilo linajn a&ubreve; kanabajn fibrojn
      por purigi ilin.
    </dif>
    <trdgrp lng="be">
      <trd>&c_ch;&c_a;&c_s;&c_a;&c_c;&c_mol;</trd>,
      <trd>&c_r;&c_a;&c_s;&c_ch;&c_e;&c_s;&c_v;&c_a;&c_c;&c_mol;</trd>
    </trdgrp>
    <trd lng="de">ausk&auml;mmen</trd>
    <trd lng="en">card</trd>
    <trdgrp lng="fr">
      <trd>carder</trd>,
      <trd>peigner<klr tip="ind"> (carder)</klr></trd>,
      <trd>d&eacute;m&ecirc;ler<klr tip="ind"> (carder)</klr></trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>kif&eacute;s&uuml;l</trd>,
      <trd>k&aacute;rtol</trd>,
      <trd>gerebenez</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd><baz>sisir</baz>menyisir<klr tip="amb"> (utk membersihkan)</klr></trd>,
      <trd><baz>susur</baz>menyusur</trd>
    </trdgrp>
    <trd lng="ja">&#x3059;&#x304F;</trd>
    <trd lng="nl">kaarden</trd>
    <trdgrp lng="pl">
      <trd>przeczesywa&cacute;</trd>,
      <trd>rozczesa&cacute;</trd>
    </trdgrp>
    <trdgrp lng="ro">
      <trd>piept&abreve;na</trd>,
      <trd>perie</trd>
    </trdgrp>
    <trd lng="uk">&c_r;&c_o;&c_z;&c_ch;&c_ib;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  </snc>
</drv>

<drv mrk="komb.tra0i">
  <kap>
    tra<tld/>i
  </kap>
  <snc mrk="komb.tra0i.harojn">
    <dif>
      Zorge <tld/>i:
      <ekz>
        li karesis &scirc;ian hararon, kiun anta&ubreve; la man&gcirc;o &scirc;i tra<tld/>is tiel zorgeme
        <fnt>
          <aut>B. Traven, trad. Dorothea kaj Hans-Georg Kaiser</aut>
          <vrk><url ref="https://www.karapaco.de/u/B.Traven/btraven_registaro.pdf"
              >Registaro</url></vrk>
          <lok>p. 338</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="komb.tra0i.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      <ref cel="sercx.tra0i">Traser&ccirc;i</ref>, tra<ref cel="plug.0i">plugi</ref> la&ubreve;vice:
      <ekz>
        la radiisto tra<tld/>is despere novajn ondolongojn
        <fnt>
          <aut>Vladimir Beekman</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/0089/0027.php"
              >Noktaj aviadistoj</url></vrk>
          <lok>&ccirc;ap. 2, p. 19</lok>
        </fnt>;
      </ekz>
      <ekz>
        ne estis senco ser&ccirc;i en &ccirc;i tiu arbaro a&ubreve; la najbaraj arbaroj, &ccirc;ar Glogo kaj Bobo
        jam trakombis ilin &ccirc;iujn
        <fnt>
          <aut>Upton Sinclair</aut>
          <vrk><url ref="https://verkoj.com/dn/inko/115-1.pdf"
              >La gnoma&ubreve;to</url></vrk>
          <lok>Kvara &ccirc;apitro, p. 29</lok>
        </fnt>;
      </ekz>
      <ekz>
        la helpantoj kun siaj ma&scirc;inoj atakas la kampojn kvaza&ubreve; armeo, en komuna takto,
        senhalte, me&hcirc;anike, ili tra<tld/>as la terenon
        <fnt>
          <bib>Monato</bib>
          <aut>Franz-Georg R&ouml;ssler</aut>
          <vrk>Ni fosu nian konton!</vrk>
          <lok>2010</lok>
