<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: ingest.xml,v 1.1 2026/11/25 21:58:14 afido Exp $">
    <kap>
      <rad>ingest</rad>/i
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="ingest.0i">
  <kap><tld/>i</kap>
  <snc mrk="ingest.0i.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      <ref tip="super" cel="korp.en0igi.enigi">Enkorpigi</ref> substancon (nutra&jcirc;on, venenon ktp.)
      tra la bu&scirc;o (kontraste al traha&ubreve;ta a&ubreve; trapulma enkorpigo):
      <ekz>
        <tld/>o de halucinogenoj
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        homo infektas sin per <tld/>o de nesufi&ccirc;e boligita, kruda <klr>[&#x2026;]</klr> viando,
        en kiu la cestodaj larvoj postvivis
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="glut.0i.ANA">gluti</ref>,
      <ref cel="mangx.0i.macxi">man&gcirc;i</ref>,
      <ref cel="trink.0i.gluti">trinki</ref>
    </refgrp>
    <trdgrp lng="de">
      <trd>aufnehmen <klr>(Nahrung usw. durch den Mund)</klr></trd>,
      <trd>einnehmen <klr>(Nahrung, Arznei)</klr></trd>,
      <trd>zu sich <ind>nehmen</ind></trd>
    </trdgrp>
    <trd lng="en">ingest</trd>
  </snc>
</drv>

  </art>


