    <kap>
      <rad>Kasandr</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="kasandr.0o">
  <kap><tld/>o</kap>
  <snc mrk="kasandr.0o.MIT">
    <uzo tip="fak">MIT</uzo>
    <dif>
      Filino de la troja re&gcirc;o Priamo, ricevinta de Apolono la doton anta&ubreve;vidi
      la estontecon sed poste malbenita tiel, ke neniu &scirc;in kredis:
      <ekz>
        la pensoj de tiuj grandaj viroj povus <klr>[&#8230;]</klr> gvidi la homaron al pli
        humana, pli sa&gcirc;a kaj pli feli&ccirc;a mondo, beda&ubreve;rinde, kiel spertis <tld/>o, ne
        sufi&ccirc;e da homoj estas sufi&ccirc;e sa&gcirc;aj kaj humilaj por a&ubreve;skulti
        <fnt>

          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2006/008723.php"
              >Malgranda estas bela</url></vrk>
              <bib>Monato</bib>
          <lok>2006/05, p. 12</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        mi estis vera <tld/>o <klr>(<ref tip="sin" cel="vid.nigre0ulo">nigrevidulo</ref>)</klr>
        <fnt>
          <vrk><url
          ref="https://www.radio-frei.de/index.php?iid=podcast&amp;ssuchtext=TURINGIO%20INTERNACIA&amp;ksubmit_show=Artikel&amp;kartikel_id=8887"
              >Der Kandelaber(Ludwig Bechstein)</url></vrk>
          <lok>Turingio Internacia 117, 2021-07-11</lok>
        </fnt>!
      </ekz>
    </dif>
    <trd lng="de">Kassandra</trd>
    <trd lng="en">Cassandra</trd>
    <trd lng="fr">Cassandre</trd>
    <trd lng="grc">&Kappa;&alfa;&sigma;&sigma;&alfa_ton;&ny;&delta;&rho;&alfa;</trd>
    <trd lng="nl">Cassandra</trd>
    <trd lng="ru">&c_K;&c_a;&c_s;&c_s;&c_a;&c_n;&c_d;&c_r;&c_a;</trd>
  </snc>
</drv>

