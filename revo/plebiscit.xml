<drv mrk="plebiscit.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">POL</uzo>
    <dif>
      Rekta <ref tip="super" cel="vocx.0dono">vo&ccirc;dono</ref> de &ccirc;iuj enlo&gcirc;antoj en iu teritorio
      pri &gcirc;ia apartena statuso a&ubreve; konstitucio:
      <ekz>
        la Brita Asocio por la Ligo de Nacioj havis duonmilionon da membroj, kaj unu
        <tld/>o, kiun &gcirc;i private organizis en la tuta lando, ricevis dekdu milionojn
        da respondoj memvolaj
        <fnt>
          <bib>FSp</bib>
          <lok>Tria Parto: Ligo De Nacioj</lok>
        </fnt>;
      </ekz>
      <ekz>
        okazis nacia referendumo en 1975 pri la da&ubreve;ra membri&gcirc;o de Britio en tiama E&ubreve;ropa
        Komunumo <klr>[&#8230;]</klr> tamen dum 36 jaroj <klr>[&#8230;]</klr> ne plu okazis simila
        tutlanda <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Paul Gubbins</aut>
          <vrk><url ref="&Monato;/2011/010372.php">La venkanto heredos &ccirc;ion ...</url></vrk>
          <lok>2011</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="sub" cel="refere1.0o">referendumo</ref>
    <ref tip="vid" cel="pleb.0o">plebo</ref>
    <trdgrp lng="be">
      <trd>&c_p;&c_l;&c_je;&c_b;&c_ib;&c_s;&c_c;&c_y;&c_t;</trd>,
      <trd>&c_u;&c_s;&c_je;&c_a;&c_g;&c_u;&c_l;&c_mol;&c_n;&c_a;&c_je;
      <ind>&c_g;&c_a;&c_l;&c_a;&c_s;&c_a;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_je;</ind></trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Plebiszit</trd>,
      <trd>Volksabstimmung</trd>
    </trdgrp>
    <trd lng="en">plebiscite</trd>
    <trd lng="fr">pl&eacute;biscite</trd>
    <trd lng="pl">plebiscyt</trd>
    <trd lng="ru">&c_p;&c_l;&c_je;&c_b;&c_i;&c_s;&c_c;&c_i;&c_t;</trd>
