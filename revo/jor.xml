<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: jor.xml,v 1.12 2026/09/06 20:00:21 afido Exp $">
<kap>
  <rad>jor</rad>/i  <fnt><bib>SPV</bib></fnt>
</kap>

<drv mrk="jor.0i">
  <kap><tld/>i</kap>
  <snc mrk="jor.0i.VET">
    <uzo tip="fak">AUT</uzo>
    <uzo tip="fak">AVI</uzo>
    <uzo tip="fak">MAR</uzo>
    <dif>
      Subite <ref tip="super" cel="glit.de0i">degliti</ref> flanken de sia normala vojo:
      <ekz>
        la ma&scirc;ino ek<tld/>as, sed tuj poste stabili&gcirc;as
        <fnt>
          <aut>J. Francis</aut>,
          <vrk><url ref="http://esperanto.net/literaturo/noveloj/13.html">
          La Tu&scirc;o de Morto</url></vrk>,
          <lok>en: Vitralo, 1960</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
       <ref cel="klin.de0igxi.MOV">deklini&gcirc;i<sncref/></ref>,
       <ref cel="devi.0i.FIG">devii<sncref/></ref>,
       <ref cel="voj.de0igxi">devoji&gcirc;i</ref>,
       <ref cel="flank.0igxi">forflanki&gcirc;i</ref>,
       <ref cel="gir.0i">giri</ref>
    </refgrp>
    <trdgrp lng="en">
      <trd>yaw <klr>(skid)</klr></trd>,
      <trd>skid</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_s;&c_mol;&c_l;&c_ib;&c_z;&c_g;&c_a;&c_c;&c_c;&c_a; <klr>(&c_a;&c_b;
  &c_t;&c_r;&c_a;&c_n;&c_s;&c_p;&c_a;&c_r;&c_t;&c_n;&c_y;&c_m;
  &c_s;&c_r;&c_o;&c_d;&c_k;&c_u;)</klr></trd>
  <trdgrp lng="ca">
    <trd>derrapar</trd>,
    <trd>guinyar</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>schlingern</trd>,
    <trd><klr>(seitlich)</klr> ausbrechen</trd>,
    <trd>schleudern</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>faire un <ind>&eacute;cart</ind></trd>,
    <trd>faire une <ind>embard&eacute;e</ind></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#27178;&#28369;&#12426;&#12377;&#12427;  <pr>&#12424;&#12371;&#12377;&#12409;&#12426;&#12377;&#12427;</pr></trd>,
    <trd>&#20559;&#36208;&#12377;&#12427;  <pr>&#12408;&#12435;&#12399;&#12375;&#12377;&#12427;</pr></trd>,
    <trd>&#20559;&#25594;&#12428;&#12377;&#12427;  <pr>&#12408;&#12435;&#12422;&#12428;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>po&sacute;lizgn&aogonek;&cacute; si&eogonek; w <ind>bok</ind></trd>,
    <trd>ze&sacute;lizgn&aogonek;&cacute; si&eogonek; na <ind>bok</ind></trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_s;&c_k;&c_o;&c_v;&c_z;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_b;&c_u;&c_k;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_v;&c_i;&c_l;&c_ja;&c_t;&c_i;</trd>,
    <trd>&c_v;&c_ib;&c_d;&c_h;&c_i;&c_l;&c_ja;&c_t;&c_i;&c_s;&c_ja; &c_v;&c_ib;&c_d; &c_k;&c_u;&c_r;&c_s;&c_u;</trd>
  </trdgrp>
</drv>

<drv mrk="jor.0o">
  <kap>
    <tld/>o
  </kap>
  <snc mrk="jor.0o.VET">
    <dif>
      Subita forflanki&gcirc;o de veturilo:
      <ekz>
        subita bremsado a&ubreve; direkto&scirc;an&gcirc;o de <klr>[&#8230;]</klr> peza veturilo
        povas ka&ubreve;zi dan&gcirc;eran, e&ccirc; mortigan <tld/>on
        <fnt>
          <aut>T. Steele</aut>
          <vrk>Konvinka Kamufla&jcirc;o</vrk>
          <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_s;&c_mol;&c_l;&c_ib;&c_z;&c_g;&c_a;&c_c;&c_je;&c_n;&c_mol;&c_n;&c_je;</trd>
  <trdgrp lng="ca">
    <trd>derrapada</trd>,
    <trd>guinyada</trd>
  </trdgrp>
  <trd lng="fr">embard&eacute;e</trd>
  <trdgrp lng="ja">
    <trd>&#27178;&#28369;&#12426;  <pr>&#12424;&#12371;&#12377;&#12409;&#12426;</pr></trd>,
    <trd>&#12473;&#12522;&#12483;&#12503;  <pr>&#12377;&#12426;&#12387;&#12407;</pr></trd>,
    <trd>&#33337;&#39318;&#25594;&#12428;  <pr>&#12379;&#12435;&#12375;&#12421;&#12422;&#12428;</pr></trd>,
    <trd>&#20559;&#36208;  <pr>&#12408;&#12435;&#12399;&#12375;</pr></trd>,
    <trd>&#20559;&#25594;&#12428;  <pr>&#12408;&#12435;&#12422;&#12428;</pr></trd>,
    <trd>&#12520;&#12540;</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>raptowne zboczenie z kursu</trd>,
    <trd>po&sacute;lizg boczny pojazdu</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_b;&c_ib;&c_ch;&c_n;&c_je; &c_k;&c_o;&c_v;&c_z;&c_a;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_b;&c_u;&c_k;&c_s;&c_u;&c_v;&c_a;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_v;&c_i;&c_l;&c_ja;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_z;&c_a;&c_n;&c_o;&c_s; <klr>(&c_k;&c_o;&c_l;&c_ib;&c_s;)</klr></trd>,
    <trd>&c_v;&c_ib;&c_d;&c_h;&c_i;&c_l;&c_je;&c_n;&c_n;&c_ja; &c_v;&c_ib;&c_d; &c_k;&c_u;&c_r;&c_s;&c_u;</trd>
  </trdgrp>
</drv>
</art>

