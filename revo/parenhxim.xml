<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: parenhxim.xml,v 1.2 2026/11/23 07:27:01 afido Exp $">
    <kap>
      <rad>paren&hcirc;im</rad>/o,
      <var><kap><rad var="k">parenkim</rad>/o <fnt><bib>PIV1</bib></fnt></kap></var>
    </kap>

<drv mrk="parenhxim.0o">
  <kap><tld/>o, <var><kap><tld var="k"/>o</kap></var></kap>
  <uzo tip="fak">FIZL</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="hist.0o">Histo</ref> de iu organo plenumanta specifan funkcion,
      aparte rilatan al metabolo:
      <ekz>
        &ccirc;efa histoelemento de la platverma korpo estas la <tld/>o <klr>[&#8230;]</klr>
        konsistanta el relative nediferenci&gcirc;intaj &ccirc;eloj
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>;
      </ekz>
      <ekz>
        ksilemo estas komplika histo de evoluintaj plantoj, kunmetita el tubetoj, lignaj
        fibroj kaj <tld var="k"/>aj &ccirc;eloj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=17333"
              >Ksilemo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Parenchym</trd>
    <trd lng="en">parenchyma</trd>
    <trd lng="fr">parenchyme</trd>
    <trd lng="nl">parenchym</trd>
    <trd lng="ru">&c_p;&c_a;&c_r;&c_je;&c_n;&c_h;&c_i;&c_m;&c_a;</trd>
    <trd lng="uk">&c_p;&c_a;&c_r;&c_je;&c_n;&c_h;&c_ib;&c_m;&c_a;</trd>
  </snc>
</drv>

  </art>

