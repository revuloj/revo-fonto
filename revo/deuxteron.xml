<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: deuxteron.xml,v 1.1 2026/11/08 18:04:28 afido Exp $">
    <kap>
      <rad>de&ubreve;teron</rad>/o <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="deuxteron.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">FIZ</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="kern.atom0o">Atomkerno</ref> de de&ubreve;terio kun atommaso 2 (<sup>2</sup>H<sup>+</sup>):
      <ekz>
        kiel lasta ekzemplo de <klr>[&#x2026;]</klr> elementa korpusklo mi povus mencii la
        <tld/>on
        <fnt>
          <bib>SR</bib>
          <aut>F. J. Belinfante</aut>
          <vrk>Pri nomoj de elementaj korpuskloj kaj de kelkaj instrumentoj</vrk>
          <lok>Scienca Revuo, nro 003/1949</lok>
        </fnt>;
      </ekz>
      <ekz>
        la fratoj <nom>Maurice</nom> kaj <nom>Gerson Goldhaber</nom> <klr>[&#x2026;]</klr> kontribuis al la fiziko de
        la 20-a jarcento per malkovroj kiuj inkludas la <klr>[&#x2026;]</klr> fotodiseri&gcirc;on
        de la <tld/>o
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=443994"
              >8610 Goldhaber</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Deuteron</trd>
    <trd lng="en">deuteron</trd>
    <trd lng="ru">&c_d;&c_je;&c_j;&c_t;&c_r;&c_o;&c_n;</trd>
  </snc>
</drv>

  </art>


