<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: triklini.xml,v 1.9 2026/08/03 11:42:45 revo Exp $">
    <kap><rad>triklini</rad>/o</kap>
  <drv mrk="triklini.0o">
    <kap><tld/>o</kap>
    <uzo tip="fak">HIS</uzo>
    <snc  mrk="triklini.0o.kusxbenkoj">
      <dif>
        En la antikva regiono mediteranea,  tri lignaj a&ubreve; &scirc;tonaj trilokaj ku&scirc;benkoj
        aran&gcirc;itaj  la&ubreve; tri flankojn de kvadrata  man&gcirc;otablo, sur kiuj oni duonku&scirc;is
         dum man&gcirc;ado:
        <ekz>
          mi plenigis la amforojn de Rustico apud la <tld/>o
          <fnt>
            <aut>Antonio Zozaya</aut>,
            <vrk>Terra-cotta</vrk>.
            <lok><url
ref="http://www.esperanto.es:8080/jspui/bitstream/11013/2975/1/Hispana%20Esperantisto_n56.pdf"
                    >Hispana Esperantisto</url>, n-ro 56 (marto 1922).  P&gcirc;.&nbsp;24.</lok>
          </fnt>;
         </ekz><ekz>
           komforte sidante sur unu el la sofoj de la
           <tld/>o, Publio Lentulus, kune kun sia amiko Flaminio
           Severus, finas la vesperman&gcirc;on
          <fnt>
            <aut>Francisco C&acirc;ndido Xavier, tr. L.C. Porto Carreiro  Neto</aut>,
            <vrk><url
ref="https://www.febnet.org.br/ba/file/livro%20em%20esperanto/Antauxdumiljaroj.pdf"
                   >Anta&ubreve; du mil jaroj&#8230;</url></vrk>.
            <lok>Rio-de-&Jcirc;anejro, 1951, p&gcirc;.&nbsp;26</lok>
          </fnt>.
         </ekz>
      </dif>
      <rim>
        Krom <tld/>oj ekzistis similaj aran&gcirc;oj entenantaj nur 2
        ku&scirc;benkojn. Ilia nomo latina estas &leftquot;biclinium&rightquot;,
        greke &leftquot;&delta;&jota;&kappa;&lambda;&jota_ton;&ny;&jota;&omikron;&rightquot; [di-klinio].
        Se Esperanto bezonas anka&ubreve; &ccirc;i tian terminon, tiam radik&scirc;para
        solvo estus retroderivi la radikon klini&middot;
        (kies signifo estus &#8249;&ccirc;etabla ku&scirc;benko&#8250;, kaj la etimo la greka
        &kappa;&lambda;&jota_ton;&ny;&eta;), el kiu regule deriveblus du&middot;klini&middot;o kaj tri&middot;klini&middot;o.
        <aut>Sergio Pokrovskij</aut>
      </rim>
    </snc>
    <trd lng="be">&c_t;&c_r;&c_y;&c_k;&c_l;&c_ib;&c_n;&c_ib;&c_j;</trd>
    <trd lng="de">Triclinium</trd>
    <trd lng="el">&tau;&rho;&jota;&kappa;&lambda;&jota_ton;&ny;&jota;&omikron;&ny;</trd>
    <trd lng="en">triclinium</trd>
    <trd lng="lat">triclinium</trd>
    <trd lng="pl">triclinium</trd>
    <trd lng="ru">&c_t;&c_r;&c_i;&c_k;&c_l;&c_i;&c_n;&c_i;&c_j;<klr> (&c_m;&c_je;&c_b;&c_je;&c_l;&c_mol;)</klr></trd>
  </drv>

  <drv mrk="triklini.0ejo">
    <kap><tld/>ejo</kap>
    <uzo tip="fak">HIS</uzo>
    <uzo tip="fak">ARKI</uzo>
    <snc>
      <dif>
        Man&gcirc;o&ccirc;ambro a&ubreve; salono a&ubreve; alia loko kun unu a&ubreve; pluraj <tld/>oj:
        <ekz>
          en somero oni ofte preferis liberaerajn <tld/>ejojn
          <fnt><bib>Vikio</bib></fnt>;
        </ekz><ekz>
          a&ubreve;di&gcirc;is pezaj pa&scirc;oj, kaj en la <tld/>ejon eniris centuriestro Apro
          <fnt>
            <aut>H. Sienkiewicz, tr. Lidja &Z;, prilaboris S. Pokrovskij</aut>:
            <vrk>Kien ci iras?</vrk>
            <lok>Suplemento al LOdE, 2026, &ccirc;ap.&nbsp;51&#170;</lok>
          </fnt>.
        </ekz>
      </dif>
    </snc>
    <trd lng="be">&c_t;&c_r;&c_y;&c_k;&c_l;&c_ib;&c_n;&c_ib;&c_j;</trd>
    <trd lng="de">Triclinium</trd>
    <trd lng="el">&tau;&rho;&jota;&kappa;&lambda;&jota_ton;&ny;&jota;&omikron;&ny;</trd>
    <trd lng="en">triclinium</trd>
    <trd lng="lat">triclinium</trd>
    <trd lng="pl">triclinium</trd>
    <trd lng="ru">&c_t;&c_r;&c_i;&c_k;&c_l;&c_i;&c_n;&c_i;&c_j;<klr> (&c_p;&c_o;&c_m;&c_je;&c_shch;&c_je;&c_n;&c_i;&c_je;)</klr></trd>
  </drv>
 </art>

