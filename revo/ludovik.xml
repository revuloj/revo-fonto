<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: ludovik.xml,v 1.15 2026/09/23 18:23:44 revo Exp $">
<kap>
  <ofc>*</ofc><ofc>7</ofc><rad>Ludovik</rad>/o
</kap>

<drv mrk="ludovik.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <uzo tip="fak">NOM</uzo>
  <snc mrk="ludovik.0o.vira">
    <dif>
      Vira <ref tip="lst" cel="nom.antaux0o" lst="voko:personaj_nomoj">anta&ubreve;nomo</ref>
      &gcirc;ermandevena:
      <ekz>
        <tld/>o, donu al mi panon
        <fnt><bib>F</bib>, <lok>&FE; 8</lok></fnt>;
      </ekz>
      <ekz>
        <tld/>o XIV estis granda malamiko de tabako kaj malpermesis uzi &gcirc;in &ccirc;e la kortego
        <fnt>
          <bib>FK</bib>
          <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
        </fnt>;
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_L;&c_ju;&c_d;&c_v;&c_ib;&c_k;</trd>,
    <trd>&c_L;&c_ju;&c_d;&c_v;&c_ib;&c_g;</trd>,
    <trd>&c_L;&c_ju;&c_d;&c_o;&c_v;&c_ib;&c_k;</trd>
  </trdgrp>
  <trd lng="br">Loeiz</trd>
  <trd lng="ca">Llu&iacute;s</trd>
  <trd lng="de">Ludwig</trd>
  <trdgrp lng="en">
    <trd>Louis</trd>,
    <trd>Ludovic</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>Luis</trd>,
    <trd>Ludovico</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>Louis</trd>,
    <trd>Ludovic</trd>
  </trdgrp>
  <trd lng="hu">Lajos</trd>
  <trdgrp lng="it">
    <trd>Luigi</trd>,
    <trd>Ludovico</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30EB;&#x30C9;&#x30D3;&#x30AF;</trd>,
    <trd>&#x30EB;&#x30FC;&#x30C8;&#x30D3;&#x30D2;</trd>
 </trdgrp>
 <trd lng="la">Ludovicus</trd>
 <trd lng="nl">Ludo</trd>
 <trd lng="pl">Ludwik</trd>
 <trdgrp lng="pt">
   <trd>Lu&iacute;s</trd>,
   <trd>Luiz</trd>
 </trdgrp>
 <trd lng="ru">&c_L;&c_ju;&c_d;&c_o;&c_v;&c_i;&c_k;</trd>
 <trdgrp lng="uk">
   <trd>&c_L;&c_ju;&c_d;&c_o;&c_v;&c_ib;&c_k;</trd>,
   <trd>&c_L;&c_ju;&c_d;&c_v;&c_ib;&c_gu;</trd>
 </trdgrp>
 <trdgrp lng="zh">
   <trd>&#x8DEF;&#x6613;&#x65AF; <pr>l&ugrave;y&igrave;s&imacron;</pr></trd>,
   <trd>&#x8DEF;&#x5FB7;&#x7DAD;&#x5E0C; <pr>l&ugrave;d&eacute;w&eacute;ix&imacron;</pr></trd>,
   <trd>&#x8DEF;&#x5FB7;&#x7EF4;&#x5E0C; <pr>l&ugrave;d&eacute;w&eacute;ix&imacron;</pr></trd>
</trdgrp>
</drv>

<drv mrk="ludovik.0ino">
  <kap>
    <tld/>ino, <var><kap><tld/>o</kap></var>
  </kap>
  <uzo tip="fak">NOM</uzo>
  <snc mrk="ludovik.0ino.virina">
    <dif>
      Virina nomo:
      <ekz>
        <tld/>ino <nom>Zminska</nom> akceptis &scirc;in multe pli malvarme kaj pli oficiale, ol anta&ubreve;e
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        mi vidis <tld/>on en la pre&gcirc;ejo, &scirc;i havis ru&gcirc;an &ccirc;apelon
        <fnt>
          <bib>IKr</bib>
          <lok>Neniam Plu!</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Ludowika</trd>
</drv>

</art>

