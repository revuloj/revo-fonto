      <rad>tiabendazol</rad>/o
    </kap>

<drv mrk="tiabendazol.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo><uzo tip="fak">MED</uzo>
  <snc mrk="tiabendazol.0o.KEM">
    <dif>
      &Hcirc;emia&jcirc;o, <frm>C<sub>10</sub>H<sub>7</sub>N<sub>3</sub>S</frm>,
      kiun oni uzas por kuraci de parazitaj vermoj kaj fungoj:
      <ekz>
        &gcirc;is nun ne atingeblaj muskolaj tri&hcirc;ineloj pereas post apliko de <tld/>o
        <fnt>
          <bib>SR</bib>
          <aut>S. Boev</aut>
          <vrk>Pri la cirkulado de Tri&hcirc;ineloj</vrk>
          <lok>Scienca Revuo, nro 69/1967</lok>
        </fnt>;
      </ekz>
      <ekz>
        en kazo de neoperacieblaj cistoj estas indikata &hcirc;emoterapio, aliaj studoj provis
        <tld/>o
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Thiabendazol</trd>
    <trd lng="en">thiabendazole</trd>
    <trd lng="fr">thiabendazole</trd>
    <trd lng="ru">&c_t;&c_i;&c_a;&c_b;&c_je;&c_n;&c_d;&c_a;&c_z;&c_o;&c_l;</trd>
  </snc>
</drv>

