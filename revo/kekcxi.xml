<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kekcxi.xml,v 1.1 2026/07/29 14:56:29 afido Exp $">
    <kap>
      <rad>kek&ccirc;i</rad>/o
    </kap>

<drv mrk="kekcxi.0">
  <kap><tld/>o</kap>
  <uzo tip="fak">LIN</uzo>
  <snc>
    <dif>
      Ano de majaa popolo, nuntempe vivantaj precipe en <ref tip="malprt" cel="gvatemal.G0o">Gvatemalo</ref>,
      <ref tip="malprt" cel="salvador.S0o.GEOG">Salvadoro</ref> kaj <ref tip="malprt" cel="beliz.B0o">Belizo</ref>:
      <ekz>
        420&#x202F;000 <tld/>oj vivas en tiuj tri landoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=271331"
              >Kek&ccirc;ioj</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        la lingvoj kak&ccirc;ikela, ke&ccirc;ua, mapu&ccirc;a, <tld/>a, mammajaa, gua&hcirc;ira, nasaa,
        zapoteka, mi&scirc;a, miskita, na&ubreve;atla, ajmara, gvarania kaj boruka estas kelkaj el
        la 25 originaj lingvoj kiuj a&ubreve;di&gcirc;is dum la ses tagoj de la du eventoj
        <fnt>
          <aut>Arnol Piedra Sosaya, trad. Luis Obando, Manuela Burghelea</aut>
          <vrk><url ref="https://eo.globalvoices.org/2020/01/6607/"
              >Lingva aktivismo por la estonteco de la homaro</url></vrk>
          <lok>Utopia mondo de kunvivantaj lingvoj</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Kekch&iacute;</trd>,
      <trd>Q&#x2019;eqchi&#x2019;</trd>
    </trdgrp>
    <trd lng="en">Q&#x2BC;eqchi&#x2BC;</trd>
  </snc>
</drv>

  </art>

