<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kvidicx.xml,v 1.1 2026/09/30 16:10:24 afido Exp $">
    <kap>
      <rad>kvidi&ccirc;</rad>/o
    </kap>

<drv mrk="kvidicx.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">SPO</uzo>
  <snc mrk="kvidicx.0o.SPO">
    <dif>
      Pilkludo ludata sur flugantaj balailoj en la romanoj pri <nom>Hari Potter</nom>;
      reala ludo surgrunda kun balailo inter la kruroj, inspirita de la romanoj
      <klr>(vd <ref cel="pilk.kvar0o">kvarpilko</ref>)</klr>:
      <ekz>
        pliaj programofertoj: okazis enkondukoj <klr>[pri]</klr> la bildlingvo <nom>Bliss</nom>,
        <klr>[&#x2026;]</klr> kosmo&scirc;ipo <nom>Rosetta</nom>, <tld/>o, la Verdaj Skoltoj
        <fnt>
          <bib>LOdE</bib>
          <aut>Lu Wunsch-Rolshoven</aut>
          <vrk><url ref="https://esperanto-ondo.ru/Ondo/244-lode.htm"
              >NR &ndash; multfaceta kiel &ccirc;iam</url></vrk>
          <lok>2015. &#x2116;2 (244)</lok>
        </fnt>;
      </ekz>
      <ekz>
        la unua mat&ccirc;o de <tld lit="K"/>o Grifindoro-<nom>Hufflepuff</nom> fini&gcirc;is per tio, ke <nom>Harry</nom>
        falis de sur la balailo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=203585"
              >Hari Poter kaj la Kaptito de Azkabano</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Quidditch</trd>,
      <trd>Quadball</trd>,
      <trd>Muggel-Quidditch</trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd>quidditch</trd>,
      <trd>quadball</trd>
    </trdgrp>
    <trdgrp lng="fr">
      <trd>quidditch</trd>,
      <trd>quadball</trd>
    </trdgrp>
  </snc>
</drv>

  </art>


