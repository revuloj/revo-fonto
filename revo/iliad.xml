<kap>
  <rad>Iliad</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="iliad.0o">
  <kap><tld/>o</kap>
  <snc mrk="iliad.0o.BELE">
    <uzo tip="fak">BELE</uzo>
    <dif>
      Antikva greklingva epopeo pri la konkero de la
      urbo Trojo fare de koaliciaj grekaj princoj, atribuita al
      <ref tip="vid" cel="homer.0o">Homero</ref>:
      <ekz>
        la unua kanto de la <tld/>o en traduko de A. Kofman
        <fnt><bib>Plumamikoj</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_Ib;&c_l;&c_ib;&c_ja;&c_d;&c_a;</trd>
  <trd lng="ca">Il&iacute;ada</trd>
  <trd lng="cs">Ilias</trd>
  <trd lng="cv">&c_I;&c_l;&c_i;&c_a;&c_d;&c_a;</trd>
  <trd lng="de">Ilias</trd>
  <trd lng="en">Iliad</trd>
  <trd lng="es">Il&iacute;ada</trd>
  <trd lng="fa">&a_A;&f_y;&a_l;&f_y;&a_A;&a_d;</trd>
  <trd lng="fr">Iliade</trd>
  <trd lng="hu">Ili&aacute;sz</trd>
  <trd lng="ja">&#12302;<ind>&#12452;&#12522;&#12450;&#12473;</ind>&#12303;</trd>
  <trd lng="nl">Ilias</trd>
  <trd lng="oc">Iliada</trd>
  <trd lng="pl">Iliada</trd>
  <trd lng="pt">Il&iacute;ada</trd>
  <trd lng="ru">&c_I;&c_l;&c_i;&c_a;&c_d;&c_a;</trd>
  <trd lng="sk">Ilias</trd>
  <trd lng="uk">&c_Ib;&c_l;&c_ib;&c_a;&c_d;&c_a; (&c_t;&c_v;&c_ib;&c_r; &c_G;&c_o;&c_m;&c_je;&c_r;&c_a;)</trd>
  <trdgrp lng="zh">
    <trd>&#20234;&#21033;&#20122;&#29305; <pr>y&#299;l&igrave;y&agrave;t&egrave;</pr></trd>,
    <trd>&#20234;&#21033;&#20122;&#29305; <pr>Y&#299;l&igrave;y&agrave;t&egrave;</pr></trd>
  </trdgrp>
</drv>
