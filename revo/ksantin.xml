<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: ksantin.xml,v 1.1 2026/11/20 20:41:58 afido Exp $">
    <kap>
      <rad>ksantin</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="ksantin.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      Flaveta <ref tip="super" cel="hxemi.0ajxo.substanco">&hcirc;emia&jcirc;o</ref>,
      <frm>C<sub>5</sub>H<sub>4</sub>N<sub>4</sub>O<sub>2</sub></frm>,
      interprodukto &ccirc;e la metabola transformo de purino al ureata acido:
      <ekz>
        bazoj, ne kutimaj por natura DNA &mdash; <tld/>o, hipoksantino, uracilo kaj
        metilcitozino, kiuj unui&gcirc;ante kun A,G,T,C, a&ubreve; inter si povus formi parojn kun
        la sama suma nombro de elektronoj en la tavoloj kiel paroj A-T kaj G-C
        <fnt>
          <bib>SR</bib>
          <aut>M. T. Popov</aut>
          <vrk>Formulo de la nativa DNA</vrk>
          <lok>Scienca Revuo, nro 137/1982</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Xanthin</trd>
    <trd lng="en">xanthine</trd>
    <trd lng="fr">xanthine</trd>
    <trd lng="ru">&c_k;&c_s;&c_a;&c_n;&c_t;&c_i;&c_n;</trd>
  </snc>
</drv>

  </art>


