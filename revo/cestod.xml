<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: cestod.xml,v 1.2 2026/11/22 09:45:36 afido Exp $">
    <kap>
      <rad>cestod</rad>/oj
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="cestod.0oj">
  <kap><tld/>oj</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
      <ref tip="lst" lst="voko:zoologiaj_klasoj" cel="klas.0o.BIO">Klaso</ref>
      de <ref tip="malprt" cel="verm.plat0oj">platvermoj</ref>
      (<trd lng="la">Cestoda</trd>),  kun kapo kaj segmentita korpo,
      parazitantaj en la intesto a&ubreve; cerbo de vertebruloj:
      <ekz>
        la longo de <tld/>a &ccirc;eno povas esti inter kelkaj milimetroj &gcirc;is pluraj metroj
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>;
      </ekz>
      <ekz>
        la evolua ciklo de la hompatogenaj <tld/>oj estas karakterizataj per tio, ke la
        larvaj stadioj disvolvi&gcirc;as en alia gastiganto ol la adoltaj vermoj
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Bandw&uuml;rmer</trd>,
      <trd>Zestoden</trd>,
      <trd>Cestoden</trd>
    </trdgrp>
    <trd lng="en">cestodes</trd>
    <trd lng="fr">cestodes</trd>
    <trd lng="ru">&c_l;&c_je;&c_n;&c_t;&c_o;&c_ch;&c_n;&c_y;&c_je; &c_ch;&c_je;&c_r;&c_v;&c_i;</trd>
    <trd lng="uk">&c_c;&c_je;&c_s;&c_t;&c_o;&c_d;&c_i;</trd>
  </snc>
</drv>

  </art>

