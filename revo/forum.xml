<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: forum.xml,v 1.27 2026/09/17 21:19:53 revo Exp $">
<kap>
<ofc>2</ofc>
<rad>forum</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="forum.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      (majuskle) <ref tip="super" cel="plac.0o.ARKI">Placo</ref> de
      antikva <ref tip="malprt" cel="rom.0o">Romo</ref>, kie la popolo pritraktis la publikajn
      aferojn:
      <ekz>
        la suno transiras al la templo de Jovo la Kapitola kaj komencas brili deflanke
        sur <tld lit="F"/>on
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        Kla&ubreve;dio la unuan fojon eniris la <tld lit="F"/>on en siaj konsula robo kaj
        insignaro
        <fnt>
          <bib>MJA</bib>
          <lok>Parto Kvina</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="nl">forum romanum</trd>
    <trd lng="pl">Forum Romanum</trd>
    <trdgrp lng="pt">
      <trd>foro</trd>,
      <trd>f&oacute;rum</trd>
    </trdgrp>
    <trd lng="ru">&c_f;&c_o;&c_r;&c_u;&c_m;</trd>
  </snc>
  <snc mrk="forum.0o.kadro">
    <dif>
      Loko, organiza <ref tip="super" cel="kadr.0o.kondicxoj">kadro</ref>,
      en kiu oni diskutas pri publikaj aferoj:
      <ekz>
        la <tld/>oj <klr>[&#x2026;]</klr> eksvarmis per homoj
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XXIX</lok>
        </fnt>;
      </ekz>
      <ekz>
        multaj <klr>[&#x2026;]</klr> lingvoj sonis &ccirc;i-salone, kiel en giganta babela <tld/>o
        <fnt>
          <bib>CKv</bib>
          <lok>19</lok>
        </fnt>;
      </ekz>
      <ekz>
        la oratoraj konkursoj estas ta&ubreve;ga <tld/>o, en kiu gejunuloj de diversaj nacioj
        <klr>[&#x2026;]</klr> povas libere inter&scirc;an&gcirc;i ideojn kaj a&ubreve;digi siajn vo&ccirc;ojn
        <fnt>
          <bib>EeP</bib>
          <lok>Tria Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Kongresoj de TEJO nun alprenis la karakteron de <tld/>o, en kiu la
        partoprenantoj priparolas difinitan kongresan temon
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        okazis ses <tld/>oj: pri membreco kaj kotizoj, bu&gcirc;eto kaj financoj, konsciigo,
        kapabligo, kunordigo kaj komunumaj aferoj
        <fnt>
          <bib>Kon11</bib>
          <lok>La kongresa movadumo dun la Universala Kongreso (Kirill Novi&ccirc;enko)</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Junulara <tld lit="F"/>o de UNESKO
        <fnt>
          <bib>Kon11</bib>
          <lok>TEJO/UEA aktive reprezentita &ccirc;e la Junulara Forumo de UNESKO</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Monda Ekonomia <tld lit="F"/>o de <nom>Davos</nom>
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="konsili.0o">konsilio</ref>,
      <ref cel="panel.0o.diskuto">panelo<sncref/></ref>,
      <ref cel="platform.0o.INF">platformo<sncref/></ref>
    </refgrp>
    <trd lng="nl">forum</trd>
    <trd lng="pl">forum</trd>
    <trdgrp lng="pt">
      <trd>foro</trd>,
      <trd>tribuna</trd>,
      <trd>f&oacute;rum</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_f;&c_o;&c_r;&c_u;&c_m;</trd>, <trd>&c_t;&c_o;&c_r;&c_zh;&c_i;&c_shch;&c_je;</trd>,
      <trd>&c_v;&c_je;&c_ch;&c_je;</trd>
     </trdgrp>
  </snc>
  <snc mrk="forum.0o.komp">
    <uzo tip="fak">RET</uzo>
    <fnt><lok><url ref="&KompLeks;/F.html#FORUMO">KompLeks</url></lok></fnt>
    <dif>
      Nefermita <ref tip="super" cel="grup.diskut0o">diskutgrupo</ref> en
      <ref tip="malprt" cel="ret.malloka_0o.KOMP">malloka komputila
      reto</ref>:
      <ekz>
        <tld/>oj por diskuto / spertinter&scirc;an&gcirc;o inter la lernantoj
        <fnt>
          <bib>Kon11</bib>
          <lok>Herzberg, la Esperanto-urbo kiu proponas lingvan kaj movadan klerigadon</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o, simila al <nom>Reddid</nom>, en kiu vi povas enmeti kontribua&jcirc;ojn, kiel artikoloj,
        bildoj a&ubreve; filmoj
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        ni lan&ccirc;is anka&ubreve; kunlaboran <tld/>on &leftquot;Interredaktore&rightquot;, enkadre de kiu ni
        distribuadis per retpo&scirc;to diversajn artikolojn al redakcioj de E-gazetoj
        <fnt>
          <bib>Kon11</bib>
          <lok>Intervjuo</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="prt" cel="afisx.0i">afi&scirc;i</ref>
    <rim>
      La&ubreve; <fnt><bib>BL</bib></fnt>: (en retaj kuntekstoj) anka&ubreve; eblas diri <ke>diskutejo</ke>.
    </rim>
    <trdgrp lng="en">
      <trd>forum</trd>, <trd>newsgroup</trd>
    </trdgrp>
    <trd lng="nl">nieuwsgroep<klr tip="ind"> (Internet)</klr></trd>
    <trd lng="pl">grupa dyskusyjna</trd>
    <trdgrp lng="pt">
      <trd>f&oacute;rum</trd>,
      <trd>newsgroup</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_t;&c_je;&c_l;&c_je;&c_k;&c_o;&c_n;&c_f;&c_je;&c_r;&c_je;&c_n;&c_c;&c_i;&c_ja;</trd>,
      <trd>&c_d;&c_i;&c_s;&c_k;&c_u;&c_s;&c_s;&c_i;&c_o;&c_n;&c_n;&c_a;&c_ja; &c_g;&c_r;&c_u;&c_p;&c_p;&c_a;</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_f;&c_o;&c_r;&c_u;&c_m;</trd>
  <trd lng="cs">f&oacute;rum</trd>
  <trd lng="de">Forum</trd>
  <trd lng="es">foro</trd>
  <trdgrp lng="fr">
    <trd>forum</trd>,
    <trd>groupe de discussion<klr tip="ind"> (Internet)</klr></trd>,
    <trd>lieu de d&eacute;bat</trd>,
    <trd>tribunal<klr tip="ind"> (jugement de
    l'opinion)</klr></trd></trdgrp>
  <trdgrp lng="hu">
    <trd>f&oacute;rum</trd>,
    <trd>vitaf&oacute;rum<klr tip="ind"> (Internet)</klr></trd>
  </trdgrp>
  <trd lng="ja">&#x30D5;&#x30A9;&#x30FC;&#x30E9;&#x30E0;  <pr>&#x3075;&#x3049;&#x30FC;&#x3089;&#x3080;</pr></trd>
  <trd lng="pl">forum</trd>
  <trd lng="sk">f&oacute;rum</trd>
  <trd lng="uk">&c_f;&c_o;&c_r;&c_u;&c_m;</trd>
  <trdgrp lng="zh">
    <trd>&#x8AD6;&#x58C7; <pr>l&ugrave;nt&aacute;n</pr></trd>,
    <trd>&#x8A0E;&#x8AD6;&#x6703; <pr>t&#x1CE;ol&ugrave;nhu&igrave;</pr></trd>
  </trdgrp>
</drv>
</art>
