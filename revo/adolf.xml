<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: adolf.xml,v 1.17 2026/07/30 14:28:50 revo Exp $">
<kap>
  <rad>Adolf</rad>/o
  <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="adolf.0o">
  <kap><tld/>o</kap>
  <snc mrk="adolf.0o.NOM">
    <dif>
      Vira <ref tip="lst" cel="nom.antaux0o" lst="voko:personaj_nomoj">anta&ubreve;nomo</ref>
      &gcirc;ermandevena:
      <ekz>
        du viglaj knaboj, <klr>[&#x2026;]</klr> nomataj Jono kaj <tld/>o
        <fnt>
          <bib>Fab1</bib>
          <lok>Floroj de la malgranda Ida</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o estis metallaboristo
        <fnt><bib>InfanTorent2</bib>, <lok>unua parto, &ccirc;apitro
        2a</lok></fnt>;
      </ekz>
      <ekz>
        la itala ministro pri eksterlanda komerco, <tld/>o Urso, deklaris, ke por Italio
        Albanio estas la enirejo en Balkanion
        <fnt>
          <bib>Monato</bib>
          <aut>Bardhyl Selimi</aut>
          <vrk><url ref="&Monato;/2003/007967.html"
              >La Oka Koridoro</url></vrk>
          <lok>2003</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_A;&c_d;&c_o;&c_l;&c_mol;&c_f;</trd>
  <trd lng="ca">Adolf</trd>
  <trd lng="cs">Adolf</trd>
  <trd lng="de">Adolf</trd>
  <trdgrp lng="en">
    <trd>Adolf</trd>
    <trd>Adolph</trd>
  </trdgrp>
  <trd lng="es">Adolfo</trd>
  <trd lng="fr">Adolphe</trd>
  <trd lng="hu">Adolf</trd>
  <trd lng="it">Adolfo</trd>
  <trd lng="ja">&#x30A2;&#x30C9;&#x30EB;&#x30D5;</trd>
  <trd lng="nl">Adolf</trd>
  <trd lng="pl">Adolf</trd>
  <trd lng="pt">Adolfo</trd>
  <trd lng="sk">Adolf</trd>
  <trd lng="sv">Adolf</trd>
</drv>
</art>

