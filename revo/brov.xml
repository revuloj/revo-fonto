<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: brov.xml,v 1.35 2026/10/27 12:00:19 revo Exp $">
<kap>
<ofc>*</ofc>
  <rad>brov</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="brov.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="brov.0o.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Arkoforma superokula <ref tip="super" cel="tuf.har0o">hartufo</ref>:
      <ekz>
        sian kapon kaj sian barbon kaj la <tld/>ojn de siaj okuloj, &ccirc;iujn siajn harojn
        li forrazos
        <fnt>
          <bib>MT</bib>
          <lok>Levidoj 14:9</lok>
        </fnt>;
      </ekz>
      <ekz>
        li havis longajn ostecajn fingrojn kaj grizajn tufajn <tld/>ojn
        <fnt>
          <bib>Fab3</bib>
          <lok>Nokta &ccirc;apo de fra&ubreve;lo</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur la kavi&gcirc;intaj vangoj estis makuloj de sanga ru&gcirc;o, la <tld/>ojn dividis
        profunda sulko
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        delikata profilo kun malkavaj <tld/>oj, apartigitaj de la sulko plena de
        melankolio kaj sa&gcirc;o
        <fnt>
          <bib>IK</bib>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> levis supren la <tld/>ojn, kiel homo, kiu permesas al iu
        mensogi, sed scias pri la mensogo
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro VI</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="en">eyebrow</trd>
    <trdgrp lng="zh">
    <trd>&#30473; <pr>m&eacute;i</pr></trd>,
    <trd>&#30473;&#27611; <pr>m&eacute;im&aacute;o</pr></trd>,
    <trd>&#30473;&#23574; <pr>m&eacute;iji&amacron;n</pr></trd>,
    <trd>&#30473;&#27611; <pr>m&eacute;imao</pr></trd>
  </trdgrp>
</snc>
  <trd lng="be">&c_b;&c_r;&c_y;&c_v;&c_o;</trd>
  <trd lng="bg">&c_v;&c_je;&c_zh;&c_d;&c_a;</trd>
  <trd lng="br">abrant</trd>
  <trd lng="ca">cella</trd>
  <trd lng="cs">obo&ccaron;&iacute;</trd>
  <trd lng="cv">&c_h;&c_a;&c_r;&c_sh;&#1233;</trd>
  <trd lng="de">Augenbraue</trd>
  <trd lng="el">&phi;&rho;&ypsilon_ton;&delta;&jota;</trd>
  <trd lng="es">ceja</trd>
  <trd lng="fr">sourcil</trd>
  <trd lng="he">&#8503;&bet;&he;</trd>
  <trd lng="hu">szem&ouml;ld&ouml;k</trd>
  <trd lng="id">alis</trd>
  <trd lng="it">sopracciglio</trd>
  <trd lng="ja">&#30473;  <pr>&#12414;&#12422;</pr></trd>
  <trd lng="nl">wenkbrauw</trd>
  <trdgrp lng="oc">
    <trd>subrecilha</trd>,
    <trd>subercilha</trd>
  </trdgrp>
  <trd lng="pl">brew</trd>
  <trd lng="pt">sobrancelha</trd>
  <trd lng="ro">spr&acirc;ncene</trd>
  <trd lng="ru">&c_b;&c_r;&c_o;&c_v;&c_mol;</trd>
  <trd lng="sk">obo&ccaron;ie</trd>
  <trd lng="sv">&ouml;gonbryn</trd>
  <trd lng="uk">&c_b;&c_r;&c_o;&c_v;&c_a;</trd>
</drv>

<drv mrk="brov.kuntirila0ojn">
  <kap>kuntiri la <tld/>ojn,
  <var><kap>sulkigi la <tld/>ojn</kap></var></kap>
  <snc mrk="brov.kuntirila0ojn.MIEN">
    <dif>
      Stre&ccirc;i kaj interproksimigi la <tld/>ojn,
      signante ekatenton, dubon, maltrankvilon...:
      <ekz>
        viaj vortoj estas malrespektaj diris la knabino sulkigante la <tld/>ojn
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro III</lok>
        </fnt>;
      </ekz>
      <ekz>
        stranga ideo! murmuris Andreo, sulkigante siajn
        <tld/>ojn
        <fnt><aut>H. Vallienne</aut>, <vrk>Kastelo de Prelongo</vrk>,
        <lok>1907</lok></fnt>;
      </ekz>
      <ekz>
        <nom>Spada</nom> severe kuntiris la <tld/>ojn
        <fnt><aut>I. Nemere</aut>, <vrk>Sur Kampo Granita</vrk>,
        <lok>1983</lok></fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="frunt.0o.ANA">frunto</ref>
  <trdgrp lng="en">
    <trd>frown</trd>,
    <trd>knit one's <ind>brows</ind></trd>
  </trdgrp>
  </snc>
  <trd lng="be">&c_s;&c_s;&c_u;&c_n;&c_u;&c_c;&c_mol; <ind>&c_b;&c_r;&c_o;&c_v;&c_y;</ind></trd>
  <trd lng="bg">&c_s;&c_m;&c_r;&c_malmol;&c_shch;&c_v;&c_a;&c_m; &c_v;&c_je;&c_zh;&c_d;&c_i;</trd>
  <trdgrp lng="ca">
    <trd>arrufar les celles</trd>,
    <trd>arronsar les celles</trd>,
    <trd>arrunsar les celles</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>st&aacute;hnout obo&ccaron;&iacute;</trd>,
    <trd>svra&scaron;tit obo&ccaron;&iacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>die Augenbrauen runzeln</trd>,
    <trd>die <ind>Augenbrauen</ind> zusammen ziehen</trd>
  </trdgrp>
  <trd lng="fr">froncer les sourcils</trd>
  <trdgrp lng="id">
    <trd><baz>kerut</baz>mengerutkan dahi kening</trd>,
    <trd><baz>kernyit</baz>mengernyit</trd>,
    <trd><baz>kernyit</baz>mengernyitkan dahi/kening</trd>
  </trdgrp>
  <trd lng="ja">&#12414;&#12422;&#12434;&#12402;&#12381;&#12417;&#12427;</trd>
  <trd lng="pl">marszczy&cacute; <ind>brwi</ind></trd>
  <trd lng="sk">stiahnu&tcaron; obo&ccaron;ie</trd>
</drv>
</art>
