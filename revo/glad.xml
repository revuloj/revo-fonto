<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: glad.xml,v 1.35 2026/08/14 13:59:41 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>glad</rad>/i
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="glad.0i">
  <kap><ofc>*</ofc><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="glad.0i.glatigi">
    <dif>
      (tukojn, vestojn ktp) <ref tip="super" cel="glat.0igi">Glatigi</ref> per varmega ilo,
      &gcirc;in prem&scirc;ovante tien kaj reen:
      <ekz>
        &scirc;i certe e&ccirc; ne scias lavi nek <tld/>i
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[mi]</klr> portis malpurajn vesta&jcirc;ojn al la lavejo, frotpurigis, <tld/>is
        <fnt>
          <bib>VaK</bib>
          <lok>Sepa &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        li komencas el sub la kravato <tld/>i sian barbon
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto unua</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_r;&c_a;&c_s;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>
  <trd lng="bg">&c_g;&c_l;&c_a;&c_d;&c_ja;<klr tip="amb"> (&c_s; &c_ju;&c_t;&c_i;&c_ja;)</klr></trd>
  <trd lng="ca">planxar</trd>
  <trd lng="cs">&zcaron;ehlit</trd>
  <trdgrp lng="de">
     <trd>pl&auml;tten</trd>,
     <trd>b&uuml;geln</trd></trdgrp>
  <trd lng="en">to iron</trd>
  <trd lng="es">planchar</trd>
  <trdgrp lng="fr">
    <trd>repasser<klr tip="ind"> (avec un fer)</klr></trd>,
    <trd>lisser</trd>
  </trdgrp>
  <trd lng="hu">vasal</trd>
  <trd lng="id"><baz>setrika</baz>menyetrika</trd>
  <trd lng="ja">&#x30A2;&#x30A4;&#x30ED;&#x30F3;&#x3092;&#x304B;&#x3051;&#x308B;
  <pr>&#x3042;&#x3044;&#x308D;&#x3093;&#x3092;&#x304B;&#x3051;&#x308B;</pr></trd>
  <trd lng="nl">strijken</trd>
  <trd lng="pl">prasowa&cacute;<klr> (&zdot;elazkiem)</klr></trd>
  <trdgrp lng="pt">
   <trd>passar a ferro</trd>,
   <trd>alisar roupa<klr tip="amb"> (com ferro de passar)</klr></trd>
  </trdgrp>
  <trd lng="ro">c&abreve;lca</trd>
  <trd lng="ru">&c_g;&c_l;&c_a;&c_d;&c_i;&c_t;&c_mol;<klr tip="amb">
  (&c_u;&c_t;&c_ju;&c_g;&c_o;&c_m;)</klr></trd>
  <trdgrp lng="sk">
    <trd>hladi&tcaron;</trd>,
    <trd>&zcaron;ehli&tcaron;</trd>
  </trdgrp>
  <trd lng="tr">&uuml;t&uuml;lemek</trd>
  <trd lng="uk">&c_p;&c_r;&c_a;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  <trdgrp lng="zh">
    <trd>&#x7185; <pr>y&ugrave;n</pr></trd>,
    <trd>&#x70EB; <pr>t&agrave;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="glad.0ilo">
  <kap><tld/>ilo</kap>
  <snc>
    <dif>
      Fera ilo por <tld/>i:
      <ekz>
        la tajloro &scirc;losis en la &scirc;ranko la kudrilon, fadenojn, <tld/>ilon kaj ulnon
        <fnt>
          <bib>ElektFab</bib>
          <lok>Tablo , la orazeno kaj bastono el sako</lok>
        </fnt>;
      </ekz>
      <ekz>
        oni ilin amelis, pendigis super se&gcirc;o en la sunlumo, kaj poste oni ilin metis sur
        la <ind><tld/>otabulo</ind>n, tiam venis la varmega <tld/>ilo
        <fnt>
          <bib>Fab3</bib>
          <lok>Kolumo</lok>
        </fnt>;
        <trd lng="de">B&uuml;gelbrett</trd>
      </ekz>
      <ekz>
        varma <tld/>ilo glatigis surfacon de la &ccirc;emizaj butontruoj
        <fnt>
          <bib>OIP</bib>
          <lok>Ombro sur interna pejza&gcirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur bretaro vici&gcirc;as jam rusti&gcirc;intaj bra&gcirc;-<tld/>iloj
        <fnt>
          <bib>Monato</bib>
          <aut>Laimius Stra&zcaron;nickas</aut>
          <vrk><url ref="&Monato;/2004/008445.html"
              >Kolekti antikva&jcirc;ojn</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_r;&c_a;&c_s;</trd>
  <trd lng="bg">&c_ju;&c_t;&c_i;&c_ja;</trd>
  <trd lng="ca">planxa</trd>
  <trd lng="cs">&zcaron;ehli&ccaron;ka</trd>
  <trdgrp lng="de">
    <trd>B&uuml;geleisen</trd>,
    <trd>Gl&auml;tteisen <klr>(svisgermana)</klr></trd>
  </trdgrp>
  <trd lng="en">iron</trd>
  <trd lng="es">plancha</trd>
  <trd lng="fr">fer &agrave; repasser</trd>
  <trd lng="hu">vasal&oacute;</trd>
  <trd lng="id">setrika</trd>
  <trdgrp lng="ja">
    <trd>&#x30A2;&#x30A4;&#x30ED;&#x30F3;</trd>,
    <trd>&#x3053;&#x3066;</trd>
  </trdgrp>
  <trd lng="nl">strijkijzer</trd>
  <trdgrp lng="pl">
     <trd>&zdot;elazko</trd>,
     <trd>prasowalnica</trd>
  </trdgrp>
  <trd lng="pt">ferro de passar roupa</trd>
  <trd lng="ro">fier de c&abreve;lcat</trd>
  <trd lng="ru">&c_u;&c_t;&c_ju;&c_g;</trd>
  <trd lng="sk">&zcaron;ehli&ccaron;ka</trd>
  <trd lng="tr">&uuml;t&uuml;</trd>
  <trd lng="uk">&c_p;&c_r;&c_a;&c_s;&c_k;&c_a;</trd>
  <trd lng="zh">&#x71A8;&#x6597; <pr>y&ugrave;nd&#x1D2;u</pr></trd>
</drv>

<drv mrk="glad.0isto">
  <kap><tld/>isto</kap>
  <snc>
    <dif>
      Persono, kies metio estas <tld/>i.
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_r;&c_a;&c_s;&c_a;&c_v;&c_a;&c_l;&c_mol;&c_sh;&c_ch;&c_y;&c_k;</trd>
  <trd lng="ca">planxador</trd>
  <trd lng="de">B&uuml;gler</trd>
  <trdgrp lng="en"><trd>presser</trd>, <trd>ironer</trd></trdgrp>
  <trd lng="es">planchador</trd>
  <trd lng="fr">repasseur<klr tip="ind"> (de linge)</klr></trd>
  <trd lng="hu">vasal&oacute;<klr tip="ind"> (munk&aacute;s)</klr></trd>
  <trd lng="id"><baz>setrika</baz>penyetrika</trd>
  <trd lng="nl">strijker<klr tip="ind"> (van kleren)</klr></trd>
  <trdgrp lng="pl">
     <trd>prasowacz</trd>,
     <trd>prasowaczka</trd>
  </trdgrp>
  <trd lng="pt">passador<klr tip="amb"> (de roupa)</klr></trd>
  <trd lng="ru">&c_g;&c_l;&c_a;&c_d;&c_i;&c_l;&c_mol;&c_shch;&c_i;&c_k;</trd>
</drv>

<drv mrk="glad.0istino">
  <kap><tld/>istino</kap>
  <snc>
    <dif>
      Virino, kies metio estas <tld/>i.
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_r;&c_a;&c_s;&c_a;&c_v;&c_a;&c_l;&c_mol;&c_sh;&c_ch;&c_y;&c_c;&c_a;</trd>
  <trd lng="ca">planxadora</trd>
  <trdgrp lng="de">
    <trd>B&uuml;gelfrau</trd>,
    <trd>B&uuml;glerin</trd>
  </trdgrp>
  <trd lng="es">planchadora</trd>
  <trd lng="fr">repasseuse<klr tip="ind"> (de linge)</klr></trd>
  <trd lng="hu">vasal&oacute;n&odblac;</trd>
  <trd lng="id"><baz>setrika</baz>penyetrika perempuan</trd>
  <trd lng="nl">strijkster<klr tip="ind"> (van kleren)</klr></trd>
  <trdgrp lng="pl">
     <trd>prasowaczka</trd>
  </trdgrp>
  <trd lng="pt">passadeira<klr tip="amb"> (de roupa)</klr></trd>
  <trd lng="ru">&c_g;&c_l;&c_a;&c_d;&c_i;&c_l;&c_mol;&c_shch;&c_i;&c_c;&c_a;</trd>
  <trd lng="uk">&c_p;&c_r;&c_a;&c_s;&c_u;&c_v;&c_a;&c_l;&c_mol;&c_n;&c_i;&c_c;&c_ja;</trd>
</drv>

<drv mrk="glad.ne0enda">
  <kap>ne<tld/>enda</kap>
  <snc>
      <ref tip="dif" cel="cxif.ne0ebla">ne&ccirc;ifebla</ref>
  </snc>
  <trdgrp lng="be">
    <trd>&c_ja;&c_k;&c_ib; &c_n;&c_je; &c_p;&c_a;&c_t;&c_r;&c_a;&c_b;&c_u;&c_je; <ind>&c_p;&c_r;&c_a;&c_s;&c_a;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_ja;</ind></trd>,
    <trd>&c_ja;&c_k;&c_ib; &c_n;&c_ja; <ind>&c_m;&c_n;&c_je;&c_c;&c_c;&c_a;</ind></trd>
  </trdgrp>
  <trd lng="ca">no planxable</trd>
  <trd lng="cs">ne&zcaron;ehliv&yacute;</trd>
  <trdgrp lng="de">
    <trd>b&uuml;gelfrei</trd>,
    <trd>knitterfest</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>wrinkle-free</trd>,
    <trd>no-iron</trd>
  </trdgrp>
  <trd lng="es">no planchable</trd>
  <trd lng="fr">infroissable</trd>
  <trdgrp lng="id">
    <trd>tidak perlu disetrika</trd>,
    <trd>bebas kusut</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30D1;&#x30FC;&#x30DE;&#x30CD;&#x30F3;&#x30C8;&#x30D7;&#x30EC;&#x30B9;&#x52A0;&#x5DE5;&#x306E;

    <pr>&#x30D1;&#x30FC;&#x30DE;&#x30CD;&#x30F3;&#x30C8;&#x30D7;&#x30EC;&#x30B9;&#x304B;&#x3053;&#x3046;&#x306E;</pr></trd>,
    <trd>&#x30CE;&#x30FC;&#x30A2;&#x30A4;&#x30ED;&#x30F3;&#x306E;</trd>
  </trdgrp>
  <trd lng="pl">niemn&aogonek;cy</trd>
  <trd lng="sk">ne&zcaron;ehliv&yacute;</trd>
  <trdgrp lng="uk">
    <trd>&c_ja;&c_k;&c_i;&c_j; &c_n;&c_je; &c_m;&c_n;&c_je;&c_t;&c_mol;&c_s;&c_ja;</trd>,
    <trd>&c_ja;&c_k;&c_o;&c_g;&c_o; &c_n;&c_je; &c_t;&c_r;&c_je;&c_b;&c_a; &c_p;&c_r;&c_a;&c_s;&c_u;&c_v;&c_a;&c_t;&c_i; (&c_p;&c_r;&c_o;
    &c_t;&c_k;&c_a;&c_n;&c_i;&c_n;&c_u;)</trd>
  </trdgrp>
  <trd lng="zh">&#x514D;&#x70EB; <pr>mi&#x1CE;nt&agrave;ng</pr></trd>
</drv>

</art>
