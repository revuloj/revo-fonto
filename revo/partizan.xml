<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: partizan.xml,v 1.16 2026/10/31 20:00:19 revo Exp $">
<kap>
  <rad>partizan</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="partizan.0o">
  <kap><tld/>o</kap>
  <snc mrk="partizan.0o.MIL">
    <uzo tip="fak">MIL</uzo>
    <dif>
      Civilulo batalanta kontra&ubreve; fremda okupacio:
      <ekz>
        legendo flustras pri la <tld/>oj /
        de l' jugoslava liberig-milito
        <fnt>
          <aut>K. Kalocsay</aut>,
          <vrk><url
          ref="http://donh.best.vwh.net/Esperanto/Literaturo/Poezio/kalocsay/partizanoj.html">
          Partizanoj</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        kaj se mi mortos kiel <tld/>o /
        vi devos entombigi min
        <fnt>
          <aut>-, trad. R. Corsetti</aut>,
          <vrk>Ho belulin'</vrk>,
          <lok>en: <url ref="http://www.cinquantini.it/esperant/kantaro.html">
          Kantaro</url>, 2006-10</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="insurekci.0ano.POL">insurekciano</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_r;&c_t;&c_y;&c_z;&c_a;&c_n;</trd>
  <trd lng="bg">&c_p;&c_a;&c_r;&c_t;&c_i;&c_z;&c_a;&c_n;&c_i;&c_n;</trd>
  <trd lng="ca">partis&agrave;</trd>
  <trd lng="cs">partyz&aacute;n</trd>
  <trd lng="de">Partisan</trd>
  <trd lng="en">partisan</trd>
  <trd lng="fr">r&eacute;sistant<klr> (subst.)</klr></trd>
  <trd lng="it">partigiano<klr> (sost.)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#12497;&#12523;&#12481;&#12470;&#12531;</trd>,
    <trd>&#20449;&#22857;&#32773;  <pr>&#12375;&#12435;&#12413;&#12358;&#12375;&#12419;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>partizaan</trd>,
    <trd>guerrillastrijder</trd>
  </trdgrp>
  <trd lng="pl">partyzant</trd>
  <trdgrp lng="pt">
    <trd>"<ind>partisan</ind>"</trd>,
    <trd>guerrilheiro</trd>
  </trdgrp>
  <trd lng="ro">partizan  <klr>(armat&abreve;)</klr></trd>
  <trd lng="sk">partiz&aacute;n</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_r;&c_i;&c_h;&c_i;&c_l;&c_mol;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_b;&c_je;&c_z;&c_u;&c_m;&c_o;&c_v;&c_n;&c_i;&c_j; &c_p;&c_r;&c_i;&c_h;&c_i;&c_l;&c_mol;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_p;&c_o;&c_s;&c_l;&c_ib;&c_d;&c_o;&c_v;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_p;&c_a;&c_r;&c_t;&c_i;&c_z;&c_a;&c_n;</trd>
  </trdgrp>
</drv>

<drv mrk="partizan.0a">
  <kap><tld/>a</kap>
  <snc mrk="partizan.0a.MIL">
    <dif>
      Rilata al <tld/>oj, al ilia agado:
      <ekz>
        tiun tagon mi trafis <tld/>anan grupon
        <fnt>
          <aut>A. Montagner</aut>,
          <vrk><url ref="http://www.andreamontagner.it/">
          Lingvo por &ccirc;iuj</url></vrk>,
          <lok>2005-08-06</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_r;&c_t;&c_y;&c_z;&c_a;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">partis&agrave;</trd>
  <trd lng="en">partisan</trd>
  <trd lng="fr">r&eacute;sistant<klr> (adj., arm&eacute;)</klr></trd>
  <trd lng="it">partigiano<klr> (agg.)</klr></trd>
  <trd lng="nl">partizanen-</trd>
  <trd lng="pl">partyzancki</trd>
  <trd lng="ro">partizan&abreve;</trd>
  <trd lng="uk">&c_p;&c_a;&c_r;&c_t;&c_i;&c_z;&c_a;&c_n;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
</drv>
</art>

