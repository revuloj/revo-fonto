<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kardan.xml,v 1.19 2026/09/23 17:27:09 revo Exp $">
<kap>
  <rad>kardan</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="kardan.0o">
  <kap>
    <tld/>o
  </kap>
  <uzo tip="fak">TEK</uzo>
  <snc mrk="kardan.0o.pendigo">
    <dif>
      Pendigo de objekte interne de du a&ubreve; tri ringoj kun lagroj aran&gcirc;itaj ortaj unu al la alia
      <klr>(priskribita en la 16a jc de Girolamo Cardano)</klr>:
      <ekz>
        oni utiligas la <tld/>on en la fabrikado de &scirc;ipkompasoj, lampoj
        ks.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/f/f8/Kardanischer-Kompass.jpg/250px-Kardanischer-Kompass.jpg"
      prm="PD"
      >kompaso kun <tld/>a pendigo
        <fnt>
          <lok><url ref="&WCW;/File:Kardanischer-Kompass.jpg"
              >https://commons.wikimedia.org/wiki/File:Kardanischer-Kompass.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="de">Kardanische Aufh&auml;ngung</trd>
  </snc>
  <snc mrk="kardan.0o.kunigo">
    <dif>
      Kunigo de du &scirc;aftoj tia, ke ili transmisias movon malgra&ubreve; deviaj aksoj:
      <ekz>
        <klr>[&ccirc;e la]</klr> traktoro <klr>[&#x2026;]</klr> la movan forton transdonas <tld/>a
        &scirc;afto al la 8&ndash;10-grada rapid&scirc;an&gcirc;ilo kaj per diferencialo al la du
        <klr>[malanta&ubreve;aj]</klr> grandaj radoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=25630"
              >Traktoro</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/a/aa/Cardan-joint_DIN808_type-E_3D_animated.gif/250px-Cardan-joint_DIN808_type-E_3D_animated.gif"
      prm="CC BY-SA 2.5"
      ><tld/>a kunigo
        <fnt>
          <aut>Silberwolf</aut>
          <lok><url ref="&WCW;/File:Cardan-joint_DIN808_type-E_3D_animated.gif"
              >https://commons.wikimedia.org/wiki/File:Cardan-joint_DIN808_type-E_3D_animated.gif</url></lok>
        </fnt>
    </bld>
    <trdgrp lng="de">
      <trd>Kardangelenk</trd>,
      <trd>Kreuzgelenk</trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_d;&c_a;&c_n;</trd>
  <trdgrp lng="ca">
    <trd>junta de Cardan</trd>,
    <trd>junta universal</trd>
  </trdgrp>
  <trd lng="en">universal <ind>joint</ind></trd>
  <trd lng="fr">cardan</trd>
  <trdgrp lng="hu">
    <trd>kard&aacute;n</trd>,
    <trd>g&ouml;mbcsukl&oacute;</trd>
  </trdgrp>
  <trd lng="ja">&#x30AB;&#x30EB;&#x30C0;&#x30F3;&#x61F8;&#x67B6;&#x88C5;&#x7F6E;  <pr>&#x30AB;&#x30EB;&#x30C0;&#x30F3;&#x304B;&#x304B;&#x304B;&#x304B;&#x305D;&#x3046;&#x3061;</pr></trd>
  <trd lng="nl">cardan</trd>
  <trdgrp lng="pl">
    <trd>kardan</trd>,
    <trd>sprz&eogonek;g&lstroke;o wychylne</trd>,
    <trd>sprz&eogonek;g&lstroke;o Cardana</trd>,
    <trd>przegub Cardana</trd>,
    <trd>przegub krzy&zdot;akowy</trd>
  </trdgrp>
  <trd lng="ru">&c_k;&c_a;&c_r;&c_d;&c_a;&c_n;</trd>
  <trdgrp lng="uk">
    <trd>&c_k;&c_a;&c_r;&c_d;&c_a;&c_n;</trd>,
    <trd>&c_k;&c_a;&c_r;&c_d;&c_a;&c_n;&c_n;&c_i;&c_j; &c_v;&c_a;&c_l;</trd>
  </trdgrp>
</drv>
</art>
