<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: alergi.xml,v 1.21 2026/09/22 11:30:04 revo Exp $">
<kap>
  <ofc>9</ofc><rad>alergi</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="alergi.0o">
  <kap><ofc>9</ofc><tld/>o</kap>
  <snc mrk="alergi.0o.FIZL">
    <uzo tip="fak">FIZL</uzo>
    <uzo tip="fak">MED</uzo>
    <dif>
      <ref tip="lst" cel="san.mal0o.MED" lst="voko:malsanoj">Malsano</ref>,
      ka&ubreve;zita de forta reago de la <ref cel="sistem.imun0o">imunsistemo</ref>
      kontra&ubreve; substancoj, kiuj normale estas sendan&gcirc;eraj, ekzemple
      man&gcirc;a&jcirc;oj, poleno, polvo ks:
      <ekz>
        oni kalkulas, ke 10% de la monda lo&gcirc;antaro suferas de iu speco
        de <tld/>o
        <fnt>
          <aut>H. Schicke</aut>,
          <vrk>Alergio kaj astmo</vrk>,
          <lok><url ref="http://www.naturkuracado.info">naturkuracado.info</url>,
          2005</lok>
        </fnt>;
      </ekz>
      <ekz>
        lastatempe mi suferas strangan <tld/>on, kiu &ndash; pro ankora&ubreve; nekonataj kialoj &ndash; de
        tempo al tempo forte ru&gcirc;igas mian viza&gcirc;on
        <fnt>
          <bib>Kon11</bib>
          <lok>Blogo de alergiulo</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="zh">
      <trd>&#x654F;&#x611F;&#x75C7; <pr>m&#x1D0;ng&#x1CE;nzh&egrave;ng</pr></trd>,
      <trd>&#x654F;&#x75C7; <pr>m&#x1D0;nzh&egrave;ng</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_je;&c_r;&c_g;&c_ib;&c_ja;</trd>
  <trd lng="bg">&c_a;&c_l;&c_je;&c_r;&c_g;&c_i;&c_ja;</trd>
  <trd lng="de">Allergie</trd>
  <trd lng="en">allergy</trd>
  <trd lng="es">alergia</trd>
  <trd lng="fr">allergie</trd>
  <trd lng="he">&alef;&#x5B7;&lamed;&#x5B6;&resh;&gimel;&#x5B4;&yod;&#x5B8;&he;</trd>
  <trd lng="id">alergi</trd>
  <trd lng="it">allergia</trd>
  <trd lng="ja">&#x30A2;&#x30EC;&#x30EB;&#x30AE;&#x30FC;
    <pr>&#x3042;&#x308C;&#x308B;&#x304E;&#x30FC;</pr></trd>
  <trd lng="ms">alergi</trd>
  <trd lng="nl">allergie</trd>
  <trdgrp lng="pl">
    <trd>alergia</trd>,
    <trd>uczulenie</trd>
  </trdgrp>
  <trd lng="ro">sensibilitate</trd>
  <trd lng="ru">&c_a;&c_l;&c_l;&c_je;&c_r;&c_g;&c_i;&c_ja;</trd>
  <trd lng="uk">&c_a;&c_l;&c_je;&c_r;&c_gu;&c_ib;&c_ja;</trd>
</drv>

<drv mrk="alergi.0a">
  <kap><tld/>a</kap>
  <snc mrk="alergi.0a.FIZL">
    <dif>
      Rilata al <tld/>o:
      <ekz>
        <tld/>a konjunktivito
        <fnt>
          <aut>A. Garc&iacute;a Acosta</aut>,
          <vrk><url
          ref="http://www.radiosanctispiritus.cu/Version%20Esperanto/Noticias/salud/febrero/19/nueva.htm">Nova
          terapio...</url></vrk>,
          <lok>Radio Sancti Sp&iacute;ritus, 2006-06-05</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>ajn perturbojn ka&ubreve;zas al &scirc;i laktuko, cepoj kaj multaj aliaj legomoj
        <fnt>
          <bib>Monato</bib>
          <aut>Albisturo Kvinke</aut>
          <vrk><url ref="&Monato;/2008/009326.php"
              >Analoj de Bailenambeann</url></vrk>
          <lok>2008</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_je;&c_r;&c_g;&c_ib;&c_ch;&c_n;&c_y;</trd>
  <trd lng="bg">&c_a;&c_l;&c_je;&c_r;&c_g;&c_i;&c_ch;&c_je;&c_n;</trd>
  <trd lng="cs">alergick&yacute; <klr>(na)</klr></trd>
  <trd lng="de">allergisch</trd>
  <trd lng="en">allergic</trd>
  <trd lng="es">al&eacute;rgico</trd>
  <trd lng="fr">allergique</trd>
  <trd lng="he">&alef;&#x5B7;&lamed;&#x5B6;&resh;&gimel;&#x5B4;&yod;&#x5B8;&he;</trd>
  <trd lng="id">alergis</trd>
  <trd lng="it">allergico</trd>
  <trd lng="nl">allergisch</trd>
  <trd lng="pl">alergiczny</trd>
  <trd lng="ru">&c_a;&c_l;&c_l;&c_je;&c_r;&c_g;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">alergick&yacute; <klr>(na)</klr></trd>
  <trd lng="uk">&c_a;&c_l;&c_je;&c_r;&c_gu;&c_ib;&c_j;&c_n;&c_i;&c_j;</trd>
</drv>

<drv mrk="alergi.0i">
  <kap>
    <tld/>i
  </kap>
  <snc>
    <dif>
      Reagi per <tld/>o al io:
      <ekz>
        mi anka&ubreve; &scirc;atas katojn sed mi <tld/>as al ili
        <fnt>
          <bib>Kon11</bib>
          <lok>Intervjuo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        esperantistoj restas naciistoj, kaj pro tio ili <tld/>as al la hodlera mesa&gcirc;o
        <fnt>
          <bib>LOdE</bib>
          <lok>2000, No 6 (68)</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">allergisch reagieren</trd>
</drv>

<drv mrk="alergi.0iga">
  <kap><tld/>iga</kap>
  <snc mrk="alergi.0iga.FIZL">
    <dif>
      Ka&ubreve;zanta <tld/>ajn reagojn:
      <ekz>
        li mezuris la efikon de <ind><tld/>iga</ind> substanco en &ccirc;elkulturo
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        en la &ccirc;iutaga vivo vi devas bone gardi vin mem kaj ne tu&scirc;i
        la facile <tld/>igajn objektojn
        <fnt>
        <aut>&Ccirc;ina Radio Internacia</aut>,
          <vrk><url ref="http://es.chinabroadcast.cn/1/2005/03/18/1@22350.htm">Fruaj
          simptomoj de
          malsanoj</url></vrk>,
          <lok>2005-03-18</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_je;&c_r;&c_g;&c_je;&c_n;&c_n;&c_y;</trd>
  <trd lng="bg">&c_a;&c_l;&c_je;&c_r;&c_g;&c_i;&c_z;&c_i;&c_r;&c_a;&c_shch;</trd>
  <trdgrp lng="de">
    <trd>allergen</trd>,
    <trd>allergieausl&ouml;send</trd>
  </trdgrp>
  <trd lng="en">allergenic</trd>
  <trd lng="es">alerg&eacute;nico</trd>
  <trd lng="fr">allerg&egrave;ne<klr> (adj.)</klr></trd>
  <trd lng="it">allergenico</trd>
  <trd lng="nl">allergeen</trd>
  <trd lng="pl">uczulaj&aogonek;cy</trd>
  <trdgrp lng="ru">
    <trd>&c_a;&c_l;&c_l;&c_je;&c_r;&c_g;&c_je;&c_n;&c_n;&c_y;&c_j;</trd>,
    <trd>&c_v;&c_y;&c_z;&c_y;&c_v;&c_a;&c_ju;&c_shch;&c_i;&c_j;
    <ind>&c_a;&c_l;&c_l;&c_je;&c_r;&c_g;&c_i;&c_ju;</ind></trd>
  </trdgrp>
</drv>

<drv mrk="alergi.0ulo">
  <kap>
    <tld/>ulo
  </kap>
  <snc>
    <dif>
      Iu suferanta pro <tld/>o:
      <ekz>
        por <tld/>uloj kaj celiakiuloj e&ccirc; spuro de gluteno povas esti tre dan&gcirc;era
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        kiu ajn printempe spertas fortajn kaj da&ubreve;rajn malvarmumojn, konjunktiviton,
        kapdoloron, ver&scirc;ajne estas <tld/>ulo
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2013/010953.php"
              >Zorga gardisto nenion preteratentas</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Allergiker</trd>
  <trd lng="en">allergic person</trd>
  <trd lng="fr">personne allergique</trd>
  <trd lng="ru">&c_a;&c_l;&c_l;&c_je;&c_r;&c_g;&c_i;&c_k;</trd>
</drv>

</art>
