<art mrk="$Id: sxamisen.xml,v 1.15 2026/09/15 21:18:09 revo Exp $">
<kap>
  <rad>&scirc;amisen</rad>/o <fnt><bib>EncJap</bib></fnt>
</kap>
<drv mrk="sxamisen.0o">
  <kap><tld/>o</kap>
  <snc mrk="sxamisen.0o.MUZ">
    <uzo tip="fak">MUZ</uzo>
    <dif>
      Japana klasika
      <ref tip="lst" cel="instru2.kord0o.MUZ" lst="voko:kordinstrumentoj">kordinstrumento</ref>
      trikorda, el kvadrata sonkesto tegita per katha&ubreve;to,
      longa kolo kaj kapo kun tri kejloj, plektre ludata:
      <ekz>
        tiu malnova formo estis ludita, ne de <tld/>o, sed tamburo kaj
        fluto
        <fnt>
        <aut>M. Sasaki</aut>,
        <vrk>
<url ref="http://morioka.cool.ne.jp/ihatov-esperanto/yoshare.html">
        Jo&scirc;are</url></vrk>,
        <lok>2004-08-15</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/5/54/'Woman_Playing_a_Shamisen'%2C_Japanese_late_17th_century.jpg/250px-'Woman_Playing_a_Shamisen'%2C_Japanese_late_17th_century.jpg"
      prm="PD"
      >virino ludanta <tld/>on, Japana pentra&jcirc;o el la 17a jc
        <fnt>
          <aut>Nekonato, Muzeo de Arto, Honolulu</aut>
          <lok><url ref="&WCW;/File:'Woman_Playing_a_Shamisen',_Japanese_late_17th_century.jpg"
              >https://commons.wikimedia.org/wiki/File:'Woman_Playing_a_Shamisen',_Japanese_late_17th_century.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_s;&c_ja;&c_m;&c_ib;&c_s;&c_e;&c_n;</trd>
  <trd lng="ca">shamisen</trd>
  <trd lng="de">Shamisen</trd>
  <trd lng="en">shamisen</trd>
  <trd lng="fr">shamisen</trd>
  <trd lng="hu">samiszen</trd>
  <trd lng="it">shamisen</trd>
  <trdgrp lng="ja">
    <trd>&#x4E09;&#x5473;&#x7DDA;     <pr>&#x3057;&#x3083;&#x307F;&#x305B;&#x3093;</pr></trd>,
    <trd>&#x4E09;&#x7D43;</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>shamisen</trd>,
    <trd>samisen</trd>
  </trdgrp>
  <trd lng="pt">shamisen</trd>
  <trd lng="ru">&c_s;&c_ja;&c_m;&c_i;&c_s;&c_e;&c_n;</trd>
  <trdgrp lng="uk">
    <trd>&c_s;&c_ja;&c_m;&c_ib;&c_s;&c_je;&c_n;</trd>,
    <trd>&c_ja;&c_p;&c_o;&c_n;&c_s;&c_mol;&c_k;&c_a; &c_l;&c_ju;&c_t;&c_n;&c_ja;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x4E09;&#x5473;&#x7DDA; <pr>s&amacron;nw&egrave;ixi&agrave;n</pr></trd>,
    <trd>&#x4E09;&#x5473;&#x7EBF; <pr>s&amacron;nw&egrave;ixi&agrave;n</pr></trd>
  </trdgrp>
</drv>
</art>
