<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: peristalt.xml,v 1.1 2026/11/21 19:45:15 afido Exp $">
    <kap>
      <rad>peristalt</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="peristalt.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">FIZL</uzo>
  <snc>
    <dif>
      Muskola aktiveco de tuba organo, ekz-e de la digestaj organoj:
      <ekz>
        tiel zorgas glatmuskolaro &ndash; nomata anka&ubreve; viscera muskolaro - <klr>[por]</klr>
        <tld/>o en stomako, intestaro
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=22094"
              >Glatfibra muskolo</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        okazas anka&ubreve; akcidenta meminfekto de portanto de la porka&jcirc;a tenio, kiam pro
        kontra&ubreve;<tld/>a movi&gcirc;o de la duodeno, regurgito a&ubreve; forta vomado maturaj
        segmentoj kun infektokapablaj ovoj eniras la stomakon
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Peristaltik</trd>
    <trd lng="en">peristalsis</trd>
    <trd lng="fr">p&eacute;ristaltisme</trd>
    <trd lng="ru">&c_p;&c_je;&c_r;&c_i;&c_s;&c_t;&c_a;&c_l;&c_mol;&c_t;&c_i;&c_k;&c_a;</trd>
    <trd lng="uk">&c_p;&c_je;&c_r;&c_i;&c_s;&c_t;&c_a;&c_l;&c_mol;&c_t;&c_i;&c_k;&c_a;</trd>
  </snc>
</drv>

  </art>


