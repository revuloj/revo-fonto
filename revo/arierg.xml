<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: arierg.xml,v 1.25 2026/09/20 11:17:40 revo Exp $">
<kap>
  <rad>ariergard</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="arierg.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      <ref tip="super" cel="tacxme.0o.MIL">Ta&ccirc;mento</ref>
      gardanta la postan parton de armeo:
      <ekz>
        subite, malproksime, en la dekstra flanko eksonis trumpetoj kaj
        multfoje
        ripetataj aklamoj: la sentima Patroklo, ebria jam de la mateno,
        atakis la
        malamikan <tld/>on
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro XVIII</lok>
        </fnt>;
      </ekz>
      <ekz>
        pli frue ili flugis anta&ubreve; la kompanio por esplori la regionon,
        kiel <ref tip="ant" cel="avanga.0o.MIL">avangardo</ref>,
        sed nun ili mar&scirc;is kiel <tld/>o malanta&ubreve;e
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Stelmona&hcirc;ejo</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="sin" cel="gvardi.post0o">postgvardio</ref>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: (en la armea signifo) prefere diru <ke>malanta&ubreve;a ta&ccirc;mento</ke>,
    <ke>malanta&ubreve;iranto</ke>.
  </rim>

  <adm>
  Supozeble ekzistas simila figura senco, kiel
  cxe avangardo. <aut>MB</aut>
  </adm>
  <trd lng="be">&c_a;&c_r;'&c_je;&c_r;&c_g;&c_a;&c_r;&c_d;</trd>
  <trd lng="ca">rereguarda</trd>
  <trd lng="cs">zadn&iacute; voj</trd>
  <trd lng="de">Nachhut</trd>
  <trd lng="en">rear-guard</trd>
  <trd lng="fr">arri&egrave;re-garde</trd>
  <trd lng="he">&het;&yod;&lamed; &mem;&alef;&samekh;&fpe;</trd>
  <trd lng="hu">h&aacute;tv&aacute;d</trd>
  <trd lng="it">retroguardia</trd>
  <trd lng="ja">&#24460;&#34907;  <pr>&#12371;&#12358;&#12360;&#12356;</pr></trd>
  <trd lng="pt">retaguarda</trd>
  <trd lng="ru">&c_a;&c_r;&c_mol;&c_je;&c_r;&c_g;&c_a;&c_r;&c_d;</trd>
  <trd lng="sk">zadn&yacute; <ind>voj</ind></trd>
  <trd lng="uk">&c_a;&c_r;&#8217;&c_jeu;&c_r;&c_gu;&c_a;&c_r;&c_d;</trd>
</drv>
</art>
