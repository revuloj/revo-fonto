<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: recesi.xml,v 1.12 2026/08/10 13:40:56 revo Exp $">
<kap>
  <rad>recesi</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="recesi.0o">
  <kap><tld/>o</kap>
  <snc mrk="recesi.0o.EKON">
    <uzo tip="fak">EKON</uzo>
    <dif>
      &Gcirc;enerala malgrandi&gcirc;o de produktado:
      <ekz>
        La koktelejoj estas malplenaj, la
        omarrestoracioj estas
        malplenaj, ni havas
        <tld/>on, oni diras
        <fnt>
          <aut>C. Bukowski, trad. Cezar</aut>,
          <vrk><url ref="http://www.ipernity.com/blog/cezar/143219">Recesio</url></vrk>,
          <lok>2009</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: (en la &ccirc;iutaga lingvo) prefere diru <ke>malkresko</ke>,
    <ke><ref tip="sin" cel="progre.mal0o">malprogreso</ref></ke>,
    <ke><ref tip="sin" cel="prospe1.mal0o">malprospero</ref></ke>,
    <ke><ref tip="sin" cel="kriz.ekonomia0o">ekonomia krizo</ref></ke>.
  </rim>

  <refgrp tip="vid">
    <ref cel="depresi.0o.EKON">depresio <sncref/></ref>
  </refgrp>
  <trd lng="be">&c_r;&c_e;&c_c;&c_e;&c_s;&c_ib;&c_ja;</trd>
  <trd lng="bg">&c_r;&c_je;&c_c;&c_je;&c_s;&c_i;&c_ja;</trd>
  <trd lng="ca">recessi&oacute;</trd>
  <trdgrp lng="cs">
    <trd>recese</trd>,
    <trd>v&yacute;st&rcaron;edn&iacute; &zcaron;erty</trd>
  </trdgrp>
  <trd lng="de">Rezession</trd>
  <trd lng="fr">r&eacute;cession</trd>
  <trd lng="nl">recessie</trd>
  <trd lng="pl">recesja gospodarcza</trd>
  <trd lng="ro">recesiune  <klr>(economie)</klr></trd>
  <trdgrp lng="sk">
    <trd>recesia</trd>,
    <trd>v&yacute;stredn&yacute; &zcaron;art</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_r;&c_je;&c_c;&c_je;&c_s;&c_ib;&c_ja;</trd>,
    <trd>(&c_je;&c_k;&c_o;&c_n;&c_o;&c_m;&c_ib;&c_ch;&c_n;&c_i;&c_j;) &c_s;&c_p;&c_a;&c_d;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#34928;&#36864; <pr>shu&amacron;itu&igrave;</pr></trd>,
    <trd>&#32147;&#28639;&#34928;&#36864; <pr>j&imacron;ngj&igrave;shu&amacron;itu&igrave;</pr></trd>,
    <trd>&#32463;&#27982;&#34928;&#36864; <pr>j&imacron;ngj&igrave;shu&amacron;itu&igrave;</pr></trd>
  </trdgrp>
</drv>
</art>

