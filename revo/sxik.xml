<vortaro>
<art mrk="$Id: sxik.xml,v 1.24 2026/09/12 18:23:02 revo Exp $">
<kap>
  <rad>&scirc;ik</rad>/a
  <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="sxik.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      La&ubreve;mode <ref tip="super" cel="gust.bon0a.estetika">bongusta</ref>:
      <ekz>
        <nom>Starbucks</nom> popularas inter junulinoj pro sia <tld/>a interna dekoracio
        <fnt>
          <bib>Monato</bib>
          <aut>Igarasi Takeo</aut>
          <vrk><url ref="&Monato;/2003/007563.html">Novtipaj kafejoj prosperas</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i sidi&gcirc;is kaj suspiris, deprenis <klr>[&#8230;]</klr> la <tld/>ajn altkalkanumajn
        &scirc;uojn, kiujn &scirc;i a&ccirc;etis en Londono
        <fnt>
          <bib>Monato</bib>
          <aut>Saliko</aut>
          <vrk><url ref="&Monato;/2006/008760.php">En fremda lando</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        ni diligente preparis nin: ni surmetis niajn plej <tld/>ajn vestojn, <nom>Liza</nom> kombis
        min aparte bele kaj zorge &scirc;minkis sin
        <fnt>
          <bib>Monato</bib>
          <aut>Lena Karpunina</aut>
          <vrk><url ref="&Monato;/2006/008836.php">La revo pri cirko</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la plej renomaj kaj <tld/>aj restoracioj de Parizo
        <fnt>
          <bib>Monato</bib>
          <aut>Yves Nicolas</aut>
          <vrk><url ref="&Monato;/2010/010225.php">Komuna agado, komunaj valoroj</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        vi havas <tld/>an, ri&ccirc;an edzinon
        <fnt>
          <bib>Monato</bib>
          <aut>Trevor Steele</aut>
          <vrk><url ref="&Monato;/2015/011474.php">Tridek jarojn poste</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="elegan.0a">eleganta</ref>,
      <ref cel="pimp.0a">pimpa</ref>,
      <ref cel="bel.0a">bela</ref>,
      <ref cel="koket.0a.io">koketa</ref>,
      <ref cel="mod.laux0a">la&ubreve;moda</ref>,
      <ref cel="lind.0a">linda</ref>,
      <ref cel="mojos.0a">mojosa</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_sh;&c_y;&c_k;&c_o;&c_w;&c_n;&c_y;</trd>
  <trdgrp lng="de">
    <trd>schick</trd>,
    <trd>modisch</trd>,
    <trd>elegant</trd>
  </trdgrp>
  <trd lng="el">&kappa;&omikron;&my;&psi;&omikron_ton;&sigma_fina;</trd>
  <trdgrp lng="en">
    <trd>chic</trd>,
    <trd>fashionable</trd>
  </trdgrp>
  <trdgrp lng="es">
     <trd>de buen gusto</trd>,
     <trd>elegante</trd>
  </trdgrp>
  <trd lng="fa">&a_sh;&f_y;&f_k;</trd>
  <trd lng="fr">chic</trd>
  <trd lng="hu">sikkes</trd>
  <trdgrp lng="it">
    <trd>chic</trd>,
    <trd>elegante</trd>,
    <trd>fine<klr> (elegante, con stile)</klr></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30B7;&#x30C3;&#x30AF;&#x306A;  <pr>&#12375;&#12387;&#x304F;&#x306A;</pr></trd>,
    <trd>&#12356;&#x304D;&#x306A;</trd>,
    <trd>&#12375;&#12419;&#x308C;&#x305F;</trd>,
    <trd>&#x8DA3;&#21619;&#x306E;&#x826F;&#12356;  <pr>&#12375;&#12421;&#x307F;&#x306E;&#12356;&#12356;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>chic</trd>,
    <trd>hip</trd>,
    <trd>deftig</trd>
  </trdgrp>
  <trd lng="pl">szykowny</trd>
  <trd lng="pt">chique</trd>
  <trd lng="ru">&c_sh;&c_i;&c_k;&c_a;&c_r;&c_n;&c_y;&c_j;</trd>
  <trd lng="uk">&c_sh;&c_i;&c_k;&c_a;&c_r;&c_n;&c_i;&c_j;</trd>
  <trdgrp lng="zh">
    <trd>&#x4E00;&#x5EA6;&#x6D41;&#x884C; <pr>y&imacron;d&ugrave;li&uacute;x&iacute;ng</pr></trd>,
    <trd>&#20837;&#x65F6; <pr>r&ugrave;sh&iacute;</pr></trd>,
    <trd>&#20837;&#26178; <pr>r&ugrave;sh&iacute;</pr></trd>
  </trdgrp>
</drv>
</art>
