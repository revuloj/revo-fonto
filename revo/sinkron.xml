<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: sinkron.xml,v 1.12 2026/11/20 20:41:57 revo Exp $">
<kap>
  <rad>sinkron</rad>/a <fnt><bib>PVEF</bib></fnt>,
  <var><kap><rad var="hx">sin&hcirc;ron</rad>/a</kap></var>
</kap>
<drv mrk="sinkron.0a">
  <kap><tld/>a, <var><kap><tld var="hx"/>a</kap></var></kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="sinkron.0a.SCI">
    <uzo tip="fak">SCI</uzo>
    <dif>
      <ref tip="dif" cel="temp.sam0a.KOMUNE">Samtempa</ref>,
      <ref tip="dif" cel="takt.sam0a.KOMUNE">samtakta</ref>;
      konsideranta aferojn en difinita momento, sen tempa evoluo;
      kontraste al <ref tip="ant" cel="diakron.0a.SCI">diakrona</ref>:
      <ekz>
        etaj galaksioj, kiuj movi&gcirc;as interne de la Andromeda,
        <klr>[&#x2026;]</klr> rotacias la&ubreve; <tld/>a rapideco
        <fnt>
          <aut>P. S. Viana</aut>,
          <vrk><url ref="http://retradio.webnode.at/news/dek-kvin-jara-sciencisto/">
          Dek-kvin-jara sciencisto</url></vrk>,
          <lok>esperanta retradio, 2013-01-08</lok>
        </fnt>;
      </ekz>
      <ekz>
        ili oscilas samtakte (<tld var="hx"/>e) kaj elsendas pro tio koherentajn radiojn
        <fnt>
          <bib>SR</bib>
          <aut>Prof. D-ro H. Sirk</aut>
          <vrk>La longo de lumondo kiel natura etalono</vrk>
          <lok>Scienca Revuo, nro 032/1957</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: (en lingvoscienco kaj &gcirc;enerale) prefere diru <ke>unutempa</ke>, <ke>samtempa</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_s;&c_y;&c_n;&c_h;&c_r;&c_o;&c_n;&c_n;&c_y;</trd>,
    <trd>&c_a;&c_d;&c_n;&c_a;&c_ch;&c_a;&c_s;&c_o;&c_v;&c_y;</trd>,
    <trd>&c_a;&c_d;&c_n;&c_a;&c_ch;&c_a;&c_s;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="en">synchronic</trd>
  <trd lng="fr">synchronique</trd>
  <trdgrp lng="ja">
    <trd>&#x540C;&#x6642;&#x306B;&#x8D77;&#x304D;&#x308B;  <pr>&#x3069;&#x3046;&#x3058;&#x306B;&#x304A;&#x304D;&#x308B;</pr></trd>,
    <trd>&#x540C;&#x671F;&#x306E;  <pr>&#x3069;&#x3046;&#x304D;&#x306E;</pr></trd>,
    <trd>&#x540C;&#x671F;&#x3057;&#x305F;  <pr>&#x3069;&#x3046;&#x304D;&#x3057;&#x305F;</pr></trd>,
    <trd>&#x5171;&#x6642;&#x7684;&#x306A;  <pr>&#x3068;&#x3082;&#x3058;&#x3066;&#x304D;&#x306A;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
   <trd>jednoczesny</trd>,
   <trd>synchroniczny</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>synchronick&yacute;</trd>,
    <trd>s&uacute;&ccaron;asn&yacute;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_s;&c_i;&c_n;&c_h;&c_r;&c_o;&c_n;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_o;&c_d;&c_n;&c_o;&c_ch;&c_a;&c_s;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x540C;&#x6B65; <pr>t&oacute;ngb&ugrave;</pr></trd>,
    <trd>&#x540C;&#x671F; <pr>t&oacute;ngq&imacron;</pr></trd>,
    <trd>&#x5171;&#x65F6; <pr>g&ograve;ngsh&iacute;</pr></trd>,
    <trd>&#x5171;&#x6642; <pr>g&ograve;ngsh&iacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="sinkron.0igi">
  <kap>
    <tld/>igi, <var><kap><tld var="hx"/>igi</kap></var>
  </kap>
  <snc mrk="sinkron.0igi.agordi">
    <dif>
      <ref tip="super" cel="agord.0i.TEK">Agordi</ref> du a&ubreve; pliajn aferojn por ke ili funkciu samtakte:
      <ekz>
        <tld/>igi lipajn movojn al parolado
        <fnt>
          <bib>Kon11</bib>
          <lok>Intervjuo</lok>
        </fnt>;
      </ekz>
      <ekz>
        prilaborilo do devus enhavi <tld var="hx"/>igilon, kiu ebligus al la storo peti
        atendostadion
        <fnt>
          <bib>SR</bib>
          <aut>Christian Bertin (tradukinto)</aut>
          <vrk>INTEL 8080 &mdash; priskribo kaj programado</vrk>
          <lok>Scienca Revuo, nro 133/1978</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">synchronisieren</trd>
  <trd lng="en">synchronize</trd>
</drv>

</art>

