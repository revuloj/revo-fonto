<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: spinac.xml,v 1.32 2026/08/12 17:09:03 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>spinac</rad>/o
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="spinac.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="spinac.0o.legomo">
    <uzo tip="fak">KUI</uzo>
    <dif>
      Legomo el folioj de unu specio de <ref cel="spinac.0o.genro"><tld/>o<sncref/></ref>:
      <ekz>
        la plej belaj pejza&gcirc;oj aspektis en <klr>[la spegulo]</klr> kiel
        kuirita <tld/>o, kaj la plej bonaj homoj fari&gcirc;is malbelaj
        <fnt>
          <bib>Fab2</bib>
          <lok>Ne&gcirc;a re&gcirc;ino</lok>
        </fnt>;
      </ekz>
      <ekz>
        lokaj torteloj, kvadrataj, far&ccirc;itaj per selakto kaj <tld/>oj,
        kondimentitaj per tomata sa&ubreve;co
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2012/010845.php">Saturnia: Vintra magio</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">espinacs</trd>
  </snc>
  <snc mrk="spinac.0o.genro">
    <uzo tip="fak">BOT</uzo>
    <dif>
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:botanikaj_genroj">Genro</ref> el familio
      <ref tip="malprt" cel="amarantac.0oj">amarantacoj</ref>
      (<trd lng="la">Spinacia</trd>); la verdajn foliojn de unu specio
      (<trd lng="la">Spinacia oleracea</trd>) oni man&gcirc;as
      kiel legomo.
    </dif>
    <bld
    lok="&WCU;/thumb/d/d9/Spinazie_vrouwelijke_plant_%28Spinacia_oleracea_female_plant%29.jpg/330px-Spinazie_vrouwelijke_plant_%28Spinacia_oleracea_female_plant%29.jpg"
    prm="CC-BY-SA-3.0">ina <tld/>o (Spinacia oleracea)
        <fnt>
          <aut>Rasbak, propra verko</aut>
          <lok><url
          ref="&WCW;/File:Spinazie_vrouwelijke_plant_(Spinacia_oleracea_female_plant).jpg">&WCW;/File:Spinazie_vrouwelijke_plant_(Spinacia_oleracea_female_plant).jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="ca">espinac<klr tip="amb"> (planta)</klr></trd>
  </snc>
  <trd lng="be">&c_sh;&c_p;&c_ib;&c_n;&c_a;&c_t;</trd>
  <trd lng="bg">&c_s;&c_p;&c_i;&c_n;&c_a;&c_k;</trd>
  <trd lng="bo">&t_sa;&t_ngata;&t_naro;&t_tsheg;&t_tsha;&t_la;&t_tsheg;&t_zha;&t_gigu;&t_ga;&t_tsheg;</trd>
  <trd lng="cs">&scaron;pen&aacute;t</trd>
  <trd lng="de">Spinat</trd>
  <trd lng="en">spinach</trd>
  <trd lng="es">espinaca</trd>
  <trd lng="fa">&a_A;&a_s;&a_f;&a_n;&a_A;&a_j;</trd>
  <trd lng="fr">&eacute;pinard</trd>
  <trdgrp lng="hu">
    <trd>spen&oacute;t</trd>,
    <trd>paraj</trd>
  </trdgrp>
  <trd lng="id">bayam</trd>
  <trd lng="ja">&#x30DB;&#x30A6;&#x30EC;&#x30F3;&#x30BD;&#x30A6;</trd>
  <trd lng="nl">spinazie</trd>
  <trd lng="pl">szpinak</trd>
  <trd lng="ru">&c_sh;&c_p;&c_i;&c_n;&c_a;&c_t;</trd>
  <trd lng="sk">&scaron;pen&aacute;t</trd>
  <trd lng="tr">&inodot;spanak</trd>
  <trd lng="uk">&c_sh;&c_p;&c_i;&c_n;&c_a;&c_t;</trd>
  <trdgrp lng="zh">
    <trd>&#x83E0;&#x83DC; <pr>b&omacron;c&agrave;i</pr></trd>,
    <trd>&#x83E0; <pr>b&omacron;</pr></trd>,
    <trd>&#x8590; <pr>l&eacute;ng</pr></trd>
  </trdgrp>
</drv>
</art>
