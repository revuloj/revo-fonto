<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: akci.xml,v 1.29 2026/08/05 17:52:58 revo Exp $">
  <kap>
  <ofc>1</ofc>
  <rad>akci</rad>/o
  <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="akci.0o">
  <kap><tld/>o</kap>
    <uzo tip="fak">EKON</uzo>
    <snc mrk="akci.0o.EKON">
    <dif>
      Atesto pri partopreno en la kapitalo de financa societo,
      <ref tip="super" cel="paper.valor0o">valorpapero</ref>:
      <ekz>
        <tld/>a societo;
      </ekz>
      <ekz>
        <klr>[&scirc;i]</klr> venis, <klr>[&#x2026;]</klr> por proponi <tld/>ojn de sia tanejo
        <fnt>
          <bib>Fab3</bib>
          <lok>Kora sufero</lok>
        </fnt>;
      </ekz>
      <ekz>
        la <tld/>oj alti&gcirc;is, kaj Kristoforo estis kontenta
        <fnt>
          <bib>HsT</bib>
          <lok>Disaj vojoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        oni parolas pri procentedono de monsumoj, pri a&ccirc;eto de <tld/>oj al la Societo de
        direkteblaj aerostatoj
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        ili transdonis la <tld/>ojn de la fabriko kiel garantion
        <fnt>
          <bib>KKl</bib>
          <lok>&Ccirc;apitro 8</lok>
        </fnt>.
      </ekz>
  </dif>
  </snc>
  <trd lng="be">&c_a;&c_k;&c_c;&c_y;&c_ja;</trd>
  <trd lng="cs">akcie</trd>
  <trdgrp lng="de">
   <trd>Aktie</trd>,
   <trd>Anteil</trd>,
   <trd>Anteilschein</trd>,
   <trd>Kux</trd></trdgrp>
  <trdgrp lng="en">
   <trd>share</trd>,
   <trd>stock</trd>,
   <trd>corporate share</trd></trdgrp>
  <trd lng="es">acci&oacute;n</trd>
  <trd lng="fa">&a_s;&a_h;&a_m;<klr tip="ind"> (&a_s;&a_h;&a_A;&a_m;)</klr></trd>
  <trd lng="fr">action</trd>
  <trd lng="he">&mem;&nun;&yod;&he;</trd>
  <trd lng="hu">r&eacute;szv&eacute;ny</trd>
  <trdgrp lng="ja">
    <trd>&#x682A;&#x5F0F;  <pr>&#x304B;&#x3076;&#x3057;&#x304D;</pr></trd>,
    <trd>&#x682A;&#x5238;  <pr>&#x304B;&#x3076;&#x3051;&#x3093;</pr></trd>
  </trdgrp>
  <trd lng="nl">aandeel</trd>
  <trd lng="pl">akcja <klr>(wk&lstroke;ad)</klr></trd>
  <trdgrp lng="pt">
   <trd>a&ccedil;&atilde;o</trd>,
   <trd>ap&oacute;lice</trd>
  </trdgrp>
  <trd lng="ru">&c_a;&c_k;&c_c;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>&uacute;&ccaron;astina</trd>,
    <trd>akcia</trd>,
    <trd>akcia <klr>(nespisovne!)</klr></trd>
  </trdgrp>
  <trd lng="sv">aktie</trd>
  <trd lng="tr">hisse senedi</trd>
  <trd lng="uk">&c_a;&c_k;&c_c;&c_ib;&c_ja;</trd>
</drv>

<drv mrk="akci.0ulo">
  <kap><tld/>ulo</kap>
  <uzo tip="fak">EKON</uzo>
  <snc>
    <dif>
      Posedanto de <tld/>o(j):
      <ekz>
        la le&gcirc;o organizas sindikatojn da <tld/>uloj;
      </ekz>
      <ekz>
        &Gcirc;enerala Kunveno de la <tld/>uloj
        <fnt>
          <bib>KKl</bib>
          <lok>&Ccirc;apitro 8</lok>
        </fnt>;
      </ekz>
      <ekz>
        la <tld/>uloj de la entrepreno, <klr>[&#x2026;]</klr> povis anta&ubreve;vidi kaj anta&ubreve;kalkuli,
        ke tiuj procentoj almena&ubreve; plialti&gcirc;us &gcirc;is dek
        <fnt>
          <bib>IdO</bib>
          <lok>Kvara Parto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_k;&c_c;&c_y;&c_ja;&c_n;&c_e;&c_r;</trd>
  <trd lng="cs">akcion&aacute;&rcaron;</trd>
  <trdgrp lng="de">
    <trd>Aktion&auml;r</trd>,
    <trd>Anteilseigner</trd>,
    <trd>Aktienbesitzer</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>shareholder</trd>,
    <trd>stockholder</trd>
  </trdgrp>
  <trd lng="es">accionista</trd>
  <trd lng="fa">&a_s;&a_h;&a_A;&a_m;&zwnj;&a_d;&a_A;&a_r;</trd>
  <trd lng="fr">actionnaire</trd>
  <trd lng="he">&bet;&ayin;&lamed; &mem;&nun;&yod;&vav;&tav;</trd>
  <trd lng="hu">r&eacute;szv&eacute;nyes</trd>
  <trd lng="ja">&#x682A;&#x4E3B;  <pr>&#x304B;&#x3076;&#x306C;&#x3057;</pr></trd>
  <trd lng="nl">aandeelhouder</trd>
  <trdgrp lng="pl">
    <trd>akcjonariusz</trd>,
    <trd>udzia&lstroke;owiec</trd>
  </trdgrp>
  <trd lng="pt">acionista</trd>
  <trd lng="ru">&c_a;&c_k;&c_c;&c_i;&c_o;&c_n;&c_je;&c_r;</trd>
  <trdgrp lng="sk">
    <trd>&uacute;&ccaron;astin&aacute;r</trd>,
    <trd>akcion&aacute;r</trd>,
    <trd>majite&lcaron; akci&iacute;</trd>
  </trdgrp>
  <trd lng="uk">&c_a;&c_k;&c_c;&c_ib;&c_o;&c_n;&c_je;&c_r;</trd>
</drv>
</art>
