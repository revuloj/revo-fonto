<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: hans.xml,v 1.26 2026/10/24 10:53:38 revo Exp $">
<kap>
  <rad>hans</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="hans.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">EKON</uzo>
  <uzo tip="fak">HIS</uzo>
  <snc>
    <dif>
      Komerca <ref tip="super" cel="asoci.0o.societo">asocio</ref> de negocistoj
      a&ubreve; <ref tip="prt" cel="urb.0o">urbo</ref>j:
      <ekz>
        la plej konata estas la <ctl>Germana <tld lit="H"/>o</ctl>,
        kiu ligis inter la 13a kaj la 16a jarcentoj
        komercistojn el norde&ubreve;ropaj urboj
        <fnt><aut>Roland Rotsaert</aut>:
          <vrk><url ref="&Monato;/2002/pdf/monato200204.pdf#page=17">Mezepoka Hanso-asocio
          revivi&gcirc;as</url></vrk>,
        <bib>Monato</bib>
        <lok>2002/04, p. 17</lok></fnt>;
      </ekz>
      <ekz>
        &leftquot;<tld/>o&#8221; estas germandevena vorto pri asocio, kiu ligis komercistojn el aro da urboj
        <fnt>
        <aut>Roland Rotsaert</aut>:
        <vrk><url ref="&Monato;/2002/pdf/monato200204.pdf#page=17">Mezepoka Hanso-asocio
        revivi&gcirc;as</url></vrk>,
        <bib>Monato</bib>
        <lok>2002/04, p. 17</lok></fnt>;
      </ekz>
      <ekz>
        la <tld lit="H"/>a Ligo <klr>[&#8230;]</klr> kunigis &ccirc;. 200 urbojn en E&ubreve;ropo
        <fnt>

          <aut>last</aut>
          <vrk><url ref="&Monato;/2011/010405.php">Bruas la mezepoko</url></vrk>
          <bib>Monato</bib>
          <lok>2011/08, p. 19</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="gild.0o">gildo</ref>,
      <ref cel="korpor.0o">korporacio</ref>,
      <ref cel="sindik1.0o">sindikato</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_g;&c_a;&c_n;&c_z;&c_a;</trd>
  <trd lng="bg">&c_h;&c_a;&c_n;&c_z;&c_a;</trd>
  <trdgrp lng="cs">
    <trd>hansa</trd>,
    <trd>hanza</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Hanse</trd>
  </trdgrp>
  <trd lng="en">Hansa</trd>
  <trdgrp lng="es">
    <trd>corporaci&oacute;n</trd>,
    <trd>sociedad</trd>
  </trdgrp>
  <trd lng="fr">hanse</trd>
  <trd lng="hu">Hanza</trd>
  <trd lng="nl">Hansa</trd>
  <trd lng="pl">Hanza</trd>
  <trd lng="pt">hansa</trd>
  <trd lng="ru">&c_g;&c_a;&c_n;&c_z;&c_a;</trd>
  <trd lng="sk">hanza</trd>
  <trd lng="uk">&c_g;&c_a;&#x43D;&c_z;&c_a;</trd>
  <trd lng="zh">&#x6C49;&#33832;&#x540C;&#x76DF; <pr>h&#xE0;ns&#xE0;t&#xF3;ngm&#xE9;ng</pr></trd>
</drv>
</art>
