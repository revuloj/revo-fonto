  <trd lng="pl">G&oacute;rna  <ind>Saksonia</ind></trd>
  <trd lng="ru">&c_V;&c_je;&c_r;&c_h;&c_n;&c_ja;&c_ja; &c_S;&c_a;&c_k;&c_s;&c_o;&c_n;&c_i;&c_ja;</trd>
</drv>

