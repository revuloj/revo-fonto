<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: saks.xml,v 1.31 2026/09/08 09:08:31 revo Exp $">
<kap><ofc>10</ofc>
  <rad>saks</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="saks.0o">
  <kap><tld/>o</kap>
  <snc mrk="saks.0o.HIS">
    <uzo tip="fak">HIS</uzo>
    <dif>
      Ano de iama &gcirc;ermana
      <ref tip="lst" cel="trib.0o.ETN" lst="voko:popolanoj">tribo</ref>,
      lo&gcirc;anta precipe okcidente de la rivero Elbo
      (tiuj, kiuj invadis Britujon, poste nomi&gcirc;is <ref cel="saks.anglo0o">anglosaksoj</ref>):
      <ekz>
        la definitiva enlo&gcirc;i&gcirc;o de la Jutlandanoj, Angloj kaj
        <tld lit="S"/>oj en
        Anglio<fnt><bib>IntArkeol</bib>, <lok>p. 35a</lok></fnt>;
      </ekz>
      <ekz>
        la&ubreve; legendo en la 5a jarcento post Kristo, re&gcirc;o <nom>Gradlon</nom>, &ccirc;efo de la bretonoj
        elpelitaj el Anglio fare de la <tld/>oj, enmigris en <nom>Ys</nom>
        <fnt>
          <bib>Monato</bib>
          <aut>Josette Ducloyer</aut>
          <vrk>Francio: Quimper</vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_s;&c_a;&c_k;&c_s;</trd>
    <trdgrp lng="de">
      <trd>Sachse</trd>,
      <trd>S&auml;chsin</trd>
    </trdgrp>
    <trd lng="en">Saxon <klr>(of tribe)</klr></trd>
    <trd lng="nl">Saks</trd>
    <trdgrp lng="pt">
      <trd>sax&atilde;o</trd>
    </trdgrp>
    <trd lng="ru">&c_s;&c_a;&c_k;&c_s;</trd>
  </snc>
  <snc mrk="saks.0o.civitano">
    <dif>
      Civitano de la federacia germana &scirc;tato <tld lit="S"/>ujo.
    </dif>
    <trd lng="be">&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_je;&c_c;</trd>
    <trdgrp lng="de">
      <trd>Sachse</trd>,
      <trd>S&auml;chsin</trd>
    </trdgrp>
    <trd lng="en">Saxon <klr>(inhabitant)</klr></trd>
    <trd lng="nl">Saks</trd>
    <trd lng="ru">&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_je;&c_c;</trd>
  </snc>
  <trd lng="ca">sax&oacute; <klr>(subst.)</klr></trd>
  <trd lng="cs">Sas</trd>
  <trd lng="es">saj&oacute;n</trd>
  <trd lng="fr">Saxon<klr> (subst.)</klr></trd>
  <trd lng="hu">sz&aacute;sz</trd>
  <trd lng="it">sassone<klr> (sost.)</klr></trd>
  <trd lng="ja">&#x30B6;&#x30AF;&#x30BB;&#x30F3;&#x4EBA;
  <pr>&#x30B6;&#x30AF;&#x30BB;&#x30F3;&#12376;&#12435;</pr></trd>
  <trd lng="pl">Sakso&nacute;czyk</trd>
  <trd lng="sk">Sas</trd>
  <trdgrp lng="uk">
    <trd>&c_s;&c_a;&c_k;&c_s;</trd>,
    <trd>&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_je;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="zh">&#25746;&#x514B;&#x68EE;&#x4EBA; <pr>s&#x1CE;k&egrave;s&emacron;nr&eacute;n</pr></trd>
</drv>

<drv mrk="saks.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Rilatanta al <tld/>oj, ilia nacieco a&ubreve; &scirc;tato:
      <ekz>
        <tld/>aj dialektoj, a&ubreve;toro, konstitucio;
      </ekz>
      <ekz>
        la <tld/>a &ccirc;efurbo Dresdeno
        <fnt>
          <bib>Monato</bib>
          <aut>Jomo Ipfelkofer</aut>
          <vrk><url ref="&Monato;/2005/008575.php"
              >60 jarojn poste</url></vrk>
          <lok>2005</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld lit="S"/>a Esperanto-Instituto
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        Varsovia Duklando, tiam (1811) pola &scirc;tato sendependa kun <tld/>a dinastio, estis
        formita de Napoleon en 1807
        <fnt>
          <bib>SrT</bib>
          <lok>Libro I.</lok>
        </fnt>;
      </ekz>
      <ekz>
        en Anglio, post la normanda konkero, la reganta klaso parolis la francan
        normandan lingvon, dum la kamparanoj kaj metiistoj plue parolis <tld/>ajn
        lingvojn dum kelka tempo
        <fnt>
          <bib>Ret</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        nur proksimume 40% de la anglaj vortoj apartenas al angla-<tld/>a origino, kiu
        ja formas la bazon de la angla lingvo
        <fnt>
          <bib>Ret</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        per letero de la 24-a de januaro 1949 la <tld/>a Ministerio pri Popolklerigo
        <klr>[asertis ke]</klr> oni ne povas konsideri tiun artefaritan lingvon ta&ubreve;ga
        rimedo por interproksimigi la kulturajn valorojn de la popoloj
        <fnt>
          <bib>EeP</bib>
          <lok>Kvina Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="svis.Saksa0ujo">Saksa Svisujo</ref>
    <trd lng="en">Saxon</trd>
  </snc>
  <trd lng="be">&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">sax&oacute; <klr>(adj.)</klr></trd>
  <trd lng="cs">sask&yacute;</trd>
  <trd lng="de">s&auml;chsisch</trd>
  <trd lng="fr">saxon<klr> (adj.)</klr></trd>
  <trd lng="hu">sz&aacute;sz</trd>
  <trd lng="it">sassone<klr> (agg.)</klr></trd>
  <trd lng="lat">Saxonicus</trd>
  <trd lng="nl">Saksisch</trd>
  <trdgrp lng="pl">
    <trd>sakso&nacute;ski</trd>,
    <trd>saski</trd>
  </trdgrp>
  <trd lng="ru">&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_s;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">sask&yacute;</trd>
  <trd lng="uk">&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
  <trdgrp lng="zh">
    <trd>&#x85A9;&#x514B;&#x68EE;&#x4EBA;&#30340; <pr>s&agrave;k&egrave;s&emacron;nr&eacute;nde</pr></trd>,
    <trd>&#33832;&#x514B;&#x68EE;&#x5DDE;&#30340; <pr>s&agrave;k&egrave;s&emacron;nzh&omacron;ude</pr></trd>,
    <trd>&#x85A9;&#x514B;&#x68EE;&#x5DDE;&#30340; <pr>s&agrave;k&egrave;s&emacron;nzh&omacron;ude</pr></trd>,
    <trd>&#x85A9;&#x514B;&#x68EE;&#30340; <pr>s&agrave;k&egrave;s&emacron;nde</pr></trd>
  </trdgrp>
</drv>

<drv mrk="saks.S0ujo">
  <kap><ofc>10</ofc><tld lit="S"/>ujo</kap>
  <fnt><bib>ZR</bib></fnt>
  <snc mrk="saks.S0ujo.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Regiono kaj lando de la iama &gcirc;ermana tribo de la <tld/>oj;
      geografie preska&ubreve; identa al la moderna federacia
      &scirc;tato Malsupra <tld lit="S"/>ujo.
    </dif>
    <trd lng="en">Old <ind>Saxony</ind></trd>
    <trd lng="lat">Saxonia</trd>
  </snc>
  <snc mrk="saks.S0ujo.HIS">
    <uzo tip="fak">HIS</uzo>
    <uzo tip="fak">POL</uzo>
    <dif>
      Pluraj germanaj duklandoj en la mezepoka tempo (1180 - 1572),
      prusa provinco (1815 - 1944), re&gcirc;lando (1806 - 1918); geografie
      plejparte sur la teritorioj de la modernaj federaciaj &scirc;tatoj (supra)
      <tld lit="S"/>ujo kaj <tld lit="S"/>ujo-Anhalto:
      <ekz>
        dum sia restado en Prusujo kaj <tld lit="S"/>ujo li spertadis multe da amikeco
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro XVI</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi permesas al mi anta&ubreve; &ccirc;io esprimi la plej respektan dankon de nia kongreso al
        Lia Regnestra Mo&scirc;to la Re&gcirc;o Frederiko A&ubreve;gusto de <tld lit="S"/>ujo por la
        granda honoro, kiun li faris al ni, prenante sur sin la altan protektadon de
        nia kvara kongreso
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Kvara Kongreso Esperantista en Dresden en la 17a de a&ubreve;gusto
          1908</vrk>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Herzogtum <ind>Sachsen</ind></trd>,
      <trd>K&ouml;nigreich <ind>Sachsen</ind></trd>
    </trdgrp>
    <trd lng="en">Saxony <klr>(Duchy of)</klr></trd>
    <trd lng="hu">Sz&aacute;sz Fejedelems&eacute;g</trd>
  </snc>
  <snc mrk="saks.S0ujo.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      Unu el la federaciaj &scirc;tatoj de
      <ref tip="malprt" cel="german1.G0ujo">Germanujo</ref>, historie
      kaj geografie supra Saksujo kaj okcident-Nisa parto de Silezio kun
      regurbo Dresdeno (Oficiale: Respubliko Saksujo).
    </dif>
    <trdgrp lng="de">
      <trd>Bundesland <ind>Sachsen</ind></trd>,
      <trd>Freistaat <ind>Sachsen</ind></trd>,
      <trd>Provinz <ind>Sachsen</ind></trd>
    </trdgrp>
    <trd lng="en">Saxony <klr>(Free State of)</klr></trd>
    <trd lng="hu">Sz&aacute;sz Sz&ouml;vets&eacute;gi &Aacute;llam</trd>
  </snc>
  <trd lng="be">&c_S;&c_a;&c_k;&c_s;&c_o;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="ca">Sax&ograve;nia</trd>
  <trd lng="de">Sachsen</trd>
  <trd lng="es">Sajonia</trd>
  <trd lng="fr">Saxe</trd>
  <trd lng="hu">Sz&aacute;szorsz&aacute;g</trd>
  <trd lng="it">Sassonia</trd>
  <trd lng="nl">Saksen</trd>
  <trd lng="pl">Saksonia</trd>
  <trd lng="ru">&c_S;&c_a;&c_k;&c_s;&c_o;&c_n;&c_i;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#33832;&#x514B;&#x68EE;&#x5DDE; <pr>s&agrave;k&egrave;s&emacron;nzh&omacron;u</pr></trd>,
    <trd>&#x85A9;&#x514B;&#x68EE;&#x5DDE; <pr>s&agrave;k&egrave;s&emacron;nzh&omacron;u</pr></trd>
  </trdgrp>
</drv>

<drv mrk="saks.anglo0o">
  <kap>anglo<tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <fnt><bib>WED</bib></fnt>
  <snc>
    <dif>
      Ano a&ubreve; posteulo de anoj de tiu grupo de la iama
      &gcirc;ermana
      tribo de la saksoj, kiu iam invadis Britujon. Hodia&ubreve;
      anka&ubreve; pri la modernaj angloj, usonanoj kaj aliaj
      angloparolantoj kaj la komuna parto de ilia kulturo.
    </dif>
  <trd lng="en">Anglo-Saxon</trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_n;&c_g;&c_l;&c_a;&c_s;&c_a;&c_k;&c_s;</trd>,
    <trd>&c_a;&c_n;&c_g;&c_l;&c_a;&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_je;&c_c;</trd>
  </trdgrp>
  <trd lng="ca">anglosax&oacute; <klr>(subst.)</klr></trd>
  <trdgrp lng="de">
    <trd>Angelsachse</trd>
  </trdgrp>
  <trd lng="es">anglosaj&oacute;n</trd>
  <trd lng="fr">Anglo-saxon<klr> (subst.)</klr></trd>
  <trd lng="hu">angolsz&aacute;sz</trd>
  <trd lng="it">anglosassone<klr> (sost.)</klr></trd>
  <trd lng="nl">Angelsakser</trd>
  <trd lng="pl">Anglosas</trd>
  <trd lng="ru">&c_a;&c_n;&c_g;&c_l;&c_o;&c_s;&c_a;&c_k;&c_s;</trd>
</drv>

<drv mrk="saks.anglo0a">
  <kap>anglo<tld/>a</kap>
  <uzo tip="fak">GEOG</uzo>
  <fnt><bib>WED</bib></fnt>
  <snc>
    <dif>
      Rilatanta al la areo, historio kaj kulturo de la anglosaksoj:
      <ekz>
        en Kebekio la kebekianoj etne formas integran nacion, regatan
        tamen de anglo-<tld/>a re&gcirc;imo<fnt><aut>Remigiusz
        Mielcarek</aut>:
        <vrk>Enmigrintoj en ora ka&gcirc;o</vrk>,
        <bib>Monato</bib><lok>jaro
        1994a, numero 1a, p. 15a</lok></fnt>.
      </ekz>
    </dif>
  <trd lng="en">Anglo-Saxon</trd>
  </snc>
  <trd lng="be">&c_a;&c_n;&c_g;&c_l;&c_a;&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">anglosax&oacute; <klr>(adj.)</klr></trd>
  <trd lng="cs">anglosask&yacute;</trd>
  <trdgrp lng="de">
    <trd>angels&auml;chsisch</trd>
  </trdgrp>
  <trd lng="fr">anglo-saxon<klr> (adj.)</klr></trd>
  <trd lng="hu">angolsz&aacute;sz</trd>
  <trd lng="it">anglosassone<klr> (agg.)</klr></trd>
  <trd lng="nl">angelsaksisch</trd>
  <trd lng="pl">anglosaski</trd>
  <trd lng="ru">&c_a;&c_n;&c_g;&c_l;&c_o;&c_s;&c_a;&c_k;&c_s;&c_o;&c_n;&c_s;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">anglosask&yacute;</trd>
  <trd lng="uk">&c_a;&c_n;&c_g;&c_l;&c_o;&c_s;&c_a;&c_k;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
  <trdgrp lng="zh">
    <trd>&#26679;&#x683C;&#x9C81;&#33832;&#x514B;&#x900A;
    <pr>y&agrave;ngg&eacute;l&#x1D4;s&agrave;k&egrave;x&ugrave;n</pr></trd>,
    <trd>&#x6A23;&#x683C;&#x9B6F;&#x85A9;&#x514B;&#x905C;
    <pr>y&agrave;ngg&eacute;l&#x1D4;s&agrave;k&egrave;x&ugrave;n</pr></trd>
  </trdgrp>
</drv>

