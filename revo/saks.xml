  <trdgrp lng="de">
    <trd>Niedersachsen</trd>,
    <trd>Bundesland <ind>Niedersachsen</ind></trd>
  </trdgrp>
  <trd lng="fr">Basse-Saxe</trd>
  <trd lng="hu">Als&oacute;-Sz&aacute;szorsz&aacute;g</trd>
  <trd lng="it">Bassa <ind>Sassonia</ind></trd>
  <trd lng="nl">Nedersaksen</trd>
  <trd lng="pl">Dolna  <ind>Saksonia</ind></trd>
  <trd lng="ru">&c_N;&c_i;&c_zh;&c_n;&c_ja;&c_ja; &c_S;&c_a;&c_k;&c_s;&c_o;&c_n;&c_i;&c_ja;</trd>
  <trdgrp lng="zh">
