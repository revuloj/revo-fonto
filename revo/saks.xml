  <uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      Unu el la federaciaj &scirc;tatoj de
      <ref tip="malprt" cel="german1.G0ujo">Germanujo</ref>. Historie la
      origina lando de la saksoj. Regurbo estas Hanovro.
    </dif>
  <trd lng="en">Lower Saxony</trd>
  </snc>
  <trd lng="be">&c_N;&c_ib;&c_zh;&c_n;&c_ja;&c_ja; <ind>&c_S;&c_a;&c_k;&c_s;&c_o;&c_n;&c_ib;&c_ja;</ind></trd>
