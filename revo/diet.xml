<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: diet.xml,v 1.33 2026/09/13 22:00:22 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>diet</rad>/o <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="diet.0o">
  <kap><tld/>o</kap>
  <snc mrk="diet.0o.DIET">
    <uzo tip="fak">MED</uzo>
    <dif>
      Nutromaniero, obeanta difinitan regularon:
      <ekz>
        observi severan <tld/>on;
      </ekz>
      <ekz>
        vegetara, akva, lakta <tld/>o;
      </ekz>
      <ekz>
        estas ironie, ke kelkaj debatas pri <tld/>oj, dum aliaj mortas
        pro malsato
        <fnt><aut>K. Ungar</aut>, <vrk>Vivu vigle kaj
        vegetare!</vrk>, <bib>Monato</bib>,
        <lok>1995:7, p. 18a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_d;&c_y;&c_je;&c_t;&c_a;</trd>
  <trdgrp lng="ca">
    <trd>r&egrave;gim<klr tip="amb"> (alimentari)</klr></trd>,
    <trd>dieta</trd>
  </trdgrp>
  <trd lng="cs">b&uring;&zcaron;ek</trd>
  <trd lng="de">Di&auml;t</trd>
  <trd lng="en">diet</trd>
  <trd lng="es">dieta</trd>
  <trd lng="fa">&a_r;&f_zh;&f_y;&a_m; &a_gh;&a_dh;&a_A;&f_y;&f_y;</trd>
  <trdgrp lng="fr">
    <trd>di&egrave;te<klr tip="ind"> (r&eacute;gime
    alimentaire)</klr></trd>,
    <trd>r&eacute;gime<klr tip="ind"> (alimentaire)</klr></trd>
  </trdgrp>
  <trdgrp lng="he">
    <trd>&dalet;&#1460;&yod;&alef;&#1461;&tet;&#1464;&he;</trd>,
    <trd>&tav;&zayin;&vav;&nun;&he;</trd>
  </trdgrp>
  <trd lng="hu">di&eacute;ta</trd>
  <trd lng="id">diet</trd>
  <trdgrp lng="ja">
    <trd>&#39135;&#39180;&#30274;&#27861;  <pr>&#12375;&#12423;&#12367;&#12376;&#12426;&#12423;&#12358;&#12411;&#12358;</pr></trd>,
    <trd>&#12480;&#12452;&#12456;&#12483;&#12488;  <pr>&#12384;&#12356;&#12360;&#12387;&#12392;</pr></trd>,
    <trd>&#35215;&#23450;&#39135;  <pr>&#12365;&#12390;&#12356;&#12375;&#12423;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="nl">dieet</trd>
  <trd lng="pl">dieta</trd>
  <trdgrp lng="pt">
    <trd>dieta</trd>,
    <trd>regime <klr tip="amb">(alimentar)</klr></trd>
  </trdgrp>
  <trd lng="ru">&c_d;&c_i;&c_je;&c_t;&c_a;</trd>
  <trdgrp lng="sk">
    <trd>b&ocirc;&zcaron;ik</trd>,
    <trd>di&eacute;ta</trd>
  </trdgrp>
  <trd lng="uk">&c_d;&c_ib;&c_jeu;&c_t;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#35215;&#23450;&#39154;&#39135; <pr>gu&#299;d&igrave;ngy&#464;nsh&iacute;</pr></trd>,
    <trd>&#31680;&#39135; <pr>ji&eacute;sh&iacute;</pr></trd>,
    <trd>&#29305;&#31181;&#39278;&#39135; <pr>t&egrave;zh&#466;ngy&#464;nsh&iacute;</pr></trd>,
    <trd>&#20581;&#24609; <pr>ji&agrave;ny&iacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="diet.0i">
  <kap><tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="diet.0i.DIET">
    <dif>
      Sin nutri la&ubreve; moderaj reguloj koncerne tipojn, kvantojn de
      man&gcirc;a&jcirc;oj,
      a&ubreve; tempojn de man&gcirc;ado:
      <ekz>
        anstata&ubreve; frandemi, &scirc;i &ccirc;iam <tld/>is
        <fnt><bib>RugxDom</bib> <lok>&ccirc;apitro 53a, p.
        182a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_b;&c_y;&c_c;&c_mol; &c_n;&c_a;
  <ind>&c_d;&c_y;&c_je;&c_c;&c_je;</ind></trd>
  <trdgrp lng="ca">
    <trd>seguir un <ind>r&egrave;gim</ind></trd>,
    <trd>fer <ind>dieta</ind></trd>,
    <trd>estar a <ind>r&egrave;gim</ind></trd>
  </trdgrp>
  <trd lng="de">eine <ind>Di&auml;t</ind> machen</trd>
  <trdgrp lng="en">
    <trd>diet</trd>,
    <trd>be on a <ind>diet</ind></trd>
  </trdgrp>
  <trd lng="fa">&a_r;&f_zh;&f_y;&a_m; &f_g;&a_r;&a_f;&a_t;&a_n;</trd>
  <trdgrp lng="fr">
    <trd>faire <ind>di&egrave;te</ind></trd>,
    <trd>suivre un <ind>r&eacute;gime</ind></trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>di&eacute;t&aacute;zik</trd>,
    <trd>di&eacute;t&aacute;t tart</trd>
  </trdgrp>
  <trd lng="id"><baz>diet</baz>berdiet</trd>
  <trd lng="nl">dieet volgen</trd>
  <trdgrp lng="pl">
    <trd>by&cacute; na <ind>diecie</ind></trd>,
    <trd>stosowa&cacute; <ind>diet&eogonek;</ind></trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_s;&c_i;&c_d;&c_je;&c_t;&c_mol; &c_n;&c_a;
    <ind>&c_d;&c_i;&c_je;&c_t;&c_je;</ind></trd>,
    <trd>&c_b;&c_y;&c_t;&c_mol; &c_n;&c_a;
    <ind>&c_d;&c_i;&c_je;&c_t;&c_je;</ind></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#20943;&#32933; <pr>ji&#462;nf&eacute;i</pr></trd>,
    <trd>&#25106;&#21475; <pr>ji&egrave;k&#466;u</pr></trd>
  </trdgrp>
</drv>

<drv mrk="diet.0ero">
  <kap><tld/>ero</kap>
  <snc mrk="diet.0ero.DIET">
    <dif>
      Iu el la nutraj substancoj provizataj de man&gcirc;a&jcirc;oj,
      kiuj rolas en metabolo:
      <ekz>
        e&ccirc; granda kvanto da man&gcirc;a&jcirc;o, kiu estas deficita
        je unu <tld/>ero, povas rezultigi misnutradon kaj
        malsanon
        <fnt><aut>W. F. Rolt</aut>, <vrk>El la Polvo de la Tero</vrk>,
        <lok>1967</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="nutr.0ajxo.BIO">nutra&jcirc;o</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_zh;&c_y;&c_w;&c_n;&c_y;
  <ind>&c_e;&c_l;&c_je;&c_m;&c_e;&c_n;&c_t;</ind></trd>
  <trdgrp lng="fr">
    <trd>&eacute;l&eacute;ment nutritif</trd>,
    <trd>nutriment</trd>
  </trdgrp>
  <trd lng="id">nutrisi diet</trd>
  <trd lng="pl">sk&lstroke;adnik od&zdot;ywczy</trd>
</drv>
</art>
