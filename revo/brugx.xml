<art mrk="$Id: brugx.xml,v 1.16 2026/10/24 10:53:37 revo Exp $">
<kap>
  <rad>Bru&gcirc;</rad>/o
</kap>
<drv mrk="brugx.B0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <fnt><bib>PIV1</bib></fnt>
  <snc>
    <dif>
      <ref tip="lst" lst="voko:urboj" cel="urb.0o">Urbo</ref> en la belga provinco
      <ref tip="malprt" cel="flandr.F0ujo.prov">Okcident-Flandrujo</ref>
      (3&deg;13&minute;E, 51&deg;13&minute;N):
      <ekz>
        la belga urbo <tld/>o, samtempe kun la hispana Salamanca, estas
        kultura &ccirc;efurbo de E&ubreve;ropo dum 2002<fnt>
        <aut>Roland Rotsaert</aut>:
        <vrk><url ref="&Monato;/2002/pdf/monato200204.pdf#page=17">Mezepoka Hanso-asocio
        revivi&gcirc;as</url></vrk>,
        <bib>Monato</bib>
        <lok>2002/04, p. 17</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_B;&c_r;&c_u;&c_g;&c_je;</trd>
  <trd lng="de">Br&uuml;gge</trd>
  <trd lng="en">Bruges</trd>
  <trd lng="es">Brujas</trd>
  <trd lng="fa">&a_b;&a_r;&a_w;&f_zh;</trd>
  <trd lng="fr">Bruges</trd>
  <trdgrp lng="hu">
    <trd>Brugge</trd>,
    <trd>Bruges</trd>
  </trdgrp>
  <trd lng="it">Bruges</trd>
  <trd lng="ja">&#x30D6;&#x30EB;&#x30C3;&#x30D8;</trd>
  <trd lng="lat">Brugis Flandrorum</trd>
  <trd lng="nl">Brugge</trd>
  <trd lng="pl">Brugia</trd>
  <trd lng="ru">&c_B;&c_r;&c_ju;&c_g;&c_g;&c_je;</trd>
  <trd lng="uk">&c_B;&c_r;&#x44E;&c_g;&c_g;&c_je;</trd>
</drv>
</art>
