<vortaro>
  <art mrk="$Id: testosteron.xml,v 1.6 2026/11/19 20:00:19 afido Exp $">
    <kap>
      <rad>testosteron</rad>/o
    </kap>

<drv mrk="testosteron.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">FIZL</uzo>
  <snc mrk="testosteron.0o.FIZL">
    <dif>
      <frm>C<sub>19</sub>H<sub>28</sub>O<sub>2</sub></frm>;
      Seksa <ref tip="super" cel="hormon.0o.FIZL">hormono</ref>, precipe produktata en la viraj
      testikloj:
      <ekz>
        iliaj korpoj ne konas la efikojn de vira <tld/>o a&ubreve; de adrenalino, do ili ne
        militas, kverelas, a&ubreve; eksciti&gcirc;as
        <fnt>
          <bib>Monato</bib>
          <aut>Garvan Makaj'</aut>
          <vrk><url ref="&Monato;/2015/011355.php">Komunika&jcirc;o de Ikaro</url></vrk>
          <lok>2015/01, p. 22</lok>
        </fnt>;
       </ekz>
      <ekz>
        volupto estas la dekomenca pasia seksa deziro kiu helpas la pari&gcirc;on, kaj
        kondukas al plii&gcirc;anta liberigo de kemia&jcirc;oj kiaj <tld/>o kaj estrogeno
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=30233">Amo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_t;&c_e;&c_s;&c_t;&c_a;&c_s;&c_t;&c_e;&c_r;&c_o;&c_n;</trd>
    <trd lng="de">Testosteron</trd>
    <trd lng="en">Testosterone</trd>
    <trd lng="fr">Testost&eacute;rone</trd>
    <trd lng="nl">testosteron</trd>
    <trd lng="pl">testosteron</trd>
    <trd lng="ru">&c_T;&c_je;&c_s;&c_t;&c_o;&c_s;&c_t;&c_je;&c_r;&c_o;&c_n;</trd>
    <trdgrp lng="zh">
    <trd>&#30590;&#20024;&#30014;&#37230; <pr>g&#257;ow&aacute;nz&#257;it&oacute;ng</pr></trd>,
    <trd>&#30590;&#20024;&#28608;&#32032; <pr>g&#257;ow&aacute;nj&#299;s&ugrave;</pr></trd>,
    <trd>&#30590;&#20024;&#37230; <pr>g&#257;ow&aacute;nt&oacute;ng</pr></trd>,
    <trd>&#30590;&#20024;&#32032; <pr>g&#257;ow&aacute;ns&ugrave;</pr></trd>
  </trdgrp>
</snc>
  <trd lng="ca">testosterona</trd>
  <trd lng="es">testosterona</trd>
</drv>
