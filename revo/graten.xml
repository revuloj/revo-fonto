<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: graten.xml,v 1.29 2026/09/15 11:39:04 revo Exp $">
<kap>
<rad>graten</rad>/i
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="graten.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <uzo tip="fak">KUI</uzo>
  <snc mrk="graten.0i.KUI">
    <dif>
      Kovri man&gcirc;a&jcirc;on per ia miksa&jcirc;o el kremo, ovo, paneroj, froma&gcirc;o
      kaj baki &gcirc;in &gcirc;is formi&gcirc;o de delikata krusteto:
      <ekz>
        terpomoj <tld/>itaj per froma&gcirc;o;
      </ekz>
      <ekz>
        dum la sekvaj <klr>[&#x2026;]</klr> festotagoj ili laborigas siajn stomakojn per
        buljono, far&ccirc;ita brasiko, <klr>[&#x2026;]</klr> <tld/>ita viando
        <fnt>
          <aut>Szil&aacute;rd Balint</aut>
          <vrk><url ref="https://tempa.bitarkivo.org/gazetoj/HungaraVivo/HungaraVivo_1981_6.pdf"
              >Kristnasko en la nuna Hungario</url></vrk>
          <lok>Hungara Vivo 6/1982, p. 219</lok>
        </fnt>;
      </ekz>
      <ekz>
        la fi&scirc;o estas la plej bongusta man&gcirc;a&jcirc;o <klr>[&#x2026;]</klr> &ccirc;i tie, kvankam oni
        <tld/>as &gcirc;in en faruno
        <fnt>
          <aut>Jen&otilde; Rejt&otilde;, trad. L&aacute;szl&oacute; Bal&aacute;zs</aut>
          <vrk><url ref="https://libro.ee/file.php?id=2885"
              >La Tri Korpogardistoj en Afriko</url></vrk>
          <lok>&ccirc;ap. 1, p. 219</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>krustbaki</ke>, <ke>krustige baki</ke>,
    <ke>krustumi</ke>.
  </rim>

  <ref tip="vid" cel="pan.0erumi">panerumi</ref>
  <trdgrp lng="be">
    <trd>&c_p;&c_ja;&c_ch;&c_y; <klr>(&c_je;&c_zh;&c_u;)</klr></trd>,
    <trd>&c_z;&c_a;&c_p;&c_ja;&c_k;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="ca">gratinar</trd>
  <trdgrp lng="cs">
    <trd>zap&eacute;ci</trd>,
    <trd>zap&eacute;kat</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>gratinieren</trd>,
    <trd>&uuml;berbacken</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>grill <klr>(culinary)</klr></trd>,
    <trd>brown <klr>(culinary)</klr></trd>
  </trdgrp>
  <trd lng="es">gratinar</trd>
  <trd lng="fr">gratiner</trd>
  <trdgrp lng="hu">
    <trd>cs&odblac;ben <ind>s&uuml;t</ind></trd>,
    <trd>gratin&iacute;roz</trd>
  </trdgrp>
  <trd lng="ja">&#x30B0;&#x30E9;&#x30BF;&#x30F3;&#x306B;&#x3059;&#x308B;  <pr>&#x3050;&#x3089;&#x305F;&#x3093;&#x306B;&#x3059;&#x308B;</pr></trd>
  <trd lng="nl">gratineren</trd>
  <trd lng="pl">panierowa&cacute;</trd>
  <trd lng="pt">preparar comida &agrave; <ind>milanesa</ind></trd>
  <trdgrp lng="ru">
    <trd>&c_z;&c_a;&c_p;&c_je;&c_ch;&c_mol;</trd>,
    <trd>&c_z;&c_a;&c_p;&c_je;&c_k;&c_a;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>zapeka&tcaron;</trd>,
    <trd>zapiec&tcaron;</trd>
  </trdgrp>
  <trd lng="tr">g&uuml;ve&ccedil;te pi&scedil;irmek </trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_ib;&c_d;&c_s;&c_m;&c_a;&c_zh;&c_u;&c_v;&c_a;&c_t;&c_i; &c_v; &c_s;&c_u;&c_h;&c_a;&c_r;&c_ja;&c_h;</trd>,
    <trd>&c_z;&c_a;&c_p;&c_ib;&c_k;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
</drv>

<drv mrk="graten.0ajxo">
  <kap><tld/>a&jcirc;o</kap>
  <uzo tip="fak">KUI</uzo>
  <snc mrk="graten.0ajxo.KUI">
    <dif>
      <tld lit="G"/>ita man&gcirc;a&jcirc;o:
      <ekz>
        en <tld/>a&jcirc;oj, supoj, tortoj kaj kukoj, la partoprenantoj malkovris tradiciajn
        a&ubreve; originalajn manierojn man&gcirc;i kukurbon
        <fnt>
          <bib>LOdE</bib>
          <lok>2002, &#x2116; 12</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_z;&c_a;&c_p;&c_ja;&c_k;&c_a;&c_n;&c_k;&c_a;</trd>
  <trd lng="ca">menjar gratinat</trd>
  <trdgrp lng="de">
    <trd>Auflauf</trd>,
    <trd>Gratin</trd>
  </trdgrp>
  <trd lng="en">gratin</trd>
  <trd lng="fr">gratin</trd>
  <trd lng="hu">cs&odblac;ben <ind>s&uuml;lt</ind></trd>
  <trd lng="ja">&#x30B0;&#x30E9;&#x30BF;&#x30F3;</trd>
  <trd lng="nl">gratin</trd>
  <trdgrp lng="pl">
    <trd>potrawa <ind>panierowana</ind></trd>,
    <trd>potrawa w <ind>panierce</ind></trd>
  </trdgrp>
  <trd lng="pt">comida &agrave; <ind>milanesa</ind></trd>
  <trd lng="ru">&c_z;&c_a;&c_p;&c_je;&c_k;&c_a;&c_n;&c_k;&c_a;</trd>
  <trd lng="tr">g&uuml;ve&ccedil;te pi&scedil;mi&scedil; yiyecek</trd>
  <trd lng="uk">&c_z;&c_a;&c_p;&c_ib;&c_k;&c_a;&c_n;&c_k;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#x86CB;&#x767D;&#x725B;&#x5976;&#x9165; <pr>d&agrave;nb&aacute;ini&uacute;n&#x1CE;is&umacron;</pr></trd>,
    <trd>&#x9165;&#x9905; <pr>s&umacron;b&#x1D0;ng</pr></trd>,
    <trd>&#x9921;&#x9905; <pr>xi&agrave;nb&#x1D0;ng</pr></trd>
  </trdgrp>
</drv>
</art>
