<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: interv1.xml,v 1.31 2026/08/12 07:50:29 revo Exp $">
<kap>
  <ofc>3</ofc>
  <rad>intervju</rad>/o <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="interv1.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="interv1.0i.INF">
    <dif>
      <ref tip="super" cel="demand.pri0i">Pridemandi</ref> iun pri vivo, opinioj kaj similaj
      por posta, ofte publika raporto:
      <ekz>
        mia koro bategis, kiam mi eniris oficejon kaj <tld/>is <klr>[&#8230;]</klr> direktorojn
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro XIV</lok>
        </fnt>;
      </ekz>
      <ekz>
        la observanto de UEA estis plurfoje <tld/>ita
        <fnt>
          <bib>EeP</bib>
          <lok>Kvina Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;ajnis al mi, ke la <tld/>anto ne estas justa
        <fnt>
          <bib>ChV</bib>
          <lok>14</lok>
        </fnt>;
      </ekz>
      <ekz>
        la realaj nomoj de la <tld/>atoj estis &scirc;an&gcirc;itaj
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi tuj iru al Stokholmo por <tld/>i nian agenton en tiu urbego
        <fnt>
          <bib>KKl</bib>
          <lok>&Ccirc;apitro 5</lok>
        </fnt>;
      </ekz>
      <ekz>
        imamo de roterdama moskeo estis <tld/>ita televide
        <fnt>
          <aut>G. Berveling</aut>:
          <vrk>Samseksemo kaj islamo</vrk>,
          <bib>Monato</bib>, <lok>2001:10, p.
          15a</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="enket.0i">enketi</ref>
  </snc>
  <trd lng="be">&c_ib;&c_n;&c_t;&c_e;&c_r;&c_v;&c_ib;&c_ja;&c_v;&c_a;&c_c;&c_mol;</trd>
  <trd lng="cs">interviewovat</trd>
  <trdgrp lng="de">
    <trd>befragen</trd>,
    <trd>interviewen</trd>
  </trdgrp>
  <trd lng="en">interview</trd>
  <trd lng="es">entrevistar</trd>
  <trd lng="fa">&a_m;&a_S;&a_A;&a_H;&a_b;&a_h; &f_k;&a_r;&a_d;&a_n;<klr> (&a_b;&a_A;)</klr></trd>
  <trdgrp lng="fr">
    <trd>interviewer</trd>,
    <trd>interroger<klr tip="ind"> (interviewer)</klr></trd>
  </trdgrp>
  <trd lng="hu">interj&uacute;vol</trd>
  <trdgrp lng="id">
    <trd><baz>wawancara</baz>mewawancara</trd>,
    <trd><baz>wawancara</baz>mewawancarai</trd>,
    <trd><baz>interviu</baz>menginterviu</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30A4;&#x30F3;&#x30BF;&#x30D3;&#x30E5;&#x30FC;&#12377;&#x308B; 
    <pr>&#12356;&#12435;&#x305F;&#12403;&#12421;&#x30FC;&#12377;&#x308B;</pr></trd>,
    <trd>&#38754;&#x63A5;&#12377;&#x308B;  <pr>&#12417;&#12435;&#x305B;&#12388;&#12377;&#x308B;</pr></trd>
  </trdgrp>
  <trd lng="nl">interviewen</trd>
  <trd lng="pl">przeprowadzi&cacute; <ind>wywiad</ind> z kim&sacute;</trd>
  <trd lng="pt">entrevistar</trd>
  <trd lng="ru">&c_i;&c_n;&c_t;&c_je;&c_r;&c_v;&c_mol;&c_ju;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
  <trd lng="sk">interviewova&tcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_ib;&c_n;&c_t;&c_je;&c_r;&c_v;&#8217;&c_ju;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_b;&c_r;&c_a;&c_t;&c_i; &c_ib;&c_n;&c_t;&c_je;&c_r;&c_v;&#8217;&c_ju;</trd>
  </trdgrp>
  <trd lng="zh">&#x8A2A;&#x8AC7; <pr>f&#x1CE;ngt&aacute;n</pr></trd>
</drv>

<drv mrk="interv1.0o">
  <kap><tld/>o</kap>
  <snc mrk="interv1.0o.INF">
    <dif>
      Interparolo konsistanta el demandoj kaj respondoj
      pri ies vivo, agoj a&ubreve; opinioj por raporto:
      <ekz>
        <ctl>pri kelkaj problemoj de interlingvistiko</ctl> estas
        surpaperigo de <tld/>o kun la franca lingvisto
        <nom>Andr&eacute; Martinet</nom>
        <fnt><aut>PP</aut>, <vrk>Fascina bro&scirc;uro</vrk>,
        <bib>Monato</bib>, <lok>199311, p.
        23a</lok></fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> penis koncentri sian tutan atenton pri la <tld/>o, kiun li
        intencas havi kun la fratoj de la plej bela el &ccirc;iuj virinoj
        <fnt>
          <bib>KKl</bib>
          <lok>&Ccirc;apitro 10</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi vizitis &scirc;in, sed la <tld/>o ne liveris interesajn detalojn
        <fnt>
          <bib>ChV</bib>
          <lok>10</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="enket.0o">enketo</ref>
  </snc>
  <trd lng="be">&c_ib;&c_n;&c_t;&c_e;&c_r;&c_v;&c_ib;&c_ju;</trd>
  <trd lng="cs">interview</trd>
  <trdgrp lng="de">
    <trd>Befragung</trd>,
    <trd>Interview</trd>
  </trdgrp>
  <trd lng="en">interview</trd>
  <trd lng="es">entrevista</trd>
  <trd lng="fa">&a_m;&a_S;&a_A;&a_H;&a_b;&a_h;</trd>
  <trdgrp lng="fr">
    <trd>interview</trd>,
    <trd>entrevue<klr tip="ind"> (interview)</klr></trd>
    <trd>entretien</trd>
  </trdgrp>
  <trd lng="hu">interj&uacute;</trd>
  <trdgrp lng="id">
    <trd>wawancara</trd>,
    <trd>interviu</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30A4;&#x30F3;&#x30BF;&#x30D3;&#x30E5;&#x30FC;  <pr>&#12356;&#12435;&#x305F;&#12403;&#12421;&#x30FC;</pr></trd>,
    <trd>&#x53D6;&#26448;&#x8A2A;&#x554F;  <pr>&#12375;&#12421;&#12374;&#12356;&#x307B;&#12358;&#12418;&#12435;</pr></trd>,
    <trd>&#38754;&#x63A5;  <pr>&#12417;&#12435;&#x305B;&#12388;</pr></trd>
  </trdgrp>
  <trdgrp lng="lat">
    <trd>colloquium, ii percontatiuum</trd>,
    <trd>colloquium, ii interrogatiuum</trd>
  </trdgrp>
  <trd lng="nl">interview</trd>
  <trd lng="pl">wywiad <klr>(radio)</klr></trd>
  <trd lng="pt">entrevista</trd>
  <trd lng="ru">&c_i;&c_n;&c_t;&c_je;&c_r;&c_v;&c_mol;&c_ju;</trd>
  <trd lng="sk">interview</trd>
  <trd lng="uk">&c_ib;&c_n;&c_t;&c_je;&c_r;&c_v;&#8217;&c_ju;</trd>
  <trdgrp lng="zh">
    <trd>&#38754;&#x8A66; <pr>mi&agrave;nsh&igrave;</pr></trd>,
    <trd>&#x8A2A;&#x8AC7; <pr>f&#x1CE;ngt&aacute;n</pr></trd>,
    <trd>&#26212;&#x8AC7; <pr>w&ugrave;t&aacute;n</pr></trd>,
    <trd>&#38754;&#x8AC7; <pr>mi&agrave;nt&aacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="interv1.0igxi">
  <kap><tld/>i&gcirc;i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="interv1.0igxi.INF">
    <dif>
      Respondi al demandoj de <tld/>o:
      <ekz>
        &ccirc;u vi venas <klr>[&#8230;]</klr> al nia &ccirc;efsidejo por
        <tld/>i&gcirc;i?
        <fnt>
          <aut>Chun-Chan Yeh, trad. W. Auld</aut>
          <vrk>Montara Vila&gcirc;o</vrk>
          <lok>1984</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_d;&c_a;&c_v;&c_a;&c_c;&c_mol; <ind>&c_ib;&c_n;&c_t;&c_e;&c_r;&c_v;&c_ib;&c_ju;</ind></trd>
  <trd lng="en">be <ind>interview</ind>ed</trd>
  <trdgrp lng="fr">
    <trd>donner un <ind>entretien</ind></trd>,
    <trd>se faire <ind>interviewer</ind></trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd><baz>wawancara</baz>diwawancara</trd>,
    <trd><baz>wawancara</baz>diwawancarai</trd>,
    <trd><baz>interviu</baz>diinterviu</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30A4;&#x30F3;&#x30BF;&#x30D3;&#x30E5;&#x30FC;&#12434;&#x53D7;&#12369;&#x308B; 
    <pr>&#12356;&#12435;&#x305F;&#12403;&#12421;&#x30FC;&#12434;&#12358;&#12369;&#x308B;</pr></trd>,
    <trd>&#38754;&#x63A5;&#12434;&#x53D7;&#12369;&#x308B;  <pr>&#12417;&#12435;&#x305B;&#12388;&#12434;&#12358;&#12369;&#x308B;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>udzieli&cacute; <ind>wywiadu</ind></trd>,
    <trd>by&cacute; przes&lstroke;uchiwanym</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#38754;&#x8A66; <pr>mi&agrave;nsh&igrave;</pr></trd>,
    <trd>&#x53D7;&#x8A2A; <pr>sh&ograve;uf&#x1CE;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="interv1.0isto">
  <kap>
    <tld/>isto
  </kap>
  <snc>
    <dif>
      Iu, kiu profesie <tld/>as:
      <ekz>
        en la elsendo a&ubreve;deblis la bona interkompreno inter <nom>Martin</nom>, <nom>Uriel</nom> kaj
        la
        <tld/>istino
        <fnt>
          <bib>Kon11</bib>
          <lok>Nikaragvo: bona semo estis plantita (Po&oacute;r Veronika)</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Interviewer</trd>
  <trd lng="en">interviewer</trd>
<trdgrp lng="id">
  <trd><baz>wawancara</baz>pewawancara</trd>,
  <trd><baz>interviu</baz>penginterviu</trd>
</trdgrp>
</drv>

<drv mrk="interv1.dung0o">
  <kap>dung<tld/>o,
  <var><kap>labor<tld/>o</kap></var>
  </kap>
  <snc mrk="interv1.dung0o.EKON">
    <dif>
      <tld lit="I"/>o per kiu proponanto de laboro esploras la pretecon de kandidato:
      <ekz>
        imagu, kion mi a&ubreve;dis dum dung<tld/>o:
        &leftquot;&ccirc;u vi havas sperton?&#x201D;
        &leftquot;jes, multan, jam 50 <tld/>ojn.&#x201D;
        <fnt>
          <aut>-</aut>
          <vrk><url ref="https://tatoeba.org/tgl/sentences/show/6736127">Frazo 6736127a</url></vrk>
          <lok>Tatoeba, [2018?]</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi sukcesis pri la unua labor<tld/>o
        <fnt>
          <aut>noktema</aut>
          <vrk><url ref="https://www.youtube.com/watch?v=rB2ZE3dyyeA">
          E-bloga&jcirc;o - saluton ree</url></vrk>
          <lok>2010</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_s;&c_u;&c_r;&c_a;&c_z;&c_m;&c_o;&c_w;&c_je; <klr>(&c_p;&c_r;&c_y; &c_p;&c_r;&c_y;&c_jo;&c_m;&c_je; &c_n;&c_a; &c_p;&c_r;&c_a;&c_c;&c_u;)</klr></trd>
  <trd lng="en">employment <ind>interview</ind></trd>
  <trd lng="fr">entretien d'embauche</trd>
  <trdgrp lng="id">
    <trd>wawancara kerja</trd>,
    <trd>interviu kerja</trd>
  </trdgrp>
  <trd lng="pl">rozmowa kwalifikacyjna</trd>
  <trd lng="zh">&#38754;&#x8A66; <pr>mi&agrave;nsh&igrave;</pr></trd>
</drv>
</art>
