<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: morbid.xml,v 1.1 2026/10/01 18:34:53 afido Exp $">
    <kap>
      <rad>morbid</rad>/a
    </kap>

<drv mrk="morbid.0a">
  <kap><tld/>a</kap>
  <uzo tip="stl">RAR</uzo>
  <snc>
    <dif>
      Aspektanta malsana, iom <ref tip="super" cel="kaduk.0a">kaduka</ref>,
      perdinta iaman viglecon kaj brilon;
      <ref tip="dif" cel="san.mal0ema">malsanema</ref>:
      <ekz>
        la domoj sur la alia stratflanko aspektas &ccirc;iuj neoklasikismaj, ili bezonus novan
        farbon, sed ili tamen pla&ccirc;as al ni, pro la <tld/>a eleganteco
        <fnt>
          <aut>Hans-Georg Kaiser</aut>
          <vrk><url ref="https://karapacopanoramo.blogspot.com/2012/07/cezar-klaus-rakonto.html"
              >Klaus</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la intrigo de la opero restas <tld/>a: la princo <nom>Sternenhoch</nom>, stranga, ebriema
        kaj fiera, <klr>[&#x2026;]</klr> elektas ene de iu sova&gcirc;a festeno malbelan
        purigistinon <nom>Helga</nom>, <klr>[&#x2026;]</klr> al kiu li sentas na&ubreve;zon, sed samtempe amon
        <fnt>
          <aut>Petro Chrdle</aut>
          <vrk><url ref="https://www.esperanto.cz/soubory/chrdle_esperanto-aktuell_2018-3-7-sternenhoch.pdf"
              >Opero en Esperanto en la praga Nacia Teatro</url></vrk>
          <lok>Esperanto aktuell 3/2018 &#x2116; 24, p. 7</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="dekade.0o">dekadenca</ref>,
      <ref cel="vigl.mal0a">malvigla</ref>,
      <ref cel="melank.0a">melankolia</ref>
    </refgrp>
    <trd lng="de">morbid</trd>
    <trd lng="en">morbid</trd>
    <trd lng="fr">morbide</trd>
  </snc>
</drv>

  </art>


