<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: koroid.xml,v 1.1 2026/11/28 08:22:07 afido Exp $">
    <kap>
      <rad>koroid</rad>/o
      <fnt><bib>PIV1</bib></fnt>,
      <var><kap><rad var="hx">&hcirc;oroid</rad>/o
        <fnt>
          <aut>d-ro Briquet</aut>
          <vrk><url ref="https://www.eventoj.hu/steb/vortaroj/eo-teknika-medicina-vortaro-Briquet.pdf"
              >Esperanta Teknika Medicina Vortaro</url></vrk>
        </fnt>
      </kap></var>
    </kap>

<drv mrk="koroid.0o">
  <kap><tld/>o, <var><kap><tld var="hx"/>o</kap></var></kap>
  <snc mrk="koroid.0o.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Membrano inter sklero kaj retino de la <ref tip="malprt" cel="okul.0o.ANA">okulo</ref>
      (<trd lng="la">Chorioidea</trd>),
      enhavanta la sangujojn nutrantaj la najbarajn histojn:
      <ekz>
        la meza tavolo de la birda okulo anka&ubreve; estas la <tld/>o, kiel &ccirc;e aliaj
        vertebruloj <klr>[&#x2026;]</klr>, plej malsimilaj el tri tavoloj inter la birdoj
        kaj al la vertebruloj estas la retino
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=126747"
              >Senso (birdoj)</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Aderhaut</trd>,
      <trd>Chorioidea</trd>
    </trdgrp>
    <trd lng="en">choroid</trd>
    <trd lng="fr">choro&iuml;de</trd>
    <trd lng="ru">&c_h;&c_o;&c_r;&c_i;&c_o;&c_i;&c_d;&c_je;&c_a;</trd>
    <trd lng="uk">&c_h;&c_o;&c_r;&c_ib;&c_o;&c_ib;&c_d;&c_je;&c_a;</trd>
  </snc>
</drv>

  </art>


