<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: arteri.xml,v 1.33 2026/08/05 19:52:09 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>arteri</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="arteri.0o">
  <kap><tld/>o</kap>
  <snc mrk="arteri.0o.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Tubeto, kiu kondukas la sangon el la koro &gcirc;is &ccirc;iuj partoj de
      la korpo:
      <ekz>
        dum la kuracisto apogis sian fingron sur la <tld/>on, lia rigardo ne forlasis la
        viza&gcirc;on de l&#x2019; agonianto
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        la efiko estas plilar&gcirc;igi <tld/>ojn, kaj tio plifaciligas la
        fluon
        de oksigenita sango al la koro
        <fnt>
          <aut>David Curtis</aut>
          <vrk><url ref="&Monato;/2002/pdf/monato200201.pdf#page=28">Koratako</url></vrk>
          <bib>Monato</bib>
          <lok>2002/01, p. 28-34</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">art&egrave;ria</trd>
    <trdgrp lng="de">
      <trd>Arterie</trd>,
      <trd>Schlagader</trd>
    </trdgrp>
    <trd lng="en">artery</trd>
    <trdgrp lng="id">
      <trd>arteri</trd>,
      <trd>pem<ind>buluh</ind> nadi</trd>
    </trdgrp>
    <trd lng="nl">slagader</trd>
    <trd lng="pl">t&eogonek;tnica</trd>
    <trdgrp lng="zh">
      <trd>&#x52A8;&#x8109; <pr>d&ograve;ngm&agrave;i</pr></trd>,
      <trd>&#x52D5;&#x8108; <pr>d&ograve;ngm&agrave;i</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="arteri.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Trafikvojo:
      <ekz>
        strato tridek pa&scirc;ojn lar&gcirc;a, sufi&ccirc;e rekta, pavimita per plataj &scirc;tonoj, formis la
        &ccirc;efan <tld/>on
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro XIX</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;i tien rapidas torentoj de proletaro, trafluante &ccirc;iujn <tld/>ojn de la grandega
        urbo
        <fnt>
          <bib>Metrop</bib>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Verkehrsader</trd>
    </trdgrp>
    <trd lng="en"><klr>(traffic) </klr>artery</trd>
    <trd lng="nl">verkeersader</trd>
    <trdgrp lng="zh">
      <trd>&#x4EA4;&#x901A;&#x5E72;&#x7EBF; <pr>ji&amacron;ot&omacron;ngg&agrave;nxi&agrave;n</pr></trd>,
      <trd>&#x4EA4;&#x901A;&#x5E79;&#x7DDA; <pr>ji&amacron;ot&omacron;ngg&agrave;nxi&agrave;n</pr></trd>,
      <trd>&#x4E3B;&#x52A8;&#x8109; <pr>zh&#x1D4;d&ograve;ngm&agrave;i</pr></trd>,
      <trd>&#x4E3B;&#x52D5;&#x8108; <pr>zh&#x1D4;d&ograve;ngm&agrave;i</pr></trd>,
      <trd>&#x4E3B;&#x8981;&#x9053;&#x8DEF; <pr>zh&#x1D4;y&agrave;od&agrave;ol&ugrave;</pr></trd>,
      <trd>&#x4E3B;&#x901A;&#x9053; <pr>zh&#x1D4;t&omacron;ngd&agrave;o</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_a;&c_r;&c_t;&c_e;&c_r;&c_y;&c_ja;</trd>
  <trd lng="ca">art&egrave;ria</trd>
  <trdgrp lng="cs">
    <trd>art&eacute;rie</trd>,
    <trd>tepna</trd>
  </trdgrp>
  <trd lng="es">arteria</trd>
  <trd lng="fr">art&egrave;re</trd>
  <trd lng="he">&ayin;&vav;&resh;&qof;</trd>
  <trd lng="id"><ind>jalan</ind> arteri</trd>
  <trd lng="it">arteria</trd>
  <trd lng="ja">&#x52D5;&#x8108;  <pr>&#x3069;&#x3046;&#x307F;&#x3083;&#x304F;</pr></trd>
  <trd lng="pl">arteria</trd>
  <trd lng="ru">&c_a;&c_r;&c_t;&c_je;&c_r;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>tepna</trd>,
    <trd>art&eacute;ria</trd>
  </trdgrp>
  <trd lng="uk">&c_a;&c_r;&c_t;&c_je;&c_r;&c_ib;&c_ja;</trd>
</drv>
</art>
