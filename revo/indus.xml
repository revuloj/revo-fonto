<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: indus.xml,v 1.10 2026/10/15 20:00:21 revo Exp $">
    <kap><ofc>10</ofc>
      <rad>Indus</rad>/o
    </kap>

<drv mrk="indus.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Granda <ref tip="lst" lst="voko:riveroj" cel="river.0o.GEOG">rivero</ref>
      en suda <ref tip="malprt" cel="azi.A0o">Azio</ref>, pli ol 3000&#8239;km longa, eliranta el
      Tibeto fluanta tra Ka&scirc;miro kaj Pakistano:
      <ekz>
        apartan gloron Samarkando akiris dum la regado de elstara &scirc;tata aganto <nom>Amir
        Temur</nom> (1336-1405), kiu igis &gcirc;in &ccirc;efurbo de sia grandega imperio en Azio,
        etendi&gcirc;anta de la rivero <tld/>o &gcirc;is la markolo Bosporo
        <fnt>
          <bib>Monato</bib>
          <aut>Anatoli Ionesov</aut>
          <vrk><url ref="&Monato;/2006/008920.php">Perlo &ccirc;e la Silka Vojo</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la nomo Hindio derivi&gcirc;as de la vorto &leftquot;<nac>sindhu</nac>&rightquot;, kiu en la
        sanskrita havas la
        signifon de &leftquot;rivero&#8221; kaj estis ne hazarde la nomo donita al <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2014/011358.php">Notoj indaj pri lingvaroj
          hindaj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Indus</trd>
    <trd lng="en">Indus river</trd>
    <trd lng="fr">Indus</trd>
    <trd lng="pl">Indus</trd>
  </snc>
  <trd lng="be">&c_Ib;&c_n;&c_d; <klr>(&c_r;&c_a;&c_k;&c_a;)</klr></trd>
  <trd lng="ca">Indus</trd>
  <trd lng="es">Indo</trd>
  <trd lng="ja">&#12452;&#12531;&#12480;&#12473;&#24029; 
  <pr>&#12452;&#12531;&#12480;&#12473;&#12363;&#12431;</pr></trd>
  <trd lng="uk">&c_Ib;&c_n;&c_d;</trd>
  <trd lng="zh">&#21360;&#24230;&#27827; <pr>Y&igrave;nd&ugrave;H&eacute;</pr></trd>
</drv>
</art>

