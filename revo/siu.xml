<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: siu.xml,v 1.11 2026/10/03 14:00:19 revo Exp $">
<kap>
  <rad>siu</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="siu.0o">
  <kap><tld/>o</kap>
  <snc mrk="siu.0o.ETN">
    <dif>
      <ref tip="super" cel="indian.0o.ETN">Indiano</ref> el plurgenta
      popolo vivinta en la usona ebena&jcirc;o, nun precipe en
Suddakoto.
      <ekz>
        <ctl>Historietoj de la <tld lit="S"/>oj</ctl>
        <fnt>
          <aut>L. Standing Bear, trad. W. R. Harmon</aut>,
          <vrk>Historietoj de la Siuoj</vrk>,
          <lok>1999</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_s;&c_ib;&c_w;</trd>
  <trd lng="ca">sioux</trd>
  <trd lng="cs">Sioux</trd>
  <trd lng="en">Sioux <klr>(person)</klr></trd>
  <trd lng="fr">Sioux<klr> (subst.)</klr></trd>
  <trd lng="ja">&#12473;&#12540;&#26063;  <pr>&#12473;&#12540;&#12382;&#12367;</pr></trd>
  <trd lng="pl">Siuks</trd>
  <trd lng="pt">sioux</trd>
  <trd lng="sk">Siux</trd>
  <trd lng="uk">&c_s;&c_ib;&c_u; (&c_ch;&c_l;&c_je;&c_n; &c_ib;&c_n;&c_d;&c_ib;&c_a;&c_n;&c_s;&c_mol;&c_k;&c_o;&c_g;&c_o;
  &c_p;&c_l;&c_je;&c_m;&c_je;&c_n;&c_ib;)</trd>
</drv>

<drv mrk="siu.0a">
  <kap><tld/>a</kap>
  <snc mrk="siu.0a.ETN">
    <dif>
      Rilata al la <tld/>oj:
      <ekz>
        la intertraktatoj <klr>...</klr> estis &leftquot;perfiditaj
        multajn fojojn cele &scirc;teli nian kulturon, grundon kaj
        kutimojn&rightquot;,
        aldonis la respondeculoj de la <tld/>a komunumo
        <fnt>
          <aut>R. Platteau</aut>,
          <vrk>Lakotaj indianoj rompis la interkonsentojn...</vrk>,
          <lok><url ref="http://raporto.info">
          Raporto.info</url>, 2007-12-23</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_s;&c_ib;&c_w;&c_a;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">sioux</trd>
  <trd lng="en">Sioux</trd>
  <trd lng="fr">sioux<klr> (adj.)</klr></trd>
  <trd lng="pl">Siuks&oacute;w<klr> (przym.)</klr></trd>
  <trd lng="pt">sioux</trd>
</drv>
</art>

