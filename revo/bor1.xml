<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bor1.xml,v 1.37 2026/08/02 15:15:24 revo Exp $">
<kap>
<rad>bor</rad>/o
<fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="bor1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <mlg kod="IUPAC">B</mlg>
  <snc mrk="bor1.0o.elemento">
    <dif>
      &Hcirc;emia <ref tip="lst" cel="elemen.0o.KEM" lst="voko:&hcirc;emiaj_elementoj" val="5">elemento</ref>
      kun
      atomnumero 5, atompezo 10,811:
      <ekz>
        eluzitaj uraniaj stangoj ne plu estas sub malvarmiganta akvo kun aldono de
        <tld/>o kiel &scirc;irmilo
        <fnt>
          <bib>Monato</bib>
          <aut>Pejno Simono</aut>
          <vrk><url ref="&Monato;/2011/010370.php"
              >Moderna minaco: radioaktiveco</url></vrk>
          <lok>2011</lok>
        </fnt>.
      </ekz>
     </dif>
     <ref tip="super" cel="metalo.0o">metaloido</ref>
  </snc>
  <ref tip="hom" cel="bor.0i">bori</ref>
  <trd lng="be">&c_b;&c_o;&c_r;</trd>
  <trd lng="bg">&c_b;&c_o;&c_r;</trd>
  <trd lng="br">bor</trd>
  <trd lng="ca">bor</trd>
  <trd lng="cs">b&oacute;r</trd>
  <trd lng="de">Bor</trd>
  <trd lng="en">boron</trd>
  <trd lng="es">boro</trd>
  <trdgrp lng="fa">
    <trd>&a_b;&a_w;&a_r;&a_w;&a_n;</trd>,
    <trd>&a_b;&a_damma_w;&a_r;</trd>,
    <trd>&a_b;&a_damma;&a_r;</trd>
  </trdgrp>
  <trd lng="fr">bore</trd>
  <trd lng="he">&bet;&#x5BC;&vav;&#x5B9;&resh;</trd>
  <trd lng="hu">b&oacute;r</trd>
  <trd lng="id">boron</trd>
  <trd lng="it">boro</trd>
  <trd lng="ja">&#x30DB;&#x30A6;&#x7D20;  <pr>&#x30DB;&#x30A6;&#x305D;</pr></trd>
  <trd lng="la">Borum</trd>
  <trdgrp lng="nl">
    <trd>boor<klr tip="ind"> (borium)</klr></trd>,
    <trd>borium</trd>
  </trdgrp>
  <trd lng="pl">bor</trd>
  <trd lng="pt">boro</trd>
  <trd lng="ru">&c_b;&c_o;&c_r;</trd>
  <trd lng="sk">b&oacute;r</trd>
  <trd lng="sv">bor</trd>
</drv>

    <drv mrk="bor1.0a">
      <kap><tld/>a</kap>
      <uzo tip="fak">KEM</uzo>
      <snc>
        <dif>
          Rilata al <tld/>o:
          <ekz>
            <tld/>a acido kaj aliaj adstringanta&jcirc;oj
	    <fnt>
	      <vrk>Kronika katara konjunktivito</vrk>. <bib>FK</bib>
	    </fnt>.
          </ekz>
        </dif>
      </snc>
  <trd lng="be">&c_b;&c_o;&c_r;&c_n;&c_y;</trd>
  <trdgrp lng="cs">
    <trd>vrtac&iacute;</trd>,
    <trd>vrtn&yacute;</trd>
  </trdgrp>
  <trd lng="en">boric</trd>
  <trd lng="pl">borowy</trd>
  <trd lng="ru">&c_b;&c_o;&c_r;&c_n;&c_y;&c_j;</trd>
  <trdgrp lng="sk">
    <trd>vrtn&yacute;</trd>,
    <trd>v&racute;tac&iacute;</trd>
  </trdgrp>
</drv>
</art>
