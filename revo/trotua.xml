<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: trotua.xml,v 1.33 2026/09/07 17:54:36 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>trotuar</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="trotua.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="trotua.0o.TRA">
    <uzo tip="fak">TRA</uzo>
    <dif>
      Irejo, ordinare tegita per &scirc;tonplatoj a&ubreve; asfalto,
      rezervata por piedirantoj flanke de la surveturebla
      parto de <ref tip="malprt" cel="strat.0o">strato</ref>:
      <ekz>
        la <tld/>o estis plena de dense amasi&gcirc;intaj homoj
        <fnt>
          <bib>Fab2</bib>
          <lok>Malnova strata lanterno</lok>
        </fnt>;
      </ekz>
      <ekz>
        veturilo atendis min &ccirc;e-<tld/>e
        <fnt>
          <bib>CKv</bib>
          <lok>5</lok>
        </fnt>;
      </ekz>
      <ekz>
        nur piedirantoj rajtas preteriri sur la kontra&ubreve;a
        <tld/>o
        <fnt><aut>W. Klag</aut>, <vrk>Bariloj kontra&ubreve;
        bomboj</vrk>, <bib>Monato</bib>, <lok>jaro 1999a, numero 3a, p.
        7a</lok></fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_t;&c_r;&c_a;&c_t;&c_u;&c_a;&c_r;</trd>
    <trdgrp lng="de">
      <trd>B&uuml;rgersteig</trd>,
      <trd>Gehweg</trd>,
      <trd>Trottoir</trd>,
      <trd>Fu&szlig;weg <klr>(B&uuml;rgersteig)</klr></trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd>pavement</trd>,
      <trd>sidewalk</trd>
    </trdgrp>
    <trd lng="es">acera</trd>
    <trd lng="fr">trottoir</trd>
    <trd lng="hu">j&aacute;rda</trd>
    <trdgrp lng="id">
      <trd>trotoar</trd>,
      <trd>jalur pedestrian</trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>stoep</trd>,
      <trd>trottoir</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>trotuar<klr> (przest.)</klr></trd>,
      <trd>chodnik</trd>
    </trdgrp>
    <trdgrp lng="pt">
      <trd>passeio</trd>,
      <trd>cal&ccedil;ada</trd>
    </trdgrp>
    <trd lng="ru">&c_t;&c_r;&c_o;&c_t;&c_u;&c_a;&c_r;</trd>
    <trd lng="sv">trottoar</trd>
    <trdgrp lng="zh">
      <trd>&#x8D70;&#x9053; <pr>z&#x1D2;ud&agrave;o</pr></trd>,
      <trd>&#x4EBA;&#x884C;&#x9053; <pr>r&eacute;nx&iacute;ngd&agrave;o</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="trotua.0o.FER">
    <uzo tip="fak">FER</uzo>
    <dif>
      <ref tip="dif" cel="kaj1.0o.FER">Kajo<sncref/></ref>:
      <ekz>
        la vagonaro pasis kvaza&ubreve;fulme anta&ubreve; senhoma <tld/>o
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Unua</lok>
        </fnt>;
      </ekz>
      <ekz>
        la vagonaro el Havro ekalvenis, kaj ver&scirc;is sur la <tld/>on sian enhavon da
        voja&gcirc;antoj
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Deksepa</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_p;&c_e;&c_r;&c_o;&c_n;</trd>
    <trd lng="fr">quai<klr> (de gare)</klr></trd>
    <trd lng="hu">peron</trd>
    <trd lng="id">peron</trd>
    <trd lng="nl">perron</trd>
    <trd lng="pl">peron</trd>
    <trd lng="pt">plataforma</trd>
    <trd lng="ru">&c_p;&c_je;&c_r;&c_r;&c_o;&c_n;</trd>
    <trd lng="zh">&#x7AD9;&#x53F0; <pr>zh&agrave;nt&aacute;i</pr></trd>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>pa&scirc;vojo</ke>, <ke>pa&scirc;ejo</ke>,
    <ke>homvojo</ke> , <ke>porhoma vojo</ke>.
  </rim>

  <trdgrp lng="cs">
    <trd>chodn&iacute;k</trd>,
    <trd>troto&aacute;r</trd>
  </trdgrp>
  <trd lng="ja">&#x6B69;&#x9053;  <pr>&#x307B;&#x3069;&#x3046;</pr></trd>
  <trd lng="sk">chodn&iacute;k <klr>(na ulici)</klr></trd>
  <trd lng="uk">&c_t;&c_r;&c_o;&c_t;&c_u;&c_a;&c_r;</trd>
</drv>

<drv mrk="trotua.0a">
  <kap>
    <tld/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        <tld/>a kafejo
        <fnt>
          <bib>ChR</bib>
          <lok>Spiona rondo</lok>
        </fnt>;
      </ekz>
      <ekz>
        virinoj ka&ubreve;ris la&ubreve; la <tld/>a rando por pretigi legomojn
        <fnt>
          <bib>MJA</bib>
          <lok>Parto Kvara</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Fu&szlig;weg-</trd>
</drv>

<drv mrk="trotua.rul0o">
  <kap>rul<tld/>o, <var><kap>mov<tld/>o</kap></var></kap>
  <snc mrk="trotua.rul0o.TRA">
    <uzo tip="fak">TRA</uzo>
    <dif>
      Ruli&gcirc;anta striego por portado de homoj,
      eventuale de objektoj:
      <ekz>
        rul<tld/>ojn oni trovas precipe en flughavenoj a&ubreve; grandaj
        fervojaj a&ubreve; metroaj stacioj
        <fnt>
          <vrk><url ref="&Viki;/Rultrotuaro">
          Rultrotuaro</url></vrk>,
          <bib>Viki</bib>,
          <lok>2009-12-12</lok>
        </fnt>.
      </ekz>
      <ekz>
        kiam mi estis infano, simpluloj ne kredis, ke iam ekzistos
        mov<tld/>oj
        <fnt><aut>B. Vaha</aut>, <vrk>Adolesko</vrk>,
        <lok>1987</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_t;&c_r;&c_a;&c_v;&c_a;&c_l;&c_ja;&c_t;&c_a;&c_r;</trd>
  <trdgrp lng="de">
    <trd>Laufband <klr>(Fahrsteig)</klr></trd>,
    <trd>Fahrsteig</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>pasillo rodante</trd>,
    <trd>camino rodante</trd>,
    <trd>cinta desplazadora</trd>,
    <trd>pasillo mec&aacute;nico</trd>,
    <trd>cinta transportadora</trd>
  </trdgrp>
  <trd lng="fr">tapis roulant</trd>
  <trdgrp lng="id">
    <trd>travelator</trd>,
    <trd>marga laju</trd>,
    <trd>ban berjalan</trd>
  </trdgrp>
  <trd lng="pl">ruchomy <ind>chodnik</ind></trd>
</drv>
</art>
