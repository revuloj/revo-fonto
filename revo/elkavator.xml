<kap>
    <rad>elkavator</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="elkavator.0o">
  <kap><tld/>o</kap>
  <snc mrk="elkavator.0o.MAS">
    <uzo tip="fak">MAS</uzo>
    <dif>
      Ma&scirc;ino, ofte memmova, por fosi, kavigi la grundon:
      <ekz>
        en aliaj eksaj laboristaj kvartaloj, arganoj kaj <tld/>oj aktivas
        <fnt>
          <aut>B. Br&eacute;ville, trad. M. Leon</aut>
          <vrk><url ref="https://eo.mondediplo.com/2017/11/article2584">
          Grandaj urboj kaj bonaj intencoj</url></vrk>
          <lok>Le Monde diplomatique, 2017-11</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi ellernis kiel &scirc;ofori <tld/>on kun 400 tunoj!!!
        <fnt>
          <aut>Shanshan</aut>
          <vrk><url ref="https://tubaro.aperu.net/v/ytb_Vo9OFpszYeQ/">
          Kiel veturi 400-tunan elkavatoron?</url></vrk>
          <lok>youtube, 2022-06-04</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="fr">
    <trd>excavatrice</trd>,
    <trd>machine d'excavation</trd>
  </trdgrp>
</drv>
