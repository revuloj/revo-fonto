<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: inspek1.xml,v 1.24 2026/10/17 12:00:19 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>inspektor</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="inspek1.0o">
  <kap><tld/>o</kap>
  <snc mrk="inspek1.0o.inspektisto">
    <dif>
      <ref tip="dif" cel="inspek.0anto">Inspektisto</ref>:
      <ekz>
        vi, kiel <tld/>o de lernejoj, devus ekzorgi precipe 
        rilate la instruistojn
        <fnt><bib>Revizoro</bib><lok>1:1</lok></fnt>;
      </ekz>
      <ekz>
        anka&ubreve; <tld/>o <nom>Dutri</nom>, la konfidenca asistanto de <nom>Kant</nom>, 
        sciis ankora&ubreve; nenion pri tio
        <fnt><bib>UrdHadda</bib><lok>p. 24</lok></fnt>;
      </ekz>
      <ekz>
        &ccirc;ef<tld/>o Ksavero <nom>Kant</nom> aspektis kiel korpulenta kamparano 
        en diman&ccirc;a tago
        <fnt><bib>UrdHadda</bib><lok>p. 3</lok></fnt>;
      </ekz>
      <ekz>
        &scirc;i estis preferinta la liberon ol edzini al 
        &ccirc;iamde&jcirc;oranta polic-<tld/>o
        <fnt><bib>UrdHadda</bib><lok>p. 4</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_e;&c_k;&c_t;&c_a;&c_r;</trd>,
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;&c_a;&c_l;&c_mol;&c_n;&c_ib;&c_k;</trd>
  </trdgrp>
  <trd lng="ca">inspector</trd>
  <trdgrp lng="cs">
    <trd>dozorce</trd>,
    <trd>inspektor</trd>,
    <trd>inspicient</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Inspektor</trd>,
    <trd>Pr&uuml;fer</trd>,
    <trd>&Uuml;berwacher</trd>,
    <trd>Beschauer</trd>,
    <trd>Kontrolleur</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>inspector</trd>,
    <trd>overseer</trd>
  </trdgrp>
  <trd lng="es">inspector</trd>
  <trdgrp lng="fr">
    <trd>inspecteur</trd>,
    <trd>contr&ocirc;leur</trd>,
    <trd>superviseur</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>fel&uuml;gyel&odblac;</trd>,
    <trd>inspektor</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#26619;&#23519;&#23448;  <pr>&#12373;&#12373;&#12388;&#12363;&#12435;</pr></trd>,
    <trd>&#33310;&#21488;&#30435;&#30563;  <pr>&#12406;&#12383;&#12356;&#12363;&#12435;&#12392;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="nl">inspecteur</trd>
  <trd lng="pl">inspektor</trd>
  <trd lng="pt">inspetor</trd>
  <trdgrp lng="ru">
    <trd>&c_i;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_o;&c_r;</trd>,
    <trd>&c_n;&c_a;&c_d;&c_z;&c_i;&c_r;&c_a;&c_t;&c_je;&c_l;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>dozorca</trd>,
    <trd>in&scaron;pektor</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_Ib;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_o;&c_r;</trd>,
    <trd>&c_p;&c_o;&c_m;&c_ib;&c_ch;&c_n;&c_i;&c_k; &c_r;&c_je;&c_zh;&c_i;&c_s;&c_je;&c_r;&c_a;</trd>,
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_o;&c_r; &c_s;&c_c;&c_je;&c_n;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#30563;&#23519; <pr>d&#363;ch&aacute;</pr></trd>,
    <trd>&#26816;&#26597;&#21592; <pr>ji&#462;nch&aacute;yu&aacute;n</pr></trd>,
    <trd>&#30417;&#30563;&#21592; <pr>ji&#257;nd&#363;yu&aacute;n</pr></trd>,
    <trd>&#31293;&#26597;&#20154;&#21592; <pr>j&#299;ch&aacute;r&eacute;nyu&aacute;n</pr></trd>,
    <trd>&#31293;&#26597;&#21592; <pr>j&#299;ch&aacute;yu&aacute;n</pr></trd>
  </trdgrp>
</drv>
</art>
