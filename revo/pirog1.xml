<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: pirog1.xml,v 1.11 2026/08/31 20:00:21 afido Exp $">
    <kap>
      <rad>pirog</rad>/o
    </kap>

<drv mrk="pirog1.0o">
  <kap><tld/>o</kap>
  <snc mrk="pirog1.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      <ref tip="super" cel="farcx.0o">Far&ccirc;o</ref> el viando, fi&scirc;o, legomoj a&ubreve; fruktoj, bakita en
      pasta
      tega&jcirc;o:
      <ekz>
        <tld/>o kun fungoj, brasiko, vakcinio, fi&scirc;o, marmelado;
      </ekz><ekz>
        poma <tld/>o;
      </ekz><ekz>
        la kuiristino surtabligas botelon, tri glasetojn kaj
        <tld/>on
        <fnt>
          <aut>A. &Ccirc;e&hcirc;ov, tr. A. Parfentjev</aut>:
          <vrk><url ref="&LOdE;Rn-che05.htm">Gri&ccirc;jo</url></vrk>.
          <lok>&Ccirc;eriza &gcirc;ardeno, Kaliningrado: Sezonoj, 2004</lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      <fnt><bib>PIV2</bib></fnt> ial misdifinas <tld/>on kiel <em>rusan</em> paste&ccirc;on;
      tamen praktike &gcirc;i estas uzata por diverslandaj <tld/>oj
      (polaj, suomaj, kanadaj...):
      <ekz>
        en la <tld/>vendejo <nom>&Hcirc;osravi</nom> oni faris tion sed mi memoras
        ke <tld/>oj de niaj armenaj amikoj estis diable bongustaj,
        do ankora&ubreve; multaj islamanoj kaj anka&ubreve; neislamanoj el
        foraj anguloj de Tehrano venis kaj a&ccirc;etis ilin
        <fnt>
          <vrk><url ref="http://becxjo.blogspot.com/2005_09_01_archive.html">Mia sopiro pri
          man&gcirc;a&jcirc;o</url></vrk>
        </fnt>.
      </ekz>
      La konfuzeblo kun la pli internacia vorto <ref tip="hom" cel="pirog.0o.boato">pirogo</ref>
      por boato estas beda&ubreve;rinda; tamen konfuzo kian prezentas <ctl>paste&ccirc;o</ctl>
      estas multe pli &gcirc;ena, &ccirc;ar &gcirc;iaj du sencoj amba&ubreve; rilatas al
      man&gcirc;oj kaj la probablo kaj &gcirc;eno de eventuala konfuzo estas
      pli granda.
      <aut>Sergio Pokrovskij</aut>
    </rim>
    <trd lng="be">&c_p;&c_ib;&c_r;&c_o;&c_g;</trd>
    <trd lng="de">Pirogge</trd>
    <trdgrp lng="en">
      <trd>dumpling</trd>,
      <trd>pie</trd>,
      <trd>pierogi</trd>
    </trdgrp>
    <trd lng="nl">deegkussentje</trd>
    <trd lng="pl">pierog</trd>
    <trd lng="ru">&c_p;&c_i;&c_r;&c_o;&c_g;</trd>
    <trdgrp lng="zh">
    <trd>&#33457;&#39171; <pr>hu&amacron;ji&#462;o</pr></trd>,
    <trd>&#33457;&#39290; <pr>hu&amacron;ji&#462;o</pr></trd>,
    <trd>&#39171;&#23376; <pr>ji&#462;ozi</pr></trd>,
    <trd>&#39290;&#23376; <pr>ji&#462;ozi</pr></trd>,
    <trd>&#39171;&#39180; <pr>ji&#462;o&ecaron;r</pr></trd>,
    <trd>&#39290;&#39285; <pr>ji&#462;o&ecaron;r</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="ca">
    <trd>coca farcida<klr tip="amb"> (dol&ccedil;a o salada)</klr></trd>,
    <trd>panada</trd>,
    <trd>empanada<klr tip="amb"> (de carn, de peix, de verdura)</klr></trd>
  </trdgrp>
  <trd lng="id">pierogi</trd>
  <trd lng="ja">&#20024;&#26408;&#33311;  <pr>&#12414;&#12427;&#12365;&#12406;&#12397;</pr></trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_ib;&c_r;&c_o;&c_gu;&c_a;</trd>,
    <trd>&c_p;&c_i;&c_r;&c_ib;&c_g;</trd>,
    <trd>&c_v;&c_a;&c_r;&c_je;&c_n;&c_i;&c_k;</trd>
  </trdgrp>
</drv>

