<drv mrk="bonsaj.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">HOR</uzo>
  <snc mrk="bonsaj.0o.arbo">
    <dif>
      <ref tip="super" cel="arb.0o.BOT">Arbo</ref> kulturita en ujo kiel
      malgranda <ref tip="super" cel="model.0o.imitajxo">modelo</ref> de natura arbo:
      <ekz>
        oni dorlotas la bonsajon per &ccirc;iutaga &scirc;prucado, ta&ubreve;ga sterko, kontrolo de la
        temperaturo kaj lumo en la &ccirc;ambro
        <fnt>
          <bib>Monato</bib>
          <aut>Saliko</aut>
          <vrk><url ref="&Monato;/2007/009228.php">Kultivi bonsajon</url></vrk>
          <lok>2007</lok>
        </fnt>;
      </ekz>
      <ekz>
        eblas viziti Zen-&gcirc;ardenon a&ubreve; &ccirc;eesti kurseton pri <tld/>o-arbetoj
        <fnt>
          <bib>Monato</bib>
          <aut>Garvan Makaj</aut>
          <vrk><url ref="&Monato;/2010/010132.php">Monda kulturo apud la
          maro</url></vrk>
          <lok>2010</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
    lok="&WCU;/thumb/2/22/Japanese_Black_Pine%2C_1936-2007.jpg/500px-Japanese_Black_Pine%2C_1936-2007.jpg"
    prm="CC BY-SA 4.0"><tld/>o de Nigra pino
        <fnt>
          <aut>Ragesoss, propra verko</aut>
          <lok><url
          ref="&WCW;/File:Japanese_Black_Pine,_1936-2007.jpg">&WCW;/File:Japanese_Black_Pine,_1936-2007.jpg</url></lok>
        </fnt>
    </bld>
    <trdgrp lng="zh">
    <trd>&#30406;&#26223; <pr>p&eacute;nj&#464;ng</pr></trd>,
    <trd>&#30406;&#26223;&#26641; <pr>p&eacute;nj&#464;ngsh&ugrave;</pr></trd>
  </trdgrp>
</snc>
  <trd lng="be">&c_b;&c_a;&c_n;&c_s;&c_a;&c_j;</trd>
  <trdgrp lng="ca">
    <trd>bonsai</trd>,
    <trd>bonzai</trd>
  </trdgrp>
  <trd lng="cv">&c_b;&c_o;&c_n;&c_s;&c_a;&c_j;</trd>
  <trd lng="de">Bonsai</trd>
  <trd lng="en">Bonsai</trd>
  <trd lng="es">bons&aacute;i</trd>
  <trd lng="fr">Bonsa&iuml;</trd>
  <trd lng="oc">bonsai</trd>
  <trd lng="pl">bonsai drzewko</trd>
  <trd lng="uk">&c_k;&c_a;&c_r;&c_l;&c_i;&c_k;&c_o;&c_v;&c_je;
  &c_d;&c_je;&c_r;&c_je;&c_v;&c_o;/&c_d;&c_je;&c_r;&c_je;&c_v;&c_c;&c_je;</trd>
</drv>
