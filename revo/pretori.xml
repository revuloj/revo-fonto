  <kap>
    <rad>Pretori</rad>/o
  </kap>

<drv mrk="pretori.0o">
  <kap><tld/>o</kap>
  <snc mrk="pretori.0o.cxefurbo">
  <uzo tip="fak">GEOG</uzo>
  <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&Ccirc;efurbo</ref> de
      <ref tip="malprt" cel="afrik.SudA0o">Sud-Afriko</ref>: situo:  (<frm>25&#730;45&minute; S 
      28&#730;11&minute; E</frm>):
      <ekz>
        nuntempe, la esperantistoj de la urboj Johanesburgo kaj
        <tld/>o <klr>[&#8230;]</klr> &ccirc;iuj esperantumas kune
        <fnt>
          <vrk><url ref="http://www.esperanto.org.za/johannesburg-kaj-pretoria1.html">Johannesburg
          kaj Pretoria - esperanto-asocio de
              suda afriko</url></vrk>
     </fnt>;
   </ekz><ekz>
        mi atendis, ke iu flanke de la advokato de <nom>Dada
        Abdullah</nom> venos akcepti min en la stacidomo en
        <tld/>o
        <fnt><vrk><url
        ref="http://www.oocities.org/athens/acropolis/1864/gandhi/eksperimentoj/dua/unua_tago_en_pretorio.htm">La
        A&ubreve;tobiografio de Gandhi: La unua tago en
              Pretorio</url></vrk></fnt>.
     </ekz>
   </dif>
  </snc>
  <ref tip="hom" cel="pretori2.0o">pretorio (ju&gcirc;ejo&#8230;)</ref>
  <trd lng="be">&c_P;&c_r;&c_e;&c_t;&c_o;&c_r;&c_y;&c_ja;</trd>
