  <trd lng="ro">Pretoria</trd>
  <trd lng="ru">&c_P;&c_r;&c_je;&c_t;&c_o;&c_r;&c_i;&c_ja;</trd>
  <trd lng="uk">&c_P;&c_r;&c_je;&c_t;&c_o;&c_r;&c_ib;&c_ja; (&c_s;&c_t;&c_o;&c_l;&c_i;&c_c;&c_ja;)</trd>
