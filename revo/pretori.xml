    <trd>&#26222;&#21033;&#25176;&#37324;&#20122; <pr>P&#468;l&igrave;tu&#333;l&#464;y&agrave;</pr></trd>,
    <trd>&#26222;&#21033;&#25176;&#37324;&#20126; <pr>P&#468;l&igrave;tu&#333;l&#464;y&agrave;</pr></trd>
