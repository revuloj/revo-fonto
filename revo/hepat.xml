<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: hepat.xml,v 1.33 2026/09/07 05:10:42 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>hepat</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="hepat.0o">
  <kap>
    <ofc>*</ofc><tld/>o
  </kap>
  <uzo tip="fak">ANA</uzo>
  <snc mrk="hepat.0o.ANA">
    <dif>
      Granda glando, kiu produktas galon, gravajn proteinojn
      kaj inter&scirc;an&gcirc;as metabolajn substancojn kun la sango:
      <ekz>
        malsana je la <tld/>o
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro I</lok>
        </fnt>;
      </ekz>
      <ekz>
        plej multa kolesterolo, kiu cirkulas en nia sango, estas produktita de la hepato
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2013/011124.php"
              >Atentu la koron</url></vrk>
          <lok>2013</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> preska&ubreve; neniigis sian <tld/>on pro drinkado kaj dibo&ccirc;ado,
        <fnt>
          <bib>Monato</bib>
          <aut>Ivo Durwael</aut>
          <vrk><url ref="&Monato;/2012/010566.php"
              >Pri kulpo de kulpigisto</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        mia <tld/>o trograsi&gcirc;is
        <fnt>
          <bib>LOdE</bib>
          <lok>2002, &#x2116; 10</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_p;&c_ja;&c_ch;&c_o;&c_n;&c_k;&c_a;</trd>,
    <trd>&c_p;&c_je;&c_ch;&c_a;&c_n;&c_mol;</trd>
  </trdgrp>
  <trd lng="bg">&c_ch;&c_je;&c_r;&c_je;&c_n; &c_d;&c_r;&c_o;&c_b;</trd>
  <trd lng="bo">&t_ma;&t_cha;&t_gigu;&t_na;&t_tsheg;&t_pa;&t_tsheg;</trd>
  <trd lng="br">avu</trd>
  <trd lng="ca">fetge</trd>
  <trd lng="de">Leber <klr>(Organ)</klr></trd>
  <trdgrp lng="el">
    <trd>&eta_ton;&pi;&alfa;&rho;</trd>,
    <trd>&sigma;&ypsilon;&kappa;&omega_ton;&tau;&jota;</trd>
  </trdgrp>
  <trd lng="en">liver</trd>
  <trd lng="es">h&iacute;gado</trd>
  <trd lng="fr">foie<klr tip="ind"> (organe)</klr></trd>
  <trd lng="hu">m&aacute;j</trd>
  <trdgrp lng="id">
    <trd>hati</trd>,
    <trd>lever</trd>
  </trdgrp>
  <trd lng="io">hepato</trd>
  <trd lng="it">fegato<klr> (anat.)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#x809D;&#x81D3;  <pr>&#x304B;&#x3093;&#x305E;&#x3046;</pr></trd>,
    <trd>&#x809D; <pr>&#x304D;&#x3082;</pr></trd>
  </trdgrp>
  <trd lng="nl">lever</trd>
  <trd lng="pl">w&aogonek;troba</trd>
  <trd lng="pt">f&iacute;gado</trd>
  <trd lng="ro">ficat</trd>
  <trd lng="ru">&c_p;&c_je;&c_ch;&c_je;&c_n;&c_mol;</trd>
  <trd lng="tr">ci&gbreve;er</trd>
  <trd lng="uk">&c_p;&c_je;&c_ch;&c_ib;&c_n;&c_k;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#x809D; <pr>g&amacron;n</pr></trd>,
    <trd>&#x809D;&#x810F; <pr>g&amacron;nz&agrave;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="hepat.0ajxo">
  <kap>
    <tld/>a&jcirc;o
  </kap>
  <uzo tip="fak">KUI</uzo>
  <snc mrk="hepat.0ajxo.KUI">
    <dif>
      <tld lit="H"/>o de iuj bestoj uzata kiel nutra&jcirc;o:
      <ekz>
        <tld/>a&jcirc;o de bovido;
      </ekz>
      <ekz>
        telero kun <tld/>a&jcirc;o
        <fnt>
          <bib>OIP</bib>
          <lok>Ombro sur interna pejza&gcirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[&scirc;i]</klr> mendas &ccirc;iujn plej multekostajn man&gcirc;a&jcirc;ojn: kaviaron, palinuron,
        ala&ubreve;dan <tld/>a&jcirc;on
        <fnt>
          <bib>KrB</bib>
          <lok>Estro ne malsatas</lok>
        </fnt>;
      </ekz>
      <ekz>
        <ind>gras<tld/>a&jcirc;o</ind>
        <klr>(<tld/>o de ansero a&ubreve; anaso, tre grasigita per speciala
        nutra&jcirc;o kaj plena senmoveco)</klr>;
        <trd lng="ca">foie-gras</trd>
        <trdgrp lng="de">
          <trd>Stopfleber</trd>,
          <trd>Foie gras</trd>
        </trdgrp>
        <trd lng="en">foie gras</trd>
        <trd lng="fr">foie gras</trd>
        <trd lng="hu">libam&aacute;j</trd>
        <trd lng="ja">&#x30D5;&#x30A9;&#x30A2;&#x30B0;&#x30E9;</trd>
        <trd lng="nl">foie gras</trd>
      </ekz>
      <ekz>
        <ind>paste&ccirc;o de gras<tld/>a&jcirc;o</ind>.
        <trd lng="de">Leberpastete</trd>
        <trd lng="fr">p&acirc;t&eacute; de foie gras</trd>
        <trd lng="hu">libam&aacute;jp&aacute;st&eacute;tom</trd>
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_p;&c_ja;&c_ch;&c_o;&c_n;&c_k;&c_a;
    <klr>(&c_p;&c_r;&c_y;&c_g;&c_a;&c_t;&c_a;&c_v;&c_a;&c_n;&c_a;&c_ja;, &c_k;&c_a;&c_b;
    &c_je;&c_s;&c_mol;&c_c;&c_ib;)</klr></trd>,
    <trd>&c_p;&c_je;&c_ch;&c_a;&c_n;&c_mol;
    <klr>(&c_p;&c_r;&c_y;&c_g;&c_a;&c_t;&c_a;&c_v;&c_a;&c_n;&c_a;&c_ja;, &c_k;&c_a;&c_b;
    &c_je;&c_s;&c_mol;&c_c;&c_ib;)</klr></trd>
  </trdgrp>
  <trd lng="br">avu<klr tip="ind"> (boued)</klr></trd>
  <trd lng="ca">fetge<klr tip="amb"> (gastr.)</klr></trd>
  <trd lng="de">Leber <klr>(Speise)</klr></trd>
  <trd lng="el">&sigma;&ypsilon;&kappa;&omega_ton;&tau;&jota;</trd>
  <trd lng="en">liver<klr tip="ind"> (as food)</klr></trd>
  <trd lng="es">h&iacute;gado</trd>
  <trd lng="fr">foie<klr tip="ind"> (comme aliment)</klr></trd>
  <trd lng="hu">m&aacute;j<klr tip="ind"> (&eacute;tel)</klr></trd>
  <trd lng="it">fegato<klr> (cuc.)</klr></trd>
  <trd lng="ja">&#x30EC;&#x30D0;&#x30FC;</trd>
  <trd lng="nl">lever<klr tip="ind"> (gerecht)</klr></trd>
  <trd lng="pl">w&aogonek;tr&oacute;bka</trd>
  <trd lng="pt">f&iacute;gado<klr tip="amb"> (como alimento;
  prato)</klr></trd>
  <trd lng="ru">&c_p;&c_je;&c_ch;&c_jo;&c_n;&c_k;&c_a;</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_je;&c_ch;&c_ib;&c_n;&c_k;&c_a;</trd>,
    <trd>&c_s;&c_t;&c_r;&c_a;&c_v;&c_a; &c_z; &c_p;&c_je;&c_ch;&c_ib;&c_n;&c_k;&c_i;</trd>
  </trdgrp>
</drv>
</art>
