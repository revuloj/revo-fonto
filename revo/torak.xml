<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: torak.xml,v 1.28 2026/10/05 14:28:40 revo Exp $">
<kap>
  <rad>torak</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="torak.0o">
  <kap><tld/>o</kap>
  <snc mrk="torak.0o.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Parto de la <ref tip="malprt" cel="korp.0o.ANA">korpo</ref>
      de <ref tip="vid" cel="verteb.0uloj">vertebruloj</ref> inter
      la <ref tip="vid" cel="kol.0o.korpo">kolo</ref>
      kaj la <ref tip="vid" cel="abdome.0o">abdomeno</ref>,
      entenanta la <ref tip="vid" cel="kor.0o.ANA">koron</ref>,
      <ref tip="vid" cel="pulm.0o">pulmojn</ref>, trakeon k ezofagon:
      <ekz>
        korpo, nuda, en koaguli&gcirc;inta sango, kun forpremita brako kaj frakasita <tld/>o
        <fnt>
          <bib>MkM</bib>
          <lok>5</lok>
        </fnt>;
      </ekz>
      <ekz>
        la dimensioj de la klingo &ndash; ties lar&gcirc;eco, pinteco, plateco &ndash; respondas ekzakte
        al la tre neta vundo, kiun la murdoarmilo faris penetrante la <tld/>on
        <fnt>
          <bib>CKv</bib>
          <lok>23</lok>
        </fnt>;
      </ekz>
      <ekz>
        por la malsano estas tipaj multenombraj ru&gcirc;aj makuloj kaj nodetoj sur la ha&ubreve;to
        de viza&gcirc;o, kapo, kolo kaj <tld/>o, kiuj balda&ubreve; ulceri&gcirc;as
        <fnt>
          <bib>Monato</bib>
          <aut>Vladimir Lemelev</aut>
          <vrk><url ref="&Monato;/2007/008991.php"
              >La &ccirc;efaj murdistoj de HIV-infektitoj</url></vrk>
          <lok>2007</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="tors.0o.ANA">torso</ref>
    <trd lng="be">&c_g;&c_r;&c_u;&c_d;&c_n;&c_a;&c_ja;
      &c_k;&c_l;&c_je;&c_t;&c_k;&c_a;</trd>
    <trdgrp lng="de">
      <trd>Thorax</trd>,
      <trd>Brustkorb</trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd>thorax</trd>,
      <trd>chest</trd>
    </trdgrp>
    <trd lng="es">t&oacute;rax</trd>
    <trd lng="fr">thorax</trd>
    <trd lng="hu">mellkas</trd>
    <trd lng="it">torace</trd>
    <trd lng="la">thorax</trd>
    <trdgrp lng="nl">
      <trd>thorax</trd>,
      <trd>borstholte</trd>
    </trdgrp>
    <trd lng="pl">klatka piersiowa</trd>
    <trd lng="pt">t&oacute;rax</trd>
    <trd lng="ru">&c_g;&c_r;&c_u;&c_d;&c_n;&c_a;&c_ja;
      &c_k;&c_l;&c_je;&c_t;&c_k;&c_a;</trd>
    <trdgrp lng="zh">
      <trd>&#x80F8; <pr>xi&omacron;ng</pr></trd>,
      <trd>&#x80F8;&#x5ED3; <pr>xi&omacron;ngku&ograve;</pr></trd>,
      <trd>&#x819B; <pr>t&aacute;ng</pr></trd>,
      <trd>&#x80F8;&#x8154; <pr>xi&omacron;ngqi&amacron;ng</pr></trd>,
      <trd>&#x80F8;&#x90E8; <pr>xi&omacron;ngb&ugrave;</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="torak.0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <dif>
      La dua <ref tip="malprt" cel="korp.0o.ANA">korpo</ref>parto
      de <ref tip="vid" cel="insekt.0oj">insektoj</ref>,
      portanta la krurojn kaj la flugilojn.
    </dif>
    <trd lng="be">&c_g;&c_r;&c_u;&c_d;&c_n;&c_y; &c_a;&c_d;&c_d;&c_z;&c_je;&c_l; <klr>(&c_u; &c_k;&c_a;&c_z;&c_ju;&c_r;&c_a;&c_k;)</klr></trd>
    <trd lng="pl">tu&lstroke;&oacute;w</trd>
  </snc>
  <trd lng="ca">t&ograve;rax</trd>
  <trdgrp lng="cs">
    <trd>hrudn&iacute; ko&scaron;</trd>,
    <trd>hrudn&iacute;k</trd>,
    <trd>torax</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x80F8;&#x90ED;  <pr>&#x304D;&#x3087;&#x3046;&#x304B;&#x304F;</pr></trd>,
    <trd>&#x80F8;&#x90E8;  <pr>&#x304D;&#x3087;&#x3046;&#x3076;</pr></trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>hrudn&yacute; k&ocirc;&scaron;</trd>,
    <trd>torax</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_g;&c_r;&c_u;&c_d;&c_n;&c_a; &c_k;&c_l;&c_ib;&c_t;&c_k;&c_a;</trd>,
    <trd>&c_g;&c_r;&c_u;&c_d;&c_n;&c_a; &c_p;&c_o;&c_r;&c_o;&c_zh;&c_n;&c_i;&c_n;&c_a;</trd>
  </trdgrp>
</drv>

<drv mrk="torak.kap0o">
  <kap>kap<tld/>o</kap>
  <snc mrk="torak.kap0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <dif>
      Anta&ubreve;a parto de <ref tip="malprt" cel="korp.0o.ANA">korpo</ref>,
      kuniganta kapon kaj
      <ref tip="vid" cel="torak.0o.ZOO">torakon</ref> kiel tuton,
      &ccirc;e <ref tip="vid" cel="arane.0uloj">araneuloj</ref>,
      <ref tip="vid" cel="krust.0uloj">krustuloj</ref>:
      <ekz>
        sur la kap<tld/>o trovi&gcirc;as plejofte ok okuloj
        <fnt>
          <aut>E. Nieuwenhuys, trad. L. De Cooman</aut>,
          <vrk><url ref="http://www.xs4all.nl/~ednieuw/Spiders/InfoNed/Araneo_korpo.html">
          Araneo</url></vrk>,
          <lok>1999-03</lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>La&ubreve; <fnt><bib>PIV2</bib></fnt> sinonimas &leftquot;cefalo<tld/>o&rightquot;.</rim>
  </snc>
  <trd lng="be">&c_g;&c_a;&c_l;&c_a;&c_v;&c_a;&c_g;&c_r;&c_u;&c_d;&c_z;&c_ib;</trd>
  <trd lng="ca">cefalot&ograve;rax</trd>
  <trdgrp lng="de">
    <trd>Cephalothorax</trd>,
    <trd>Vorderleib</trd>
  </trdgrp>
  <trd lng="en">cephalothorax</trd>
  <trd lng="fr">c&eacute;phalothorax</trd>
  <trdgrp lng="it">
    <trd>cefalotorace</trd>,
    <trd>capotorace<klr> (nei crostacei)</klr></trd>,
    <trd>prosoma<klr> (negli aracnidi)</klr></trd>
  </trdgrp>
  <trd lng="pl">g&lstroke;owotu&lstroke;&oacute;w</trd>
  <trdgrp lng="zh">
    <trd>&#x5934;&#x80F8;&#x90E8; <pr>t&oacute;uxi&omacron;ngb&ugrave;</pr></trd>,
    <trd>&#x982D;&#x80F8;&#x90E8; <pr>t&oacute;uxi&omacron;ngb&ugrave;</pr></trd>
  </trdgrp>
</drv>
</art>
