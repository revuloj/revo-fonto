<art mrk="$Id: alberg.xml,v 1.14 2026/10/02 06:00:20 revo Exp $">
<kap>
  <rad>alberg</rad>/o <fnt><bib>SPIV</bib></fnt>
</kap>
<drv mrk="alberg.0o">
  <kap><tld/>o</kap>
  <uzo tip="stl">POE</uzo>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="alberg.0o.TUR">
    <dif>
      <ref tip="super" cel="gast.0ejo.TUR">Gastejo</ref> senkomforta,
      ofte montara a&ubreve; kampara:
      <ekz>
        du el la amikoj adia&ubreve;is la trian, &ccirc;ar ili ne &ccirc;iuj lo&gcirc;is en la
        sama <tld/>o
        <fnt>
          <aut>J. A. Schneiderfranken, trad. A. Rehfeldt</aut>,
          <vrk><url ref="www.a-rehfeldt.de/LaSekretoEspTNR.pdf">la
          sekreto</url></vrk>,
          <lok>2005</lok>
        </fnt>;
      </ekz>
      <ekz>
        tagman&gcirc;o en la <tld/>o <nom>Brandon</nom>
        <fnt>
          <vrk><url ref="https://www.youtube.com/watch?v=IRa7NALVqSw">Irlande 7:
          Killarney</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="kaban.0o">kabano</ref>
    <trdgrp lng="zh">
    <trd>&#23433;&#25490;&#33203;&#23487; <pr>&amacron;np&aacute;ish&agrave;ns&ugrave;</pr></trd>,
    <trd>&#24208; <pr>l&uacute;</pr></trd>,
    <trd>&#24300; <pr>l&uacute;</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_a;&c_je;&c_z;&c_n;&c_y; <ind>&c_d;&c_v;&c_o;&c_r;</ind></trd>,
    <trd>&c_g;&c_a;&c_t;&c_e;&c_l;&c_mol;
    <klr>(&c_n;&c_je;&c_v;&c_ja;&c_l;&c_ib;&c_k;&c_ib;)</klr></trd>
  </trdgrp>
  <trd lng="bo">&#3928;&#3906;&#4018;&#3964;&#3923;&#3851;&#3905;&#3908;&#3851;</trd>
  <trd lng="ca">alberg</trd>
  <trdgrp lng="de">
    <trd>Herberge</trd>,
    <trd>H&uuml;tte</trd>,
    <trd>Landgasthof</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>auberge</trd>,
    <trd>inn</trd>, <trd>tavern</trd>, <trd>hostel</trd>
  </trdgrp>
  <trd lng="es">albergue</trd>
  <trdgrp lng="fa">
    <trd>&a_m;&a_s;&a_A;&a_f;&a_r;&a_kh;&a_A;&a_n;&a_h;</trd>,
    <trd>&a_m;&a_h;&a_m;&a_A;&a_n;&a_kh;&a_A;&a_n;&a_h;</trd>,
    <trd>&a_m;&a_h;&a_m;&a_A;&a_n;&a_s;&a_r;&a_A;</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>auberge</trd>,
    <trd>taverne</trd>
  </trdgrp>
  <trd lng="hu">vend&eacute;gfogad&oacute;</trd>
  <trd lng="nl">taverne</trd>
  <trd lng="pt">albergue</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_o;&c_s;&c_t;&c_o;&c_ja;&c_l;&c_i;&c_j;/&c_z;&c_a;&c_ji;&c_zh;&c_d;&c_zh;&c_i;&c_j;
    &c_d;&c_v;&c_ib;&c_r;</trd>,
    <trd>&c_z;&c_a;&c_ji;&c_z;&c_d;</trd>
  </trdgrp>
</drv>
</art>

