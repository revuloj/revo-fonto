  <trd lng="en">autobiography</trd>
  <trd lng="es">autobiograf&iacute;a</trd>
  <trd lng="fr">autobiographie</trd>
  <trd
  lng="he">&alef;&vav;&#x5B9;&tet;&vav;&#x5B9;&bet;&#x5BC;&#x5B4;&yod;&vav;&#x5B9;&gimel;&#x5B0;&resh;&#x5B8;&pe;&#x5B4;&yod;&#x5B8;&he;</trd>
  <trd lng="hu">&ouml;n&eacute;letrajz</trd>
