<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: profes1.xml,v 1.26 2026/09/09 16:34:59 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>profesor</rad>/o
<fnt><bib>JED</bib></fnt></kap>

<drv mrk="profes1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">PED</uzo>
  <snc mrk="profes1.0o.PED">
    <dif>
      Altranga <ref tip="super" cel="instru.0isto.PED">instruisto</ref>
      en supera lernejo, pli altranga ol
      <ref cel="docent.0o">docento</ref>; normale, por ricevi la
      pedagogan gradon de <tld/>o oni bezonas havi la sciencistan
      gradon <ref cel="doktor.0o.SCI">doktoro</ref>:
      <ekz>
        <tld/>o de botaniko
        <fnt>
          <bib>Fab1</bib>
          <lok>Floroj de la malgranda Ida</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o <nom>Bucher</nom> el Lejpcigo elkalkulis la rilatan nombron de la viroj kaj virinoj
        en E&ubreve;ropo
        <fnt>
          <bib>FK</bib>
          <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
        </fnt>;
      </ekz>
      <ekz>
        akiri <tld/>econ <klr>(la gradon <tld/>o)</klr>;
      </ekz>
      <ekz>
        <tld/>o de eklezia akademio
        <fnt>
          <bib>Homaranismo</bib>
          <vrk>Pri la homaranismo</vrk>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>oj faris min <tld/>o
        <fnt>
          <bib>Fab2</bib>
          <lok>La ombro</lok>
        </fnt>;
      </ekz>
      <ekz>
        li estas muzika <tld/>o &ccirc;e la konservatorio en la urbo
        <fnt>
          <bib>IdO</bib>
          <lok>Tria Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        universitata <tld/>o pri genetiko
        <fnt><aut>Marteno Ecott</aut>,
          <vrk>Himno al toleremo</vrk>, <bib>Monato</bib>,
          <lok>jaro 1999a, numero 5a, p. 18a</lok></fnt>.
      </ekz>
      <ekz>
        lecionoj al <tld/>o estas vana laboro
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_p;&c_r;&c_a;&c_f;&c_e;&c_s;&c_a;&c_r;</trd>
    <trd lng="bg">&c_p;&c_r;&c_o;&c_f;&c_je;&c_s;&c_o;&c_r;</trd>
    <trd lng="de">Professor</trd>
    <trd lng="en">professor</trd>
    <trdgrp lng="fa">
      <trd>&a_A;&a_s;&a_t;&a_A;&a_d;</trd>,
      <trd>&f_p;&a_r;&a_w;&a_f;&a_s;&a_w;&a_r;</trd>
    </trdgrp>
    <trd lng="nl">professor</trd>
    <trd lng="ru">&c_p;&c_r;&c_o;&c_f;&c_je;&c_s;&c_s;&c_o;&c_r;</trd>
    <trd lng="sv">professor</trd>
  </snc>
  <snc mrk="profes1.0o.EVI">
    <uzo tip="stl">EVI</uzo>
    <dif>
      En latinidlingvaj landoj, mez-lerneja a&ubreve; e&ccirc; baz-lerneja
      instruisto:
      <ekz>
        <tld/>o &ccirc;e la liceo
        <fnt>
          <bib>Ifigenio</bib>
          <lok>Ifigenio en Ta&ubreve;rido</lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      &Ccirc;i tiu senco estas tre misgvida internacie, kaj en Esperanto
      nepre evitida. En PIV2 &gcirc;i ne aperas.
      <aut>Sergio Pokrovskij</aut>
    </rim>
    <!-- ne traduku EVI:
    <trd lng="en">teacher</trd>
    <trd lng="nl">leraar<klr tip="ind"> (ontr.)</klr></trd>
    -->
  </snc>
  <trd lng="cs">profesor</trd>
  <trdgrp lng="fr">
    <trd>professeur</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>tan&aacute;r</trd>,
    <trd>professzor</trd>
  </trdgrp>
  <trd lng="ja">&#x6559;&#x6388;  <pr>&#x304D;&#x3087;&#x3046;&#x3058;&#x3085;</pr></trd>
  <trd lng="pl">profesor</trd>
  <trd lng="pt">professor <klr>(universit&aacute;rio)</klr></trd>
  <trd lng="ro">profesor</trd>
  <trd lng="sk">profesor</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_r;&c_o;&c_f;&c_je;&c_s;&c_o;&c_r;</trd>,
    <trd>&c_v;&c_i;&c_k;&c_l;&c_a;&c_d;&c_a;&c_ch;</trd>
  </trdgrp>
  <trd lng="zh">&#x6559;&#x6388; <pr>ji&agrave;osh&ograve;u</pr></trd>
</drv>
  </art>
