<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kantar1.xml,v 1.25 2026/09/23 18:23:45 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>kantarid</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="kantar1.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="kantar1.0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <dif>
      Specio el la ordo <ref tip="super" cel="koleop.0oj">koleopteroj</ref>
      (<trd lng="la">Lytta vesicatoria</trd>),
      metale verda skarabo, kies veneno <klr>(kantaridino)</klr>
      vezikigas la ha&ubreve;ton kaj estis uzata kiel afrodiziiga&jcirc;o
      kaj por vezikplastroj:
      <ekz>
        li almetis al si sur la nukon kaj sur la dorson po unu granda
        <tld/>a plastro, por eltiri la frenezecon
        <fnt><bib>Fab1</bib>, <lok>galo&scirc;oj de feli&ccirc;o, 4</lok></fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/7/70/Lytta_vesicatoria_up.JPG/330px-Lytta_vesicatoria_up.JPG"
      prm="CC BY-SA 3.0"
      ><tld/>o (Lytta vesicatoria), Suda Francujo
        <fnt>
          <aut>Siga, propra verko</aut>
          <lok><url ref="&WCW;/File:Lytta_vesicatoria_up.JPG"
              >https://commons.wikimedia.org/wiki/File:Lytta_vesicatoria_up.JPG</url></lok>
        </fnt>
    </bld>
  </snc>
  <adm>
    Mankas dif de "vezikplastro".
    <aut>MB</aut>
  </adm>
  <trd lng="be">&c_sh;&c_p;&c_a;&c_n;&c_s;&c_k;&c_a;&c_ja; &c_m;&c_u;&c_sh;&c_k;&c_a;</trd>
  <trd lng="br">c'hwil-glas</trd>
  <trd lng="ca">cant&agrave;rida</trd>
  <trd lng="cs">moucha &scaron;pan&ecaron;lsk&aacute;</trd>
  <trd lng="de"><ofc>*</ofc>Spanische Fliege</trd>
  <trdgrp lng="en">
    <trd>sailor beetle</trd>,
    <trd>soldier beetle</trd>
  </trdgrp>
  <trd lng="fr"><ofc>*</ofc>cantharide</trd>
  <trd lng="hu">k&odblac;risbog&aacute;r</trd>
  <trd lng="ja">&#x30DF;&#x30C9;&#x30EA;&#x30B2;&#x30F3;&#x30BB;&#x30A4;</trd>
  <trd lng="nl">Spaanse <ind>vlieg</ind></trd>
  <trdgrp lng="pl">
    <trd>kantaryda</trd>,
    <trd>pryszczel lekarski</trd>
  </trdgrp>
  <trd lng="ro">cantarid&abreve;</trd>
  <trd lng="ru"><ofc>*</ofc>&c_sh;&c_p;&c_a;&c_n;&c_s;&c_k;&c_a;&c_ja; &c_m;&c_u;&c_h;&c_a;</trd>
  <trd lng="sk">&scaron;panielska mu&scaron;ka</trd>
  <trd lng="uk">&c_sh;&c_p;&c_a;&c_n;&c_s;&c_mol;&c_k;&c_a; &c_m;&c_u;&c_h;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#x8765; <pr>m&aacute;o</pr></trd>,
    <trd>&#x87CA; <pr>m&aacute;o</pr></trd>
  </trdgrp>
</drv>
</art>
