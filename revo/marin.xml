<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: marin.xml,v 1.22 2026/10/05 19:30:32 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>marin</rad>/i
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="marin.0i">
  <kap>
    <tld/>i
  </kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="marin.0i.KUI">
  <uzo tip="fak">KUI</uzo>
    <dif>
      Trempi dum kelka tempo en vinagro, vino a&ubreve; oleo kun spicoj viandon
      a&ubreve; aliajn man&gcirc;a&jcirc;ojn poste kuirotajn:
      <ekz>
        <tld/>i kapreolan kruron, haringojn, betojn;
      </ekz>
      <ekz>
        oni ne man&gcirc;as &ccirc;i tiujn altajn tigojn, sed tre junajn bambuajn &scirc;osojn,
        <klr>[&#x2026;]</klr> la kerno de junaj tigoj, <tld/>itaj en vinagro, produktas tre
        valoran spicon
        <fnt>
          <aut>Julio Vern, trad. Geo</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/9998/0026.php"
              >La Insulo Mistera</url></vrk>
          <lok>&Ccirc;apitro IV</lok>
        </fnt>;
      </ekz>
      <ekz>
        kukumoj <tld/>itaj en dol&ccirc;a-acida spica&jcirc;o
        <fnt>
          <aut>Dorothea Kaiser</aut>
          <vrk><url ref="https://karapacopanoramo.blogspot.com/2007/06/fisupo-la-donjo.html"
              >Fi&scirc;supo la&ubreve; Donjo</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        kraboj <tld/>itaj en vino
        <fnt>
          <aut>R. Sachs</aut>
          <vrk><url ref="https://www.eventoj.hu/steb/medicino/medicina-parazitologio/medicina-parazitologio.htm"
              >Medicina Parazitologio</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="macer.0i">maceri</ref>,
      <ref cel="pekl.0i">pekli</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_r;&c_y;&c_n;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>
  <trd lng="br">lakaat en <ind>hili</ind></trd>
  <trd lng="ca">marinar</trd>
  <trdgrp lng="de">
    <trd>marinieren</trd>,
    <trd>einlegen <klr>(in Essig, Marinade)</klr></trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>marinate</trd>,
    <trd>pickle</trd>
  </trdgrp>
  <trd lng="fr">mariner</trd>
  <trdgrp lng="hu">
    <trd>p&aacute;col</trd>,
    <trd>marin&iacute;roz</trd>
  </trdgrp>
  <trd lng="ja">&#x30DE;&#x30EA;&#x30CD;&#x30FC;&#x30C9;&#x306B;&#x6F2C;&#x3051;&#x308B;  <pr>&#x30DE;&#x30EA;&#x30CD;&#x30FC;&#x30C9;&#x306B;&#x3064;&#x3051;&#x308B;</pr></trd>
  <trd lng="nl">marineren</trd>
  <trd lng="pl">marynowa&cacute;</trd>
  <trdgrp lng="pt">
    <trd>p&ocirc;r em <ind>marinada</ind></trd>,
    <trd>marinar</trd>,
    <trd>p&ocirc;r em <ind>escabeche</ind></trd>,
    <trd>p&ocirc;r em <ind>vinha-d'alhos</ind></trd>
  </trdgrp>
  <trd lng="ro">mur&abreve;</trd>
  <trd lng="ru">&c_m;&c_a;&c_r;&c_i;&c_n;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
  <trd lng="sv">marinera</trd>
  <trd lng="uk">&c_m;&c_a;&c_r;&c_i;&c_n;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  <trdgrp lng="zh">
    <trd>&#x6F24; <pr>l&#x1CE;n</pr></trd>,
    <trd>&#x814C;&#x5236; <pr>y&amacron;nzh&igrave;</pr></trd>,
    <trd>&#x814C;&#x88FD; <pr>y&amacron;nzh&igrave;</pr></trd>,
    <trd>&#x9183;&#x6E0D; <pr>y&amacron;nz&igrave;</pr></trd>,
    <trd>&#x9183;&#x6F2C; <pr>y&amacron;nz&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="marin.0ajxo">
  <kap>
    <tld/>a&jcirc;o
  </kap>
  <uzo tip="fak">KUI</uzo>
  <snc>
    <dif>
      Man&gcirc;o preparita per <tld/>ado; la flua&jcirc;o, per kiu oni <tld/>as:
      <ekz>
        li faris siajn receptojn kaj &ccirc;iutage konservadis fungojn en sia sekreta <tld/>a&jcirc;o
        <fnt>
          <aut>Vera rakonteto pri fungoj</aut>
          <vrk><url ref="https://verkoj.com/dn/revuoj/Mirmekobo/mirmekobo21.pdf"
              >Vera rakonteto pri fungoj</url></vrk>
          <lok>Mirmekobo, 21, okt. 2012, p. 30</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>Marinade</trd>,
    <trd>Eingelegtes</trd>
  </trdgrp>
  <trd lng="en">marinade</trd>
  <trd lng="fr">marinade</trd>
</drv>

</art>
