<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kolik.xml,v 1.21 2026/09/21 19:22:10 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>kolik</rad>/o
<fnt><bib>JED</bib></fnt></kap>

<drv mrk="kolik.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc mrk="kolik.0o.kojla">
    <dif>
      <ref tip="super" cel="dolor.0o">Doloro</ref> de la kojlo:
      <ekz>
        li ne plu povos atingi la necesejon <klr>[&#x2026;]</klr> trovas kaserolon
        <klr>[&#x2026;]</klr>, liberi&gcirc;inte de sia <tld/>o, Kruko, kun la kaserolo en la
        mano, malrapide revenas
        <fnt>
          <bib>KrB</bib>
          <lok>Poton taksu la&ubreve; sono</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;evaloj forte inklini&gcirc;as al <tld/>oj pro manko de senproblema regurgiteblo
        <fnt>
          <aut>Monika Schmalstieg</aut>
          <vrk><url ref="https://scienca-revuo.info/files/1498-1-1636-1-10-20140426.pdf"
              >Oni jam vidis &ccirc;evalojn voma&ccirc;i</url></vrk>
          <lok>Scienca Revuo 4/2005, p. 239</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="en">
      <trd>colic</trd>,
      <trd>gripes</trd>,
      <trd>intestinal <klr>cramps</klr></trd>
    </trdgrp>
    <trd lng="ru">&c_r;&c_je;&c_z;&c_mol;</trd>
  </snc>
  <snc mrk="kolik.0o.iuorgana">
    <dif>
      Spasma doloro de interna organo:
      <ekz>
        hepata, rena <tld/>o.
      </ekz>
    </dif>
  </snc>
  <ref tip="lst" cel="san.mal0o.MED" lst="voko:malsanoj">malsano</ref>
  <trdgrp lng="be">
    <trd>&c_k;&c_o;&c_l;&c_ib;&c_k;&c_a;</trd>,
    <trd>&c_r;&c_e;&c_z;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_a;&c_ch;&c_k;&c_a;</trd>
  </trdgrp>
  <trd lng="ca">c&ograve;lic</trd>
  <trd lng="cs">kolika <klr>(z&aacute;chvat)</klr></trd>
  <trd lng="de">Kolik</trd>
  <trd lng="es">c&oacute;lico</trd>
  <trd lng="fr">colique<klr tip="ind"> (subst.)</klr></trd>
  <trd lng="id">kolik</trd>
  <trdgrp lng="ja">
    <trd>&#x759D;&#x75DB;  <pr>&#x305B;&#x3093;&#x3064;&#x3046;</pr></trd>,
    <trd>&#x5DEE;&#x3057;&#x8FBC;&#x307F;  <pr>&#x3055;&#x3057;&#x3053;&#x307F;</pr></trd>,
    <trd>&#x8179;&#x75DB;  <pr>&#x3075;&#x304F;&#x3064;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="nl">koliek</trd>
  <trd lng="pl">kolka</trd>
  <trd lng="ro">colic&abreve;</trd>
  <trd lng="ru">&c_k;&c_o;&c_l;&c_i;&c_k;&c_a;</trd>
  <trd lng="sk">kolika</trd>
  <trdgrp lng="uk">
    <trd>&c_k;&c_o;&c_l;&c_mol;&c_k;&c_a;</trd>,
    <trd>&c_r;&c_ib;&c_z;&c_mol;</trd>
  </trdgrp>
</drv>
</art>
