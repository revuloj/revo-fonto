<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ekscen.xml,v 1.23 2026/08/04 19:53:26 revo Exp $">
<kap>
  <rad>ekscentrik</rad>/o
  <fnt><bib>PVEF</bib></fnt>
</kap>

<drv mrk="ekscen.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">TEK</uzo>
  <snc>
    <dif>
      Disko, ringo a&ubreve; cilindra stango, kies rotacia akso ne
      okupas la centron.
    </dif>
  </snc>
  <trd lng="be">&c_e;&c_k;&c_s;&c_c;&c_e;&c_n;&c_t;&c_r;&c_y;&c_k;</trd>
  <trd lng="ca">exc&egrave;ntric<klr> (subst.)</klr></trd>
  <trdgrp lng="cs">
    <trd>excentr</trd>,
    <trd>v&yacute;st&rcaron;edn&yacute; kotou&ccaron;</trd>
  </trdgrp>
  <trdgrp lng="de">
     <trd>Exzenter</trd>,
     <trd>Unwucht</trd>
  </trdgrp>
  <trd lng="en">eccentric<klr tip="amb"> (geometry)</klr></trd>
  <trd lng="fr">excentrique<klr tip="ind"> (subst., m&eacute;c.)</klr></trd>
  <trdgrp lng="hu">
    <trd>k&ouml;rhagy&oacute; elem</trd>,
    <trd>excenter</trd>
  </trdgrp>
  <trd lng="ja">&#x504F;&#x5FC3;&#x8F2A;  <pr>&#x3078;&#x3093;&#x3053;&#x3053;&#x308D;&#x308A;&#x3093;</pr></trd>
  <trd lng="pl">mimo&sacute;r&oacute;d</trd>
  <trd lng="ru">&c_e;&c_k;&c_s;&c_c;&c_je;&c_n;&c_t;&c_r;&c_i;&c_k;</trd>
  <trdgrp lng="sk">
    <trd>excenter</trd>,
    <trd>v&yacute;stredn&yacute; kot&uacute;&ccaron;</trd>
  </trdgrp>
  <trd lng="zh">&#x51F8;&#x8F2A; <pr>t&umacron;l&uacute;n</pr></trd>
</drv>

<drv mrk="ekscen.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">TEK</uzo>
  <snc>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        <ind><tld/>a</ind> disko, ringo, stango;
      </ekz>
      <ekz>
        krank&scirc;afto estas <tld/>a akso kiu transformas navedan movadon al rotacia (turna)
        movado a&ubreve; inverse
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=399149"
              >Krank&scirc;afto</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_e;&c_k;&c_s;&c_c;&c_e;&c_n;&c_t;&c_r;&c_y;&c_ch;&c_n;&c_y;</trd>
    <trd lng="ca">exc&egrave;ntric<klr> (adj.)</klr></trd>
    <trdgrp lng="de">
      <trd>exzentrisch</trd>,
      <trd>unwuchtig</trd>
    </trdgrp>
    <trd lng="en">eccentric<klr tip="amb"> (geometry)</klr></trd>
    <trd lng="es">exc&eacute;ntrico</trd>
    <trd lng="fr">excentrique<klr tip="ind"> (adj.,
    m&eacute;c.)</klr></trd>
    <trdgrp lng="hu">
      <trd>k&ouml;rhagy&oacute;</trd>,
      <trd>excentrikus</trd>
    </trdgrp>
    <trd lng="pl">mimo&sacute;rodowy</trd>
    <trd lng="pt">exc&ecirc;ntrico</trd>
    <trd lng="ru">&c_e;&c_k;&c_s;&c_c;&c_je;&c_n;&c_t;&c_r;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;</trd>
  </snc>
  <refgrp tip="vid">
    Ne konfuzu kun <ref cel="ekscentr.0a">ekscentra (ekstravaganca)</ref>
  </refgrp>
  <trdgrp lng="cs">
    <trd>excentrick&yacute;</trd>,
    <trd>mimost&rcaron;edn&yacute;</trd>
  </trdgrp>
  <trd lng="he">&tav;&mem;&he;&vav;&nun;&yod;</trd>
  <trd lng="sk">mimostredov&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#x975E;&#x4F20;&#x7EDF; <pr>f&emacron;ichu&aacute;nt&#x1D2;ng</pr></trd>,
    <trd>&#x504F;&#x5FC3; <pr>pi&amacron;nx&imacron;n</pr></trd>
  </trdgrp>
</drv>
</art>
