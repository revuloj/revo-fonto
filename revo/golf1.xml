<kap>
  <rad>golf</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="golf1.0o">
  <kap><tld/>o,
  <var><kap><tld/>ludo<fnt><bib>PIV1</bib></fnt></kap></var></kap>
  <snc mrk="golf1.0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Surherba
      <ref tip="super" cel="sport.0o.SPO">sporto</ref>,
      en kiu ludantoj per bastono (&leftquot;klabo&#8223;)
      batas pilketon, celante sinsekvajn malproksimajn truojn:
      <ekz>
        dum <tld/>o li kripligis sin por pli ol semajno,
        montrante al novulo kiel svingi
        <fnt>
          <aut>J. K. Jerome, trad. R. Williams</aut>,
          <vrk><url ref="&Sezonoj;2013/10/jerome">
          La viro kiu volis direkti</url></vrk>,
          <lok>La Ondo de Esperanto, 2013:10</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim mrk="golf1.0o.RIM_HOM">
    Fundamente <ref tip="hom" cel="golf.0o.GEOG">golfo</ref>
    estas kava kurbo de marbordo.
  </rim>
  <trd lng="be">&c_g;&c_o;&c_l;&c_mol;&c_f;</trd>
  <trd lng="bg">&c_g;&c_o;&c_l;&c_f;</trd>
  <trd lng="bo">&#3928;&#3930;&#3964;&#3851;&#3905;&#3956;&#3906;&#3851;</trd>
  <trd lng="ca">golf<klr tip="amb"> (esport)</klr></trd>
  <trd lng="de">Golf<klr> (Sport)</klr></trd>
  <trd lng="en">golf</trd>
  <trd lng="es">golfo<klr> (deporte)</klr></trd>
  <trd lng="fr">golf<klr> (sport)</klr></trd>
  <trd lng="id">golf</trd>
  <trd lng="ja">&#12468;&#12523;&#12501;  <pr>&#12372;&#12427;&#12405;</pr></trd>
  <trd lng="nl">golf<klr> (sport)</klr></trd>
  <trd lng="pl">golf</trd>
  <trdgrp lng="uk">
    <trd>&c_z;&c_a;&c_t;&c_o;&c_k;&c_a;</trd>,
    <trd>&c_b;&c_u;&c_h;&c_t;&c_a;</trd>
  </trdgrp>
  <trd lng="zh">&#39640;&#23572;&#22827;&#29699; <pr>g&amacron;o&ecaron;rf&#363;qi&uacute;</pr></trd>
