<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: konsul1.xml,v 1.27 2026/09/23 07:43:05 revo Exp $">
<kap>
  <ofc>3</ofc>
  <rad>konsult</rad>/i
  <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="konsul1.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      <ref tip="super" cel="demand.0i">Demandi</ref> specialiston por koni lian
      opinion pri io; <ref tip="super" cel="konsil.0igxi">konsili&gcirc;i</ref> kun
      kompetentulo:
      <ekz>
        <tld/>i konsiliston, orakolon,
        <uzo tip="stl">FIG</uzo>
        sian konsciencon, vortaron;
      </ekz>
      <ekz>
        li <tld/>u bonan kuraciston, kiu eble trovos rimedon
        <fnt>
          <bib>Ret</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>i sian amikon
        <fnt>
          <bib>I&scirc;tar</bib>
          <lok>&Ccirc;apitro VIII</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;u vi jam <tld/>is vian advokaton
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro XII</lok>
        </fnt>?
      </ekz>
      <ekz>
        <klr>[mi]</klr> <tld/>is la plej eminentajn historiistojn
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro VIII</lok>
        </fnt>;
      </ekz>
      <ekz>
        li deziris <tld/>i sian &ccirc;io-solvan edzinon
        <fnt>
          <bib>MMa</bib>
          <lok>&Ccirc;apitro 1</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        <tld/>i Jarlibron de sia organiza&jcirc;o
        <fnt>
          <bib>EeP</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la registaro volas <tld/>i <klr>(enketi)</klr> la popolon por informi&gcirc;i,
        &gcirc;is kiu grado estas dezirata atomenergio
        <fnt>
          <bib>Monato</bib>
          <aut>Isikawa Takasi</aut>
          <vrk><url ref="&Monato;/2012/010852.php"
              >Fandi&gcirc;is konsciencoj, fandi&gcirc;is reaktorkernoj</url></vrk>
          <lok>2012</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_a;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_a;&c_v;&c_a;&c_c;&c_c;&c_a;</trd>,
    <trd>&c_a;&c_t;&c_r;&c_y;&c_m;&c_a;&c_c;&c_mol; <ind>&c_k;&c_a;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_a;&c_c;&c_y;&c_ju;</ind></trd>
  </trdgrp>
  <trd lng="bg">&c_k;&c_o;&c_n;&c_s;&c_u;&c_l;&c_t;&c_i;&c_r;&c_a;&c_m; &c_s;&c_je;</trd>
  <trd lng="ca">consultar</trd>
  <trdgrp lng="cs">
    <trd>konzultovat <klr>(s)</klr></trd>,
    <trd>poradit se (s)</trd>,
    <trd>&zcaron;&aacute;dat o radu</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>konsultieren</trd>,
    <trd>befragen</trd>,
    <trd>zu <ind>Rate ziehen</ind></trd>
  </trdgrp>
  <trd lng="en">consult</trd>
  <trd lng="es">consultar</trd>
  <trd lng="fr">consulter</trd>
  <trdgrp lng="hu">
    <trd>konzult&aacute;l</trd>,
    <trd>tan&aacute;cskozik</trd>,
    <trd>ut&aacute;nan&eacute;z <klr tip="ind">(vminek)</klr></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x76F8;&#x8AC7;&#x3059;&#x308B;  <pr>&#x305D;&#x3046;&#x3060;&#x3093;&#x3059;&#x308B;</pr></trd>,
    <trd>&#x8AEE;&#x554F;&#x3059;&#x308B;  <pr>&#x3057;&#x3082;&#x3093;&#x3059;&#x308B;</pr></trd>,
    <trd>&#x8ABF;&#x3079;&#x308B;  <pr>&#x3057;&#x3089;&#x3079;&#x308B;</pr></trd>,
    <trd>&#x53C2;&#x7167;&#x3059;&#x308B;  <pr>&#x3055;&#x3093;&#x3057;&#x3087;&#x3046;&#x3059;&#x308B;</pr></trd>
  </trdgrp>
  <trd lng="kek">aatinank</trd>
  <trd lng="nl">raadplegen</trd>
  <trdgrp lng="pl">
    <trd>konsultowa&cacute; si&eogonek;</trd>,
    <trd>radzi&cacute; si&eogonek;</trd>
  </trdgrp>
  <trd lng="pt">consultar</trd>
  <trd lng="ro">consulta</trd>
  <trdgrp lng="ru">
    <trd>&c_k;&c_o;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;&c_s;&c_ja; <klr>(&c_u; &c_k;&c_o;&c_g;&c_o;-&c_l;.)</klr></trd>,
    <trd>&c_p;&c_o;&c_l;&c_u;&c_ch;&c_i;&c_t;&c_mol; &c_k;&c_o;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_a;&c_c;&c_i;&c_ju; <klr>(&c_u; &c_k;&c_o;&c_g;&c_o;-&c_l;.)</klr></trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>konzultova&tcaron;</trd>,
    <trd>poradi&tcaron; sa <klr>(s)</klr></trd>,
    <trd>&zcaron;iada&tcaron; o radu</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8AEE;&#x8A62; <pr>z&imacron;x&uacute;n</pr></trd>,
    <trd>&#x54A8;&#x8A62; <pr>z&imacron;x&uacute;n</pr></trd>,
    <trd>&#x8ACB;&#x6559; <pr>q&#x1D0;ngji&agrave;o</pr></trd>,
    <trd>&#x8B2A; <pr>sh&amacron;ng</pr></trd>,
    <trd>&#x53C2;&#x8003; <pr>c&amacron;nk&#x1CE;o</pr></trd>,
    <trd>&#x54A8; <pr>z&imacron;</pr></trd>,
    <trd>&#x8AEE; <pr>z&imacron;</pr></trd>,
    <trd>&#x78CB;&#x5546; <pr>cu&omacron;sh&amacron;ng</pr></trd>,
    <trd>&#x5546;&#x91CF; <pr>sh&amacron;ngliang</pr></trd>,
    <trd>&#x67E5;&#x95B1; <pr>ch&aacute;yu&egrave;</pr></trd>,
    <trd>&#x6D3D;&#x8A62; <pr>qi&agrave;x&uacute;n</pr></trd>,
    <trd>&#x8A0E;&#x6559; <pr>t&#x1CE;oji&agrave;o</pr></trd>
  </trdgrp>
</drv>

<drv mrk="konsul1.0igxa">
  <kap><tld/>i&gcirc;a</kap>
  <snc>
    <dif>
      Rajtanta doni sian opinion pri demando, sed ne decidi pri &gcirc;i:
      <ekz>
        <ind><tld/>i&gcirc;a komitato</ind>
        <klr>(kontraste kun balotrajta)</klr>.
        <trd lng="ca">comit&eacute; consultiu</trd>
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_a;&c_c;&c_y;&c_j;&c_n;&c_y;</trd>
  <trd lng="bg">&c_s;&c_malmol;&c_v;&c_je;&c_shch;&c_a;&c_t;&c_je;&c_l;&c_je;&c_n;</trd>
  <trd lng="ca">consultiu</trd>
  <trdgrp lng="de">
    <trd>beratend</trd>
  </trdgrp>
  <trd lng="en">advisory</trd>
  <trdgrp lng="es">
    <trd>de consulta</trd>
    <trd>consultor, consultora</trd>
  </trdgrp>
  <trd lng="fr">consultatif</trd>
  <trdgrp lng="hu">
    <trd>tan&aacute;cskoz&oacute;</trd>
    <trd>tan&aacute;cskoz&aacute;si</trd>
  </trdgrp>
  <trd lng="ja">&#x8AEE;&#x554F;&#x306E;  <pr>&#x3057;&#x3082;&#x3093;&#x306E;</pr></trd>
  <trd lng="nl">adviserend</trd>
  <trd lng="pl">doradczy</trd>
  <trd lng="ro">consultativ</trd>
  <trdgrp lng="ru">
    <trd>&c_k;&c_o;&c_n;&c_s;&c_u;&c_l;&c_mol;&c_t;&c_a;&c_t;&c_i;&c_v;&c_n;&c_y;&c_j;</trd>,
    <trd>&c_s;&c_o;&c_v;&c_je;&c_shch;&c_a;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_y;&c_j;</trd>
  </trdgrp>
</drv>

<drv mrk="konsul1.0igxi">
  <kap>
    <tld/>i&gcirc;i
  </kap>
  <snc>
    <dif>
      Esti pridemandata kiel kompetentulo; <ref tip="dif" cel="konsil.0i">konsili</ref>.
    </dif>
    <trd lng="de">beraten</trd>
  </snc>
  <snc mrk="konsul1.0igxi.kunveni">
    <dif>
      Kunveni en rondo de spertuloj por interkonsili&gcirc;i:
      <ekz>
        ni ne alprenis decidon sen anta&ubreve;e <tld/>i&gcirc;i inter ni
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>i&gcirc;o kun du el la senatanoj
        <fnt>
          <bib>MJA</bib>
          <lok>Parto Kvina</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi revivigis la iamajn <tld/>i&gcirc;ojn <klr>[&#x2026;]</klr> sur la bazo de la komuna
        intereso
        <fnt>
          <bib>LOdE</bib>
          <lok>2001, &#x2116;6</lok>
        </fnt>;
      </ekz>
      <ekz>
        en <nom>Dob&rcaron;ichovice</nom> <tld/>i&gcirc;is reprezentantoj de meze&ubreve;ropaj E-asocioj
        <fnt>
          <bib>LOdE</bib>
          <lok>2002, &#x2116;1</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">sich <ind>beraten</ind></trd>
  </snc>
</drv>

</art>
