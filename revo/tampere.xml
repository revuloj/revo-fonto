<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: tampere.xml,v 1.3 2026/09/06 22:08:59 afido Exp $">
    <kap>
     <ofc>10</ofc> <rad>Tampere</rad>/o
    </kap>

<drv mrk="tampere.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
     <ref tip="prt" cel="finn.F0lando">Finna</ref>
     <ref tip="lst" lst="voko:urboj" cel="urb.0o.ARKI">urbo</ref>, kie
     en 1995 okazis la 80a Universala Kongreso de Esperanto,
     &ccirc;. 150&#8239;km nord-okcidente de
     <ref tip="prt" cel="helsink.0o">Helsinko</ref>;
     situo: (<frm>61&#x2DA;30&minute;N  23&#x2DA;46&minute;E</frm>):
      <ekz>
        la Universitato de <tld/>o
        <fnt>
          <bib>LOdE</bib>
          <lok>2002, &#8470; 11</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Komitato de UEA en <tld/>o unuanime elektis <klr>[Barbara Cvetkova]</klr> Honora Membro
        de UEA, cetere
        la sola en Ruslando la&ubreve; la lastaj Jarlibroj
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 8-9 (58-59)</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;telistoj penetris en la konstrua&jcirc;on kie trovi&gcirc;as la klubejo Nesto (<tld/>o,
        Finnlando), sed ili ne sukcesis malfermi la pordon
        <fnt>
          <bib>LOdE</bib>
          <lok>2000, No 11</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Tampere</trd>
    <trd lng="en">Tampere</trd>
    <trd lng="fi">Tampere</trd>
    <trd lng="fr">Tampere</trd>
    <trd lng="pl">Tampere</trd>
    <trd lng="se">Tammerfors</trd>
  </snc>
    <trd lng="be">&c_T;&c_a;&c_m;&c_p;&c_e;&c_r;&c_e;</trd>
</drv>
</art>

