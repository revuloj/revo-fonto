<art mrk="$Id: triole.xml,v 1.20 2026/09/20 16:03:09 revo Exp $">
<kap>
  <rad>triolet</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="triole.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">POE</uzo>
  <snc>
    <dif>
      Fiksforma <ref tip="super" cel="vers.0ajxo">versa&jcirc;o</ref> okversa kun ripeto de la unua verso
      post la tria
      kaj de la du unuaj post la sesa:
      <ekz>
        lia poemeto Krizantemo, la&ubreve; metriko, la <tld lit="T"/>o estas enhavita en la
        fama Parnasa Gvidlibro
        <fnt>
          <aut>Shi Chengtai</aut>
          <vrk><url ref="http://www.espero.com.cn/2012-09/04/content_29175381.htm"
                  >Fonto de la &ccirc;ina sa&gcirc;o &dash; Aperas la Esperanta versio de Da&ubreve; De Jing de
              Laozi</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        Maja <tld lit="T"/>o: Plej bela fest' &ndash; unua Tag' de Majo! &#11005; &Gcirc;i estas festo de
        Natur' kaj Kreo, &#11005; en tiu tago &ccirc;ie regas gajo! &#11005; Plej bela fest' &ndash; unua Tag'
        de Majo! &#11005; En urbo, en vila&gcirc;', sur kajo &ndash; &#11005; solenas &ccirc;ie nia Pacarmeo!... &#11005;
        Plej bela fest' &ndash; unua Tag' de Majo, &#11005; &gcirc;i estas festo de Natur' kaj Kreo!
        <fnt>
          <aut>G. De&scaron;kin</aut>
          <vrk><url ref="http://esperantobrno.cz/malnova/Fajrero-1961-02.pdf">Maja
          Trioleto</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_t;&c_r;&c_y;&c_ja;&c_l;&c_je;&c_t;</trd>
  <trdgrp lng="cs">
    <trd>triola</trd>,
    <trd>trylek</trd>
  </trdgrp>
  <trd lng="de">Triolett</trd>
  <trd lng="en">triolet</trd>
  <trd lng="fr">triolet</trd>
  <trd lng="hu">triolett</trd>
  <trdgrp lng="ja">
    <trd>&#x30C8;&#x30EA;&#x30AA;&#x30EC;</trd>,
    <trd>&#x4E09;&#36899;&#x97F3;&#x7B26;  <pr>&#12373;&#12435;&#x308C;&#12435;&#x304A;&#12435;&#12407;</pr></trd>
  </trdgrp>
  <trd lng="nl">triolet</trd>
  <trd lng="pl">triolet</trd>
  <trd lng="pt">triol&eacute;</trd>
  <trd lng="ro">triolet</trd>
  <trd lng="ru">&c_t;&c_r;&c_i;&c_o;&c_l;&c_je;&c_t;</trd>
  <trd lng="sk">triolet</trd>
  <trd lng="uk">&c_t;&c_r;&c_ib;&#x43E;&#x43B;&c_je;&c_t;</trd>
</drv>
</art>
