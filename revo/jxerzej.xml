<kap>
  <rad>&Jcirc;erzej</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="jxerzej.0o">
  <kap><tld/>o</kap>
  <snc mrk="jxerzej.0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Unu el la Manikinsuloj apud Francio,
      dependa je la brita re&gcirc;ado:
      <ekz>
        ligitaj al Britujo estas Manikinsuloj <tld/>o,
        Gernezejo k.a.
        <fnt><bib>LanLin</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_D;&c_zh;&c_e;&c_r;&c_z;&c_ib;</trd>
  <trd lng="ca">Jersey</trd>
  <trd lng="en">Jersey</trd>
  <trd lng="fr">Jersey</trd>
  <trd lng="ja">&#12472;&#12515;&#12540;&#12472;&#12540;&#23798; 
  <pr>&#12472;&#12515;&#12540;&#12472;&#12540;&#12375;&#12414;</pr></trd>
  <trd lng="pl">Jersey</trd>
  <trd lng="uk">&c_D;&c_zh;&c_je;&c_r;&c_s;&c_ib;</trd>
  <trdgrp lng="zh">
    <trd>&#27901;&#35199; <pr>Z&eacute;x&#299;</pr></trd>,
    <trd>&#27901;&#35199;&#23707; <pr>Z&eacute;x&#299;D&#462;o</pr></trd>
  </trdgrp>
</drv>

<drv mrk="jxerzej.nov0o">
  <kap>Nov<tld lit="&jcirc;"/>o</kap>
  <snc mrk="jxerzej.nov0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Sub&scirc;tato en la nordorienta parto de
      <ref tip="malprt" cel="uson.U0o.GEOG">Usono</ref>:
      <ekz>
        la romano rakontas la aventurojn de mafia familio
        en Nov<tld lit="&jcirc;"/>o
        <fnt>
          <aut>-, trad. Centre culturel d&#8217;esp&eacute;ranto de Marseille</aut>,
          <vrk>Tonino Benacquista</vrk>,
          <lok>en <url ref="http://esperanto.marseille.over-blog.com/categorie-11643621.html">
          esperanto.marseille, 2009-03-15</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_N;&c_mol;&c_ju;-&c_D;&c_zh;&c_e;&c_r;&c_z;&c_ib;</trd>
  <trd lng="ca">Nova Jersey</trd>
  <trd lng="en">New Jersey</trd>
  <trdgrp lng="fr">
    <trd>New Jersey</trd>,
    <trd>Nouveau Jersey</trd>
  </trdgrp>
  <trd lng="pl">New <ind>Jersey</ind></trd>
  <trdgrp lng="zh">
    <trd>&#26032;&#27901;&#35199; <pr>X&#299;nz&eacute;x&#299;</pr></trd>,
    <trd>&#26032;&#27901;&#35199;&#24030; <pr>X&#299;nz&eacute;x&#299;zh&#333;u</pr></trd>,
    <trd>&#32016;&#28580;&#35199; <pr>Ni&#468;z&eacute;x&#299;</pr></trd>
  </trdgrp>
</drv>
</art>

