<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: david.xml,v 1.19 2026/09/15 21:17:41 revo Exp $">
<kap>
  <rad>David</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="david.0o">
  <kap><tld/>o</kap>
  <snc mrk="david.0o.NOM">
    <uzo tip="fak">NOM</uzo>
    <dif>
      Vira <ref tip="lst" cel="nom.antaux0o" lst="voko:personaj_nomoj">anta&ubreve;nomo</ref>
      hebredevena:
      <ekz>
        <tld/>o <klr>[&#x2026;]</klr> &ccirc;i&ccirc;eronis nin pla&ccirc;ivole &ccirc;ien en la urbo
        <fnt>
          <bib>Kon11</bib>
          <lok>Esperanto kaj solidareco kuni&gcirc;is en Tanzanio</lok>
        </fnt>;
      </ekz>
      <ekz>
        Leono sciis iom pri la koro de <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Den Drown</aut>
          <vrk><url ref="&Monato;/2003/008171.html"
              >Elektoj</url></vrk>
          <lok>2003</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="david.0o.PERS">
    <uzo tip="fak">BIB</uzo>
    <uzo tip="fak">PERS</uzo>
    <dif>
      Re&gcirc;o de Izraelo (proksimume 1000 a.K. &ndash; proksimume 972
      a.K.), fondinto de ties precipa dinastio, tradicie rigardata kiel poeto,
      muzikisto kaj a&ubreve;toro de la biblia Psalmaro:
      <ekz>
        la psalmoj de <tld/>o
        <fnt>
          <bib>Fab4</bib>
          <lok>Historio el la dunoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiam venis la viroj de <nom>Jehuda</nom> kaj sanktoleis tie <tld/>on kiel
        re&gcirc;on super la domo de <nom>Jehuda</nom>
        <fnt><bib>MT</bib>, <lok>&Sa2; 2:4</lok></fnt>;
      </ekz>
      <ekz>
        oni ricevis la impreson, ke Jesuo kaj la an&gcirc;eloj kaj Moseo kaj <tld/>o kaj &ccirc;iuj
        aliaj bibliaj personoj estas liaj intimaj konatoj
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_D;&c_a;&c_v;&c_ib;&c_d;</trd>,
    <trd>&c_D;&c_a;&c_v;&c_y;&c_d;</trd>
  </trdgrp>
  <trd lng="ca">David</trd>
  <trd lng="de">David</trd>
  <trd lng="en">David</trd>
  <trd lng="fr">David</trd>
  <trdgrp lng="id">
    <trd>Daud</trd>,
    <trd>David</trd>
  </trdgrp>
  <trd lng="it">Davide</trd>
  <trd lng="ja">&#x30C0;&#x30D3;&#x30C7;</trd>
  <trd lng="nl">David</trd>
  <trd lng="oc">D&agrave;vid</trd>
  <trd lng="pl">Dawid</trd>
  <trdgrp lng="pt">
    <trd>Davi</trd>,
    <trd>David</trd>
  </trdgrp>
  <trd lng="sv">David</trd>
  <trd lng="uk">&c_D;&c_a;&c_v;&c_i;&c_d;</trd>
  <trd lng="zh">&#x5927;&#x536B; <pr>d&agrave;w&egrave;i</pr></trd>
</drv>
</art>

