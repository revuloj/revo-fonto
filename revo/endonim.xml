<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: endonim.xml,v 1.3 2026/11/05 09:25:32 afido Exp $">
<kap>
    <rad>endonim</rad>/o <fnt><bib>Viki</bib></fnt>
</kap>
<drv mrk="endonim.0o">
  <kap><tld/>o</kap>
  <snc mrk="endonim.0o.SNC">
    <uzo tip="fak">LIN</uzo>
    <dif>
      <ref tip="super" cel="nom.lok0o">Loknomo</ref> uzata de lokanoj:
      <ekz>
        la <tld lit="e"/>o de Germanio estas <nom>Deutschland</nom>, tio estas kiel la germanoj
        nomas sian
        landon
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/wiki/Ekzonimo_kaj_endonimo">Ekzonimo kaj
          endonimo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="ekzonim.0o">ekzonimo</ref>
  </snc>
  <trd lng="be">&c_e;&c_n;&c_d;&c_o;&c_n;&c_ib;&c_m;</trd>
  <trd lng="de">Endonym</trd>
  <trd lng="en">endonym</trd>
  <trd lng="fr">endonyme</trd>
  <trd lng="nl">endoniem</trd>
  <trd lng="uk">&c_je;&c_n;&c_d;&c_o;&c_n;&c_ib;&c_m;</trd>
</drv>
</art>

