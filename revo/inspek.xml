<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: inspek.xml,v 1.33 2026/10/17 14:00:19 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>inspekt</rad>/i <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="inspek.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="inspek.0i.KOMUNE">
    <dif>
      <ref tip="super" cel="kontro.0i.administracie">Kontroli</ref> la&ubreve; ricevita komisio
      la funkciadon de io a&ubreve; la agadon de iu:
      <ekz>
        <tld/>i lernejon, &scirc;ipon, armeon, fabrikon;
      </ekz>
      <ekz>
        ili diligente <klr>[&#8230;]</klr> <tld/>is detale &ccirc;iujn kestojn, valizojn kaj &scirc;rankojn
        <fnt>
          <bib>&Ccirc;uk&ccirc;oj</bib>
        </fnt>;
      </ekz>
      <ekz>
        kion vi faras tie &ccirc;i? &ndash; ni <tld/>as la uzinon, diris Alda
        kun &scirc;ajnigita seriozo
        <fnt>
          <bib>InfanTorent2</bib>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Arne</nom> momente <tld/>is &scirc;in kaj diris sektone: <klr>[&#8230;]</klr> aspektas afekteme,
        rigardu, se mi metus &ccirc;apon <klr>[&#8230;]</klr> tiamaniere
        <fnt>
          <bib>InfanTorent2</bib>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[ili]</klr> starigis la Levidojn, havantajn la a&gcirc;on
        de dudek jaroj kaj pli, por <tld/>i la laborojn en la domo de la
        Eternulo
        <fnt><bib>MT</bib>, <lok>&Ezr; 3:8</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="ekzame.0i">ekzameni</ref>,
      <ref cel="revizi.0i">revizii</ref>,
      <ref cel="rigard.super0i.FIG">superrigardi<sncref/></ref>
    </refgrp>
  </snc>
  <adm>
      Indus kontroli en la hebrea originalo, &ccirc;u la unua ekzemplo vere
      montras la modernan sencon de "kontroli", a&ubreve; prefere "direkti",
      "prizorgi". Cetere la tradukoj, kiujn mi trovas por "inspektisto"
      en franca versio de Biblio, perpleksigas: plejofte temas pri
      "skribisto". La ekz. el Fabeloj uzas "inspektadon" kun senco
      proksima al "superrigardado".
      <aut>MB</aut>
  </adm>
  <trdgrp lng="be">
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_e;&c_k;&c_t;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>inspeccionar</trd>,
    <trd>supervisar</trd>,
    <trd>controlar</trd>,
    <trd>examinar</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>dohl&iacute;&zcaron;et</trd>,
    <trd>doz&iacute;rat</trd>,
    <trd>konat dozor</trd>,
    <trd>konat inspekci</trd>,
    <trd>prov&aacute;d&ecaron;t dohled</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>inspizieren</trd>,
    <trd>nachpr&uuml;fen</trd>,
    <trd>&uuml;berwachen</trd>,
    <trd>beschauen</trd>,
    <trd>kontrollieren</trd>
  </trdgrp>
  <trd lng="en">inspect</trd>
  <trd lng="es">inspeccionar</trd>
  <trd lng="fa">&a_b;&a_A;&a_z;&a_r;&a_s;&f_y; &f_k;&a_r;&a_d;&a_n;</trd>
  <trdgrp lng="fr">
    <trd>inspecter</trd>,
    <trd>examiner<klr tip="ind"> (inspecter)</klr></trd>,
    <trd>scruter</trd>,
    <trd>sonder</trd>,
    <trd>superviser</trd>,
    <trd>v&eacute;rifier</trd>,
    <trd>visiter<klr tip="ind"> (inspecter)</klr></trd>
  </trdgrp>
  <trd lng="hu">fel&uuml;gyel</trd>
  <trdgrp lng="ja">
    <trd>&#26619;&#23519;&#12377;&#12427;  <pr>&#12373;&#12373;&#12388;&#12377;&#12427;</pr></trd>,
    <trd>&#26908;&#26619;&#12377;&#12427;  <pr>&#12369;&#12435;&#12373;&#12377;&#12427;</pr></trd>,
    <trd>&#30435;&#26619;&#12377;&#12427;  <pr>&#12363;&#12435;&#12373;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trd lng="nl">inspecteren</trd>
  <trdgrp lng="pl">
    <trd>nadzorowa&cacute;</trd>,
    <trd>kontrolowa&cacute;</trd>,
    <trd>wizytowa&cacute;</trd>,
    <trd>dogl&aogonek;da&cacute;</trd>
  </trdgrp>
  <trd lng="pt">inspecionar</trd>
  <trdgrp lng="ru">
    <trd>&c_i;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_n;&c_a;&c_d;&c_z;&c_i;&c_r;&c_a;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>dozera&tcaron;</trd>,
    <trd>kona&tcaron; dozor</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_s;&c_t;&c_je;&c_zh;&c_i;&c_t;&c_i; (&c_z;&c_a; &c_ch;&c_i;&c_m;-&c_n;.</trd>,
    <trd>&c_k;&c_i;&c_m;-&c_n;.)</trd>,
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#26597;&#30475; <pr>ch&aacute;k&agrave;n</pr></trd>,
    <trd>&#26680;&#26597; <pr>h&eacute;ch&aacute;</pr></trd>,
    <trd>&#31293;&#26597; <pr>j&#299;ch&aacute;</pr></trd>,
    <trd>&#31293; <pr>j&#299;</pr></trd>,
    <trd>&#26816;&#26597; <pr>ji&#462;nch&aacute;</pr></trd>,
    <trd>&#35222;&#23519; <pr>sh&igrave;ch&aacute;</pr></trd>,
    <trd>&#26597;&#39511; <pr>ch&aacute;y&agrave;n</pr></trd>,
    <trd>&#23457;&#26680; <pr>sh&ecaron;nh&eacute;</pr></trd>,
    <trd>&#23519; <pr>ch&aacute;</pr></trd>,
    <trd>&#26816;&#39564; <pr>ji&#462;ny&agrave;n</pr></trd>,
    <trd>&#25911; <pr>k&#462;o</pr></trd>,
    <trd>&#26597; <pr>ch&aacute;</pr></trd>,
    <trd>&#26816; <pr>ji&#462;n</pr></trd>,
    <trd>&#31293;&#26680; <pr>j&#299;h&eacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="inspek.0o">
  <kap><tld/>o, <var><kap><tld/>ado</kap></var></kap>
  <snc mrk="inspek.0o.kontrolo">
    <dif>
      Ago <tld/>i, detala kontrolo:
      <ekz>
        ili ne frotis siajn mantelbutonojn dece brilaj
        kaj ili ne tenis la pafilon
        sufi&ccirc;e stre&ccirc;e &ccirc;e la parada <tld/>ado
        <fnt>
          <bib>VaK</bib>
        </fnt>;
      </ekz>
      <ekz>
        montri&gcirc;is post <tld/>ado per speciala roboto, ke la
        reaktoroj <klr>[&#8230;]</klr>
        havas multajn mikroskopajn vezikojn en la metalo
        <fnt>
          <bib>Monato</bib>
          <aut>Eddy Van den Bosch</aut>
          <vrk><url ref="&Monato;/2014/011380.php">&Ccirc;u sabotado &ccirc;e nuklea centralo?</url></vrk>
          <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_ib;&c_n;&c_s;&c_p;&c_e;&c_k;&c_c;&c_y;&c_ja;</trd>,
      <trd>&c_k;&c_a;&c_n;&c_t;&c_r;&c_o;&c_l;&c_mol;</trd>
    </trdgrp>
    <trd lng="de">Inspektion</trd>
  </snc>
  <snc mrk="inspek.0o.KOMUNE">
    <dif>
      Garda prizorgado kaj kontrolado:
      <ekz>
        anka&ubreve; <nom>Ester</nom> estis prenita en la re&gcirc;an domon sub la
        <tld/>on de <nom>Hegaj</nom>, la gardisto de la virinoj
        <fnt><bib>MT</bib>, <lok>&Est; 2:8</lok></fnt>;
      </ekz>
      <ekz>
        <ind>esti prenita sub ies <tld/>on</ind>
        <klr>(esti <ref cel="konfid.0i.pro_honesteco">konfidita</ref> al
        tiu)</klr>;
        <trd lng="fr">&ecirc;tre <ind>confi&eacute;</ind> &agrave; qn</trd>
        <trd lng="hu">fel&uuml;gyelet al&aacute; vesz</trd>
      </ekz>
      <ekz>
        maljuna tombistino, al kiu estis komisiita la
        <tld/>ado super la granda florvarmejo de la Morto
        <fnt><bib>Fab3</bib>, <lok>Historio de unu patrino</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="zorg.0o.peno">zorgo<sncref/></ref>,
      <ref cel="rigard.super0o.kontrolo">superrigardo<sncref/></ref>
    </refgrp>
    <trd lng="be">&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;</trd>
    <trdgrp lng="de">
      <trd>Aufsicht</trd>,
      <trd>Obhut</trd>
    </trdgrp>
    <trd lng="fa">&a_b;&a_A;&a_z;&a_r;&a_s;&f_y;</trd>
    <trdgrp lng="fr">
      <trd>inspection</trd>,
      <trd>surveillance</trd>
    </trdgrp>
    <trd lng="hu">fel&uuml;gyelet</trd>
    <trdgrp lng="zh">
    <trd>&#31649;&#21046; <pr>gu&#462;nzh&igrave;</pr></trd>,
    <trd>&#26816;&#26597; <pr>ji&#462;nch&aacute;</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="ca">
    <trd>inspecci&oacute;</trd>,
    <trd>supervisi&oacute;</trd>,
    <trd>control</trd>,
    <trd>examen</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#26619;&#23519;  <pr>&#12373;&#12373;&#12388;</pr></trd>,
    <trd>&#26908;&#26619;  <pr>&#12369;&#12435;&#12373;</pr></trd>,
    <trd>&#30435;&#26619;  <pr>&#12363;&#12435;&#12373;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>nadzorowanie</trd>,
    <trd>kontrolowanie</trd>,
    <trd>lustrowanie</trd>,
    <trd>dogl&aogonek;danie</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;</trd>,
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_je;&c_k;&c_c;&c_ib;&c_ja;</trd>
  </trdgrp>
</drv>

<drv mrk="inspek.0anto">
  <kap><tld/>anto, <var><kap><tld/>isto</kap></var></kap>
  <snc mrk="inspek.0anto.KOMUNE">
    <dif>
      Oficisto komisiita por <tld/>i;
      <ref tip="sin" cel="inspek1.0o">inspektoro</ref>:
      <ekz>
        la Izraelidoj havis <klr>[...]</klr> siajn <tld/>istojn,
        kiuj servis al la re&gcirc;o pri &ccirc;iuj aferoj de la aparta&jcirc;oj
        <fnt><bib>MT</bib>, <lok>&Kr1; 27:1</lok></fnt>.
      </ekz>
      <ekz>
        mi mem administras la bienon kaj imagu, mia <tld/>isto
        <nom>Erofej</nom> estas rimarkinda
        tipo
        <fnt>
          <bib>PatrojFiloj</bib>
        </fnt>;
      </ekz>
      <ekz>
        ili havas anka&ubreve; tuj la plej belan fulmotondron
        <klr>(&ccirc;agrenon)</klr> kun la <tld/>istoj
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Postnikov</nom> estis <tld/>isto de la fervojoj
        <fnt>
          <bib>LOdE</bib>
          <lok>2000, No 7 (69)</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_e;&c_k;&c_t;&c_a;&c_r;</trd>,
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;&c_a;&c_l;&c_mol;&c_n;&c_ib;&c_k;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>inspector</trd>,
    <trd>controlador</trd>,
    <trd>supervisor</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>inspektor</trd>,
    <trd>&uacute;&rcaron;edn&iacute; dozorce</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Inspektor</trd>,
    <trd>Pr&uuml;fer</trd>,
    <trd>&Uuml;berwacher</trd>,
    <trd>Beschauer</trd>,
    <trd>Kontrolleur</trd>
  </trdgrp>
  <trd lng="es">inspector</trd>
  <trd lng="fa">&a_b;&a_A;&a_z;&a_r;&a_s;</trd>
  <trdgrp lng="fr">
    <trd>inspecteur</trd>,
    <trd>contr&ocirc;leur</trd>,
    <trd>superviseur</trd>
  </trdgrp>
  <trd lng="hu">fel&uuml;gyel&odblac;</trd>
  <trdgrp lng="ja">
    <trd>&#26619;&#23519;&#23448;  <pr>&#12373;&#12373;&#12388;&#12363;&#12435;</pr></trd>,
    <trd>&#26908;&#26619;&#23448;  <pr>&#12369;&#12435;&#12373;&#12363;&#12435;</pr></trd>,
    <trd>&#30435;&#26619;&#24441;  <pr>&#12363;&#12435;&#12373;&#12420;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="nl">inspecteur</trd>
  <trdgrp lng="pl">
    <trd>nadzorca</trd>,
    <trd>kontroler</trd>,
    <trd>wizytator</trd>,
    <trd>dozorca</trd>
  </trdgrp>
  <trd lng="pt">inspetor</trd>
  <trdgrp lng="ru">
    <trd>&c_i;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_o;&c_r;</trd>,
    <trd>&c_n;&c_a;&c_d;&c_z;&c_i;&c_r;&c_a;&c_t;&c_je;&c_l;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>dohliada&ccaron;</trd>,
    <trd>dozorca</trd>,
    <trd>in&scaron;pektor</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_je;&c_k;&c_t;&c_o;&c_r;</trd>,
    <trd>&c_n;&c_a;&c_g;&c_l;&c_ja;&c_d;&c_a;&c_ch;</trd>,
    <trd>&c_ib;&c_n;&c_s;&c_p;&c_ib;&c_c;&c_ib;&c_jeu;&c_n;&c_t; (&c_z;&c_v;&c_a;&c_n;&c_n;&c_ja;
    &c_s;&c_je;&c_r;&c_je;&c_d;&c_n;&c_mol;&c_o;&c_g;&c_o;
    &c_ch;&c_i;&c_n;&c_o;&c_v;&c_n;&c_i;&c_k;&c_a;)</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#30417;&#30563;&#21592; <pr>ji&amacron;nd&#363;yu&aacute;n</pr></trd>,
    <trd>&#30417;&#23519;&#21592; <pr>ji&amacron;nch&aacute;yu&aacute;n</pr></trd>,
    <trd>&#26816;&#23519;&#21592; <pr>ji&#462;nch&aacute;yu&aacute;n</pr></trd>,
    <trd>&#35222;&#23519;&#21729; <pr>sh&igrave;ch&aacute;yu&aacute;n</pr></trd>,
    <trd>&#39640;&#32026;&#23448;&#21729; <pr>g&amacron;oj&iacute;gu&amacron;nyu&aacute;n</pr></trd>,
    <trd>&#26816;&#39564;&#21592; <pr>ji&#462;ny&agrave;nyu&aacute;n</pr></trd>,
    <trd>&#30417;&#21028;&#21592; <pr>ji&amacron;np&agrave;nyu&aacute;n</pr></trd>,
    <trd>&#30435;&#23457;&#21729; <pr>ji&amacron;nsh&ecaron;nyu&aacute;n</pr></trd>
  </trdgrp>
</drv>
</art>
