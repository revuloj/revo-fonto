<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: burg.xml,v 1.15 2026/08/15 10:38:20 revo Exp $">
<kap>
  <rad>burg</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="burg.0o">
  <kap><tld/>o</kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="burg.0o.ARKI">
    <uzo tip="fak">ARKI</uzo>
    <dif>
      Mezepoka fortikigita lo&gcirc;loko, &scirc;irmata de <ref tip="prt" cel="mur.0ego">murego</ref>;
      <ref tip="sin" cel="kastel.0o.MIL">kastelo<sncref/></ref>:
      <ekz>
        la flamoj atingis la <tld/>on, konstruitan en la 14a jarcento kiel gotika
        fortika&jcirc;o apud la slovaka urbo <nom>Ro&zcaron;&ncaron;ava</nom>
        <fnt>
          <bib>Monato</bib>
          <aut>Julius Hauser</aut>
          <vrk><url ref="&Monato;/2012/010669.php">Burgo bruligita</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        se oni alvenas el sudo, oni vidas <klr>[&#8230;]</klr> la <tld/>on <nom>&Scirc;pilberk</nom>
        <fnt>
          <bib>Monato</bib>
          <aut>Miroslav Hru&scaron;ka</aut>
          <vrk><url ref="&Monato;/2013/011042.php">Brno</url></vrk>
          <lok>2013</lok>
        </fnt>;
      </ekz>
      <ekz>
        la mezepoka <tld/>o de dukoj de <nom>Saint-Omer</nom>
        <fnt><aut>E. de Zilah</aut>, <vrk>Vivi sur barko</vrk>,
        <lok>1994</lok></fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="citade.0o">citadelo</ref>
    <rim>
      Alie ol ordinara <ref tip="super" cel="fortik.0ajxo">fortika&jcirc;o</ref>,
      <tld/>o servas unuavice por lo&gcirc;ado, ne por militaj celoj, sed &gcirc;i ne estas
      reprezentejo kiel <ref cel="kastel.0o.palaco">kastelo<sncref/></ref>.
      La vorto retrovi&gcirc;as ofte en urbonomo, ekz-e <ref cel="auxgsburg.0o">A&ubreve;gsburgo</ref>,
      <ref cel="peterburg.0o">Peterburgo</ref> k.a.
    </rim>
    <bld lok="&WCU;/thumb/b/bf/Burghausen_-_Hauptburg_(1).JPG/500px-Burghausen_-_Hauptburg_(1).JPG"
    prm="CC BY-SA 4.0"><tld/>o de la dukurbo Burghausen, Bavarujo
        <fnt>
          <aut>Bwag, propra verko</aut>
          <lok><url
          ref="&WCW;/File:Burghausen_-_Hauptburg_(1).JPG">&WCW;/File:Burghausen_-_Hauptburg_(1).JPG</url></lok>
        </fnt>
    </bld>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru (fortikigita) <ke>kastelo</ke>, <ke>fortika&jcirc;o</ke>.
  </rim>

  <trd lng="be">&c_z;&c_a;&c_m;&c_a;&c_k;</trd>
  <trdgrp lng="cs">
    <trd>m&ecaron;ste&ccaron;ko</trd>,
    <trd>opevn&ecaron;n&yacute; hrad</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Burg</trd>,
  </trdgrp>
  <trdgrp lng="en">
    <trd>burg</trd>,
    <trd>fortified city</trd>
  </trdgrp>
  <trd lng="fr">place forte</trd>
  <trd lng="he">&tet;&yod;&resh;&he; &mem;&bet;&vav;&tsadi;&resh;&tav;</trd>
  <trd lng="nl">burcht</trd>
  <trd lng="no">borg</trd>
  <trd lng="pl">twierdza</trd>
  <trd lng="sk">hradn&yacute; ka&scaron;tie&lcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_z;&c_a;&c_m;&c_o;&c_k;</trd>,
    <trd>&c_s;&c_je;&c_r;&c_je;&c_d;&c_n;&c_mol;&c_o;&c_v;&c_ib;&c_ch;&c_n;&c_je; &c_m;&c_ib;&c_s;&c_t;&c_o;</trd>,
    <trd>&c_m;&c_ib;&c_s;&c_t;&c_je;&c_ch;&c_k;&c_o;</trd>
  </trdgrp>
</drv>
</art>

