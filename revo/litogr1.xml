<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: litogr1.xml,v 1.27 2026/11/15 16:00:20 revo Exp $">
<kap>
  <ofc>8</ofc>
  <rad>litografi</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="litogr1.0o">
  <kap><tld/>o</kap>
  <snc mrk="litogr1.0o.TIP">
    <uzo tip="fak">TIP</uzo>
    <dif>
      Procedo de <ref tip="super" cel="pres.0arto.TIP">presarto</ref>,
      en kiu oni premas &scirc;tongravura&jcirc;on al surfaco por produkti
      bildon a&ubreve; tekston:
      <ekz>
        la <tld/>o estis inventita de <nom>Alois Senefelder</nom> en
        1796 en Germanio kaj 
        estas prestekniko senreliefa, kiu ebligas kreon kaj reprodukton 
        multekzempleran de desegno per inko
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=18815">Presarto</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        en 1906 <nom>Schneeberger</nom> eldonis stenografian gazeton
        &leftquot;Flugila Plumo&rightquot;, unue hektografite, poste en <tld/>o, de post
        numero 4
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=19339">Stenografio</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="litogr1.0o.bildo">
    <uzo tip="fak">TIP</uzo>
    <dif>
      <ref tip="dif" cel="litogr.0ajxo">Litografa&jcirc;o</ref>:
      <ekz>
        <tld/>o de la re&gcirc;ino <nom>Nzinga</nom> dum la interkonsentoj de
        paco kun la portugala reganto en 1657
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=58">Angolo</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="litogr1.0o.elektroniko">
    <uzo tip="fak">ELET</uzo>
    <uzo tip="fak">KOMP</uzo>
    <dif>
       Procedo uzata en la produktado de <ref cel="cirkvi.integra_0o">integraj cirkvitoj</ref>, 
       dum kiu oni preparas la kli&scirc;on (maskon) per surradiado de lumo,
       jonoj a&ubreve; elektronoj:
      <ekz>
        <ind>foto<tld/>o</ind>;
        <trd lng="ca">fotolitografia</trd>
        <trd lng="en">photolithography</trd>
        <trd lng="es">fotolitograf&iacute;a</trd>
        <trd lng="fr">photolithographie</trd>  
      </ekz>
      <ekz>
        jon<tld/>o;
      </ekz>
      <ekz>
        elektron<tld/>o;
      </ekz>
      <ekz>
        elektronaj faskoj uzi&gcirc;as por veldado, <tld/>o kaj elektronaj
        mikroskopoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=1055">Elektrono</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>&scirc;tonpresarto</ke>, <ke>&scirc;tonpresa&jcirc;o</ke>.
  </rim>

  <trd lng="be">&c_l;&c_ib;&c_t;&c_a;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja;</trd>
  <trd lng="bg">&c_l;&c_i;&c_t;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trd lng="ca">litografia</trd>
  <trdgrp lng="cs">
    <trd>kamenotisk <klr>(um&ecaron;n&iacute;)</klr></trd>,
    <trd>litografie</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Lithographie</trd>,
    <trd>Lithografie</trd>,
    <trd>Steindruck</trd>
  </trdgrp>
  <trd lng="el">&lambda;&jota;&theta;&omikron;&gamma;&rho;&alfa;&phi;&jota_ton;&alfa;</trd>
  <trd lng="es">litograf&iacute;a</trd>
  <trd lng="fr">lithographie<klr tip="amb"> (proc&eacute;d&eacute;)</klr></trd>
  <trdgrp lng="hu">
    <trd>k&odblac;nyomat</trd>,
    <trd>k&odblac;rajz</trd>,
    <trd>litogr&aacute;fia</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#30707;&#29256;&#21360;&#21047;  <pr>&#12379;&#12365;&#12400;&#12435;&#12356;&#12435;&#12373;&#12388;</pr></trd>,
    <trd>&#12522;&#12488;&#12464;&#12521;&#12501;&#12451;&#12540;</trd>
  </trdgrp>
  <trd lng="nl">steendrukkunst</trd>
  <trd lng="pl">litografia</trd>
  <trd lng="pt">litografia</trd>
  <trd lng="ro">litografie</trd>
  <trd lng="ru">&c_l;&c_i;&c_t;&c_o;&c_g;&c_r;&c_a;&c_f;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>kame&ncaron;otla&ccaron; <klr>(umenie)</klr></trd>,
    <trd>litografia</trd>
  </trdgrp>
  <trd lng="uk">&c_l;&c_ib;&c_t;&c_o;&c_g;&c_r;&c_a;&c_f;&c_ib;&c_ja; (&c_s;&c_p;&c_o;&c_s;&c_ib;&c_b;)</trd>
  <trdgrp lng="zh">
    <trd>&#30707;&#29256;&#21360;&#21047;&#26415; <pr>sh&iacute;b&#462;ny&igrave;nshu&agrave;sh&ugrave;</pr></trd>,
    <trd>&#30707;&#29256;&#21360;&#21047;&#34899; <pr>sh&iacute;b&#462;ny&igrave;nshu&agrave;sh&ugrave;</pr></trd>,
    <trd>&#24179;&#21360; <pr>p&iacute;ngy&igrave;n</pr></trd>,
    <trd>&#24179;&#21360;&#26415; <pr>p&iacute;ngy&igrave;nsh&ugrave;</pr></trd>,
    <trd>&#24179;&#21360;&#34899; <pr>p&iacute;ngy&igrave;nsh&ugrave;</pr></trd>,
    <trd>&#30707;&#21360; <pr>sh&iacute;y&igrave;n</pr></trd>
  </trdgrp>
</drv>
</art>
