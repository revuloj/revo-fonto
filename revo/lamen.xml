<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: lamen.xml,v 1.30 2026/11/26 08:52:03 revo Exp $">
<kap>
  <ofc>4</ofc>
  <rad>lamen</rad>/o
  <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="lamen.0o">
  <kap>
    <tld/>o
  </kap>
  <snc>
    <dif>
      Mallar&gcirc;a, tre maldika, plejofte metala plato:
      <ekz>
        &scirc;tala, ligna <tld/>o;
      </ekz>
      <ekz>
        gravuri sur bronzaj <tld/>oj, por ke ili restu en la eterna memoro
        <fnt>
          <bib>DKM</bib>
          <lok>&Ccirc;apitro LXII</lok>
        </fnt>;
      </ekz>
      <ekz>
        elektra hejtilo, kovrita per truita <tld/>o
        <fnt>
          <bib>VaK</bib>
          <lok>Dua &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        oni vidis rekte en la grandan <tld/>ejon, tie la feroj movis sin tien kaj reen
        kiel ru&gcirc;aj serpentegoj
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la gejunuloj estas materialo el kiu formi&gcirc;as for&gcirc;istoj, &ccirc;arpentistoj, <tld/>istoj
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        tondra bruo de gigantaj <tld/>iloj kaj &ccirc;iea tintego de fero kontra&ubreve; fero vekis
        en li ian senton de dan&gcirc;ero
        <fnt>
          <bib>Tor</bib>
          <lok>III.</lok>
        </fnt>;
      </ekz>
      <ekz>
        helikoptera kra&scirc;o pro rompo de rotora <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Albisturo Kvinke</aut>
          <vrk><url ref="&Monato;/2012/010437.php">Usonangla, &ccirc;u efika mondolingvo?</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        moneroj estas amasproduktataj <klr>[&#x2026;]</klr> uzante rondajn, malplenajn diskojn
        eltran&ccirc;itajn el latuna <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>DJ Cane</aut>
          <vrk><url ref="&Monato;/2012/010564.php">Monfalsada ekonomio</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        balen<tld/>o <klr>(vd <ref cel="balen.0ajxo">balena&jcirc;o</ref>)</klr>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La samforman sub&ccirc;apelan organon de fungoj, <fnt><bib>PIV1</bib></fnt> nomas per
    aparta vorto &leftquot;lamel&middot;o&rightquot;.
    <aut>Wolfram Diestel</aut>
  </rim>
  <trdgrp lng="be">
    <trd>&c_p;&c_l;&c_a;&c_s;&c_mol;&c_c;&c_ib;&c_n;&c_a;</trd>,
    <trd>&c_p;&c_l;&c_ib;&c_t;&c_a; <klr tip="amb">(&c_t;&c_o;&c_n;&c_k;&c_a;&c_ja;)</klr></trd>,
    <trd>&c_l;&c_ib;&c_s;&c_t; <klr tip="amb">(&c_m;&c_e;&c_t;&c_a;&c_l;&c_jo;&c_v;&c_y; &c_ib; &c_d;&c_a;
    &c_g;.&c_p;.)</klr></trd>,
    <trd>&c_a;&c_r;&c_k;&c_u;&c_sh; <klr tip="amb">(&c_m;&c_e;&c_t;&c_a;&c_l;&c_jo;&c_v;&c_y; &c_ib; &c_d;&c_a;
    &c_g;.&c_p;.)</klr></trd>
  </trdgrp>
  <trd lng="ca">l&agrave;mina</trd>
  <trdgrp lng="de">
    <trd>Lamelle</trd>,
    <trd>Blatt <klr>(Metall)</klr></trd>,
    <trd>Pl&auml;ttchen</trd>,
    <trd>Sch&uuml;ppchen</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>lamina</trd>,
    <trd>plate</trd>,
    <trd>layer</trd>
  </trdgrp>
  <trd lng="es">l&aacute;mina</trd>
  <trd lng="fr">lamelle</trd>
  <trd lng="hu">lemez</trd>
  <trdgrp lng="id">
    <trd>pelat</trd>,
    <trd>lempeng</trd>,
    <trd>lamela</trd>,
    <trd>laminasi</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x8584;&#x7247;  <pr>&#x306F;&#x304F;&#x3078;&#x3093;</pr></trd>,
    <trd>&#x8584;&#x677F;  <pr>&#x3046;&#x3059;&#x3044;&#x305F;</pr></trd>,
    <trd>&#x8584;&#x5C64;  <pr>&#x306F;&#x304F;&#x305D;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="nl">lamel</trd>
  <trdgrp lng="pl">
    <trd>lamela</trd>,
    <trd>p&lstroke;ytka</trd>,
    <trd>blaszka</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>l&acirc;mina</trd>,
    <trd>chapa</trd>,
    <trd>placa</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_p;&c_l;&c_a;&c_s;&c_t;&c_i;&c_n;&c_a;</trd>,
    <trd>&c_l;&c_i;&c_s;&c_t; <klr>(&c_m;&c_je;&c_t;&c_a;&c_l;&c_l;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;, &c_f;&c_a;&c_n;&c_je;&c_r;&c_n;&c_y;&c_j; &c_i;
    &c_t;.&c_p;.)</klr></trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd><klr>(&c_t;&c_o;&c_n;&c_k;&c_a;)</klr> &c_p;&c_l;&c_a;&c_s;&c_t;&c_i;&c_n;&c_k;&c_a;</trd>,
    <trd>&c_t;&c_o;&c_n;&c_k;&c_i;&c_j; &c_sh;&c_a;&c_r;</trd>,
    <trd>&c_l;&c_i;&c_s;&c_t; <klr>(&c_m;&c_je;&c_t;&c_a;&c_l;&c_je;&c_v;&c_i;&c_j;, &c_f;&c_a;&c_n;&c_je;&c_r;&c_n;&c_i;&c_j;, &c_sh;&c_i;&c_f;&c_je;&c_r;&c_n;&c_i;&c_j; &c_ib;
    &c_t;.&c_p;.)</klr></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8584;&#x5C42; <pr>b&aacute;oc&eacute;ng</pr></trd>,
    <trd>&#x8584;&#x5C64; <pr>b&aacute;oc&eacute;ng</pr></trd>,
    <trd>&#x8584;&#x677F; <pr>b&aacute;ob&#x1CE;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="lamen.0igi">
  <kap>
    <tld/>igi
  </kap>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      Platigi en <tld/>ojn a&ubreve; foliojn.
    </dif>
    <ref tip="sin" cel="lamin.0i">lamini</ref>
  </snc>
  <rim>
    <fnt><bib>PIV1</bib></fnt> pli malpli sinonime registras ankora&ubreve; &leftquot;laminat&middot;i:
    transformi, per ~iloj, metalan blokon en pli-malpli maldikan ladon a&ubreve;
    stangon". Dume <nom>E. W&uuml;ster</nom> donas sensufikse: &leftquot;lamen&middot;i&rightquot; (8561, de: <nac>walzen
    (Eisen)</nac>, hu: <nac>hengerel</nac>) kun pliaj deriva&jcirc;oj lamen&middot;ad&middot;ej&middot;o, lamen&middot;it&middot;a fero, tubo
    k.a.
    <aut>Wolfram Diestel</aut>
  </rim>
  <trd lng="be">&c_r;&c_a;&c_s;&c_k;&c_a;&c_ch;&c_v;&c_a;&c_c;&c_mol; <klr>(&c_u; &c_a;&c_r;&c_k;&c_u;&c_sh;)</klr></trd>
  <trd lng="ca">laminar<klr> (v.)</klr></trd>
  <trdgrp lng="de">
     <trd><klr>in </klr>d&uuml;nne Pl&auml;ttchen <ind>aufspalten</ind></trd>,
     <trd><klr>in </klr>d&uuml;nne Schichten <ind>aufspalten</ind></trd>,
     <trd>Folien auswalzen</trd>,
     <trd>Folien schlagen</trd>
  </trdgrp>
  <trd lng="en">laminate</trd>
  <trd lng="es">laminar</trd>
  <trdgrp lng="hu">
     <trd>lap&iacute;t</trd>,
     <trd>lemezz&eacute; alak&iacute;t</trd>
  </trdgrp>
  <trd lng="id"><baz>laminasi</baz>melaminasi</trd>
  <trdgrp lng="ja">
    <trd>&#x8584;&#x7247;&#x306B;&#x3059;&#x308B;  <pr>&#x3046;&#x3059;&#x304B;&#x305F;&#x306B;&#x3059;&#x308B;</pr></trd>,
    <trd>&#x5727;&#x5EF6;&#x3059;&#x308B;  <pr>&#x3042;&#x3064;&#x3048;&#x3093;&#x3059;&#x308B;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>lamineren</trd>,
    <trd>pletten</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>lamelowa&cacute;</trd>,
    <trd>rozklepa&cacute; na blach&eogonek;</trd>,
    <trd>walcowa&cacute; blach&eogonek;</trd>
  </trdgrp>
  <trd lng="pt">laminar</trd>
  <trd lng="ru">&c_r;&c_a;&c_s;&c_k;&c_a;&c_t;&c_y;&c_v;&c_a;&c_t;&c_mol; <klr>(&c_v; &c_t;&c_o;&c_n;&c_k;&c_i;&c_j;
  &c_l;&c_i;&c_s;&c_t;)</klr></trd>
  <trd lng="uk">&c_r;&c_o;&c_z;&c_k;&c_a;&c_ch;&c_u;&c_v;&c_a;&c_t;&c_i; <klr>(&c_u; &c_t;&c_o;&c_n;&c_k;&c_i;&c_j; &c_l;&c_i;&c_s;&c_t;)</klr></trd>
</drv>
</art>
