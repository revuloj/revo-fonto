<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: elektroforez.xml,v 1.1 2026/11/21 19:45:16 afido Exp $">
    <kap>
      <rad>elektroforez</rad>/o
      <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="elektroforez.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      Analizometodo eluzanta diversajn rapidojn de &scirc;argitaj eroj en elektra kampo:
      <ekz>
        povas helpi dum diagnozado <klr>[diferenciga]</klr> la nerekta imunfluoreskado
        kaj <tld/>o
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Elektrophorese</trd>
    <trd lng="en">electrophoresis</trd>
    <trd lng="fr">&eacute;lectrophor&egrave;se</trd>
    <trd lng="ru">&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_f;&c_o;&c_r;&c_je;&c_z;</trd>
    <trd lng="uk">&c_je;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_f;&c_o;&c_r;&c_je;&c_z;</trd>
  </snc>
</drv>

<drv mrk="elektroforez.0ajxo">
  <kap>
    <tld/>a&jcirc;o
  </kap>
  <snc>
    <dif>
      Rezulto de <tld/>o:
      <ekz>
        la karaktero de <tld/>a&jcirc;o indikas al la peptida naturo de tiuj substancoj
        <fnt>
          <bib>SR</bib>
          <aut>B. V. Tokarev</aut>
          <vrk>Formi&gcirc;o de l'aminacidoj dum interago de dioksido de karbono kun amoniakato de kalcio</vrk>
          <lok>Scienca Revuo, nro 108/1974</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>Elektropherogramm</trd>,
    <trd>Bandenmuster</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>electropherogram</trd>,
    <trd>banding pattern</trd>
  </trdgrp>
  <trd lng="fr">&eacute;lectroph&eacute;rogramme</trd>
</drv>

  </art>


