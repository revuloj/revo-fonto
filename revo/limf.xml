<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: limf.xml,v 1.35 2026/08/07 17:07:09 revo Exp $">
<kap>
  <ofc>9</ofc><rad>limf</rad>/o <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="limf.0o">
  <kap><ofc>9</ofc><tld/>o</kap>
  <snc mrk="limf.0o.ZOO">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Flaveta a&ubreve; senkolora likva&jcirc;o formi&gcirc;anta el hista flua&jcirc;o
      kaj forkondukata tra <tld/>ujoj al la venoj.
      <ekz>
        <tld/>o <klr>[&#8230;]</klr> produkti&gcirc;as pro la troa likvo kiu eliras de la sangaj
        kapilaroj al la inter&ccirc;ela a&ubreve; interhista spaco, kaj estas kolektita de la
        <tld/>aj kapilaroj, kiuj drenas al <tld/>aj vaskuloj pli dikaj &gcirc;is konver&gcirc;i
        en duktoj kiuj flu<klr>[ig]</klr>as <klr>[&gcirc;in]</klr> en la subklaviajn vejnojn
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=2455"
              >Kardiovaskula sistemo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="hxil.0o">&hcirc;ilo</ref>
    <trd lng="be">&c_l;&c_ib;&c_m;&c_f;&c_a;</trd>
    <trd lng="ca">limfa</trd>
    <trd lng="de">Lymphe</trd>
    <trd lng="el">&lambda;&ypsilon_ton;&my;&phi;&eta;</trd>
    <trd lng="en">lymph</trd>
    <trd lng="es">linfa</trd>
    <trd lng="fr">lymphe</trd>
    <trd lng="hu">nyirok</trd>
    <trd lng="id">limfa</trd>
    <trd lng="la">lympha</trd>
    <trd lng="nl">lymfevocht</trd>
    <trd lng="pl">limfa</trd>
    <trd lng="pt">linfa</trd>
    <trd lng="ru">&c_l;&c_i;&c_m;&c_f;&c_a;</trd>
    <trdgrp lng="zh">
      <trd>&#x6DCB;&#x5DF4; <pr>l&iacute;nb&amacron;</pr></trd>,
      <trd>&#x6DCB;&#x5DF4;&#x6DB2; <pr>l&iacute;nb&amacron;y&egrave;</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="limf.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      Akveca suko, cirkulanta en vegeta&jcirc;oj; <ref tip="sin" cel="sev.0o">sevo</ref>:
      <ekz>
        ci vidos la <tld/>on suprenrampi la&ubreve; la trunko
        de la plantoj
        <fnt>
          <aut>V. Catal&agrave;, trad. J. Ventura i Freixas</aut>,
          <vrk>Soleco</vrk>,
          <lok>1967</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_s;&c_o;&c_k; <klr tip="amb">(&c_u; &c_r;&c_a;&c_s;&c_mol;&c_l;&c_ib;&c_n;&c_je;)</klr></trd>
    <trd lng="ca">saba</trd>
    <trdgrp lng="de">
      <trd>Pflanzensaft</trd>,
      <trd>Baumsaft</trd>,
      <trd>Xylemsaft</trd>,
      <trd>Phloemsaft</trd>
    </trdgrp>
    <trd lng="en">sap</trd>
    <trd lng="fr">s&egrave;ve</trd>
    <trd lng="id">getah</trd>
    <trd lng="pt">seiva</trd>
    <trdgrp lng="zh">
      <trd>&#x6D25;&#x6CFD; <pr>j&imacron;nz&eacute;</pr></trd>,
      <trd>&#x6D25;&#x6FA4; <pr>j&imacron;nz&eacute;</pr></trd>,
      <trd>&#26641;&#x6DB2; <pr>sh&ugrave;y&egrave;</pr></trd>,
      <trd>&#x6A39;&#x6DB2; <pr>sh&ugrave;y&egrave;</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="it">linfa</trd>
  <trd lng="ja">&#x30EA;&#x30F3;&#x30D1;  <pr>&#x308A;&#12435;&#12401;</pr></trd>
  <trd lng="uk">&c_l;&c_ib;&c_m;&c_f;&c_a;</trd>
</drv>

<drv mrk="limf.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Rilatanta al <tld/>o a&ubreve; enhavanta <tld/>on.
      <ekz>
        la primara lokalizado de la virusoj estas epitelio kaj <tld/>a histo de la
        faringo
        <fnt>
          <bib>Monato</bib>
          <aut>Vladimir Lemelev</aut>
          <vrk><url ref="&Monato;/2011/010269.php"
              >Poliomjelito: &ccirc;u la dua tutmonde likvidota infektmalsano?</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Rousseff</nom> sukcese batalis kontra&ubreve; <tld/>a kancero, kiu trafis &scirc;in
        <fnt>
          <bib>Monato</bib>
          <aut>Jozefo Lej&ccirc;</aut>
          <vrk><url ref="&Monato;/2011/010219.php"
              >Lulita de la anta&ubreve;ulo</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz>
      <ekz>
        ke remado ebligas naturan <tld/>an drenadon kaj plifortigas muskolojn
        <fnt>
          <bib>Monato</bib>
          <aut>Christian Bertin</aut>
          <vrk><url ref="&Monato;/2015/011437.php"
              >Remado-rimedo</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">limf&agrave;tic</trd>
    <trdgrp lng="de">
      <trd>lymphatisch</trd>,
      <trd>Lymph-</trd>
    </trdgrp>
    <trd lng="en">lymphatic</trd>
    <trdgrp lng="hu">
      <trd>nyirok-</trd>,
      <trd>limfatikus</trd>,
      <trd>limfo-</trd>
    </trdgrp>
    <trd lng="pl">limfatyczny</trd>
    <trd lng="ru">&c_l;&c_i;&c_m;&c_f;&c_a;&c_t;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;</trd>
  </snc>
  <trd lng="be">&c_l;&c_ib;&c_m;&c_f;&c_a;&c_t;&c_y;&c_ch;&c_n;&c_y;</trd>
  <trd lng="el">&lambda;&ypsilon;&my;&phi;&alfa;&tau;&jota;&kappa;&omikron_ton;&sigma_fina;</trd>
  <trd lng="fr">lymphatique</trd>
  <trdgrp lng="id">
    <trd>limfatik</trd>,
    <trd>... <ind>limfa</ind></trd>
  </trdgrp>
  <trd lng="it">linfatico</trd>
  <trd lng="pt">linf&aacute;tico</trd>
  <trd lng="uk">&c_l;&c_ib;&c_m;&c_f;&c_a;&c_t;&c_i;&c_ch;&c_n;&c_i;&c_j;</trd>
</drv>

<drv mrk="limf.0ujo">
  <kap><tld/>ujo, <var><kap><tld/>a angio</kap></var></kap>
  <snc mrk="limf.0ujo.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Organa tubo, <ref tip="super" cel="angi.0o">angio</ref> kiu
      forkondukas la <tld/>on el la histoj al la vejnoj:
      <ekz>
        <nom>Rudbeck</nom> <klr>[&#8230;]</klr> fami&gcirc;is jam 21-jara pro eltrovo de <tld/>ujoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=161837"
              >Olof Rudbeck</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        malgrandaj sangaj kaj <tld/>aj angioj en la tega&jcirc;o de la maldika intesto
        kondukas la nutra&jcirc;on al la tuta korpo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=856"
              >Digesta sistemo</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_l;&c_ib;&c_m;&c_f;&c_a;&c_t;&c_y;&c_ch;&c_n;&c_a;&c_ja; <ind>&c_s;&c_u;&c_d;&c_z;&c_ib;&c_n;&c_a;</ind></trd>
  <trd lng="ca">vas limf&agrave;tic</trd>
  <trd lng="de">Lymphgef&auml;&szlig;</trd>
  <trd lng="es">vaso linf&aacute;tico</trd>
  <trd lng="fr">vaisseau lymphatique</trd>
  <trd lng="hu">nyirok&eacute;r</trd>
  <trd lng="id"><baz>buluh</baz>pembuluh limfa</trd>
  <trd lng="it"><ind>vaso</ind> linfatico</trd>
  <trd lng="nl">lymfevaten</trd>
  <trd lng="pl">naczynie limfatyczne</trd>
  <trd lng="pt">vaso linf&aacute;tico</trd>
  <trd lng="ru">&c_l;&c_i;&c_m;&c_f;&c_a;&c_t;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j; &c_s;&c_o;&c_s;&c_u;&c_d;</trd>
  <trdgrp lng="zh">
    <trd>&#x6DCB;&#x5DF4;&#x7CFB;&#x7D71; <pr>l&iacute;nb&amacron;x&igrave;t&#x1D2;ng</pr></trd>,
    <trd>&#x6DCB;&#x5DF4;&#x7CFB;&#x7EDF; <pr>l&iacute;nb&amacron;x&igrave;t&#x1D2;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="limf.0a_vazo">
  <kap><tld/>a vazo</kap>
  <uzo tip="stl">EVI</uzo>
  <ref tip="dif" cel="limf.0ujo"><tld/>a angio</ref>
  <trd lng="id"><baz>buluh</baz>pembuluh limfa</trd>
  <trd lng="ja">&#x30EA;&#x30F3;&#x30D1;&#x7BA1;  <pr>&#x30EA;&#x30F3;&#x30D1;&#x304B;&#12435;</pr></trd>
</drv>

</art>
