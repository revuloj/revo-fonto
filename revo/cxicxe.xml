<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: cxicxe.xml,v 1.25 2026/09/22 16:52:46 revo Exp $">
<kap>
  <rad>&ccirc;i&ccirc;eron</rad>/o
  <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="cxicxe.0o">
  <kap><tld/>o</kap>
  <snc mrk="cxicxe.0o.gvidisto">
    <dif>
      <ref tip="dif" cel="gvid.0isto.TUR">Gvidisto</ref> por
      turistoj, vizitantoj de muzeo ktp:
      <ekz>
        <tld/>o gvidis nin dum nia vizito al la kastelo kaj &gcirc;ia
        bela intermura &gcirc;ardeno
        <fnt><aut>W. H. Simcock</aut>:
        <vrk>Vizito
        al la nordaj insuloj</vrk>,
        <bib>Monato</bib><lok>jaro 1999a, numero 9a,
        p. 18a</lok></fnt>;
      </ekz>
      <ekz>
        ni volontulas en la Muzeo kiel <tld/>oj
        <fnt>
          <bib>Kon11</bib>
          <lok>Ni, pacemaj indoneziaj formikoj (Elsy Luciana)</lok>
        </fnt>;
      </ekz>
      <ekz>
        en gazetaj anoncoj ofte estas proponataj la servoj de belaj <tld/>inoj, kiuj
        akompanos gastojn al hoteloj
        <fnt>
          <bib>Monato</bib>
          <aut>last</aut>
          <vrk><url ref="&Monato;/2007/009316.php"
              >&Scirc;an&gcirc;i&gcirc;u nia propra sinteno</url></vrk>
          <lok>2007</lok>
        </fnt>;
      </ekz>
      <ekz>
        la biciklanta karavano <klr>[&#x2026;]</klr> vizitis la Sanktan Tombon, kie loka
        gardisto-<tld/>o kura&gcirc;igis ilin da&ubreve;rigi sian paco-anoncadon per pilgrima
        vizito al la Sanktaj Lokoj
        <fnt>
          <bib>Monato</bib>
          <aut>Armando Zecchin</aut>
          <vrk><url ref="&Monato;/2007/009125.php"
              >Pedalante al Jerusalemo</url></vrk>
          <lok>2007</lok>
        </fnt>!
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>urbogvidanto/-isto</ke>,
    <ke>fremdulgvidanto/-isto</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_p;&c_r;&c_a;&c_v;&c_a;&c_d;&c_n;&c_ib;&c_k;</trd>,
    <trd>&c_g;&c_ib;&c_d;</trd>
  </trdgrp>
  <trd lng="ca">guia</trd>
  <trdgrp lng="de">
    <trd>Fremdenf&uuml;hrer</trd>,
    <trd>Reisef&uuml;hrer</trd>,
    <trd>Reiseleiter</trd>
  </trdgrp>
  <trd lng="el">&xi;&epsilon;&ny;&alfa;&gamma;&omikron_ton;&sigma_fina;</trd>
  <trdgrp lng="en">
    <trd>cicerone</trd>,
    <trd>tour guide</trd>,
    <trd>docent</trd>
  </trdgrp>
  <trd lng="es">gu&iacute;a</trd>
  <trd lng="fr">guide <klr tip="ind">(accompagnateur)</klr></trd>
  <trd lng="he">&mem;&dalet;&resh;&yod;&fkaf; &tet;&yod;&vav;&lamed;&yod;&fmem;</trd>
  <trd lng="hu">idegenvezet&odblac;</trd>
  <trdgrp lng="it">
    <trd>cicerone</trd>,
    <trd>guida (turistica)</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x89B3;&#x5149;&#x30AC;&#x30A4;&#x30C9;  <pr>&#x304B;&#x3093;&#x3053;&#x3046;&#x30AC;&#x30A4;&#x30C9;</pr></trd>,
    <trd>&#x540D;&#x6240;&#x6848;&#x5185;&#x4EBA;  <pr>&#x3081;&#x3044;&#x3057;&#x3087;&#x3042;&#x3093;&#x306A;&#x3044;&#x3058;&#x3093;</pr></trd>
  </trdgrp>
  <trd lng="nl">gids</trd>
  <trdgrp lng="pl">
    <trd>przewodnik</trd>,
    <trd>cicerone</trd>
  </trdgrp>
  <trd lng="pt">cicerone</trd>
  <trd lng="ro">ghid</trd>
  <trdgrp lng="ru">
    <trd>&c_p;&c_r;&c_o;&c_v;&c_o;&c_d;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_ch;&c_i;&c_ch;&c_je;&c_r;&c_o;&c_n;&c_je;</trd>
  </trdgrp>
  <trd lng="sv">guide</trd>
  <trdgrp lng="uk">
    <trd>&c_je;&c_k;&c_s;&c_k;&c_u;&c_r;&c_s;&c_o;&c_v;&c_o;&c_d;</trd>,
    <trd>&c_p;&c_r;&c_o;&c_v;&c_ib;&c_d;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_ch;&c_i;&c_ch;&c_je;&c_r;&c_o;&c_n;&c_je;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x5916;&#x56FD;&#x5BFC;&#x6E38; <pr>w&agrave;igu&oacute;d&#x1CE;oy&oacute;u</pr></trd>,
    <trd>&#x5BFC;&#x6E38; <pr>d&#x1CE;oy&oacute;u</pr></trd>,
    <trd>&#x65C5;&#x6E38;&#x6307;&#x5357; <pr>l&#x1DA;y&oacute;uzh&#x1D0;n&aacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="cxicxe.0i">
  <kap>
    <tld/>i
  </kap>
  <snc mrk="cxicxe.0i.gvidi">
    <dif>
      <ref tip="super" cel="gvid.0i.al_direkto">Gvidi</ref> kiel <tld/>o:
      <ekz>
        entuziasme &scirc;i <tld/>is tra Prago kaj la tuta &Ccirc;e&hcirc;io
        <fnt>
          <bib>LOdE</bib>
          <lok>2000, No 3 (65)</lok>
        </fnt>;
      </ekz>
      <ekz>
        ni promenas en <nom>Nara</nom> en akompano (kaj kun bonega <tld/>ado) de esperantisto
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Magalh&atilde;es</nom> <klr>[&#x2026;]</klr> kartografias la domon, <tld/>ante &ccirc;ambron post
        &ccirc;ambro
        <fnt>
          <bib>Monato</bib>
          <aut>Reinaldo Marcelo Ferreira</aut>
          <vrk><url ref="&Monato;/2007/009077.php"
              >La movada koro sur viddisko</url></vrk>
          <lok>2007</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">f&uuml;hren <klr>(durch ein Museum usw.)</klr></trd>
</drv>

</art>
