<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: moskv.xml,v 1.42 2026/09/19 12:31:19 revo Exp $">
<kap><ofc>10</ofc>
<rad>Moskv</rad>/o
</kap>
<drv mrk="moskv.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Urbo en <ref tip="malprt" cel="rus.R0ujo">Rusujo</ref>
      (37&#730;37'E, 55&#730;44'N),
      anta&ubreve; 1712 kaj ekde 1918 la
      <ref tip="lst" cel="urb.cxef0o" lst="voko:&ccirc;efurboj">&ccirc;efurbo</ref>
      de Rusujo, kaj de 1922 &gcirc;is 1991 anka&ubreve; de <ref tip="malprt" cel="sovet.S0unio">Sovetunio</ref>:
      <ekz>
        foje en <tld/>o, dum malnormale varmega printempa sunsubiro, du
        civitanoj venis la &gcirc;ardenplacon de la Patriar&hcirc;a
        lageto
        <fnt><bib>MkM</bib>, <lok/></fnt>;
      </ekz>
      <ekz>
         la gotojn portis ega fortostre&ccirc;o &#11005;
         sub <tld/>on, kaj, jubile pri l' atingoj, &#11005;
         ili sin pu&scirc;is plu en duonringoj, &#11005;
         por rabi tiun urbon per sie&gcirc;o
        <fnt>
         <aut>K. Kalocsay</aut>: <vrk>Sub Moskvo</vrk>.
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="peterburg.0o">Peterburgo</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_M;&c_a;&c_s;&c_k;&c_v;&c_a;</trd>
  <trd lng="bg">&c_M;&c_o;&c_s;&c_k;&c_v;&c_a;</trd>
  <trd lng="ca">Moscou</trd>
  <trd lng="cs">Moskva</trd>
  <trd lng="de">Moskau</trd>
  <trd lng="en">Moscow</trd>
  <trd lng="es">Mosc&uacute;</trd>
  <trd lng="fa">&a_m;&a_s;&f_k;&a_w;</trd>
  <trd lng="fr">Moscou</trd>
  <trd lng="hu">Moszkva</trd>
  <trd lng="ja">&#12514;&#12473;&#12463;&#12527;  <pr>&#12418;&#12377;&#12367;&#12431;</pr></trd>
  <trd lng="kk">&c_M;&#1241;&c_s;&c_k;&c_je;&c_u;</trd>
  <trd lng="nl">Moskou</trd>
  <trd lng="os">&c_M;&aelig;&c_s;&c_k;&c_u;&c_y;</trd>
  <trd lng="pl">Moskwa</trd>
  <trdgrp lng="pt">
   <trd>Moscou</trd>,
    <trd>Moscovo <klr tip="amb">(PT)</klr></trd>
  </trdgrp>
  <trd lng="ru">&c_M;&c_o;&c_s;&c_k;&c_v;&c_a;</trd>
  <trdgrp lng="sk">
    <trd>Moskva</trd>,
    <trd>Moskva <klr>(mesto)</klr></trd>
  </trdgrp>
  <trd lng="sv">Moskva</trd>
  <trd lng="uk">&c_M;&c_o;&c_s;&c_k;&c_v;&c_a;
  <klr>(&c_s;&c_t;&c_o;&c_l;&c_i;&c_c;&c_ja;)</klr></trd>
  <trd lng="zh">&#33707;&#26031;&#31185;<klr>
  [M&ograve;sike]</klr></trd>
</drv>

<drv mrk="moskv.0ano">
  <kap><tld lit="m"/>ano</kap>
  <snc>
    <dif>
      Lo&gcirc;anto de <tld/>o:
      <ekz>
        moskvanoj mal&scirc;atas sian urbegon pro &gcirc;iaj &hcirc;aoso kaj interpremo
        <fnt>
          <bib>Monato</bib>
          <aut>Mihail Korotkov</aut>
          <vrk><url ref="&Monato;/2011/010465.php"
              >Bridi la monstron</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz>
     <ekz>
        moskvanoj fondis en junio 1922 altnivelan literatur-sciencan revuon La Nova Epoko
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_s;&c_k;&c_v;&c_ib;&c_ch;</trd>
  <trd lng="ca">moscovita</trd>
  <trdgrp lng="de">
    <trd>Moskauer</trd>,
    <trd>Moskowiter</trd>
  </trdgrp>
  <trd lng="en">Muscovite</trd>
  <trd lng="es">moscovita</trd>
  <trd lng="fr">moscovite</trd>
  <trd lng="ru">&c_m;&c_o;&c_s;&c_k;&c_v;&c_i;&c_ch;</trd>
  <trd lng="zh">&#33707;&#26031;&#31185;&#20154; <pr>m&ograve;s&imacron;k&emacron;r&eacute;n</pr></trd>
</drv>

<drv mrk="moskv.0ulo">
  <kap><tld lit="m"/>ulo</kap>
  <snc mrk="moskv.0ulo.ruso">
    <dif>
      Mal&scirc;ata nomo de ruso en alietnaj partoj de la Rusa Imperio:
      <ekz>
        en Litvo estas konata plenda kanto pri sinjorino <nom>Cybulska</nom>,
        kiun la edzo kartlude malgajnis al <tld/>ulo
        <fnt><aut>A. Mickiewicz tr. A. Grabowski</aut>:
          <vrk>Sinjoro Tadeo</vrk>, <lok>12:357, piednoto.</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="de">Russki</trd>
  </snc>
  <snc mrk="moskv.0ulo.soldato">
    <dif>
      Mal&scirc;ata nomo de registara funkciulo a&ubreve; militisto en nerusaj
      partoj de la Rusa Imperio:
      <ekz>
        de malsupre, <tld lit="m"/>uloj kuglojn hajle pafis
        <fnt><aut>A. Mickiewicz tr. A. Grabowski</aut>:
            <vrk>Sinjoro Tadeo</vrk>, <lok>2:304.</lok>
          </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="moskv.0ulo.partiano">
    <dif>
      Partiano de la ruslanda registaro:
      <ekz>
        granda fripon&#8217;, la&ubreve; regulo,
	se polo, en carservo, fari&gcirc;as <tld lit="m"/>ulo
        <fnt><aut>A. Mickiewicz tr. A. Grabowski</aut>:
            <vrk>Sinjoro Tadeo</vrk>, <lok>9:109.</lok>
          </fnt>;
      </ekz><ekz>
        se mi <tld lit="m"/>ulo i&gcirc;us, plej granda magnato,
	ser&ccirc;us mian protekton, e&ccirc; nobelofrato
        <fnt><aut>A. Mickiewicz tr. A. Grabowski</aut>:
          <vrk>Sinjoro Tadeo</vrk>, <lok>10:813-814.</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="de">Apparatschik</trd>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_s;&c_k;&c_a;&c_l;&c_mol;</trd>
  <trd lng="de">Moskal</trd>
  <trd lng="en">Russki</trd>
  <trd lng="pl">moskal</trd>
  <trd lng="ru">&c_m;&c_o;&c_s;&c_k;&c_a;&c_l;&c_mol;</trd>
</drv>

<drv mrk="moskv.0orivero">
  <kap><tld/>o-rivero</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      <ref tip="lst" cel="river.0o" lst="voko:riveroj">Rivero</ref>, kiu fluas tra
      urbo <tld/>o, maldekstra alfluanto de
      <ref cel="oka.O0o.Euxropa">Okao<sncref/></ref>:
      <ekz>
        rajdante sur la bordo de <tld/>o-rivero, oni bone povis vidi la
        tutan &gcirc;ardenon de <nom>Morozov</nom>
        <fnt><aut>A.K. Tolstoj, tr. M. &Scirc;idlovskaja</aut>:
          <vrk><url ref="&Gutenberg;files/55302/55302-h/55302-h.htm">Princo
          Serebrjanij</url></vrk>.
          <lok>Librejo Esperanto: Moskvo, 1912. &Ccirc;ap. 5&#170;.</lok>
        </fnt>;
      </ekz><ekz>
        <klr>[la urbo <tld/>o]</klr> aperis kiel fe&ubreve;da bieno-kastelo
        <klr>[&#8230;]</klr> sur monteto &ccirc;e la enfluo de la rivereto
        <nom>Neglinka</nom> al <tld/>o-rivero
        <fnt><aut>Nikolao Gudskov, Natalia Arolovi&ccirc;</aut>:
          <vrk>Malgranda gvidlibro pri Moskvo</vrk>.
          <lok>Impeto: Moskvo, 2000.</lok></fnt>.
        </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_M;&c_a;&c_s;&c_k;&c_v;&c_a;-&c_r;&c_a;&c_k;&c_a;</trd>
  <trd lng="ca">Moskva</trd>
  <trd lng="cs">&rcaron;eka Moskva</trd>
  <trd lng="de">Moskwa</trd>
  <trd lng="en">Moskva</trd>
  <trd lng="es">Moscova</trd>
  <trd lng="fa">&a_r;&a_w;&a_d;&a_kh;&a_A;&a_n;&a_h;&a_hamza_sure;
  <ind>&a_m;&a_s;&f_k;&a_w;</ind></trd>
  <trdgrp lng="fr">
    <trd>Moskva</trd>,
    <trd>Moskova</trd>
  </trdgrp>
  <trd lng="hu">Moszkva-foly&oacute;</trd>
  <trd lng="nl">Moskou-rivier</trd>
  <trd lng="pl"><klr>rzeka</klr> Moskwa</trd>
  <trdgrp lng="pt">
   <trd>Moscova</trd>,
    <trd>M&oacute;scova</trd>
  </trdgrp>
  <trd lng="ru">&c_M;&c_o;&c_s;&c_k;&c_v;&c_a;-&c_r;&c_je;&c_k;&c_a;</trd>
  <trdgrp lng="sk">
    <trd>Moskva <klr>(rieka)</klr></trd>,
    <trd>rieka Moskva</trd>
  </trdgrp>
  <trd lng="zh">&#33707;&#26031;&#31185;&#27827; <pr>m&ograve;s&imacron;k&emacron;h&eacute;</pr></trd>
</drv>

</art>
