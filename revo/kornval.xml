<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kornval.xml,v 1.5 2026/11/11 17:54:55 afido Exp $">
    <kap>
      <ofc>10</ofc><rad>Kornval</rad>/o
    </kap>

<drv mrk="kornval.0o">
  <kap><ofc>10</ofc><tld/>o</kap>
  <mlg>GB&#8209;CON</mlg>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      Graflando en la sudokcidento de <ref tip="malprt" cel="angl.A0ujo">Anglujo</ref>:
      <ekz>
        en <tld/>o <klr>[&#8230;]</klr> la lastaj parolanto de loka kelta lingvo mortis &ccirc;irka&ubreve;
        la jaro 1800
        <fnt>

          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2006/008740.php"
              >Revivi&gcirc;o de mortinta lingvo</url></vrk>
              <bib>Monato</bib>
          <lok>2006/02, p. 22</lok>
        </fnt>;
      </ekz>
      <ekz>
        ankora&ubreve; ekzistas en la okcidenta Francio kelta idiomo, nome la bretona, kiu
        tamen ne estas rekta deriva&jcirc;o de la galla, sed estis enkondukita en la 5a
        jarcento de homoj enmigrintaj el <tld/>o
        <fnt>

          <aut>Garvan Makaj' (Garbhan MacAoidh)</aut>
          <vrk><url ref="&Monato;/2013/010673.php"
              >Malgravaj lingvoj gravas</url></vrk>
              <bib>Monato</bib>
          <lok>2013/01, p. 26</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Cornwall</trd>
    <trd lng="en">Cornwall</trd>
    <trd lng="fr">Cornouailles</trd>
    <trd lng="nl">Cornwall</trd>
    <trd lng="pl">Kornwalia</trd>
  </snc>
<trd lng="be">&c_K;&c_o;&c_r;&c_n;&c_w;&c_a;&c_l;</trd>
</drv>

<drv mrk="kornval.0a">
  <kap>
    <ofc>10</ofc><tld lit="k"/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o, la <tld lit="k"/>anoj, la tradicia kelta lingvo:
      <ekz>
        post nia mallonga restado en <tld/>o, ni povas konfirmi, ke la <tld lit="k"/>a
        ne estas mortinta lingvo, kvankam &ccirc;ie oni a&ubreve;das la anglan
        <fnt>

          <aut>Garvan Makaj'</aut>
          <vrk><url ref="&Monato;/2008/009528.php">La kornvala ne mortinta!</url></vrk>
          <bib>Monato</bib>
          <lok>2008/10, p. 19</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="en">Cornish</trd>
  </snc>
  <trd lng="be">&c_k;&c_o;&c_r;&c_n;&c_w;&c_a;&c_l;&c_mol;&c_s;&c_k;&c_ib;</trd>
  <trd lng="de">kornisch</trd>
  <trd lng="nl">Cornish<klr> (v. Cornwall)</klr></trd>
  <trd lng="pl">kornwalijski</trd>
</drv>

<drv mrk="kornval.0ano">
  <kap>
    <ofc>10</ofc><tld lit="k"/>ano
  </kap>
  <snc>
    <dif>
      Iu el <tld/>o:
      <ekz>
        malgranda sed signifa kaj kreskanta nombro da <tld lit="k"/>anoj lernis kaj nun
        uzas la <tld lit="k"/>an kiel familian lingvon
        <fnt>

          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2006/008740.php"
              >Revivi&gcirc;o de mortinta lingvo</url></vrk>
               <bib>Monato</bib>
          <lok>2006/02, p. 22</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="en"><ind>Cornish</ind> person</trd>
  <trd lng="nl">Cornish<klr> (volk)</klr></trd>
  <trd lng="pl">Kornwalijczyk</trd>
  </snc>
  <trd lng="be">&c_k;&c_o;&c_r;&c_n;&c_w;&c_a;&c_l;&c_je;&c_c;</trd>
</drv>
</art>

