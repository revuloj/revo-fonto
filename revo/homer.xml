<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: homer.xml,v 1.18 2026/11/05 18:01:40 revo Exp $">
<kap>
  <rad>Homer</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="homer.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">PERS</uzo>
  <snc>
    <dif>
      Eposisto helena (probable el la 8a jarcento a. K.) konsiderata
      kiel a&ubreve;toro de <ref tip="vid" cel="iliad.0o">Iliado</ref> kaj <ref tip="vid"
      cel="odise.0ado.BELE">Odiseado</ref>:
      <ekz>
        <tld/>o prikantas en sia eposo la templon de Atena
        <fnt><bib>IntArkeol</bib>, <lok>p. 19a</lok></fnt>;
      </ekz>
      <ekz>
      de 1993 ekzistas en Ankono, Italio, muzeo iom eksterskema, la muzeo <nom>Omero</nom> (nomata
      la&ubreve; la itala formo de <tld lit="H"/>o, kiu, la&ubreve; tradicia scio, estis blinda)
      <fnt>
        <aut>Aldo Grassini</aut>
        <vrk><url ref="&Monato;/2006/008997.php">Arto videbla anka&ubreve; por blinduloj</url></vrk>
        <bib>Monato</bib>
        <lok>2006/10, p. 20</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_G;&c_a;&c_m;&c_e;&c_r;</trd>
  <trd lng="ca">Homer</trd>
  <trd lng="cs">Hom&#xE9;r</trd>
  <trd lng="de">Homer</trd>
  <trd lng="en">Homer</trd>
  <trd lng="es">Homero</trd>
  <trd lng="fr">Hom&egrave;re</trd>
  <trd lng="hu">Hom&eacute;rosz</trd>
  <trd lng="it">Omero</trd>
  <trd lng="ja">&#x30DB;&#x30E1;&#x30ED;&#x30B9;</trd>
  <trd lng="nl">Homeros</trd>
  <trd lng="pl">Homer</trd>
  <trd lng="pt">Homero</trd>
  <trd lng="ru">&c_G;&c_o;&c_m;&c_je;&c_r;</trd>
  <trd lng="sk">Hom&#xE9;r</trd>
  <trd lng="uk">&c_G;&#x43E;&#x43C;&c_je;&c_r; (&c_d;&c_a;&c_v;&#x43D;&#x44C;&#x43E;&c_g;&c_r;&c_je;&c_c;&#x44C;&#x43A;&c_i;&c_j;
  &#x43F;&#x43E;&c_je;&c_t;)</trd>
  <trd lng="zh">&#33655;&#x99AC; <pr>H&#xE9;m&#x1CE;</pr></trd>
</drv>
</art>

