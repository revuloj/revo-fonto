<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: gxenev.xml,v 1.16 2026/11/07 06:00:19 revo Exp $">
<kap><ofc>10</ofc>
  <rad>&Gcirc;enev</rad>/o
</kap>
<drv mrk="gxenev.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Grava <ref tip="lst" lst="voko:urboj" cel="urb.0o.ARKI">urbo</ref>
      de <ref tip="malprt" cel="svis.S0ujo">Svisujo</ref>,
      situo: (<frm>46&#730;12&minute;N  06&#730;09&minute;E</frm>):
      <ekz>
        &leftquot;Ho, kiaj vortoj!&rightquot; ekkriis <nom>Zamenhof</nom> indigne dum sia
        parolado &ccirc;e la Dua Kongreso
        Esperantista en <tld/>o je 1906
        <fnt>
          <bib>VivZam</bib>
        </fnt>;
      </ekz>
      <ekz>
        mortis nia plej kara samideano kaj amiko, kiu estis
        <klr>[&#8230;]</klr> la &ccirc;efa
        motoro de nia lasta kongreso en <tld/>o
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Tria Kongreso Esperantista en Cambridge
          en la 12a de a&ubreve;gusto 1907</vrk>
        </fnt>;
      </ekz>
      <ekz>
        la gazaanoj plu suferas, pro kolektiva puno, kiu estas
        malpermesita de la
        konvencio de <tld/>o, subskribita de Israelo
        <fnt>
          <bib>Monato</bib>
          <aut>Thierry Tailhades</aut>
          <vrk><url ref="&Monato;/2009/009820.php">Tri monatoj pasis ...</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la esplorcentro CERN en <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2010/010081.php">Misteroj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_Zh;&c_e;&c_n;&c_e;&c_v;&c_a;</trd>
  <trd lng="bg">&c_Zh;&c_je;&c_n;&c_je;&c_v;&c_a;</trd>
  <trd lng="ca">Ginebra</trd>
  <trd lng="cv">&c_Zh;&c_je;&c_n;&c_je;&c_v;&c_a;</trd>
  <trd lng="de">Genf</trd>
  <trd lng="en">Geneva</trd>
  <trd lng="fr">Gen&egrave;ve</trd>
  <trd lng="id">Jenewa</trd>
  <trd lng="it">Ginevra</trd>
  <trd lng="ja">&#12472;&#12517;&#12493;&#12540;&#12502;  <pr>&#12376;&#12421;&#12397;&#12540;&#12406;</pr></trd>
  <trd lng="oc">Gen&egrave;va</trd>
  <trd lng="pl">Genewa</trd>
  <trd lng="uk">&c_Zh;&c_je;&c_n;&c_je;&c_v;&c_a;</trd>
  <trd lng="zh">&#26085;&#20839;&#29926; <pr>r&igrave;n&egrave;iw&#462;</pr></trd>
</drv>
</art>

