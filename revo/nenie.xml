<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: nenie.xml,v 1.31 2026/08/10 15:13:34 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>nenie</rad>
  <fnt> <bib>UV</bib></fnt>
</kap>

<drv mrk="nenie.0">
  <kap><ofc>*</ofc><tld/></kap>
  <snc>
    <dif>
      Adverbo signifanta: &leftquot;en neniu ajn loko&rightquot;:
      <ekz>
        <klr>[li]</klr> komencis ser&ccirc;i <klr>[&#x2026;]</klr>, sed li <tld/> povis &gcirc;in trovi
        <fnt>
          <bib>Fab1</bib>
          <lok>Galo&scirc;oj de feli&ccirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        pli bone ol &ccirc;e ni <tld/> povas esti
        <fnt>
          <bib>Fab2</bib>
          <lok>Feli&ccirc;a familio</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi multe dankas vin por via gastameco <klr>[&#x2026;]</klr>,
        <tld/> <klr>(krom tie &ccirc;i)</klr> mi havis tian bonan akcepton
        <fnt>
          <bib>Revizoro</bib>
          <lok>Akto kvara</lok>
        </fnt>;
      </ekz>
      <ekz>
        ne rigardu malanta&ubreve;en kaj haltu <tld/>
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 19:17</lok>
        </fnt>;
      </ekz>
      <ekz>
        vento blovis de <tld/> kaj neniu folio movi&gcirc;is
        <fnt>
          <bib>ElektFab</bib>
          <lok>Sesope oni trairas la tutan mondon</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Maljunulo <klr>[&#x2026;]</klr> povis esti <ind>&ccirc;ie kaj <tld/></ind>
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Maljunulo de la Migranta Monto</lok>
        </fnt>;
        <trd lng="de">&uuml;berall und nirgends</trd>
      </ekz>
      <ekz>
        <tld/> semata, &ccirc;ie trovata
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        kiu kutimis &ccirc;ion ju&gcirc;i, <tld/> povas rifu&gcirc;i
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_n;&c_ib;&c_d;&c_z;&c_je;</trd>
  <trd lng="bo">&t_ga;&t_tsheg;&t_pa;&t_ra;&t_tsheg;&t_ya;&t_sa;&t_tsheg;&t_ma;&t_gigu;&t_na;&t_tsheg;&t_-a;&t_da;&t_shabchu;&t_ga;&t_tsheg;</trd>
  <trd lng="ca">enlloc</trd>
  <trd lng="cs">nikde</trd>
  <trdgrp lng="de">
    <trd>nirgends</trd>,
    <trd>nirgendwo</trd>
  </trdgrp>
  <trd lng="el">&pi;&omikron;&ypsilon;&theta;&epsilon;&ny;&alfa_ton;</trd>
  <trdgrp lng="en">
    <trd>nowhere</trd>,
    <trd>in no <ind>case</ind></trd>,
    <trd>not <ind>anywhere</ind></trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>en ning&uacute;n <ind>sitio</ind></trd>,
    <trd>en ninguna <ind>parte</ind></trd>,
    <trd>en ning&uacute;n <ind>lugar</ind></trd>
  </trdgrp>
  <trd lng="fr">nulle part</trd>
  <trd lng="hu">sehol</trd>
  <trd lng="ja">&#x3069;&#x3053;&#x306B;&#x3082;&#xFF5E;&#x306A;&#x3044;</trd>
  <trd lng="nl">nergens</trd>
  <trd lng="pl">nigdzie</trd>
  <trdgrp lng="pt">
    <trd>nenhures</trd>,
    <trd>em <klr tip="amb">lugar</klr> algum</trd>
  </trdgrp>
  <trd lng="ro">nic&abreve;ieri</trd>
  <trd lng="ru">&c_n;&c_i;&c_g;&c_d;&c_je;</trd>
  <trd lng="sk">nikde</trd>
  <trd lng="sv">ingenstans</trd>
  <trd lng="uk">&c_n;&c_ib;&c_d;&c_je;</trd>
  <trdgrp lng="zh">
    <trd>&#x67D0;&#x4E00;&#x4E2A; <pr>m&#x1D2;uy&imacron;g&egrave;</pr></trd>,
    <trd>&#x67D0;&#x4E00;&#x500B; <pr>m&#x1D2;uy&imacron;g&egrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="nenie.0n">
  <kap><tld/>n</kap>
  <snc>
    <dif>
      Adverbo signifanta: &leftquot;en neniun ajn lokon&rightquot;:
      <ekz>
        mi <tld/>n plu iros hodia&ubreve;
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>n, <tld/>n &scirc;i povas forkuri de sia mizera sorto
        <fnt>
          <bib>Mizero</bib>
          <lok>III</lok>
        </fnt>;
      </ekz>
      <ekz>
        kun Dio vi iros &ccirc;ien, sen Dio <tld/>n
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_n;&c_ib;&c_k;&c_u;&c_d;&c_y;</trd>
  <trd lng="de">nirgendwohin</trd>
  <trd lng="hu">sehov&aacute;</trd>
  <trd lng="ja">&#x3069;&#x3053;&#x3078;&#x3082;&#xFF5E;&#x306A;&#x3044;</trd>
  <trd lng="nl">nergens heen</trd>
  <trd lng="pl">donik&aogonek;d</trd>
  <trd lng="ru">&c_n;&c_i;&c_k;&c_u;&c_d;&c_a;</trd>
</drv>
</art>
