<art mrk="$Id: akupunktur.xml,v 1.28 2026/08/14 13:59:44 revo Exp $">
<kap>
  <ofc>9</ofc><rad>akupunktur</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="akupunktur.0o">
  <kap><ofc>9</ofc><tld/>o</kap>
  <snc mrk="akupunktur.0o.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      Kuracmetodo el la tradicia &ccirc;ina medicino, kiu konsistas en
      pikado de difinitaj korpopunktoj per pingloj:
      <ekz>
        <tld/>o, masa&gcirc;oj, aromterapio, floraj esencoj, ekzistas diversaj terapioj, kiuj
        povas funkcii kiel alternativoj al la tradiciaj (&ccirc;efe okcidentaj) kuracmetodoj
        <fnt>
          <bib>Kon11</bib>
          <lok>Reagoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        ekpopulari&gcirc;is en Japanio <tld/>o por bestoj, precipe hundoj
        <fnt>
          <bib>Monato</bib>
          <aut>HORI Yasuo</aut>
          <vrk><url ref="&Monato;/2004/008245.html"
              >Piko-efiko</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="zh">
    <trd>&#x65BD;&#x4EE5;&#x91DD;&#x7078; <pr>sh&imacron;y&#x1D0;zh&emacron;nji&#x1D4;</pr></trd>,
    <trd>&#x65BD;&#x4EE5;&#x9488;&#x7078; <pr>sh&imacron;y&#x1D0;zh&emacron;nji&#x1D4;</pr></trd>,
    <trd>&#x91DD;&#x523A; <pr>zh&emacron;nc&igrave;</pr></trd>,
    <trd>&#x9488;&#x523A; <pr>zh&emacron;nc&igrave;</pr></trd>,
    <trd>&#x91DD;&#x6CBB; <pr>zh&emacron;nzh&igrave;</pr></trd>,
    <trd>&#x9488;&#x6CBB; <pr>zh&emacron;nzh&igrave;</pr></trd>,
    <trd>&#x91DD;&#x523A;&#x7642;&#x6CD5; <pr>zh&emacron;nc&igrave;li&aacute;of&#x1CE;</pr></trd>,
    <trd>&#x9488;&#x523A;&#x7597;&#x6CD5; <pr>zh&emacron;nc&igrave;li&aacute;of&#x1CE;</pr></trd>
  </trdgrp>
</snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>nadlopikkuracado</ke>, <ke>nadlopikado</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_a;</trd>,
    <trd>&c_ib;&c_g;&c_o;&c_l;&c_k;&c_a;&c_w;&c_k;&c_o;&c_l;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>
  </trdgrp>
  <trd lng="bg">&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_a;</trd>
  <trd lng="ca">acupuntura</trd>
  <trd lng="de">Akupunktur</trd>
  <trd lng="en">acupuncture</trd>
  <trd lng="es">acupuntura</trd>
  <trd lng="fa">&a_T;&a_b; &a_s;&a_w;&a_z;&a_n;&f_y;</trd>
  <trdgrp lng="fr">
    <trd>acuponcture</trd>,
    <trd>acupuncture</trd>
  </trdgrp>
  <trd lng="he">&alef;&#x5B7;&qof;&vav;&#x5BC;&pe;&#x5BC;&vav;&#x5BC;&nun;&qof;&tet;&vav;&#x5BC;&resh;&#x5B8;&he;</trd>
  <trd lng="hu">akupunkt&uacute;ra</trd>
  <trdgrp lng="ja">
    <trd>&#x937C;&#x7642;&#x6CD5;  <pr>&#x306F;&#x308A;&#x308A;&#x3087;&#x3046;&#x307B;&#x3046;</pr></trd>,
    <trd>&#x937C;&#x6CBB;&#x7642;  <pr>&#x306F;&#x308A;&#x3061;&#x308A;&#x3087;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="nl">acupunctuur</trd>
  <trd lng="pl">akupunktura</trd>
  <trdgrp lng="pt">
   <trd>acupuntura</trd>
  </trdgrp>
  <trd lng="ro">acupuntur&abreve;</trd>
  <trdgrp lng="ru">
    <trd>&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_a;</trd>,
    <trd>&c_i;&c_g;&c_l;&c_o;&c_u;&c_k;&c_a;&c_l;&c_y;&c_v;&c_a;&c_n;&c_i;&c_je;</trd>,
    <trd>&c_i;&c_g;&c_l;&c_o;&c_t;&c_je;&c_r;&c_a;&c_p;&c_i;&c_ja;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_a;</trd>,
    <trd>&c_g;&c_o;&c_l;&c_k;&c_o;&c_t;&c_je;&c_r;&c_a;&c_p;&c_ib;&c_ja;</trd>,
    <trd>&c_g;&c_o;&c_l;&c_k;&c_o;&c_v;&c_k;&c_o;&c_l;&c_ju;&c_v;&c_a;&c_n;&c_n;&c_ja;</trd>
  </trdgrp>
</drv>

<drv mrk="akupunktur.0isto">
  <kap><tld/>isto</kap>
  <snc mrk="akupunktur.0isto.MED">
    <uzo tip="fak">MED</uzo>
    <dif>
      Kuracisto aganta per <tld/>o:
      <ekz>
	li iris &ccirc;ien por ser&ccirc;i kuraciston, fine li trovis <tld/>istinon
	<fnt><bib>RugxDom</bib>, <lok>&ccirc;apitro 75a, volumo 2a, p.
	591a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_n;&c_ib;&c_k;</trd>
  <trd lng="bg">&c_a;&c_k;&c_u;&c_p;&c_u;&c_n;&c_k;&c_t;&c_u;&c_r;&c_i;&c_s;&c_t;</trd>
  <trd lng="ca">acupuntor</trd>
  <trd lng="de">Akupunkteur</trd>
  <trd lng="en">acupuncturist</trd>
  <trdgrp lng="es">
    <trd>acupuntor</trd>
    <trd>acupunturista</trd>
  </trdgrp>
  <trd lng="fa">&a_m;&a_t;&a_kh;&a_S;&a_S; <ind>&a_T;&a_b; &a_s;&a_w;&a_z;&a_n;&f_y;</ind></trd>
  <trdgrp lng="fr">
    <trd>acuponcteur</trd>,
    <trd>acupuncteur</trd>
  </trdgrp>
  <trd lng="hu">akupunkt&uacute;r&aacute;val gy&oacute;gy&iacute;t&oacute;</trd>
  <trd lng="nl">acupuncturist</trd>
  <trd lng="pl">akupunkturzysta</trd>
  <trdgrp lng="ru">
    <trd>&c_i;&c_g;&c_l;&c_o;&c_u;&c_k;&c_a;&c_l;&c_y;&c_v;&c_a;&c_t;&c_je;&c_l;&c_mol;</trd>,
    <trd>&c_s;&c_p;&c_je;&c_c;&c_i;&c_a;&c_l;&c_i;&c_s;&c_t; &c_p;&c_o;
    <ind>&c_i;&c_g;&c_l;&c_o;&c_t;&c_je;&c_r;&c_a;&c_p;&c_i;&c_i;</ind></trd>
  </trdgrp>
</drv>
