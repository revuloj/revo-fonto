<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
 <art mrk="$Id: levistik.xml,v 1.1 2026/09/10 11:12:11 afido Exp $">
  <kap>
    <rad>levistik</rad>/o
    <fnt><bib>PIV1</bib></fnt>
  </kap>

<drv mrk="levistik.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BOT</uzo><uzo tip="fak">KUI</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="herb.spic0o">Spicherbo</ref>
      (<trd lng="la">Levisticum officinale</trd>),
      arome odoranta, da&ubreve;ra planto
      el familio <ref tip="malprt" cel="apiac.0oj">apiacoj</ref>,
      kun  2-3-foje plume dividitaj, senharaj folioj kaj
      malgrandaj flavetaj floroj en 12 - 20 umbeletoj:
      <ekz>
        sur <tld/>on kun fervor&#x2019; larmetis ili la&ubreve; la mor&#x2019;
        <fnt>
          <bib>LOdE</bib>
          <lok>2003, &#x2116; 6 (104)</lok>
        </fnt>;
      </ekz>
      <ekz>
        fra&ubreve;linoj &jcirc;etadis en riverojn florkronojn plektitajn el rozmareno, <tld/>o,
        verbasko kaj hiperiko, dum fra&ubreve;loj <klr>[&#x2026;]</klr> saltadis en la akvon
        <klr>[&#x2026;]</klr>, klopodis ilin elpreni
        <fnt>
          <aut>Krystyna Grochocka</aut>
          <vrk><url ref="https://pola-retradio.org/2021/06/cirkau-la-somera-solstico-kaj-la-sanktjohana-nokto/"
              >&Ccirc;irka&ubreve; la somera solstico kaj la Sanktjohana Nokto</url></vrk>
          <lok>Pola Retradio, 2021-06-25</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/2/25/Illustration_Levisticum_officinale0.jpg/500px-Illustration_Levisticum_officinale0.jpg"
      prm="PD"
      >botanika tabulo de <tld/>o (Levisticum officinale)
        <fnt>
          <lok><url ref="&WCW;/File:Illustration_Levisticum_officinale0.jpg"
              >https://commons.wikimedia.org/wiki/File:Illustration_Levisticum_officinale0.jpg</url></lok>
        </fnt>
    </bld>
    <trdgrp lng="de">
      <trd>Liebst&ouml;ckel</trd>,
      <trd>Maggikraut</trd>
    </trdgrp>
    <trd lng="en">lovage</trd>
    <trd lng="fr">liv&egrave;che</trd>
    <trd lng="ru">&c_l;&c_ju;&c_b;&c_i;&c_s;&c_t;&c_o;&c_k;</trd>
  </snc>
</drv>

  </art>


