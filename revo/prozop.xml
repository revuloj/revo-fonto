    <trd>Personifizierung</trd>,
    <trd>Prosopop&ouml;ie</trd>
  </trdgrp>
  <trd lng="id">personifikasi</trd>
  <trd lng="ja">&#25836;&#20154;&#27861;  <pr>&#12366;&#12375;&#12435;&#12411;&#12358;</pr></trd>
  <trdgrp lng="nl">
    <trd>prosopopoeia</trd>,
    <trd>personificatie</trd>
  </trdgrp>
  <trd lng="pl">personifikacja</trd>
  <trd lng="ro">personificarea</trd>
  <trd lng="sk">zosobnenie</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_r;&c_o;&c_z;&c_o;&c_p;&c_o;&c_p;&c_je;&c_ja;</trd>,
    <trd>&c_u;&c_o;&c_s;&c_o;&c_b;&c_l;&c_je;&c_n;&c_n;&c_ja;</trd>
  </trdgrp>
</drv>
