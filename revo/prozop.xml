</kap>

<drv mrk="prozop.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">LIN</uzo>
  <dif>
    <ref tip="dif" cel="person.0igo.LIN">Personigo<sncref/></ref>:
    <ekz>
      bjeso <klr>[&#8230;]</klr> signifas ka&ubreve;zanta timon &#8208; en anta&ubreve;kristanismaj kredoj de
      slavoj <tld/>o de precize ne difinita malbona fantomo a&ubreve; demono de malbono
      <fnt>
        <bib>Viki</bib>
        <lok><url ref="https://eo.wikipedia.org/?curid=504373">Bjeso</url></lok>
      </fnt>.
    </ekz>
  </dif>
  <trd lng="be">&c_u;&c_v;&c_a;&c_s;&c_a;&c_b;&c_l;&c_je;&c_n;&c_mol;&c_n;&c_je;</trd>
  <trd lng="ca">prosopopeia</trd>
  <trd lng="cs">zosobn&ecaron;n&iacute;</trd>
