<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: sard.xml,v 1.11 2026/10/25 08:00:19 revo Exp $">
    <kap>
      <rad>sard</rad>/o <fnt><bib>PVEF</bib></fnt>
    </kap>

<drv mrk="sard.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Lo&gcirc;anto de la insulo <tld lit="S"/>ujo, kiu situas sude de
      Korsiko:
      <ekz>
        per regiona le&gcirc;o de 1997 kaj itala le&gcirc;o de 1999 la <tld/>a
        oficiale akiris la
        samajn rajtojn kiel la itala lingvo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=17823">Sarda lingvo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="sardon.0a_rido">sardona rido</ref>
    <trd lng="de">Sarde</trd>
    <trd lng="en">Sardinian</trd>
    <trd lng="fr">Sarde</trd>
    <trd lng="pl">Sardy&nacute;czyk</trd>
  </snc>
  <trd lng="be">&c_s;&c_a;&c_r;&c_d;&c_y;&c_n;&c_je;&c_c;</trd>
  <trd lng="ca">sard</trd>
  <trd lng="es">sardo</trd>
  <trd lng="ja">&#12469;&#12523;&#12487;&#12451;&#12540;&#12491;&#12515;&#20154;
  <pr>&#12469;&#12523;&#12487;&#12451;&#12540;&#12491;&#12515;&#12376;&#12435;</pr></trd>
  <trd lng="oc">sard</trd>
  <trdgrp lng="uk">
    <trd>&c_s;&c_a;&c_r;&c_d;</trd>,
    <trd>&c_s;&c_a;&c_r;&c_d;&c_i;&c_n;&c_je;&c_c;&c_mol;</trd>,
    <trd>&c_s;&c_a;&c_r;&c_d;&c_je;&c_r; (&c_r;&c_ib;&c_z;&c_n;&c_o;&c_v;&c_i;&c_d;
    &c_h;&c_a;&c_l;&c_c;&c_je;&c_d;&c_o;&c_n;&c_u;)</trd>
  </trdgrp>
</drv>

<drv mrk="sard.S0ujo">
  <kap>
    <tld lit="S"/>ujo
  </kap>
  <snc>
  <uzo tip="fak">GEOG</uzo>
  <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="lst" lst="voko:insuloj" cel="insul.0o.GEOG">Insulo</ref>
      en <ref tip="malprt" cel="mediterane.M0o">Mediteraneo</ref>
      sude de Korsiko:
      <ekz>
        <klr>[la&ubreve;mite]</klr> la re&gcirc;o Thespios havis kvindek filinojn
        <klr>[&#8230;]</klr> Heraklo amoris kun &ccirc;iuj
        <klr>[kaj]</klr> havis kvindek infanojn <klr>[&#8230;]</klr>, kvardek
        unu el ili
        fondis kolonion en <tld lit="S"/>ujo, kiam ili estis
        plenkreskuloj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=26241">Heraklo</url></lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="en">Sardinia</trd>
  </snc>
  <trd lng="be">&c_S;&c_a;&c_r;&c_d;&c_y;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="ca">Sadenya</trd>
  <trd lng="de">Sardinien</trd>
  <trd lng="es">Cerde&ntilde;a</trd>
  <trd lng="fr">Sardaigne</trd>
  <trd lng="oc">Sardenha</trd>
  <trd lng="pl">Sardynia</trd>
  <trdgrp lng="zh">
    <trd>&#25746;&#19969;&#23707; <pr>s&amacron;d&imacron;ngd&#462;o</pr></trd>,
    <trd>&#25746;&#19969;&#23798; <pr>s&amacron;d&imacron;ngd&#462;o</pr></trd>,
    <trd>&#33832;&#19969;&#23707; <pr>s&agrave;d&imacron;ngd&#462;o</pr></trd>,
    <trd>&#34217;&#19969;&#23798; <pr>s&agrave;d&imacron;ngd&#462;o</pr></trd>
  </trdgrp>
</drv>

  </art>

