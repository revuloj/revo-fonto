<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: diskotek.xml,v 1.18 2026/11/06 20:00:19 revo Exp $">
<kap>
  <rad>diskotek</rad>/o
</kap>

<drv mrk="diskotek.0o">
  <kap><tld/>o</kap>
  <snc mrk="diskotek.0o.MUZ">
    <uzo tip="stl">KOMUNE</uzo>
    <dif>
      <ref tip="dif" cel="danc.0ejo.MUZ">Dancejo</ref>:
      <ekz>
        alparolas min <nom>Kerstin</nom> &ndash; knabino, kiu &scirc;atas festojn kaj
        <tld/>ojn
        <fnt>
          <aut>U. Matthias</aut>,
          <vrk><url ref="http://www.u-matthias.de/verko/fajron.htm">
          Fajron sentas mi interne</url></vrk>,
          <lok>Pro Esperanto, 1990</lok>
        </fnt>;
      </ekz>
      <ekz>
        por ili ne estas kompreneble, kial viro ekkonstruis ne profitodonan restoracion
        a&ubreve; <tld/>on, sed pre&gcirc;ejon, kiu alportos neniun monon
        <fnt>

          <aut>Laimius Stra&zcaron;nickas</aut>
          <vrk><url ref="&Monato;/2003/007949.html">Sur propra tereno propra pre&gcirc;ejo</url></vrk>
          <bib>Monato</bib>
          <lok>2003/09, p. 15</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iuvespere ni kune pre&gcirc;as, por ke almena&ubreve; neniu el la kunposedantoj enkapigu al
        si malfermi <tld/>on <klr>[&#8230;]</klr> super nia dormo&ccirc;ambro
        <fnt>

          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2011/010183.php">Terasa apartamento</url></vrk>
          <bib>Monato</bib>
          <lok>2011/01, p. 26</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="bg">&c_d;&c_i;&c_s;&c_k;&c_o;&c_t;&c_je;&c_k;&c_a;</trd>
    <trdgrp lng="de">
      <trd>Disco</trd>,
      <trd>Diskothek</trd>
    </trdgrp>
    <trd lng="en">discoth&egrave;que</trd>
    <trd lng="es">discoteca</trd>
    <trdgrp lng="nl">
      <trd>disco</trd>,
      <trd>discotheek</trd>
    </trdgrp>
    <trd lng="pl">dyskoteka</trd>
    <trdgrp lng="pt">
      <trd>discoteca</trd>,
      <trd>danceteria</trd>
    </trdgrp>
    <trd lng="ro">discotec&abreve;</trd>
    <trdgrp lng="zh">
    <trd>&#36842;&#26031;&#31185;&#33310;&#21381; <pr>d&iacute;s&imacron;k&emacron;w&#468;t&imacron;ng</pr></trd>,
    <trd>&#36842;&#26031;&#31185; <pr>d&iacute;s&imacron;k&emacron;</pr></trd>,
    <trd>&#36842;&#26031;&#31185;&#21543; <pr>d&iacute;s&imacron;k&emacron;b&amacron;</pr></trd>,
    <trd>&#21809;&#29255;&#25910;&#34255;&#23460; <pr>ch&agrave;ngpi&agrave;nsh&omacron;uc&aacute;ngsh&igrave;</pr></trd>
  </trdgrp>
</snc>
  <snc mrk="diskotek.0o.BIB">
    <fnt><bib>PIV1</bib></fnt>
    <dif>
      Kolekto de diskaj a&ubreve; aliaj sonregistra&jcirc;oj, ofte parto
      de <ref tip="malprt" cel="biblio1.0o.ejo">biblioteko</ref>.
    </dif>
    <trdgrp lng="de">
      <trd>Plattensammlung</trd>,
      <trd>Phonothek</trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd><ind>recording</ind>s collection</trd>,
      <trd>music <ind>library</ind></trd>
    </trdgrp>
    <trd lng="nl">muziekbibliotheek</trd>
    <trd lng="pl">p&lstroke;ytoteka</trd>
    <trd lng="pt">discoteca</trd>
  </snc>
  <trd lng="be">&c_d;&c_y;&c_s;&c_k;&c_a;&c_t;&c_e;&c_k;&c_a;</trd>
  <trd lng="ca">discoteca</trd>
  <trd lng="cs">diskot&eacute;ka</trd>
  <trd lng="fr">discoth&egrave;que</trd>
  <trd lng="he">&dalet;&yod;&samekh;&qof;&vav;&tet;&qof;</trd>
  <trd lng="ja">&#12524;&#12467;&#12540;&#12489;&#12521;&#12452;&#12502;&#12521;&#12522;</trd>
  <trd lng="oc">discot&egrave;ca</trd>
  <trd lng="sk">diskot&eacute;ka</trd>
  <trd lng="uk">&c_d;&c_i;&c_s;&c_k;&c_o;&c_t;&c_je;&c_k;&c_a;</trd>
</drv>
