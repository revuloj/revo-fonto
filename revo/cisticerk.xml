<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: cisticerk.xml,v 1.1 2026/11/21 19:45:14 afido Exp $">
    <kap>
      <rad>cisticerk</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="cisticerk.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc mrk="cisticerk.0o.larvo">
    <dif>
      <ref tip="super" cel="larv.0o">Larvo</ref> de iuj <ref cel="teni.0o">tenio</ref>j en formo de veziko,
      en kiun etendi&gcirc;as la kapo:
      <ekz>
        en la bova muskolaro la <tld/>oj estas evoluintaj al infekta stadio jam tri
        semajnojn post ingesto de ovoj
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[la]</klr> dua larvo-stadio, la <tld/>o en kiu jam trovi&gcirc;as la enfaldita
        skolekso de la estonta cestodo kun su&ccirc;iloj kaj krono kun hoketoj
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Cysticercus</trd>,
      <trd>Zystizerkus</trd>,
      <trd>Finne <klr>(Bandwurmlarve)</klr></trd>,
      <trd>Blasenwurm</trd>
    </trdgrp>
    <trd lng="en">cysticercus</trd>
    <trd lng="fr">cysticerque</trd>
    <trd lng="ru">&c_c;&c_i;&c_s;&c_t;&c_i;&c_c;&c_je;&c_r;&c_k;</trd>
  </snc>
</drv>

  </art>


