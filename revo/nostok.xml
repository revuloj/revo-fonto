<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: nostok.xml,v 1.2 2026/08/07 17:07:09 afido Exp $">
    <kap>
      <rad>nostok</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="nostok.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">BIO</uzo>
    <dif>
      <ref tip="super" cel="genr.0o.BIO">Genro</ref> de <ref tip="super"
      cel="bakter.ciano0oj">cianobakterioj</ref>j
      (<trd lng="la">Nostoc</trd>),
      formantaj globecajn a&ubreve; membranecajn koloniojn:
      <ekz>
        ili komercas per <tld/>oj, iliaj <tld/>oj bone vendi&gcirc;as en suda &Ccirc;inio, precipe
        en Guangdong-provinco
        <fnt>
          <vrk><url
          ref="https://tempa.bitarkivo.org/gazetoj/ElPopolaChinio/ElPopolaChinio_1998_n09.pdf"
              >Mia vizito al Ningxia</url></vrk>
          <lok>El Popola &Ccirc;inio, 09/1998, p. 4</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Nostoc</trd>
    <trd lng="en">nostoc</trd>
    <trd lng="fr">nostoc</trd>
    <trd lng="ru">&c_n;&c_o;&c_s;&c_t;&c_o;&c_k;</trd>
    <trd lng="uk">&c_n;&c_o;&c_s;&c_t;&c_o;&c_k;</trd>
  </snc>
<trd lng="id">Nostoc (genus)</trd>
</drv>

  </art>

