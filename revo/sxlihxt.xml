<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: sxlihxt.xml,v 1.1 2026/10/25 18:59:12 afido Exp $">
    <kap>
      <rad>&scirc;li&hcirc;t</rad>/o
      <fnt>
          <bib>EBV</bib>
          <lok>bildo 158/44</lok>
        </fnt>
    </kap>

<drv mrk="sxlihxt.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Likva&jcirc;o por glatigi kaj firmigi varpon anta&ubreve; teksado:
      <ekz>
        la saturado de varpo okazas en <klr>[&#x2026;]</klr> en <tld/>o-trogo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=763198"
              >&Scirc;li&hcirc;to</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Schlichte</trd>
    <trd lng="en">size <klr>(weaving)</klr>)</trd>
    <trd lng="fr">solution d'ensimage</trd>
    <trd lng="ru">&c_sh;&c_l;&c_i;&c_h;&c_t;&c_a;</trd>
  </snc>
</drv>

<drv mrk="sxlihxt.0i">
  <kap>
    <tld/>i
  </kap>
  <snc>
    <dif>
      Trasorbigi varpon per <tld/>o:
      <ekz>
        oni prenis la plenan varpotrabon el la <tld/>ma&scirc;ino
        <fnt>
          <aut>Marie Bartovsk&aacute;</aut>
          <vrk><url ref="https://scienca-revuo.info/article/1448"
              >La teksokombilo</url></vrk>
          <lok>Scienca Revuo, 1972 n-ro 95, artikolo 1448</lok>
        </fnt>;
      </ekz>
      <ekz>
        la varpotrabon kun la <tld/>ita varpo oni lokigas en speciala stablo super la
        harneso kaj kombilo
        <fnt>
          <aut>Marie Bartovsk&aacute;</aut>
          <vrk><url ref="https://scienca-revuo.info/article/1448"
              >La teksokombilo</url></vrk>
          <lok>Scienca Revuo, 1972 n-ro 95, artikolo 1448</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="apretu.0i">apreturi</ref>,
      <ref cel="impregn.0i">impregni</ref>
    </refgrp>
    <trd lng="de">schlichten (Kettf&auml;den)</trd>
  </snc>
</drv>

  </art>


