<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: fulg.xml,v 1.27 2026/08/14 13:59:46 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>fulg</rad>/o
  <fnt><bib>UV</bib></fnt>
</kap>

<drv mrk="fulg.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc>
    <dif>
      Nigra densa materio lasita de fumo en kamentuboj:
      <ekz>
        <tld/>okovrita poto
        <fnt>
          <bib>HsT</bib>
          <lok>Feli&ccirc;a homo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la klinitaj, kovritaj per <tld/>o muroj de l' jurt<klr>[o]</klr>
        <fnt>
          <bib>Mizero</bib>
          <lok>II</lok>
        </fnt>;
      </ekz>
      <ekz>
        <ind><tld/>okolora</ind> viza&gcirc;o
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro XXVI</lok>
        </fnt>;
        <trd lng="de">ru&szlig;farbig</trd>
        <trd lng="fr">fuligineux<klr tip="ind"> (couleur)</klr></trd>
        <trd lng="hu">koromfekete</trd>
        <trd lng="nl">roetkleurig</trd>
      </ekz>
      <ekz>
        li trovis la eniron en la inferon, la truo estis nigra kaj kovrita de <tld/>o
        <fnt>
          <bib>ElektFab</bib>
          <lok>Tri oraj haroj de la diablo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <ind><tld/>ofloko</ind>j flugis tiel dense kiel la akridoj <klr>[&#x2026;]</klr> dum plago
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 30</lok>
        </fnt>.
        <trd lng="de">Ru&szlig;flocke</trd>
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="bistr.0o">bistro</ref>
    </refgrp>
  </snc>
  <trd lng="ja">&#x7164;  <pr>&#x3059;&#x3059;</pr></trd>
  <trdgrp lng="be">
    <trd>&c_s;&c_a;&c_zh;&c_a;</trd>,
    <trd>&c_k;&c_u;&c_r;&c_o;&c_d;&c_y;&c_m;</trd>
  </trdgrp>
  <trd lng="bg">&c_s;&c_a;&c_zh;&c_d;&c_i;</trd>
  <trdgrp lng="cs">
    <trd>kopt</trd>,
    <trd>saze</trd>,
    <trd>&ccaron;er&ncaron;</trd>
  </trdgrp>
  <trd lng="de">Ru&szlig;</trd>
  <trd lng="en">soot</trd>
  <trd lng="fr">suie</trd>
  <trd lng="hu">korom</trd>
  <trdgrp lng="id">
    <trd>jelaga</trd>,
    <trd>sulang (2)</trd>
  </trdgrp>
  <trd lng="kek">ab&#x315;aq</trd>
  <trd lng="nl">roet</trd>
  <trdgrp lng="pl">
    <trd>sadza</trd>,
    <trd>kope&cacute;<klr> (przest.)</klr></trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>fuligem</trd>,
    <trd>picum&atilde;</trd>
  </trdgrp>
  <trd lng="ru">&c_s;&c_a;&c_zh;&c_a;</trd>
  <trd lng="sk">sadza</trd>
  <trd lng="uk">&c_s;&c_a;&c_zh;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#x70B2; <pr>tai</pr></trd>,
    <trd>&#x78B3;&#x9ED1; <pr>t&agrave;nh&emacron;i</pr></trd>,
    <trd>&#x6CB9;&#x70DF; <pr>y&oacute;uy&amacron;n</pr></trd>,
    <trd>&#x70B1; <pr>t&aacute;i</pr></trd>,
    <trd>&#x70AD;&#x9ED1; <pr>t&agrave;nh&emacron;i</pr></trd>,
    <trd>&#x7164;&#x7070; <pr>m&eacute;ihu&imacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="fulg.0a">
  <kap>
    <tld/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        <tld/>aj muroj
        <fnt>
          <bib>SrT</bib>
          <lok>Libro IV.</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>aj strioj makulis lian viza&gcirc;on
        <fnt>
          <bib>StU</bib>
          <lok>La Nazaretanoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        la vespero metis sian nigran, <tld/>an, truan tukon sur la mondon
        <fnt>
          <bib>KKr</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        li sur&jcirc;etis kelkajn lignopecojn kaj pendigis <tld/>an kafujon sur hokon super la
        fajron
        <fnt>
          <bib>VRA</bib>
          <lok>Birger Vikstr&ouml;m</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>ru&szlig;ig</trd>,
    <trd>Ru&szlig;-</trd>
  </trdgrp>
</drv>

<drv mrk="fulg.0i">
  <kap>
    <tld/>i
  </kap>
  <snc>
    <dif>
      Fumi kun <tld/>o:
      <ekz>
        <tld/>anta petrola lampo
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 28</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">ru&szlig;en</trd>
</drv>

<drv mrk="fulg.0igi">
  <kap><tld/>igi</kap>
  <snc>
    <dif>
      Nigrigi, makuli per <tld/>o:
      <ekz>
        <tld/>igita kameno.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_u;&c_r;&c_e;&c_c;&c_mol;</trd>
    <trd>&c_k;&c_u;&c_r;&c_o;&c_d;&c_y;&c_m;&c_ib;&c_c;&c_mol;</trd>,
    <trd>&c_z;&c_a;&c_k;&c_u;&c_r;&c_o;&c_d;&c_y;&c_m;&c_ib;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="cs">za&ccaron;adit</trd>
  <trdgrp lng="de">
    <trd>ru&szlig;en <klr>(schw&auml;rzen)</klr></trd>,
    <trd>ru&szlig;schw&auml;rzen</trd>
  </trdgrp>
  <trd lng="en">blacken <klr tip="amb">(with soot)</klr></trd>
  <trd lng="fr">noircir &agrave; la suie</trd>
  <trd lng="hu">bekormoz</trd>
  <trdgrp lng="id">
    <trd><baz>jelaga</baz>menjelagai</trd>,
    <trd><baz>sulang</baz>menyulangi</trd>,
    <trd><baz>hitam</baz>menghitamkan dgn jelaga/sulang</trd>
  </trdgrp>
  <trd lng="ja">&#x3059;&#x3059;&#x3051;&#x3055;&#x305B;&#x308B;</trd>
  <trd lng="nl">zwartblakeren</trd>
  <trdgrp lng="pl">
    <trd>kopci&cacute;</trd>,
    <trd>okapca&cacute;</trd>
  </trdgrp>
  <trd lng="ru">&c_z;&c_a;&c_k;&c_o;&c_p;&c_t;&c_i;&c_t;&c_mol;</trd>
  <trd lng="sk">za&ccaron;adi&tcaron;</trd>
  <trd lng="zh">&#x7164;&#x7070; <pr>m&eacute;ihu&imacron;</pr></trd>
</drv>
</art>
