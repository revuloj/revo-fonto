<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: lukt.xml,v 1.35 2026/09/19 18:00:21 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>lukt</rad>/i <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="lukt.0i">
  <kap><tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="lukt.0i.SPO">
    <dif>
      Korpe batali kontra&ubreve; iu:
      <ekz>
        iu <tld/>is kun li &gcirc;is la apero de la matenru&gcirc;o
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 32:24</lok>
        </fnt>;
      </ekz>
      <ekz>
        la glavo estis akrigata, la <tld lit="L"/>istoj <tld/>is pri la diino de beleco
        <fnt>
          <bib>Fab1</bib>
          <lok>Kupra porko</lok>
        </fnt>;
      </ekz>
      <ekz>
        la aliaj friponoj kaptis lin, <tld/>is kun li, fleksis lin tiel, ke lia kapo
        atingis liajn piedojn
        <fnt>
          <bib>Fab3</bib>
          <lok>Historio</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="barakt.0i">barakti</ref>.
    </refgrp>
    <trd lng="ca">lluitar</trd>
    <trdgrp lng="en">
      <trd>wrestle <klr>(physically)</klr></trd>,
      <trd>fight <klr>(physically)</klr></trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>harcol</trd>,
      <trd>k&uuml;zd</trd>
    </trdgrp>
    <trd lng="nl">worstelen</trd>
    <trdgrp lng="pl">
      <trd>si&lstroke;owa&cacute; si&eogonek;</trd>,
      <trd>mocowa&cacute; si&eogonek;</trd>,
      <trd>zmaga&cacute; si&eogonek;</trd>
    </trdgrp>
  </snc>
  <snc mrk="lukt.0i.FIG">
    <dif>
      Peni, klopodi por venki malhelpon a&ubreve; atingi malfacilan rezulton:
      <ekz>
        <tld/>i por siaj ideoj, por kandidato, kontra&ubreve; la tuberkulozo, kontra&ubreve; mizero,
        morto, ventego, konkurenco;
      </ekz>
      <ekz>
        mi turmenti&gcirc;is, mi <tld/>is kaj strebis por la infano, mi frotpurigadis
        &scirc;tuparojn kaj lavadis tola&jcirc;on <klr>[&#8230;]</klr>
        <fnt>
          <bib>Fab3</bib>
          <lok>&Scirc;i estis tute senta&ubreve;ga</lok>
        </fnt>;
      </ekz>
      <ekz>
        vere, nun mi sufi&ccirc;e suferis kaj <tld/>is <klr>[kontra&ubreve; la tento]</klr>! nun mi
        opinias, ke mi estas tiel same bona, kiel multaj el tiuj, kiuj sidas en la
        pre&gcirc;ejo
        <fnt>
          <bib>Fab2</bib>
          <lok>Ru&gcirc;aj &scirc;uoj</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>lluitar</trd>,
      <trd>combatre</trd>
    </trdgrp>
    <trdgrp lng="en">
      <trd>wrestle <klr>(figuratively)</klr></trd>,
      <trd>fight <klr>(figuratively)</klr></trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>k&uuml;zd</trd>,
      <trd>s&iacute;krasz&aacute;ll</trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>(ergens mee) <ind>worstelen</ind></trd>,
      <trd>zwoegen</trd>,
      <trd>ploeteren</trd>
    </trdgrp>
    <trd lng="pl">boryka&cacute; si&eogonek;</trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_m;&c_a;&c_g;&c_a;&c_c;&c_c;&c_a;</trd>,
    <trd>&c_d;&c_u;&c_zh;&c_a;&c_c;&c_c;&c_a;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>bojovat</trd>,
    <trd>b&iacute;t se</trd>,
    <trd>z&aacute;pasit</trd>
  </trdgrp>
  <trd lng="de">ringen</trd>
  <trdgrp lng="el">
    <trd>&alfa;&gamma;&omega;&ny;&jota_ton;&zeta;&omikron;&my;&alfa;&jota;</trd>,
    <trd>&pi;&alfa;&lambda;&epsilon;&ypsilon_ton;&omega;</trd>
  </trdgrp>
  <trd lng="es">luchar</trd>
  <trd lng="fr">lutter</trd>
  <trd lng="hu">birk&oacute;z&aacute;s</trd>
  <trdgrp lng="ja">
    <trd>&#26684;&#38360;&#12377;&#12427;  <pr>&#12363;&#12367;&#12392;&#12358;&#12377;&#12427;</pr></trd>,
    <trd>&#12524;&#12473;&#12522;&#12531;&#12464;&#12434;&#12377;&#12427;  <pr>&#12428;&#12377;&#12426;&#12435;&#12368;&#12434;&#12377;&#12427;</pr></trd>,
    <trd>&#38360;&#12358;  <pr>&#12383;&#12383;&#12363;&#12358;</pr></trd>
  </trdgrp>
  <trd lng="pt">lutar</trd>
  <trd lng="ru">&c_b;&c_o;&c_r;&c_o;&c_t;&c_mol;&c_s;&c_ja;</trd>
  <trd lng="sk">z&aacute;pasi&tcaron;</trd>
  <trd lng="uk">&c_b;&c_o;&c_r;&c_o;&c_t;&c_i;&c_s;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#25615;&#20987; <pr>b&oacute;j&imacron;</pr></trd>,
    <trd>&#25615;&#25802; <pr>b&oacute;j&imacron;</pr></trd>,
    <trd>&#25197;&#25171; <pr>ni&#468;d&#462;</pr></trd>,
    <trd>&#25684;&#35282; <pr>shu&amacron;iji&#462;o</pr></trd>,
    <trd>&#35282;&#25269; <pr>ju&eacute;d&#464;</pr></trd>,
    <trd>&#25684;&#36324; <pr>shu&amacron;iji&amacron;o</pr></trd>,
    <trd>&#25340;&#25615; <pr>p&imacron;nb&oacute;</pr></trd>,
    <trd>&#22859;&#25112; <pr>f&egrave;nzh&agrave;n</pr></trd>,
    <trd>&#22894;&#25136; <pr>f&egrave;nzh&agrave;n</pr></trd>,
    <trd>&#22859;&#26007; <pr>f&egrave;nd&ograve;u</pr></trd>,
    <trd>&#22894;&#39717; <pr>f&egrave;nd&ograve;u</pr></trd>,
    <trd>&#25171;&#25340; <pr>d&#462;p&imacron;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="lukt.0o">
  <kap><tld/>o</kap>
  <snc mrk="lukt.0o.ago">
    <dif>
      Ago <tld/>i:
      <ekz>
        <nom>Ra&hcirc;el</nom> diris: per Dia <tld/>o mi <tld/>is kun mia fratino, kaj mi venkis
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 30:8</lok>
        </fnt>;
      </ekz>
      <ekz>
        ve! post <tld/>o vanas larmofer'
        <fnt>
          <aut>Raymond Schwartz</aut>
          <vrk><url ref="&Steloj;butiko">La Stranga Butiko</url></vrk>
          <lok>Pri Somero</lok>
        </fnt>;
      </ekz>
      <ekz>
        la a&ubreve;toro eliris de la principo, ke <tld/>o kontra&ubreve; rasismo komenci&gcirc;as per
        edukado
        <fnt>
	<aut>Jorge Camacho</aut>
	<vrk><url ref="&Monato;/2000/006810.php">Diskutige kaj diskutinde</url></vrk>
	<bib>Monato</bib>
	<lok>2000/08, p. 25</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o de povoj, <tld/>o de interesoj, <tld/>o por la tutmonda hegemonio
        <fnt>
          <bib>Monato</bib>
          <aut>Carlo Minnaja</aut>
          <vrk><url ref="&Monato;/2003/008022.html">Tridek jaroj da sa&gcirc;o</url></vrk>
          <lok>2003</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Ringen</trd>
  <trd lng="en">fight</trd>
  </snc>
  <snc mrk="lukt.0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      Iu el la <ref tip="super" cel="sport.0o.SPO">sportoj</ref>
      en kiuj praktikanto penas sub difinitaj reguloj
      teren renversi a&ubreve; senmovigi la kontra&ubreve;ulon:
      <ekz>
        sumoo, la japana tradicia <tld/>o rigardata kiel nacia sporto
        <fnt>
          <bib>Monato</bib>
          <aut>Hori Jasuo</aut>
          <vrk><url ref="&Monato;/2010/010127.php">Malplenaj kapoj, plenaj
          korpoj</url></vrk>
          <lok>2010</lok>
        </fnt>;
      </ekz>
      <ekz>
        &jcirc;udo estas internacia <tld/>osporto kaj olimpika ludo
        <fnt>
          <bib>Monato</bib>
          <aut>Isikawa Takasi</aut>
          <vrk><url ref="&Monato;/2015/011410.php">Malmoli&gcirc;as la mola vojo</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="cs">
      <trd>boj</trd>,
      <trd>z&aacute;pas</trd>
    </trdgrp>
    <trd lng="de">Ringkampf</trd>
    <trdgrp lng="en">
      <trd>wrestling <klr>(sport)</klr></trd>,
      <trd>boxing <klr>(sport)</klr></trd>
    </trdgrp>
    <trd lng="es">lucha<klr> (deporte)</klr></trd>
    <trd lng="fr">lutte</trd>
    <trd lng="nl">worstelen<klr tip="ind"> (sport)</klr></trd>
    <trd lng="pl">zapasy</trd>
    <trdgrp lng="sk">
      <trd>boj</trd>,
      <trd>z&aacute;pas</trd>
    </trdgrp>
    <trd lng="zh">&#25684;&#35282; <pr>shu&amacron;iji&#462;o</pr></trd>
</snc>
    <trdgrp lng="be">
      <trd>&c_z;&c_m;&c_a;&c_g;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>,
      <trd>&c_d;&c_u;&c_zh;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>,
      <trd>&c_b;&c_a;&c_r;&c_a;&c_c;&c_mol;&c_b;&c_a;</trd>,
      <trd>&c_b;&c_o;&c_r;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>
    </trdgrp>
  <trdgrp lng="ca">
    <trd>lluita</trd>,
    <trd>combat</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#26684;&#38360;  <pr>&#12363;&#12367;&#12392;&#12358;</pr></trd>,
    <trd>&#12524;&#12473;&#12522;&#12531;&#12464;</trd>,
    <trd>&#38360;&#12356;  <pr>&#12383;&#12383;&#12363;&#12356;</pr></trd>
  </trdgrp>
  <trd lng="uk">&c_b;&c_o;&c_r;&c_o;&c_t;&c_mol;&c_b;&c_a;</trd>
</drv>

<drv mrk="lukt.inter0i">
  <kap>inter<tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="lukt.inter0i.KOMUNE">
    <dif>
      <tld lit="L"/>i unu kontra&ubreve; la alia:
      <ekz>
        al mi pla&ccirc;us vidi, se <nom>Lauri</nom> kaj <nom>Eero</nom> inter<tld/>us
        <fnt><aut>A. Kivi, trad. I. Ekstr&ouml;m</aut>, <vrk>Sep
        fratoj</vrk>, <lok>1947</lok></fnt>.
      </ekz>
    </dif>
  <trd lng="en">fight <klr>(against each other)</klr></trd>
  </snc>
  <trd lng="be">&c_z;&c_m;&c_a;&c_g;&c_a;&c_c;&c_c;&c_a;
  <klr>(&c_p;&c_a;&c_m;&c_ib;&c_zh;&c_s;&c_o;&c_b;&c_k;&c_u;)</klr></trd>
  <trd lng="ca">lluitar<klr tip="amb"> (un contra un altre)</klr></trd>
  <trd lng="fr">se <ind>combattre</ind></trd>
  <trdgrp lng="zh">
    <trd>&#35942; <pr>q&uacute;</pr></trd>,
    <trd>&#23545;&#25171; <pr>du&igrave;d&#462;</pr></trd>,
    <trd>&#23565;&#25171; <pr>du&igrave;d&#462;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="lukt.klasikstila0o">
  <kap>klasikstila <tld/>o<fnt><aut>T. Ujlaky-Nagy</aut>,<vrk>La sporta
  lingvo en Esperanto</vrk>,<lok>1972</lok></fnt>,
  <var><kap>grekromia <tld/>o</kap></var></kap>
  <snc mrk="lukt.klasikstila0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      <ref tip="super" cel="lukt.0o.SPO"><tld lit="L"/>o</ref>
      parte imitanta la grek-romian manieron,
      en kiu <tld/>antoj uzas nur la brakojn kaj
      kaptas nur super la talio:
      <ekz>
        la kulmino de la mistifiko estis la helen-romiaj <tld/>oj
        <fnt>
          <aut>S. Bubeni&ccaron;</aut>,
          <vrk>Sub Cirkotendo</vrk>,
          <lok>1969</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="en">Greco-Roman <ind>wrestling</ind></trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_g;&c_r;&c_e;&c_k;&c_a;-&c_r;&c_y;&c_m;&c_s;&c_k;&c_a;&c_ja;
    <ind>&c_b;&c_a;&c_r;&c_a;&c_c;&c_mol;&c_b;&c_a;</ind></trd>,
    <trd>&c_k;&c_l;&c_ja;&c_s;&c_y;&c_ch;&c_n;&c_a;&c_ja;
    <ind>&c_b;&c_a;&c_r;&c_a;&c_c;&c_mol;&c_b;&c_a;</ind></trd>
  </trdgrp>
  <trd lng="ca">lluita grecoromana</trd>
  <trd lng="cs">&rcaron;ecko&rcaron;&iacute;msk&yacute; z&aacute;pas</trd>
  <trd lng="fr">lutte gr&eacute;co-romaine</trd>
  <trd lng="nl">Grieks-Romeins worstelen</trd>
  <trd lng="pl">zapasy <klr>klasyczne</klr></trd>
  <trd lng="sk">gr&eacute;ckor&iacute;msky z&aacute;pas</trd>
</drv>
</art>
