<drv mrk="cxj.av0o">
  <kap>av<tld/>o, <var><kap>a<tld/>o</kap></var></kap>
  <snc mrk="cxj.av0o.KOMUNE">
    <dif>
      Karesvorto por <ref tip="sin" cel="av.0o">avo</ref>:
      <ekz>
        Teo, &ccirc;irka&ubreve;brakante unu el la kruroj de la avo, <klr>[&#8230;]</klr> diris plue:&ndash; Nu,
        a<tld/>o
        <fnt>
          <bib>IdO</bib>
          <lok>Tria Parto</lok>
        </fnt>?
      </ekz>
      <ekz>
        kiam av<tld/>o ankora&ubreve; lo&gcirc;is en <nom>South Carolina</nom> <klr>[&#8230;]</klr>
        <fnt><bib>Mortul&Scirc;ip</bib>, <lok>unua libro, &ccirc;apitro
        6a</lok></fnt>;
      </ekz>
      <ekz>
        av<tld/>o finis rakonti, sentante sin, evidente, tre vigla
        <fnt>
          <bib>Kon11</bib>
          <lok>Rakonto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_d;&c_z;&c_ja;&c_d;&c_u;&c_l;&c_ja;</trd>,
    <trd>&c_d;&c_z;&c_ja;&c_d;&c_u;&c_n;&c_ja;</trd>
  </trdgrp>
  <trd lng="bg">&c_d;&c_ja;&c_d;&c_o;</trd>
  <trdgrp lng="ca">
    <trd>avi<klr tip="ind"> (diminutiu)</klr></trd>,
    <trd>padr&iacute;<klr tip="ind"> (diminutiu)</klr></trd>,
    <trd>iaio<klr tip="ind"> (diminutiu)</klr></trd>,
    <trd>jai<klr tip="amb"> (diminutiu)</klr></trd>
  </trdgrp>
