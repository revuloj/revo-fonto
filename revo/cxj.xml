<subart>
<drv mrk="cxj.0">
  <kap>-<tld/></kap>
  <snc>
    <dif>
      Sufikso karesa almetata post la unua a&ubreve; unuaj silaboj
      de vira nomo a&ubreve; alia vorto indikanta viron:
      <ekz>
        <ind>se Pe<tld/>o ne semos, Petro ne rikoltos</ind>
        <trd lng="hu">ha Jancsi nem vet, J&aacute;nos nem arat</trd>
        <trd lng="pl">czego Ja&sacute; si&eogonek; nie nauczy, tego Jan
        nie b&eogonek;dzie umia&lstroke;</trd>
        <fnt><bib>PrV</bib></fnt>
      </ekz>
      <ekz>
        Nikolao, Nikol<tld/>o, Nik<tld/>o, Ni<tld/>o;
      </ekz>
      <ekz>
        A&ubreve;gu<tld/>o kaj A&ubreve;gunjo estas bonaj infanoj
        <fnt>
          <bib>DL</bib>
          <lok>Dua Libro de l' Lingvo Internacia</lok>
        </fnt>;
      </ekz>
      <ekz>
        Jo<tld/>o
        <fnt>
          <bib>ChR</bib>
          <lok>Spiona rondo</lok>
        </fnt>;
      </ekz>
      <ekz>
        Iva<tld/>o
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 12 (62)</lok>
        </fnt>;
      </ekz>
      <ekz>
        Edu<tld/>o
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        la aventuroj de Tin<tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Mariana Evlogieva</aut>
          <vrk><url ref="&Monato;/2011/010151.php"
              >Instrua, instiga, inspira!</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz>
      <ekz>
        Mi<tld/>o, sesjara knabo
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 7 (57)</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="icx.0">i&ccirc;</ref>,
      <ref cel="nj.0">nj</ref>,
      <ref cel="et._0.sufikso">et</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_l;&c_a;&c_s;&c_k;&c_a;&c_l;&c_mol;&c_n;&c_y; &c_a;&c_f;&c_ib;&c_k;&c_s; &c_u; &c_e;&c_s;&c_p;&c_e;&c_r;&c_a;&c_n;&c_t;&c_a; <klr>(&c_d;&c_l;&c_ja; &c_m;&c_u;&c_zh;&c_ch;&c_y;&c_n;)</klr></trd>
  <trd lng="en">diminutive masculine suffix of endearment <klr>(-y angle
  estas amba&ubreve;seksa)</klr></trd>
  <trd lng="es">-ito<klr> (diminutivo cari&ntilde;oso masculino)</klr></trd>
  <trdgrp lng="fr">
    <trd>-ot<klr> (diminutif masculin)</klr></trd>,
    <trd>-ou<klr> (diminutif masculin)</klr></trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>-<ind>ka/ke</ind><klr> (f&eacute;rfin&eacute;v
    kicsiny&iacute;t&odblac;k&eacute;pz&odblac;)</klr></trd>,
    <trd>-<ind>cska/cske</ind><klr> (f&eacute;rfin&eacute;v
    kicsiny&iacute;t&odblac;k&eacute;pz&odblac;)</klr></trd>
  </trdgrp>
  <trdgrp lng="it">
    <trd>-ino<klr> (diminutivo maschile)</klr></trd>,
    <trd>-etto<klr> (diminutivo maschile)</klr></trd>,
    <trd>-uccio<klr> (vezzeggiativo maschile)</klr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>-tje<klr tip="ind"> (mannelijk diminutiefsuffix)</klr></trd>,
    <trd>-pje<klr tip="ind"> (mannelijk diminutiefsuffix)</klr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>-cio<klr> (zdrobnienie rzecz. rodz.
    m&eogonek;skiego)</klr></trd>,
    <trd>-ek<klr> (zdrobnienie rzecz. rodz.
    m&eogonek;skiego)</klr></trd>,
    <trd>-u&sacute;<klr> (zdrobnienie rzecz. rodz.
    m&eogonek;skiego)</klr></trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>-ito<klr> (diminutivo carinhoso masculino)</klr></trd>,
    <trd>-inho<klr> (diminutivo carinhoso masculino)</klr></trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>-<ind>&c_k;&c_a;</ind><klr tip="ind">
    (&c_l;&c_a;&c_s;&c_k;&c_a;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_y;&c_j;
    &c_s;&c_u;&c_f;&c_f;&c_i;&c_k;&c_s;
    &c_m;&c_u;&c_zh;&c_s;&c_k;&c_o;&c_g;&c_o;
    &c_r;&c_o;&c_d;&c_a;)</klr></trd>,
    <trd>-<ind>&c_ch;&c_k;&c_a;</ind><klr tip="ind">
    (&c_l;&c_a;&c_s;&c_k;&c_a;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_y;&c_j;
    &c_s;&c_u;&c_f;&c_f;&c_i;&c_k;&c_s;
    &c_m;&c_u;&c_zh;&c_s;&c_k;&c_o;&c_g;&c_o;
    &c_r;&c_o;&c_d;&c_a;)</klr></trd>,
    <trd>-<ind>&c_n;&c_mol;&c_k;&c_a;</ind><klr tip="amb">
    (&c_l;&c_a;&c_s;&c_k;&c_a;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_y;&c_j;
    &c_s;&c_u;&c_f;&c_f;&c_i;&c_k;&c_s;
    &c_m;&c_u;&c_zh;&c_s;&c_k;&c_o;&c_g;&c_o;
    &c_r;&c_o;&c_d;&c_a;)</klr></trd>
  </trdgrp>
</drv>
