<subart>
<dif>
  Uzo en kelkaj vortoj (parencoj k.a.):
</dif>
<drv mrk="cxj.av0o">
  <kap>av<tld/>o, <var><kap>a<tld/>o</kap></var></kap>
  <snc mrk="cxj.av0o.KOMUNE">
    <dif>
      Karesvorto por <ref tip="sin" cel="av.0o">avo</ref>:
      <ekz>
        Teo, &ccirc;irka&ubreve;brakante unu el la kruroj de la avo, <klr>[&#x2026;]</klr> diris plue:&ndash; Nu,
        a<tld/>o
        <fnt>
          <bib>IdO</bib>
          <lok>Tria Parto</lok>
        </fnt>?
      </ekz>
      <ekz>
        kiam av<tld/>o ankora&ubreve; lo&gcirc;is en <nom>South Carolina</nom> <klr>[&#x2026;]</klr>
        <fnt><bib>Mortul&Scirc;ip</bib>, <lok>unua libro, &ccirc;apitro
        6a</lok></fnt>;
      </ekz>
      <ekz>
        av<tld/>o finis rakonti, sentante sin, evidente, tre vigla
        <fnt>
          <bib>Kon11</bib>
          <lok>Rakonto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_d;&c_z;&c_ja;&c_d;&c_u;&c_l;&c_ja;</trd>,
    <trd>&c_d;&c_z;&c_ja;&c_d;&c_u;&c_n;&c_ja;</trd>
  </trdgrp>
  <trd lng="bg">&c_d;&c_ja;&c_d;&c_o;</trd>
  <trd lng="de"> Opa </trd>
  <trd lng="en">grandpa</trd>
  <trdgrp lng="es">
    <trd>abuelito</trd>,
    <trd>yayo</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>papi</trd>,
    <trd>papy</trd>,
    <trd>p&eacute;p&eacute;</trd>,
    <trd>grand-papa</trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>kakung</trd>,
    <trd>opa</trd>
  </trdgrp>
  <trdgrp lng="it">
    <trd>nonnino</trd>,
    <trd>nonnetto<klr> (ironico)</klr></trd>
  </trdgrp>
  <trd lng="ja">&#x304A;&#x3058;&#x3044;&#x3061;&#x3083;&#x3093;</trd>
  <trd lng="nl">opa</trd>
  <trdgrp lng="pl">
    <trd>dziadziu&sacute;</trd>,
    <trd>dziadzio</trd>
  </trdgrp>
  <trd lng="ru">&c_d;&c_je;&c_d;&c_u;&c_sh;&c_k;&c_a;</trd>
</drv>

