<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ekzokrin.xml,v 1.14 2026/09/24 10:30:18 revo Exp $">
<kap>
  <rad>ekzokrin</rad>/a <fnt><bib>NePiv</bib></fnt>
</kap>
<drv mrk="ekzokrin.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">FIZL</uzo>
  <snc mrk="ekzokrin.0a.KOMUNE">
    <uzo tip="stl">KOMUNE</uzo>
      <dif>
        Rilata al la <tld/>aj <ref tip="vid" cel="gland.0o">glandoj</ref>:
        <ekz>
          <tld/>a sekrecio.
        </ekz>
      </dif>
  </snc>
  <snc mrk="ekzokrin.0a.FIZL">
  <uzo tip="klr">(pri glando)</uzo>
      <dif>
        Ellasanta sian sekrecia&jcirc;on en la eksteran medion (sur la ha&ubreve;ton)
        a&ubreve; en naturan kavon komuniki&gcirc;antan kun la ekstera medio (ekz. la
        digestotubon):
        <ekz>
          plejofte <tld/>aj glandoj elver&scirc;as siajn
          sekrecia&jcirc;on eksteren pere de <ref tip="vid" cel="sekrec.el0a">elsekrecia</ref> dukto (ekz.
          la &scirc;vitaj, salivaj, larmaj glandoj) sed ili kelkfoje estas senduktaj (ekz.
          la en-epiteliaj glandoj &ccirc;e la vira uretro);
        </ekz>
        <ekz>
          biologie, haroj kaj similaj fenomenoj estas nur sekrecioj de
          <tld/>aj glandoj, fari&gcirc;intaj sufi&ccirc;e solidaj, por resti a&ubreve; kiel
          flekseblaj haroj, a&ubreve; kiel pli solida skvamo, &scirc;elo,
          ungo, hufo
          <fnt>
            <aut>E. Pauli</aut>,
            <vrk><url ref="http://www.cfh.ufsc.br/~simpozio/">Enciklopedio
            simpozio</url></vrk>,
            <lok>artikolo &leftquot;haro&rightquot;, 1996-05</lok>
          </fnt>.
        </ekz>
      </dif>
    <adm>
      Anta&ubreve;a difino indikis ke la terminoj "~a" kaj
      "endokrina"
      estas maloftaj kaj redirektis al respektive
      "dukta" kaj "sendukta". Tio estas erara.
      Efektive, la ~aj glandoj plejparte estas duktohavaj sed ne
      &ccirc;iuj. Kelkaj el ili estas senduktaj (ekzemple la supra&jcirc;aj
      ~aj glandoj &ccirc;e la naza, stomaka a&ubreve; uretra epitelio) kiel la
      endokrinaj glandoj.
    </adm>
  </snc>
  <refgrp tip="vid">
    <ref cel="endokrin.0a">endokrina</ref>,
    <ref cel="amfikrin.0a">amfikrina</ref>
  </refgrp>
  <trdgrp lng="be">
    <trd>&c_e;&c_k;&c_z;&c_a;&c_k;&c_r;&c_y;&c_n;&c_n;&c_y;</trd>,
    <trd>&c_z;&c_mol;&c_n;&c_je;&c_sh;&c_n;&c_je;&c_s;&c_a;&c_k;&c_r;&c_e;&c_c;&c_y;&c_j;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="ca">exocr&iacute;</trd>
  <trd lng="de">exokrine</trd>
  <trd lng="en">exocrine</trd>
  <trdgrp lng="fa">
    <trd>&a_b;&a_r;&a_w;&a_n;&zwnj;&a_r;&f_y;&a_z;</trd>,
    <trd>&a_A;&f_g;&a_z;&a_w;&f_k;&a_r;&f_y;&a_n;</trd>
  </trdgrp>
  <trd lng="fr">exocrine</trd>
  <trdgrp lng="hu">
    <trd>exokrin</trd>,
    <trd>k&uuml;ls&odblac; elv&aacute;laszt&aacute;s&uacute;</trd>
  </trdgrp>
  <trd lng="it">esocrino</trd>
  <trd lng="pl">zewn&aogonek;trzwydzielniczy</trd>
  <trd lng="pt">ex&oacute;crino</trd>
  <trd lng="ro">exocrine</trd>
  <trdgrp lng="uk">
    <trd>&c_je;&c_k;&c_z;&c_o;&c_k;&c_r;&c_i;&c_n;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_z;&c_o;&c_v;&c_n;&c_ib;&c_sh;&c_n;&c_mol;&c_o;-&c_s;&c_je;&c_k;&c_r;&c_je;&c_t;&c_o;&c_r;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
</drv>
</art>

