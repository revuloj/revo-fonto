<kap><ofc>8</ofc>
<rad>fu&gcirc;</rad>/i <fnt><bib>PV</bib></fnt></kap>
<drv mrk="fugx.0i">
  <kap><tld/>i</kap>
  <gra><vspec>x</vspec></gra>
  <snc>
    <dif>
      <ref tip="sin" cel="kur.for0i">Forkuri</ref> por sin <ref cel="sav.0i">savi</ref> de
      reala a&ubreve; imagita dan&gcirc;ero:
      <ekz>
        la sango fluis al lia kapo kaj <klr>[&#x2026;]</klr> kure li <tld/>is de tie
        <fnt>
          <bib>LGA</bib>
        </fnt>;
      </ekz>
      <ekz>
        forlasinte la a&ubreve;tomobilon, ili <tld/>as strateton
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iuminute preta <tld/>i
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        kelkaj a&ubreve;toj &ccirc;irka&ubreve;umis ilin tiel, ke neniu povis <tld/>i
        <fnt>
          <bib>VaK</bib>
        </fnt>;
      </ekz>
      <ekz>
        ili laboris sur la sovetia flanko kun ia scienca brigado, kaj decidis <tld/>i al
        Norvegio
        <fnt>
          <bib>CKv</bib>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        &scirc;i <tld/>is <klr>(<ref cel="tir.re0i">retirigis</ref>)</klr> al siaj libroj
        <fnt>
          <bib>KKr</bib>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        pli malproksimen <tld/>os la oratoro de kiu ajn konkreta morala dogmaro
        <fnt>
          <bib>Ret</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="sav.sin_for0i">sin forsavi</ref>,
      <ref cel="rifugx.0i">rifu&gcirc;i</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_u;&c_c;&c_ja;&c_k;&c_a;&c_c;&c_mol; <klr>(&c_a;&c_d; &c_p;&c_a;&c_g;&c_r;&c_o;&c_z;&c_y;)</klr></trd>
  <trd lng="ca">fugir</trd>
  <trdgrp lng="de">
    <trd>fliehen</trd>,
    <trd>fl&uuml;chten</trd>
  </trdgrp>
  <trd lng="en">flee</trd>
  <trd lng="es">fugar</trd>
  <trdgrp lng="fa">
    <trd>&f_g;&a_r;&f_y;&a_kh;&a_t;&a_n;</trd>,
    <trd>&a_f;&a_r;&a_A;&a_r; &f_k;&a_r;&a_d;&a_n;</trd>
  </trdgrp>
  <trd lng="fr">fuir</trd>
  <trd lng="hu">(el)<ind>menek&uuml;l</ind></trd>
  <trdgrp lng="ja">
    <trd>&#x9003;&#x3052;&#x308B;  <pr>&#x306B;&#x3052;&#x308B;</pr></trd>,
    <trd>&#x9003;&#x8D70;&#x3059;&#x308B;  <pr>&#x3068;&#x3046;&#x305D;&#x3046;&#x3059;&#x308B;</pr></trd>,
    <trd>&#x9003;&#x4EA1;&#x3059;&#x308B;  <pr>&#x3068;&#x3046;&#x307C;&#x3046;&#x3059;&#x308B;</pr></trd>,
    <trd>&#x9003;&#x907F;&#x3059;&#x308B;  <pr>&#x3068;&#x3046;&#x3072;&#x3059;&#x308B;</pr></trd>
  </trdgrp>
  <trd lng="nl">vluchten</trd>
  <trdgrp lng="pl">
    <trd>uciec</trd>,
    <trd>czmycha&cacute;</trd>,
    <trd>zwiewa&cacute;</trd>,
    <trd>wymyka&cacute; si&eogonek;</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>fugir</trd>,
    <trd>escapar</trd>,
    <trd>evadir-se</trd>,
    <trd>escapulir</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_u;&c_b;&c_je;&c_zh;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_s;&c_p;&c_a;&c_s;&c_t;&c_i;&c_s;&c_mol; &c_b;&c_je;&c_g;&c_s;&c_t;&c_v;&c_o;&c_m;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_t;&c_ib;&c_k;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_u;&c_t;&c_ib;&c_k;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_r;&c_ja;&c_t;&c_u;&c_v;&c_a;&c_t;&c_i;&c_s;&c_ja; &c_v;&c_t;&c_je;&c_ch;&c_je;&c_ju;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x9003;&#x96BE; <pr>t&aacute;on&agrave;n</pr></trd>,
    <trd>&#x9003;&#x7A9C; <pr>t&aacute;ocu&agrave;n</pr></trd>,
    <trd>&#x9003; <pr>t&aacute;o</pr></trd>,
    <trd>&#x9003;&#x79BB; <pr>t&aacute;ol&iacute;</pr></trd>,
    <trd>&#x9003;&#x5954; <pr>t&aacute;ob&egrave;n</pr></trd>,
    <trd>&#x9003;&#x4EA1; <pr>t&aacute;ow&aacute;ng</pr></trd>,
    <trd>&#x751F;&#x7B0B; <pr>sh&emacron;ngs&#x1D4;n</pr></trd>,
    <trd>&#x98DB;&#x8D70; <pr>f&emacron;iz&#x1D2;u</pr></trd>,
    <trd>&#x907F; <pr>b&igrave;</pr></trd>,
    <trd>&#x900B; <pr>b&umacron;</pr></trd>,
    <trd>&#x9003;&#x8D70; <pr>t&aacute;oz&#x1D2;u</pr></trd>,
    <trd>&#x6E9C;&#x8D70; <pr>li&umacron;z&#x1D2;u</pr></trd>,
    <trd>&#x9003;&#x907F; <pr>t&aacute;ob&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="fugx.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      La ago de iu, kiu <tld/>as, a&ubreve; la stato de <tld/>ado:
      <ekz>
        <klr>[li]</klr> parolis pri <klr>[&#x2026;]</klr> sia <tld/>o el la &ccirc;efurbo de la
        filistra ordo
        <fnt>
          <bib>LGA</bib>
        </fnt>;
      </ekz>
      <ekz>
        romano <klr>[&#x2026;]</klr> pri la <tld/>o el siberia militkaptitejo
        <fnt>
          <bib>EeP</bib>
        </fnt>;
      </ekz>
      <ekz>
        turmentega morto <klr>[&#x2026;]</klr> atendis min, kaj kiun mi povis eviti per nenio
        alia ol la nokta <tld/>o
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="rifugx.0o">rifu&gcirc;o</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_u;&c_c;&c_jo;&c_k;&c_ib;</trd>
  <trdgrp lng="ca">
    <trd>fuga</trd>,
    <trd>fugida</trd>
  </trdgrp>
  <trd lng="de">Flucht</trd>
  <trd lng="en">flight</trd>
  <trd lng="es">fuga</trd>
  <trdgrp lng="fa">
    <trd>&f_g;&a_r;&f_y;&a_z;</trd>,
    <trd>&a_f;&a_r;&a_A;&a_r;</trd>
  </trdgrp>
  <trd lng="fr">fuite</trd>
  <trdgrp lng="hu">
    <trd>menek&uuml;l&eacute;s</trd>,
    <trd>sz&ouml;k&eacute;s</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x9003;&#x8D70;  <pr>&#x3068;&#x3046;&#x305D;&#x3046;</pr></trd>,
    <trd>&#x9003;&#x4EA1;  <pr>&#x3068;&#x3046;&#x307C;&#x3046;</pr></trd>,
    <trd>&#x8131;&#x8D70;  <pr>&#x3060;&#x3063;&#x305D;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="nl">vlucht<klr tip="ind"> (het vluchten)</klr></trd>
  <trdgrp lng="pl">
    <trd>ucieczka</trd>,
    <trd>rejterada</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>fuga</trd>,
    <trd>escapada</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_b;&c_je;&c_g;&c_s;&c_t;&c_v;&c_o;</trd>,
    <trd>&c_p;&c_o;&c_b;&c_je;&c_g;</trd>
  </trdgrp>
  <trd lng="uk">&c_v;&c_t;&c_je;&c_ch;&c_a;</trd>
  <trd lng="zh">&#x9003;&#x79BB; <pr>t&aacute;ol&iacute;</pr></trd>
</drv>

<drv mrk="fugx.0ejo">
  <kap>
    <tld/>ejo
  </kap>
  <snc>
    <dif>
      Loko al kiu oni <tld/>is, <ref tip="dif" cel="rifugx.0ejo">rifu&gcirc;ejo</ref>:
      <ekz>
        tor&ccirc;oj balanci&gcirc;is tien kaj reen <klr>[&#x2026;]</klr>, bon&scirc;ance, ilia <tld/>ejo ne
        estis malkovrita
        <fnt>
          <bib>StU</bib>
          <lok>Britujo</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Zufluch</trd>
  <trd lng="en">refuge</trd>
  <trd lng="fr">refuge</trd>
</drv>

<drv mrk="fugx.0ema">
  <kap>
    <tld/>ema
  </kap>
  <snc>
    <dif>
      Inklina, preta <tld/>i:
      <ekz>
        li volis eviti provokon, <klr>[&#x2026;]</klr> prezenti sin kiel humila servisto, sed
        tio <klr>[&#x2026;]</klr> donis ian rigardon de <tld/>emo al liaj okuloj
        <fnt>
          <bib>VRA</bib>
          <lok>Ivar Lo-Johansson</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Stockburger</nom> volas montri la &leftquot;nestabilecon,
        <tld/>emon kaj neegalecon de valoroj
        ekonomie determinatajn&rightquot;
        <fnt>
          <bib>Monato</bib>
          <aut>Walter Klag</aut>
          <vrk><url ref="&Monato;/2014/011333.php"
              >Mono el ora kolono</url></vrk>
          <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">fluchtbereit</trd>
</drv>

<drv mrk="fugx.0into">
  <kap>
    <tld/>into
  </kap>
  <snc>
    <dif>
      Iu, kiu <tld/>is:
      <ekz>
        la aliaj sklavoj esprimis kompaton al tiuj <tld/>intoj, kiuj estis mistraktitaj
        <fnt>
          <bib>StU</bib>
          <lok>Al Romo</lok>
        </fnt>;
      </ekz>
      <ekz>
        i ni ankora&ubreve; hodia&ubreve; havus centmilojn da Kosovo-albanaj <tld/>intoj en tuta E&ubreve;ropo
        <fnt>
          <bib>Monato</bib>
          <aut>Luciano Ortelli</aut>
          <vrk>Celtrafa milito</vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>Fl&uuml;chtling</trd>,
    <trd>Geflohener</trd>
  </trdgrp>
</drv>

<drv mrk="fugx.for0i">
  <kap>
    for<tld/>i, <var><kap>el<tld/>i</kap></var>
  </kap>
  <snc>
    <dif>
      Sukcese <ref tip="super" cel="fugx.0i"><tld/>i</ref>
      for de iu situacio; <ref tip="dif" cel="eskap.0i">eskapi</ref>:
      <ekz>
        li for<tld/>is de sia propra edzi&gcirc;festo en tiu fatala momento
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 21</lok>
        </fnt>;
      </ekz>
      <ekz>
        ne videblis flanka strato en kiun el<tld/>i kaj ne eblis retroiri sen veki
        suspekton
        <fnt>
          <bib>Kon11</bib>
          <lok>Moderna Drogo</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi sentas min devigita for<tld/>i el la konfuzo
        <fnt>
          <bib>Fab4</bib>
          <lok>Turgardisto Ole</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi provas kapti ideon, memoron, kaj &gcirc;i konstante for<tld/>as
        <fnt>
          <bib>ChR</bib>
          <lok>La fantoma bovino</lok>
        </fnt>;
      </ekz>
      <ekz>
        mia demando <klr>[&#x2026;]</klr> senpripense el<tld/>is el mia bu&scirc;o, kvaza&ubreve; el ka&gcirc;o
        <fnt>
          <bib>OIP</bib>
          <lok>Ombro sur interna pejza&gcirc;o</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>entfliehen</trd>,
    <trd>entrinnen</trd>,
    <trd>entkommen</trd>,
    <trd>ausrei&szlig;en</trd>,
    <trd>entschl&uuml;pfen</trd>
  </trdgrp>
  <trd lng="en">escape</trd>
  <trd lng="fr">s'&eacute;vader</trd>
</drv>

<drv mrk="fugx.trans0into">
  <kap>trans<tld/>into</kap>
  <snc>
    <dif>
      Homo, kiu forlasis sian partion por transiri en alian:
      <ekz>
        4,6 milionoj da trans<tld/>intoj <klr>[&#x2026;]</klr> pasis anta&ubreve; 1989 de GDR al FRG
        <fnt>
          <bib>MD05</bib>
        </fnt>
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="kur">transkurinto</ref>,
      <ref cel="fal.de0i.BIB">defalinto</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_p;&c_je;&c_r;&c_a;&c_b;&c_je;&c_zh;&c_ch;&c_y;&c_k;</trd>
  <trd lng="ca">tr&agrave;nsfuga</trd>
  <trd lng="de">&Uuml;berl&auml;ufer</trd>
  <trd lng="en">refugee</trd>
  <trd lng="fa">&f_p;&a_n;&a_A;&a_h;&a_j;&a_w;</trd>
  <trd lng="fr">transfuge</trd>
  <trd lng="hu">disszidens</trd>
  <trdgrp lng="ja">
    <trd>&#x88CF;&#x5207;&#x308A;&#x8005;  <pr>&#x3046;&#x3089;&#x304E;&#x308A;&#x3082;&#x306E;</pr></trd>,
    <trd>&#x6575;&#x306B;&#x5BDD;&#x8FD4;&#x3063;&#x305F;&#x8005;
    <pr>&#x3066;&#x304D;&#x306B;&#x306D;&#x304C;&#x3048;&#x3063;&#x305F;&#x3082;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="nl">overloper</trd>
  <trdgrp lng="pl">
    <trd>dezerter</trd>,
    <trd>renegat</trd>
  </trdgrp>
  <trd lng="pt">refugiado</trd>
  <trd lng="ru">&c_p;&c_je;&c_r;&c_je;&c_b;&c_je;&c_zh;&c_ch;&c_i;&c_k;</trd>
  <trd lng="uk">&c_p;&c_je;&c_r;&c_je;&c_b;&c_ib;&c_zh;&c_ch;&c_i;&c_k;</trd>
  <trd lng="zh">&#x9003;&#x5175; <pr>t&aacute;ob&imacron;ng</pr></trd>
</drv>
</art>
