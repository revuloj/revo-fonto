<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kleptomani.xml,v 1.1 2026/09/19 12:29:09 afido Exp $">
    <kap>
      <rad>kleptomani</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="kleptomani.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">MED</uzo>
    <dif>
      &Scirc;tel<ref tip="super" cel="mani.0o.PSI">manio</ref>:
      <ekz>
        ekde &ccirc;irka&ubreve; la 10a vivojaro mi suferis de <tld/>o, kvankam plagis min
        konstantaj kulposentoj kaj mi ripro&ccirc;is min, mi ne havis la forton por rezisti
        <fnt>
          <aut>Z. D.</aut>
          <vrk><url ref="https://www.bruno-groening.org/eo/sani%C4%9Doj/sanigoj-je-dependecoj/188-mania-konduto/kleptomanio/1829-sanio-je-kleptomanio"
              >Sani&gcirc;o je kleptomanio</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la fobioj, la <tld/>o, certaj paralizoj ktp. ne estas alia afero ol la rezultato
        de efiko de la nekonscio al la korpa a&ubreve; la spirita esta&jcirc;o
        <fnt>
          <aut>E. Cou&eacute;</aut>
          <vrk><url ref="https://eo.wikisource.org/wiki/Pa%C4%9Do:Cou%C3%A9_-_La_regado_de_si_mem_per_konscia_a%C5%ADtosugesto,_1924,_Borel.pdf/32"
              >La regado de si mem per konscia a&ubreve;tosugesto</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Kleptomanie</trd>
    <trd lng="en">kleptomania</trd>
    <trd lng="fr">kleptomanie</trd>
    <trd lng="ru">&c_k;&c_l;&c_je;&c_p;&c_t;&c_o;&c_m;&c_a;&c_n;&c_i;&c_ja;</trd>
  </snc>
</drv>

  </art>


