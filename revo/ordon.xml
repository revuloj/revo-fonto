  <trdgrp lng="es">
   <trd>ordenado, -a</trd>,
   <trd>mandado, -a</trd>,
   <trd>mandatorio, -a</trd>
  </trdgrp>
  <trdgrp lng="fr">
   <trd>imp&eacute;ratif</trd>,
   <trd>de <ind>commandement</ind></trd>
  </trdgrp>
  <trdgrp lng="hu">
