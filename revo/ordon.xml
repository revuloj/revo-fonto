<drv mrk="ordon.0o">
  <kap><tld/>o</kap>
  <snc mrk="ordon.0o.volo">
    <dif>
      <ref tip="lst" lst="voko:komunikoj" cel="esprim.0o.ado">Esprimo</ref>
      de ies estra <ref cel="vol.0o">volo</ref>:
      <ekz>
        mi restas tie &ccirc;i la&ubreve; la <tld/>o de mia estro
        <fnt>
          <bib>F</bib>
          <lok>&FE; 26</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[tiu]</klr> respektanta <tld/>on estos rekompencita
        <fnt>
          <bib>MT</bib>
          <lok>Sentencoj 13:13</lok>
        </fnt>;
      </ekz>
      <ekz>
        observi kaj plenumi &ccirc;iujn <klr>[&#8230;]</klr> <tld/>ojn
        <fnt>
          <bib>MT</bib>
          <lok>Readmono 15:5</lok>
        </fnt>;
      </ekz>
      <ekz>
        ne for&jcirc;etu la <tld/>on de via patrino
        <fnt>
          <bib>MT</bib>
          <lok>Sentencoj 1:8</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[&scirc;i]</klr> jam estis for por disdoni novajn <tld/>ojn
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Batalo je la Ebura Turo</lok>
        </fnt>;
      </ekz>
      <ekz>
       bezono estas plej forta <tld/>o
       <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        de la volo la <tld/>o pli efikas ol bastono
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        deziro kaj inklino <tld/>on ne obeas
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
    <refgrp tip="sub">
       <ref cel="edikt.0o">edikto</ref>,
       <ref cel="ukaz.0o">ukazo</ref>,
       <ref cel="direktiv.0o">direktivo</ref>,
       <ref cel="komand.0o">komando</ref>
    </refgrp>
    <trd lng="be">&c_z;&c_a;&c_g;&c_a;&c_d;</trd>
    <trdgrp lng="ca">
      <trd>ordre<klr tip="amb"> (fem.)</klr></trd>,
      <trd>orde<klr tip="amb"> (fem.)</klr></trd>,
      <trd>manament</trd>
    </trdgrp>
    <trd lng="cs">rozkaz</trd>
    <trdgrp lng="de">
      <trd>Anordnung</trd>,
      <trd>Gebot</trd>
    </trdgrp>
    <trd lng="en">order <klr>(command)</klr></trd>
    <trdgrp lng="es">
      <trd>orden</trd>,
      <trd>mandato</trd>
    </trdgrp>
    <trdgrp lng="fr">
      <trd>ordre</trd>,
      <trd>injonction</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd>instruksi</trd>,
      <trd>komando</trd>,
      <trd>perintah</trd>,
      <trd>titah</trd>
    </trdgrp>
    <trd lng="nl">bevel</trd>
    <trdgrp lng="pl">
      <trd>nakaz</trd>,
      <trd>polecenie</trd>,
      <trd>rozkaz</trd>,
      <trd>zarz&aogonek;dzenie</trd>,
      <trd>zlecenie</trd>
    </trdgrp>
    <trdgrp lng="pt">
     <trd>ordem</trd>,
     <trd>comando</trd>
    </trdgrp>
    <trdgrp lng="ro">
      <trd>mandat</trd>,
      <trd>porunc&abreve;</trd>,
      <trd>ordin</trd>,
      <trd>comand&abreve;</trd>
    </trdgrp>
    <trd lng="ru">&c_p;&c_r;&c_i;&c_k;&c_a;&c_z;</trd>
    <trd lng="sv">order</trd>
  </snc>
  <snc mrk="ordon.0o.KOMP">
    <uzo tip="fak">KOMP</uzo>
    <dif>
      En <ref tip="malprt" cel="progra.0o.komp">programo</ref>,
      <ref tip="super" cel="fraz.0o.KOMP">frazo</ref> indikanta
      agon plenumendan:
      <ekz>
         simpla <tld/>o <klr>(baza,
         kiu ne entenas aliajn <tld/>ojn)</klr>;
      </ekz><ekz>
          malsimpla <tld/>o <klr>(konstruita el pli simplaj
          <tld/>oj)</klr>;
      </ekz><ekz>
         kondi&ccirc;a, iteracia <tld/>o;
      </ekz>
      <ekz>
        estas du metodoj agordi la amplekson de indicoj por tabeloj deklaritaj per la
        <tld/>o <frm>Dim</frm>
        <fnt>
          <vrk><url
          ref="https://helponline.libreoffice.org/5.4/eo/text/sbasic/shared/03102101.html">Ordono
          ReDim [Rultempa] - helponline.libreoffice.org</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la komputilo simple plenumas tiujn <tld/>ojn en la donita sinsekvo
        <fnt>
          <vrk><url ref="&Viki;/Programlingvo">Programlingvo -
          Vikipedio</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la parto de la proces-unuo, kie &ccirc;iu <tld/>o el la programo estas
        &leftquot;legata&rightquot;,
        interpretata kaj direktata
        <fnt>
          <vrk><url ref="http://www.ilei.info/dok/INVERSA%20VORTARO%20HILAND.pdf">Inversa
          Vortaro</url></vrk>
          <lok>ilei.info</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="deklar.0o.KOMP">deklaro</ref>
    <ref tip="sub" cel="komand.0o.KOMP">komando</ref>
    <trd lng="be">&c_a;&c_p;&c_e;&c_r;&c_a;&c_t;&c_a;&c_r; <klr>(&c_u;
    &c_k;&c_a;&c_m;&c_p;&c_u;&c_t;&c_a;&c_r;&c_n;&c_a;&c_j;
    &c_p;&c_r;&c_a;&c_g;&c_r;&c_a;&c_m;&c_je;)</klr></trd>
    <trdgrp lng="ca">
      <trd>instrucci&oacute;</trd>,
      <trd>ordre<klr tip="amb"> (fem.)</klr></trd>,
      <trd>orde<klr tip="amb"> (fem.)</klr></trd>
    </trdgrp>
    <trd lng="de">Instruktion</trd>
    <trd lng="en"><klr>(executable)</klr> <ind>statement</ind></trd>
    <trdgrp lng="es">
     <trd>comando</trd>,
     <trd>instrucci&oacute;n</trd>
    </trdgrp>
    <trdgrp lng="fr"><trd>commande</trd><trd>instruction</trd></trdgrp>
    <trd lng="id">perintah</trd>
    <trd lng="nl">instructie</trd>
    <trdgrp lng="pt">
     <trd>comando</trd>,
     <trd>instru&ccedil;&atilde;o</trd>
    </trdgrp>
    <trd lng="ru">&c_o;&c_p;&c_je;&c_r;&c_a;&c_t;&c_o;&c_r;</trd>
    <trd lng="zh">&#21629;&#20196; <pr>m&igrave;ngl&igrave;ng</pr></trd>
  </snc>
  <trd lng="bo">&t_ba;&t_ka;&amp;t_-a;&t_tsheg;</trd>
  <trdgrp lng="cs">
    <trd>na&rcaron;&iacute;zen&iacute;</trd>,
    <trd>p&rcaron;&iacute;kaz</trd>
  </trdgrp>
  <trdgrp lng="de">
     <trd>Befehl</trd>,
     <trd>Anweisung</trd>
   </trdgrp>
   <trdgrp lng="hu">
     <trd>parancs</trd>,
     <trd>utas&iacute;t&aacute;s</trd>
   </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21629;&#20196;  <pr>&#12417;&#12356;&#12428;&#12356;</pr></trd>,
    <trd>&#25351;&#22259;  <pr>&#12373;&#12375;&#12378;</pr></trd>,
    <trd>&#21495;&#20196;  <pr>&#12372;&#12358;&#12428;&#12356;</pr></trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>nariadenie</trd>,
    <trd>pr&iacute;kaz</trd>,
    <trd>rozkaz</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_n;&c_a;&c_k;&c_a;&c_z;</trd>,
    <trd>&c_v;&c_je;&c_l;&c_ib;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_r;&c_o;&c_z;&c_p;&c_o;&c_r;&c_ja;&c_d;&c_zh;&c_je;&c_n;&c_n;&c_ja;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#21629;&#20196; <pr>m&igrave;ngl&igrave;ng</pr></trd>,
    <trd>&#25351;&#20196; <pr>zh&#464;l&igrave;ng</pr></trd>,
    <trd>&#25351;&#25381; <pr>zh&#464;hu&imacron;</pr></trd>,
    <trd>&#25351;&#25582; <pr>zh&#464;hu&imacron;</pr></trd>,
    <trd>&#25351;&#25381;&#26435; <pr>zh&#464;hu&imacron;qu&aacute;n</pr></trd>,
    <trd>&#25351;&#25582;&#27402; <pr>zh&#464;hu&imacron;qu&aacute;n</pr></trd>,
    <trd>&#21495;&#20196; <pr>h&agrave;ol&igrave;ng</pr></trd>,
    <trd>&#34399;&#20196; <pr>h&agrave;ol&igrave;ng</pr></trd>,
    <trd>&#35347;&#20196; <pr>x&ugrave;nl&igrave;ng</pr></trd>,
    <trd>&#35757;&#20196; <pr>x&ugrave;nl&igrave;ng</pr></trd>,
    <trd>&#25351;&#31034; <pr>zh&#464;sh&igrave;</pr></trd>
