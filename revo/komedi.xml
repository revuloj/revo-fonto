<drv mrk="komedi.0o">
  <kap><tld/>o</kap>
  <snc mrk="komedi.0o.TEA">
    <uzo tip="fak">TEA</uzo>
    <dif>
      <ref tip="super" cel="teatr.0ajxo">Teatra&jcirc;o</ref>, kiu
      ekscitas la ridon prezentante komikajn personojn a&ubreve; amuzajn
      eksterordinarajn cirkonstancojn:
      <ekz>
        La Revizoro, <tld/>o en kvin aktoj
        <fnt>
          <bib>Ifigenio</bib>
        </fnt>;
      </ekz>
      <ekz>
        li &jcirc;us starigis sian malgrandan teatron, kaj la homoj sidis &ccirc;irka&ubreve;e, por rigardi
        la <tld/>on
        <fnt>
          <bib>Fab1</bib>
          <lok>Vojkamarado</lok>
        </fnt>;
      </ekz>
      <ekz>
        dum la tago mi sidas en la policejo &ccirc;e la enuigaj aktoj, kaj en la nokto mi
        son&gcirc;as, ke mi flugas en formo de ala&ubreve;do en la Frederika parko, vere, oni
        povus skribi pri tio tutan <tld/>on
        <fnt>
          <bib>Fab1</bib>
          <lok>Galo&scirc;oj de feli&ccirc;o</lok>
        </fnt>!
      </ekz>
      <ekz>
        &scirc;i rakontis kelke da komikaj scenoj el la <tld/>oj de <nom>Holberg</nom>
        <fnt>
          <bib>Fab2</bib>
          <lok>Malgranda Tuk</lok>
        </fnt>;
      </ekz>
      <ekz>
        pupa <tld/>o
        <fnt>
          <bib>Fab4</bib>
          <lok>Pupludisto</lok>
        </fnt>;
      </ekz>
      <ekz>
        li estis aran&gcirc;isto de <tld/>oj, maskobaloj kaj &ccirc;iaj elpenseblaj amuzi&gcirc;oj
        <fnt>
          <bib>Fab4</bib>
          <lok>Dekdu per la po&scirc;to</lok>
        </fnt>;
      </ekz>
      <ekz>
        la&ubreve; la maniero de herooj de <tld/>o li mallevis la kapon kaj la manojn
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        la plej bonaj aktoroj en la mondo, por tragedioj, <tld/>oj, historioj,
        pastoraloj, pastoralaj <tld/>oj
        <fnt>
          <bib>Hamlet</bib>
        </fnt>;
      </ekz>
      <ekz>
        la katastrofon de tiu &ccirc;i tragi<tld/>o lasu al mi
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>!
      </ekz>
    </dif>
    <refgrp tip="sub">
      <ref cel="burles.0o">burlesko</ref>,
      <ref cel="fars.0o">farso</ref>,
    </refgrp>
    <trdgrp lng="de">
      <trd>Kom&ouml;die</trd>,
      <trd>Lustspiel</trd>
    </trdgrp>
    <trd lng="fr">com&eacute;die<klr tip="ind">
    (th&eacute;&acirc;tre)</klr></trd>
    <trdgrp lng="nl">
      <trd>comedie</trd>,
      <trd>blijspel</trd>
    </trdgrp>
  </snc>
  <snc mrk="komedi.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Aran&gcirc;o malsincera por trompi per falsa &scirc;ajno;
      &scirc;ajnigo, hipokriteco:
      <ekz>
        li ludis la <tld/>on de l&#8217; amo kaj de l&#8217; edzi&gcirc;o nur por min devigi al la
        senvualigo de mia sekreto
        <fnt>
          <aut>Henri Vallienne</aut>
          <vrk><url ref="&Tekstaro;?nomo=chu-li">&Ccirc;u li?</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        kial &scirc;i ludus tian <tld/>on, kial ne simple diri la veron
        <fnt>
          <aut>Joh&aacute;n Valano</aut>
          <vrk><url ref="&Tekstaro;?nomo=chu-ni-kunvenis-vane">&Ccirc;u ni kunvenis
          vane?</url></vrk>
        </fnt>?
      </ekz>
    </dif>
  <trdgrp lng="de">
    <trd>Kom&ouml;die</trd>,
    <trd>abgekartetes Spiel</trd>,
    <trd>Farce</trd>
  </trdgrp>
    <trdgrp lng="fr">
      <trd>com&eacute;die<klr tip="ind"> (fig.)</klr></trd>,
      <trd>exag&eacute;ration</trd>,
      <trd>farce</trd>,
      <trd>tromperie</trd>
    </trdgrp>
    <trd lng="nl">comedie</trd>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_m;&c_e;&c_d;&c_y;&c_ja;</trd>
  <trd lng="ca">com&egrave;dia</trd>
  <trdgrp lng="cs">
    <trd>komedie</trd>,
    <trd>p&rcaron;en. p&rcaron;etv&aacute;&rcaron;ka</trd>,
    <trd>veselohra</trd>
  </trdgrp>
  <trd lng="en">comedy</trd>
  <trd lng="es">comedia</trd>
  <trd lng="it">commedia</trd>
  <trdgrp lng="ja">
    <trd>&#21916;&#21127;  <pr>&#12365;&#12370;&#12365;</pr></trd>,
    <trd>&#12467;&#12513;&#12487;&#12451;&#12540;  <pr>&#12371;&#12417;&#12391;&#12355;&#12540;</pr></trd>,
    <trd>&#33590;&#30058;  <pr>&#12385;&#12419;&#12400;&#12435;</pr></trd>,
    <trd>&#35211;&#12379;&#12363;&#12369;&#12398;&#33437;&#23621;  <pr>&#12415;&#12379;&#12363;&#12369;&#12398;&#12375;&#12400;&#12356;</pr></trd>
  </trdgrp>
  <trd lng="pl">komedia</trd>
  <trd lng="pt">com&eacute;dia</trd>
  <trd lng="ru">&c_k;&c_o;&c_m;&c_je;&c_d;&c_i;&c_ja;</trd>
  <trd lng="sk">veselohra</trd>
  <trdgrp lng="sl">
    <trd>veseloigra</trd>,
    <trd>komedija</trd>
  </trdgrp>
  <trd lng="uk">&c_k;&c_o;&c_m;&c_je;&c_d;&c_ib;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#25630;&#31505;&#29255; <pr>g&#462;oxi&agrave;opi&agrave;n</pr></trd>,
    <trd>&#21916;&#21095; <pr>x&#464;j&ugrave;</pr></trd>,
    <trd>&#31505;&#21095; <pr>xi&agrave;oj&ugrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="komedi.0a">
  <kap><tld/>a</kap>
  <snc mrk="komedi.0a.TEA">
    <uzo tip="fak">TEA</uzo>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        tia ciklo respureblas en pluraj &scirc;ekspiraj verkoj, &ccirc;u <tld/>aj, &ccirc;u dramaj
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan MacGill</aut>
          <vrk><url ref="&Monato;/2007/009029.php">Irigu vin tra intrigo
          vintra</url></vrk>
          <lok>2007</lok>
        </fnt>;
      </ekz>
      <ekz>
        aperis pli poste <tld/>a filmo
        <fnt>
          <bib>Monato</bib>
          <aut>Fidilalao Henriel</aut>
          <vrk><url ref="&Monato;/2007/009064.php">Kino malagasa furoras</url></vrk>
          <lok>2007</lok>
        </fnt>;
      </ekz>
      <ekz>
        usona <tld/>a serio
        <fnt>
          <bib>Monato</bib>
          <aut>Jean Pierre VandenDaele</aut>
          <vrk><url ref="&Monato;/2012/010697.php">De analogo al cifereco: evoluo de
          persona historio</url></vrk>
          <lok>2012</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_k;&c_a;&c_m;&c_e;&c_d;&c_y;&c_j;&c_n;&c_y;</trd>,
      <trd>&c_k;&c_a;&c_m;&c_ib;&c_ch;&c_n;&c_y;</trd>,
      <trd>&c_s;&c_mol;&c_m;&c_ja;&c_sh;&c_l;&c_ib;&c_v;&c_y;</trd>
    </trdgrp>
  <trdgrp lng="fr">
    <trd>de <ind>com&eacute;die</ind></trd>,
    <trd>comique<klr tip="ind"> (adj.)</klr></trd>
  </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_k;&c_o;&c_m;&c_je;&c_d;&c_i;&c_j;&c_n;&c_y;&c_j;</trd>,
      <trd>&c_k;&c_o;&c_m;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;</trd>,
      <trd>&c_k;&c_o;&c_m;&c_i;&c_ch;&c_n;&c_y;&c_j;</trd>
    </trdgrp>
  </snc>
  <snc mrk="komedi.0a.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Malsincera, hipokrita:
      <ekz>
        oni diros, ke ni aran&gcirc;is <tld/>an elekton
        <fnt><bib>PV</bib></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_sh;&c_t;&c_u;&c_ch;&c_n;&c_y;</trd>,
      <trd>&c_f;&c_a;&c_l;&c_mol;&c_sh;&c_y;&c_v;&c_y;</trd>
    </trdgrp>
    <trdgrp lng="fr">
      <trd>de <ind>com&eacute;die</ind></trd>,
      <trd>com&eacute;dien<klr tip="ind"> (adj.)</klr></trd>
    </trdgrp>
    <trd lng="ru">
    &c_p;&c_r;&c_i;&c_t;&c_v;&c_o;&c_r;&c_n;&c_y;&c_j;</trd>
  </snc>
  <trd lng="ca">c&ograve;mic</trd>
  <trd lng="de">kom&ouml;diantisch</trd>
  <trd lng="en">comedic</trd>
  <trd lng="es">c&oacute;mico</trd>
  <trdgrp lng="ja">
    <trd>&#21916;&#21127;&#12398;  <pr>&#12365;&#12370;&#12365;&#12398;</pr></trd>,
    <trd>&#21916;&#21127;&#30340;&#12394;  <pr>&#12365;&#12370;&#12365;&#12390;&#12365;&#12394;</pr></trd>,
    <trd>&#35211;&#12379;&#12363;&#12369;&#12398;  <pr>&#12415;&#12379;&#12363;&#12369;&#12398;</pr></trd>,
    <trd>&#33590;&#30058;&#12398;  <pr>&#12385;&#12419;&#12400;&#12435;&#12398;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>komediowy</trd>,
    <trd>komediancki</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_k;&c_o;&c_m;&c_je;&c_d;&c_ib;&c_j;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_k;&c_o;&c_m;&c_ib;&c_ch;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
  <trd lng="zh">&#28369; <pr>g&#468;</pr></trd>
</drv>

<drv mrk="komedi.0i">
  <kap><tld/>i</kap>
  <snc mrk="komedi.0i.TEA">
    <gra><vspec>ntr</vspec></gra>
    <uzo tip="fak">TEA</uzo>
    <dif>
      Ludi <tld/>on:
      <ekz>
        tre malsa&gcirc;a <tld/>anto!... &#8208; sopiris <nom>Herhor</nom>, frotante la frunton
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro XIV</lok>
        </fnt>;
      </ekz>
      <ekz>
        li vekas nin, rigardas post sin alprenas la sintenon de <tld/>anto, lundanta la
        rolon de Oresto, kaj plie, de a&ccirc;a <tld/>anto, li deklamas grekajn versa&jcirc;ojn
        <fnt>
          <aut>Henryk Sienkiewicz, trad. Lidia Zamenhof </aut>
          <vrk><url ref="&Tekstaro;?nomo=quo-vadis">Quo Vadis</url></vrk>
          <lok>&Ccirc;apitro XVIII</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">
&c_g;&c_r;&c_a;&c_c;&c_mol; <ind>&c_k;&c_a;&c_m;&c_e;&c_d;&c_y;&c_ju;
    </ind></trd>
    <trd lng="ca">interpretar una com&egrave;dia</trd>
    <trd lng="ru">
&c_i;&c_g;&c_r;&c_a;&c_t;&c_mol; &c_k;&c_o;&c_m;&c_je;&c_d;&c_i;&c_ju;
    </trd>
  </snc>
  <snc mrk="komedi.0i.FIG">
    <gra><vspec>tr</vspec></gra>
    <uzo tip="stl">FIG</uzo>
    <dif>
      <ref tip="dif" cel="hipokr.0i">Hipokriti</ref>:
      <ekz>
        &ccirc;u vi ne opinias, ke li <tld/>as la&ubreve;vole
        <fnt>
          <aut>Joh&aacute;n Valano</aut>
          <vrk><url ref="&Tekstaro;?nomo=chu-ni-kunvenis-vane">&Ccirc;u ni kunvenis
          vane?</url></vrk>
        </fnt>?
      </ekz>
    </dif>
    <trd lng="be">&c_l;&c_a;&c_m;&c_a;&c_c;&c_mol;
    <ind>&c_k;&c_a;&c_m;&c_e;&c_d;&c_y;&c_ju;</ind></trd>
    <trd lng="ca">fer <ind>com&egrave;dia</ind></trd>
    <trd lng="de">etwas <ind>vormachen</ind></trd>
    <trd lng="ru">
&c_l;&c_o;&c_m;&c_a;&c_t;&c_mol; &c_k;&c_o;&c_m;&c_je;&c_d;&c_i;&c_ju;
    </trd>
  </snc>
  <trd lng="cs">hr&aacute;t  komedii</trd>
  <trd lng="de"><ind>Kom&ouml;die</ind> spielen</trd>
  <trdgrp lng="fr">
    <trd>jouer la <ind>com&eacute;die</ind></trd>,
    <trd>affecter<klr tip="ind"> (feindre)</klr></trd>,
    <trd>feindre</trd>,
    <trd>faire l'<ind>hypocrite</ind></trd>,
    <trd>pr&eacute;tendre<klr tip="ind"> (feindre)</klr></trd>,
    <trd>faire <ind>semblant</ind> (de)</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21916;&#21127;&#12434;&#28436;&#12376;&#12427;  <pr>&#12365;&#12370;&#12365;&#12434;&#12360;&#12435;&#12376;&#12427;</pr></trd>,
    <trd>&#35211;&#12379;&#12363;&#12369;&#12427;  <pr>&#12415;&#12379;&#12363;&#12369;&#12427;</pr></trd>,
    <trd>&#33437;&#23621;&#12377;&#12427;  <pr>&#12375;&#12400;&#12356;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trd lng="nl">comedie spelen</trd>
  <trdgrp lng="pl">
    <trd>gra&cacute; komedi&eogonek;</trd>
  </trdgrp>
  <trd lng="sk">hra&tcaron; kom&eacute;diu</trd>
  <trdgrp lng="uk">
    <trd>&c_g;&c_r;&c_a;&c_t;&c_i; &c_k;&c_o;&c_m;&c_je;&c_d;&c_ib;&c_ju;</trd>,
    <trd>&c_l;&c_i;&c_c;&c_je;&c_m;&c_ib;&c_r;&c_i;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#20335; <pr>y&aacute;ng</pr></trd>,
    <trd>&#20551;&#35013; <pr>ji&#462;zhu&#257;ng</pr></trd>,
    <trd>&#25925;&#20316; <pr>g&ugrave;zu&ograve;</pr></trd>,
    <trd>&#35013;&#20316; <pr>zhu&#257;ngzu&ograve;</pr></trd>,
    <trd>&#28436;&#25103; <pr>y&#462;nx&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="komedi.0isto">
  <kap><tld/>isto</kap>
  <snc>
    <dif>
      Aktoro, ludanta <tld/>on:
      <ekz>
        la itala <tld/>isto, scenaristo kaj &ccirc;efaktoro Dario <nom>Niccodemi</nom> konata precipe pro
        la <tld/>oj &leftquot;<nom>Scampolo</nom>&rightquot; kaj &leftquot;<nom>La
        nemica</nom>&rightquot;
        <fnt>
          <vrk><url ref="http://www.bitoteko.it/esperanto-vivo/eo/2017/09/24/dario-niccodemi/">Dario
          Niccodemi - Esperanto-vivo</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        la muzik-<tld/>isto <nom>Victor Borge</nom> distradis siajn a&ubreve;skultantojn per simila sistemo
        <fnt>
          <bib>Monato</bib>
          <aut>Donald Broadribb</aut>
          <vrk><url ref="&Monato;/2007/009300.php">Sukcesoplena, &scirc;ercoplena kaj tre
          malkutima</url></vrk>
          <lok>2007</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_m;&c_e;&c_d;&c_y;&c_ja;&c_n;&c_t;</trd>
  <trdgrp lng="ca">
    <trd>comediant</trd>,
    <trd>actor c&ograve;mic</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>komediant</trd>,
    <trd>komedi&aacute;ln&iacute; herec</trd>,
    <trd>komik</trd>
  </trdgrp>
  <trd lng="de">Kom&ouml;diant</trd>
  <trd lng="en">comedian</trd>
  <trd lng="es">comediante</trd>
  <trd lng="fr">com&eacute;dien<klr tip="ind"> (subst.)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#12467;&#12513;&#12487;&#12451;&#12450;&#12531;</trd>,
    <trd>&#21916;&#21127;&#24441;&#32773;  <pr>&#12365;&#12370;&#12365;&#12420;&#12367;&#12375;&#12419;</pr></trd>
  </trdgrp>
  <trd lng="pl">komediant</trd>
  <trd lng="ru">&c_k;&c_o;&c_m;&c_je;&c_d;&c_i;&c_a;&c_n;&c_t;</trd>
  <trdgrp lng="sk">
    <trd>komediant</trd>,
    <trd>komik</trd>
  </trdgrp>
  <trd lng="uk">&c_k;&c_o;&c_m;&c_je;&c_d;&c_ib;&c_j;&c_n;&c_i;&c_j; &c_a;&c_k;&c_t;&c_o;&c_r;</trd>
  <trdgrp lng="zh">
    <trd>&#35559;&#26143; <pr>xi&eacute;x&#299;ng</pr></trd>,
    <trd>&#23567;&#19985; <pr>xi&#462;och&#466;u</pr></trd>
  </trdgrp>
</drv>

