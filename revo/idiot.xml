<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: idiot.xml,v 1.32 2026/08/14 03:11:01 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>idiot</rad>/o
<fnt><bib>JED</bib></fnt></kap>

<drv mrk="idiot.0o">
  <kap><tld/>o</kap>
  <snc mrk="idiot.0o.KOMUNE">
    <dif>
      Homo tute ne inteligenta, malsa&gcirc;ega
      (kutime uzata kiel insulto, blasfemo):
      <ekz>
        efektive, ili diras, la tuta mondo tiam konsistis el <tld/>oj
        <fnt>
          <bib>EE</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;u mi ne rajtas paroli kaj diri la veron en mia propra domo! diablaj idiotoj vi
        estas
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>!
      </ekz>
      <ekz>
        <nom>Schwarz</nom> estas efektiva idioto! lin trompi neniom valoras
        <fnt>
          <bib>Metrop</bib>
        </fnt>!
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Dummkopf</trd>,
      <trd>Hohlkopf</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>h&uuml;lye</trd>,
      <trd>ostoba</trd>
    </trdgrp>
    <trd lng="ru">&c_b;&c_o;&c_l;&c_v;&c_a;&c_n;</trd>
    <trd lng="sv">idiot</trd>
  </snc>

  <snc mrk="idiot.0o.MED">
    <uzo tip="fak">MED</uzo>
    <uzo tip="stl">ARK</uzo>
    <dif>
      Homo senigita je inteligenteco pro cerbaj difektoj:
      <ekz>
        alkoholismo &ccirc;e la patro igas ofte la infanojn
        <tld/>oj.
      </ekz>
    </dif>
    <trdgrp lng="hu">
      <trd>gyengeelm&eacute;j&udblac;</trd>,
      <trd>idi&oacute;ta</trd>
    </trdgrp>
    <trd lng="pl">idiota</trd>
  </snc>
  <refgrp tip="vid">
    <ref cel="kreten.0o">kreteno</ref>,
    <ref cel="kap.vent0ulo">malplenkapulo</ref>,
    <ref cel="cerb.sen0ulo">sencerbulo</ref>,
    <ref cel="stult.0ulo">stultulo</ref>,
    <ref cel="kap.sxtip0ulo">&scirc;tipkapulo</ref>
  </refgrp>
  <trd lng="be">&c_ib;&c_d;&c_y;&c_jo;&c_t;</trd>
  <trd lng="bg">&c_i;&c_d;&c_i;&c_o;&c_t;</trd>
  <trd lng="ca">idiota</trd>
  <trdgrp lng="cs">
    <trd>blbec</trd>,
    <trd>idiot</trd>
  </trdgrp>
  <trd lng="de">Idiot</trd>
  <trd lng="en">idiot</trd>
  <trd lng="es">idiota</trd>
  <trdgrp lng="fr">
    <trd>idiot</trd>,
    <trd>abruti</trd>,
    <trd>imb&eacute;cile</trd>,
    <trd>cr&eacute;tin</trd></trdgrp>
  <trdgrp lng="id">
    <trd>idiot</trd>,
    <trd>tunagrahita</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x91CD;&#x5EA6;&#x77E5;&#x7684;&#x969C;&#x5BB3;&#x8005; <pr>&#x3058;&#x3085;&#x3046;&#x3069;&#x3061;&#x3066;&#x304D;&#x3057;&#x3087;&#x3046;&#x304C;&#x3044;&#x3057;&#x3083;</pr></trd>,
    <trd>&#x767D;&#x75F4; <pr>&#x305F;&#x308F;&#x3051;</pr></trd>,
    <trd>&#x611A;&#x304B;&#x8005; <pr>&#x304A;&#x308D;&#x304B;&#x3082;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="nl">idioot</trd>
  <trdgrp lng="pl">
    <trd>idiota</trd>,
    <trd>g&lstroke;upek</trd>
  </trdgrp>
  <trd lng="pt">idiota<klr tip="ind"> (subst.)</klr></trd>
  <trd lng="ru">&c_i;&c_d;&c_i;&c_o;&c_t;</trd>
  <trdgrp lng="sk">
    <trd>hlup&aacute;k</trd>,
    <trd>idiot</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_ib;&c_d;&c_ib;&c_o;&c_t;</trd>,
    <trd>&c_shch;&c_je; &c_j;&c_o;&c_l;&c_o;&c_p;</trd>,
    <trd>&c_b;&c_o;&c_v;&c_d;&c_u;&c_r;</trd>,
    <trd>&c_b;&c_je;&c_v;&c_z;&c_mol;</trd>,
    <trd>&c_t;&c_je;&c_l;&c_je;&c_p;&c_je;&c_n;&c_mol;</trd>,
    <trd>&c_l;&c_o;&c_b;&c_u;&c_r;</trd>,
    <trd>&c_d;&c_u;&c_r;&c_je;&c_n;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x50BB;&#x5B50; <pr>sh&#x1CE;zi</pr></trd>,
    <trd>&#x50BB;&#x74DC; <pr>sh&#x1CE;gu&amacron;</pr></trd>,
    <trd>&#x5446;&#x5B50; <pr>d&amacron;izi</pr></trd>,
    <trd>&#x5446;&#x74DC; <pr>d&amacron;igu&amacron;</pr></trd>,
    <trd>&#x61A8;&#x5B50; <pr>h&amacron;nzi</pr></trd>,
    <trd>&#x7B28;&#x86CB; <pr>b&egrave;nd&agrave;n</pr></trd>,
    <trd>&#x75F4; <pr>ch&imacron;</pr></trd>,
    <trd>&#x4E8C;&#x5C44; <pr>&egrave;rb&imacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="idiot.0eco">
  <kap><tld/>eco</kap>
  <snc mrk="idiot.0eco.KOMUNE">
    <dif>
      Granda stulteco:
      <ekz>
        la sceno malgra&ubreve; sia tuta groteska <tld/>eco, estis tiom frapanta, ke &gcirc;i e&ccirc; min
        kortu&scirc;is
        <fnt>
          <bib>VaK</bib>
          <lok>Deksepa &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        li diris ke mi tiel ade praktikas la <tld/>econ, kvaza&ubreve; mi estus profesia
        <tld/>o, <tld/>isto
        <fnt>
          <bib>KKr</bib>
          <lok>I</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;u vi havas alian klarigon por la <tld/>eco de usonaj registoj, kiuj
        bomb-detruas kompletan landon kaj poste lamentas, ke kostas terure multe
        rekonstrui Irakon
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan MAUL</aut>
          <vrk><url ref="&Monato;/2003/008209.html"
              >Ekscita jaro</url></vrk>
          <lok>2003</lok>
        </fnt>?
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>idiotesa</trd>,
      <trd>estupidesa</trd>,
      <trd>estupididat</trd>,
      <trd>imbecil&middot;litat</trd>
    </trdgrp>
    <trd lng="de">Idiotie</trd>
    <trdgrp lng="hu">
      <trd>h&uuml;lyes&eacute;g</trd>,
      <trd>ostobas&aacute;g</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>idiotyzm</trd>,
      <trd>g&lstroke;upota</trd>
    </trdgrp>
  </snc>
  <snc mrk="idiot.0eco.MED">
    <uzo tip="fak">MED</uzo>
    <uzo tip="stl">ARK</uzo>
    <dif>
      <ref tip="lst" cel="san.mal0o.MED" lst="voko:malsanoj">Malsano</ref> de <tld/>o <sncref
      ref="idiot.0o.MED"/>.
    </dif>
    <adm>
      Kontroli trd nl. La antauxa difino tekstis nur
      "stato de ~o". Mi sxovis la tradukojn al la medicina
      senco, sed ne certas. <aut>MB</aut>
    </adm>
    <trd lng="ca">idi&ograve;cia</trd>
    <trd lng="de">Idiotismus</trd>
    <trdgrp lng="hu">
      <trd>gyengeelm&eacute;j&udblac;s&eacute;g</trd>,
      <trd>idi&oacute;tizmus</trd>
    </trdgrp>
    <trd lng="nl">idiotie</trd>
    <trd lng="pl">idiotyzm</trd>
  </snc>
  <trd lng="be">&c_ib;&c_d;&c_y;&c_ja;&c_t;&c_y;&c_z;&c_m;</trd>
  <trdgrp lng="cs">
    <trd>blbost</trd>,
    <trd>choromyslnost</trd>,
    <trd>du&scaron;evn&iacute; zaostalost</trd>,
    <trd>idiocie</trd>,
    <trd>idiotie</trd>,
    <trd>idiotstv&iacute;</trd>,
    <trd>slabomyslnost</trd>
  </trdgrp>
  <trd lng="en">idiocy</trd>
  <trd lng="es">idiotez</trd>
  <trd lng="fr">idiotie<klr tip="ind"> (&eacute;tat, maladie)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#x91CD;&#x5EA6;&#x306E;&#x77E5;&#x7684;&#x969C;&#x5BB3;
    <pr>&#x3058;&#x3085;&#x3046;&#x3069;&#x306E;&#x3061;&#x3066;&#x304D;&#x3057;&#x3087;&#x3046;&#x304C;&#x3044;</pr></trd>,
    <trd>&#x767D;&#x75F4;  <pr>&#x305F;&#x308F;&#x3051;</pr></trd>
  </trdgrp>
  <trd lng="pt">idiotice<klr tip="ind"> (subst.)</klr></trd>
  <trd lng="ru">&c_i;&c_d;&c_i;&c_o;&c_t;&c_i;&c_z;&c_m;</trd>
  <trdgrp lng="sk">
    <trd>idiotstvo</trd>,
    <trd>slabomyse&lcaron;nos&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_ib;&c_d;&c_ib;&c_o;&c_t;&c_i;&c_z;&c_m;</trd>,
    <trd>&c_n;&c_je;&c_d;&c_o;&c_u;&c_m;&c_k;&c_u;&c_v;&c_a;&c_t;&c_ib;&c_s;&c_t;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x767D;&#x75F4; <pr>b&aacute;ich&imacron;</pr></trd>,
    <trd>&#x767D;&#x7661; <pr>b&aacute;ich&imacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="idiot.0igi">
  <kap><tld/>igi</kap>
  <snc>
    <dif>
      Igi iun <tld/>o:
      <ekz>la kutima ebrieco <tld/>igas.</ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_r;&c_a;&c_b;&c_ib;&c_c;&c_mol; <ind>&c_ib;&c_d;&c_y;&c_jo;&c_t;&c_a;&c_m;</ind></trd>,
    <trd>&c_v;&c_y;&c_k;&c_l;&c_ib;&c_k;&c_a;&c_c;&c_mol;
    <ind>&c_ib;&c_d;&c_y;&c_ja;&c_t;&c_y;&c_z;&c_m;</ind></trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>fer tornar <ind>idiota</ind></trd>,
    <trd>idiotitzar</trd>
  </trdgrp>
  <trd lng="cs">zblbnout <klr>(n&ecaron;koho)</klr></trd>
  <trd lng="de">verbl&ouml;den</trd>
  <trd lng="es">idiotizar</trd>
  <trdgrp lng="fr">
    <trd>rendre <ind>idiot</ind></trd>,
    <trd>abrutir</trd>,
    <trd>cr&eacute;tiniser</trd>
  </trdgrp>
  <trd lng="ja">&#x611A;&#x304B;&#x306B;&#x3059;&#x308B;
  <pr>&#x304A;&#x308D;&#x304B;&#x306B;&#x3059;&#x308B;</pr></trd>
  <trd lng="pl">og&lstroke;upia&cacute;</trd>
  <trd lng="pt">idiotizar</trd>
  <trd lng="sk">zblbn&uacute;&tcaron; <klr>(niekoho)</klr></trd>
  <trdgrp lng="uk">
    <trd>&c_r;&c_o;&c_b;&c_i;&c_t;&c_i; &c_ib;&c_d;&c_ib;&c_o;&c_t;&c_o;&c_m;</trd>,
    <trd>&c_p;&c_r;&c_i;&c_z;&c_v;&c_o;&c_d;&c_i;&c_t;&c_i; &c_d;&c_o;
    &c_ib;&c_d;&c_ib;&c_o;&c_t;&c_i;&c_z;&c_m;&c_u;</trd>
  </trdgrp>
</drv>
</art>
