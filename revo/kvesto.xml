<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kvesto.xml,v 1.24 2026/09/20 18:47:22 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>kvestor</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="kvesto.0o">
  <kap>
    <tld/>o
  </kap>
  <snc>
    <uzo tip="fak">HIS</uzo>
    <dif>
      Administranto de la &scirc;tata trezoro &ccirc;e la antikvaj Romanoj:
      <ekz>
        en la jaro 75 a.K., 137 jarojn post lia morto, la romia oratoro Cicerono
        estis servanta kiel <tld/>o en Sicilio kaj a&ubreve;skultis historiojn pri la tombo
        de Arkimedo, sed neniu el la lokanoj estis kapabla diri kie &gcirc;i precize situas,
        finfine, li trovis la tombon apud la pordego de Agrigento en Sirakuzo,
        tre malzorgita kaj &ccirc;irka&ubreve;ita de arbustoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=151">Arkimedo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">q&uuml;estor</trd>
    <trd lng="de">Qu&auml;stor</trd>
    <trd lng="en">quaestor</trd>
    <trd lng="es">cuestor</trd>
    <trd lng="hu">quaestor</trd>
    <trd lng="nl">quaestor</trd>
    <trd lng="pl">kwestor</trd>
    <trd lng="pt">questor</trd>
    <trd lng="ru">&c_k;&c_v;&c_je;&c_s;&c_t;&c_o;&c_r;</trd>
  </snc>
  <snc>
    <dif>
      Tiu, kiu en kelkaj korporacioj, zorgas pri la <ref cel="spez.0o">spezoj</ref>.
    </dif>
    <trd lng="ca">tresorer</trd>
    <trd lng="de">Schatzmeister</trd>
    <trd lng="en">treasurer</trd>
    <trd lng="es">tesorero</trd>
    <trdgrp lng="hu">
      <trd>gazdas&aacute;gi vezet&odblac;</trd>,
      <trd>kvesztor</trd></trdgrp>
    <trd lng="nl">penningmeester</trd>
    <trd lng="pl">skarbnik</trd>
  </snc>
  <snc>
    <dif>
      En Italujo, kvartala <ref tip="super" cel="polic.0estro">policestro</ref>:
      <ekz>
        <nom>Giovanni Palatucci</nom> (1909-1945) &mdash; itala policano, komisaro de publika sekureco,
        taskita pri rilatoj kun fremdlandanoj kaj fine kiel anstata&ubreve;anta <tld/>o
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=286451">Giovanni Palatucci</url></lok>
        </fnt>.
      </ekz>
    </dif><trdgrp lng="ca">
      <trd>questore</trd>,
      <trd>cap de policia <klr>(a It&agrave;lia)</klr></trd>
    </trdgrp>
    <trd lng="de">Polizeipr&auml;sident</trd>
    <trd lng="en">questore</trd>
    <trd lng="es">comisario de polic&iacute;a de distrito (Italia)</trd>
    <trd lng="hu">rend&odblac;rkapit&aacute;ny</trd>
    <trdgrp lng="nl">
      <trd>hoofd van <ind>politie</ind></trd>,
    </trdgrp>
    <trd lng="pl">dzielnicowy<klr> (policjant)</klr></trd>
  </snc>
  <trd lng="be">&c_k;&c_v;&c_e;&c_s;&c_t;&c_a;&c_r;</trd>
  <trdgrp lng="ja">
    <trd>&#x8CA1;&#x52D9;&#x5B98;  <pr>&#12374;&#12356;&#12416;&#x304B;&#12435;</pr></trd>,
    <trd>&#x51FA;&#x7D0D;&#x59D4;&#x54E1;  <pr>&#12377;&#12356;&#12392;&#12358;&#12356;&#12356;&#12435;</pr></trd>,
    <trd>&#x8B66;&#x5BDF;&#x7F72;&#38263;  <pr>&#12369;&#12356;&#12373;&#12388;&#12375;&#12423;&#12385;&#12423;&#12358;</pr></trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&#x43A;&c_v;&c_je;&c_s;&c_t;&#x43E;&c_r;</trd>,
    <trd>&c_s;&#x43A;&c_a;&c_r;&c_b;&#x43D;&c_i;&#x43A;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8CA1;&#x52D9;&#x79D8;&#x66F8; <pr>c&#xE1;iw&#xF9;m&#xEC;sh&#x16B;</pr></trd>,
    <trd>&#x8D22;&#x52A1;&#x79D8;&#x4E66; <pr>c&#xE1;iw&#xF9;m&#xEC;sh&#x16B;</pr></trd>
  </trdgrp>
</drv>
</art>
