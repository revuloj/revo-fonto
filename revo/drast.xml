<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: drast.xml,v 1.33 2026/09/14 18:00:23 revo Exp $">
<kap>
  <ofc>9</ofc><rad>drast</rad>/a <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="drast.0a">
  <kap><ofc>9</ofc><tld/>a</kap>
  <snc mrk="drast.0a.KOMUNE">
    <dif>
      Fortege, <ref tip="sin" cel="mild.mal0a">malmilde</ref>, rapide,
      <ref tip="sin" cel="radika.0a">radikale</ref> efikanta:
      <ekz>
        <tld/>a medikamento, &scirc;an&gcirc;o, kresko, esprimo
        <fnt><bib>OA9</bib></fnt>,
      </ekz>
      <ekz>
        <tld/>a kontrasto <klr>(kreanta fortan impreson)</klr>
        <fnt><bib>OA9</bib></fnt>;
      </ekz>
      <ekz>
        tio ja estas <tld/>a laksigilo
        <fnt>
          <bib>KrB</bib>
        </fnt>;
      </ekz>
      <ekz>
        oni tradra&scirc;as min, kaj sufi&ccirc;e <tld/>e
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
        </fnt>;
      </ekz>
      <ekz>
        Japanujo <klr>[&#8230;]</klr> sukcesis per <tld/>a utiligo de naskolimigo kaj aliaj
        rimedoj jam stabiligi sian lo&gcirc;antaron
        <fnt>
          <bib>AzS</bib>
        </fnt>;
      </ekz>
      <ekz>
        la optimismo pri e&ubreve;ropa estonteco <tld/>e falis, de 95&#8239;% anta&ubreve; kelkaj jaroj &gcirc;is
        45&#8239;%
        <fnt>
          <bib>Monato</bib>
          <aut>Bardhyl Selimi</aut>
          <vrk><url ref="&Monato;/2015/011460.php">Denove elmigrado</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="abrupt.0a">abrupta</ref>,
      <ref cel="akr.0a.vigla">akra<sncref/></ref>,
      <ref cel="drakon.0a">drakona</ref>,
      <ref cel="efik.0a">efika</ref>,
      <ref cel="energi.0a">energia</ref>,
      <ref cel="grav.0a">grava</ref>,
      <ref cel="frap.okul0a">okulfrapa</ref>,
      <ref cel="sever.0a">severa</ref>,
      <ref cel="rigor.0a">rigora</ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_m;&c_o;&c_c;&c_n;&c_y;</trd>,
    <trd>&c_m;&c_o;&c_c;&c_n;&c_a;&c_d;&c_z;&c_je;&c_ju;&c_ch;&c_y;</trd>
    <trd>&c_r;&c_e;&c_z;&c_k;&c_ib;</trd>,
    <trd>&c_e;&c_f;&c_e;&c_k;&c_t;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="ca">dr&agrave;stic</trd>
  <trdgrp lng="de">
    <trd>drastisch</trd>,
    <trd>derb</trd>,
    <trd>gut <ind>einschlagend</ind></trd>,
    <trd>wirksam</trd>,
    <trd>stark</trd>,
    <trd>radikal</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>drastic</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>dr&aacute;stico</trd>,
    <trd>radical</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>drastique</trd>
    <trd>draconien</trd>
    <trd>frappant</trd>
    <trd>impressionnant</trd>,
    <trd>puissant<klr tip="ind"> (tr&egrave;s efficace)</klr></trd>
    <trd>s&eacute;v&egrave;re<klr tip="ind"> (draconien)</klr></trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>er&odblac;s hat&aacute;s&uacute;</trd>
    <trd>er&odblac;s</trd>,
    <trd>drasztikus</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#34220;&#21177;&#12398;&#28608;&#12375;&#12356;  <pr>&#12420;&#12387;&#12371;&#12358;&#12398;&#12399;&#12370;&#12375;&#12356;</pr></trd>,
    <trd>&#24375;&#28872;&#12394;  <pr>&#12365;&#12423;&#12358;&#12428;&#12388;&#12394;</pr></trd>,
    <trd>&#28608;&#28872;&#12394;  <pr>&#12370;&#12365;&#12428;&#12388;&#12394;</pr></trd>,
    <trd>&#24505;&#24213;&#30340;&#12394;  <pr>&#12390;&#12387;&#12390;&#12356;&#12390;&#12365;&#12394;</pr></trd>,
    <trd>&#24605;&#12356;&#20999;&#12387;&#12383;  <pr>&#12362;&#12418;&#12356;&#12365;&#12387;&#12383;</pr></trd>,
    <trd>&#21427;&#12375;&#12356;  <pr>&#12365;&#12403;&#12375;&#12356;</pr></trd>
  </trdgrp>
  <trd lng="nl">drastisch</trd>
  <trd lng="pl">drastyczny</trd>
  <trdgrp lng="pt">
    <trd>dr&aacute;stico</trd>,
    <trd>violento</trd>,
    <trd>en&eacute;rgico</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_s;&c_i;&c_l;&c_mol;&c_n;&c_o;&c_d;&c_je;&c_j;&c_s;&c_t;&c_v;&c_u;&c_ju;&c_shch;&c_i;&c_j;</trd>,
    <trd>&c_r;&c_je;&c_z;&c_k;&c_i;&c_j;</trd>
    <trd>&c_v;&c_p;&c_je;&c_ch;&c_a;&c_t;&c_l;&c_ja;&c_ju;&c_shch;&c_i;&c_j;</trd>,
    <trd>&c_e;&c_f;&c_f;&c_je;&c_k;&c_t;&c_n;&c_y;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_d;&c_r;&c_a;&c_s;&c_t;&c_i;&c_ch;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_s;&c_i;&c_l;&c_mol;&c_n;&c_o; &c_d;&c_ib;&c_ju;&c_ch;&c_i;&c_j;</trd>,
    <trd>&c_r;&c_ib;&c_z;&c_k;&c_i;&c_j;</trd>,
    <trd>&c_ja;&c_k;&c_i;&c_j; &c_s;&c_p;&c_r;&c_a;&c_v;&c_l;&c_ja;&c_jeu; &c_s;&c_i;&c_l;&c_mol;&c_n;&c_je;
    &c_v;&c_r;&c_a;&c_zh;&c_je;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_s;&c_i;&c_l;&c_mol;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#26681;&#26412;&#19978; <pr>g&emacron;nb&ecaron;nsh&agrave;ng</pr></trd>,
    <trd>&#36895;&#25928; <pr>s&ugrave;xi&agrave;o</pr></trd>
  </trdgrp>
</drv>

<drv mrk="drast.0eco">
  <kap><tld/>eco</kap>
  <snc mrk="drast.0eco.KOMUNE">
    <dif>
      Forta, sendevoji&gcirc;a, eventuale kruda efikado:
      <ekz>
        la komikan li regule prezentas kun tia <tld/>eco
        kaj natureco <klr>[&#8230;]</klr>, ke &ccirc;iuj estas ravitaj
        <fnt>
          <aut>T. Mann, trad. K. Schulze</aut>
          <vrk>Lotte en Weimar</vrk>
          <lok>2005</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_r;&c_e;&c_z;&c_k;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_m;&c_o;&c_c;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="ca">radicalitat</trd>
  <trd lng="de">Derbheit</trd>
  <trdgrp lng="fr">
    <trd>&acirc;pret&eacute;</trd>,
    <trd>rigueur</trd>
  </trdgrp>
</drv>

<drv mrk="drast.0igi">
  <kap><tld/>igi</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="drast.0igi.KOMUNE">
    <dif>
      Igi <tld/>a, <ref tip="vid" cel="sever.0igi.KOMUNE">severigi</ref>, radikaligi:
      <ekz>
        la konservativa registaro, kiu regas en Grekio de anta&ubreve; jaro,
        iom post iom <tld/>igas <klr>[&#8230;]</klr> la le&gcirc;aron kontra&ubreve; la rifu&gcirc;intoj
        <fnt>
          <aut>R. Poort, A. Pe&ccirc;&euml;nkin</aut>
          <vrk><url ref="http://muzaiko.info/programdetaloj?id=1218">
          Tutmondaj Nova&jcirc;oj</url></vrk>
          <lok>Muzaiko, 2020-06-25</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_u;&c_z;&c_m;&c_a;&c_c;&c_n;&c_ja;&c_c;&c_mol;</trd>,
    <trd>&c_a;&c_b;&c_v;&c_a;&c_s;&c_t;&c_r;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>radicalitzar</trd>,
    <trd>endurir</trd>
  </trdgrp>
  <trd lng="de">versch&auml;rfen</trd>
  <trd lng="fr">raidir</trd>
</drv>

<drv mrk="drast.mal0a">
  <kap>mal<tld/>a</kap>
  <snc mrk="drast.mal0a.KOMUNE">
    <dif>
      <ref tip="vid" cel="mild.0a">Milda</ref>,
      <ref tip="vid" cel="iom.0post0a.KOMUNE">iompostioma</ref>,
      ne tro subita kaj forta:
      <ekz>
        modifi la sistemon mal<tld/>e
        <fnt>
          <aut>B. Vaha</aut>,
          <vrk>Simplaj komplika&jcirc;oj</vrk>,
          <lok><url ref="http://ilei.info/ipr/ipr_1997_3.htm">
          Internacia Pedagogia Revuo, 1997:3</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="grad.0a.iompostioma">grada</ref>
  </snc>
  <trdgrp lng="be">
    <trd>&c_m;&c_ja;&c_k;&c_k;&c_ib;</trd>,
    <trd>&c_n;&c_ja;&c_m;&c_o;&c_c;&c_n;&c_y;</trd>,
    <trd>&c_n;&c_ja;&c_r;&c_e;&c_z;&c_k;&c_ib;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>calmat</trd>,
    <trd>pausat</trd>,
    <trd>assossegat</trd>,
    <trd>gradual</trd>,
    <trd>progressiu</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>allm&auml;hlich</trd>,
    <trd>graduell</trd>,
    <trd>vorsichtig</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>paulatino</trd>,
    <trd>gradual</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>graduel</trd>,
    <trd>retenu<klr> (mod&eacute;r&eacute;)</klr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>delilkatny</trd>,
    <trd>spokojny</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#36880;&#27425; <pr>zh&uacute;c&igrave;</pr></trd>,
    <trd>&#36880;&#28176; <pr>zh&uacute;ji&agrave;n</pr></trd>,
    <trd>&#28176;&#27425; <pr>ji&agrave;nc&igrave;</pr></trd>,
    <trd>&#26085;&#30410;&#22686;&#22810;&#22320; <pr>r&igrave;y&igrave;z&emacron;ngdu&#333;de</pr></trd>,
    <trd>&#28176; <pr>ji&agrave;n</pr></trd>,
    <trd>&#20873;&#20873; <pr>r&#462;nr&#462;n</pr></trd>,
    <trd>&#20840;&#33021; <pr>qu&aacute;nn&eacute;ng</pr></trd>
  </trdgrp>
</drv>
</art>
