<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: vejn.xml,v 1.36 2026/08/02 10:09:49 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>vejn</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="vejn.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="vejn.0o.ANA">
    <uzo tip="fak">ANA</uzo>
    <dif>
      Tubeto rekondukanta la sangon al la koro:
      <ekz>
        &ccirc;u vi vidas tiujn &ccirc;i du bluajn <tld/>ojn, kiuj kuras de la kubuto al la fingroj
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>?
      </ekz>
      <ekz>
        hispana sango rulas en &scirc;iaj <tld/>oj
        <fnt>
          <bib>Fab2</bib>
          <lok>Malbela anasido</lok>
        </fnt>;
      </ekz>
      <ekz>
        se ankora&ubreve; unu guto da germana heroa sango fluas en viaj <tld/>oj, &mdash; venu
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Unua</lok>
        </fnt>!
      </ekz>
      <ekz>
        Viktoro <klr>[&#8230;]</klr> sentis en liaj vejnoj la ekbruli&gcirc;on de dezirega febro
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Sesa</lok>
        </fnt>;
      </ekz>
      <ekz>
        varma sento trakuris miajn <tld/>ojn kaj mi rekonscii&gcirc;is
        <fnt>
          <bib>IdO</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        frosti&gcirc;is la sango en miaj <tld/>oj pro la ekvidita terura&jcirc;o
        <fnt>
          <bib>VaK</bib>
          <lok>Deksesa &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi ne inokulos malsanan sangon en <tld/>ojn de mortantino
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> resanigis la varikajn <tld/>ojn de mona&hcirc;ino
        <fnt>
          <bib>Monato</bib>
          <aut>W. H. Simcock</aut>
          <vrk><url ref="&Monato;/2005/008520.php"
              >Sanktuloj</url></vrk>
          <lok>2005</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="super">
      <ref cel="angi.0o">angio</ref>,
      <ref cel="vaskul.0o.ANA">vaskulo<sncref/></ref>
    </refgrp>
    <refgrp tip="vid">
      <ref cel="arteri.0o.ANA">arterio<sncref/></ref>
    </refgrp>
    <trdgrp lng="be">
      <trd>&c_v;&c_je;&c_n;&c_a;</trd>,
      <trd>&c_zh;&c_y;&c_l;&c_k;&c_a;</trd>
    </trdgrp>
    <trd lng="ca">vena</trd>
    <trd lng="de">Vene</trd>
    <trd lng="es">vena</trd>
    <trdgrp lng="hu">
      <trd>v&eacute;na</trd>,
      <trd>vissz&eacute;r</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd>vena</trd>,
      <trd>pem<ind>buluh</ind> balik</trd>
    </trdgrp>
    <trd lng="it">vena</trd>
    <trd lng="pl">&zdot;y&lstroke;a</trd>
    <trd lng="ru">&c_v;&c_je;&c_n;&c_a;</trd>
    <trd lng="sv">ven</trd>
    <trd lng="tr">kan damar&inodot;</trd>
  </snc>
  <snc mrk="vejn.0o.MIN">
    <uzo tip="fak">MIN</uzo>
    <dif>
      Longa mallar&gcirc;a tavolo el sama substanco en grundo:
      <ekz>
        mineja <tld/>o el karbo;
      </ekz>
      <ekz>
        la plej granda petrola kaj gasa <tld/>o de la kontinenta E&ubreve;ropo
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2012/010686.php"
              >Mizeriga petrolo</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi scias kie situas la ora <tld/>o, do mia afero estas organizi la eligon kaj la
        transporton
        <fnt>
          <bib>LOdE</bib>
          <lok>2004, &#8470; 3 (113)</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="gang.0o">gango</ref>,
      <ref cel="min.0o.MIN">mino<sncref/></ref>
    </refgrp>
    <trdgrp lng="be">
      <trd>&c_z;&c_l;&c_o;&c_zh;&c_zh;&c_a;</trd>,
      <trd>&c_zh;&c_y;&c_l;&c_a; <klr tip="amb">(&c_g;&c_je;&c_a;&c_l;.)</klr></trd>
    </trdgrp>
    <trdgrp lng="ca">
      <trd>fil&oacute;</trd>,
      <trd>bei</trd>
    </trdgrp>
    <trd lng="de">Ader <klr>(Mineral)</klr></trd>
    <trdgrp lng="es">
      <trd>veta</trd>,
      <trd>fil&oacute;n</trd>
    </trdgrp>
    <trd lng="hu">tel&eacute;r</trd>
    <trd lng="it">vena</trd>
    <trd lng="pl">&zdot;y&lstroke;a</trd>
    <trd lng="ru">&c_zh;&c_i;&c_l;&c_a; <klr tip="amb">(&c_g;&c_je;&c_o;&c_l;.)</klr></trd>
  </snc>
  <snc mrk="vejn.0o.FIG">
    <dif>
      Ondlinia streko en iu materialo, similanta <tld/>ojn sub la ha&ubreve;to:
      <ekz>
        la <tld/>oj de marmoro, ligno;
      </ekz>
      <ekz>
        <klr>[t]</klr>ion ni en folio nomas <tld/>oj
        <klr>(vd <ref cel="nervur.0o.BIO">nervuro</ref>)</klr>
        <fnt>
          <bib>Fab2</bib>
          <lok>Elfo de la rozo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la triangulo, distran&ccirc;ita de la akvaj <tld/>oj, estas bildo de Malsupra Egipto
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur la bluaj vasta&jcirc;oj <tld/>oj de akvumita tero serpentas kaprice
        <fnt>
          <bib>Mizero</bib>
          <lok>I</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_p;&c_r;&c_a;&c_zh;&c_y;&c_l;&c_a;&c_k;</trd>
    <trdgrp lng="ca">
      <trd>veta</trd>,
      <trd>nervi</trd>,
      <trd>vin&ccedil;a</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>&Auml;derung</trd>,
      <trd>Maserung</trd>
    </trdgrp>
    <trd lng="es">vena</trd>
    <trd lng="hu">erezet</trd>
    <trd lng="it">venatura</trd>
    <trd lng="pl">&zdot;y&lstroke;a</trd>
    <trd lng="ru">&c_p;&c_r;&c_o;&c_zh;&c_i;&c_l;&c_k;&c_a;</trd>
  </snc>
  <trd lng="bg">&c_v;&c_je;&c_n;&c_a;</trd>
  <trd lng="bo">&t_ra;&t_tsata;&t_tsheg;</trd>
  <trd lng="ca">vena</trd>
  <trdgrp lng="cs">
    <trd>v&eacute;na</trd>,
    <trd>&zcaron;&iacute;la</trd>
  </trdgrp>
  <trd lng="el">&alfa;&gamma;&gamma;&epsilon;&jota_ton;&omikron;</trd>
  <trd lng="en">vein</trd>
  <trd lng="fr">veine</trd>
  <trdgrp lng="ja">
    <trd>&#38745;&#33032;  <pr>&#12376;&#12423;&#12358;&#x307F;&#12419;&#x304F;</pr></trd>,
    <trd>&#37489;&#33032;  <pr>&#12371;&#12358;&#x307F;&#12419;&#x304F;</pr></trd>,
    <trd>&#26408;&#x76EE;  <pr>&#12418;&#x304F;&#12417;</pr></trd>,
    <trd>&#x77F3;&#x76EE;  <pr>&#12356;&#12375;&#12417;</pr></trd>
  </trdgrp>
  <trd lng="nl">ader</trd>
  <trd lng="pl">&zdot;y&lstroke;a</trd>
  <trd lng="pt">veia</trd>
  <trd lng="sk">&zcaron;ila</trd>
  <trdgrp lng="uk">
    <trd>&c_v;&c_je;&c_n;&c_a;</trd>,
    <trd>&c_zh;&c_i;&c_l;&c_a;</trd>,
    <trd>&c_zh;&c_i;&c_l;&c_k;&c_a;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#38738;&#x7B4B; <pr>q&imacron;ngj&imacron;n</pr></trd>,
    <trd>&#x7D0B;&#29702; <pr>w&eacute;nl&#x1D0;</pr></trd>,
    <trd>&#x7EB9;&#29702; <pr>w&eacute;nl&#x1D0;</pr></trd>,
    <trd>&#38745;&#33033; <pr>j&igrave;ngm&agrave;i</pr></trd>,
    <trd>&#x975C;&#33032; <pr>j&igrave;ngm&agrave;i</pr></trd>,
    <trd>&#x739F; <pr>w&eacute;n</pr></trd>,
    <trd>&#x7D0B;&#x7E37; <pr>w&eacute;nl&#x1D4;:</pr></trd>,
    <trd>&#x7EB9;&#x7F15; <pr>w&eacute;nl&#x1D4;:</pr></trd>
  </trdgrp>
</drv>

<drv mrk="vejn.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="vejn.0i.FIG">
    <dif>
      Marki <tld/>ojn sur ion:
      <ekz>
        &ccirc;e la kolo bro&ccirc;o kiel verda folio <tld/>ita per ar&gcirc;ento
        <fnt>
          <aut>John Ronald Reuel Tolkien, trad. William Auld</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/0151/0029.php"
              >La Kunularo de l' Ringo</url></vrk>
          <lok>&Ccirc;apitro 8: Adia&ubreve; al Lorieno</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_r;&c_y;&c_s;&c_a;&c_v;&c_a;&c_c;&c_mol; <ind>&c_p;&c_r;&c_a;&c_zh;&c_y;&c_l;&c_k;&c_ib;</ind></trd>
  <trd lng="ca">marcar les venes</trd>
  <trd lng="cs">imitovat &zcaron;ilkov&aacute;n&iacute;</trd>
  <trdgrp lng="de">
    <trd>&auml;dern</trd>,
    <trd>masern</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>mark with veins</trd>,
    <trd>marble</trd>
  </trdgrp>
  <trd lng="es">marcar las venas</trd>
  <trd lng="fr">veiner</trd>
  <trd lng="hu">erez</trd>
  <trd lng="it">venare</trd>
  <trdgrp lng="ja">
    <trd>&#26408;&#x76EE;&#x6A21;&#x69D8;&#12434;&#12388;&#12369;&#x308B;  <pr>&#12418;&#x304F;&#12417;&#12418;&#12424;&#12358;&#12434;&#12388;&#12369;&#x308B;</pr></trd>,
    <trd>&#x77F3;&#x76EE;&#x6A21;&#x69D8;&#12434;&#12388;&#12369;&#x308B;  <pr>&#12356;&#12375;&#12417;&#12418;&#12424;&#12358;&#12434;&#12388;&#12369;&#x308B;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>aderen</trd>,
    <trd>marmeren</trd>
  </trdgrp>
  <trd lng="pl">&zdot;y&lstroke;&eogonek; zaznacza&cacute;</trd>
  <trd lng="sk">&zcaron;ilkova&tcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_r;&c_o;&c_v;&c_o;&c_d;&c_i;&c_t;&c_i; &c_zh;&c_i;&c_l;&c_k;&c_i;</trd>,
    <trd>&c_o;&c_b;&c_r;&c_o;&c_b;&c_l;&c_ja;&c_t;&c_i; &c_p;&c_ib;&c_d; &c_d;&c_je;&c_r;&c_je;&c_v;&c_o;</trd>,
    <trd>&c_m;&c_a;&c_r;&c_m;&c_u;&c_r;</trd>
  </trdgrp>
</drv>
</art>
