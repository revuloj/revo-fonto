<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: infini.xml,v 1.29 2026/09/15 11:39:04 revo Exp $">
<kap>
  <rad>infinit</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="infini.0o">
  <kap><tld/>o</kap>
  <snc mrk="infini.0o.KOMUNE">
    <dif>
      Senlima grando, senlima malproksimo:
      <ekz>
        la sensacio estis kvaza&ubreve; mi retenus senfinan energion, kiu ne povis eskapi el
        mia korpo, neniam malaperis tiu <tld/>o ene de mi
        <fnt>
          <bib>Kon11</bib>
          <lok>La aldono de valoro kiel strategio (Enric Baltasar)</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiuj, kiuj kredas je ia dio, komprenas, kial ili tiel kredas, <klr>[&#x2026;]</klr> la
        ceteruloj, la nekredantoj, tamen gustumas la <tld/>on
        <fnt>
          <bib>Monato</bib>
          <aut>Angela Tellier</aut>
          <vrk><url ref="&Monato;/2004/008306.html"
              >La&ubreve;proverbaj fabeloj</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="hu">
      <trd>v&eacute;gtelen</trd>,
      <trd>v&eacute;gtelens&eacute;g</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>niesko&nacute;czono&sacute;&cacute;</trd>,
      <trd>bezkres</trd>
    </trdgrp>
    <trd lng="ro">infinitate</trd>
  </snc>
  <snc mrk="infini.0o.MAT">
    <uzo tip="fak">MAT</uzo>
    <uzo tip="stl">ARK</uzo>
    <fnt><bib>MatTerm</bib><lok>p. 17</lok></fnt>
    <ref tip="dif" cel="fini.mal0o">malfinio</ref>
    <refgrp tip="vid">
      <ref cel="infini1.0o.MAT">infinitezimo</ref>
    </refgrp>
    <trd lng="de">Unendlich</trd>
    <trd lng="en">infinity</trd>
    <trd lng="hu">v&eacute;gtelen</trd>
    <trd lng="pl">niesko&nacute;czono&sacute;&cacute;</trd>
  </snc>
  <trd lng="be">&c_b;&c_ja;&c_s;&c_k;&c_o;&c_n;&c_c;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>
  <trd lng="ca">infinit</trd>
  <trdgrp lng="cs">
    <trd>infinitum</trd>,
    <trd>nekone&ccaron;no</trd>
  </trdgrp>
  <trd lng="es">infinito</trd>
  <trd lng="fr">infini<klr tip="ind"> (subst.)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#x7121;&#x9650;  <pr>&#x3080;&#x3052;&#x3093;</pr></trd>,
    <trd>&#x7121;&#x9650;&#x5927;  <pr>&#x3080;&#x3052;&#x3093;&#x3060;&#x3044;</pr></trd>
  </trdgrp>
  <trd lng="nl">oneindigheid</trd>
  <trd lng="pt">infinito<klr tip="ind"> (subst.)</klr></trd>
  <trd lng="ru">&c_b;&c_je;&c_s;&c_k;&c_o;&c_n;&c_je;&c_ch;&c_n;&c_o;&c_s;&c_t;&c_mol;</trd>
  <trd lng="sk">nekone&ccaron;n&aacute; ve&lcaron;kos&tcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_n;&c_je;&c_s;&c_k;&c_ib;&c_n;&c_ch;&c_je;&c_n;&c_n;&c_ib;&c_s;&c_t;&c_mol;</trd>,
    <trd>&c_b;&c_je;&c_z;&c_k;&c_o;&c_n;&c_je;&c_ch;&c_n;&c_ib;&c_s;&c_t;&c_mol;</trd>
  </trdgrp>
  <trd lng="zh">&#x65E0;&#x7A77; <pr>w&uacute;qi&oacute;ng</pr></trd>
</drv>

<drv mrk="infini.0a">
  <kap><tld/>a</kap>
  <snc mrk="infini.0a.KOMUNE">
    <dif>
      Senlime granda a&ubreve; malproksima:
      <ekz>
        <klr>[ili]</klr> fu&gcirc;is <klr>[je]</klr> multaj <tld/>aj kilometroj for de siaj
        naski&gcirc;ujoj
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i tamen prenis tian <tld/>an vo&ccirc;on, ke la bruo de pluraj atombomboj similus al
        la tute senventa falo de folieto
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">unendlich</trd>
    <trdgrp lng="pl">
      <trd>niesko&nacute;czony</trd>,
      <trd>bezkresny</trd>
    </trdgrp>
  </snc>
  <snc mrk="infini.0a.MAT">
    <uzo tip="fak">MAT</uzo>
    <uzo tip="stl">ARK</uzo>
    <fnt><bib>MatTerm</bib><lok>p. 17</lok></fnt>
    <dif>
      <ref tip="dif" cel="fini.mal0a">Malfinia</ref>; strebanta al
      malfinio.
    </dif>
    <rim>
      Depende de la kunteksto pli prozaj sinonimoj povus esti
      <ctl>senfina</ctl>, <ctl>senlima</ctl>, <ctl>senranda</ctl>...
      Tamen <nom>Bricard</nom> pravigas la radikon, atentigante pri la pedanta diferenco
      inter
      <ekz>
       senfina sinsekvo,
      </ekz>
      <ekz>
        senlima kresko de funkcio,
      </ekz>
      kaj aliflanke
      <ekz>
        infinita kiomo <klr>(kvanto)</klr> de naturaj nombroj.
      </ekz>
      Ja oni ne povus diri, strikte parolante, ke kvanto <ctl>ne havas
      finon</ctl> a&ubreve; <ctl>ne havas limon</ctl>, &ccirc;ar kio estas
      fino a&ubreve; limo de kvanto ne estas difinita. En tiuj &ccirc;i
      tri ekzemploj la nuntempuloj ne hezitas uzi nur
      <ctl>nefinia</ctl>.
      Estas interese rimarki, ke <ctl><tld/>a</ctl> estis por <nom>Bricard</nom>
      nederivita vorto, ver&scirc;ajne, kiel <ctl>finita</ctl> mem,
      malgra&ubreve; &gcirc;ia participa aspekto. En
      <fnt><bib>PV</bib></fnt> oni provis sistemigi la aferon,
      prezentante
      la paron <ctl>finita</ctl>/<ctl>nefinita</ctl> kiel deriva&jcirc;ojn de
      la verbo <ctl>fini</ctl>, kion la senco tute ne allasas. La
      moderna
      uzo solvas la problemon per la paro
      <ctl>finia</ctl>/<ctl>nefinia</ctl>,
      do per nova radiko <ctl>fini</ctl><fnt><bib>PIV1</bib></fnt>,
      kiu tamen devis venki la strangan samcelan
      <ctl>fajnajt</ctl><fnt><bib>SPIV</bib></fnt>...
    </rim>
    <trd lng="de">unendlich</trd>
    <trd lng="en">infinite</trd>
    <trd lng="pl">niesko&nacute;czony</trd>
  </snc>
  <trd lng="be">&c_b;&c_ja;&c_s;&c_k;&c_o;&c_n;&c_c;&c_y;</trd>
  <trd lng="ca">infinit</trd>
  <trd lng="cs">nekone&ccaron;n&yacute;</trd>
  <trd lng="es">infinito</trd>
  <trd lng="fr">infini<klr tip="ind"> (adj.)</klr></trd>
  <trd lng="hu">v&eacute;gtelen</trd>
  <trdgrp lng="ja">
    <trd>&#x7121;&#x9650;&#x306E;  <pr>&#x3080;&#x3052;&#x3093;&#x306E;</pr></trd>,
    <trd>&#x7121;&#x9650;&#x5927;&#x306E;  <pr>&#x3080;&#x3052;&#x3093;&#x3060;&#x3044;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="nl">oneindig</trd>
  <trd lng="pt">infinito<klr tip="ind"> (adj.)</klr></trd>
  <trd lng="ro">infinit</trd>
  <trd lng="ru">&c_b;&c_je;&c_s;&c_k;&c_o;&c_n;&c_je;&c_ch;&c_n;&c_y;&c_j;</trd>
  <trd lng="sk">nekone&ccaron;n&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#x6F2B;&#x6F2B; <pr>m&agrave;nm&agrave;n</pr></trd>,
    <trd>&#x6F92; <pr>h&ograve;ng</pr></trd>,
    <trd>&#x65E0;&#x57A0; <pr>w&uacute;y&iacute;n</pr></trd>,
    <trd>&#x65E0;&#x7A77; <pr>w&uacute;qi&oacute;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="infini.0iganto">
  <kap><tld/>iganto</kap>
  <fnt><bib>MatTerm</bib><lok>p. 20</lok></fnt>
  <snc>
    <dif>
      <klr>(de <ref cel="bild.0igo.MAT">bildigo</ref>)</klr>
      Tia punkto de la fonto-aro, &ccirc;e kiu la bildigo strebas al
      malfinio.
    </dif>
  </snc>
  <trd lng="pl"><klr>(punkt)</klr> zmierzaj&aogonek;cy do niesko&nacute;czono&sacute;ci</trd>
</drv>

<drv mrk="infini.0igxi">
  <kap><tld/>i&gcirc;i</kap>
  <uzo tip="fak">MAT</uzo>
  <fnt><bib>MatTerm</bib><lok>p. 17</lok></fnt>
  <snc>
    <dif>
      Strebi al malfinio.
    </dif>
  </snc>
  <trd lng="be">&c_ib;&c_m;&c_k;&c_n;&c_u;&c_c;&c_c;&c_a; &c_d;&c_a;
    &c_b;&c_ja;&c_s;&c_k;&c_o;&c_n;&c_c;&c_a;&c_s;&c_mol;&c_c;&c_ib;</trd>
  <trd lng="ca">tendir a l'infinit</trd>
  <trd lng="de">gegen Unendlich <ind>streben</ind></trd>
  <trd lng="en">approach infinity</trd>
  <trd lng="es">tender al <ind>infinito</ind></trd>
  <trd lng="fr">tendre vers l'infini</trd>
  <trd lng="hu">v&eacute;gtelenhez tart</trd>
  <trd lng="ja">&#x7121;&#x9650;&#x5927;&#x306B;&#x306A;&#x308B;  <pr>&#x3080;&#x3052;&#x3093;&#x3060;&#x3044;&#x306B;&#x306A;&#x308B;</pr></trd>
  <trd lng="pl">d&aogonek;&zdot;y&cacute; do niesko&nacute;czono&sacute;ci</trd>
  <trd lng="pt">tornar-se <ind>infinitamente</ind> grande</trd>
  <trd lng="ru">&c_s;&c_t;&c_r;&c_je;&c_m;&c_i;&c_t;&c_mol;&c_s;&c_ja; &c_k;
  &c_b;&c_je;&c_s;&c_k;&c_o;&c_n;&c_je;&c_ch;&c_n;&c_o;&c_s;&c_t;&c_i;</trd>
</drv>
</art>
