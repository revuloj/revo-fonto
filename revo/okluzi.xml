<vortaro>
  <art mrk="$Id: okluzi.xml,v 1.1 2026/11/25 09:02:46 afido Exp $">
    <kap>
      <rad>okluzi</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="okluzi.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">MED</uzo>
    <dif>
      Malsaneca a&ubreve; &hcirc;irurgia fermo de kava organo:
      <ekz>
        en la akvodukta regiono de la cerbo povas, ka&ubreve;ze de <tld/>o, esti&gcirc;i interna
        hidrocefalo kaj simptomoj de cerba tumoro
        <fnt>
          <bib>SR</bib>
          <aut>R. Sachs</aut>
          <vrk>Medicina Parazitologio</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Okklusion</trd>
    <trd lng="en">occlusion</trd>
    <trd lng="fr">occlusion</trd>
    <trd lng="ru">&c_z;&c_a;&c_k;&c_u;&c_p;&c_o;&c_r;&c_k;&c_a; <klr>(&c_s;&c_o;&c_s;&c_u;&c_d;&c_o;&c_v;)</klr></trd>
  </snc>
</drv>

  </art>


