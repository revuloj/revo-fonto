<drv mrk="municip.0o">
  <kap><tld/>o</kap>
  <snc mrk="municip.0o.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      Loka administracio de vila&gcirc;o, urbo a&ubreve; urbega distrikto:
      <ekz>
        li sukcesis levi Macondon al la kategorio de <tld/>o
        <fnt><aut>G. Garc&iacute;a M&aacute;rquez, trad. F. de Diego</aut>,
        <vrk>Cent
        Jaroj da Soleco</vrk>, <lok>Fonto, 1992</lok></fnt>;
      </ekz>
      <ekz>
        oni diskutis pri senpaga disponigo de ejoj, kiuj apartenas al
        la urba <tld/>o
        <fnt><aut>P. Jegorovas</aut>, <vrk>Litovia Kalejdoskopo</vrk>,
        <bib>LOdE</bib>, <lok>2004:4 (114)</lok></fnt>.
      </ekz>
    </dif>
  <ref tip="vid" cel="komun.0umo">komunumo.</ref>
  </snc>
  <trdgrp lng="be">
    <trd>&c_m;&c_u;&c_n;&c_ib;&c_c;&c_y;&c_p;&c_a;&c_l;&c_ib;&c_t;&c_e;&c_t;</trd>,
    <trd>&c_m;&c_ja;&c_s;&c_c;&c_o;&c_v;&c_a;&c_ja;
    <ind>&c_a;&c_d;&c_m;&c_ib;&c_n;&c_ib;&c_s;&c_t;&c_r;&c_a;&c_c;&c_y;&c_ja;</ind></trd>
  </trdgrp>
  <trd lng="bg">&c_o;&c_b;&c_shch;&c_i;&c_n;&c_a;</trd>
  <trd lng="ca">municipi</trd>
  <trd lng="cs">municipium</trd>
  <trd lng="da">kommune</trd>
  <trd lng="de">Gemeinde</trd>
  <trd lng="el">&delta;&eta_ton;&my;&omikron;&sigma_fina;</trd>
  <trd lng="en">municipality</trd>
  <trd lng="es">municipio</trd>
  <trd lng="fi">kunta</trd>
  <trdgrp lng="fr">
    <trd>commune<klr> (municipalit&eacute;)</klr></trd>,
    <trd>municipalit&eacute;</trd>
  </trdgrp>
  <trd lng="it">municipio</trd>
  <trd lng="ja">&#33258;&#27835;&#20307;  <pr>&#12376;&#12385;&#12383;&#12356;</pr></trd>
  <trd lng="nl">gemeente</trd>
  <trd lng="no">kommune</trd>
  <trdgrp lng="oc">
    <trd>comuna</trd>,
    <trd>municipalitat</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>gmina</trd>,
    <trd>gr&oacute;d</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>munic&iacute;pio</trd>,
    <trd>concelho</trd>
  </trdgrp>
  <trd lng="ro">municipiu</trd>
  <trd lng="sk">municipium</trd>
  <trd lng="sv">kommun</trd>
  <trdgrp lng="uk">
    <trd>&c_m;&c_u;&c_n;&c_ib;&c_c;&c_i;&c_p;&c_a;&c_l;&c_ib;&c_t;&c_je;&c_t;</trd>,
    <trd>&c_m;&c_ib;&c_s;&c_mol;&c_k;&c_je; &c_s;&c_a;&c_m;&c_o;&c_v;&c_r;&c_ja;&c_d;&c_u;&c_v;&c_a;&c_n;&c_n;&c_ja;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#24066; <pr>sh&igrave;</pr></trd>,
    <trd>&#22522;&#23618;&#25919;&#26435; <pr>j&#299;c&eacute;ngzh&egrave;ngqu&aacute;n</pr></trd>,
    <trd>&#22522;&#23652;&#25919;&#27402; <pr>j&#299;c&eacute;ngzh&egrave;ngqu&aacute;n</pr></trd>,
    <trd>&#34892;&#25919;&#26449; <pr>x&iacute;ngzh&egrave;ngc&#363;n</pr></trd>
  </trdgrp>
