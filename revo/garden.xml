<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: garden.xml,v 1.28 2026/09/22 18:44:48 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>gardeni</rad>/o <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="garden.0o">
  <kap><tld/>o</kap>
  <snc mrk="garden.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      &Ccirc;iamverda arbeto el malsekaj tropikaj regionoj kun belaj
      dikpetalaj floroj kaj brilaj malhelverdaj folioj,
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:botanikaj_genroj">genro</ref>
      el familio <ref tip="malprt" cel="rubi.0oj.BOT">rubiacoj</ref>
      (<trd lng="la">Gardenia</trd>):
      <ekz>
        la italo alvenis nokti&gcirc;e kun <tld/>o en la butontruo de la
        jakfaldo
        <fnt><aut>G. Garc&iacute;a M&aacute;rquez, trad. F. de Diego</aut>, <vrk>Cent
        Jaroj da Soleco</vrk>, <lok>Fonto, 1992</lok></fnt>;
      </ekz>
      <ekz>
        li! Alfredo, en blanka kompleto, kun ru&gcirc;a kravato kaj du
        <tld/>oj enmane!
        <fnt>
          <aut>M. Fern&aacute;ndez</aut>,
          <vrk>Du Gardenioj</vrk>,
          <lok>Ekstremoj, 1997</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/2/2c/Gardenia_latifolia_Roxburgh_1798_2-134.jpg/330px-Gardenia_latifolia_Roxburgh_1798_2-134.jpg"
      prm="PD"
      >botanika tabulo de <tld/>o (Gardenia latifolia)
        <fnt>
          <aut>Roxburgh, W., Roxburgh, W., Plants of the coast of Coromandel, vol. 2: t. 134 (1798)plantillustrations</aut>
          <lok><url ref="&WCW;/File:Gardenia_latifolia_Roxburgh_1798_2-134.jpg"
              >https://commons.wikimedia.org/wiki/File:Gardenia_latifolia_Roxburgh_1798_2-134.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_g;&c_a;&c_r;&c_d;&c_e;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="ca">gard&egrave;nia</trd>
  <trd lng="cs">gard&eacute;nie</trd>
  <trd lng="de">Gardenie</trd>
  <trd lng="el">&gamma;&alfa;&rho;&delta;&epsilon_ton;&ny;&jota;&alfa;</trd>
  <trd lng="en">gardenia</trd>
  <trd lng="es">gardenia</trd>
  <trd lng="fr">gard&eacute;nia</trd>
  <trd lng="hu">gard&eacute;nia</trd>
  <trd lng="it">gardenia</trd>
  <trd lng="ja">&#x30AF;&#x30C1;&#x30CA;&#x30B7;</trd>
  <trd lng="nl">gardeniastruik</trd>
  <trd lng="pl">gardenia</trd>
  <trd lng="pt">gard&ecirc;nia</trd>
  <trd lng="ru">&c_g;&c_a;&c_r;&c_d;&c_je;&c_n;&c_i;&c_ja;</trd>
  <trd lng="sk">gard&eacute;nia</trd>
  <trd lng="uk">&c_g;&c_a;&c_r;&c_d;&c_je;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="zh">&#x6800;&#x5B50;&#x82B1; <pr>zh&imacron;z&#x1D0;hu&amacron;</pr></trd>
</drv>
</art>
