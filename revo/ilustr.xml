<vortaro>
<art mrk="$Id: ilustr.xml,v 1.25 2026/09/23 12:00:21 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>ilustr</rad>/i
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="ilustr.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc num="1">
    <dif>
      Ornami tekston per bildoj a&ubreve; desegna&jcirc;oj rilataj al &gcirc;i:
      <ekz><tld/>i libron;</ekz>
      <ekz><tld/>ita revuo.</ekz>
    </dif>
  </snc>
  <snc num="2">
    <dif>
      Ornami per bildoj: <ekz><tld/>ita po&scirc;tkarto.</ekz>
    </dif>
  </snc>
  <snc num="3">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Klarigi ideon per komparoj a&ubreve; ekzemploj:
      <ekz><tld/>i regulon per multaj ekzemploj;</ekz>
      <ekz><tld/>i sian penson per metaforoj kaj figuroj.</ekz>
    </dif>
  </snc>
  <trd lng="be">&c_ib;&c_l;&c_ju;&c_s;&c_t;&c_r;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>
  <trd lng="ca">il&middot;lustrar</trd>
  <trdgrp lng="cs">
    <trd>ilustrovat</trd>,
    <trd>zobrazit</trd>,
    <trd>zobrazovat</trd>
  </trdgrp>
  <trd lng="de">illustrieren</trd>
  <trd lng="en">illustrate</trd>
  <trd lng="es">ilustrar</trd>
  <trd lng="fr">illustrer</trd>
  <trd lng="hu">illusztr&aacute;l</trd>
  <trdgrp lng="id">
    <trd><baz>gambar</baz>menggambarkan</trd>,
    <trd><baz>ilustrasi</baz>mengilustrasikan</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#25407;&#32117;&#12434;&#20837;&#12428;&#12427;  <pr>&#12373;&#12375;&#12360;&#12434;&#12356;&#12428;&#12427;</pr></trd>,
    <trd>&#22259;&#35299;&#12377;&#12427;  <pr>&#12378;&#12363;&#12356;&#12377;&#12427;</pr></trd>,
    <trd>&#35500;&#26126;&#12377;&#12427;  <pr>&#12379;&#12388;&#12417;&#12356;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trd lng="nl">illustreren</trd>
  <trdgrp lng="pl">
    <trd>ilustrowa&cacute;</trd>,
    <trd>ozdabia&cacute;</trd>
  </trdgrp>
  <trd lng="pt">ilustrar</trd>
  <trd lng="ru">&c_i;&c_l;&c_l;&c_ju;&c_s;&c_t;&c_r;&c_i;&c_r;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>
  <trdgrp lng="sk">
    <trd>ilustrova&tcaron;</trd>,
    <trd>zobrazi&tcaron;</trd>
  </trdgrp>
  <trd lng="zh">&#22270;&#35299; <pr>t&uacute;ji&ecaron;</pr></trd>
</drv>

<drv mrk="ilustr.0ajxo">
  <kap><tld/>a&jcirc;o</kap>
  <snc num="1">
    <dif>
      Desegno, kiu <tld/>as.
    </dif>
    <trd lng="nl">illustratie</trd>
  </snc>
  <snc num="2">
    <dif>
      Ekzemplo, kiu klarigas.
    </dif>
    <trd lng="de">Illustration</trd>
    <trd lng="en">illustration</trd>
    <trd lng="nl">voorbeeld</trd>
  </snc>
  <trd lng="be">&c_ib;&c_l;&c_ju;&c_s;&c_t;&c_r;&c_a;&c_c;&c_y;&c_ja;</trd>
  <trd lng="ca">il&middot;lustraci&oacute;</trd>
  <trd lng="es">ilustraci&oacute;n</trd>
  <trd lng="fr">illustration<klr tip="ind"> (ce qui illustre)</klr></trd>
  <trd lng="hu">illusztr&aacute;ci&oacute;</trd>
  <trdgrp lng="id">
    <trd>gambar</trd>,
    <trd>gambaran</trd>,
    <trd><baz>gambar</baz>penggambaran</trd>,
    <trd>ilustrasi</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#25407;&#32117;  <pr>&#12373;&#12375;&#12360;</pr></trd>,
    <trd>&#22259;  <pr>&#12378;</pr></trd>,
    <trd>&#12452;&#12521;&#12473;&#12488;  <pr>&#12356;&#12425;&#12377;&#12392;</pr></trd>,
    <trd>&#20363;&#35388;  <pr>&#12428;&#12356;&#12375;&#12423;&#12358;</pr></trd>,
    <trd>&#20363;&#31034;  <pr>&#12428;&#12356;&#12376;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>ilustracja</trd>,
    <trd>rycina</trd>
  </trdgrp>
  <trd lng="pt">ilustra&ccedil;&atilde;o</trd>
  <trd lng="ru">&c_i;&c_l;&c_l;&c_ju;&c_s;&c_t;&c_r;&c_a;&c_c;&c_i;&c_ja;</trd>
  <trd lng="uk">&c_ib;&c_l;&c_ju;&c_s;&c_t;&c_r;&c_a;&c_c;&c_ib;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#25554;&#30011; <pr>ch&amacron;hu&agrave;</pr></trd>,
    <trd>&#25554;&#22270; <pr>ch&amacron;t&uacute;</pr></trd>
  </trdgrp>
</drv>
</art>
