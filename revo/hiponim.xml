<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: hiponim.xml,v 1.8 2026/09/30 05:29:15 afido Exp $">
    <kap>
      <rad>hiponim</rad>/o
      <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="hiponim.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">LIN</uzo>
    <dif>
      <ref tip="dif" cel="noci.sub0o">Subnocio</ref>:
      <ekz>
        skarlata <klr>[&#8230;]</klr>, karmezina, <klr>[&#8230;]</klr> amba&ubreve; estas <tld/>oj de ru&gcirc;a
        <fnt><bib>LAE</bib> <lok>5. Leksiko Kaj Semantiko</lok></fnt>;
      </ekz><ekz>
        tiaj rilatoj estas sinonimeco, antonimeco, plursignifo, paronimeco, <tld/>eco
        kaj &gcirc;ia malo, kaj inverseco
        <fnt><bib>LAE</bib> <lok>5. Leksiko Kaj Semantiko</lok></fnt>.
      </ekz><ekz>
        En la senco de genro kaj speco estas uzeblaj anka&ubreve; terminoj &leftquot;<tld/>o&rightquot; (genro)
        kaj &leftquot;hiponimo&rightquot; (speco)
        <fnt>
          <aut>Jan Werner</aut>: <vrk>Terminologia kurso</vrk>.
          <lok>&Ccirc;EA, 1986. &para;2.8.</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="ant" cel="noci.super0o">supernocio</ref>
    <ref tip="super" cel="noci.0o">nocio</ref>
    <rim>
      La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>subnomo</ke>.
    </rim>
    <rim>
      Prefere oni <em>ne uzu</em> tiusence la vorton <ke>subnomo</ke>, &ccirc;ar ne
      temas pri parto de nomo. Kaj se anstata&ubreve; la nomo de specio &leftquot;Koreia pino&rightquot;
      (Pinus koraiensis) oni uzos la &leftquot;subnomon&rightquot; <ke>pino</ke>, tiam rezultros
      ne <tld/>o, sed tute male, hiperonimo (genro, supernocio).
      <aut>Sergio Pokrovskij</aut>
    </rim>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_d;&c_p;&c_a;&c_n;&c_ja;&c_c;&c_mol;&c_c;&c_je;</trd>
  <trd lng="de">Hyponym</trd>
  <trd lng="en">hyponym</trd>
  <trd lng="fr">hyponyme</trd>
  <trd lng="ja">&#x4E0B;&#x4F4D;&#x8A9E;  <pr>&#x304B;&#12356;&#12372;</pr></trd>
  <trd lng="pl">hiponim</trd>
  <trdgrp lng="ru">
    <trd>&c_p;&c_o;&c_d;&c_p;&c_o;&c_n;&c_ja;&c_t;&c_i;&c_je;</trd>,
    <trd>&c_g;&c_i;&c_p;&c_je;&c_r;&c_o;&c_n;&c_i;&c_m;</trd>
  </trdgrp>
  <trd lng="zh">&#x4E0B;&#x4E49;&#x8BCD; <pr>xi&#xE0;y&#xEC;c&#xED;</pr></trd>
</drv>
  </art>

