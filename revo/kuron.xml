<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kuron.xml,v 1.3 2026/08/26 17:00:03 revo Exp $">
    <kap>
      <rad>kuron</rad>/o
    </kap>

<drv mrk="kuron.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">HIS</uzo><uzo tip="fak">LIN</uzo>
    <dif>
      Ano de <ref tip="super" cel="balt.0o">balta</ref> popolo,
      iam lo&gcirc;inta &ccirc;e la <ref tip="prt" cel="mar.BaltaM0o">Balta Maro</ref>
      en la okcidento de hodia&ubreve;a <ref tip="prt" cel="latv.L0ujo">Latvujo</ref> kaj
      <ref tip="prt" cel="litov.L0ujo">Litovujo</ref>:
      <ekz>
        inter la 7-a kaj 12-a jarcentoj la <tld/>oj batalis kontra&ubreve; la ripete atakantaj
        vikingoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=131780"
              >Kuronoj</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        latgaloj, zemgaloj, selonoj kaj <tld/>oj estis la pralo&gcirc;antoj de la nuna Latvio
        <fnt>
          <vrk><url ref="http://dhjtyl.blogspot.com/2018/12/latvoj.html"
              >Latvoj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_k;&c_u;&c_r;&c_sh;</trd>
    <trd lng="de">Kure</trd>
    <trd lng="pl">Kuron</trd>
  </snc>
</drv>

<drv mrk="kuron.0a">
  <kap>
    <tld/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>oj, ilia lingvo, kulturo kaj lo&gcirc;ata regiono:
      <ekz>
        kvankam baze balta lingvo, la malnova <tld/>a lingvo anka&ubreve; estis proksime rilata
        al la finn-urgraj <klr>[&#8230;]</klr> lingvoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=246926"
              >Kurona lingvo</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        la lo&gcirc;antoj de la <ind><tld lit="K"/>a duoninsulo</ind> &ccirc;iam baraktis kontra&ubreve; movi&gcirc;anta
        sablo kaj stre&ccirc;oj de kaj la Balta maro kaj la <tld lit="K"/>a laguno
        <fnt>
          <aut>Linus Ganman</aut>
          <vrk><url ref="http://www.linusganman.se/y2w.htm"
              >Litovio</url></vrk>
        </fnt>.
        <trd lng="de">Kurische Nehrung</trd>
        <trd lng="pl">Mierzeja Kuro&nacute;ska</trd>
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_u;&c_r;&c_s;&c_k;&c_ib; <klr>(&c_k;&c_u;&c_r;&c_sh;&c_a;&c_w;)</klr></trd>
  <trd lng="de">kurisch</trd>
  <trd lng="pl">kuro&nacute;ski</trd>
</drv>
</art>

