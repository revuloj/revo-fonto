<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kned.xml,v 1.26 2026/08/19 14:51:54 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>kned</rad>/i
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="kned.0i">
  <kap><ofc>*</ofc><tld/>i</kap>
  <uzo tip="fak">KUI</uzo>
  <gra><vspec>tr</vspec></gra>
  <snc>
    <dif>
      Premante kaj kirlante miksi per la manoj farunon kaj akvon por
      fari <ref cel="past.0o">pasto</ref>n:
      <ekz>
        &scirc;i prenis paston, <tld/>is &gcirc;in, preparis anta&ubreve; liaj okuloj, kaj bakis la kuketojn
        <fnt>
          <bib>MT</bib>
          <lok>II. Samuel 13:8</lok>
        </fnt>;
      </ekz>
      <ekz>
        la maljuna <nom>Hanna</nom> malbone <tld/>is la paston, la servantinoj per siaj rulpremiloj
        rulpremis la paston tro maldike, duono de la macoj karbi&gcirc;is en la forno
        <fnt>
          <bib>RBa</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        la homoj estas <tld/>itaj el unu pasto <klr>[&#8230;]</klr> &ccirc;iu estas kapabla fari
        malsa&gcirc;a&jcirc;on
        <fnt>
          <bib>Tor</bib>
          <lok>II.</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_m;&c_ja;&c_s;&c_ib;&c_c;&c_mol; <klr tip="amb">(&c_c;&c_je;&c_s;&c_t;&c_a;)</klr></trd>,
      <trd>&c_r;&c_a;&c_sh;&c_ch;&c_y;&c_n;&c_ja;&c_c;&c_mol;</trd>
    </trdgrp>
    <trd lng="de">kneten</trd>
    <trdgrp lng="en">
      <trd>mix</trd>,
      <trd>knead</trd>
    </trdgrp>
    <trd lng="es">amasar</trd>
    <trdgrp lng="id">
      <trd><baz>adon</baz>mengadon</trd>,
      <trd><baz>adon</baz>mengadoni</trd>,
      <trd><baz>ulen</baz>menguleni</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_m;&c_je;&c_s;&c_i;&c_t;&c_mol; <klr>(&c_t;&c_je;&c_s;&c_t;&c_o;)</klr></trd>,
      <trd>&c_z;&c_a;&c_m;&c_je;&c_sh;&c_i;&c_v;&c_a;&c_t;&c_mol;</trd>
    </trdgrp>
  </snc>
  <snc>
    <dif>
      Premadi kaj prilabori per la manoj pastecan substancon por
      doni al &gcirc;i ian formon:
      <ekz>
        <tld/>u argilon, faru fortajn brikojn
        <fnt>
          <bib>MT</bib>
          <lok>Na&hcirc;um 3:14</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[ili]</klr> knedas potojn a&ubreve; drinkas
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        kia princo! tiel bela, <klr>[&#8230;]</klr> <tld/>ita el mildo kaj pla&ccirc;o
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro XI</lok>
        </fnt>;
      </ekz>
      <ekz>
        promenantoj <tld/>is kotan fluida&jcirc;on sur la trotuaroj
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        &Ccirc;i tiu fraz' surprizis &#11005; Kaj ili &gcirc;in skrupule &#11005; &Gcirc;is fundo analizis &#11005; &Gcirc;i &dash; sub
        ilia <tld/>o &dash; &#11005; Fandi&gcirc;is kiel vakso
        <fnt>
          <bib>LSB</bib>
          <lok>Epigramo</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_l;&c_ja;&c_p;&c_ib;&c_c;&c_mol;</trd>
    <trd lng="de">formen</trd>
    <trdgrp lng="en">
      <trd>form</trd>,
      <trd>give form to</trd>
    </trdgrp>
    <trd lng="es">moldear</trd>
    <trd lng="id"><baz>bentuk</baz>membentuk (tanah liat dsb.)</trd>
    <trd lng="ru">&c_l;&c_je;&c_p;&c_i;&c_t;&c_mol;</trd>
  </snc>
  <trd lng="br">merat</trd>
  <trdgrp lng="cs">
    <trd>hn&iacute;st</trd>,
    <trd>hn&ecaron;ten&iacute;m tvo&rcaron;it</trd>,
    <trd>m&iacute;sit</trd>
  </trdgrp>
  <trd lng="de">kneten</trd>
  <trdgrp lng="fr">
    <trd>p&eacute;trir</trd>,
    <trd>brasser<klr tip="ind"> (malaxer)</klr></trd>,
    <trd>fa&ccedil;onner</trd>,
    <trd>former<klr tip="ind"> (donner une forme avec les
    mains)</klr></trd>,
    <trd>malaxer</trd>,
    <trd>masser<klr tip="ind"> (p&eacute;trir)</klr></trd>,
    <trd>modeler<klr tip="ind"> (fa&ccedil;onner avec les mains)</klr></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#12371;&#x306D;&#x308B;</trd>,
    <trd>&#x7DF4;&#x308B;  <pr>&#x306D;&#x308B;</pr></trd>,
    <trd>&#12418;&#12416;</trd>,
    <trd>&#x935B;&#12360;&#x308B;  <pr>&#x304D;&#x305F;&#12360;&#x308B;</pr></trd>
  </trdgrp>
  <trd lng="nl">kneden</trd>
  <trdgrp lng="pl">
    <trd>gnie&sacute;&cacute; ciasto</trd>,
    <trd>miesi&cacute;</trd>,
    <trd>ugniata&cacute;</trd>
  </trdgrp>
  <trd lng="ro">fr&abreve;m&acirc;nta aluatul</trd>
  <trdgrp lng="sk">
    <trd>hnies&tcaron;</trd>,
    <trd>miesi&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_m;&c_ib;&c_s;&c_i;&c_t;&c_i;</trd>,
    <trd>&c_v;&c_i;&c_m;&c_i;&c_n;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x63C9;&#21046; <pr>r&oacute;uzh&igrave;</pr></trd>,
    <trd>&#x640B; <pr>chu&amacron;i</pr></trd>,
    <trd>&#25619;&#x63C9; <pr>cu&omacron;r&oacute;u</pr></trd>,
    <trd>&#x548C;&#38754; <pr>hu&oacute;mi&agrave;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="kned.0ebla">
  <kap>
    <tld/>ebla
  </kap>
  <snc>
    <dif>
      Tiel <ref tip="super" cel="mol.0a.cedema">mola</ref>, ke oni povas <tld/>i &gcirc;in:
      <ekz>
        argilo estas <tld/>ebla mina&jcirc;o, <klr>[&#8230;]</klr> rezultanta de la malkombini&gcirc;o de
        rokoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=119"
              >Argilo</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        &gcirc;enerale, modlopasto estas <tld/>ebla sen akvo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=108781"
              >Modlopasto</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        la cerbo de la infanoj estas <ind>facile <tld/>ebla</ind>
        <klr>(edukebla)</klr>.
        <trd lng="es">maleable</trd>
        <trd lng="fr">mall&eacute;able</trd>
      </ekz>
    </dif>
  </snc>
  <trd lng="de">knetbar</trd>
  <trdgrp lng="en">
    <trd>kneadable</trd>,
    <trd>plastic</trd>,
    <trd>figuline</trd>
  </trdgrp>
  <trd lng="fr">p&eacute;trissable</trd>
<trdgrp lng="id">
  <trd>dapat diadon</trd>,
  <trd>dapat diuleni</trd>
</trdgrp>
</drv>

<drv mrk="kned.0ujo">
  <kap><tld/>ujo</kap>
  <snc mrk="kned.0ujo.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      Ujo, en kiu la bakisto <tld/>as la paston:
      <ekz>
        Johana rapidema kiel birdo levas la kovrilon de la knedujo <klr>[&#8230;]</klr>
        senpene deskrapas per sia tondilo resta&jcirc;ojn de panpasto, kaj donacas al Jo&ccirc;jo.
        <fnt>
          <aut>Fr&eacute;d&eacute;ric Mistral</aut>
          <vrk><url
          ref="https://tempa.bitarkivo.org/gazetoj/NiaGazeto/nia-gazeto-monata_1934_n10_nov.pdf"
              >Knedujaj skrapa&jcirc;oj</url></vrk>
          <lok>Nia gazeto, n-ro 10, Nov. 1934, p. 3</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_d;&c_z;&c_ja;&c_zh;&c_a;</trd>,
    <trd>&c_d;&c_z;&c_je;&c_zh;&c_k;&c_a; <klr>(&c_d;&c_l;&c_ja; &c_c;&c_je;&c_s;&c_t;&c_a;)</klr></trd>
  </trdgrp>
  <trdgrp lng="br">
    <trd>laouer-doaz</trd>,
    <trd>nev-doaz</trd>,
    <trd>toazeg</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>d&iacute;&zcaron;</trd>,
    <trd>d&iacute;&zcaron;e</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Knettrog</trd>,
    <trd>Backtrog</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>kneading bowl</trd>,
    <trd>kneading trough</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>masera</trd>,
    <trd>amasadera</trd>
  </trdgrp>
  <trd lng="fr">p&eacute;trin<klr tip="ind"> (de boulanger)</klr></trd>
  <trd lng="id">bak pengaduk adonan</trd>
  <trd lng="ja">&#12371;&#x306D;&#26742;  <pr>&#12371;&#x306D;&#x304A;&#12369;</pr></trd>
  <trd lng="nl">baktrog</trd>
  <trd lng="pl">dzie&zdot;a</trd>
  <trdgrp lng="ro">
    <trd>covat&abreve;</trd>,
    <trd>bucluc</trd>
  </trdgrp>
  <trd lng="ru">&c_k;&c_v;&c_a;&c_sh;&c_n;&c_ja;</trd>
  <trd lng="sk">die&zcaron;a</trd>
  <trdgrp lng="uk">
    <trd>&c_d;&c_ib;&c_zh;&c_a;</trd>,
    <trd>&c_n;&c_o;&c_ch;&c_v;&c_i;</trd>
  </trdgrp>
</drv>

<drv mrk="kned.rul0ilo">
  <kap>
    rul<tld/>ilo
  </kap>
  <snc mrk="kned.rul0ilo.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      <ref tip="dif" cel="prem.rul0ilo.KUI">Rulpremilo</ref>:
      <ekz>
        pastorulo, rul<tld/>ilo, pastplatigilo estas cilindroforma kuirilo uzata
        por formi kaj platigi paston,
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=548005"
              >Pastorulo</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Teigrolle</trd>
<trd lng="id"><baz>gilas</baz>penggilas adonan</trd>
</drv>

</art>
