<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: tank.xml,v 1.22 2026/09/15 21:17:45 revo Exp $">
<kap>
   <ofc>9</ofc><rad>tank</rad>/o <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="tank.0o">
  <kap><ofc>9</ofc><tld/>o</kap>
  <uzo tip="fak">MIL</uzo>
  <snc mrk="tank.0o.MIL">
     <dif>
       Kirasita <ref cel="rauxp.0veturilo">ra&ubreve;pveturilo</ref>:
       <ekz>
         la unuaj <tld/>oj aperis dum la mondmilito en la jaro 1916;
       </ekz>
       <ekz>
        oni bezonas pli da milit&scirc;ipoj, pli da kanonoj, pli da pafiloj, pli da <tld/>oj
        kaj flugma&scirc;inoj <klr>[&#x2026;]</klr> do nia pano donos morton al kamaradoj en aliaj landoj
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Dua Parto</lok>
        </fnt>!
      </ekz>
      <ekz>
        por certigi la e&ubreve;ropan ekvilibron kaj pacon, ur&gcirc;e estis senditaj en Egiption
        kelkaj divizioj, ekipitaj per aeroplanoj, <tld/>oj, flam&jcirc;etiloj
        <fnt>
          <bib>VaK</bib>
          <lok>Unua &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        pafado kaj <tld/>oj interesas, parolado kaj traktadoj, ne
        <fnt>
          <bib>Monato</bib>
          <aut>Paul Gubbins</aut>
          <vrk><url ref="&Monato;/2003/008119.html"
              >Taglibro de l' milito ... el la lando de &Scirc;ekspiro</url></vrk>
          <lok>2003</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_t;&c_a;&c_n;&c_k;</trd>
  <trd lng="bg">&c_t;&c_a;&c_n;&c_k;</trd>
  <trd lng="ca">tanc</trd>
  <trd lng="de">Panzer</trd>
  <trd lng="en">tank</trd>
  <trd lng="es">tanque</trd>
  <trd lng="fa">&a_t;&a_A;&a_n;&f_k;</trd>
  <trdgrp lng="fr"><trd>char d'assaut</trd><trd>tank</trd></trdgrp>
  <trdgrp lng="hu">
    <trd>harckocsi</trd>,
    <trd>tank</trd>
  </trdgrp>
  <trd lng="it">carro armato</trd>
  <trdgrp lng="ja">
    <trd>&#x6226;&#x8ECA;  <pr>&#x305B;&#x3093;&#x3057;&#x3083;</pr></trd>,
    <trd>&#x30BF;&#x30F3;&#x30AF;  <pr>&#x305F;&#x3093;&#x304F;</pr></trd>
  </trdgrp>
  <trd lng="nl">tank</trd>
  <trdgrp lng="pl">
    <trd>czo&lstroke;g</trd>,
    <trd>tank<klr> (rzadkie)</klr></trd>
  </trdgrp>
  <trd lng="pt">tanque</trd>
  <trd lng="ru">&c_t;&c_a;&c_n;&c_k;</trd>
  <trd lng="uk">&c_t;&c_a;&c_n;&c_k;</trd>
  <trd lng="zh">&#x5766;&#x514B; <pr>t&#x1CE;nk&egrave;</pr></trd>
</drv>
</art>
