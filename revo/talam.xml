        <bib>Monato</bib>
        <lok>2026/11, p. 20</lok>
        </fnt>;
      </ekz>
      <ekz>
      la hipotalamo estas regiono de la diencefalo, sub la <tld/>o
      <fnt>
        <aut>H. M. Schweizer</aut>
        <vrk>Cerb-esploro kaj gejeco</vrk>
        <bib>Monato</bib>
        <lok>1989/05, p. 4</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Thalamus</trd>
  <trd lng="en">thalamus</trd>
  <trd lng="fr">thalamus</trd>
  <trd lng="nl">thalamus</trd>
  <trd lng="ro">talamus</trd>
