<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: karol1.xml,v 1.32 2026/10/28 16:40:05 revo Exp $">
    <kap><rad>Karol</rad>/o <fnt><bib>PIV1</bib></fnt>,
    <var><kap><rad var="rl">Karl</rad>/o <fnt><bib>PIV2</bib></fnt></kap></var>
    </kap>

<drv mrk="karol1.0o">
  <kap><tld/>o, <var><kap><tld var="rl"/>o</kap></var></kap>
  <uzo tip="fak">NOM</uzo>
  <snc>
    <dif>
      Vira <ref tip="lst" cel="nom.antaux0o" lst="voko:personaj_nomoj">anta&ubreve;nomo</ref> &gcirc;ermandevena:
      <ekz>
        <tld/>o a&ccirc;etis por sia kuzino horlo&gcirc;eton kun tri montrantoj
        <fnt><bib>DL</bib></fnt>;
      </ekz>
      <ekz>
        <tld var="rl"/>o estis tre pensema knabeto kaj jam havis
        siajn precizajn ideojn pri multaj aferoj
        <fnt>
          <aut>E. Privat</aut>,
          <vrk>Karlo</vrk>,
          <lok>1926</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld var="rl"/>o la unua estis senkapigata
        <fnt>
          <bib>IdO</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        Petron kruro doloras, <tld/>o ne lamas
        <fnt><bib>Prv</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <ref tip="hom" cel="karol.0o">karolo (kanta&jcirc;o)</ref>
  <trdgrp lng="be">
    <trd>&c_K;&c_a;&c_r;&c_l;</trd>,
    <trd>&c_K;&c_a;&c_r;&c_a;&c_l;&c_mol;</trd>
  </trdgrp>
  <trd lng="br">Charlez</trd>
  <trd lng="ca">Carles</trd>
  <trd lng="cv">&c_K;&c_a;&c_r;&c_l;</trd>
  <trd lng="de">Karl</trd>
  <trdgrp lng="en">
    <trd>Charles</trd>, <trd>Carl</trd>,
    <trd>Carlo</trd>, <trd>Carlos</trd>
  </trdgrp>
  <trd lng="es">Carlos</trd>
  <trd lng="fr">Charles</trd>
  <trd lng="hu">K&aacute;roly</trd>
  <trdgrp lng="id">
    <trd>Karolus</trd>,
    <trd>Karlos</trd>
  </trdgrp>
  <trd lng="it">Carlo</trd>
  <trdgrp lng="ja">
    <trd>&#12459;&#12540;&#12523;</trd>,
    <trd>&#12471;&#12515;&#12523;&#12523;</trd>,
    <trd>&#12481;&#12515;&#12540;&#12523;&#12474;  <pr>&#12385;&#12419;&#12540;&#12427;&#12378;</pr></trd>
  </trdgrp>
  <trd lng="nl">Karel</trd>
  <trd lng="oc">Carles</trd>
  <trd lng="pl">Karol</trd>
  <trd lng="ro">Carol</trd>
  <trdgrp lng="ru">
    <trd>&c_K;&c_a;&c_r;&c_l;</trd>,
    <trd>&c_K;&c_a;&c_r;&c_o;&c_l;&c_mol;</trd>,
    <trd>&c_Sh;&c_a;&c_r;&c_l;&c_mol;</trd>,
    <trd>&c_Ch;&c_a;&c_r;&c_l;&c_mol;&c_z;</trd>
  </trdgrp>
  <trd lng="uk">&c_K;&c_a;&c_r;&c_l;</trd>
  <trdgrp lng="zh">
    <trd>&#26597;&#23572;&#26031; <pr>Ch&aacute;&ecaron;rs&imacron;</pr></trd>,
    <trd>&#21345;&#27931;&#26031; <pr>K&#462;lu&ograve;s&imacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="karol1.0ino">
  <kap><tld/>ino</kap>
  <uzo tip="fak">NOM</uzo>
  <snc>
    <dif>
      Ina <ref tip="lst" cel="nom.antaux0o" lst="voko:personaj_nomoj">anta&ubreve;nomo</ref> &gcirc;ermandevena:
      <ekz>
        <tld/>ino levis la &scirc;ultrojn
        <fnt><bib>Marta</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_K;&c_a;&c_r;&c_l;&c_a;</trd>,
