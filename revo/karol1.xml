</drv>

<drv mrk="karol1.0ido">
  <kap><tld lit="k"/>ido</kap>
  <uzo tip="fak">HIS</uzo>
  <snc>
    <dif>
      Ano de franka dinastio, kiu regis precipe la teritoriojn de
      nunaj Francujo kaj Germanujo de la jaro 751a &gcirc;is en la 10a
      jarcento:
      <ekz>
        post la merovidoj venis la <tld lit="k"/>idoj kun Pipino la pli
        juna, kiu firmigis sian legitimecon per sia kronado
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=391265">Re&gcirc;lando
          Francio</url></lok>
        </fnt>;
      </ekz><ekz>
        &ccirc;e la okcidentaj <tld lit="k"/>idoj la fe&ubreve;da disfalo estis
        rapida, kaj <tld/>o
        la 2-a rapide perdis a&ubreve;toritatecon sude de la rivero Luaro
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=391265">Re&gcirc;lando
          Francio</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_a;&c_l;&c_ib;&c_n;&c_g;</trd>
  <trd lng="br">Karlingad</trd>
  <trd lng="ca">carolingi<klr> (subst.)</klr></trd>
  <trd lng="cv">&c_k;&c_a;&c_r;&c_o;&c_l;&c_i;&c_n;&c_g;</trd>
  <trd lng="de">Karolinger</trd>
  <trdgrp lng="en">
    <trd>Carolingian</trd>,
    <trd>Carolingian Frank</trd>
  </trdgrp>
  <trd lng="fr">Carolingien<klr tip="ind"> (subst.)</klr></trd>
  <trd lng="hu">Karoling</trd>
  <trdgrp lng="id">
    <trd>Wangsa Karoling</trd>,
    <trd>Wangsa Karling</trd>
  </trdgrp>
  <trd lng="it">carolingio<klr> (sost.)</klr></trd>
  <trd lng="nl">Karolinger</trd>
  <trd lng="pl">Karoling</trd>
  <trd lng="ro">Carolingian&abreve; Dinastia  {pl}</trd>
  <trd lng="ru">&c_K;&c_a;&c_r;&c_o;&c_l;&c_i;&c_n;&c_g;(&c_i;)</trd>
  <trd lng="zh">&#21345;&#27931;&#26519;&#29579;&#26397; <pr>k&#462;lu&ograve;l&iacute;nw&aacute;ngch&aacute;o</pr></trd>
</drv>

<drv mrk="karol1.0ida">
  <kap><tld lit="k"/>ida</kap>
  <snc>
    <dif>
      Rilata al <tld lit="k"/>idoj, al ilia regado, al la tiuepoka
      kulturo:
      <ekz>
        post la <tld/>ida Imperio kaj la traktato de <nom>Verdun</nom> de 843
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=79117">Ne&ubreve;strio</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <subsnc mrk="karol1.0ida.TIP">
      <uzo tip="fak">TIP</uzo>
      <dif>
        Stilo de latinaj literoj uzata por libroj dum la <tld/>ida
        regado,
        precipa bazo de renesancaj kaj modernaj tiparaj minuskloj:
        <ekz>
          klasika fasono ne estas Romia: <klr>[...]</klr> la
          etliteroj
          sekvas la <tld/>idan minusklan skribon
          <fnt><bib>KompLeks</bib>,
            <lok>artikolo &leftquot;klasika fasono&rightquot;</lok></fnt>.
        </ekz>
      </dif>
      <trdgrp lng="en">
        <trd>Carolingian</trd>,
        <trd>Caroline <klr>(minuscule)</klr></trd>
      </trdgrp>
      <trd lng="fr">caroline<klr tip="ind"> (adj.,
      tipo.)</klr></trd>
    </subsnc>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_a;&c_r;&c_a;&c_l;&c_ib;&c_n;&c_s;&c_k;&c_ib;</trd>,
    <trd>&c_k;&c_a;&c_r;&c_a;&c_l;&c_ib;&c_n;&c_g;&c_a;&c_w;</trd>
  </trdgrp>
  <trd lng="br">karlingat</trd>
  <trdgrp lng="ca">
    <trd>carolingi</trd>,
    <trd>carol&iacute;<klr> (adj.)</klr></trd>
  </trdgrp>
  <trd lng="de">karolingisch</trd>
  <trd lng="en">Carolingian</trd>
  <trd lng="fr">carolingien<klr tip="ind"> (adj.)</klr></trd>
  <trd lng="hu">karoling</trd>
  <trdgrp lng="id">
    <trd>Karoling</trd>,
    <trd>Karling</trd>
  </trdgrp>
  <trd lng="it">carolingio<klr> (agg.)</klr></trd>
  <trd lng="nl">Karolingisch</trd>
  <trd lng="pl">karolinga</trd>
  <trd lng="ro">carolingian&abreve;</trd>
  <trd lng="ru">&c_k;&c_a;&c_r;&c_o;&c_l;&c_i;&c_n;&c_g;&c_s;&c_k;&c_i;&c_j;</trd>
</drv>

<drv mrk="karol1.0o_la_Granda">
  <kap><tld/>o la Granda</kap>
  <uzo tip="fak">HIS</uzo>
  <uzo tip="fak">PERS</uzo>
  <snc mrk="karol1.0o_la_Granda.HIS">
    <dif>
      <tld/>o la 1a, re&gcirc;o de Frankoj (747&ndash;814), etendinta
      sian regnon super proksimume nunajn Germanujon, Francujon,
      Nordan Italujon, fari&gcirc;inta <ctl>okcidenta imperiestro</ctl>
      en 800, instiginto de kulturaj reformoj la&ubreve; romia modelo:
      <ekz>
        tra la kanala tunelo oni veturas al Francujo, al la lando de
        <tld/>o la Granda
        <fnt>
          <bib>Fab3</bib>
          <lok>Post jarmiloj</lok>
        </fnt>;
      </ekz><ekz>
        jam <klr>[&#8230;]</klr> en la tempo de la imperiestro <tld/>o
        la Granda
        <fnt><bib>DonKihxoto</bib>,
          <lok>dua parto, &ccirc;apitro 24a, p. 530a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_K;&c_a;&c_r;&c_l; &c_V;&c_ja;&c_l;&c_ib;&c_k;&c_ib;</trd>
  <trd lng="br">Karl-Veur</trd>
  <trd lng="ca">Carlemany</trd>
  <trd lng="cs">Karel Velik&yacute;</trd>
  <trd lng="cv">&c_A;&c_s;&c_l;&#1233; <ind>&c_K;&c_a;&c_r;&c_l;</ind></trd>
  <trd lng="de">Karl der Gro&szlig;e</trd>
  <trdgrp lng="en">
    <trd>Charlemagne</trd>,
    <trd>Charles the Great</trd>
  </trdgrp>
  <trd lng="es">Carlomagno</trd>
  <trd lng="fr">Charlemagne</trd>
  <trd lng="hu">Nagy K&aacute;roly</trd>
  <trd lng="id">Karolus Agung</trd>
  <trdgrp lng="it">
    <trd>Carlomagno</trd>,
    <trd><ind>Carlo</ind> Magno</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#12459;&#12540;&#12523;&#22823;&#24093;  <pr>&#12459;&#12540;&#12523;&#12383;&#12356;&#12390;&#12356;</pr></trd>,
    <trd>&#12471;&#12515;&#12523;&#12523;&#12510;&#12540;&#12491;&#12517;</trd>
  </trdgrp>
  <trd lng="lat">Carolus Magnus</trd>
  <trd lng="nl">Karel de Grote</trd>
  <trd lng="oc">Carlesmanhe</trd>
  <trd lng="pl">Karol Wielki</trd>
  <trd lng="ro">Carol cel Mare</trd>
  <trd lng="ru">&c_K;&c_a;&c_r;&c_l; &c_V;&c_je;&c_l;&c_i;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">Karol Ve&lcaron;k&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#26597;&#29702;&#26364;&#22823;&#24093; <pr>ch&aacute;l&#464;m&agrave;nd&agrave;d&igrave;</pr></trd>,
    <trd>&#26597;&#21033;&#26364; <pr>ch&aacute;l&igrave;m&agrave;n</pr></trd>,
    <trd>&#26597;&#29702;&#22823;&#24093; <pr>Ch&aacute;l&#464;D&agrave;d&igrave;</pr></trd>
  </trdgrp>
</drv>
    <adm>
      La terminoj "franka", &leftquot;Franko&rightquot; estas uzataj en difinoj,
      sed ili ne aperas en la vortaro.
      <aut>MB</aut>
    </adm>
  </art>
