<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: hanibal.xml,v 1.10 2026/10/27 12:00:19 revo Exp $">
<kap>
    <rad>Hanibal</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="hanibal.0o">
  <kap><tld/>o</kap>
  <snc mrk="hanibal.0o.militestro">
    <uzo tip="fak">HIS</uzo>
    <dif>
      Fama <ref tip="lst" cel="milit.0estro" lst="voko:historiaj_personoj">militestro</ref> de la
      antikvo,
      naski&gcirc;inta en Kartago kaj venkanta plurfoje kontra&ubreve; la
      Romio dum la Dua Punika Milito:
      <ekz>
        post la fino de la milito, <tld/>o estris Kartagon dum multaj
        jaroj,
        helpante &gcirc;ian rekonstruadon post la ruinigado de milito, &gcirc;is la
        Romianoj devigas lin ekzili en 195 a.K.
        <fnt><bib>Viki</bib>, <lok>Hanibalo</lok></fnt>
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_G;&c_a;&c_n;&c_ib;&c_b;&c_a;&c_l;</trd>
  <trdgrp lng="ca">
    <trd>Ann&iacute;bal</trd>,
    <trd>Hann&iacute;bal</trd>
  </trdgrp>
  <trd lng="cs">Hanibal</trd>
  <trd lng="cv">&c_G;&c_a;&c_n;&c_n;&c_i;&c_b;&c_a;&c_l;</trd>
  <trd lng="de">Hannibal</trd>
  <trd lng="es">An&iacute;bal</trd>
  <trd lng="fr">Hannibal</trd>
  <trd lng="ja">&#12495;&#12531;&#12491;&#12496;&#12523;</trd>
  <trd lng="oc">Anibal</trd>
  <trd lng="pl">Hannibal</trd>
  <trd lng="sk">Hanibal</trd>
  <trd lng="uk">&c_G;&c_a;&c_n;&c_n;&c_ib;&c_b;&c_a;&c_l;</trd>
  <trd lng="zh">&#27721;&#23612;&#25300; <pr>h&agrave;nn&iacute;b&aacute;</pr></trd>
</drv>
</art>

