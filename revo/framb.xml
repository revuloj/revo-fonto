<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: framb.xml,v 1.39 2026/08/14 13:59:47 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>framb</rad>/o
<fnt><bib>UV</bib></fnt></kap>

<drv mrk="framb.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="framb.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      Ru&gcirc;a, bongusta man&gcirc;ebla frukto de <tld/>ujo:
      <ekz>
        ili sin turnadis en la arbaro, kolektante fragojn kaj <tld/>ojn
        <fnt>
          <bib>Fab2</bib>
          <lok>Abio</lok>
        </fnt>;
      </ekz>
      <ekz>
        la avino metis sur la sofon kvar tasojn kun <ind><tld/>osuko</ind>
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>;
        <trd lng="de">Himbeersaft</trd>
      </ekz>
      <ekz>
        <ind><tld/>kolora</ind> makulo, lar&gcirc;a kiel lento
        <fnt>
          <bib>KPr</bib>
          <lok>&Ccirc;apitro Deka</lok>
        </fnt>;
        <trd lng="de">himbeerfarben</trd>
      </ekz>
      <ekz>
        la scenejo ekflamis en <tld/>okoloraj fajroj kaj anta&ubreve; ni aperis fantazia
        spektaklo
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a asperula siropo
        <fnt>
          <bib>Monato</bib>
          <aut>Marc Vanden Bempt</aut>
          <vrk><url ref="&Monato;/2008/009232.php"
              >Simpatia vulgariga fakliteraturo</url></vrk>
          <lok>2008</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="super" cel="frukt.plur0o">plurfrukto</ref>
    <bld lok="../bld/framb2.jpg">
      <tld/>o
    </bld>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_l;&c_ib;&c_n;&c_a; <klr>(&c_ja;&c_g;&c_a;&c_d;&c_a;)</klr></trd>
  <trd lng="bg">&c_m;&c_a;&c_l;&c_i;&c_n;&c_a;</trd>
  <trdgrp lng="cs">
    <trd>malina</trd>,
    <trd>malina <klr>(plod)</klr></trd>
  </trdgrp>
  <trd lng="de">Himbeere</trd>
  <trd lng="en">raspberry</trd>
  <trd lng="es">frambuesa</trd>
  <trd lng="fr">framboise</trd>
  <trd lng="hu">m&aacute;lna</trd>
  <trdgrp lng="id">
    <trd>rasberi</trd>,
    <trd>frambos</trd>,
    <trd>lembutung</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30E9;&#x30BA;&#x30D9;&#x30EA;&#x30FC;</trd>,
    <trd>&#x30D5;&#x30E9;&#x30F3;&#x30DC;&#x30EF;&#x30FC;&#x30BA;</trd>,
    <trd>&#x30AD;&#x30A4;&#x30C1;&#x30B4;</trd>
  </trdgrp>
  <trd lng="nl">framboos</trd>
  <trd lng="no">bringeb&aelig;r</trd>
  <trd lng="pl">malina</trd>
  <trd lng="pt">framboesa</trd>
  <trd lng="ro">zmeur&abreve;</trd>
  <trd lng="ru">&c_m;&c_a;&c_l;&c_i;&c_n;&c_a; <klr>(&c_ja;&c_g;&c_o;&c_d;&c_a;)</klr></trd>
  <trd lng="sk">malina <klr>(plod)</klr></trd>
  <trd lng="uk">&c_m;&c_a;&c_l;&c_i;&c_n;&c_a; (&c_ja;&c_g;&c_o;&c_d;&c_a;)</trd>
  <trdgrp lng="zh">
    <trd>&#x8986;&#x76C6;&#x5B50; <pr>f&ugrave;p&eacute;nz&#x1D0;</pr></trd>,
    <trd>&#x6811;&#x8393; <pr>sh&ugrave;m&eacute;i</pr></trd>,
    <trd>&#x6728;&#x8393; <pr>m&ugrave;m&eacute;i</pr></trd>,
    <trd>&#x9911;&#x9911;&#x982D; <pr>b&omacron;bot&oacute;u</pr></trd>
  </trdgrp>
</drv>

<drv mrk="framb.0ujo">
  <kap><tld/>ujo</kap>
  <snc mrk="framb.0ujo.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      <ref tip="lst" cel="speci.0o.BIO" lst="voko:botanikaj_specioj">Specio</ref> de <ref
      tip="super" cel="rubus.0o.genro">rubuso</ref>
      kun ru&gcirc;aj plurfruktoj (<trd lng="la">Rubus idaeus</trd>):
      <ekz>
        ili ma&ccirc;is laktukojn, grimpadis sur ribujoj kaj <tld/>ujoj
        <fnt>
          <bib>Monato</bib>
          <aut>Geraldo Mattos</aut>
        </fnt>;
      </ekz>
      <ekz>
        inter verdaj <tld/>ujoj staris alta svelta fra&ubreve;lino
        <fnt>
          <aut>Ivan Turgenev, trad. I. Novikova k.a.</aut>,
          <vrk><url ref="&LOdE;Rn-turg1.htm">La unua
          amo</url></vrk>,
          <lok>Jekaterinburg: Sezonoj, 1993</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <bld lok="../bld/framb.jpg">
    floroj
  </bld>
  <trdgrp lng="be">
    <trd>&c_m;&c_a;&c_l;&c_ib;&c_n;&c_a; <klr>(&c_r;&c_a;&c_s;&c_mol;&c_l;&c_ib;&c_n;&c_a;)</klr></trd>,
    <trd>&c_m;&c_a;&c_l;&c_ib;&c_n;&c_mol;&c_n;&c_ib;&c_k;</trd>,
    <trd>&c_m;&c_a;&c_l;&c_ib;&c_n;&c_a;&c_v;&c_y; &c_k;&c_u;&c_s;&c_t;</trd>
  </trdgrp>
  <trd lng="bg">&c_m;&c_a;&c_l;&c_i;&c_n;&c_a;</trd>
  <trdgrp lng="cs">
    <trd>malin&iacute;k obecn&yacute;</trd>,
    <trd>ostru&zcaron;in&iacute;k malinov&yacute;</trd>
  </trdgrp>
  <trd lng="de">Himbeerstrauch</trd>
  <trd lng="en">raspberry bush</trd>
  <trd lng="fr">framboisier</trd>
  <trd lng="hu">m&aacute;lnabokor</trd>
  <trdgrp lng="id">
    <trd>pohon rasberi</trd>,
    <trd>pohon frambos</trd>,
    <trd>pohon lembutung</trd>,
    <trd>tumbuhan rasberi</trd>,
    <trd>tumbuhan frambos</trd>,
    <trd>tumbuhan lembutung</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30E9;&#x30BA;&#x30D9;&#x30EA;&#x30FC;</trd>,
    <trd>&#x30E8;&#x30FC;&#x30ED;&#x30C3;&#x30D1;&#x30AD;&#x30A4;&#x30C1;&#x30B4;</trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>framboos</trd>,
    <trd>frambozenstruik</trd>
  </trdgrp>
  <trdgrp lng="no">
    <trd>bringeb&aelig;r</trd>,
    <trd>bringeb&aelig;rbusk</trd>
  </trdgrp>
  <trd lng="pl">malina</trd>
  <trd lng="pt">framboeseira</trd>
  <trdgrp lng="ru">
    <trd>&c_m;&c_a;&c_l;&c_i;&c_n;&c_a; <klr>(&c_r;&c_a;&c_s;&c_t;&c_je;&c_n;&c_i;&c_je;)</klr></trd>,
    <trd>&c_m;&c_a;&c_l;&c_i;&c_n;&c_o;&c_v;&c_y;&c_j; &c_k;&c_u;&c_s;&c_t;</trd>
  </trdgrp>
  <trd lng="sk">ostru&zcaron;ina malinov&aacute;</trd>
  <trd lng="uk">&c_m;&c_a;&c_l;&c_i;&c_n;&c_a; (&c_k;&c_u;&c_shch;)</trd>
  <trd lng="zh">&#x8986;&#x76C6;&#x5B57; <pr>f&ugrave;p&eacute;nz&igrave;</pr></trd>
</drv>
</art>
