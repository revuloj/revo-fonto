<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: furioz.xml,v 1.33 2026/08/12 03:08:02 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>furioz</rad>/a <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="furioz.0a">
  <kap><ofc>*</ofc><tld/>a</kap>
  <snc mrk="furioz.0a.PSI">
    <dif>
      Pasie, freneze, senbride <ref tip="super" cel="koler.0a">kolera</ref>:
      <ekz>
        longa kaj <tld/>a estis la batalo, fine la giganto venkis
        <fnt>
          <bib>ElektFab</bib>
          <lok>La senditoj de morto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la princo saltis en sian &scirc;ipeton kaj <tld/>a, ordonis al la remisto persekuti la
        malhumilan oficiston
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro XII</lok>
        </fnt>;
      </ekz>
      <ekz>
        la regnanoj salutis lin kun <tld/>a entuziasmo
        <fnt>
          <bib>Far3</bib>
          <lok>&Ccirc;apitro X</lok>
        </fnt>;
      </ekz>
      <ekz>
        se li vidis sakristianon, li fari&gcirc;is tute <tld/>a
        <fnt>
          <bib>Fab1</bib>
          <lok>Malgranda Niko kaj granda Niko</lok>
        </fnt>;
      </ekz>
      <ekz>
        liaj naztruoj vasti&gcirc;is kiel &ccirc;e <tld/>a bovo, la okuloj ekbrilis
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro X</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a &scirc;ipisto malmilde batis kaj &jcirc;etis lin sur la plankon
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[vi]</klr> ekstermis viajn profetojn, kiel <tld/>a leono
        <fnt>
          <bib>MT</bib>
          <lok>Jeremia 2:30</lok>
        </fnt>;
      </ekz>
      <ekz>
        Mi transdonos vin en la manojn de homoj <tld/>aj, lertaj ekstermistoj
        <fnt>
          <bib>MT</bib>
          <lok>Je&hcirc;ezkel 21:31</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="frenez.0a.pro_pasio">freneza<sncref/></ref>,
      <ref cel="rabi.0a">rabia</ref>,
      <ref cel="sovagx.0a.intensa">sova&gcirc;a<sncref/></ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_l;&c_ju;&c_t;&c_y;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_mol;&c_ju;&c_sh;&c_a;&c_n;&c_y;</trd>,
    <trd>&c_a;&c_p;&c_a;&c_n;&c_t;&c_a;&c_n;&c_y;</trd>,
    <trd>&c_sh;&c_a;&c_l;&c_jo;&c_n;&c_y;</trd>,
    <trd>&c_a;&c_sh;&c_a;&c_l;&c_je;&c_l;&c_y;</trd>,
    <trd>&c_b;&c_u;&c_ja;&c_n;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>furi&oacute;s</trd>,
    <trd>rabi&oacute;s</trd>,
    <trd>fora de si</trd>,
    <trd>desfermat</trd>,
    <trd>desbridat</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>l&iacute;t&yacute;</trd>,
    <trd>nep&rcaron;&iacute;&ccaron;etn&yacute;</trd>,
    <trd>rozkacen&yacute;</trd>,
    <trd>rozl&iacute;cen&yacute;</trd>,
    <trd>rozl&iacute;cen&yacute;</trd>,
    <trd>zb&ecaron;sil&yacute;</trd>,
    <trd>zu&rcaron;iv&yacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd><ofc>*</ofc>w&uuml;tend</trd>,
    <trd>rasend</trd>,
    <trd>tobend</trd>,
    <trd><ofc>*</ofc>toll <klr>(w&uuml;tend)</klr></trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd><ofc>*</ofc>furious</trd>,
    <trd><ofc>*</ofc>raging</trd>
  </trdgrp>
  <trd lng="es">furioso</trd>
  <trdgrp lng="fr">
    <trd>d&eacute;chain&eacute;<klr tip="ind"> (furieux)</klr></trd>,
    <trd>enrag&eacute;<klr tip="ind"> (furieux)</klr></trd>,
    <trd><ofc>*</ofc>furieux</trd>,
    <trd>en <ind>furie</ind></trd>,
  </trdgrp>
  <trd lng="hu">&odblac;rj&ouml;ng&odblac;</trd>
  <trdgrp lng="ja">
    <trd>&#x6012;&#x308A;&#x72C2;&#x3063;&#x305F;  <pr>&#x3044;&#x304B;&#x308A;&#x304F;&#x308B;&#x3063;&#x305F;</pr></trd>,
    <trd>&#x6FC0;&#x6012;&#x3057;&#x305F;  <pr>&#x3052;&#x304D;&#x3069;&#x3057;&#x305F;</pr></trd>,
    <trd>&#x8352;&#x308C;&#x72C2;&#x3046;  <pr>&#x3042;&#x308C;&#x304F;&#x308B;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="lat">rabidus, a, um (rabies)</trd>
  <trd lng="nl">razend</trd>
  <trdgrp lng="pl">
    <trd><ofc>*</ofc>w&sacute;ciek&lstroke;y <klr>(z gniewu)</klr></trd>,
    <trd>rozjuszony</trd>,
    <trd>zapami&eogonek;ta&lstroke;y</trd>,
    <trd>szalony</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>furioso</trd>,
    <trd>raivoso</trd>,
    <trd>fulo</trd>,
    <trd>irado</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_n;&c_je;&c_i;&c_s;&c_t;&c_o;&c_v;&c_y;&c_j;</trd>,
    <trd>&c_ja;&c_r;&c_o;&c_s;&c_t;&c_n;&c_y;&c_j;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_malmol;&c_ja;&c_r;&c_jo;&c_n;&c_n;&c_y;&c_j;</trd>,
    <trd><ofc>*</ofc>&c_b;&c_je;&c_sh;&c_je;&c_n;&c_y;&c_j;</trd>,
    <trd>&c_b;&c_u;&c_j;&c_n;&c_y;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>besn&yacute;</trd>,
    <trd>rozz&uacute;ren&yacute;</trd>,
    <trd>z&uacute;riv&yacute;</trd>
  </trdgrp>
  <trd lng="uk">&c_r;&c_o;&c_z;&c_l;&c_ju;&c_ch;&c_je;&c_n;&c_i;&c_j;</trd>
  <trd lng="zh">&#x7316;&#x7357; <pr>ch&amacron;ngju&eacute;</pr></trd>
</drv>

<drv mrk="furioz.0i">
  <kap><tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="furioz.0i.KOMUNE">
    <dif>
      Esti <tld/>a, agi <tld/>e:
      <ekz>
        <tld/>as la &jcirc;aluzo
        <fnt>
          <bib>MT</bib>
          <lok>Sentencoj 6:34</lok>
        </fnt>;
      </ekz>
      <ekz>
        li <tld/>as kiel apro
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        la ventego <tld/>is &ccirc;e &ccirc;iuj fenestroj
        <fnt>
          <bib>Fab1</bib>
          <lok>Malbonkonduta knabo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        la oceano jam komencis <tld/>i en sia sova&gcirc;a kaj blinda forto
        <fnt>
          <bib>Lasta</bib>
          <lok>La Lasta</lok>
        </fnt>;
      </ekz>
      <ekz>
        lia malhumileco kaj fiereco kaj <tld/>ado estas pli granda, ol lia forto
        <fnt>
          <bib>MT</bib>
          <lok>Jesaja 16:6</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="koler.0i">koleri</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_sh;&c_a;&c_l;&c_je;&c_c;&c_mol;</trd>
  <trdgrp lng="ca">
    <trd>estar <ind>furi&oacute;s</ind></trd>,
    <trd>estar <ind>enfurit</ind></trd>,
    <trd>estar <ind>fren&egrave;tic</ind></trd>,
    <trd>rugir<klr tip="amb"> (fig.)</klr></trd>,
    <trd>bramar<klr tip="amb"> (fig.)</klr></trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>vztekat se ,, l&aacute;te&rcaron;it</trd>,
    <trd>&rcaron;&aacute;dit</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>rasen <klr>(w&uuml;ten)</klr></trd>,
    <trd>w&uuml;ten</trd>,
    <trd>toben</trd>,
    <trd>ausflippen</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>be furious</trd>,
    <trd>rage</trd>
  </trdgrp>
  <trd lng="es">estar <ind>furioso</ind></trd>
  <trdgrp lng="fr">
    <trd>&ecirc;tre <ind>furieux</ind></trd>,
    <trd>&ecirc;tre <ind>d&eacute;chain&eacute;</ind></trd>,
    <trd>&ecirc;tre <ind>enrag&eacute;</ind></trd>,
    <trd>faire <ind>rage</ind></trd></trdgrp>
  <trd lng="hu">&odblac;rj&ouml;ng</trd>
  <trdgrp lng="ja">
    <trd>&#x6012;&#x308A;&#x72C2;&#x3046;  <pr>&#x3044;&#x304B;&#x308A;&#x304F;&#x308B;&#x3046;</pr></trd>,
    <trd>&#x8352;&#x308C;&#x72C2;&#x3046;  <pr>&#x3042;&#x308C;&#x304F;&#x308B;&#x3046;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>w&sacute;cieka&cacute; si&eogonek;</trd>,
    <trd>szale&cacute;</trd>,
    <trd>wpada&cacute; w <ind>sza&lstroke;</ind></trd>,
    <trd>wpada&cacute; we
    <ind>w&sacute;ciek&lstroke;o&sacute;&cacute;</ind></trd>,
    <trd>wpada&cacute; w <ind>furi&eogonek;</ind></trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_n;&c_je;&c_i;&c_s;&c_t;&c_o;&c_v;&c_s;&c_t;&c_v;&c_o;&c_v;&c_a;&c_t;&c_mol;</trd>,
    <trd>&c_b;&c_y;&c_t;&c_mol; &c_v; &c_ja;&c_r;&c_o;&c_s;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>vyv&aacute;dza&tcaron;</trd>,
    <trd>z&uacute;ri&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_l;&c_ju;&c_t;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_sh;&c_a;&c_l;&c_je;&c_n;&c_ib;&c_t;&c_i;</trd>,
    <trd>&c_s;&c_k;&c_a;&c_zh;&c_je;&c_n;&c_ib;&c_t;&c_i;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8086;&#x8650; <pr>s&igrave;n&uuml;&egrave;</pr></trd>,
    <trd>&#x6C14;&#x660F; <pr>q&igrave;h&umacron;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="furioz.0o">
  <kap><tld/>o, <var><kap><tld/>eco</kap></var></kap>
  <snc mrk="furioz.0o.PSI">
    <dif>
      Stato de iu <tld/>a:
      <ekz>
        la re&gcirc;o forte ekkoleris, kaj lia <tld/>o brulis en li
        <fnt>
          <bib>MT</bib>
          <lok>Ester 1:12</lok>
        </fnt>;
      </ekz>
      <ekz>
        pro <tld/>eco vi ja nenion a&ubreve;das
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Unua</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi incitos lin &gcirc;is <tld/>eco, ke li neniigu min en la <tld/>eco
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Kvina</lok>
        </fnt>;
      </ekz>
      <ekz>
        lo&gcirc;u &ccirc;e li kelkan tempon, &gcirc;is kvieti&gcirc;os la <tld/>o
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 27:44</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;irmilo kontra&ubreve; la <tld/>eco de la vento malestis
        <fnt>
          <bib>IdO</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="indign.0o">indigno</ref>,
      <ref cel="koler.0o">kolero</ref>,
      <ref cel="rabi.0o.furiozo">rabio<sncref/></ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_sh;&c_a;&c_l;&c_jo;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_sh;&c_a;&c_l;&c_je;&c_n;&c_s;&c_t;&c_v;&c_a;</trd>,
    <trd>&c_a;&c_p;&c_a;&c_n;&c_t;&c_a;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_l;&c_ju;&c_t;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_mol;&c_ju;&c_sh;&c_a;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>f&uacute;ria</trd>,
    <trd>frenesia</trd>,
    <trd>frenes&iacute;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>vzteklost</trd>,
    <trd>zu&rcaron;ivost</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Raserei</trd>,
    <trd>Groll</trd>,
    <trd>Tobsucht</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>fury</trd>,
    <trd>rage</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>fureur</trd>,
    <trd>furie<klr tip="ind"> (acc&egrave;s de col&egrave;re)</klr>
    </trd>,
    <trd>rage<klr tip="ind"> (fureur)</klr></trd></trdgrp>
  <trd lng="hu">&odblac;rj&ouml;ng&eacute;s</trd>
  <trdgrp lng="ja">
    <trd>&#x6012;&#x308A;&#x306E;&#x6FC0;&#x3057;&#x3055;  <pr>&#x3044;&#x304B;&#x308A;&#x306E;&#x306F;&#x3052;&#x3057;&#x3055;</pr></trd>,
    <trd>&#x6FC0;&#x6012;  <pr>&#x3052;&#x304D;&#x3069;</pr></trd>
  </trdgrp>
  <trd lng="nl">razernij</trd>
  <trdgrp lng="pl">
    <trd>w&sacute;ciek&lstroke;o&sacute;&cacute;</trd>,
    <trd>sza&lstroke;</trd>,
    <trd>zapami&eogonek;tanie</trd>,
    <trd>napad <ind>sza&lstroke;u</ind></trd>,
    <trd>napad <ind>w&sacute;ciek&lstroke;o&sacute;ci</ind></trd>,
    <trd>napad <ind>furii</ind></trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_ja;&c_r;&c_o;&c_s;&c_t;&c_mol;</trd>,
    <trd>&c_n;&c_je;&c_i;&c_s;&c_t;&c_o;&c_v;&c_s;&c_t;&c_v;&c_o;</trd>,
    <trd>&c_b;&c_je;&c_sh;&c_je;&c_n;&c_s;&c_t;&c_v;&c_o;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>bes</trd>,
    <trd>z&uacute;rivos&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_l;&c_ju;&c_t;&c_mol;</trd>,
    <trd>&c_sh;&c_a;&c_l;&c_je;&c_n;&c_s;&c_t;&c_v;&c_o;</trd>,
    <trd>&c_n;&c_je;&c_s;&c_a;&c_m;&c_o;&c_v;&c_i;&c_t;&c_ib;&c_s;&c_t;&c_mol;</trd>,
    <trd>&c_o;&c_s;&c_k;&c_a;&c_zh;&c_je;&c_n;&c_ib;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_s;&c_k;&c_a;&c_z;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x5927;&#x53D1;&#x813E;&#x6C14; <pr>d&agrave;f&amacron;p&iacute;qi</pr></trd>,
    <trd>&#x607C;&#x6012; <pr>n&#x1CE;on&ugrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="furioz.0igi">
  <kap><tld/>igi</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="furioz.0igi.PSI">
    <dif>
      Igi <tld/>a, spiti, ekscitegi:
      <ekz>
        kial vi <tld/>igas nin
        <fnt>
          <bib>I&scirc;tar</bib>
          <lok>&Ccirc;apitro I</lok>
        </fnt>?
      </ekz>
      <ekz>
        <tld/>igite de la malestima konduto de la juna ar&hcirc;itekturisto <klr>[&#x2026;]</klr>
        akre parolis
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro VIII</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>igite kaj senpaciencigite de preska&ubreve; &ccirc;iuflanka kontra&ubreve;starado, li ekkriis
        kun kolera rigardego al la plej ribelemaj subuloj
        <fnt>
          <bib>I&scirc;tar</bib>
          <lok>&Ccirc;apitro IX</lok>
        </fnt>;
      </ekz>
      <ekz>
        li vidu, &ccirc;u lia atako kapablas neniigi
        tion, kio lin <tld/>igas
        <fnt>
          <aut>trad. I. Chiussi</aut>,
          <vrk>La Nobla Korano</vrk>,
          <lok>1970</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="ekscit.0i.anime">eksciti<sncref/></ref>,
      <ref cel="indign.0i">indigni</ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_r;&c_a;&c_z;&c_mol;&c_l;&c_ju;&c_t;&c_a;&c_v;&c_a;&c_c;&c_mol;</trd>,
    <trd>&c_d;&c_a;&c_v;&c_je;&c_s;&c_mol;&c_c;&c_ib; &c_d;&c_a;
    <ind>&c_sh;&c_a;&c_l;&c_je;&c_n;&c_s;&c_t;&c_v;&c_a;</ind></trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>posar <ind>furi&oacute;s</ind></trd>,
    <trd>enfurismar</trd>,
    <trd>posar <ind>fren&egrave;tic</ind></trd>,
    <trd>treure de <ind>pollaguera</ind></trd>,
    <trd>traure de <ind>pollaguera</ind></trd>,
    <trd>fer perdre els <ind>estrep</ind>s</trd>,
    <trd>fer perdre els <ind>paper</ind>s</trd>,
    <trd>emprenyar</trd>
  </trdgrp>
  <trd lng="cs">rozzu&rcaron;it</trd>
  <trdgrp lng="de">
    <trd>zur <ind>Raserei</ind> bringen</trd>,
    <trd>in <ind>Wut</ind> versetzen</trd>
  </trdgrp>
  <trd lng="fr">mettre en <ind>fureur</ind></trd>
  <trdgrp lng="sk">
    <trd>rozbesni&tcaron;</trd>,
    <trd>rozz&uacute;ri&tcaron;</trd>,
    <trd>roz&ccaron;erti&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_r;&c_o;&c_z;&c_l;&c_ju;&c_t;&c_o;&c_v;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_r;&c_o;&c_z;&c_l;&c_ju;&c_ch;&c_u;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_d;&c_o;&c_v;&c_o;&c_d;&c_i;&c_t;&c_i; &c_d;&c_o; &c_s;&c_k;&c_a;&c_z;&c_u;</trd>
  </trdgrp>
</drv>
</art>
