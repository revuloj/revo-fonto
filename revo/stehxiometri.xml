<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: stehxiometri.xml,v 1.2 2026/11/11 01:57:01 afido Exp $">
    <kap>
      <rad>ste&hcirc;iometri</rad>/o,
      <var><kap><rad var="k">stekiometri</rad>/o <fnt><bib>PIV1</bib></fnt></kap></var>
    </kap>

<drv mrk="stehxiometri.0o">
  <kap><tld/>o, <var><kap><tld var="k"/>o</kap></var></kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      Metodo por elkalkuli la &gcirc;ustajn proporciojn de &hcirc;emia&jcirc;oj partoprenantaj en reakcio:
      <ekz>
        <nom>Johannsen</nom> tro facilanime neglektis la <tld/>on de unuopaj
        feldspatoidoj
        <fnt>
          <bib>SR</bib>
          <aut>Josef Kavka</aut>
          <vrk>Perspektivoj por sistemigo de la magmoroka&jcirc;oj</vrk>
          <lok>Scienca Revuo, nro 129/1978</lok>
        </fnt>;
      </ekz>
      <ekz>
        la eksperimentoj pri oksigeno, <klr>[&#8230;]</klr> ne nur identigis gravan duatoman
        gason, sed anka&ubreve; malfermis vojon al priskribo de kompona&jcirc;oj kaj reakcioj la&ubreve;
        la <tld var="k"/>aj rilatoj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=225490"
              >Neorganika &hcirc;emio</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">St&ouml;chiometrie</trd>
    <trd lng="en">stoichiometry</trd>
    <trd lng="fr">st&oelig;chiom&eacute;trie</trd>
    <trd lng="ru">&c_s;&c_t;&c_je;&c_h;&c_i;&c_o;&c_m;&c_je;&c_t;&c_r;&c_i;&c_ja;</trd>
  </snc>
</drv>

  </art>

