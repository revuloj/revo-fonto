<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kajt.xml,v 1.32 2026/09/23 07:45:44 revo Exp $">
<kap>
   <rad>kajt</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="kajt.0o">
  <kap><tld/>o</kap>
  <snc mrk="kajt.0o.SPO">
    <uzo tip="fak">SPO</uzo>
    <dif>
      <ref tip="lst" cel="lud.0ilo" lst="voko:ludiloj">Ludilo</ref>,
      konsistanta el malpeza skeleto kovrita per papero
      a&ubreve; &scirc;tofo, kiun oni levas en aero tirante &gcirc;in kontra&ubreve; la vento:
      <ekz>
        vila&gcirc;a bubo tenanta kontra&ubreve;vente sian <tld/>on
        <fnt>
          <bib>Kon11</bib>
          <lok>Poezio</lok>
        </fnt>;
      </ekz>
      <ekz>
        la knabinoj a&ubreve;dis pri flugigo de <tld/>o
        <fnt><bib>RugxDom</bib> <lok>&ccirc;apitro 70a, p. 493a</lok></fnt>;
      </ekz>
      <ekz>
        Vejfango <klr>[&#8230;]</klr> estas nomata la &ccirc;efurbo de la
        paper<ref cel="milv.0o">milvo</ref>j (alia nomo por
        <tld/>o en la antikva &Ccirc;inio)
        <fnt>
          <bib>Monato</bib>
          <aut>Shang Xiao-han</aut>
          <vrk><url ref="&Monato;/2013/010994.php"
              >Kajtoj de Vejfango</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="pt">
     <trd>papagaio<klr tip="ind"> (brinquedo)</klr></trd>,
     <trd>pipa<klr tip="ind"> (brinquedo)</klr></trd>,
     <trd>pandorga<klr tip="ind"> (brinquedo)</klr></trd>
    </trdgrp>
  </snc>
  <snc mrk="kajt.0o.TEK">
    <uzo tip="fak">TEK</uzo>
    <dif>
      Aparato, similrimede levi&gcirc;anta, uzata por te&hcirc;nikaj a&ubreve; sciencaj celoj:
      <ekz>
        temis pri la plej longa ekspedicio neprovizita kaj nemotorizita en Antarkto:
        sledojn kaj tiel nomatajn ne&gcirc;-<tld/>ojn ili uzis
        <fnt>
          <bib>Monato</bib>
          <aut>Feliks Nevos</aut>
          <vrk><url ref="&Monato;/2012/010638.php"
              >Ne&gcirc;o-re&gcirc;oj</url></vrk>
          <lok>2012</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <refgrp tip="sin">
    <ref cel="drak.0o.kajto">drako</ref>,
    <ref cel="drak.flug0o">flugdrako</ref>,
    <ref cel="lud.flug0ilo">flugludilo</ref>
  </refgrp>
  <trdgrp lng="be">
   <trd>&c_p;&c_a;&c_v;&c_je;&c_t;&c_r;&c_a;&c_n;&c_y;
     &c_z;&c_mol;&c_m;&c_je;&c_j;</trd>,
   <trd>&c_l;&c_ja;&c_t;&c_u;&c_ch;&c_y;
     &c_z;&c_mol;&c_m;&c_je;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>estel</trd>,
    <trd>milotxa</trd>,
    <trd>catxerulo</trd>
  </trdgrp>
  <trd lng="cs">drak <klr>(hra&ccaron;ka| letadlo)</klr></trd>
  <trd lng="de">Drachen <klr tip="ind">(Flugger&auml;t)</klr></trd>
  <trd lng="en">kite</trd>
  <trdgrp lng="es">
    <trd>cometa</trd>,
    <trd>papalote</trd>
  </trdgrp>
  <trd lng="fi">leija</trd>
  <trd lng="fr">cerf-volant<klr tip="ind"> (jouet,
  instrument)</klr></trd>
  <trd lng="he">&ayin;&pe;&yod;&pe;&vav;&fnun;</trd>
  <trd lng="hu">pap&iacute;rs&aacute;rk&aacute;ny</trd>
  <trd lng="ja">&#x51E7;  <pr>&#12356;&#x304B;&#x306E;&#x307C;&#x308A;</pr></trd>
  <trd lng="nl">vlieger</trd>
  <trd lng="pl">latawiec</trd>
  <trd lng="ro">zmeu</trd>
  <trd lng="ru">&c_v;&c_o;&c_z;&c_d;&c_u;&c_sh;&c_n;&c_y;&c_j;
     &c_z;&c_m;&c_je;&c_j;</trd>
  <trd lng="sk">&scaron;arkan</trd>
  <trd lng="sv">drake</trd>
  <trd lng="tr">u&ccedil;urtma</trd>
  <trd lng="uk">&c_p;&c_a;&c_p;&c_je;&c_r;&c_o;&c_v;&c_i;&c_j;/&c_p;&c_o;&c_v;&c_ib;&c_t;&c_r;&c_ja;&c_n;&c_i;&c_j; &c_z;&c_m;&c_ib;&c_j;</trd>
  <trdgrp lng="zh">
    <trd>&#x98A8;&#x7B8F; <pr>f&emacron;ngzh&emacron;ng</pr></trd>,
    <trd>&#x7D19;&#x9DC2; <pr>zh&#x1D0;y&agrave;o</pr></trd>,
    <trd>&#x9CF6; <pr>yu&amacron;n</pr></trd>,
    <trd>&#x7D19;&#x9CF6; <pr>zh&#x1D0;yu&amacron;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="kajt.K0o">
  <kap>
    <tld lit="K"/>o
  </kap>
  <snc mrk="kajt.K0o.MUZ">
    <uzo tip="fak">MUZ</uzo>
    <uzo tip="fak">ESP</uzo>
    <dif>
      <ref tip="super" cel="grup.muzik0o">Muzikgrupo</ref> el
      nederlanda Frislando kantanta en Esperanto:
      <ekz>
        <tld lit="K"/>o debutis en Esperantujo &ccirc;irka&ubreve; 1989, kiam aperis &gcirc;ia unua disko
        <fnt>
          <bib>Monato</bib>
          <aut>Edmund Grimley Evans</aut>
          <vrk><url ref="&Monato;/2014/011289.php"
              >Kajto flugas plu</url></vrk>
          <lok>2014</lok>
        </fnt>;
      </ekz>
      <ekz>
        la plej populara kompakta disko estis Masko de <tld lit="K"/>o
        <fnt>
          <bib>LOdE</bib>
          <lok>2000, No 1 (63)</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld lit="K"/>o estas kvaza&ubreve; &leftquot;monda kultura hereda&jcirc;o&rightquot; de Esperantujo
        <fnt>
          <bib>Kon11</bib>
          <lok>Recenzo</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Kajto</trd>
  <trd lng="en">Kajto</trd>
  <trd lng="fr">Kajto</trd>
</drv>

</art>
