<vortaro>
<art mrk="$Id: konkor.xml,v 1.25 2026/11/03 12:00:19 revo Exp $">
<kap>
  <ofc>3</ofc>
  <rad>konkord</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="konkor.0o">
  <kap><tld/>o</kap>
  <snc mrk="konkor.0o.KOMUNE">
    <dif>
      Kora a&ubreve; morala plen<ref tip="super" cel="akord.0o.samopinieco">akordo</ref>;
      <ref cel="harmon1.0o.paco">harmonio</ref> de sentoj kaj opinioj
      inter pluraj personoj:
      <ekz>
        en tia afero, se &gcirc;i per si mem montri&gcirc;is vivipova, <tld/>o estas la plej certa
        garantio de senduba sukceso, mal<tld/>o signifas la morton
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Sesa Kongreso Esperantista en Washington en la 15a de a&ubreve;gusto
          1910</vrk>
        </fnt>;
      </ekz>
      <ekz>
        la lingvo <klr>[&#8230;]</klr> montri&gcirc;as en la &ccirc;iutaga vivo jen kiel laborilo nepre
        necesa, jen kiel ponardo vunda a&ubreve; e&ccirc; mortiga, jen kiel semanto de <tld/>o,
        trankvilo, paco kaj amo
        <fnt>
          <bib>Ret</bib>
        </fnt>;
      </ekz>
      <ekz>
        tiu negativismo ne meritus e&ccirc; mencion, se &gcirc;i ne disrompus la <tld/>on kaj
        dissemus defetismon
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        kie regas <tld/>o, regas ordo
        <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        <tld/>o malgranda&jcirc;on kreskigas, mal<tld/>o granda&jcirc;on
        ruinigas
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="konsen.0o">konsento</ref>,
      <ref cel="opini.sam0eco">samopinieco</ref>,
      <ref cel="simpat.0o">simpatio</ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_g;&c_o;&c_d;&c_a;</trd>,
    <trd>&c_u;&c_g;&c_o;&c_d;&c_a;</trd>,
    <trd>&c_u;&c_z;&c_a;&c_je;&c_m;&c_a;&c_r;&c_a;&c_z;&c_u;&c_m;&c_je;&c_n;&c_mol;&c_n;&c_je;</trd>
  </trdgrp>
  <trd lng="ca">conc&ograve;rdia</trd>
  <trdgrp lng="cs">
    <trd>konkordance</trd>,
    <trd>shoda</trd>
  </trdgrp>
  <trdgrp lng="de">
     <trd>Eintracht</trd>,
     <trd>Einm&uuml;tigkeit</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>concord</trd>,
    <trd>accord</trd>,
    <trd>agreement</trd>,
    <trd>harmony</trd>
  </trdgrp>
  <trd lng="es">concordia</trd>
  <trdgrp lng="fr">
    <trd>concorde</trd>,
    <trd>pleine <ind>entente</ind></trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>egyet&eacute;rt&eacute;s</trd>,
    <trd>&ouml;sszhang</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21644;&#21512;  <pr>&#12431;&#12372;&#12358;</pr></trd>,
    <trd>&#35519;&#21644;  <pr>&#12385;&#12423;&#12358;&#12431;</pr></trd>,
    <trd>&#19968;&#33268;  <pr>&#12356;&#12387;&#12385;</pr></trd>
  </trdgrp>
  <trd lng="nl">eendracht</trd>
  <trdgrp lng="pl">
    <trd>jedno&sacute;&cacute;</trd>,
    <trd>zgoda</trd>
  </trdgrp>
  <trd lng="pt">conc&oacute;rdia</trd>
  <trdgrp lng="ro">
    <trd>unitate</trd>,
    <trd>acord</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_s;&c_o;&c_g;&c_l;&c_a;&c_s;&c_i;&c_je;</trd>,
    <trd>&c_l;&c_a;&c_d;</trd>,
    <trd>&c_m;&c_i;&c_r;</trd>,
    <trd>&c_v;&c_z;&c_a;&c_i;&c_m;&c_o;&c_p;&c_o;&c_n;&c_i;&c_m;&c_a;&c_n;&c_i;&c_je;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>jednota</trd>,
    <trd>svornos&tcaron;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#21327;&#21644; <pr>xi&eacute;h&eacute;</pr></trd>,
    <trd>&#26102;&#38605; <pr>sh&iacute;y&omacron;ng</pr></trd>,
    <trd>&#21644;&#35559; <pr>h&eacute;xi&eacute;</pr></trd>,
    <trd>&#24609; <pr>y&iacute;</pr></trd>,
    <trd>&#29166; <pr>xi&egrave;</pr></trd>,
    <trd>&#20840;&#20307;&#19968;&#33268; <pr>qu&aacute;nt&#464;y&imacron;zh&igrave;</pr></trd>,
    <trd>&#27794;&#26377;&#30064;&#35696; <pr>m&eacute;iy&#466;uy&igrave;y&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="konkor.0a">
  <kap><tld/>a</kap>
  <snc mrk="konkor.0a.KOMUNE">
    <dif>
      En grupa interakordo:
      <ekz>
        <tld/>a kunvivado
        <fnt>
          <aut>G. M. Escayola</aut>,
          <vrk><url ref="http://www.gazetoteko.com/kajeroj/k45soci.htm">
          Socia evoluo</url></vrk>,
          <lok>Kajeroj el la Sudo, 1999-05</lok>
        </fnt>;
      </ekz>
      <ekz>
        la pli malnovaj teoriistoj, kvankam ne <tld/>aj pri la detaloj, opiniis, ke
        unueca komuna pralingvo devis iam ekzisti
        <fnt>
          <bib>Ret</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_g;&c_o;&c_d;&c_n;&c_y;</trd>,
    <trd>&c_u;&c_z;&c_g;&c_o;&c_d;&c_n;&c_je;&c_n;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>jednomysln&yacute;</trd>,
    <trd>svorn&yacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>eintr&auml;chtig</trd>,
    <trd>einm&uuml;tig</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>concordant</trd>,
    <trd>harmonieux</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21644;&#21512;&#12375;&#12383;  <pr>&#12431;&#12372;&#12358;&#12375;&#12383;</pr></trd>,
    <trd>&#19968;&#33268;&#12375;&#12383;  <pr>&#12356;&#12387;&#12385;&#12375;&#12383;</pr></trd>
  </trdgrp>
  <trd lng="pl">zgodny</trd>
  <trd lng="ro">conform</trd>
  <trdgrp lng="sk">
    <trd>jednomyse&lcaron;n&yacute;</trd>,
    <trd>svorn&yacute;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#21232; <pr>xi&eacute;</pr></trd>,
    <trd>&#21512;&#25163; <pr>h&eacute;sh&#466;u</pr></trd>,
    <trd>&#21644;&#32654; <pr>h&eacute;m&ecaron;i</pr></trd>,
    <trd>&#21644;&#35559; <pr>h&eacute;xi&eacute;</pr></trd>,
    <trd>&#34701;&#27965; <pr>r&oacute;ngqi&agrave;</pr></trd>,
    <trd>&#35559; <pr>xi&eacute;</pr></trd>,
    <trd>&#38605; <pr>y&omacron;ng</pr></trd>,
    <trd>&#21327;&#21644; <pr>xi&eacute;h&eacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="konkor.0i">
  <kap><tld/>i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="konkor.0i.KOMUNE">
    <dif>
      Inter<ref tip="super" cel="akord.0i.samopinii">akordi</ref>,
      <ref tip="sin" cel="konsen.inter0i.akordigxi">interkonsenti</ref>,
      <ref tip="sin" cel="harmon1.0i">harmonii</ref>:
      <ekz>
        raciaj, ne stultaj homoj <tld/>as, ke lingvo internacia, tutmonda, kiom
        eble plej klara, fonetika, relative facila kaj simpla estas nepre bezonata
        <fnt>
          <bib>Monato</bib>
          <aut>S. Maul</aut>
        </fnt>;
      </ekz>
      <ekz>
        fakto estas, ke la vere nepretervidebla plejmulto de la raciuloj de tiu &ccirc;i mondo
        <tld/>as pri la preciza malo
        <fnt>
          <bib>Monato</bib>
          <vrk>&Ccirc;u ni mortu miskomprene? (2)</vrk>
        </fnt>;
      </ekz>
      <ekz>
        en mia propra kampo psikiatria <klr>[&#8230;]</klr>
        necesas ordigi terminojn, kies uzado ne <tld/>as
        inter diversaj lingvoj
        <fnt>
          <aut>V. Banaitis</aut>,
          <vrk>en: <url
          ref="http://www.liberafolio.org/2014/la-universo-nun-alireblas-en-esperanto">
          La universo nun alireblas en Esperanto</url></vrk>,
          <lok>libera folio, 2014-03-06</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_b;&c_y;&c_c;&c_mol; &c_u;
    <ind>&c_a;&c_d;&c_p;&c_a;&c_v;&c_je;&c_d;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_ib;</ind></trd>,
    <trd>&c_b;&c_y;&c_c;&c_mol; &c_u; <ind>&c_z;&c_g;&c_o;&c_d;&c_z;&c_je;</ind></trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>b&yacute;t v jednot&ecaron;</trd>,
    <trd>b&yacute;t ve svornosti</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>&uuml;bereinstimmen <ind>(in Sinnen und Trachten)</ind></trd>,
    <trd>in <ind>Eintracht</ind> sein</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>concorder</trd>,
    <trd>s'<ind>harmoniser</ind></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21644;&#21512;&#12375;&#12390;&#12356;&#12427;  <pr>&#12431;&#12372;&#12358;&#12375;&#12390;&#12356;&#12427;</pr></trd>,
    <trd>&#19968;&#33268;&#12375;&#12390;&#12356;&#12427;  <pr>&#12356;&#12387;&#12385;&#12375;&#12390;&#12356;&#12427;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>by&cacute; w <ind>zgodzie</ind></trd>,
    <trd>pokrywa&cacute; <klr>(si&eogonek; z czym&sacute;)</klr></trd>
  </trdgrp>
<trdgrp lng="ro">
    <trd>sunt conforme</trd>,
    <trd>suna bine</trd>,
    <trd>acoperi <klr>(cu ceva)</klr></trd>
  </trdgrp>
  <trd lng="sk">by&tcaron; svorn&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#30456;&#31526; <pr>xi&amacron;ngf&uacute;</pr></trd>,
    <trd>&#31216; <pr>ch&egrave;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="konkor.0ekun">
  <kap><tld/>e kun,
  <var><kap><tld/>e al</kap></var></kap>
  <gra><vspec>prepozicia&jcirc;o</vspec></gra>
  <snc mrk="konkor.0ekun.KOMUNE">
    <dif>
      Harmonie kun,
      <ref tip="vid" cel="akord.0ekun.KOMUNE">akorde kun</ref>...:
      <ekz>
        <tld/>e al tiu bruo ekmu&gcirc;is la urbanoj
        <fnt>
          <aut>Hasegawa T.</aut>,
          <vrk><url ref="http://wikilivres.ca/wiki/En_%C4%88inio_Batalanta">
          En &Ccirc;inio Batalanta</url></vrk>,
          <lok>1954</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>e kun la mona&hcirc;eja regulo ili zorgadis
        pri malri&ccirc;uloj kaj malsanuloj
        <fnt>
          <aut>-</aut>,
          <vrk><url ref="http://www.gdynia.pl/esp/tourism/5600_53205.html">
          Mallonga promenado tra historiaj monumentoj de Gdynia
          (Gdinio)</url></vrk>,
          <lok>[vidita en 2012]</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="konfor.0eal">konforme kun</ref>
  </snc>
  <trd lng="be">&c_u;
  <ind>&c_a;&c_d;&c_p;&c_a;&c_v;&c_je;&c_d;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_ib;</ind> &c_z;&#8230;</trd>
  <trd lng="de">in <ind>&Uuml;bereinstimmung</ind> mit</trd>
  <trd lng="fr">en accord avec</trd>
  <trd lng="pl">zgodnie z</trd>
  <trdgrp lng="ro">
    <trd>conform</trd>,
    <trd>potrivit</trd>
  </trdgrp>
</drv>

<drv mrk="konkor.mal0a">
  <kap>mal<tld/>a</kap>
  <snc mrk="konkor.mal0a.KOMUNE">
    <dif>
      Kiu ne enhavas interkonsenton, harmonion,
      unuecon:
      <ekz>
        kiel preska&ubreve; &ccirc;iam okazas, la minoritatajn
        mal<tld/>ajn vo&ccirc;ojn silentigis <klr>[&#8230;]</klr>
        plimulto
        <fnt>
          <aut>L. E. M&aacute;rquez, trad. T. del Barrio</aut>,
          <vrk><url ref="http://www.delbarrio.eu/spiritismo.htm">
          Infanina Ludo</url></vrk>,
          <lok>[2010?]</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_n;&c_ja;&c_z;&c_g;&c_o;&c_d;&c_n;&c_y;</trd>,
    <trd>&c_n;&c_je;&c_a;&c_d;&c_p;&c_a;&c_v;&c_je;&c_d;&c_n;&c_y;</trd>,
    <trd>&c_n;&c_ja;&c_w;&c_z;&c_g;&c_o;&c_d;&c_n;&c_je;&c_n;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>v nejednot&ecaron;</trd>,
    <trd>ve sv&aacute;ru</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>zwietr&auml;chtig</trd>,
    <trd>uneinig</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>d&eacute;suni</trd>,
    <trd>discordant</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#19981;&#21644;&#12398;  <pr>&#12405;&#12431;&#12398;</pr></trd>,
    <trd>&#19981;&#19968;&#33268;&#12398;  <pr>&#12405;&#12356;&#12387;&#12385;&#12398;</pr></trd>
  </trdgrp>
  <trd lng="pl">niezgodny</trd>
  <trdgrp lng="ro">
    <trd>discordie</trd>,
    <trd>nepotrivit</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>nejednotn&yacute;</trd>,
    <trd>nesvorn&yacute;</trd>,
    <trd>nezn&aacute;&scaron;anliv&yacute;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#19981;&#21644; <pr>b&ugrave;h&eacute;</pr></trd>,
    <trd>&#19981;&#31526;&#21512; <pr>b&ugrave;f&uacute;h&eacute;</pr></trd>,
    <trd>&#19968;&#30424;&#25955;&#27801; <pr>y&imacron;p&aacute;ns&#462;nsh&amacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="konkor.mal0o">
  <kap>mal<tld/>o</kap>
  <snc mrk="konkor.mal0o.KOMUNE">
    <dif>
      Diseco de sentoj, opinioj, agadoj,
      spirita
      <ref tip="vid" cel="unu.mal0eco.KOMUNE">malunueco</ref>:
      <ekz>
        nenia afero estas pli malbenita, ol la dispartii&gcirc;o kaj
        mal<tld/>o
        <fnt>
          <bib>SatirRak</bib>,
          <lok>Kain kaj Abel</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_n;&c_ja;&c_z;&c_g;&c_o;&c_d;&c_a;</trd>,
    <trd>&c_n;&c_ja;&c_z;&c_g;&c_o;&c_d;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_n;&c_je;&c_a;&c_d;&c_p;&c_a;&c_v;&c_je;&c_d;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>,
    <trd>&c_r;&c_a;&c_z;&c_l;&c_a;&c_d;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>nejednotnost</trd>,
    <trd>neshoda</trd>,
    <trd>nesoulad</trd>,
    <trd>nesvornost</trd>,
    <trd>rozkol</trd>
  </trdgrp>
  <trd lng="cv">&c_ju;&c_t;&c_sh;&#1233;&c_n;&c_u;&c_l;&#1233;&c_h;</trd>
  <trdgrp lng="de">
    <trd>Zwietracht</trd>,
    <trd>Uneinigkeit</trd>,
    <trd>Hader</trd>,
    <trd>Dissens</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>discorde</trd>,
    <trd>dissentiment</trd>,
    <trd>m&eacute;sentente</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#19981;&#21644;  <pr>&#12405;&#12431;</pr></trd>,
    <trd>&#19981;&#19968;&#33268;  <pr>&#12405;&#12356;&#12387;&#12385;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>rozterka</trd>,
    <trd>scysja</trd>,
    <trd>wa&sacute;&nacute;</trd>
  </trdgrp>
<trdgrp lng="ro">
    <trd>dilem&abreve; </trd>,
    <trd>nedumerire</trd>,
    <trd>ceart&abreve;</trd>,
    <trd>ciocnire</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>nejednotnos&tcaron;</trd>,
    <trd>nesvornos&tcaron;</trd>,
    <trd>nezn&aacute;&scaron;anlivos&tcaron;</trd>,
    <trd>rozkol</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#19981;&#21644; <pr>b&ugrave;h&eacute;</pr></trd>,
    <trd>&#24847;&#35211;&#19981;&#21512; <pr>y&igrave;ji&agrave;nb&ugrave;h&eacute;</pr></trd>,
    <trd>&#38548;&#38305; <pr>g&eacute;h&eacute;</pr></trd>
  </trdgrp>
</drv>
