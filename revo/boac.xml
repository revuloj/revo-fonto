<art mrk="$Id: boac.xml,v 1.28 2026/08/31 20:00:21 revo Exp $">
<kap>
<ofc>9</ofc> <rad>boac</rad>/o <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="boac.0o">
  <kap><ofc>9</ofc><tld/>o</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:zoologiaj_genroj">Genro</ref> el familio <ref
      tip="malprt" cel="cerved.0oj">cervedoj</ref>
      (<trd lng="la">Rangifer</trd>), vivanta en nordaj regionoj.
      Amba&ubreve; seksoj portas kornojn:
      <ekz>
        la <tld/>o estas la sola hejmbesta specio el cervedoj.
      </ekz>
    </dif>
    <ref tip="sin" cel="cerv.norda0o">norda cervo</ref>
  </snc>
  <trd lng="be">&c_a;&c_l;&c_je;&c_n;&c_mol;<klr tip="amb">
  (&c_p;&c_a;&c_w;&c_n;&c_o;&c_ch;&c_n;&c_y;)</klr></trd>
  <trd lng="bg">&c_s;&c_je;&c_v;&c_je;&c_r;&c_je;&c_n;<ind> &c_je;&c_l;&c_je;&c_n;</ind></trd>
  <trdgrp lng="ca">
    <trd>ren</trd>,
    <trd>carib&uacute;</trd>
  </trdgrp>
  <trd lng="de">Rentier</trd>
  <trdgrp lng="en">
    <trd>reindeer</trd>,
    <trd>caribou</trd>
  </trdgrp>
  <trd lng="fr">renne</trd>
  <trd lng="he">&alef;&yod;&lamed;</trd>
  <trdgrp lng="hu">
    <trd>tar&aacute;ndszarvas</trd>,
    <trd>r&eacute;nszarvas</trd>
  </trdgrp>
  <trd lng="io">rentiro</trd>
  <trdgrp lng="ja">
    <trd>&#12488;&#12490;&#12459;&#12452;</trd>,
    <trd>&#12459;&#12522;&#12502;&#12540;</trd>,
    <trd>&#39348;&#40575;  <pr>&#12376;&#12421;&#12435;&#12429;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="nl">rendier</trd>
  <trdgrp lng="pl">
    <trd>renifer</trd>,
    <trd>ren</trd>
  </trdgrp>
  <trd lng="ru">&c_o;&c_l;&c_je;&c_n;&c_mol;<klr>
  (&c_s;&c_je;&c_v;&c_je;&c_r;&c_n;&c_y;&c_j;)</klr></trd>
  <trd lng="se">boazu</trd>
  <trd lng="sv">ren</trd>
  <trd lng="uk">&c_p;&c_ib;&c_v;&c_n;&c_ib;&c_ch;&c_n;&c_i;&c_j;&nbsp;&c_o;&c_l;&c_je;&c_n;&c_mol; (&c_d;&c_i;&c_k;&c_i;&c_j;)</trd>
</drv>
</art>
