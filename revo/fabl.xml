<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: fabl.xml,v 1.32 2026/08/04 19:53:24 revo Exp $">
<kap>
<ofc>*</ofc>
<rad>fabl</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="fabl.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <uzo tip="fak">BELE</uzo>
  <snc>
    <dif>
      Fantazia <ref tip="super" cel="rakont.0o">rakonto</ref>,
      ofte versa, kies agantoj estas plej ofte bestoj
      a&ubreve; senvivaj objektoj, kaj pruvanta moralan instruon:
      <ekz>
        <tld/>oj de <ref cel="ezop.0o">Ezopo</ref>, de <nom>La Fontaine</nom>;
      </ekz>
      <ekz>
        ripetu al vi la vortojn de malnova <tld/>o: malbone, malbone vi tempon pasigas,
        vin tio amuzas, nin tio mortigas
        <fnt>
          <bib>Marta</bib>
        </fnt>!
      </ekz>
      <ekz>
        &leftquot;estas malsa&gcirc;e kalkuli la kokidojn anta&ubreve; la elkovi&gcirc;o&rightquot; &ndash; &leftquot;malnova fablo,&rightquot; diris
        <nom>Kensford</nom>
        <fnt>
          <bib>KKl</bib>
          <lok>&Ccirc;apitro 1</lok>
        </fnt>;
      </ekz>
      <ekz>
        malsatulon la <tld/>oj ne nutros
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="sub">
      <ref cel="apolog.0o">apologo</ref>
    </refgrp>
    <ref tip="vid" cel="parabo.0o.BELE">parabolo<sncref/></ref>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_j;&c_k;&c_a;</trd>
  <trd lng="bg">&c_b;&c_a;&c_s;&c_n;&c_ja;</trd>
  <trdgrp lng="br">
    <trd>fablenn</trd>,
    <trd>mojenn<klr tip="ind"> (fablenn)</klr></trd>
  </trdgrp>
  <trd lng="ca">faula</trd>
  <trd lng="cs">bajka</trd>
  <trd lng="de">Fabel</trd>
  <trdgrp lng="en">
    <trd>fable</trd>,
    <trd>beast <ind>fable</ind></trd>
  </trdgrp>
  <trd lng="es">f&aacute;bula</trd>
  <trdgrp lng="fa">
    <trd>&a_q;&a_S;&a_h;</trd>,
    <trd>&a_H;&f_k;&a_A;&f_y;&a_t;</trd>,
    <trd>&a_A;&a_f;&a_s;&a_A;&a_n;&a_h;</trd>
  </trdgrp>
  <trd lng="fr">fable<klr tip="ind"> (genre
    litt&eacute;raire)</klr></trd>
  <trdgrp lng="hu">
    <trd>&aacute;llatmese</trd>,
    <trd>fabula</trd>
  </trdgrp>
  <trd lng="id">fabel</trd>
  <trd lng="ja">&#x5BD3;&#x8A71; <pr>&#x3050;&#x3046;&#x308F;</pr></trd>
  <trd lng="lat">fabula, ae</trd>
  <trd lng="nl">fabel</trd>
  <trd lng="pl">bajka</trd>
  <trdgrp lng="pt">
    <trd>ap&oacute;logo</trd>,
    <trd>f&aacute;bula</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_b;&c_a;&c_s;&c_n;&c_ja;</trd>,
    <trd>&c_p;&c_r;&c_i;&c_t;&c_ch;&c_a;</trd>
  </trdgrp>
  <trd lng="sk">b&aacute;jka</trd>
  <trd lng="sv">fabel</trd>
  <trdgrp lng="uk">
    <trd>&c_b;&c_a;&c_j;&c_k;&c_a;</trd>,
    <trd>&c_p;&c_r;&c_i;&c_t;&c_ch;&c_a;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x7A7A;&#x8AC7; <pr>k&omacron;ngt&aacute;n</pr></trd>,
    <trd>&#x8B0A;&#x8A71; <pr>hu&#x1CE;nghu&agrave;</pr></trd>,
    <trd>&#x634F;&#x9020;&#x7684;&#x4E8B; <pr>ni&emacron;z&agrave;odesh&igrave;</pr></trd>,
    <trd>&#x5BD3;&#x8A00; <pr>y&ugrave;y&aacute;n</pr></trd>
  </trdgrp>
</drv>
</art>
