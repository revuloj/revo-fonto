<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: balafon.xml,v 1.15 2026/09/14 23:07:10 revo Exp $">
<kap>
  <rad>balafon</rad>/o <fnt><bib>SPIV</bib></fnt>
</kap>
<drv mrk="balafon.0o">
  <kap><tld/>o</kap>
  <snc mrk="balafon.0o.MUZ">
    <uzo tip="fak">MUZ</uzo>
    <dif>
      <ref tip="lst" cel="instru2.frap0o" lst="voko:frapinstrumentoj">Frapinstrumento</ref>
      el serio de lignolamenoj frapataj per bastonetoj, kun kalabasoj
      kiel sonkestoj, populara en centra kaj okcidenta Afriko:
      <ekz>
        <tld/>o, pigmeokanto, birdalvokoj kaj akvobruo...
        <fnt>
        <aut>O. Briand</aut>,
        <vrk><url ref="http://kantoturdo.free.fr/">Kantoturdo</url></vrk>,
        <lok>[vidita je 2006-03-09]</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="ksilof.0o">ksilofono</ref>
    </refgrp>
    <bld
      lok="&WCU;/thumb/a/ad/Ba_Banga_Nyeck_jouant_au_balafon_chromatique.jpg/960px-Ba_Banga_Nyeck_jouant_au_balafon_chromatique.jpg"
      prm="CC0"
      >ludanto de <tld/>o Ba Banga Nyeck
        <fnt>
          <aut>Hermivan, propra verko</aut>
          <lok><url ref="&WCW;/File:Ba_Banga_Nyeck_jouant_au_balafon_chromatique.jpg"
              >https://commons.wikimedia.org/wiki/File:Ba_Banga_Nyeck_jouant_au_balafon_chromatique.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_l;&c_ja;&c_f;&c_o;&c_n;</trd>
  <trd lng="bg">&c_b;&c_a;&c_l;&c_a;&c_f;&c_o;&c_n;</trd>
  <trd lng="ca">balafo</trd>
  <trd lng="cs">balafon</trd>
  <trd lng="de">Balafon</trd>
  <trd lng="en">balaphone</trd>
  <trdgrp lng="fr">
    <trd>balafon</trd>
  </trdgrp>
  <trd lng="hu">balafon</trd>
  <trd lng="it">balafon</trd>
  <trd lng="nl">balafoon</trd>
  <trd lng="sk">balaf&oacute;n</trd>
  <trd lng="uk">&c_b;&c_a;&c_l;&c_a;&c_f;&c_o;&c_n;</trd>
</drv>
</art>
