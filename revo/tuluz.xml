<vortaro>

  <art mrk="$Id: tuluz.xml,v 1.7 2026/10/23 08:00:21 afido Exp $">
    <kap>
      <rad>Tuluz</rad>/o
    </kap>

<drv mrk="tuluz.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc mrk="tuluz.0o.urbo">
    <dif>
      Sudfranca <ref tip="lst" lst="voko:urboj" cel="urb.0o">urbo</ref>
      &ccirc;e Garono, c. 200&#8239;km sudoriente de
      <ref tip="prt" cel="bordoz.0o">Bordozo</ref>:
      situo: (<frm>43&#730;36&minute; N  1&#730;26&minute; E</frm>):
      <ekz>
        en <tld/>o en la stacidomo ili jam atendas min
        <fnt>
          <bib>Mortul&Scirc;ip</bib>
          <lok>&Ccirc;apitro 12</lok>
        </fnt>;
      </ekz>
      <ekz>
        multaj lo&gcirc;antoj komence de la anta&ubreve;a jarcento estis devigitaj foriri por labori
        en Barcelono a&ubreve; en <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Gerard Escuer</aut>
          <vrk><url ref="https://www.monato.be/2005/008697.php">Andoro ne estas Monako</url></vrk>
          <lok>2005</lok>
        </fnt>;
      </ekz>
      <ekz>
        al Portugalio mi veturis trajne tra <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Tatjana Loskutova</aut>
          <vrk><url ref="https://www.monato.be/2007/009164.php">Voja&gcirc;o en Iberio</url></vrk>
          <lok>2007</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_T;&c_u;&c_l;&c_ju;&c_z;&c_a;</trd>
    <trd lng="de">Toulouse</trd>
    <trd lng="en">Toulouse</trd>
    <trd lng="fr">Toulouse</trd>
    <trd lng="oc">Tolosa</trd>
    <trd lng="pl">Tuluza</trd>
    <trdgrp lng="zh">
    <trd>&#22270;&#21346;&#26031; <pr>T&uacute;l&uacute;s&#299;</pr></trd>,
    <trd>&#22294;&#30439;&#26031; <pr>T&uacute;l&uacute;s&#299;</pr></trd>,
    <trd>&#22270;&#21346;&#20857; <pr>T&uacute;l&uacute;z&#299;</pr></trd>,
    <trd>&#22294;&#30439;&#33586; <pr>T&uacute;l&uacute;z&#299;</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="ca">
    <trd>Tolosa</trd>,
    <trd>Tolosa de Llenguadoc</trd>
  </trdgrp>
  <trd lng="es">Toulouse</trd>
  <trd lng="ja">&#12488;&#12453;&#12540;&#12523;&#12540;&#12474;</trd>
</drv>
