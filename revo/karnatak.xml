<kap>
  <rad>Karnatak</rad>/o <fnt><bib>NePiv</bib></fnt>
  <fnt><bib>LanLin</bib></fnt>
</kap>
<drv mrk="karnatak.0o">
  <kap><tld/>o</kap>
  <snc mrk="karnatak.0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Gubernio en la sudokcidenta parto de
      <ref tip="malprt" cel="hind.H0ujo.POL">Hindujo</ref>:
      <ekz>
        la plej glora periodo en la historio de <tld/>o 
        estis la regno de &Ccirc;alukja ekde la 6a jarcento p.K.  
        <fnt>
          <aut>-</aut>,
          <vrk><url ref="http://barato.50webs.org/eventoj/ak2008/ak2008-pri-karnatako.htm">
          La Gubernio Karnatako: mallonga historio</url></vrk>,
          <lok>[vidita en 2014]</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_K;&c_a;&c_r;&c_n;&c_a;&c_t;&c_a;&c_k;&c_a;</trd>
  <trd lng="ca">Karnataka</trd>
  <trd lng="en">Karnataka</trd>
  <trd lng="es">Karnataka</trd>
  <trd lng="fr">Karnataka</trd>
  <trd lng="ja">&#12459;&#12523;&#12490;&#12479;&#12459;&#24030;  <pr>&#12459;&#12523;&#12490;&#12479;&#12459;&#12375;&#12421;&#12358;</pr></trd>
  <trd lng="pl">Karnataka</trd>     
  <trd lng="ro">Karnataka</trd>
  <trd lng="uk">&c_K;&c_a;&c_r;&c_n;&c_a;&c_t;&c_a;&c_k;&c_a;</trd>
  <trd lng="zh">&#21345;&#32013;&#22612;&#20811;&#37030; <pr>K&#462;n&agrave;t&#462;k&egrave;b&#257;ng</pr></trd>
</drv>
