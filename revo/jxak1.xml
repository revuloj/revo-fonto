<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: jxak1.xml,v 1.14 2026/08/07 00:15:34 revo Exp $">
<kap>
  <rad>&jcirc;ak</rad>/o
</kap>
<drv mrk="jxak1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">ELE</uzo>
  <snc mrk="jxak1.0o.sxtopilo">
    <fnt><bib>PV</bib></fnt>
    <dif>
      Cilindroforma
      <ref tip="super" cel="sxtop.0ilo.ELE">&scirc;topilo</ref>,
      kiun oni &scirc;ovas en &scirc;topilingon por fari simplan, duopan
      a&ubreve; pluropan kontakton;
      iam uzata por &scirc;alti kaj mal&scirc;alti telefonajn cirkvitojn,
      nun ekz-e por konekti <ref cel="auxd.kap0ilo">kapa&ubreve;dilon</ref>
      al komputilo a&ubreve; sonaparato.
    </dif>
    <trdgrp lng="be">
      <trd>&c_sh;&c_t;&c_e;&c_k;&c_je;&c_r;</trd>,
      <trd>&c_v;&c_ib;&c_l;&c_k;&c_a; <klr tip="amb">
      (&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_y;&c_ch;&c_n;&c_a;&c_ja;)
      </klr></trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Klinke <klr>(Stecker)</klr></trd>,
      <trd>St&ouml;psel</trd>
    </trdgrp>
    <trdgrp lng="it">
      <trd>jack</trd>,
      <trd>connettore<klr> (tipo jack)</klr></trd>
    </trdgrp>
  </snc>
  <snc mrk="jxak1.0o.sxtopilingo">
    <fnt><bib>PIV1</bib></fnt>
    <dif>
      La <ref tip="super" cel="sxtop.0ilingo">&scirc;topilingo</ref>,
      responda al <tld/>o <sncref ref="jxak1.0o.sxtopilo"/>:
      <ekz>
        la telefonistino povas fari interligon helpe de <tld/>oj, du <tld/>oj estas
        konektitaj per konduktiloj, klaprelajso anoncis, se iu vokis, la
        telefonistino &scirc;topis liberan &scirc;topilon en la la&ubreve;an &scirc;topilingon, demandis la
        vokiton, balda&ubreve; &scirc;i &scirc;topis la alian &scirc;topilon en la &scirc;topilingon de la vokito
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=203471">Telefoncentralo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>&scirc;topilingo</ke>.
    </rim>
    <trdgrp lng="be">
      <trd>&c_g;&c_n;&c_ja;&c_z;&c_d;&c_o; <klr tip="amb">
      (&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_y;&c_ch;&c_n;&c_a;&c_g;&c_a;
      &c_r;&c_a;&c_z;&c_d;&c_y;&c_m;&c_a;)</klr></trd>,
      <trd>&c_r;&c_a;&c_z;&c_e;&c_t;&c_k;&c_a; <klr tip="amb">
      (&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_y;&c_ch;&c_n;&c_a;&c_ja;)
      </klr></trd>
    </trdgrp>
    <trd lng="de">Buchse</trd>
    <trdgrp lng="zh">
      <trd>&#32178;&#32097;&#20986;&#21475; <pr>w&#462;nglu&ograve;ch&umacron;k&#466;u</pr></trd>,
      <trd>&#36600;&#22871; <pr>zh&oacute;ut&agrave;o</pr></trd>,
      <trd>&#38604;&#24615;&#25509;&#21475; <pr>c&iacute;x&igrave;ngji&emacron;k&#466;u</pr></trd>
    </trdgrp>
  </snc>
  <refgrp tip="hom">
    Ne konfuzu kun
    <ref cel="jxak.0o">&jcirc;ako</ref>
  </refgrp>
  <rim>
    PIV senambigue difinas <tld/>on kiel &scirc;topilingon, sed ne
    indikas la nomon de la responda &scirc;topilo. PV difinas <tld/>on
    kiel &leftquot;konektilon&rightquot; (sen difino), sed en la difino de &leftquot;kontaktilo&rightquot;
    klare donas al &gcirc;i &scirc;topilan rolon. &Ccirc;u ne estus sa&gcirc;e
    reveni al la PV-a senco por <ctl><tld/>o</ctl> kaj enkonduki <ctl>
    <tld/>ingo</ctl> por la PIV-a senco?
  </rim>
  <adm>
    Kontroli trad en, hu, nl, ru.
    <aut>MB</aut>
  </adm>

  <trd lng="en">jack</trd>
  <trdgrp lng="fr">
    <trd>jack</trd>,
    <trd>connecteur jack</trd>,
    <trd>fiche jack</trd>,
    <trd>prise jack</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>jackdug&oacute;</trd>,
    <trd>kapcsol&oacute;h&uuml;vely</trd>,
    <trd>dugaszh&uuml;vely</trd>
  </trdgrp>
  <trd lng="ja">&#12472;&#12515;&#12483;&#12463;  <pr>&#12376;&#12419;&#12387;&#12367;</pr></trd>
  <trd lng="nl">contactbus</trd>
  <trd lng="pl">wtyczka<klr> elektryczna</klr></trd>
  <trd lng="pt">plugue</trd>
  <trd lng="ru">&c_g;&c_n;&c_je;&c_z;&c_d;&c_o;<klr tip="amb"> (&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_o;&c_g;&c_o;
     &c_r;&c_a;&c_z;&c_malmol;&c_jo;&c_m;&c_a;)</klr></trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_je;&c_r;&c_je;&c_m;&c_i;&c_k;&c_a;&c_ch;</trd>,
    <trd>&c_g;&c_n;&c_ib;&c_z;&c_d;&c_o; &c_t;&c_je;&c_l;&c_je;&c_f;&c_o;&c_n;&c_n;&c_o;&c_g;&c_o; &c_k;&c_o;&c_m;&c_u;&c_t;&c_a;&c_t;&c_o;&c_r;&c_a;</trd>
  </trdgrp>
</drv>
</art>

