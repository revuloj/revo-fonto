<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: ruten.xml,v 1.4 2026/10/30 05:40:44 afido Exp $">
    <kap>
      <rad>ruten</rad>/o
    </kap>

<drv mrk="ruten.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      <klr>(en la 14a &gcirc;is 18a jc)</klr> Ano de orientslava popolo, parolanto de orientslava lingvo
      el kiu evoluis la belorusa, ukrajna kaj rusa lingvoj:
      <ekz>
        en lando nomata &leftquot;Polujo&rightquot; la Poloj sentas sin mastroj, dum Hebreoj, <tld lit="R"/>oj kaj
        Litovoj plendas pri humiligo
        <fnt>
          <bib>VivZam</bib>
          <lok>Vivo de Zamenhof</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Ruthene</trd>,
      <trd>Reu&szlig;e</trd>
    </trdgrp>
    <trdgrp lng="uk">
      <trd>&c_r;&c_u;&c_s;&c_i;&c_n; <klr>(m.)</klr></trd>,
      <trd>&c_r;&c_u;&c_s;&c_i;&c_n;&c_k;&c_a; <klr>(f.)</klr></trd>
      <trd>&c_r;&c_u;&c_t;&c_je;&c_n;&c_je;&c_c;&c_mol; <klr>(m.)</klr></trd>,
      <trd>&c_r;&c_u;&c_t;&c_je;&c_n;&c_k;&c_a; <klr>(f.)</klr></trd>
    </trdgrp>
  </snc>
<trd lng="id">orang Rutenia</trd>
</drv>

<drv mrk="ruten.0ujo">
  <kap>
    <tld lit="R"/>ujo
  </kap>
  <snc>
    <uzo tip="fak">HIS</uzo>
    <dif>
      Historia regiono oriente de Karpatoj:
      <ekz>
        Grodno, urbo <klr>[&#8230;]</klr> &ccirc;elime de Litvo, Polujo kaj Blank-<tld lit="R"/>ujo
        <fnt>
          <bib>SrT</bib>
          <lok>Libro XI.</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="de">
    <trd>Ruthenien</trd>,
    <trd>Reu&szlig;en</trd>
  </trdgrp>
  <trd lng="id">Rutenia</trd>
  <trdgrp lng="uk">
    <trd>&c_R;&c_u;&c_s;&c_mol;</trd>,
    <trd>&c_R;&c_u;&c_t;&c_je;&c_n;&c_ib;&c_ja;</trd>
  </trdgrp>
</drv>

  </art>

