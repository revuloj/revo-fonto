<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: karmez.xml,v 1.23 2026/09/20 11:17:56 revo Exp $">
<kap>
  <rad>karmezin</rad>/o
  <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="karmez.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Malhela ru&gcirc;a <ref tip="lst" cel="kolor.0o.propre" lst="voko:koloroj">koloro</ref> kun
      viola nuanco:
      <ekz>
      la nuboj &scirc;an&gcirc;is koloron, de hel-oran&gcirc;o al <tld/>o kaj purpuro

      <fnt>
        <aut>Frank Roger</aut>
        <vrk><url ref="&Monato;/2004/008248.html">La brulanta virino</url></vrk>
        <bib>Monato</bib>
        <lok>2004/02, p. 24</lok>
        </fnt>.

      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_a;&c_r;&c_m;&c_a;&c_z;&c_y;&c_n;</trd>,
    <trd>&c_k;&c_a;&c_r;&c_m;&c_a;&c_z;&c_y;&c_n;&c_a;&c_v;&c_y; &c_k;&c_o;&c_l;&c_je;&c_r;</trd>
  </trdgrp>
  <trd lng="cs">tmavo&ccaron;erven&eacute; barvivo</trd>
  <trd lng="de">Karmesinrot</trd>
  <trdgrp lng="en">
    <trd>crimson</trd>,
    <trd>deep <ind>red</ind><klr> inclining to purple</klr></trd>
  </trdgrp>
  <trd lng="es">carmes&iacute;</trd>
  <trdgrp lng="fr">
    <trd>couleur <ind>cramoisie</ind></trd>,
    <trd>rouge fonc&eacute;</trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>karmazsin sz&iacute;n</trd>,
    <trd>lil&aacute;spiros sz&iacute;n</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x6DF1;&#x7D05;&#33394;  <pr>&#12375;&#12435;&#12371;&#12358;&#12375;&#12423;&#x304F;</pr></trd>,
    <trd>&#x30AF;&#x30EA;&#x30E0;&#x30BD;&#x30F3;</trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>karmozijn</trd>,
    <trd>donkerrood</trd>
  </trdgrp>
  <trd lng="pl">karmazyn</trd>
  <trd lng="ro">crimson</trd>
  <trdgrp lng="ru">
    <trd>&c_t;&c_jo;&c_m;&c_n;&c_o;-&c_k;&c_r;&c_a;&c_s;&c_n;&c_y;&c_j; &c_c;&c_v;&c_je;&c_t;</trd>,
    <trd>&c_m;&c_a;&c_l;&c_i;&c_n;&c_o;&c_v;&c_y;&c_j; &c_c;&c_v;&c_je;&c_t;</trd>,
    <trd>&c_k;&c_a;&c_r;&c_m;&c_a;&c_z;&c_i;&c_n;&c_n;&c_y;&c_j; &c_c;&c_v;&c_je;&c_t;</trd>
  </trdgrp>
  <trd lng="sk">karmaz&iacute;n</trd>
</drv>

<drv mrk="karmez.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Malhele ru&gcirc;a kun viola nuanco:
      <ekz>
        Jaspa tuj surmetis botetojn el ru&gcirc;a &scirc;afledo <klr>...</klr> kaj
        <tld/>an silkan mantelon
        <fnt><bib>RugxDom</bib> <lok>&ccirc;apitro 49a, p. 121a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_r;&c_m;&c_a;&c_z;&c_y;&c_n;&c_a;&c_v;&c_y;</trd>
  <trdgrp lng="cs">
    <trd>tmavo&ccaron;erven&yacute;</trd>,
    <trd>z&aacute;&rcaron;iv&ecaron; rud&yacute;</trd>
  </trdgrp>
  <trd lng="de">karmesinrot</trd>
  <trd lng="en">crimson</trd>
  <trd lng="es">carmes&iacute;</trd>
  <trd lng="fr">cramoisi</trd>
  <trdgrp lng="hu">
    <trd>karmazsin</trd>,
    <trd>lil&aacute;spiros</trd>
  </trdgrp>
  <trd lng="ja">&#x6DF1;&#x7D05;&#33394;&#x306E;  <pr>&#12375;&#12435;&#x304F;&#12356;&#x308D;&#x306E;</pr></trd>
  <trd lng="pl">karmazynowy</trd>
  <trdgrp lng="ro">
    <trd>carmin</trd>,
    <trd>purpuriu</trd>
  </trdgrp>
  <trd lng="sk">tmavo&ccaron;erven&yacute;</trd>
  <trdgrp lng="uk">
    <trd>&c_t;&c_je;&#x43C;&#x43D;&#x43E;-&c_ch;&c_je;&c_r;&c_v;&#x43E;&#x43D;&c_i;&c_j;</trd>,
    <trd>&#x43C;&c_a;&#x43B;&c_i;&#x43D;&#x43E;&c_v;&c_i;&c_j;</trd>,
    <trd>&#x43A;&c_a;&c_r;&#x43C;&c_a;&c_z;&c_i;&#x43D;&#x43E;&c_v;&c_i;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8D6F; <pr>t&#xE1;ng</pr></trd>,
    <trd>&#22823;&#x7D05; <pr>d&#xE0;h&#xF3;ng</pr></trd>,
    <trd>&#33395;&#x7EA2;&#33394; <pr>y&#xE0;nh&#xF3;ngs&#xE8;</pr></trd>
  </trdgrp>
</drv>
</art>
