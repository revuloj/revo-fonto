<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: skot.xml,v 1.30 2026/10/23 08:00:22 revo Exp $">
<kap><ofc>10</ofc>
  <rad>skot</rad>/o
<fnt><bib>JED</bib></fnt></kap>

<drv mrk="skot.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      <tld lit="S"/>landano:
      <ekz>
        granda kaj bela estis la pre&gcirc;ejo, <tld lit="S"/>oj kaj
        Holandanoj konstruis &gcirc;in anta&ubreve; kelke da jarcentoj
        <fnt>
          <bib>Fab4</bib>
          <lok>Historio el la dunoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        nordirlandanoj miris, ke nekatolikaj <tld/>oj parolas la
        <tld/>an varianton de la gaela
        <fnt>
          <bib>Monato</bib>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2006/009069.php">Lingvoj,
          komunumoj kaj politiko</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        en la simpla frazo &leftquot;<nac>Can I land?</nac>&rightquot; (&leftquot;&Ccirc;u mi rajtas/povas
        alteri&gcirc;i?&rightquot;),
        &ccirc;iu el la tri vortoj estos malsame prononcata de, ekzemple,
        sudanglo,
        nordanglo, <tld/>o, nordusonano, sudusonano, a&ubreve;straliano,
        baratano (hindo), ktp
        <fnt>
          <aut>Garbhan MacAoidh</aut>
            <vrk><url ref="&Monato;/2000/007159.php">Flugilhavaj vortoj</url></vrk>
            <bib>Monato</bib>
            <lok>2000/10, p. 22</lok>
          </fnt>;
      </ekz>
      <ekz>
        <nom>Jeanie Johnson</nom> tiam estis konsiderata kiel modela
        &scirc;ipo,
        tiun vel&scirc;ipon, kiu tenis 700 tonelojn, konstruis <tld/>o en 1847
        en Kebekio
        <fnt>
          <bib>Monato</bib>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2004/008277.html">Renaski&gcirc;o
          de vel&scirc;ipo Jeanie Johnson</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_sh;&c_a;&c_t;&c_l;&c_ja;&c_n;&c_mol;&c_d;&c_z;&c_je;&c_c;</trd>
  <trd lng="bg">&c_sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;&c_je;&c_c;</trd>
  <trd lng="ca">escoc&eacute;s</trd>
  <trd lng="cs">Skot</trd>
  <trd lng="cv">&c_sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;</trd>
  <trd lng="de">Schotte</trd>
  <trd lng="en">Scot</trd>
  <trd lng="es">escoc&eacute;s</trd>
  <trd lng="fr">Ecossais<klr> (habitant)</klr></trd>
  <trd lng="fy">Skot</trd>
  <trd lng="ja">&#12473;&#12467;&#12483;&#12488;&#12521;&#12531;&#12489;&#20154;
  <pr>&#12473;&#12467;&#12483;&#12488;&#12521;&#12531;&#12489;&#12376;&#12435;</pr></trd>
  <trd lng="nl">Schot</trd>
  <trd lng="pl">Szkot</trd>
  <trd lng="sk">&Scaron;k&oacute;t</trd>
  <trd lng="uk">&c_sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;&c_je;&c_c;&c_mol;</trd>
  <trd lng="vo">Skot&auml;nan</trd>
</drv>

<drv mrk="skot.0a">
  <kap><ofc>10</ofc><tld/>a</kap>
  <snc>
    <dif>
      Rilata al <tld/>oj a&ubreve; <tld lit="S"/>lando.
    </dif>
  </snc>
  <trd lng="be">&c_sh;&c_a;&c_t;&c_l;&c_ja;&c_n;&c_d;&c_z;&c_k;&c_ib;</trd>
  <trd lng="ca">escoc&eacute;s</trd>
  <trd lng="de">schottisch</trd>
  <trdgrp lng="en">
    <trd>Scottish</trd>,
    <trd>Scots</trd>,
    <trd>Scotch</trd>
  </trdgrp>
  <trd lng="es">escoc&eacute;s</trd>
  <trd lng="fr">&eacute;cossais<klr> (adj.)</klr></trd>
  <trd lng="fy">Skotsk</trd>
  <trdgrp lng="ja">
    <trd>&#12473;&#12467;&#12483;&#12488;&#12521;&#12531;&#12489;&#12398;
    <pr>&#12377;&#12371;&#12387;&#12392;&#12425;&#12435;&#12393;&#12398;</pr></trd>,
    <trd>&#12473;&#12467;&#12483;&#12488;&#12521;&#12531;&#12489;&#35486;&#12398;
    <pr>&#12473;&#12467;&#12483;&#12488;&#12521;&#12531;&#12489;&#12372;&#12398;</pr></trd>
  </trdgrp>
  <trd lng="nl">Schots</trd>
  <trd lng="pl">szkocki</trd>
  <trd lng="uk">&c_sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
  <trd lng="vo">Skot&auml;nik</trd>
</drv>

<drv mrk="skot.0lando">
  <kap><ofc>10</ofc>
    <tld lit="S"/>lando
    <fnt><bib>RLN</bib></fnt>,
    <var><kap><tld lit="S"/>ujo</kap></var>
  </kap>
  <snc mrk="skot.0lando.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="lst" lst="voko:regionoj" cel="land.0o.GEOG">Lando</ref>
      en la norda parto de <ref tip="prt" cel="briti.B0o.insulo">Britio</ref>
      kun <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&ccirc;efurbo</ref>
       <ref tip="prt" cel="edinburg.0o">Edinburgo</ref>; parto de
       <ref tip="malprt" cel="brit.B0ujo">Britujo</ref>:
      <ekz>
        multe da tempo la <esc>multeokupita</esc> generacio dedi&ccirc;as al
        la grandaj Anglujo kaj <tld lit="S"/>ujo
        <fnt>
          <bib>Fab3</bib>
          <lok>Post jarmiloj</lok>
        </fnt>;
      </ekz>
      <ekz>
        ekde la resta&ubreve;ro en 1997 de la <tld/>a parlamento oni konstatas
        en <tld lit="S"/>lando renovigitan intereson pri la aparta
        nacieco kaj pri la indi&gcirc;enaj lingvoj de la <tld/>oj
        <fnt>
          <bib>Monato</bib>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2007/009227.php">Lingva
          diverseco</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      La nomo estas gentobaza<fnt>AdE</fnt>, sed oni ofte uzas la
      finvorton -land anstata&ubreve; -uj/-i pro internacieco a&ubreve;
      Esperanta tradicio.
    </rim>
    </snc>
    <trd lng="be">&c_Sh;&c_a;&c_t;&c_l;&c_ja;&c_n;&c_d;&c_y;&c_ja;</trd>
    <trd lng="bg">&c_Sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;&c_i;&c_ja;</trd>
    <trd lng="ca">Esc&ograve;cia</trd>
  <trd lng="cv">&c_Sh;&c_o;&c_t;&c_l;&c_a;&c_n;&c_d;&c_i;</trd>
  <trd lng="de">Schottland</trd>
    <trd lng="en">Scotland</trd>
    <trd lng="es">Escocia</trd>
    <trd lng="fr">Ecosse</trd>
    <trd lng="fy">Skotl&acirc;n</trd>
    <trd lng="nl">Schotland</trd>
    <trd lng="pl">Szkocja</trd>
    <trd lng="pt">Esc&oacute;cia</trd>
    <trd lng="vo">Skot&auml;n</trd>
  <trdgrp lng="zh">
    <trd>&#33487;&#26684;&#20848; <pr>S&#363;g&eacute;l&aacute;n</pr></trd>,
    <trd>&#34311;&#26684;&#34349; <pr>S&#363;g&eacute;l&aacute;n</pr></trd>
  </trdgrp>
</drv>
</art>

