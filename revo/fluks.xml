<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: fluks.xml,v 1.1 2026/11/09 07:06:25 afido Exp $">
    <kap>
      <rad>fluks</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="fluks.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">FIZ</uzo>
  <snc mrk="fluks.0o.FIZ">
    <dif>
      Fizika grando rezultanta el la produkto de vektora kampo kun surfaco:
      <ekz>
        elektra <tld/>o, magneta <tld/>o
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=2949"
              >Ekvacioj de Maxwell</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        la skalara flukso de vektora kampo tra areo <frm am="A">A</frm> kalkuli&gcirc;as kiel
        <frm am="\Phi=\int \vec{F}\cdot d\vec{A}">&Phi;&#x20D7;=&#x222B;F&#x20D7;&#x22C5;dA&#x20D7;</frm>;
      </ekz>
      <ekz>
        kun la homogena <tld/>o-distribuo kiel enpa&scirc;a limkondi&ccirc;o, anka&ubreve; la malsupra
        baseno estas kalkulebla klasikmetode
        <fnt>
          <bib>SR</bib>
          <aut>Ott&oacute; Haszpra</aut>
          <vrk>Modeleksperimentoj pri Hidroteknikaj Objektoj de Montara Akvorezervejo</vrk>
          <lok>Scienca Revuo, nro 179/1999</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/d/d2/Flux_density.svg"
      prm="CC0"
      lrg="330"
      >bildigo de <tld/>o tra areo
        <fnt>
          <aut>Debenben, propra verko</aut>
          <lok><url ref="&WCW;/File:Flux_density.svg"
              >https://commons.wikimedia.org/wiki/File:Flux_density.svg</url></lok>
        </fnt>
    </bld>
    <trd lng="da">flux</trd>
    <trd lng="de">Fluss <klr>(Physik)</klr></trd>
    <trd lng="en">flux</trd>
    <trd lng="fr">flux <klr>(physique)</klr></trd>
    <trd lng="ru">&c_p;&c_o;&c_t;&c_o;&c_k; &c_v;&c_je;&c_k;&c_t;&c_o;&c_r;&c_n;&c_o;&c_g;&c_o; &c_p;&c_o;&c_l;&c_ja;</trd>
    <trd lng="uk">&c_p;&c_o;&c_t;&c_ib;&c_k; &c_v;&c_je;&c_k;&c_t;&c_o;&c_r;&c_n;&c_o;&c_g;&c_o; &c_p;&c_o;&c_l;&c_ja;</trd>
  </snc>
</drv>

  </art>


