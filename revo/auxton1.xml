<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: auxton1.xml,v 1.27 2026/11/07 21:47:32 revo Exp $">
<kap>
  <rad>a&ubreve;tonomi</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="auxton1.0o">
  <kap><tld/>o</kap>
  <snc mrk="auxton1.0o.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="dif" cel="auxton.0eco.POL">A&ubreve;tonomeco</ref>:
      <ekz>
        la Irlanda Respubliko agnoskis la <tld/>on de Skotlando per vizito
        de la ministro pri eksterlandaj aferoj &ccirc;e la nova skota
        &ccirc;efministro
        <fnt><aut>Irl</aut>,
        <vrk><url ref="&Monato;/1999/monato199907.pdf#page=6">Historia pa&scirc;o</url></vrk>,
        <bib>Monato</bib>,
        <lok>1999/07, p. 6</lok></fnt>.
      </ekz>
      <ekz>
        kroatoj <klr>[&#8230;]</klr> &gcirc;is 1918 havis kadre de hungara, poste a&ubreve;strohungara
        &scirc;tato fortan <tld/>on
        <fnt>
	<aut>Zlatko Ti&scaron;ljar</aut>
	<vrk><url ref="&Monato;/2000/006811.php">Nekredeblaj malveroj</url></vrk>
	<bib>Monato</bib>
	<lok>2000/03, p. 12-13</lok>
        </fnt>;
      </ekz>
      <ekz>
        en Sovetio ili havis du <tld/>ajn regionojn: Nord-Osetio ene de Rusio kaj
        Sud-Osetio kadre de Kartvelio
        <fnt>

          <aut>Vja&ccirc;eslav (Slavik) Ivanov</aut>
          <vrk><url ref="&Monato;/2003/007865.html">La oseta lingvo</url></vrk>
           <bib>Monato</bib>
           <lok>2003/01, p. 24</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="zh">
      <trd>&#x81EA;&#x6CBB;&#26435; <pr>z&igrave;zh&igrave;qu&aacute;n</pr></trd>,
      <trd>&#x81EA;&#x6CBB;&#x6B0A; <pr>z&igrave;zh&igrave;qu&aacute;n</pr></trd>,
      <trd>&#x81EA;&#x4E3B; <pr>z&igrave;zh&#x1D4;</pr></trd>,
      <trd>&#x81EA;&#x7D66;&#x81EA;&#x8DB3; <pr>z&igrave;j&#x1D0;z&igrave;z&uacute;</pr></trd>,
      <trd>&#x81EA;&#x7ED9;&#x81EA;&#x8DB3; <pr>z&igrave;j&#x1D0;z&igrave;z&uacute;</pr></trd>
    </trdgrp>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>memstareco</ke>, <ke>memregeco</ke>.
  </rim>

  <trd lng="be">&c_a;&c_w;&c_t;&c_a;&c_n;&c_o;&c_m;&c_ib;&c_ja;</trd>
  <trd lng="ca">autonomia</trd>
  <trdgrp lng="de">
    <trd>Autonomie</trd>,
    <trd>Selbst&auml;ndigkeit</trd>,
    <trd>Unabh&auml;ngigkeit</trd>
  </trdgrp>
  <trd lng="en">autonomy</trd>
  <trd lng="es">autonom&iacute;a</trd>
  <trd lng="fr">autonomie</trd>
  <trd lng="he">&alef;&vav;&tet;&vav;&nun;&vav;&mem;&yod;&he;</trd>
  <trd lng="hu">auton&oacute;mia</trd>
  <trd lng="it">autonomia</trd>
  <trd lng="nl">autonomie</trd>
  <trdgrp lng="pl">
    <trd>autonomia</trd>,
    <trd>samorz&aogonek;d</trd>
  </trdgrp>
  <trd lng="ro">autonomie</trd>
  <trd lng="ru">&c_a;&c_v;&c_t;&c_o;&c_n;&c_o;&c_m;&c_i;&c_ja;</trd>
  <trdgrp lng="uk">
    <trd>&c_a;&c_v;&c_t;&c_o;&c_n;&c_o;&c_m;&c_ib;&c_ja;</trd>,
    <trd>&c_a;&c_v;&c_t;&c_o;&c_n;&c_o;&c_m;&c_n;&c_ib;&c_s;&c_t;&c_mol;</trd>
  </trdgrp>
</drv>

<drv mrk="auxton1.0a">
  <kap>
    <tld/>a
  </kap>
  <snc mrk="auxton1.0a.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      <ref tip="dif" cel="auxton.0a.POL">A&ubreve;tonoma<sncref/></ref>:
      <ekz>
        E&ubreve;skio estas unu el la <tld/>aj komunumoj, kiuj konsistigas la hispanan regnon
        kaj havas apartan nacian flagon krom la &scirc;tata
        <fnt>

          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2004/008271.html"
              >Flagoj: fenestro al vasta mondo</url></vrk>
              <bib>Monato</bib>
          <lok>2004/04, p. 16</lok>
        </fnt>;
      </ekz>
      <ekz>
        en Sovetio <klr>[osetoj]</klr> havis du <tld/>ajn regionojn: Nord-Osetio ene de Rusio kaj
        Sud-Osetio kadre de Kartvelio
        <fnt>

          <aut>Vja&ccirc;eslav (Slavik) Ivanov</aut>
          <vrk><url ref="&Monato;/2003/007865.html"
              >La oseta lingvo</url></vrk>
               <bib>Monato</bib>
          <lok>2003/01, p. 24</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">autonom</trd>
  <trd lng="en">autonomous</trd>
  <trd lng="fr">autonome</trd>
  <trd lng="nl">autonoom</trd>
</drv>

</art>
