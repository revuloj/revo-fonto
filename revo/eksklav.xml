<vortaro>
  <art mrk="$Id: eksklav.xml,v 1.2 2026/08/07 17:07:06 afido Exp $">
    <kap>
      <rad>eksklav</rad>/o
    </kap>

<drv mrk="eksklav.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      Parto de &scirc;tato a&ubreve; alia politika unuo apartigita de la &ccirc;efa teritorio,
      kaj atingebla nur tra fremda teritorio:
      <ekz>
        <tld/>o tute enfermita de alia &scirc;tato, el ties perspektivo estas
        <ref tip="sub" cel="enklav.0o">enklavo</ref>;
      </ekz>
      <ekz>
        post la dissolvo de Sovetunio, Kaliningrada regiono i&gcirc;is <tld/>o de Ruslando
        <fnt>
          <bib>LOdE</bib>
          <aut>Halina Gorecka</aut>
          <vrk><url ref="https://sezonoj.ru/2015/12/gorecka-4/"
              >Pa&gcirc;oj el la historio de la Sukcena Lando</url></vrk>
          <lok>2015-12-28</lok>
        </fnt>;
      </ekz>
      <ekz>
        la transmara havena areo de <nom>Bremen</nom>, <nom>Bremerhaven</nom>,
        estas <tld/>o de la urbo <nom>Bremen</nom>
        <fnt>
          <vrk><url ref="https://www.esperanto.de/eo/node/3767"
              >Bremeno</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Exklave</trd>
    <trd lng="en">exclave</trd>
    <trd lng="ru">&c_e;&c_k;&c_s;&c_k;&c_l;&c_a;&c_v;</trd>
  </snc>
<trd lng="id">eksklave</trd>
</drv>

  </art>

