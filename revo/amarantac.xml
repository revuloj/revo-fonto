<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: amarantac.xml,v 1.1 2026/08/12 14:03:30 afido Exp $">
    <kap>
      <rad>amarantac</rad>/oj
    </kap>

<drv mrk="amarantac.0oj">
  <kap><tld/>oj</kap>
  <uzo tip="fak">BOT</uzo>
  <snc>
    <dif>
      <ref tip="lst" lst="voko:botanikaj_familioj" cel="famili.0o.BIO">Familio</ref> de
      <ref tip="malprt" cel="kotile.du0aj">dukotiledonaj</ref>
      herboj (<trd lng="la">Amaranthaceae</trd>), al kiu apartenas
      <ref tip="prt" cel="amaran.0o">amaranto</ref>, <ref tip="prt" cel="bet.0o.genro">beto</ref>,
      <ref tip="prt" cel="kvino.0o">kvinoo</ref>, <ref tip="prt" cel="spinac.0o.genro">spinaco</ref>:
      <ekz>
        &scirc;i man&gcirc;is <klr>[&#x2026;]</klr> kvinoon (herbecan jaran planton de la familio <tld/>oj
        kultivatan precipe pro la grajnoj ri&ccirc;aj je proteinoj)
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2015/011521.php"
              >Festanta la revenon de Astrosamantha</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Fuchsschwanzgew&auml;chse</trd>
    <trd lng="en">Amaranthaceae</trd>
    <trd lng="fr">Amaranthaceae</trd>
    <trdgrp lng="ru">
      <trd>&c_A;&c_m;&c_a;&c_r;&c_a;&c_n;&c_t;&c_o;&c_v;&c_y;&c_je;</trd>,
      <trd>&c_Shch;&c_i;&c_r;&c_i;&c_c;&c_je;&c_v;&c_y;&c_je;</trd>
    </trdgrp>
  </snc>
</drv>

  </art>

