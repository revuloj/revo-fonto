<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: vulkanologi.xml,v 1.1 2026/08/09 16:53:23 afido Exp $">
<kap>
    <rad>vulkanologi</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="vulkanologi.0o">
  <kap><tld/>o</kap>
  <snc mrk="vulkanologi.0o.GEOL">
    <uzo tip="fak">GEOL</uzo>
    <dif>
      Scienco pri <ref tip="vid" cel="vulkan.0o">vulkanoj</ref>:
      <ekz>
        inter grizaj amasoj da magmo, solidi&gcirc;inta neniu scias kiam,
        blanki&gcirc;is <klr>[&#8230;]</klr> kupoloj de <tld/>a stacio
        <fnt>
          <aut>A. Strugackij, B. Strugackij, trad. A. Kerbel</aut>
          <vrk><url ref="https://verkoj.com/dn/kerbel/Krimintenculoj.pdf">
          Krimintenculoj</url></vrk>
          <lok>2014</lok>
        </fnt>;
      </ekz>
      <ekz>
        profesoro en la Instituto de <tld lit="V"/>o, Romo, per artikoloj, monografioj kaj
        organizado de konferencoj
        <klr>[&#8230;]</klr> alportis multe da fakta materialo
        <fnt>
          <aut>V. Shehu</aut>
          <vrk><url ref="https://scienca-revuo.info/files/51-1-190-1-10-20140415.pdf">
          La dinamismo kaj kresko de la tero pro sia transformebla kerno de la nukleo</url></vrk>
          <lok>Scienca Revuo, 2014, 2/64, p. 63-79a</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="fr">volcanologie</trd>
</drv>
</art>


