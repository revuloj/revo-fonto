<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: toskan.xml,v 1.11 2026/09/20 16:00:46 revo Exp $">
<kap>
  <rad>toskan</rad>/o <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="toskan.0o">
  <kap><tld/>o</kap>
  <snc mrk="toskan.0o.logxanto">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Lo&gcirc;anto de <ref tip="malprt" cel="toskan.0ujo.GEOG">Toskanujo</ref>:
      <ekz>
        la <tld/>oj organizis enlandajn ekzamenojn
        <fnt>
          <aut>Gianantonio Pfleger</aut>
          <vrk><url ref="https://tempa.bitarkivo.org/gazetoj/EsperigaKomunikoEKO/EKO_2022_n65_nov.pdf"
              >Toskanaj tagoj</url></vrk>
          <lok>EKO 2022-11-25</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La nomo originas en la latina vorto <nac>Tusci</nac>, per kiu la romanoj nomis la
    <ref cel="etrusk.0o">etrusko</ref>jn.
    Majuskle oni trovas la vorton anka&ubreve; uzata kiel la nomo la itala regiono.
    <aut>Wolfram Diestel</aut>
  </rim>
  <trd lng="be">&c_t;&c_a;&c_s;&c_k;&c_a;&c_n;&c_je;&c_c;</trd>
  <trd lng="ca">tosc&agrave;<klr> (subst.)</klr></trd>
  <trd lng="de">Toskaner</trd>
  <trd lng="en">Tuskanian</trd>
  <trd lng="fr">toscan<klr> (subst. personne)</klr></trd>
  <trd lng="it">toscano</trd>
  <trd lng="ja">&#x30C8;&#x30B9;&#x30AB;&#x30CA;&#x4EBA;  <pr>&#x30C8;&#x30B9;&#x30AB;&#x30CA;&#x3058;&#x3093;</pr></trd>
  <trd lng="pl">Toska&nacute;czyk</trd>
  <trd lng="uk">&c_t;&c_o;&c_s;&c_k;&c_a;&c_n;&c_je;&c_c;&c_mol;</trd>
</drv>

<drv mrk="toskan.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      Rilata al <tld/>oj a&ubreve; al <tld lit="T"/>ujo.
      <ekz>
        <tld/>a literaturo;
      </ekz>
      <ekz>
        la itala komuna lingvo havas sian bazon en la <tld/>a lingvo,
        kiun kreis kaj evoluigis la kulturaj rondoj de Florenco
        <fnt>
          <bib>Ret</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Don</nom> Ki&hcirc;oto &#xAD; konas iom da <tld/>a lingvo, kaj mi e&ccirc; povas deklami kelkajn
        stancojn de Ariosto
        <fnt>
          <bib>DKM</bib>
          <lok>&Ccirc;apitro LXII</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_t;&c_a;&c_s;&c_k;&c_a;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">tosc&agrave;<klr> (adj.)</klr></trd>
  <trd lng="de">toskanisch</trd>
  <trd lng="en">Tuskanian</trd>
  <trd lng="fr">toscan<klr> (adj.)</klr></trd>
  <trd lng="it">toscano <klr>(adj)</klr></trd>
  <trd lng="pl">toska&nacute;ski</trd>
  <trd lng="uk">&c_t;&c_o;&c_s;&c_k;&c_a;&c_n;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
</drv>

<drv mrk="toskan.0ujo">
  <kap><tld lit="T"/>ujo</kap>
  <snc mrk="toskan.0ujo.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
     Provinco en centra <ref tip="malprt" cel="ital.I0ujo">Italujo</ref>
     kun &ccirc;efurbo <ref tip="prt" cel="florenc.0o">Florenco</ref>:
     <ekz>
        en <tld lit="T"/>ujo la papa amnestio efikis e&ccirc; registaron
        <fnt>
          <aut>Etelo Liliano Vojni&ccirc;, trad. Vladimir Okc</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/0186/0010.php"
              >Ojstro</url></vrk>
          <lok>&Ccirc;apitro 1: Pasis dek tri jaroj</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_T;&c_a;&c_s;&c_k;&c_a;&c_n;&c_a;</trd>
  <trd lng="ca">la <ind>Toscana</ind></trd>
  <trd lng="de">Toskana</trd>
  <trd lng="en">Tuscany</trd>
  <trd lng="fr">Toscane</trd>
  <trd lng="it">Toscana</trd>
  <trd lng="pl">Toskania</trd>
</drv>
</art>

