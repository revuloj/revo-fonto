<drv mrk="vilagx.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="vilagx.0o.ARKI">
    <uzo tip="fak">ARKI</uzo>
    <dif>
      Malgranda aro da domoj en kamparo, montaro...:
      <ekz>
        fi&scirc;ista <tld/>o
        <fnt>
          <bib>Lasta</bib>
          <lok>La Lasta</lok>
        </fnt>;
      </ekz>
      <ekz>
        malgranda <tld/>o kro&ccirc;i&gcirc;is al la deklivo de l&#x2019; monto
        <fnt>
          <bib>IKr</bib>
          <lok>La Miraklo De Purun Bhagat</lok>
        </fnt>;
      </ekz>
      <ekz>
        Jesuo trairis &ccirc;iujn urbojn kaj <tld/>ojn, instruante en iliaj sinagogoj
        <fnt>
          <bib>NT</bib>
          <lok>Mateo 9:35</lok>
        </fnt>;
      </ekz>
      <ekz>
        miaj gepatroj vivas en montara <tld/>o
        <fnt>
          <bib>Kon11</bib>
          <lok>Saluton, Nepalo! (Flama Floro)</lok>
        </fnt>;
      </ekz>
      <ekz>
        pli facile estas perdi <tld/>on, ol akiri domon
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="komun.0umo.distrikto">komunumo<sncref/></ref>,
      <ref tip="hom" cel="urb.0eto">urbeto</ref>
    </refgrp>
