  <trd lng="hu">falusi</trd>
  <trd lng="ja">&#x6751;&#x6C11;  <pr>&#x305D;&#x3093;&#x307F;&#x3093;</pr></trd>
  <trdgrp lng="pl">
    <trd>ch&lstroke;op</trd>,
    <trd>wie&sacute;niak</trd>,
    <trd>w&lstroke;o&sacute;cianin</trd>
  </trdgrp>
  <trd lng="ru">&c_k;&c_r;&c_je;&c_s;&c_t;&c_mol;&c_ja;&c_n;&c_i;&c_n;</trd>
  <trd lng="uk">&c_s;&c_je;&c_l;&c_ja;&c_n;&c_i;&c_n;</trd>
