<drv mrk="vilagx.0ano">
  <kap><ofc>*</ofc><tld/>ano</kap>
  <snc mrk="vilagx.0ano.KOMUNE">
    <dif>
      Lo&gcirc;anto de <tld/>o:
      <ekz>
        <tld/>ano en blanka frisa surtuto
        <fnt>
          <bib>Fab3</bib>
          <lok>Historio de la jaro</lok>
        </fnt>;
      </ekz>
      <ekz>
        unu bu&scirc;elon li ricevis jam anta&ubreve;e de la <tld/>ano
        <fnt>
          <bib>Fab1</bib>
          <lok>Malgranda Niko kaj granda Niko</lok>
        </fnt>;
      </ekz>
      <ekz>
        virino <klr>[&#x2026;]</klr> vestita en ordinara vesto de rusa
        <tld/>anino
        <fnt><bib>Voja&gcirc;Imp</bib>, <lok>du blinduloj, sceno el la lando
        de Donaj kozakoj</lok></fnt>;
      </ekz>
      <ekz>
        li kaptas nobeleton, kiu senfeligas siajn <tld/>anojn kiel bruton
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>ano kreditas, <tld/>estro pruntas
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="kamp.0arano.AGR">kamparano</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_s;&c_je;&c_l;&c_ja;&c_n;&c_ib;&c_n;</trd>
  <trd lng="bg">&c_s;&c_je;&c_l;&c_ja;&c_n;&c_i;&c_n;</trd>
  <trd lng="ca">poblet&agrave;</trd>
  <trd lng="de">Dorfbewohner</trd>
