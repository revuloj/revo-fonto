<drv mrk="vilagx.sam0ano">
  <kap>sam<tld/>ano</kap>
  <snc mrk="vilagx.sam0ano.KOMUNE">
    <dif>
      Lo&gcirc;anto, devenanto de sama <tld/>o:
      <ekz>
        sekve, vi estas mia sam<tld/>ano? el <nom>Nikolskoje</nom>
        <fnt>
          <bib>Metrop</bib>
        </fnt>?
      </ekz>
      <ekz>
        Leo <nom>Broadbent</nom> forte malamas sian sam<tld/>anon
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro XII</lok>
        </fnt>;
      </ekz>
      <ekz>
        li estis <klr>[&#x2026;]</klr> sam<tld/>ano, iam, anta&ubreve; longaj jaroj
        li forlasis la vila&gcirc;on por labori en la urba fabriko
        <fnt>
          <aut>J. Baghy</aut>,
          <vrk><url ref="http://www.egalite.hu/baghy/dancu/tri%20kamaradoj.htm">
          Tri Kamaradoj</url></vrk>,
          <lok>en: Dancu Marionetoj!, 1933</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_d;&c_n;&c_a;&c_v;&c_ja;&c_s;&c_k;&c_o;&c_v;&c_je;&c_c;</trd>,
    <trd>&c_a;&c_d;&c_n;&c_a;&c_s;&c_je;&c_l;&c_je;&c_c;</trd>
  </trdgrp>
  <trd lng="de">Dorfgenosse</trd>
  <trd lng="fr">pays<klr> (du m&ecirc;me village)</klr></trd>
  <trd lng="pl">kolega z tej samej <ind>wsi</ind></trd>
  <trdgrp lng="uk">
    <trd>&c_o;&c_d;&c_n;&c_o;&c_s;&c_je;&c_l;&c_je;&c_c;&c_mol;</trd>,
    <trd>&c_zh;&c_i;&c_t;&c_je;&c_l;&c_mol; &c_t;&c_o;&c_g;&c_o; &c_zh; &c_s;&c_je;&c_l;&c_a;</trd>,
    <trd>&c_z;&c_je;&c_m;&c_l;&c_ja;&c_k;</trd>
  </trdgrp>
</drv>
