<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ermen.xml,v 1.26 2026/08/28 16:00:21 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>ermen</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="ermen.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
     Tre malgranda <ref tip="lst" cel="best.rabo0o" lst="voko:rabobestoj">rabobesto</ref> kun vintra
     felo tute blanka
     krom la nigra vostopinto; dum mezepoko la pelton rajtis uzi en siaj
     vestoj nur kavaliroj kaj doktoroj; 
     <ref tip="lst" cel="speci.0o.BIO" lst="voko:zoologiaj_specioj">specio</ref> de <ref tip="super"
     cel="mustel.0o">mustelo</ref>
    (<trd lng="la">Mustela erminea</trd>):
      <ekz>
        <tld/>oj, leporoj kaj lagopoj en la francaj Alpoj, samkiel en la ekstrema nordo
        de E&ubreve;ropo, &scirc;an&gcirc;as siajn kolorojn por adapti&gcirc;i al la la&ubreve;sezone &scirc;an&gcirc;i&gcirc;anta medio
        <fnt>
          <bib>Monato</bib>
          <aut>Saliko</aut>
          <vrk><url ref="&Monato;/2005/008395.php">Vizito al la nacia parko Vanoise</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <bld lok="&WCU;/thumb/2/2f/Mustela_erminea_3.jpg/500px-Mustela_erminea_3.jpg" prm="CC BY-SA    
    2.0"><tld/>o en Himalajo, Norda Barato
        <fnt>
          <aut>soumyajit nandy el Kolkata, India, Stoat | Jispa, Himachal Pradesh</aut>
          <lok><url
          ref="&WCW;/File:Mustela_erminea_3.jpg">&WCW;/File:Mustela_erminea_3.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="de">Hermelin</trd>
    <trd lng="en">ermine</trd>
    <trd lng="fr">hermine</trd>
    <trd lng="hu">hermelin</trd>
    <trd lng="id">cerpelai</trd>
    <trd lng="nl">hermelijn</trd>
    <trd lng="pl">gronostaj</trd>
    <trd lng="pt">arminho</trd>
    <trd lng="ru">&c_g;&c_o;&c_r;&c_n;&c_o;&c_s;&c_t;&c_a;&c_j;</trd>
  </snc>
  <trd lng="be">&c_g;&c_a;&c_r;&c_n;&c_a;&c_s;&c_t;&c_a;&c_j;</trd>
  <trd lng="ca">ermini</trd>
  <trd lng="cs">hranostaj</trd>
  <trdgrp lng="ja">
    <trd>&#12458;&#12467;&#12472;&#12519;</trd>,
    <trd>&#12456;&#12478;&#12452;&#12479;&#12481;</trd>,
    <trd>&#12450;&#12540;&#12511;&#12531;</trd>
  </trdgrp>
  <trd lng="sk">hranostaj</trd>
  <trdgrp lng="uk">
    <trd>&c_g;&c_o;&c_r;&c_n;&c_o;&c_s;&c_t;&c_a;&c_j;</trd>,
    <trd>&c_g;&c_o;&c_r;&c_n;&c_o;&c_s;&c_t;&c_a;&c_j; (&c_h;&c_u;&c_t;&c_r;&c_o;)</trd>,
    <trd>&c_g;&c_je;&c_r;&c_a;&c_l;&c_mol;&c_d;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#27861;&#23448;&#32844;&#20301; <pr>f&#462;gu&#257;nzh&iacute;w&egrave;i</pr></trd>,
    <trd>&#40746; <pr>sh&#275;ng</pr></trd>
  </trdgrp>
</drv>
</art>
