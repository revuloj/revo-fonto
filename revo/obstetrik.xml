<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: obstetrik.xml,v 1.1 2026/09/19 17:15:15 afido Exp $">
    <kap>
      <rad>obstetrik</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="obstetrik.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc>
    <dif>
      <ref tip="dif" cel="akusx.0arto.MED">Aku&scirc;arto</ref>, naskofako:
      <ekz>
        la <tld/>o mencias nur sep a&ubreve; ok tiajn kazojn de vira gravedeco
        <fnt>
          <bib>KrB</bib>
          <lok>E&ccirc; inter piuloj ne mankas pekuloj</lok>
        </fnt>;
      </ekz>
      <ekz>
        bazaj kuracistoj kiel anestezistoj, <tld/>istoj kaj kirurgoj
        <fnt>
          <bib>Monato</bib>
          <aut>Julius Hauser</aut>
          <vrk><url ref="&Monato;/2012/010575.php"
              >Kuracisto-krizo</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        la <tld/>istoj kaj aku&scirc;istinoj evidente timis, ke, se ili abortigus la feton,
        ili estos jure persekutitaj
        <fnt>
          <bib>Monato</bib>
          <aut>Garvan Makaj</aut>
          <vrk><url ref="&Monato;/2013/011081.php"
              >Astrobiologio kaj religio</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">obstetr&iacute;cia</trd>
    <trdgrp lng="de">
      <trd>Obstetrik</trd>,
      <trd>Tokologie</trd>
    </trdgrp>
    <trd lng="fr">obst&eacute;trique</trd>
    <trd lng="id">obstetri</trd>
  </snc>
</drv>

  </art>


