<drv mrk="egal.0a">
  <kap><ofc>*</ofc><tld/>a</kap>
  <snc mrk="egal.0a.MEZ">
    <dif>
      Havanta saman grandon, samajn dimensiojn, saman kvanton,
      saman valoron, kiel tio, kun kio oni &gcirc;in komparas:
      <ekz>
        du kvantoj, <tld/>aj je tria, <tld/>as unu la alian;
      </ekz>
      <ekz>
        nenio, kion oni povas deziri, povas esti <tld/>a al sa&gcirc;o
        <fnt><bib>MT</bib>, <lok>&Sen; 8:11</lok></fnt>;
      </ekz>
      <ekz>
        ne respondu al malsa&gcirc;ulo, por ke vi mem ne
        fari&gcirc;u <tld/>a al li
        <fnt><bib>MT</bib>, <lok>&Sen; 26:4</lok></fnt>;
      </ekz>
      <ekz>
        ne<tld/>aj peziloj
        <fnt><bib>MT</bib>, <lok>&Sen; 20:23</lok></fnt>.
      </ekz>
      <trdgrp lng="pl">
        <trd>jednakowy</trd>,
        <trd>r&oacute;wny</trd>,
        <trd>taki sam</trd>
      </trdgrp>
    </dif>
    <subsnc mrk="egal.0a.nevaria">
      <dif>
        Restanta sama, kia &gcirc;i mem estis anta&ubreve;e, ne varianta
        kiaj ajn estas la cirkonstancoj:
        <ekz>
          <tld/>a animo;
        </ekz>
        <ekz>
          <tld/>a humoro, pulso, vo&ccirc;o;
        </ekz>
        <ekz>
          ta&ccirc;mentoj, kies <tld/>aj pa&scirc;oj similis frapojn de pezaj marteloj
          <fnt>
            <bib>Far1</bib>
            <lok>&Ccirc;apitro I</lok>
          </fnt>.
        </ekz>
      </dif>
      <refgrp tip="vid">
         <ref cel="konsta.0a">konstanta</ref>,
         <ref cel="indife.0a">indiferenta</ref>,
         <ref cel="monoto.0a.unutona">monotona<sncref/></ref>
      </refgrp>
      <trdgrp lng="de">
        <trd>gleichm&auml;&szlig;ig</trd>,
        <trd>gleichf&ouml;rmig</trd>
      </trdgrp>
      <trdgrp lng="pl">
        <trd>taki sam</trd>,
        <trd>r&oacute;wny</trd>
      </trdgrp>
      <trdgrp lng="pt">
        <trd>igual</trd>,
        <trd>parelho</trd>
      </trdgrp>
      <trdgrp lng="ru">
        <trd>&c_o;&c_d;&c_n;&c_o;&c_o;&c_b;&c_r;&c_a;&c_z;&c_n;&c_y;&c_j;</trd>,
        <trd>&c_r;&c_o;&c_v;&c_n;&c_y;&c_j;</trd>
      </trdgrp>
    </subsnc>
    <subsnc mrk="egal.0a.senprefera">
      <dif>
        Prezentanta samajn kvalitojn, do nenian motivon por esti
        preferata, t.e. indiferenta:
        <ekz>
          <ind><tld/>e</ind> &ccirc;u vi estas ri&ccirc;a a&ubreve;
          senhava
          <fnt><bib>PV</bib></fnt>;
          <trd lng="ca">igualment</trd>
        </ekz>
        <ekz>
          <tld/>e kiam li venos, kien li iros;
        </ekz>
        <ekz>
          tute <tld/>e &ccirc;u ia prepozicio starus a&ubreve; ne
          <fnt>
            <bib>F</bib>
            <lok>&FE; 28</lok>
          </fnt>.
        </ekz>
      </dif>
      <trdgrp lng="pl">
        <trd>jednaki</trd>,
        <trd>jednakowy</trd>
      </trdgrp>
    </subsnc>
  <trdgrp lng="de">
    <trd>gleichwertig</trd>,
    <trd>ebenb&uuml;rtig</trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd><baz>banding</baz>sebanding</trd>,
    <trd><baz>derajat</baz>sederajat</trd>,
    <trd><baz>imbang</baz>seimbang</trd>,
    <trd><baz>jajar</baz>sejajar</trd>,
    <trd><baz>kufu</baz>sekufu</trd>,
