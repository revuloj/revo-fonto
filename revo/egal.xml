<drv mrk="egal.mal0eco">
  <kap>
    mal<tld/>eco
  </kap>
  <snc>
    <dif>
      Eco, stato de tio, kio estas mal<tld/>a:
      <ekz>
        la sento de mal<tld/>eco transformi&gcirc;as en neklaran senton de envio
        <fnt>
          <bib>Tor</bib>
          <lok>I.</lok>
        </fnt>;
      </ekz>
      <ekz>
        en la menciitaj organiza&jcirc;oj la lingva obstaklo ka&ubreve;zas kontra&ubreve;demokratan
        mal<tld/>econ
        <fnt>
          <bib>EeP</bib>
          <lok>Kvara Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;ia manko al fiksita regulo entenas du malavanta&gcirc;ojn: la juran <klr>[&#8230;]</klr>
        escepton tiamaniere kreitan, kaj la mal<tld/>econ a&ubreve; maljustecon, se poste
        oni revenas al apliko
        <fnt>
          <bib>FSp</bib>
          <lok>Tria Parto: Ligo De Nacioj</lok>
        </fnt>;
      </ekz>
      <ekz>
        la anglalingvaj nacioj sukcesas devigi min sekvi arbitrajn sensenca&jcirc;ojn, kiuj
        kontribuas nenion al glata komunikado, sed multon al mal<tld/>eco inter ni
        <fnt>
          <bib>BonaLingvo</bib>
          <lok>2. La Spirito De La Lingvo</lok>
        </fnt>;
      </ekz>
      <ekz>
        kreskanta proprieta mal<tld/>eco prezentas grandan dan&gcirc;eron por la tutmonda
        ekonomio
        <fnt>
          <bib>Monato</bib>
          <aut>Roland Rotsaert</aut>
          <vrk><url ref="http://steloj.de/esperanto/monato2/007258.html">Mondaj Financoj: Post la
          kunsido de financistoj en Prago</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="just.mal0eco">maljusteco</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_n;&c_ja;&c_r;&c_o;&c_w;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>
  <trd lng="de">Ungleichheit</trd>
  <trd lng="en">inequality</trd>
  <trd lng="fr">in&eacute;galit&eacute;</trd>
  <trdgrp lng="id">
    <trd><baz>tidak</baz>ketidaksetaraan</trd>,
    <trd><baz>timpang</baz>ketimpangan</trd>
  </trdgrp>
  <trd lng="ja">&#19981;&#24179;&#31561;  <pr>&#12405;&#12403;&#12423;&#12358;&#12393;&#12358;</pr></trd>
</drv>

