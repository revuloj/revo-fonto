<drv mrk="egal.0eco">
  <kap>
    <tld/>eco
  </kap>
  <snc>
    <dif>
      Eco, stato de tio, kio estas <tld/>a:
      <ekz>
        ni &ccirc;iuj pekas, suferas kaj mortas, jen estas granda, plena <tld/>eco
        <fnt>
          <bib>IK</bib>
          <lok>&Ccirc;aptiro III</lok>
        </fnt>;
      </ekz>
      <ekz>
        justeco, <tld/>eco kaj frateco inter la popoloj en la praktiko estas plene ebla
        <fnt>
          <bib>Homaranismo</bib>
          <vrk>Dogmoj de Hilelismo</vrk>
        </fnt>;
      </ekz>
      <ekz>
        tiu &ccirc;i <tld/>eco de la nomoj &scirc;in forte ekfrapis
        <fnt>
          <bib>FK</bib>
          <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>eco de la statoj lasas almena&ubreve; al la honoro de edzo la liberecon montri
        siajn sentojn
        <fnt>
          <bib>GDn</bib>
          <lok>Akto Unua</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_r;&c_o;&c_w;&c_n;&c_a;&c_s;&c_mol;&c_c;&c_mol;</trd>
  <trd lng="ca">igualtat</trd>
