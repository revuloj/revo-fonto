<drv mrk="egal.kontraux0a">
  <kap>kontra&ubreve;<tld/>a</kap>
  <uzo tip="fak">MAT</uzo>
  <fnt><bib>MatTerm</bib>, <lok>p. 7</lok></fnt>
  <snc mrk="egal.kontraux0a.MAT">
    <dif>
      <klr>(p.p. du elementoj de <ref cel="grup.0o.MAT">grupo</ref> kun
        adicie signata operacio)</klr>
      Tiaj, ke &ccirc;iu el ili estas
      <ref cel="neuxtr.0iganto.MAT">ne&ubreve;triganto</ref> de la alia.
    </dif>
  </snc>
  <trd lng="be">&c_s;&c_u;&c_p;&c_r;&c_a;&c_c;&c_mol;&c_l;&c_je;&c_g;&c_l;&c_y;</trd>
  <trd lng="ca">oposat<klr> (adj.)</klr></trd>
  <trdgrp lng="de">
    <trd>entgegengesetzt</trd>,
    <trd>entgegengesetzt gleich</trd>,
    <trd>gegengleich</trd>
  </trdgrp>
  <trd lng="en">opposite</trd>
  <trd lng="fr">oppos&eacute;<klr tip="ind"> (math., adj.)</klr></trd>
  <trd lng="he">&lamed;&alef; &shin;&vav;&vav;&yod;&vav;&nun;&yod;</trd>
  <trd lng="hu">ellentett</trd>
  <trd lng="id"><baz>lawan</baz>berlawanan<klr tip="amb"> (matematika)</klr></trd>
  <trd lng="nl">tegengesteld<klr tip="ind"> (wisk.)</klr></trd>
  <trd lng="pl">przeciwny</trd>
  <trd lng="ru">&c_p;&c_r;&c_o;&c_t;&c_i;&c_v;&c_o;&c_p;&c_o;&c_l;&c_o;&c_zh;&c_n;&c_y;&c_j;</trd>
</drv>

<drv mrk="egal.kontraux0o">
  <kap>kontra&ubreve;<tld/>o</kap>
  <uzo tip="fak">MAT</uzo>
  <snc mrk="egal.kontraux0o.MAT">
    <dif>
      <ref cel="neuxtr.0iganto.MAT">Ne&ubreve;triganto</ref> rilate
      al adicie signata <ref cel="operac.0o.MAT">operacio</ref>:
      <ekz>
        &ccirc;iu elemento en adicia grupo havas kontra&ubreve;<tld/>on;
      </ekz>
      <ekz>
        la nulo egalas al sia kontra&ubreve;<tld/>o;
      </ekz>
      <ekz>
        kontra&ubreve;<tld/>o de bildigo <frm am="f"><k>f</k></frm>
        <klr> (la bildigo,
          kiu &jcirc;etas <frm am="x"><k>x</k></frm> al la kontra&ubreve;<tld/>o de
          <frm am="f(x)"><k>f</k>(<k>x</k>)</frm>)</klr>.
      </ekz>
    </dif>
    <rim>
      Ni ne trovis fonton por tiu termino, nek alian terminon por la
      nocio, sed &gcirc;i tre nature derivi&gcirc;as de la a&ubreve;toritata
      <ctl>kontra&ubreve;<tld/>a</ctl> per kutima en matematiko rekta
      substantivigo de adjektivoj.
    </rim>
  </snc>
  <trd lng="be">&c_s;&c_u;&c_p;&c_r;&c_a;&c_c;&c_mol;&c_l;&c_je;&c_g;&c_l;&c_y;
  <ind>&c_e;&c_l;&c_je;&c_m;&c_e;&c_n;&c_t;</ind></trd>
  <trd lng="ca">oposat<klr> (subst.)</klr></trd>
  <trd lng="de">entgegengesetztes <ind>Element</ind></trd>
  <trdgrp lng="en">
    <trd>opposite <ind>element</ind></trd>,
    <trd>additive <ind>inverse</ind></trd>
  </trdgrp>
  <trd lng="fr">oppos&eacute;<klr tip="ind"> (math., subst.)</klr></trd>
  <trd lng="he">&lamed;&alef; &shin;&vav;&vav;&yod;&vav;&nun;&yod;</trd>
  <trd lng="hu">ellentett</trd>
  <trdgrp lng="id">
    <trd>invers aditif</trd>,
    <trd>negasi</trd>
  </trdgrp>
  <trd lng="pl">element przeciwny</trd>
  <trd lng="ru">&c_p;&c_r;&c_o;&c_t;&c_i;&c_v;&c_o;&c_p;&c_o;&c_l;&c_o;&c_zh;&c_n;&c_y;&c_j;
  <ind>&c_e;&c_l;&c_je;&c_m;&c_je;&c_n;&c_t;</ind></trd>
</drv>

