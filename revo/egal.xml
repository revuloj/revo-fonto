  </trdgrp>
</drv>

<drv mrk="egal.0ajxo">
  <kap><tld/>a&jcirc;o</kap>
  <snc mrk="egal.0ajxo.io">
    <dif>
      Io <tld/>a:
      <ekz>
        donu al viaj sklavoj justa&jcirc;on kaj <tld/>a&jcirc;on
        <fnt>
          <bib>NT</bib>
          <lok>Koloseanoj 4:1</lok>
        </fnt>;
      </ekz>
      <ekz>
        la turetoj kaj balkonoj estis faritaj el ar&gcirc;entofiligrano de tiel mirinda speco,
        ke en tuta Fantaziujo ne ekzistis <tld/>a&jcirc;o
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Ar&gcirc;enta Urbo Amarganto</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Gleiches</trd>,
      <trd>Vergleichbares</trd>
    </trdgrp>
  <trdgrp lng="id">
    <trd><baz>sama</baz>kesamaan<klr> (derajat dsb.)</klr></trd>,
