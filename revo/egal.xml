<drv mrk="egal.tut0e">
  <kap>tut<tld/>e</kap>
  <snc mrk="egal.tut0e.sendistinge">
    <dif>
      Tute egale, ne gravas:
      <ekz>
        ili <klr>(du kronoj)</klr> estos haveblaj ie ajn, tut<tld/>e kie
        <fnt>
          <aut>S. Engholm</aut>,
          <vrk>Al Torento</vrk>,
          <lok>1930</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">sense importar</trd>
    <trdgrp lng="de">
      <trd>ganz <ind>egal</ind></trd>,
      <trd>ganz <ind>gleich</ind></trd>
    </trdgrp>
    <trd lng="en">no matter</trd>
  <trdgrp lng="id">
    <trd>pun</trd>,
    <trd>tidak peduli</trd>,
    <trd>tidak penting</trd>
  </trdgrp>
  </snc>
  <snc mrk="egal.tut0e.malgrauxe">
    <dif>
      Modala vorto signifanta
      <ctl>malgra&ubreve; la dirita, &ccirc;io restas sen&scirc;an&gcirc;a</ctl>,
      <ctl>&ccirc;iel ajn, tio ne gravas</ctl> ktp:
      <ekz>
        sed tut<tld/>e tio estas nur personaj opinioj de la
        parolintoj
        <fnt>
          <aut>D. Cibulevskij</aut>, <vrk>Pridiskuto</vrk>.
          <bib>Monato</bib>.
        </fnt>;
      </ekz>
      <ekz>
        kvankam poste estis malkovrite, ke en multaj virusoj
        genetika informo povas esti kodita en RNA (ribonukleata
        acido), tut<tld/>e la esenco de la malkovro de <nom>Avery</nom> ne
        &scirc;an&gcirc;i&gcirc;is
        <fnt>
          <aut>V. Lemelev</aut>, <vrk>Eltrovo de prionoj</vrk>.
          <bib>Monato</bib>.
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>igualment</trd>,
      <trd>no obstant</trd>
    </trdgrp>
    <trd lng="de">dessen <ind>ungeachtet</ind></trd>
    <trd lng="en">all the same</trd>
    <trd lng="id">sama persis</trd>
    <trdgrp lng="zh">
    <trd>&#20760;&#31649;&#36889;&#27171; <pr>j&#464;ngu&#462;nzh&egrave;y&agrave;ng</pr></trd>,
    <trd>&#33503; <pr>g&#466;u</pr></trd>,
    <trd>&#20760;&#31649; <pr>j&#464;ngu&#462;n</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="be">
    <trd>&c_u;&c_s;&c_jo; <ind>&c_r;&c_o;&c_w;&c_n;&c_a;</ind></trd>,
    <trd>&c_u;&c_s;&c_jo; <ind>&c_a;&c_d;&c_n;&c_o;</ind></trd>,
    <trd>&c_a;&c_b;&c_y;&c_ja;&c_k;&c_a;&c_v;&c_a;</trd>
  </trdgrp>
  <trd lng="he">&shin;&vav;&vav;&he; &lamed;&het;&lamed;&vav;&tet;&yod;&fnun;</trd>
  <trd lng="ru">&c_v;&c_s;&c_jo; &c_r;&c_a;&c_v;&c_n;&c_o;</trd>
</drv>

<drv mrk="egal.tagnokt0eco">
  <kap>tagnokt<tld/>eco</kap>
  <snc mrk="egal.tagnokt0eco.AST">
    <uzo tip="fak">AST</uzo>
    <uzo tip="fak">KAL</uzo>
    <dif>
      <ref tip="dif" cel="ekvino.0o">Ekvinokso</ref>:
      <ekz>
        en la tago de la somera tagnokt<tld/>eco, &ccirc;irka&ubreve; la na&ubreve;a
        horo vespere, <klr>[&#8230;]</klr> anta&ubreve; la pordego de l' templo
        haltis du voja&gcirc;antaj pastroj
        <fnt><bib>Far2</bib>, <lok>&ccirc;apitro 1a</lok></fnt>.
      </ekz>
    </dif>
