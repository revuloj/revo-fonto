  <snc>
    <dif>
      <ref tip="dif" cel="difere.0a">Diferenca</ref>, <ref tip="sin" cel="sam.mal0a">malsama</ref>:
      <ekz>
        kvin fratoj <klr>[&#8230;]</klr> staris fiere unu apud la alia, kvankam ilia longo
        estis tre mal<tld/>a
        <fnt>
          <bib>Fab2</bib>
          <lok>Flikilo</lok>
        </fnt>;
      </ekz>
      <ekz>
        iliaj viza&gcirc;oj <klr>[&#8230;]</klr> havis karakteron tute mal<tld/>an
        <fnt>
          <bib>Marta</bib>
        </fnt>.
      </ekz>
    </dif>
  <trdgrp lng="id">
    <trd>beda</trd>,
    <trd>lain</trd>,
    <trd>tidak sama</trd>
  </trdgrp>
