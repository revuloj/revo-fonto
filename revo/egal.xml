    <trd><baz>tingkat</baz>setingkat</trd>,
    <trd>sama rata</trd>
  </trdgrp>
  </snc>
  <snc mrk="egal.0a.simila">
    <uzo tip="stl">EVI</uzo>
    <dif>
      Simila, sama:
      <ekz>
        nomo <tld/>a sed esenco mala <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        nominativon ni uzas nur post tiuj prepozicioj, kies senco estas &ccirc;iam <tld/>a
        <fnt>
          <bib>LR</bib>
          <lok>5. Kazosintakso</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iu litero estas elparolata &ccirc;iam
        <tld/>e
        <fnt>
          <bib>LR</bib>
          <lok>4. Fonetiko</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="ca">semblant</trd>
  <trdgrp lng="id">
    <trd>mirip</trd>,
    <trd>sama</trd>
  </trdgrp>
  </snc>
  <snc mrk="egal.0a.MAT">
    <uzo tip="fak">MAT</uzo>
    <subsnc mrk="egal.0a.aro">
      <fnt><bib>PIV2</bib>, <lok>jekci: sur~o</lok></fnt>
      <dif>
        <klr>(p.p. du <ref cel="ar.0o.MAT">aroj</ref>)</klr>
        Tiaj, ke &ccirc;iu elemento de unu estas elemento de alia:
        <ekz>
          la aro de reelaj radikoj de polinomo
          <frm am="bb X^2-bb 1"><g>X</g><sup>2</sup>-<g>1</g></frm>
          estas egala al <frm am="{-1,1}">{-1,1}</frm>.
        </ekz>
      </dif>
      <rim>
        Pli &gcirc;enerale, en moderna matematiko, du objektoj estas
        <tld/>aj, se ili estas absolute nedistingeblaj, do havas precize
        la samajn ecojn. La <tld/>econ de du objektoj
        <frm am="a"><k>a</k></frm>
        kaj <frm am="b"><k>b</k></frm> oni signas per
        <frm am="a=b"><k>a</k> = <k>b</k></frm>
        <klr> (<nom>a</nom> egalas al <nom>bo</nom>, a&ubreve;: <nom>a</nom> egalas <nom>bo</nom>-on,
          a&ubreve;: <nom>a</nom> <esc>egal</esc> <nom>bo</nom>)</klr>.
      </rim>
      <trd lng="id">sama dengan</trd>
      <trd lng="pl">r&oacute;wny</trd>
    </subsnc>
    <subsnc mrk="egal.0a.izometria">
      <fnt><bib>MatTerm</bib>, <lok>p. 25</lok></fnt>
      <uzo tip="klr">(tradicia lingva&jcirc;o en elementa
        geometrio)</uzo>
      <dif>
        <klr>(p.p. du
          <ref cel="figur.geometria0o">geometriaj figuroj</ref>)</klr>
        Tiaj, ke <ctl>movante</ctl> unu el la figuroj, eblas igi
        &gcirc;in
        <ref cel="koinci.0i.figuroj_ka">koincidi</ref> kun la alia; pli
        rigore: la figuroj estas
        <ref cel="poziti.0a.izometrio">pozitive</ref>
        <ref cel="izomet.0a.subaroj">izometriaj</ref>:
        <ekz>
          du <tld/>aj strekoj estas samlongaj;
        </ekz>
        <ekz>
          se du trianguloj havas tri duope <tld/>ajn laterojn,
          anka&ubreve; ili estas <tld/>aj;
        </ekz>
        <ekz>
          reguloj pri <tld/>eco de trianguloj.
        </ekz>
      </dif>
      <trd lng="pl"><klr tip="amb">(figura)
        </klr>przystaj&aogonek;ca</trd>
    </subsnc>
    <trd lng="fr">&eacute;gal</trd>
  </snc>
