<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: pra.xml,v 1.27 2026/09/17 07:36:20 revo Exp $">
<kap>
  <ofc>*</ofc> <rad>pra</rad>
  <fnt> <bib>UV</bib></fnt>
</kap>
<subart>
  <drv mrk="pra.0">
    <kap><tld/>-</kap>
    <gra><vspec>prefikso</vspec></gra>
    <snc mrk="pra.0.HIS">
      <uzo tip="fak">HIS</uzo>
      <dif>
        Primitiva, origina, el anta&ubreve; longe:
        <ekz>
          tropika <tld/>arbaro
          <klr>(ekzistanta de nememorebla tempo)</klr>
          <fnt>
            <bib>Kon11</bib>
            <lok>Voja&gcirc;o</lok>
          </fnt>;
        </ekz>
        <ekz>
          <klr>[anta&ubreve;]</klr> la apero de la skribo, elpensita en Sumero &ccirc;irka&ubreve; 3400 jarojn
          a. K. <klr>[&#x2026;]</klr> oni parolas ne pri historio, sed pri <tld/>historio
          <fnt>
            <bib>Monato</bib>
            <aut>Thomas Genty</aut>
            <vrk>Emesal: &ccirc;u la plej antikva planlingvo?</vrk>
            <lok>2014</lok>
          </fnt>;
        </ekz>
        <ekz>
          la <tld/>ulo de la homo kaj poste la <tld/>homo havis, tamen, kapablon eligi
          anka&ubreve; diversajn sonojn
          <fnt>
            <bib>Ret</bib>
            <lok>Unua Parto</lok>
          </fnt>;
        </ekz>
        <ekz>
          <nom>Gilgame&scirc;</nom>, la Sumera <ind><tld/>tipo</ind> de Herkuleso
          <fnt>
            <bib>I&scirc;tar</bib>
            <lok>&Ccirc;apitro III</lok>
          </fnt>;
          <trdgrp lng="de">
            <trd>Urtyp</trd>,
            <trd>Vormodell</trd>,
            <trd>Prototyp</trd>
          </trdgrp>
          <trd lng="nl">prototype</trd>
          <trd lng="pl">archetyp</trd>
          <trd lng="ru">&c_p;&c_r;&c_o;&c_t;&c_o;&c_t;&c_i;&c_p;</trd>
        </ekz>
        <ekz>
          la sunkulto de la <ind><tld/>tempo</ind>j malaperis,
          nun oni adoras nur la malgrandajn lampojn
          <fnt>
            <bib>Tor</bib>
            <lok>VI.</lok>
          </fnt>.
          <trdgrp lng="de">
            <trd>Urzeit</trd>,
            <trd>Vorzeit</trd>
          </trdgrp>
          <trd lng="nl">oertijd</trd>
          <trd lng="pl">czasy zamierzch&lstroke;e {pl}</trd>
          <trdgrp lng="ru">
            <trd>&c_d;&c_o;&c_i;&c_s;&c_t;&c_o;&c_r;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_a;&c_ja; &c_e;&c_p;&c_o;&c_h;&c_a;</trd>,
            <trd>&c_p;&c_je;&c_r;&c_v;&c_o;&c_b;&c_y;&c_t;&c_n;&c_o;&c_je; &c_v;&c_r;&c_je;&c_m;&c_ja;</trd>
          </trdgrp>
        </ekz>
      </dif>
      <refgrp tip="vid">
        <ref cel="patr.pra0o"><tld/>patro</ref>,
        <ref cel="patr.pra0ino"><tld/>patrino</ref>
      </refgrp>
      <trdgrp lng="es">
        <trd>pre-<klr> (antiqu&iacute;simo, primitivo)</klr></trd>,
        <trd>proto-</trd>
      </trdgrp>
      <trdgrp lng="fr">
        <trd>pr&eacute;-<klr> (ancien, primitif)</klr></trd>,
        <trd>proto-</trd>
      </trdgrp>
      <trd lng="pl">pra-</trd>
      <trd lng="vo">&uuml;l-</trd>
      <trd lng="zh">&#x539F;&#x59CB; <pr>yu&aacute;nsh&#x1D0;</pr></trd>
    </snc>
    <snc mrk="pra.0.GEN">
      <uzo tip="fak">GEN</uzo>
      <dif>
        Sekva, pli malproksima en grado de parenceco ol la
        &jcirc;us anta&ubreve;a, tuj posta ol la indikita de la radikalo:
        <ekz>
          la <ind><tld/>avo</ind>
          kaj la <tld/>avino
          <klr>(la gepatroj de avo a&ubreve; avino)</klr>
          <fnt>
            <bib>Fab3</bib>
          </fnt>;
          <trdgrp lng="de">
            <trd>Urgro&szlig;vater</trd>,
            <trd>Uropa</trd>
          </trdgrp>
          <trd lng="nl">overgrootvader</trd>
          <trd lng="pl">pradziadek</trd>
          <trd lng="ru">&c_p;&c_r;&c_a;&c_d;&c_je;&c_d;</trd>
        </ekz>
        <ekz>
          atendu min anta&ubreve; la domo de mia
          <ind><tld/>nepo</ind>
          <fnt>
            <bib>PrV</bib>
          </fnt>.
          <trd lng="pl">prawnuk</trd>
          <trd lng="ru">&c_p;&c_r;&c_a;&c_v;&c_n;&c_u;&c_k;</trd>
        </ekz>
      </dif>
      <trd lng="es">bis-<klr> (parentesco de cuarta
        generaci&oacute;n)</klr></trd>
      <trd lng="fr">arri&egrave;re-<klr> (parent&eacute;)</klr></trd>
      <trd lng="ru">&c_p;&c_r;&c_a;-</trd>
    </snc>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_a;-</trd>,
      <trd>&c_p;&c_je;&c_r;&c_sh;&c_a;-</trd>
    </trdgrp>
    <trd lng="de">Ur-</trd>
    <trd lng="pt">pr&eacute;-</trd>
    <trd lng="uk">&c_shch;&c_o; &c_p;&c_o;&c_z;&c_n;&c_a;&c_ch;&c_a;&c_jeu;</trd>
  </drv>
</subart>

<subart>
  <dif>
    Samsignifa vortero.
  </dif>

  <drv mrk="pra.0a">
    <kap><tld/>a</kap>
    <snc mrk="pra.0a.HIS">
      <dif>
        <ref tip="sin" cel="primit.0a">Primitiva</ref>,
        anta&ubreve;historia, <ref tip="sin" cel="origin.0a">origina</ref>:
        <ekz>
          <tld/>a fekund-rito
          <fnt>
            <bib>ChM</bib>
            <lok>14</lok>
          </fnt>;
        </ekz>
        <ekz>
          en la jaro 1878, kiam d-ro <nom>Vincent</nom> fondis la someran universitaton,
          <nom>Chautauque</nom>
          okupis 150 akrojn da bela tero, sed trovis sin en tre <tld/>a stato
          <fnt>
            <bib>FK</bib>
            <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
          </fnt>;
        </ekz>
        <ekz>
          nun li staras en la kiraso de la nekontra&ubreve;starebla juneco kaj kun la <tld/>a
          forto de la deziro <klr>[&#x2026;]</klr>, bela kaj triumfa kiel juna greka dio
          <fnt>
            <bib>LGA</bib>
            <lok>III.</lok>
          </fnt>.
        </ekz>
      </dif>
    </snc>
    <trdgrp lng="be">
      <trd>&c_p;&c_je;&c_r;&c_sh;&c_a;&c_b;&c_y;&c_t;&c_n;&c_y;</trd>,
      <trd>&c_d;&c_a;&c_g;&c_ib;&c_s;&c_t;&c_a;&c_r;&c_y;&c_ch;&c_n;&c_y;</trd>
    </trdgrp>
    <trd lng="bo">&t_pha;&t_tsheg;&t_-a;&t_ba;&t_shabchu;&t_na;&t_tsheg;</trd>
    <trdgrp lng="cs">
      <trd>velmi d&aacute;vn&yacute;</trd>,
      <trd>velmi star&yacute;</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>urzeitlich</trd>,
      <trd>vorzeitlich</trd>,
      <trd>urt&uuml;mlich</trd>
    </trdgrp>
    <trd lng="en">elder <klr>(very ancient)</klr></trd>
    <trdgrp lng="es">
      <trd>arcaico</trd>,
      <trd>ancestral</trd>
    </trdgrp>
    <trd lng="fr">archa&iuml;que</trd>
    <trdgrp lng="ja">
      <trd>&#x539F;&#x59CB;&#x306E;  <pr>&#x3052;&#x3093;&#x3057;&#x306E;</pr></trd>,
      <trd>&#x592A;&#x53E4;&#x306E;  <pr>&#x305F;&#x3044;&#x3053;&#x306E;</pr></trd>
    </trdgrp>
    <trd lng="nl">voorhistorisch</trd>
    <trd lng="pl">dawny  <klr>(prastary)</klr></trd>
    <trdgrp lng="ru">
      <trd>&c_p;&c_je;&c_r;&c_v;&c_o;&c_b;&c_y;&c_t;&c_n;&c_y;&c_j;</trd>,
      <trd>&c_d;&c_o;&c_i;&c_s;&c_t;&c_o;&c_r;&c_i;&c_ch;&c_je;&c_s;&c_k;&c_i;&c_j;</trd>
    </trdgrp>
    <trdgrp lng="sk">
      <trd>prad&aacute;vny</trd>,
      <trd>starod&aacute;vny</trd>
    </trdgrp>
    <trdgrp lng="uk">
      <trd>&c_p;&c_je;&c_r;&c_v;&c_ib;&c_s;&c_n;&c_i;&c_j;</trd>,
      <trd>&c_p;&c_r;&c_i;&c_m;&c_ib;&c_t;&c_i;&c_v;&c_n;&c_i;&c_j;</trd>,
      <trd>&c_d;&c_o;&c_ib;&c_s;&c_t;&c_o;&c_r;&c_i;&c_ch;&c_n;&c_i;&c_j;</trd>
    </trdgrp>
    <trdgrp lng="zh">
      <trd>&#x8FDC;&#x53E4; <pr>yu&#x1CE;ng&#x1D4;</pr></trd>,
      <trd>&#x9060;&#x53E4; <pr>yu&#x1CE;ng&#x1D4;</pr></trd>,
      <trd>&#x539F;&#x59CB; <pr>yu&aacute;nsh&#x1D0;</pr></trd>
    </trdgrp>
  </drv>

  <drv mrk="pra.0ulo">
    <kap><tld/>ulo</kap>
    <snc mrk="pra.0ulo.GEN">
      <uzo tip="fak">GEN</uzo>
      <dif>
        Individuo de kiu oni devenas, precipe tia apartenanta al
        malproksima generacio:
        <ekz>
          inter liaj <tld/>uloj estis kaj pastroj, kaj militistoj
          <fnt>
            <aut>D. Cibulevskij</aut>:
            <vrk>Ukrainaj kantoj kaj peterburgaj groteskoj</vrk>.
            <bib>Monato</bib>.
          </fnt>;
        </ekz>
        <ekz>
          la <ctl>natura</ctl> amo al la loko, kie oni naski&gcirc;is,
          kie estas entombigitaj la <tld/>uloj estas limigita al
          tre malvasta regiono kaj neniel al tuta lando
          <fnt>
            <aut>E. Lanti</aut>:
            <vrk><url ref="http://home.arcor.de/gmickle/skk/92ms_2.html">Letero pri la kvaza&ubreve;aj
            &leftquot;Aksiomoj&rightquot;</url></vrk>
          </fnt>;
        </ekz>
        <ekz>
          eble temas pri atavismo, reveno al tiu epoko, kiam
          la <tld/>ulo de l' homo ne estis ankora&ubreve; animalo
          socia kaj vivis izole en sia kaverno
          <fnt>
            <aut>A. &Ccirc;e&hcirc;ov, trad. M.Luka&scirc;</aut>, <vrk>Enujulo</vrk>,
            <lok>La Nica literatura revuo, 3:1</lok>
          </fnt>.
        </ekz>
      </dif>
      <ref tip="ant" cel="post.0eulo">posteulo</ref>
    </snc>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_o;&c_d;&c_a;&c_k;</trd>,
      <trd>&c_p;&c_r;&c_a;&c_sh;&c_ch;&c_u;&c_r;</trd>,
      <trd>&c_r;&c_o;&c_d;&c_a;&c_p;&c_a;&c_ch;&c_y;&c_n;&c_a;&c_l;&c_mol;&c_n;&c_ib;&c_k;</trd>
    </trdgrp>
    <trd lng="cs">d&aacute;vn&yacute; p&rcaron;edek</trd>
    <trd lng="de">Vorfahre</trd>
    <trdgrp lng="en">
      <trd>ancestor</trd>,
      <trd>forebear</trd>
    </trdgrp>
    <trdgrp lng="es">
      <trd>ancestro</trd>,
      <trd>antepasado</trd>,
      <trd>ascendiente</trd>
    </trdgrp>
    <trd lng="fr">anc&ecirc;tre</trd>
    <trdgrp lng="ja">
      <trd>&#x5148;&#x7956;  <pr>&#x305B;&#x3093;&#x305E;</pr></trd>,
      <trd>&#x7956;&#x5148;  <pr>&#x305D;&#x305B;&#x3093;</pr></trd>
    </trdgrp>
    <trd lng="nl">voorvader</trd>
    <trdgrp lng="pl">
      <trd>antenat</trd>,
      <trd>protoplasta</trd>,
      <trd>przodek</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_p;&c_r;&c_je;&c_d;&c_o;&c_k;</trd>,
      <trd>&c_p;&c_r;&c_a;&c_shch;&c_u;&c_r;</trd>
    </trdgrp>
    <trd lng="sk">d&aacute;vny predok</trd>
    <trdgrp lng="uk">
      <trd>&c_p;&c_r;&c_a;&c_shch;&c_u;&c_r;</trd>,
      <trd>&c_d;&c_a;&c_l;&c_je;&c_k;&c_i;&c_j; &c_p;&c_r;&c_je;&c_d;&c_o;&c_k;</trd>
    </trdgrp>
    <trdgrp lng="zh">
      <trd>&#x7956;&#x5B97; <pr>z&#x1D4;z&omacron;ng</pr></trd>,
      <trd>&#x7956;&#x8F29; <pr>z&#x1D4;b&egrave;i</pr></trd>,
      <trd>&#x7956;&#x8F88; <pr>z&#x1D4;b&egrave;i</pr></trd>,
      <trd>&#x5B97; <pr>z&omacron;ng</pr></trd>,
      <trd>&#x7956; <pr>z&#x1D4;</pr></trd>,
      <trd>&#x7956;&#x5148; <pr>z&#x1D4;xi&amacron;n</pr></trd>,
      <trd>&#x5148;&#x4EBA; <pr>xi&amacron;nr&eacute;n</pr></trd>,
      <trd>&#x5148; <pr>xi&amacron;n</pr></trd>
    </trdgrp>
  </drv>
</subart>
