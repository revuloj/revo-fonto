<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: nil.xml,v 1.22 2026/10/16 06:00:19 revo Exp $">
<kap><ofc>10</ofc>
  <rad>Nil</rad>/o
</kap>
<drv mrk="nil.N0o">
  <kap><tld/>o</kap>
  <fnt><bib>ZR</bib></fnt>
  <snc mrk="nil.N0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Grandega nordafrika <ref tip="lst" cel="river.0o" lst="voko:riveroj">rivero</ref> ekfluanta en
      Etiopujo kaj Sudano
      kaj enfluanta en <ref tip="vid" cel="mediterane.M0o">Mediteraneon</ref> en
      Egiptujo. Apud <ref tip="vid" cel="amazon2.A0o">Amazono</ref> la
      plej longa rivero en la mondo:
      <ekz>
        por kio vi bezonas la vojon al Egiptujo, &ccirc;u por trinki la akvon
        de <tld/>o?
        <fnt>
          <bib>MT</bib>
          <lok>&Jer; 2:18</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;i tiu triangulo, nomata Delta de <tld/>o, havas kiel bazon la
        bordon
        de Mediteraneo, kaj kiel pinton, en la loko kie la rivero eliras
        el la
        intermonto, la urbon Kairon kaj la ruinojn de la antikva
        &ccirc;efurbo, Memfiso
        <fnt>
          <bib>Far1</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la fabelo pri Moseo, kiu estis metita de sia patrino sur la
        akvon de <tld/>o, trovita de la re&gcirc;idino, ricevis bonan edukon
        <fnt>
          <bib>Fab4</bib>
          <lok>Filino de la mar&ccirc;a re&gcirc;o</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_N;&c_ib;&c_l;</trd>
    <trd lng="bg">&c_N;&c_i;&c_l;</trd>
    <trd lng="de">Nil</trd>
    <trd lng="en">Nile</trd>
    <trd lng="fr">Nil</trd>
    <trd lng="hu">N&iacute;lus</trd>
    <trd lng="lat">Nilus</trd>
    <trd lng="mk">&c_N;&c_i;&c_l;</trd>
    <trd lng="nl">Nijl</trd>
    <trd lng="pl">Nil</trd>
    <trd lng="pt">Nilo</trd>
    <trd lng="ru">&c_N;&c_i;&c_l;</trd>
  </snc>
  <trd lng="ca">Nil</trd>
  <trd lng="cs">Nil</trd>
  <trd lng="es">Nilo</trd>
  <trd lng="ja">&#12490;&#12452;&#12523;&#24029; 
  <pr>&#12490;&#12452;&#12523;&#12363;&#12431;</pr></trd>
  <trd lng="sk">N&iacute;l</trd>
  <trd lng="uk">&c_N;&c_ib;&c_l;</trd>
  <trdgrp lng="zh">
    <trd>&#23612;&#32599;&#27827; <pr>N&iacute;lu&oacute;H&eacute;</pr></trd>,
    <trd>&#23612;&#32645;&#27827; <pr>N&iacute;lu&oacute;H&eacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="nil.Blanka0o">
  <kap><ofc>10</ofc>Blanka <tld/>o</kap>
  <fnt><bib>PIV1</bib></fnt>
  <fnt><bib>KrED</bib></fnt>
  <snc mrk="nil.Blanka0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Sudana alfluo al Nilo.
    </dif>
    <trd lng="be">&c_B;&c_je;&c_l;&c_y; <ind>&c_N;&c_ib;&c_l;</ind></trd>
    <trd lng="bg">&c_B;&c_je;&c_l;&c_i; <ind>&c_N;&c_i;&c_l;</ind></trd>
    <trd lng="de">Wei&szlig;er <ind>Nil</ind></trd>
    <trd lng="en">White <ind>Nile</ind></trd>
    <trd lng="fr"><ind>Nil</ind> blanc</trd>
    <trd lng="hu">Feh&eacute;r-N&iacute;lus</trd>
    <trd lng="mk">&c_B;&c_je;&c_l;&c_i; <ind>&c_N;&c_i;&c_l;</ind></trd>
    <trd lng="nl">Witte <ind>Nijl</ind></trd>
    <trd lng="pl">Bia&lstroke;y <ind>Nil</ind></trd>
    <trd lng="pt">Nilo Branco</trd>
    <trd lng="ru">&c_B;&c_je;&c_l;&c_y;&c_j; <ind>&c_N;&c_i;&c_l;</ind>
    </trd>
  </snc>
  <trd lng="ca">Nil Blanc</trd>
  <trd lng="cs">B&iacute;l&yacute; Nil</trd>
  <trd lng="es">Nilo Blanco</trd>
  <trd lng="sk">Biely N&iacute;l</trd>
</drv>

<drv mrk="nil.Blua0o">
  <kap><ofc>10</ofc>Blua <tld/>o</kap>
  <fnt><bib>PIV1</bib></fnt>
  <fnt><bib>KrED</bib></fnt>
  <snc mrk="nil.Blua0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Etiopuja alfluo al Nilo:
      <ekz>
        la sukcesa kulturado de kotono en Sudano postulis artefaritan akvumadon;
        tiucele servas la akvori&ccirc;aj torentoj de Blanka kaj Blua <tld/>oj
      <fnt>
        <aut>J. Kohen-Cedek</aut>
        <vrk>Inter Blua kaj Blanka Niloj</vrk>
        <lok>Malgranda Revuo, 1947/4</lok>
      </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_B;&c_l;&c_a;&c_k;&c_ib;&c_t;&c_n;&c_y; <ind>&c_N;&c_ib;&c_l;</ind></trd>
    <trd lng="bg">&c_S;&c_i;&c_n;&c_i; <ind>&c_N;&c_i;&c_l;</ind></trd>
    <trd lng="de">Blauer <ind>Nil</ind></trd>
    <trd lng="en">Blue <ind>Nile</ind></trd>
    <trd lng="fr"><ind>Nil</ind> bleu</trd>
    <trd lng="hu">K&eacute;k-N&iacute;lus</trd>
    <trd lng="mk">&c_S;&c_i;&c_n;&c_i; <ind>&c_N;&c_i;&c_l;</ind></trd>
    <trd lng="nl">Blauwe <ind>Nijl</ind></trd>
    <trd lng="pl">B&lstroke;&eogonek;kitny <ind>Nil</ind></trd>
    <trd lng="pt">Nilo Azul</trd>
    <trd lng="ru">&c_G;&c_o;&c_l;&c_u;&c_b;&c_o;&c_j; <ind>&c_N;&c_i;&c_l;</ind></trd>
  </snc>
  <trd lng="ca">Nil Blau</trd>
  <trd lng="es">Nilo Azul</trd>
</drv>
</art>
