<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: iriz.xml,v 1.15 2026/08/16 02:09:29 revo Exp $">
<kap>
  <rad>iriz</rad>/i <fnt><bib>SPV</bib></fnt>
</kap>
<drv mrk="iriz.0i">
  <kap><tld/>i</kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="iriz.0i.KOMUNE">
    <dif>
      Alternigi la kolorojn la&ubreve; movoj de la lumo, de la
      observanto:
      <ekz>
        prefere kombinu la kolorojn kiuj reciproke <tld/>u
        <fnt>
          <aut>T. Plicka, trad. L. Bor&ccirc;i&ccirc;</aut>,
          <vrk>Ru&gcirc;aj pasko-ovoj</vrk>,
          <lok><url ref="&SCE;">
          soc.culture. esperanto</url>, 1997-03-28</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="muar.0i">muari</ref>
    </refgrp>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>&ccirc;ielarke kolori</ke>.
  </rim>

  <trd lng="be">&c_p;&c_je;&c_r;&c_a;&c_l;&c_ib;&c_v;&c_a;&c_c;&c_c;&c_a; <klr>(&c_f;&c_a;&c_r;&c_b;&c_a;&c_m;&c_ib;, &c_n;&c_ib;&c_b;&c_y; &c_v;&c_ja;&c_s;&c_jo;&c_l;&c_k;&c_a;)</klr></trd>
  <trdgrp lng="cs">
    <trd>b&yacute;t duhov&ecaron; zbarven&yacute;</trd>,
    <trd>dou&zcaron;kovat</trd>,
    <trd>irizovat</trd>
  </trdgrp>
  <trd lng="de">irisieren</trd>
  <trd lng="fr">iriser</trd>
  <trd lng="ja">&#x8679;&#x8272;&#x306B;&#x5F69;&#x308B;  <pr>&#x306B;&#x3058;&#x3044;&#x308D;&#x306B;&#x3044;&#x308D;&#x3069;&#x308B;</pr></trd>
  <trdgrp lng="pl">
    <trd>iryzowa&cacute;</trd>,
    <trd>mieni&cacute; si&eogonek; barwami t&eogonek;czy</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>iriar(-se)</trd>,
    <trd>irisar(-se)</trd>,
    <trd>matizar(-se)</trd>
  </trdgrp>
  <trd lng="sk">meni&tcaron; farbu ako d&uacute;ha</trd>
  <trd lng="uk">&c_r;&c_o;&c_z;&c_c;&c_v;&c_ib;&c_ch;&c_u;&c_v;&c_a;&c_t;&c_i; &c_v;&c_s;&c_ib;&c_m;&c_a; &c_k;&c_o;&c_l;&c_mol;&c_o;&c_r;&c_a;&c_m;&c_i;
  &c_v;&c_je;&c_s;&c_je;&c_l;&c_k;&c_i;</trd>
</drv>

<drv mrk="iriz.0a">
  <kap><tld/>a</kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="iriz.0a.KOMUNE">
    <dif>
      Kiu <tld/>as, kies koloroj &scirc;ajne movi&gcirc;as:
      <ekz>
        inter <tld/>aj makuloj de <klr>[&#x2026;]</klr> oleo
        <fnt>
          <aut>Lubovj Lukina, E&ubreve;geno Lukin, trad. Jurij Finkel
          </aut>,
          <vrk>La misiistoj</vrk>,
          <lok><url ref="http://www.esperanto.mv.ru/Lukin/mis2.html">parto
          2a</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        malgranda knabino, kies destino nuntempe enhavis ne multe da <tld/>a&jcirc;oj, &scirc;i
        havis kanceron
        <fnt>
          <bib>Kon11</bib>
          <lok>Rakonto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_je;&c_r;&c_a;&c_l;&c_ib;&c_v;&c_ib;&c_s;&c_t;&c_y; <klr>(&c_f;&c_a;&c_r;&c_b;&c_a;&c_m;&c_ib;)</klr></trd>
  <trd lng="cs">duhov&ecaron; zbarven&yacute;</trd>
  <trd lng="de">irisierend</trd>
  <trd lng="fr">iris&eacute;</trd>
  <trdgrp lng="ja">
    <trd>&#x8679;&#x8272;&#x306E;  <pr>&#x306B;&#x3058;&#x3044;&#x308D;&#x306E;</pr></trd>,
    <trd>&#x8679;&#x8272;&#x306B;&#x8F1D;&#x304F;  <pr>&#x306B;&#x3058;&#x3044;&#x308D;&#x306B;&#x304B;&#x304C;&#x3084;&#x304F;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>iryzuj&aogonek;cy</trd>,
    <trd>mieni&aogonek;cy si&eogonek; barwami t&eogonek;czy</trd>
    <trd>t&eogonek;czowy</trd>
  </trdgrp>
  <trd lng="sk">d&uacute;hov&yacute;</trd>
  <trdgrp lng="uk">
    <trd>&c_r;&c_a;&c_j;&c_d;&c_u;&c_zh;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_p;&c_je;&c_r;&c_je;&c_l;&c_i;&c_v;&c_ch;&c_a;&c_s;&c_t;&c_i;&c_j;</trd>
  </trdgrp>
</drv>

<drv mrk="iriz.0o">
  <kap><tld/>o</kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="iriz.0o.KOMUNE">
    <dif>
      &Scirc;ajne movi&gcirc;antaj koloroj:
      <ekz>
        kulisoj feaj kun brilo kaj <tld/>o
        <fnt>
          <aut>K&aacute;lm&aacute;n Kalocsay</aut>
          <vrk><url ref="http://www.autodidactproject.org/other/kalocsay-ludo.html"
              >Ludo</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_je;&c_r;&c_a;&c_l;&c_ib;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_je; <klr tip="amb">(&c_k;&c_o;&c_l;&c_je;&c_r;&c_a;&c_w;)</klr></trd>
  <trd lng="de">Irisieren</trd>
  <trdgrp lng="ja">
    <trd>&#x8679;&#x8272;&#x52B9;&#x679C;  <pr>&#x306B;&#x3058;&#x3044;&#x308D;&#x3053;&#x3046;&#x304B;</pr></trd>,
    <trd>&#x8679;&#x8272;&#x306E;&#x8F1D;&#x304D;  <pr>&#x306B;&#x3058;&#x3044;&#x308D;&#x306E;&#x304B;&#x304C;&#x3084;&#x304D;</pr></trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>iryzacja</trd>,
    <trd>t&eogonek;czowa gra barw</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_p;&c_je;&c_r;&c_je;&c_l;&c_i;&c_v;&c_a;&c_n;&c_n;&c_ja; &c_k;&c_o;&c_l;&c_mol;&c_o;&c_r;&c_a;&c_m;&c_i;
    &c_v;&c_je;&c_s;&c_je;&c_l;&c_k;&c_i;</trd>,
    <trd>&c_ib;&c_r;&c_i;&c_z;&c_a;&c_c;&c_ib;&c_ja;</trd>
  </trdgrp>
</drv>
</art>
