<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: cembr.xml,v 1.27 2026/08/04 03:53:16 revo Exp $">
<kap>
  <rad>cembr</rad>/o
  <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="cembr.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BOT</uzo>
  <snc mrk="cembr.0o.supernocio">
    <dif>
      Iu el kelkaj specioj de <ref tip="super" cel="pin.0o">pino</ref>,
      <ref tip="lst" lst="voko:koniferoj" cel="konifer.0o">konifero</ref>
      kun kvinopaj pinglofaskoj kaj man&gcirc;eblaj
      nukssimilaj semoj (<tld/>aj nuksoj).
    </dif>
    <refgrp tip="sub">
      <ref cel="cembr.0oeuxropa"><tld/>o e&ubreve;ropa</ref>,
      <ref cel="cembr.0osiberia"><tld/>o siberia</ref>
    </refgrp>
    <ref tip="vid" cel="pini.0o">pinio</ref>
    <trd lng="ca">pi</trd>
    <trdgrp lng="es">
      <trd>pino cembro</trd>,
      <trd>pino cembra</trd>,
      <trd>cembro</trd>
    </trdgrp>
    <trd lng="it"><ind>pino</ind> (subgen: strobus)</trd>
    <trdgrp lng="nl">
      <trd>arve</trd>,
      <trd>alpenden</trd>
    </trdgrp>
    <trd lng="pl">limba</trd>
    <trd lng="ru">&c_k;&c_je;&c_d;&c_r;&c_o;&c_v;&c_a;&c_ja;
    &c_s;&c_o;&c_s;&c_n;&c_a;</trd>
  </snc>
  <snc mrk="cembr.0o.euxropa">
    <dif>
      <ref tip="dif" cel="cembr.0oeuxropa"><tld lit="C"/>o e&ubreve;ropa</ref>:
      <ekz>
        <tld/>o kreskas &gcirc;is <klr>[alteco de]</klr> 3000&nbsp;m en E&ubreve;ropo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=21550">Pino</url></lok>
        </fnt>;
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>cembra</trd>,
      <trd>pi cembra</trd>
    </trdgrp>
   <trdgrp lng="it">
    <trd>cembro</trd>,
    <trd><ind>pino</ind> cembro</trd>
    </trdgrp>
    <trd lng="nl">Europese <ind>alpenden</ind></trd>
  </snc>
  <trd lng="be">&c_k;&c_je;&c_d;&c_r;</trd>
  <trd lng="cs">borovice limba</trd>
  <trdgrp lng="de">
    <trd>Zirbelkiefer</trd>,
    <trd>Arve</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>arol</trd>,
    <trd>arolle</trd>,
    <trd>pin cembro</trd>
  </trdgrp>
  <trd lng="he">&alef;&vav;&resh;&fnun; &he;&gimel;&lamed;&ayin;&yod;&fnun;</trd>
  <trd lng="hu">cirbolyafeny&odblac;</trd>
  <trd lng="ja">&#x30E8;&#x30FC;&#x30ED;&#x30C3;&#x30D1;&#x30CF;&#x30A4;&#x30DE;&#x30C4;</trd>
  <trd lng="pl">limba</trd>
  <trd lng="sk">limba</trd>
  <trdgrp lng="uk">
    <trd>&c_s;&c_o;&c_s;&c_n;&c_a; &c_k;&c_je;&c_d;&c_r;&c_o;&c_v;&c_a;</trd>,
    <trd>&c_s;&c_o;&c_s;&c_n;&c_a; &c_jeu;&c_v;&c_r;&c_o;&c_p;&c_je;&c_j;&c_s;&c_mol;&c_k;&c_a;</trd>
  </trdgrp>
</drv>

<drv mrk="cembr.0oeuxropa">
  <kap><tld/>o e&ubreve;ropa</kap>
  <uzo tip="fak">BOT</uzo>
  <snc>
    <dif>
      <tld lit="C"/>o, la specio de <ref tip="super" cel="pin.0o">pino</ref>
      (<trd lng="la">Pinus cembra</trd>) kreskanta en la centra
      kaj okcidenta E&ubreve;ropo.
    </dif>
    <bld
      lok="https://upload.wikimedia.org/wikipedia/commons/thumb/8/8a/Pinus_cembra20080705.jpg/330px-Pinus_cembra20080705.jpg"
      prm="CC BY-SA 3.0"
      ><tld/>o en Stirio, A&ubreve;strujo
        <fnt>
          <aut>Tigerente</aut>
          <lok><url ref="&WCW;/File:Pinus_cembra20080705.jpg"
              >https://commons.wikimedia.org/wiki/File:Pinus_cembra20080705.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_k;&c_je;&c_d;&c_r; &c_e;&c_w;&c_r;&c_a;&c_p;&c_je;&c_j;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">pi cembra</trd>
  <trd lng="hu">havasi <ind>cirbolyafeny&odblac;</ind></trd>
  <trdgrp lng="it">
    <trd>cembro</trd>,
    <trd>cirmolo</trd>,
    <trd><ind>pino</ind> delle alpi</trd>,
    <trd><ind>pino</ind> cembro</trd>
  </trdgrp>
  <trd lng="nl">Europese <ind>alpenden</ind></trd>
  <trd lng="pl">sosna limba</trd>
  <trdgrp lng="ru">
    <trd>&c_k;&c_je;&c_d;&c_r;
    &c_je;&c_v;&c_r;&c_o;&c_p;&c_je;&c_j;&c_s;&c_k;&c_i;&c_j;</trd>,
    <trd>&c_s;&c_o;&c_s;&c_n;&c_a;
    &c_je;&c_v;&c_r;&c_o;&c_p;&c_je;&c_j;&c_s;&c_k;&c_a;&c_ja;</trd>
  </trdgrp>
</drv>

<drv mrk="cembr.0osiberia">
  <kap><tld/>o siberia</kap>
  <uzo tip="fak">BOT</uzo>
  <snc>
    <dif>
      <tld lit="C"/>o, la specio de
      <ref tip="super" cel="pin.0o">pino</ref>
      (<trd lng="la">Pinus sibirica</trd>) ofta
      tra la tuta Siberio.
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_je;&c_d;&c_r; &c_s;&c_ib;&c_b;&c_ib;&c_r;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">pi de Sib&egrave;ria</trd>
  <trd lng="hu">szib&eacute;riai
  <ind>cirbolyafeny&odblac;</ind></trd>
  <trd lng="it"><ind>pino</ind> siberiano</trd>
  <trd lng="nl">Siberische <ind>alpenden</ind></trd>
  <trdgrp lng="pl">
    <trd>sosna syberyjska</trd>,
    <trd>limba syberyjska</trd>,
    <trd>cedr syberyjski</trd>
  </trdgrp>
  <trd lng="ru">&c_k;&c_je;&c_d;&c_r;
  &c_s;&c_i;&c_b;&c_i;&c_r;&c_s;&c_k;&c_i;&c_j;</trd>
</drv>

<drv mrk="cembr.0ejo">
  <kap><tld/>ejo</kap>
  <uzo tip="fak">BOT</uzo>
  <snc>
    <dif>
      Parto de la tajgo a&ubreve; arbaro kie kreskas <tld/>oj.
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_je;&c_d;&c_r;&c_a;&c_ch;</trd>
  <trd lng="ca">pineda (de cembres)</trd>
  <trdgrp lng="nl">
    <trd>alpendenbos</trd>,
    <trd>arvebos</trd>
  </trdgrp>
  <trd lng="pl">tajga ciemna</trd>
  <trd lng="ru">&c_k;&c_je;&c_d;&c_r;&c_a;&c_ch;</trd>
</drv>

</art>
