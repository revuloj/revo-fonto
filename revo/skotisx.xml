<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: skotisx.xml,v 1.6 2026/11/07 01:53:40 revo Exp $">
<kap>
  <rad>skoti&scirc;</rad>/o,
  <var><kap><rad var="sx">&scirc;oti&scirc;</rad>/o</kap></var>
</kap>
<drv mrk="skotisx.0o">
  <kap><tld/>o,
    <var><kap><tld var="sx"/>o</kap></var>
  </kap>
  <snc mrk="skotisx.0o.danco">
    <uzo tip="fak">MUZ</uzo>
    <dif>
      E&ubreve;ropa para <ref tip="lst" cel="danc.0o"
      lst="voko:dancoj">danco</ref>
      simila al polko, plej populara en la 19a jarcento, la&ubreve;vorte
      <ctl>skota</ctl>:
      <ekz>
        &ccirc;iu danco havas nomon: <tld lit="S"/>o de &Jcirc;ozef Romeo, Valso
        de Dede Kerbeuf, Pluv-mazurko, ...
        <fnt>
          <aut>Mari-elen</aut>,
          <vrk><url ref="http://faldfolio.blogspot.com/">
          Faldfolio</url></vrk>,
          <lok>2006-12-24</lok>
        </fnt>;
      </ekz>
      <ekz>
        nun venu danci <tld var="sx"/>on kun mi
        <fnt>
          <aut>August Strindberg, trad. Paul Nyl&eacute;n kaj S. E. Krikortz</aut>
          <vrk>Fra&ubreve;lino Julie</vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="skotisx.0o.muzikajxo">
    <uzo tip="fak">MUZ</uzo>
    <dif>
      Muzika&jcirc;o ta&ubreve;ga por <tld/>danco:
      <ekz>
        &ccirc;iuj kantoj estas en esperanto <klr>...</klr> kun krome
        okcitanaj polko kaj <tld/>o senvo&ccirc;aj
        <fnt>
          <aut>-</aut>,
          <vrk>Kaj tiel plu &mdash; Pla&ccirc;as al mi</vrk>,
          <lok>Esperant&Ograve;C, 2005-09, numero 5a</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_s;&c_k;&c_a;&c_t;&c_y;&c_sh;</trd>,
    <trd>&c_sh;&c_o;&c_t;&c_y;&c_sh;</trd>
  </trdgrp>
  <trd lng="ca">xotis</trd>
  <trd lng="cs">&scaron;oty&scaron;</trd>
  <trd lng="de">Schottisch<klr tip="ind"> (Tanz)</klr></trd>
  <trd lng="en">schottische</trd>
  <trd lng="fr">scottish</trd>
  <trd lng="it">chotis</trd>
  <trdgrp lng="nl">
    <trd>schottisch</trd>,
    <trd><klr>(in balfolk) </klr>scottish</trd>
  </trdgrp>
  <trd lng="no">schottis</trd>
  <trd lng="pt">choti&ccedil;a</trd>
  <trd lng="ru">&c_sh;&c_o;&c_t;&c_t;&c_i;&c_sh;</trd>
  <trd lng="sv">schottis</trd>
</drv>
</art>

