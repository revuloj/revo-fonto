<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kortez.xml,v 1.1 2026/09/15 11:39:06 afido Exp $">
    <kap>
      <rad>kortez</rad>/a
    </kap>

<drv mrk="kortez.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">HIS</uzo><uzo tip="fak">BELE</uzo>
  <snc>
    <dif>
      Konforma al la kavaliraj manieroj de la <ref cel="trobad.0o">trobadoro</ref>j
      prikantantaj subliman, idealigitan amon:
      <ekz>
        la <ind><tld/>a amo</ind> alvenis kun okcitana lirika poezio
        <fnt>
          <aut>Sonia Risso</aut>
          <vrk><url ref="https://esperantaretradio.blogspot.com/2020/04/virinoj-en-muziko-4.html"
              >Virinoj en muziko (4)</url></vrk>
          <lok>Esperanta Retradio, 2020-04-25</lok>
        </fnt>;
        <trd lng="de">Minne</trd>
        <trd lng="en">courtly love</trd>
        <trd lng="fr">amour courtois</trd>
        <trd lng="oc">fin'amor</trd>
        <trd lng="ru">&c_k;&c_u;&c_r;&c_t;&c_u;&c_a;&c_z;&c_n;&c_a;&c_ja; &c_l;&c_ju;&c_b;&c_o;&c_v;&c_mol;</trd>
      </ekz>
      <ekz>
        la redukto de la originala franca poemo estas interesa: malaperas <klr>[&#x2026;]</klr>
        entute la didaktika kaj la <tld/>a parto, la <tld/>a amo transformi&gcirc;as al
        amoro
        <fnt>
          <bib>Monato</bib>
          <aut>Carlo Minnaja</aut>
          <vrk><url ref="&Monato;/2008/009455.php"
              >Mezepokaj sekret(igit)aj sonetoj</url></vrk>
          <lok>2008</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="kavali.0a">kavalira</ref>,
      <ref cel="kort.0ego">kortega</ref>
    </refgrp>
    <trd lng="de">h&ouml;fisch <klr>(Minne)</klr></trd>
    <trd lng="en">courtly</trd>
    <trd lng="fr">courtois</trd>
  </snc>
</drv>

  </art>


