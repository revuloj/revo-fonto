<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: homeostat.xml,v 1.1 2026/11/15 19:04:11 afido Exp $">
    <kap>
      <rad>homeostat</rad>/o <fnt><bib>PIV2</bib></fnt>,
      <var><kap><rad var ="zi">homeostazi</rad>/o</kap></var>
    </kap>

<drv mrk="homeostat.0o">
  <kap><tld/>o, <var><kap><tld var="zi"/>o</kap></var></kap>
  <uzo tip="fak">SCI</uzo><uzo tip="fak">FIZL</uzo>
  <snc>
    <dif>
      Ekvilibro de malfermita dinamika sistemo, konservata
      de interna reguliga procezo:
      <ekz>
        &ccirc;io postulas perfektegan reguligan sistemon, kiun la fama fiziologo <nom>Claude
        Bernard</nom> nomis la <tld/>o de la interna medio
        <fnt>
          <aut>Roebert Molimard</aut>
          <vrk><url ref="https://libro.ee/file.php?id=508"
              >La fumado</url></vrk>
          <lok>p. 24</lok>
        </fnt>;
      </ekz>
      <ekz>
        la fero ludas rolon en la ateroma kresko kaj ke misregulado de &gcirc;ia <tld var="zi"/>o
        pro aliaj malsanoj trafas la arterian sanecon
        <fnt>
          <bib>SR</bib>
          <aut>Anthony Lucas</aut>
          <vrk>Fera homeostazio, aterosklerozo kaj iskemia kardia malsano</vrk>
          <lok>Scienca Revuo, nro 231/2014</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Hom&ouml;ostase</trd>
    <trd lng="en">homeostasis</trd>
    <trd lng="fr">hom&eacute;ostasie</trd>
    <trd lng="ru">&c_g;&c_o;&c_m;&c_je;&c_o;&c_s;&c_t;&c_a;&c_z;</trd>
  </snc>
</drv>

  </art>


