<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: homeostat.xml,v 1.3 2026/11/20 07:42:34 afido Exp $">
    <kap>
      <rad>homeostat</rad>/o <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="homeostat.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">SCI</uzo><uzo tip="fak">FIZL</uzo>
  <snc>
    <dif>
      Malfermita dinamika <ref tip="super" cel="sistem.0o.SCI">sistemo</ref>, povanta konservi
      ekvilibron per interna reguliga procezo (<ref tip="prt" cel="homeostazi.0o">homeostazio</ref>):
      <ekz>
        &ccirc;io postulas perfektegan reguligan sistemon, kiun la fama fiziologo <nom>Claude
        Bernard</nom> nomis la <tld/>o de la interna medio
        <fnt>
          <aut>Roebert Molimard</aut>
          <vrk><url ref="https://libro.ee/file.php?id=508"
              >La fumado</url></vrk>
          <lok>p. 24</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[se]</klr> <tld/>o perdas la eblecon kontra&ubreve;batali perturbojn rezultantajn
        el maljuni&gcirc;ado, organismo subi&gcirc;as do al malorganiza&jcirc;o, <klr>[t.e.]</klr> morto
        <fnt>
          <bib>SR</bib>
          <aut>Marian Mazur, trad. K. Siwicki</aut>
          <vrk>Cibernetikaj problemoj de la vivproceso</vrk>
          <lok>Scienca Revuo, nro 53-54/1964</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Hom&ouml;ostat</trd>
    <trd lng="en">homeostat</trd>
    <trd lng="fr">hom&eacute;ostat</trd>
    <trd lng="ru">&c_g;&c_o;&c_m;&c_je;&c_o;&c_s;&c_t;&c_a;&c_t;</trd>
    <trd lng="uk">&c_g;&c_o;&c_m;&c_je;&c_o;&c_s;&c_t;&c_a;&c_t;</trd>
  </snc>
</drv>

  </art>

