<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: nu.xml,v 1.29 2026/09/14 23:07:11 revo Exp $">
<kap>
   <ofc>*</ofc>
   <rad>nu</rad>
</kap>
<drv mrk="nu.0">
   <kap><ofc>*</ofc><tld/></kap>
   <snc mrk="nu.0.interjekcio">
     <dif>
       <ref tip="dif" cel="interj.0o.GRA">Interjekcio</ref> servanta por
       kura&gcirc;igi a&ubreve; atentigi pri io sekvanta:
       <ekz>
         <ind><tld/>, a&ubreve;skultu la finon</ind>;
         <trd lng="fi">kuunteles nyt loppuun</trd>
       </ekz>
       <ekz>
        <tld/>, &ccirc;u vi perdis la kura&gcirc;on
        <fnt>
          <bib>Fab1</bib>
          <lok>La virineto de maro</lok>
        </fnt>?
      </ekz>
      <ekz>
        <tld/>, kiel la afero iras
        <fnt>
          <bib>Fab2</bib>
          <lok>Malbela anasido</lok>
        </fnt>?
      </ekz>
      <ekz>
        <tld/>, nu, nur ne tro da sinla&ubreve;do
        <fnt>
          <bib>Fab2</bib>
          <lok>Flikilo</lok>
        </fnt>!
      </ekz>
     </dif>
     <refgrp tip="vid">
      <ref cel="ek.0">ek!</ref>
    </refgrp>
     <trdgrp lng="de">
       <trd>nu!</trd>,
       <trd>na!</trd>
     </trdgrp>
     <trd lng="es">eh bien</trd>
     <trd lng="fr">eh bien</trd>
     <trd lng="hu">na</trd>
   </snc>
   <snc mrk="nu.0.konjunkcio">
     <dif>
       <ref tip="dif" cel="konjun.0o.GRA">Konjunkcio</ref> servanta por
       enkonduki novan fakton kaj speciale la duan
       propozicion de silogismo:
       <ekz>
        <tld/>, se Kristo estas predikata, ke li relevi&gcirc;is el la mortintoj, kiel do
        diras kelkaj el vi, ke ne ekzistas relevi&gcirc;o de mortintoj
        <fnt>
          <bib>NT</bib>
          <lok>I. Korintanoj 15:12</lok>
        </fnt>?
      </ekz>
      <ekz>
        <tld/>, nun vi plu ne amuzos vin pri mi
        <fnt>
          <bib>Fab1</bib>
          <lok>Malgranda Niko kaj granda Niko</lok>
        </fnt>!
      </ekz>
      <ekz>
        tio ne estas spioni, &ccirc;ar, <tld/>, mi rajtas iri al iu ajn restoracio, kaj se
        homoj parolas en publika loko kaj mi a&ubreve;das, ne estas mia kulpo, &ccirc;u
        <fnt>
          <bib>ChB</bib>
          <lok>22</lok>
        </fnt>?
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>nun</trd>,
      <trd>hm</trd>,
      <trd>nu ja</trd>,
      <trd>na ja</trd>
     </trdgrp>
     <trd lng="es">ahora bien</trd>
     <trd lng="fr">or</trd>
     <trdgrp lng="hu">
       <trd>nos</trd>,
       <trd>h&aacute;t</trd>
     </trdgrp>
  </snc>
  <refgrp tip="vid">
    <ref cel="do.0">do</ref>,
    <ref cel="ja.0">ja</ref>
  </refgrp>
  <rim>
    Rilate al la interjekcia senco oni povas sekvigi senpere la vorton
    <tld/> per krisigno (!) a&ubreve; tripunkto (...), por pli bone distingi &gcirc;in de la
    konjunkcia senco.
  </rim>
  <trd lng="be">&c_n;&c_u;</trd>
  <trdgrp lng="cs">
    <trd>no</trd>,
    <trd>inu</trd>,
    <trd>bodej&tcaron;</trd>,
    <trd>nu</trd>,
    <trd>nu&zcaron;e</trd>
  </trdgrp>
  <trd lng="en">well</trd>
  <trdgrp lng="fi">
     <trd>no</trd>,
     <trd>-<ind>han, -h&auml;n</ind></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x3055;&#x3066;&#x305D;&#x3053;&#x3067;</trd>,
    <trd>&#x3068;&#x3053;&#x308D;&#x3067;</trd>
  </trdgrp>
  <trdgrp lng="nl">
   <trd>nu</trd>,
   <trd>wel</trd>,
   <trd>welnu</trd>
  </trdgrp>
  <trd lng="pl">no,...</trd>
  <trd lng="pt">ora</trd>
  <trd lng="ru">&c_n;&c_u;</trd>
  <trdgrp lng="sk">
   <trd>mus&iacute;me kon&scaron;tatova&tcaron;</trd>,
   <trd>nu&zcaron;</trd>
  </trdgrp>
  <trdgrp lng="sv">
   <trd>n&aring;</trd>,
   <trd>n&aring;v&auml;l</trd>
  </trdgrp>
  <trd lng="tok">a</trd>
  <trd lng="uk">&c_n;&c_u;</trd>
</drv>
</art>
