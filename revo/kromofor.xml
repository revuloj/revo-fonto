<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: kromofor.xml,v 1.1 2026/11/08 18:04:27 afido Exp $">
    <kap>
      <rad>kromofor</rad>/o <fnt><bib>PIV1</bib></fnt>,
      <var><kap><rad var="hx">&hcirc;romofor</rad>/o</kap></var>
    </kap>

<drv mrk="kromofor.0o">
  <kap><tld/>o, <var><kap><tld var="hx"/>o</kap></var></kap>
  <uzo tip="fak">KEM</uzo>
  <snc mrk="kromofor.0o.KEM">
    <dif>
      Parto de substanco, molekulo, pigmento, kiu ka&ubreve;zas la kolorecon; kolorportanto:
      <ekz>
        retinalo estas vidpigmenta <tld var="hx"/>o en &ccirc;iuj animaloj krom kelkaj fi&scirc;oj, kies
        <tld var="hx"/>o estas dehidroretinalo
        <fnt>
          <bib>SR</bib>
          <aut>Nikolaj I. &Scirc;igajev k.a.</aut>
          <vrk>Interago de vitamino A kaj imunostimuliloj</vrk>
          <lok>Scienca Revuo, nro 160/1992</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Chromophor</trd>
    <trd lng="en">chromophore</trd>
    <trd lng="fr">chromophore</trd>
    <trd lng="ru">&c_h;&c_r;&c_o;&c_m;&c_o;&c_f;&c_o;&c_r;</trd>
    <trd lng="uk">&c_h;&c_r;&c_o;&c_m;&c_o;&c_f;&c_o;&c_r;</trd>
  </snc>
</drv>

  </art>


