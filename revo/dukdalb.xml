      <rad>dukdalb</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="dukdalb.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MAR</uzo>
  <snc>
    <dif>
      Tri, kvar <ref tip="prt" cel="fost.0o">fosto</ref>j kune enigitaj en la grundo de akvo por alligi &scirc;ipojn:
      <ekz>
        la mezuriloj <klr>[&#x2026;]</klr> povas esti fiksitaj ekzemple al fortikaj fostoj a&ubreve;
        <tld/>oj firme starantaj en la fundo
        <fnt>
          <bib>SR</bib>
          <aut>Nils Utne</aut>
          <vrk>Mezurado kaj statistika analizo de marondoj</vrk>
          <lok>Scienca Revuo, nro 129/1978</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Duckdalbe</trd>,
      <trd>Dalbe</trd>
    </trdgrp>
    <trd lng="en">dolphin <klr>(structure)</klr></trd>
    <trd lng="es">duques de alba</trd>
    <trd lng="fr">duc-d&#x2019;Albe</trd>
    <trd lng="uk">&c_r;&c_je;&c_j;&c_d;&c_o;&c_v;&c_i;&c_j; &c_p;&c_a;&c_l;</trd>
  </snc>
</drv>

  </art>


