<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: cenzor.xml,v 1.9 2026/10/02 12:08:41 revo Exp $">
<kap>
<rad>cenzor</rad>/o
</kap>
<drv mrk="cenzor.0o">
  <kap><tld/>o</kap>
  <snc>
  <uzo tip="fak">HIS</uzo>
  <uzo tip="fak">POL</uzo>
    <dif>
      Romia ofico. La du <tld/>oj havis komence (ekde 443 a.K.) la
      taskon preskribi popolnombradon kaj <ref cel="cens.0o">censadon</ref>, kaj sekve (pro
      Ovinia plebiscito en 312 a.K.) anka&ubreve; la taskon kontroli la
      senatanojn kaj la &scirc;tatan administradon:
      <ekz>
        Katono la <tld lit="C"/>o;
      </ekz>
      <ekz>
        fratinoj de Cezaro <klr>[&#x2026;]</klr> edzini&gcirc;is al senatoroj <klr>[&#x2026;]</klr> kelkaj
        membroj de la familio fari&gcirc;is konsuloj a&ubreve; cenzoroj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=1929"
              >Julio Cezaro</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="cens.0isto">censisto</ref>
    <trd lng="be">&c_c;&c_e;&c_n;&c_z;&c_a;&c_r;</trd>
    <trd lng="ca">censor</trd>
    <trdgrp lng="cs">
      <trd>censor</trd>,
      <trd>cenzor</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Censor</trd>,
      <trd>Zensor</trd>
    </trdgrp>
    <trd lng="en">censor<klr> (Roman office)</klr></trd>
    <trd lng="fr">censeur</trd>
    <trd lng="it">censore</trd>
    <trd lng="pl">cenzor</trd>
    <trd lng="sk">cenzor</trd>
  </snc>
  <snc mrk="cenzor.0o.cenzuristo">
    <uzo tip="stl">EVI</uzo>
    <dif>
      <ref tip="dif" cel="cenzur.0isto">Cenzuristo</ref>:
      <ekz>
        oni rakontas, ke la <tld/>o estis feli&ccirc;e amiko de la patro Zamenhof, li permesis
        publikigi la bro&scirc;uron, konsiderante &gcirc;in nedan&gcirc;era sensenca&jcirc;o
        <fnt>
          <aut>Adam Zakrzewski</aut>
          <vrk><url ref="https://eo.wikisource.org/wiki/Historio_de_Esperanto/I-a_Epoko"
              >Historio de Esperanto</url></vrk>
          <lok>p. 27</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
</drv>
</art>

