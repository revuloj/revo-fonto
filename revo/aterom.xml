<drv mrk="aterom.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc>
    <dif>
      Nenormala akumula&jcirc;o en &ccirc;e la interna vando de sangujo:
      <ekz>
        fero ludas gravan rolon en la <tld/>a kresko
        <fnt>
          <bib>SR</bib>
          <aut>Anthony Lucas</aut>
          <vrk>Fera homeostazio, aterosklerozo kaj iskemia kardia malsano</vrk>
          <lok>Scienca Revuo, nro 231/2014</lok>
        </fnt>;
      </ekz>
      <ekz>
        proksime a&ubreve; en la <tld/>a plako okazas mikrohemoragioj pro rompo da mikrovaskuloj
        <fnt>
          <bib>SR</bib>
          <aut>Anthony Lucas</aut>
          <vrk>Fera homeostazio, aterosklerozo kaj iskemia kardia malsano</vrk>
          <lok>Scienca Revuo, nro 231/2014</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Atherom</trd>,
      <trd>lipidreicher <ind>Plaque</ind></trd>
    </trdgrp>
    <trd lng="en">atheroma</trd>
    <trd lng="fr">ath&eacute;rome</trd>
  </snc>
</drv>

  </art>


