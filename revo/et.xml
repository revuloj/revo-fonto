<subart>
<drv mrk="et._0">
  <kap>-<tld/></kap>
  <snc mrk="et._0.sufikso">
    <dif>
      <ref tip="super" cel="sufiks.0o">Sufikso</ref> esprimanta rimarkinde malaltan <ref
      cel="grad.0o">grado</ref>n de grandeco
      a&ubreve; intenseco, ofte kun specialigo de la radikvorta ideo:
      <ekz>
        en nia lando sin ne trovas montoj, sed nur mont<tld/>oj
        <fnt>
          <bib>F</bib>
          <lok>&FE; 38</lok>
        </fnt>;
      </ekz>
      <ekz>
        ili prenis &scirc;tonojn kaj faris mont<tld/>on
        <fnt>
          <bib>MT</bib>
          <lok>&Gen; 31:46</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur lia viza&gcirc;o mi vidis &gcirc;ojan rid<tld/>on
        <fnt>
          <bib>F</bib>
          <lok>&FE; 38</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi sidas sur se&gcirc;o kaj tenas la piedojn sur benk<tld/>o
        <fnt>
          <bib>F</bib>
          <lok>&FE; 26</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi a&ccirc;etis por la infanoj tabl<tld/>on kaj kelke da se&gcirc;<tld/>oj
        <fnt>
          <bib>F</bib>
          <lok>&FE; 38</lok>
        </fnt>;
      </ekz>
      <ekz>
        dornarb<tld/>o
        <fnt>
          <bib>NT</bib>
          <lok>&Mat; 7:16</lok>
        </fnt>;
      </ekz>
      <ekz>
        bru<tld/>o de falanta folio
        <fnt>
          <bib>MT</bib>
          <lok>&Lev; 26:36</lok>
        </fnt>;
      </ekz>
      <ekz>
        iom<tld/>o da verda&jcirc;o
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro 1a</lok>
        </fnt>;
      </ekz>
      <ekz>
        verd<tld/>a a&ubreve; ru&gcirc;<tld/>a
        <fnt>
          <bib>MT</bib>
          <lok>&Lev; 13:49</lok>
        </fnt>;
      </ekz>
      <ekz>
        li sidis en malvarm<tld/>a &ccirc;ambr<tld/>o
        <fnt>
          <bib>MT</bib>
          <lok>&Jug; 3:20</lok>
        </fnt>;
      </ekz>
      <ekz>
        ili vidis la knab<tld/>on kun lia patrino <nom>Maria</nom>, kaj adorklini&gcirc;is al li
        <fnt>
          <bib>NT</bib>
          <lok>&Mat; 2:11</lok>
        </fnt>;
      </ekz>
      <ekz>
        kial vi rigardas la ligner<tld/>on en la okulo de via frato, kaj ne pripensas la
        trabon en via okulo
        <fnt>
          <bib>NT</bib>
          <lok>&Mat; 7:3</lok>
        </fnt>?
      </ekz>
      <ekz>
        donac<tld/>oj subtenas amikecon
        <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        hejma dom<tld/>o estas kiel patrin<tld/>o
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        oni komencas per &scirc;tel<tld/>oj kaj finas per &scirc;telegoj
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        river<tld/>oj fluas al riveroj
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        dronanto e&ccirc; herb<tld/>on kaptas avide
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        malgranda bird<tld/>o, sed akra ung<tld/>o
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        ne &ccirc;iu paper<tld/>o estas banka bileto
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        por paro amanta &ccirc;iu lok<tld/>o sufi&ccirc;as
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        nenia pek<tld/>o restas longe sekreto
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        tio estas lia amata <ref cel="cxeval.0eto.FIG">&ccirc;eval<tld/>o</ref>
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i <klr>[&#8230;]</klr> kudris malgrandan bel<tld/>an sak<tld/>on, kiun &scirc;i plenigis
        per delikata poligona grio
        <fnt>
          <bib>Fab1</bib>
          <lok>Fajrilo</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur la musko bril<tld/>is per verd<tld/>a lumo pli ol cent lampiroj
        <fnt>
          <bib>Fab1</bib>
          <lok>Sova&gcirc;aj cignoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiel dense, kiel rafan<tld/>oj en fasko
        <fnt>
          <bib>Fab1</bib>
          <lok>Vojkamarado</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="ant" cel="eg">-eg</ref>
    <rim num="1">
      <em>-et</em> estas ofte (mis)uzata kun karesa senco,
      anstata&ubreve;
      <em>-&ccirc;j</em>, <em>-nj</em>:
      <ekz>
        patr<tld/>o kaj patrin<tld/>o
        <fnt><bib>Fab2</bib>, <lok>Avineto</lok></fnt>.
      </ekz>
    </rim>
    <rim num="2">
      Vd <ref cel="eg.0.RIM">rimarkon &ccirc;e -eg</ref>.
    </rim>
  </snc>
  <trd lng="be">&c_a;&c_f;&c_ib;&c_k;&c_s; &c_d;&c_l;&c_ja;
  &c_v;&c_y;&c_r;&c_a;&c_zh;&c_e;&c_n;&c_mol;&c_n;&c_ja;
