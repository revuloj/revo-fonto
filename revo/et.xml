  </trdgrp>
  <trdgrp lng="id">
    <trd>agak</trd>,
    <trd>sedikit</trd>,
    <trd><baz>kecil</baz>... kecil</trd>
  </trdgrp>
  <trd lng="io">-et</trd>
  <trdgrp lng="nl">
    <trd>-<ind>je</ind></trd>,
    <trd>-<ind>tje</ind></trd>,
    <trd>-<ind>mpje</ind></trd>,
    <trd>-<ind>pje</ind></trd>,
    <trd>-<ind>etje</ind></trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>-<ind>inho</ind></trd>,
    <trd>-<ind>inha</ind></trd>,
    <trd>-<ind>ico</ind> <klr> (sufixo que forma o
    diminutivo)</klr></trd>
  </trdgrp>
  <trd lng="sgn" kod="M543x551S1eb20519x532S2ff00482x483S36d00479x527">O@10</trd>
