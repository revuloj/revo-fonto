<subart>
<drv mrk="et.0_">
  <kap><tld/>-</kap>
  <snc mrk="et.0_.prefikso">
    <dif>
      <ref tip="super" cel="prefik.0o">Prefikso</ref> esprimanta malgrandecon, malvastecon
      de la speco a&ubreve; skalo al kiu apartenas la koncernato:
      <ekz>
        <ind><tld/>komerco</ind>
        <fnt>
          <vrk><url
          ref="https://www.marxists.org/esperanto/marx-engels/engelso-logado.pdf">Frederiko Engelso
          Pri la lo&gcirc;ejproblemo</url></vrk>
        </fnt>;
        <trdgrp lng="ca">
          <trd>comer&ccedil; al detall</trd>,
          <trd>comer&ccedil; a la menuda</trd>
        </trdgrp>
        <trdgrp lng="de">
          <trd>Kleinhandel</trd>,
          <trd>Einzelhandel</trd>
        </trdgrp>
        <trd lng="id"><baz>ecer</baz>pengecer</trd>
      </ekz>
      <ekz>
        pundomoneroj estis falsataj <tld/>skale fare de malgrandaj falsistoj
        <fnt>
          <bib>Monato</bib>
          <aut>DJ Cane</aut>
          <vrk><url ref="&Monato;/2012/010564.php">Monfalsada ekonomio</url></vrk>
          <lok>2012</lok>
        </fnt>;
      </ekz>
      <ekz>
        japanoj fari&gcirc;is ri&ccirc;aj, sed ilia psi&hcirc;ologio restas tipe <tld/>bur&gcirc;a
        <fnt>
          <bib>Monato</bib>
          <aut>Yamasaki Seik&ocirc;</aut>
          <vrk><url ref="&Monato;/2007/009290.php">Busoj, biciklantoj kaj kavaliraj
          kutimoj</url></vrk>
          <lok>2007</lok>
        </fnt>;
      </ekz>
      <ekz>
        nu, la <ind><tld/>bur&gcirc;o</ind> estas fifantazia&jcirc;o jam de <nom>Marks</nom> kaj poste de
        <nom>Lenin</nom>
        <fnt>
          <vrk><url
          ref="https://karapacopanoramo.blogspot.com/2018/06/hans-georg-kaiser-kio-estas-etburgo-eseo.html#!">Hans-Georg
          Kaiser: Kio estas etbur&gcirc;o? (eseo)</url></vrk>
        </fnt>;
        <trd lng="ca">petitburg&egrave;s</trd>
        <trd lng="de">Kleinb&uuml;rger</trd>
        <trd lng="hu">kispolg&aacute;r</trd>
        <trdgrp lng="id">
          <trd>rakyat kecil</trd>,
          <trd>rakyat jelata</trd>,
          <trd>warga kelas bawah</trd>
        </trdgrp>
        <trd lng="ru">&c_m;&c_je;&c_l;&c_k;&c_i;&c_j;
      &c_b;&c_u;&c_r;&c_zh;&c_u;&c_a;</trd>
      </ekz>
      <ekz>
        konservativa <tld/>bur&gcirc;aro
        <fnt>
          <bib>Monato</bib>
          <aut>Jomo Ipfelkofer</aut>
          <vrk><url ref="&Monato;/2010/010199.php">Volo de la popolo</url></vrk>
          <lok>2010</lok>
        </fnt>;
      </ekz>
      <ekz>
        kia kverelema li estis kaj <ind><tld/>anima</ind>
        <klr>(<ref cel="bagate.0ema">bagatelema</ref>,
        <ref cel="indulg.sen0a">senindulga</ref>)</klr>
        <fnt>
          <vrk><url
          ref="https://lek.esperanto.sk/2018.12.15_PosxRakontoj/TEKSTOJ-TEXTY/47%20ASIZANO.pdf">Asizano
          47 Porotce</url></vrk>
        </fnt>;
        <trdgrp lng="ca">
          <trd>estret de mires</trd>,
          <trd>curt de mires</trd>,
          <trd>estret de front</trd>,
          <trd>mesqu&iacute;</trd>
        </trdgrp>
        <trdgrp lng="de">
          <trd>kleinlich</trd>,
          <trd>kleingeistig</trd>,
          <trd>pedantisch</trd>
        </trdgrp>
        <trdgrp lng="id">
          <trd>picik</trd>,
          <trd>sempit pikiran</trd>
        </trdgrp>
      </ekz>
      <ekz>
        la punktokomo estas sub mia dekstra <ind><tld/>fingro</ind>
       <fnt>
          <aut>E. Grimley Evans</aut>,
          <vrk><url ref="&Monato;/2000/006801.html">
          Interreto: uniksulo ekspertas Unikodon</url></vrk>,
          <bib>Monato</bib>
          <lok>2000/02, p. 20</lok>
        </fnt>;
        <trdgrp lng="ca">
          <trd>dit petit</trd>,
          <trd>dit xic</trd>,
          <trd>dit xicotet</trd>,
          <trd>dit menut</trd>,
          <trd>dit auricular</trd>,
          <trd>menovell</trd>
        </trdgrp>
      </ekz>
      <ekz>
        muel&scirc;tonoj kutime estas el <tld/>grajna firma sablo&scirc;tono a&ubreve; kalko&scirc;tono
        <fnt>
          <vrk><url ref="&Viki;/Muel%C5%9Dtono">Muel&scirc;tono - Vikipedio</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      Per tiu &ccirc;i neordinara pse&ubreve;doprefiksa kunmeto oni reliefigas la
      abstraktecon de la <tld/>eco, rilatigas &gcirc;in ne al la koncernato mem, sed
      al la karakteriza trajto.
      <ekz>
        <tld lit="E"/>bur&gcirc;o
      </ekz>
      ne estas malaltstatura bur&gcirc;o,
      sed homo kies bur&gcirc;eco estas malaltranga;
      <ekz>
        <tld/>fingro
      </ekz>
      de viro povas esti pli granda ol ajna
      fingro de knabo.
    </rim>
  </snc>
  <trd lng="be">&c_d;&c_r;&c_o;&c_b;&c_n;&c_a;-</trd>
  <trd lng="ca">petit</trd>
  <trd lng="en">small-</trd>
  <trd lng="hu">kis-</trd>
  <trd lng="ru">&c_m;&c_je;&c_l;&c_k;&c_o;-</trd>
</drv>
</subart>

