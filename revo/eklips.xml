<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: eklips.xml,v 1.35 2026/09/12 15:33:29 revo Exp $">
<kap>
   <ofc>3</ofc>
   <rad>eklips</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="eklips.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">AST</uzo>
  <snc>
    <dif>
      Neda&ubreve;ra &scirc;ajna malapero de <ref cel="astr.0o.AST">astro</ref>:
      <ekz>
        parta, plena <tld/>o de la suno.
      </ekz>
      <ekz>
        pereu la tago, en kiu mi naski&gcirc;is <klr>[&#8230;]</klr> nubo &gcirc;in kovru, eklipsoj de
        tago faru &gcirc;in terura
        <fnt>
          <bib>MT</bib>
          <lok>Ijob 3:5</lok>
        </fnt>;
      </ekz>
      <ekz>
        spertulo, kiu volis kompari kalkulojn pri venonta <tld/>o kun similaj kalkuloj,
        faritaj de Babelaj astronomoj
        <fnt>
          <bib>I&scirc;tar</bib>
        </fnt>;
      </ekz>
      <ekz>
        la 29an de marto 2006 okazis en Togolando <tld/>o de la suno
        <fnt>
          <bib>Monato</bib>
          <aut>Gbeglo Koffi</aut>
          <vrk><url ref="&Monato;/2006/008948.php">Konfuzo kaj kontra&ubreve;diroj</url></vrk>
          <lok>2006</lok>
        </fnt>;
      </ekz>
      <ekz>
        estos, por la &scirc;atantoj de astronomio, anka&ubreve; kelke da lun-<tld/>oj
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2013/010945.php">Ne &ccirc;io brilanta estas diamanto</url></vrk>
          <lok>2013</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        e&ccirc; grandaj presti&gcirc;aj lingvoj estas minacataj kaj perdas sian iaman statuson
        <klr>[&#8230;]</klr> strange, pluraj popoloj kaj &scirc;tatoj &scirc;ajnas bonvenigi tiun
        <tld/>on de siaj lingva graveco kaj kultura influo
        <fnt>
          <bib>Monato</bib>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2007/009227.php">Lingva diverseco</url></vrk>
          <lok>2007</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_z;&c_a;&c_c;&c_mol;&c_m;&c_je;&c_n;&c_mol;&c_n;&c_je;</trd>
  <trd lng="ca">eclipsi</trd>
  <trd lng="cs">zatm&ecaron;n&iacute;</trd>
  <trdgrp lng="de">
     <trd>Finsternis</trd>,
     <trd>Verfinsterung</trd>,
     <trd>Verdunkelung</trd>,
     <trd>Verdeckung</trd>
   </trdgrp>
  <trd lng="en">eclipse</trd>
  <trd lng="es">eclipse</trd>
  <trd lng="fa">&f_g;&a_r;&a_f;&a_t;</trd>
  <trd lng="fr">&eacute;clipse</trd>
  <trdgrp lng="hu">
     <trd>els&ouml;t&eacute;t&uuml;l&eacute;s</trd>,
     <trd>fogyatkoz&aacute;s</trd>,
     <trd>eklipszis</trd>
   </trdgrp>
  <trdgrp lng="id">
    <trd>gerhana</trd>,
    <trd>eklips</trd>
  </trdgrp>
  <trd lng="ja">&#x98DF;  <pr>&#12375;&#12423;&#x304F;</pr></trd>
  <trd lng="pl">za&cacute;mienie</trd>
  <trd lng="pt">eclipse</trd>
  <trd lng="ru">&c_z;&c_a;&c_t;&c_m;&c_je;&c_n;&c_i;&c_je;</trd>
  <trd lng="sk">zatmenie</trd>
  <trd lng="sv">f&ouml;rm&ouml;rkelse</trd>
  <trd lng="uk">&c_z;&c_a;&c_t;&c_je;&#x43C;&#x43D;&c_je;&#x43D;&#x43D;&#x44F;</trd>
</drv>

<drv mrk="eklips.0a">
   <kap><tld/>a</kap>
   <snc>
     <dif>
      Rilata al <tld/>o:
      <ekz>
        <uzo tip="stl">FIG</uzo>
        evidenti&gcirc;as nur kulmino de nesolvebla krizo, eble <tld/>a punkto
        <fnt>
          <bib>Monato</bib>
          <aut>Franz-Georg R&ouml;ssler</aut>
          <vrk><url ref="&Monato;/2015/011534.php">Simpla kalkulo</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
     </dif>
     <trd lng="be">&c_z;&c_a;&c_c;&c_mol;&c_m;&c_je;&c_n;&c_je;&c_v;&c_y;</trd>
     <trd lng="ca">ecl&iacute;ptic</trd>
     <trd lng="pl">za&cacute;mieniowy</trd>
     <trd lng="ru">&c_z;&c_a;&c_t;&c_m;&c_je;&c_n;&c_n;&c_y;&c_j;</trd>
   </snc>
<!--
   <snc>
     <dif>
       Prezentanta serion da mallongaj lumbriloj:
       <ekz>
         <uzo tip="fak">MAR</uzo>
         <tld/>a lumturo.
       </ekz>
     </dif>
     <trd lng="be">&c_p;&c_r;&c_o;&c_b;&c_l;&c_ib;&c_s;&c_k;&c_a;&c_v;&c_y;</trd>
     <trd lng="ca">intermitent</trd>
     <trd lng="pl">b&lstroke;yskowy</trd>
     <trd lng="ru">&c_p;&c_r;&c_o;&c_b;&c_l;&c_je;&c_s;&c_k;&c_o;&c_v;&c_y;&c_j;</trd>
     <trd lng="fr">&eacute;cliptique</trd>
   </snc>
-->
  <ref tip="vid" cel="interm.0a">intermita</ref>
  <trd lng="id">ekliptis</trd>
  <trd lng="ja">&#x98DF;&#x306E;  <pr>&#12375;&#12423;&#x304F;&#x306E;</pr></trd>
</drv>

<drv mrk="eklips.0i">
   <kap><tld/>i</kap>
   <gra><vspec>tr</vspec></gra>
   <snc mrk="eklips.0i.sxirmi">
     <uzo tip="fak">AST</uzo>
     <dif>
       Neda&ubreve;re <ref tip="super" cel="kasx.0i.de_okulo">ka&scirc;i</ref>
       <ref tip="super" cel="sxirm.0i.kovri">&scirc;irmante</ref>
       la vidon:
       <ekz>
         la luno <tld/>is la sunon.
       </ekz>
     </dif>
     <trd lng="de">verfinstern</trd>
     <trdgrp lng="hu">
       <trd>eltakar</trd>,
       <trd>&aacute;rny&eacute;kba bor&iacute;t</trd>
     </trdgrp>
     <trd lng="id"><baz>bayang</baz>membayangi</trd>
     <trdgrp lng="pl">
       <trd>za&cacute;miewa&cacute;</trd>,
       <trd>przes&lstroke;ania&cacute;</trd>
     </trdgrp>
   </snc>
  <snc mrk="eklips.0i.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      &Scirc;ajnigi malpli rimarkinda la superecon de iu pro
      sia propra supereco:
      <ekz>
        li vivis en Vieno, furoris, kiel virtuozo de la pompaj koloroj, sed lia valoro
        tuj post la morto <tld/>i&gcirc;is
        <fnt>
          <bib>SatirRak</bib>
        </fnt>;
      </ekz>
      <ekz>
        per la kvalito de siaj man&gcirc;a&jcirc;oj Gribojedovo tute <tld/>is &ccirc;iun ajn restoracion
        en Moskvo
        <fnt>
          <bib>MkM</bib>
        </fnt>;
      </ekz>
      <ekz>
        preska&ubreve; &ccirc;iam dominas la ekonomio, kiu anka&ubreve; &ccirc;i-foje <tld/>is aliajn temojn
        <fnt>
          <bib>Monato</bib>
          <aut>Isikawa Takasi</aut>
          <vrk><url ref="&Monato;/2013/011113.php">Denove nuklee</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
     <trd lng="de">in den <ind>Schatten</ind> stellen</trd>
     <trd lng="en">surpass</trd>
     <trd lng="hu">a <ind>h&aacute;tt&eacute;rbe
     szor&iacute;t</ind></trd>
     <trdgrp lng="id">
       <trd><baz>lampau</baz>melampaui</trd>,
       <trd><baz>unggul</baz>mengungguli</trd>,
       <trd><baz>lebih</baz>melebihi</trd>,
       <trd><baz>lewat</baz>melewati</trd>
     </trdgrp>
     <trdgrp lng="pl">
       <trd>za&cacute;miewa&cacute;</trd>,
       <trd>przy&cacute;miewa&cacute;</trd>
     </trdgrp>
    <trd lng="zh">&#x65E5;&#34432; <pr>r&#xEC;sh&#xED;</pr></trd>
</snc>
  <trd lng="be">&c_z;&c_a;&c_c;&c_mol;&c_m;&c_ib;&c_c;&c_mol;</trd>
  <trd lng="ca">eclipsar</trd>
  <trdgrp lng="cs">
    <trd>zatemnit</trd>,
    <trd>zatem&ncaron;ovat</trd>
  </trdgrp>
  <trd lng="en">eclipse</trd>
  <trd lng="es">eclipsar</trd>
  <trd lng="fr">&eacute;clipser</trd>
  <trd lng="he">&lamed;&lamed;&qof;&vav;&tav;</trd>
  <trdgrp lng="ja">
    <trd>&#x98DF;&#12377;&#x308B;  <pr>&#12375;&#12423;&#x304F;&#12377;&#x308B;</pr></trd>,
    <trd>&#35206;&#12356;&#x96A0;&#12377;  <pr>&#x304A;&#x304A;&#12356;&#x304B;&#x304F;&#12377;</pr></trd>,
    <trd>&#x8F1D;&#x304D;&#12434;&#x596A;&#12358;  <pr>&#x304B;&#x304C;&#12420;&#x304D;&#12434;&#12358;&#12400;&#12358;</pr></trd>,
    <trd>&#22311;&#20498;&#12377;&#x308B;  <pr>&#12354;&#12387;&#12392;&#12358;&#12377;&#x308B;</pr></trd>
  </trdgrp>
  <trdgrp lng="ru">
     <trd>&c_z;&c_a;&c_t;&c_m;&c_je;&c_v;&c_a;&c_t;&c_mol;</trd>,
     <trd>&c_z;&c_a;&c_t;&c_m;&c_i;&c_t;&c_mol;</trd>
   </trdgrp>
  <trd lng="sk">zatemni&tcaron;</trd>
  <trdgrp lng="uk">
    <trd>&c_z;&c_a;&c_t;&c_je;&#x43C;&#x43D;&#x44E;&c_v;&c_a;&c_t;&c_i;</trd>,
    <trd>&c_z;&c_a;&c_t;&#x44C;&#x43C;&c_a;&c_r;&#x44E;&c_v;&c_a;&c_t;&c_i;</trd>
  </trdgrp>
</drv>

<drv mrk="eklips.lun0o">
  <kap>lun<tld/>o,
  <var><kap>luna <tld/>ejo</kap></var></kap>
  <snc mrk="eklips.lun0o.AST">
    <dif>Astronomia evento, kiam la <ref cel="ter.0o.planedo">Tero</ref>
            kovras sunlumon &gcirc;is malheli&gcirc;as la <ref cel="lun.0o.AST_tera">luno</ref>:
      <ekz><klr>...</klr> sed la astra dispozicio sur la &ccirc;ielo: 31 dec 2000 ne estis plenluno
                  (&gcirc;i, e&ccirc; kun lun<tld/>o, okazis 9 jan 2001)
        <fnt>
          <bib>LOdE</bib>
          <aut>Sergio Pokrovskij</aut>
          <vrk>Politike korekta evangelio</vrk>
          <lok></lok>
        </fnt>;
      </ekz>
      <ekz>kaj parte &ccirc;ar li vidis la cirklan ombron de la Tero
                sur la Luno dum lun<tld/>o
        <fnt>
          <bib>Internacia Kongresa Universitato 1997-2013</bib>
          <aut>Erik H&oslash;g</aut>
          <vrk>La profundo de la &ccirc;ielo &mdash; kredo kaj scio dum 2500 jaroj</vrk>
          <lok></lok>
        </fnt>;
      </ekz>
    </dif>
  </snc>
<trd lng="id">gerhana bulan</trd>
</drv>

<drv mrk="eklips.sun0o">
  <kap>sun<tld/>o,
  <var><kap>suna <tld/>ejo</kap></var></kap>
  <snc mrk="eklips.sun0o.AST">
    <dif>Astronomia evento, kiam la <ref cel="lun.0o.AST_tera">luno</ref>
            kovras sunlumon, parte a&ubreve; plene:
      <ekz>Taleso (&ccirc;. 6a jarcento a.K.) la&ubreve;dire prognozis la sun<tld/>on de 586 a.K.
        <fnt>
          <bib>Rsp</bib>
        </fnt>;
      </ekz>
      <ekz>15 minutojn post la sun<tld/>o mi ekokupi&gcirc;is pri la lingva enigmo
        <fnt>
          <bib>LOdE</bib>
          <lok>No. 10 (60)</lok>
        </fnt>;
      </ekz>
    </dif>
  </snc>
<trd lng="id">gerhana matahari</trd>
</drv>

<adm>
   ~o: &ccirc;u ne ekzistas figura senco (&scirc;ia populareco suferis
~ojn)?
   ~i FIG: &ccirc;u io ne povas ~i ion?
   <aut>MB</aut>
</adm>

</art>
