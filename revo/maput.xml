<drv mrk="maput.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      La <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&ccirc;efurbo</ref>
      de <ref tip="malprt" cel="mozambik.M0o">Mozambiko</ref>:
      situo: (<frm>25&#730;57&minute;S  32&#730;35&minute;E</frm>):
      <ekz>
        telegramo de la 13-a de julio 1987, subskribita de la franca ambasadoro en
        <tld/>o
        <fnt>
          <aut>Augusta Conchiglia</aut>
          <vrk><url ref="&Mondediplo;article2520.html">Kiu mortigis Samora Machel?</url></vrk>
          <lok>Le Monde diplomatique</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o havas modernan havenon, tra kiu oni eksportas karbon, kotonon, sukeron,
        kromon, sisalon, <klr>[&#8230;]</klr>
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=37087">Maputo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Maputo</trd>
    <trd lng="en">Maputo</trd>
    <trd lng="fr">Maputo</trd>
    <trd lng="pl">Maputo</trd>
    <trd lng="ro">Maputo</trd>
