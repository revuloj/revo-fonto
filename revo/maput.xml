  <trd lng="be">&c_M;&c_a;&c_p;&c_u;&c_t;&c_u;</trd>
  <trd lng="ca">Maputo</trd>
  <trd lng="es">Maputo</trd>
  <trd lng="ja">&#12510;&#12503;&#12540;&#12488;</trd>
  <trd lng="uk">&c_M;&c_a;&c_p;&c_u;&c_t;&c_u; (&c_s;&c_t;&c_o;&c_l;&c_i;&c_c;&c_ja;)</trd>
  <trdgrp lng="zh">
    <trd>&#39340;&#26222;&#25176; <pr>M&#462;p&#468;tu&#333;</pr></trd>,
    <trd>&#39532;&#26222;&#25176; <pr>M&#462;p&#468;tu&#333;</pr></trd>,
