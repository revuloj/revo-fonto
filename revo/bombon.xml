<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bombon.xml,v 1.30 2026/08/04 18:05:49 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>bombon</rad>/o
  <fnt><bib>UV</bib></fnt>,
  <var><kap><rad var="n">bonbon</rad>/o</kap></var>
</kap>

<drv mrk="bombon.0o">
  <kap><ofc>*</ofc><tld/>o, <var><kap><tld var="n"/>o</kap></var></kap>
  <snc mrk="bombon.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      Malgranda sukera&jcirc;o prenata kiel <ref tip="super" cel="frand.0ajxo.KUI">franda&jcirc;o</ref>:
      <ekz>
        manpleno da <tld/>oj
        <fnt>
          <bib>IK</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        kelkaj funtoj da <tld/>oj por miaj infanetoj
        <fnt><bib>FK</bib>, <lok>3, anekdotoj</lok></fnt>;
      </ekz>
      <ekz>
        ili estis karesitaj, dorlotitaj, ricevis donacojn, hodia&ubreve; <tld var="n"/>ojn, morga&ubreve; ian
        ludilon
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Sesa</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> prezentis al ili papersaketon kun &ccirc;okoladaj <tld/>oj de la plej
        bona speco
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        e&ccirc; unu su&ccirc;-<tld/>on mi ne trovis
        <fnt>
          <bib>LOdE</bib>
          <lok>2003, &#8470; 10 (108)</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[mi]</klr> trovis <klr>[&#8230;]</klr> en alia butiko dinosa&ubreve;rajn
        <ind>&jcirc;eleo-<tld/>o</ind>jn
        <fnt>
          <bib>Monato</bib>
          <vrk>Filmotondro</vrk>
          <lok>94/02</lok>
        </fnt>.
        <trd lng="de">Geleebonbon</trd>
      </ekz>
    </dif>
    <refgrp tip="sub">
      <ref cel="pastel.0o">pastelo</ref>,
      <ref cel="dragxe.0o">dra&gcirc;eo</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_c;&c_u;&c_k;&c_je;&c_r;&c_k;&c_a;</trd>
  <trd lng="br">madig</trd>
  <trdgrp lng="de">
    <trd>Bonbon</trd>,
    <trd>Drops</trd>
  </trdgrp>
  <trdgrp lng="en">
    <trd>bonbon</trd>,
    <trd>candy</trd>,
    <trd>sweet</trd>
  </trdgrp>
  <trd lng="es">caramelo</trd>
  <trd lng="fr">bonbon</trd>
  <trd lng="he">&samekh;&vav;&kaf;&resh;&yod;&he;</trd>
  <trdgrp lng="hu">
    <trd>bonbon</trd>,
    <trd>cukorka</trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>permen</trd>,
    <trd>gula-gula</trd>,
    <trd>kembang gula</trd>,
    <trd>bonbon</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30AD;&#x30E3;&#x30F3;&#x30C7;&#x30FC;</trd>,
    <trd>&#x30DC;&#x30F3;&#x30DC;&#x30F3;</trd>
  </trdgrp>
  <trd lng="nl">bonbon</trd>
  <trd lng="pl">cukierek</trd>
  <trd lng="pt">bombom</trd>
  <trd lng="ro">bomboan&abreve;</trd>
  <trd lng="ru">&c_k;&c_o;&c_n;&c_f;&c_je;&c_t;&c_a;</trd>
  <trd lng="sk">cukr&iacute;k</trd>
  <trd lng="uk">&c_c;&c_u;&c_k;&c_je;&c_r;&c_k;&c_a;</trd>
  <trd lng="zh">&#x7CD6;&#x679C; <pr>t&aacute;nggu&#x1D2;</pr></trd>
</drv>

<drv mrk="bombon.0ujo">
  <kap>
    <tld/>ujo
  </kap>
  <snc>
    <dif>
      Skatolo por konservado de <tld/>oj:
      <ekz>
        tabletoj portis sur si <klr>[&#8230;]</klr> &ccirc;izitajn <tld/>ujojn
        <fnt>
          <bib>Marta</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Bombonschachtel</trd>
</drv>

</art>
