    <trd>&#22871;&#38957;&#27611;&#34915; <pr>t&agrave;ot&oacute;um&aacute;oy&#299;</pr></trd>,
    <trd>&#32650;&#27611;&#34923; <pr>y&aacute;ngm&aacute;osh&amacron;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="pulover.kapucx0o">
  <kap>kapu&ccirc;<tld/>o</kap>
  <snc mrk="pulover.kapucx0o.TEKS">
    <uzo tip="fak">TEKS</uzo>
    <dif>
      <ref tip="lst" lst="voko:vesta&jcirc;oj" cel="pulover.0o">Pulovero</ref>
      provizita per kapu&ccirc;o:
      <ekz>
        li estas 24-jara, havas bluan kapu&ccirc;<tld/>on
        kaj bluan &gcirc;inzon
        <fnt>
          <aut>K. Kniivil&auml;</aut>
          <vrk>Homoj de Putin</vrk>
          <lok>2016</lok>
        </fnt>.
      </ekz>
    </dif>
    <bld lok="&WCU;/thumb/f/fc/Cory_Carroll.jpg/250px-Cory_Carroll.jpg" prm="CC BY-SA 3.0">pokerante
    en kapu&ccirc;<tld/>o, Cory Carroll, 2007
        <fnt>
          <aut>Photos by flipchip / LasVegasVegas.com,
          http://www.lasvegasvegas.com/viewer/v/2007WSOP/2007+WSOP+Day+4/Cory+Carroll.jpg.html</aut>
          <lok><url ref="&WCW;/File:Cory_Carroll.jpg">&WCW;/File:Cory_Carroll.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_h;&c_u;&c_d;&c_z;&c_ib;</trd>
  <trdgrp lng="ca">
    <trd>dessuadora amb caputxa</trd>,
    <trd>suadora amb caputxa</trd>
  </trdgrp>
  <trd lng="de">Kapuzenpulli</trd>
  <trd lng="en">hoodie</trd>
  <trd lng="fr">pullover &agrave; capuche</trd>
  <trd lng="pl">sweter z kapturem</trd>
  <trdgrp lng="zh">
    <trd>&#36830;&#24125;&#21355;&#34915; <pr>li&aacute;nm&agrave;ow&egrave;iy&#299;</pr></trd>,
    <trd>&#36899;&#24125;&#34907;&#34915; <pr>li&aacute;nm&agrave;ow&egrave;iy&#299;</pr></trd>,
    <trd>&#21355;&#34915; <pr>w&egrave;iy&#299;</pr></trd>,
    <trd>&#34907;&#34915; <pr>w&egrave;iy&#299;</pr></trd>
  </trdgrp>
</drv>

