<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: rift.xml,v 1.4 2026/11/16 09:34:52 afido Exp $">
<kap>
    <rad>rift</rad>/o <fnt><bib>PIV3</bib></fnt>
</kap>
<drv mrk="rift.0o">
  <kap><tld/>o</kap>
  <snc mrk="rift.0o.SNC">
    <uzo tip="fak">GEOL</uzo>
    <dif>
      Vasta kaj tre longa terkrusta malalta&jcirc;o, kiu ekestis iom post iom per tektonika disi&gcirc;o de du
      partoj de kontinenta plato:
      <ekz>
         la Granda <tld lit="R"/>o estas granda duobla geologia fendo (teknike nomata <tld/>o) en
         orienta Afriko.
        <fnt>
          <vrk><url ref="&Viki;/Rifto">Rifto - Vikipedio</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="vid" cel="fauxlt.0o.GEOL">fa&ubreve;lto</ref>
    <trd lng="de">Grabenbruch</trd>
  <trd lng="en">rift</trd>
  <trd lng="fr">rift</trd>
  <trd lng="nl">rift</trd>
  </snc>

  <snc mrk="rift.0o.FIG">

     <uzo tip="stl">FIG</uzo>
     <dif>
     Fendo, aparti&gcirc;o
     <ekz>
     la <tld/>o fari&gcirc;is nesuperebla post la malsukcesa pu&ccirc;o en aprilo 2002, pri kiu Ch&aacute;vez malka&scirc;e
     kulpigis la Blankan Domon
     <fnt>
        <aut>Jezer Dorante</aut>
        <vrk><url ref="&Monato;/publika/014026p.php">Venezuelo sub nova kuratoreco</url></vrk>
        <bib>Monato</bib>
        <lok>2026/13, p. 3</lok>
        </fnt>;
     </ekz>
     </dif>
     <trd lng="nl">breuk</trd>
     </snc>
</drv>
</art>

