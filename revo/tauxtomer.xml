<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: tauxtomer.xml,v 1.1 2026/11/20 20:41:59 afido Exp $">
    <kap>
      <rad>ta&ubreve;tomer</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="tauxtomer.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="izomer.0o">Izomero</ref>, kiu facile esti&gcirc;as el alia per religo
      de unopaj atomoj a&ubreve; atomgrupoj, t.e. amba&ubreve; estas en &hcirc;emia ekvilibro:
      <ekz>
        AT-molekulo havas 37 <tld/>ojn kaj resonancojn, GC-molekulo &mdash; 82
        <fnt>
          <bib>SR</bib>
          <aut>M. T. Popov</aut>
          <vrk>Formulo de la nativa DNA</vrk>
          <lok>Scienca Revuo, nro 137/1982</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a konduto de la vinila alkoholo; <klr>[&#x2026;]</klr> vinila alkoholo
        konverti&gcirc;as al acetaldehido oscilante inter la alkohola formo kaj aldehida
        strukturo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=632598"
              >Vinila alkoholo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Tautomer</trd>
    <trd lng="en">tautomer</trd>
    <trd lng="fr">tautom&egrave;re</trd>
    <trd lng="ru">&c_t;&c_a;&c_u;&c_t;&c_o;&c_m;&c_je;&c_r;</trd>
    <trd lng="uk">&c_t;&c_a;&c_u;&c_t;&c_o;&c_m;&c_je;&c_r;</trd>
  </snc>
</drv>

  </art>


