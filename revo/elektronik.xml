<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: elektronik.xml,v 1.23 2026/11/02 05:56:44 revo Exp $">
<kap>
  <ofc>8</ofc> <rad>elektronik</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="elektronik.0o">
  <kap><tld/>o</kap>
  <snc mrk="elektronik.0o.ELE">
    <uzo tip="fak">ELE</uzo>
    <dif>
      Studo de elektraj signaloj kaj arto konstrui ma&scirc;inojn per
      ili funkciantajn:
       <ekz>
        transistoro <klr>...</klr> estas la &ccirc;efa komponanto en
        &ccirc;ia moderna <tld/>o
        <fnt><bib>Viki</bib>, <lok>&leftquot;komputilo, artikolo de la
        monato&rightquot;, 2007-10-11</lok></fnt>.
      </ekz>
    </dif>
  <refgrp tip="sub">
   <ref cel="transistor.0o">transistoro</ref>,
   <ref cel="diod.0o">diodo</ref>,
   <ref cel="cirkvi.integra_0o">cirkvito integra</ref>,
   <ref cel="reosta.0o">reostato</ref>,
   <ref cel="konden.0o.ELE">kondensatoro</ref>,
   <ref cel="indukt.il0o.ELE">induktilo</ref>,
   <ref cel="form.trans0ilo">transformilo</ref>,
   <ref cel="rekt.0igilo">rektigilo</ref>,
   <ref cel="konekt.0ilo">konektilo</ref>,
   <ref cel="konduk.0ilo.ELE">kondukilo</ref>,
   <ref cel="skem.konekto0o">konektoskemo</ref>,
   <ref cel="kart.cirkvit0o">cirkvitkarto</ref>
  </refgrp>
  </snc>
  <trd lng="be">&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_n;&c_ib;&c_k;&c_a;</trd>
  <trd lng="cs">elektronika</trd>
  <trd lng="de">Elektronik</trd>
  <trd lng="en">electronics</trd>
  <trd lng="fa">&a_A;&a_l;&f_k;&a_t;&a_r;&a_w;&a_n;&f_y;&f_k;</trd>
  <trd lng="fr">&eacute;lectronique<klr> (subst.)</klr></trd>
  <trd lng="id">elektronika</trd>
  <trdgrp lng="ja">
    <trd>&#12456;&#12524;&#12463;&#12488;&#12525;&#12491;&#12463;&#12473;</trd>,
    <trd>&#38651;&#23376;&#24037;&#23398;  <pr>&#12391;&#12435;&#12375;&#12371;&#12358;&#12364;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="pl">elektronika</trd>
  <trd lng="pt">eletr&ocirc;nica</trd>
  <trd lng="sk">elektronika</trd>
  <trd lng="uk">&c_je;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_n;&c_ib;&c_k;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#30005;&#23376;&#23398; <pr>di&agrave;nz&#464;xu&eacute;</pr></trd>,
    <trd>&#30005;&#23376;&#25216;&#26415; <pr>di&agrave;nz&#464;j&igrave;sh&ugrave;</pr></trd>,
    <trd>&#30005;&#23376;&#35013;&#32622; <pr>di&agrave;nz&#464;zhu&amacron;ngzh&igrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="elektronik.0a">
  <kap><tld/>a</kap>
  <snc mrk="elektronik.0a.ELE">
    <dif>
      Funkcianta per elektraj signaloj a&ubreve; iel rilata al <tld/>o:
       <ekz>
        iaj <tld/>aj drumoj havas platojn <klr>...</klr> anstata&ubreve;
        cimbaloj
        <fnt><bib>RokPop</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: (krom en okazoj kiam &gcirc;i signifas: funkcianta per elektraj signaloj
    a&ubreve; iel rilata al <tld/>o; la&ubreve; la kunteksto) prefere diru <ke>elektrona</ke>,
    <ke>elektronscienca</ke>, <ke>komputila</ke>.
  </rim>

  <trd lng="be">&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_n;&c_n;&c_y;</trd>
  <trd lng="de">elektronisch</trd>
  <trd lng="en">electronic</trd>
  <trd lng="fa">&a_A;&a_l;&f_k;&a_t;&a_r;&a_w;&a_n;&f_y;&f_k;&f_y;</trd>
  <trd lng="fr">&eacute;lectronique<klr> (adj.)</klr></trd>
  <trdgrp lng="id">
    <trd>elektronis</trd>,
    <trd>elektronik</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#38651;&#23376;&#24037;&#23398;&#12398;  <pr>&#12391;&#12435;&#12375;&#12371;&#12358;&#12364;&#12367;&#12398;</pr></trd>,
    <trd>&#38651;&#23376;&#24335;&#12398;  <pr>&#12391;&#12435;&#12375;&#12375;&#12365;&#12398;</pr></trd>
  </trdgrp>
  <trd lng="pl">elektroniczny</trd>
  <trd lng="pt">eletr&ocirc;nico</trd>
</drv>

<drv mrk="elektronik.0isto">
  <kap><tld/>isto</kap>
  <snc mrk="elektronik.0isto.ELE">
    <dif>
      Homo, kiu profesie okupi&gcirc;as pri <tld/>o:
       <ekz>
        e&ccirc; se de tiu tempo lingvistoj, matematikistoj kaj
        <tld/>istoj laboras super tiu &ccirc;i problemo, &gcirc;is nun
        ma&scirc;ina tradukado ne estis realigita
        <fnt>
          <aut>Z. Hr&scaron;el</aut>,
          <vrk>Apliko de Esperanto en la Laboro de Informcentroj</vrk>,
          <lok><url ref="http://www.fw.hu/eventoj/steb/miksitaj/aest78.rtf">
          AEST 1978</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_o;&c_n;&c_ib;&c_k;</trd>
  <trd lng="cs">elektronik</trd>
  <trd lng="de">Elektroniker</trd>
  <trd lng="en">electronics engineer</trd>
  <trd lng="fa">&a_m;&a_h;&a_n;&a_d;&a_s; <ind>&a_A;&a_l;&f_k;&a_t;&a_r;&a_w;&a_n;&f_y;&f_k;</ind></trd>
  <trd lng="fr">&eacute;lectronicien</trd>
  <trd lng="id">teknisi</trd>
  <trd lng="pl">elektronik</trd>
  <trd lng="sk">elektronik</trd>
  <trdgrp lng="zh">
    <trd>&#30005;&#23376;&#24037; <pr>di&agrave;nz&#464;g&omacron;ng</pr></trd>,
    <trd>&#30005;&#23376;&#26426;&#24037; <pr>di&agrave;nz&#464;j&imacron;g&omacron;ng</pr></trd>
  </trdgrp>
</drv>
</art>

