<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: kret1.xml,v 1.11 2026/10/25 08:00:20 afido Exp $">
    <kap>
      <rad>Kret</rad>/o
    </kap>

<drv mrk="kret1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      La plej granda <ref tip="lst" lst="voko:insuloj" cel="insul.0o.GEOG">insulo</ref>
      de <ref tip="malprt" cel="grek.G0ujo">Grekujo</ref>, 300&#8239;km sude de
      <ref tip="prt" cel="aten.0o">Ateno</ref>:
      <ekz>
        ili povos atingi Fenikson, havenon de <tld/>o
        <fnt>
          <bib>NT</bib>
          <lok>La agoj 27:12</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi lasis vin en <tld/>o, ke vi aran&gcirc;u la aferojn
        <fnt>
          <bib>NT</bib>
          <lok>Tito 1:5</lok>
        </fnt>;
      </ekz>
      <ekz>
        el <tld/>&#8217; ni estas, filoj de Adrasto
        <fnt>
          <bib>Ifigenio</bib>
        </fnt>;
      </ekz>
      <ekz>
        helena ekzemplo de logik-paradokso pri greka insulo <tld/>o:
        <tld lit="k"/>ano asertas: &leftquot;&ccirc;iuj <tld lit="k"/>anoj mensogas!&rightquot;
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2003/008114.html">Papo kontra&ubreve; kristano</url></vrk>
          <lok>2003</lok>
        </fnt>
      </ekz>
    </dif>
    <trd lng="be">&c_K;&c_r;&c_y;&c_t;</trd>
    <trd lng="de">Kreta</trd>
    <trd lng="en">Crete</trd>
    <trd lng="fr">Cr&egrave;te</trd>
    <trd lng="pl">Kreta</trd>
    <trd lng="ru">&c_K;&c_r;&c_i;&c_t;</trd>
  </snc>
  <rim>
    Kalka karbonato resp. skribilo el tiu materialo estas anka&ubreve; <ref tip="hom"
    cel="kret.0o">kreto</ref>.
  </rim>
  <trd lng="ca">Creta</trd>
  <trd lng="es">Creta</trd>
  <trd lng="ja">&#12463;&#12524;&#12479;&#23798;  <pr>&#12463;&#12524;&#12479;&#12375;&#12414;</pr></trd>
  <trd lng="uk">&c_K;&c_r;&c_i;&c_t;</trd>
  <trdgrp lng="zh">
    <trd>&#20811;&#37324;&#29305; <pr>K&egrave;l&#464;t&egrave;</pr></trd>,
    <trd>&#20811;&#37324;&#29305;&#23707; <pr>K&egrave;l&#464;t&egrave;D&#462;o</pr></trd>,
    <trd>&#20811;&#37324;&#29305;&#23798; <pr>K&egrave;l&#464;t&egrave;D&#462;o</pr></trd>,
    <trd>&#23646;&#24076;&#33098; <pr>sh&#468;x&#299;l&agrave;</pr></trd>,
    <trd>&#23660;&#24076;&#33240; <pr>sh&#468;x&#299;l&agrave;</pr></trd>
  </trdgrp>
</drv>
</art>

