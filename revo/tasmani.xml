<art mrk="$Id: tasmani.xml,v 1.13 2026/11/06 18:00:21 revo Exp $">
<kap><ofc>10</ofc>
  <rad>Tasmani</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="tasmani.0o">
  <kap><tld/>o</kap>
  <snc mrk="tasmani.0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Vasta insulo (68000 km<sup>2</sup>)
      situanta sudoriente de A&ubreve;stralio:
      <ekz>
        la ornitorinko, anka&ubreve; nomata anasotalpo, estas
        river-vivanta mamulo de A&ubreve;stralio kaj <tld/>o
        <fnt>
          <bib>OriginoDeSpecioj</bib>,
          <lok>Glosaro</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="tasmani.0o.POL">
    <uzo tip="fak">POL</uzo>
    <dif>
      Sub&scirc;tato de
      <ref tip="malprt" cel="auxstr1.A0o.sxtato">A&ubreve;stralio</ref>
      konsistanta el la insulo <tld/>o kaj proksimaj
      insuletoj:
      <ekz>
        la &ccirc;efurbo de Tasmanio estas Hobarto
        <fnt>
          <bib>Viki</bib>,
          <lok><url ref="&Viki;/Tasmanio">
          Tasmanio</url>, 2013-08-31</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_T;&c_a;&c_s;&c_m;&c_a;&c_n;&c_ib;&c_ja;</trd>
  <trd lng="ca">Tasm&agrave;nia</trd>
  <trd lng="cs">Tasm&aacute;nie</trd>
  <trd lng="cv">&c_T;&c_a;&c_s;&c_m;&c_a;&c_n;&c_i;</trd>
  <trd lng="en">Tasmania</trd>
  <trd lng="es">Tasmania</trd>
  <trd lng="fr">Tasmanie</trd>
  <trd lng="ja">&#12479;&#12473;&#12510;&#12491;&#12450;&#23798;
  <pr>&#12479;&#12473;&#12510;&#12491;&#12450;&#12375;&#12414;</pr></trd>
  <trd lng="nl">Tasmani&euml;</trd>
  <trd lng="oc">Tasmania</trd>
  <trd lng="pl">Tasmania</trd>
  <trd lng="sk">Tasm&aacute;nia</trd>
  <trd lng="uk">&c_T;&c_a;&c_s;&c_m;&c_a;&c_n;&c_ib;&c_ja; (&c_o;-&c_v; &c_ib; &c_sh;&c_t;&c_a;&c_t;)</trd>
  <trdgrp lng="zh">
    <trd>&#22612;&#24030; <pr>T&#462;Zh&#333;u</pr></trd>,
    <trd>&#22612;&#26031;&#26364;&#23612;&#20122; <pr>T&#462;s&#299;m&agrave;nn&iacute;y&agrave;</pr></trd>,
    <trd>&#22612;&#26031;&#26364;&#23612;&#20126; <pr>T&#462;s&#299;m&agrave;nn&iacute;y&agrave;</pr></trd>,
    <trd>&#22612;&#26031;&#26364;&#23612;&#20122;&#23707; <pr>T&#462;s&#299;m&agrave;nn&iacute;y&agrave;D&#462;o</pr></trd>,
    <trd>&#22612;&#26031;&#26364;&#23612;&#20126;&#23798; <pr>T&#462;s&#299;m&agrave;nn&iacute;y&agrave;D&#462;o</pr></trd>,
    <trd>&#22612;&#26031;&#39340;&#23612;&#20126; <pr>T&#462;s&#299;m&#462;n&iacute;y&agrave;</pr></trd>,
    <trd>&#22612;&#26031;&#39532;&#23612;&#20122; <pr>T&#462;s&#299;m&#462;n&iacute;y&agrave;</pr></trd>
  </trdgrp>
</drv>
