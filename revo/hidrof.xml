<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: hidrof.xml,v 1.28 2026/08/07 00:15:09 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>hidrofobi</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="hidrof.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc>
    <dif>
      Timo de la akvo, kiu karakterizas iujn <ref tip="lst" cel="san.mal0o.MED"
      lst="voko:malsanoj">malsano</ref>jn, ekz-e
      <ref cel="rabi.0o">rabion</ref>:
      <ekz>
        aperas la tipa, tre turmenta, simptomo: akvotimego (tial rabio ankora&ubreve; nomi&gcirc;as
        <tld/>o), kiam &ccirc;e la malsanulo dum iu provo eltrinki e&ccirc; unu guton de akvo,
        aperas konvulsiaj kunstre&ccirc;igoj de faringomuskoloj
        <fnt>
          <bib>Monato</bib>
          <aut>Vladimir Lemelev</aut>
          <vrk><url ref="&Monato;/2008/009550.php">Batalo kontra&ubreve; mortiga malsano</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>akvotimego</ke>, <ke>akvoangoro</ke>.
  </rim>

  <adm>
    Kontroli, ke la medicina senco estas plu aktuala en
    la franca trd "hydrophobie". PIV1 precizigas, ke temas
    pri la timo **trinki** akvon, sed mi ne scias, cxu
    prave.
    <aut>MB</aut>
  </adm>
  <trdgrp lng="be">
    <trd>&c_v;&c_a;&c_d;&c_a;&c_b;&c_o;&c_ja;&c_z;&c_mol;</trd>,
    <trd>&c_g;&c_ib;&c_d;&c_r;&c_a;&c_f;&c_o;&c_b;&c_ib;&c_ja;</trd>
  </trdgrp>
  <trd lng="ca">hidrof&ograve;bia</trd>
  <trd lng="cs">hydrofobie</trd>
  <trdgrp lng="de">
     <trd>Wasserangst</trd>,
     <trd>Wasserfurcht</trd>,
     <trd>Hydrophobie</trd>
  </trdgrp>
  <trd lng="el">&ypsilon;&delta;&rho;&omikron;&phi;&omikron;&beta;&jota_ton;&alfa;</trd>
  <trd lng="en">hydrophobia</trd>
  <trd lng="es">hidrofobia</trd>
  <trd lng="fr">hydrophobie<klr tip="ind"> (m&eacute;d.)</klr></trd>
  <trdgrp lng="hu">
    <trd>v&iacute;ziszony</trd>,
    <trd>hidrof&oacute;bia</trd>
  </trdgrp>
  <trd lng="id">hidrofobia</trd>
  <trd lng="it">idrofobia</trd>
  <trd lng="ja">&#24656;&#27700;&#30149;  <pr>&#12365;&#12423;&#12358;&#12377;&#12356;&#12403;&#12423;&#12358;</pr></trd>
  <trdgrp lng="nl">
    <trd>waterangst</trd>,
    <trd>watervrees</trd>,
    <trd>hydrofobie</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>hydrofobia</trd>,
    <trd>wodowstr&eogonek;t</trd>
  </trdgrp>
  <trd lng="pt">hidrofobia</trd>
  <trdgrp lng="ru">
    <trd>&c_g;&c_i;&c_d;&c_r;&c_o;&c_f;&c_o;&c_b;&c_i;&c_ja;</trd>,
    <trd>&c_v;&c_o;&c_d;&c_o;&c_b;&c_o;&c_ja;&c_z;&c_n;&c_mol;</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>chorobn&yacute; odpor z pitia vody</trd>,
    <trd>hydrof&oacute;bia</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_g;&c_ib;&c_d;&c_r;&c_o;&c_f;&c_o;&c_b;&c_ib;&c_ja;</trd>,
    <trd>&c_v;&c_o;&c_d;&c_o;&c_b;&c_o;&c_ja;&c_z;&c_n;&c_mol;</trd>,
    <trd>&c_s;&c_k;&c_a;&c_z;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#30216; <pr>j&igrave;</pr></trd>,
    <trd>&#24656;&#27700;&#30151; <pr>k&#466;ngshu&#464;zh&egrave;ng</pr></trd>,
    <trd>&#24656;&#27700;&#30149; <pr>k&#466;ngshu&#464;b&igrave;ng</pr></trd>
  </trdgrp>
</drv>
</art>
