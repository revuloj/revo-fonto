<drv mrk="univer2.0aareo">
   <kap><tld/>a areo, <var><kap><tld/>a parko</kap></var></kap>
   <snc mrk="univer2.0aareo.PED">
     <uzo tip="fak">PED</uzo>
     <dif>
       Granda tereno kun <tld/>aj kursejoj, bibliotekoj, man&gcirc;ejoj,
       lo&gcirc;ejoj...:
       <ekz>
         Bonn havas belan urbocentron kun <tld/>a parko
         <fnt>
         <aut>-</aut>,
         <vrk><url ref="http://www.esperanto.de/revelo/prezentoj/Nordrejno.htm">
         Esperanto NRW</url></vrk>,
         <lok>2002-06</lok>
         </fnt>;
       </ekz>
       <ekz>
         la subita studenta ribelo <klr>...</klr> ekis mardon 10an de
         junio sur la <tld/>a areo de Teherano
         <fnt>
         <aut>P. M. de La Gorce, trad. J. M. Cash</aut>,
         <vrk><url ref="&Mondediplo;article789.html">
         La islama Respubliko Irano sub premo</url></vrk>,
         <lok>le Monde diplomatique, 2003-07</lok>
         </fnt>.
       </ekz>
     </dif>
   </snc>
   <trd lng="be">&c_u;&c_n;&c_ib;&c_v;&c_e;&c_r;&c_s;&c_ib;&c_t;&c_e;&c_c;&c_k;&c_ib;
   &c_g;&c_a;&c_r;&c_a;&c_d;&c_o;&c_k;</trd>
