       <ekz>
         koran dankon al la glora Kembri&gcirc;a <tld/>o, kiu pruntis
al ni
         siajn &ccirc;ambrojn
         <fnt>
         <bib>Paroloj</bib>,
         <vrk>Tria Kongreso 1907 en Cambridge</vrk>
         </fnt>.
       </ekz>
     </dif>
   </snc>
  <trd lng="be">&c_u;&c_n;&c_ib;&c_v;&c_e;&c_r;&c_s;&c_ib;&c_t;&c_e;&c_t;</trd>
