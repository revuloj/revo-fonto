<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bakeli.xml,v 1.22 2026/09/06 10:53:45 revo Exp $">
<kap>
  <rad>bakelit</rad>/o
  <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="bakeli.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      Artefarita <ref tip="super" cel="plast.0o">plasto</ref>,
      produktata el <ref cel="formal1.0o">formaldehido</ref>
      kaj <ref cel="fenol.0o">fenolo</ref>,
      uzata kiel izola substanco a&ubreve; ornamcele (ekz-e kiel
      anstata&ubreve;a&jcirc;o de sukceno):
        <ekz>
          la produkton <tld/>o ellaboris la belga kemiisto
          <nom>Leo H. Baekeland</nom> <klr>[&#8230;]</klr> en 1909 en Usono
          <fnt>
            <bib>Viki</bib>,
            <vrk><url ref="&Viki;/Bakelito">Bakelito</url></vrk>
          </fnt>;
      </ekz>
      <ekz>
          &ccirc;io estis el ar&gcirc;entkolora metalo, vitro kaj el <tld/>-simila materialo
          <fnt>
            <bib>VaK</bib>, <lok>dua &ccirc;apitro</lok>
          </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_b;&c_a;&c_k;&c_je;&c_l;&c_ib;&c_t;</trd>
  <trd lng="ca">baquelita</trd>
  <trd lng="cs">bakelit</trd>
  <trd lng="de">Bakelit</trd>
  <trd lng="en">Bakelite</trd>
  <trd lng="es">baquelita</trd>
  <trd lng="fr">bak&eacute;lite</trd>
  <trd lng="he">&#x5D1;&#x5E7;&#x5DC;&#x5D9;&#x5D8;</trd>
  <trd lng="hu">bakelit</trd>
  <trd lng="ja">&#x30D9;&#x30FC;&#x30AF;&#x30E9;&#x30A4;&#x30C8;</trd>
  <trd lng="nl">bakeliet</trd>
  <trd lng="pl">bakelit</trd>
  <trd lng="ru">&c_b;&c_a;&c_k;&c_je;&c_l;&c_i;&c_t;</trd>
  <trd lng="sk">bakelit</trd>
  <trd lng="uk">&c_b;&c_a;&#x43A;&c_je;&#x43B;&c_ib;&c_t;</trd>
</drv>

</art>
