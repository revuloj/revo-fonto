<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ravelin.xml,v 1.12 2026/09/22 21:15:12 revo Exp $">
<kap>
  <rad>ravelin</rad>/o <fnt><bib>NePiv</bib></fnt>
</kap>
<drv mrk="ravelin.0o">
  <kap><tld/>o</kap>
  <snc mrk="ravelin.0o.MIL">
    <uzo tip="fak">ARKI</uzo>
    <uzo tip="fak">MIL</uzo>
    <dif>
      Pinta elstara&jcirc;o de <ref tip="malprt" cel="fortik.0ajxo.ARKI">fortika&jcirc;o</ref>
      a&ubreve; ekstera fortika&jcirc;eto anta&ubreve; la <ref cel="kurtin.0o">kurtino</ref> por protekti &gcirc;in:
      <ekz>
        <nom>Nolan</nom> sciis pli ol iu ajn el ili pri fortika&jcirc;oj, embrazuroj,
        <tld/>oj
        <fnt>
          <aut>Edward Everett Hale, trad. E. L. Robinson, trad. Don
          Harlow</aut>,
          <vrk><url
          ref="http://donh.best.vwh.net/Esperanto/Literaturo/Noveloj/La_Viro_Senpatria.html">La
          viro senpatria</url></vrk>,
          <lok>1907 kaj 1994</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_r;&c_a;&c_v;&c_e;&c_l;&c_ib;&c_n;</trd>
  <trdgrp lng="cs">
    <trd>prvn&iacute; opevn&ecaron;n&iacute;</trd>,
    <trd>p&rcaron;edhrad&iacute;</trd>,
    <trd>ravelin</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Ravelin</trd>,
    <trd>Wallschild</trd>
  </trdgrp>
  <trd lng="en">ravelin</trd>
  <trd lng="fr">ravelin</trd>
  <trdgrp lng="it">
     <trd>rivellino</trd>, <trd>revellino</trd>
  </trdgrp>
  <trd lng="nl">ravelijn</trd>
  <trdgrp lng="pl">
    <trd>rawelin</trd>,
    <trd>p&oacute;&lstroke;ksi&eogonek;&zdot;yc <klr tip="amb">(fortyfikacja)</klr></trd>,
    <trd>dwuramiennik <klr tip="amb">(fortyfikacja)</klr></trd>
  </trdgrp>
  <trd lng="pt">revelim</trd>
  <trdgrp lng="sk">
    <trd>predhradie</trd>,
    <trd>prv&eacute; opevnenie</trd>,
    <trd>ravel&iacute;n</trd>
  </trdgrp>
  <trd lng="uk">&c_r;&c_a;&c_v;&c_je;&c_l;&c_ib;&c_n; (&c_f;&c_o;&c_r;&c_t;&c_i;&c_f;&c_ib;&c_k;&c_a;&c_c;&c_ib;&c_j;&c_n;&c_a; &c_s;&c_p;&c_o;&c_r;&c_u;&c_d;&c_a;)</trd>
</drv>
</art>

