<kap><ofc>10</ofc>
    <rad>Kair</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="kair.K0o">
  <kap><tld/>o</kap>
  <snc mrk="kair.K0o.cxefurbo">
    <uzo tip="fak">GEOG</uzo>
    <uzo tip="fak">POL</uzo>
    <dif>
    <ref tip="lst" cel="urb.cxef0o" lst="voko:&ccirc;efurboj">&Ccirc;efurbo</ref> de
    <ref tip="malprt" cel="egipt.E0ujo">Egiptujo</ref>:
      <ekz>
        Delta de Nilo havas <klr>[...]</klr> kiel pinton
        <klr>[...]</klr>
        la urbon <tld/>on kaj la ruinojn de la antikva &ccirc;efurbo Memfiso
        <fnt>
          <bib>Far1</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        anta&ubreve; 25 jaroj okazis en la egipta &ccirc;efurbo
        <tld/>o unu el la plej grandaj amaskunvenoj
        en la historio de la araba mondo:
        milionoj da homoj plenigis la stratojn
        <fnt>
          <aut>Konrad Hinsen</aut>
          <vrk><url ref="&Monato;/2000/007063.php">Um
          Keltum'</url></vrk>
          <bib>Monato</bib>
          <lok>2000/09, p. 15</lok>
        </fnt>.
      </ekz>
    </dif>
  <trd lng="en">Cairo</trd>
  </snc>
  <trd lng="be">&c_K;&c_a;&c_ib;&c_r;</trd>
  <trd lng="ca">el <ind>Caire</ind></trd>
  <trd lng="cv">&c_K;&c_a;&c_i;&c_r;</trd>
  <trd lng="de">Kairo</trd>
  <trd lng="fr">Le Caire</trd>
  <trd lng="id">Kairo</trd>
  <trd lng="ja">&#12459;&#12452;&#12525;  <pr>&#12363;&#12356;&#12429;</pr></trd>
  <trd lng="nl">Ca&iuml;ro</trd>
  <trd lng="no">Kairo</trd>
  <trd lng="oc">lo <ind>Caire</ind></trd>
  <trd lng="pl">Kair</trd>
  <trd lng="ro">Cairo</trd>
  <trd lng="uk">&c_K;&c_a;&c_ji;&c_r;</trd>
  <trd lng="zh">&#24320;&#32599; <pr>K&amacron;ilu&oacute;</pr></trd>
