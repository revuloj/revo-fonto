<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: tali.xml,v 1.31 2026/09/20 16:00:47 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>tali</rad>/o
  <fnt><bib>UV</bib></fnt></kap>

<drv mrk="tali.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="tali.0o.ANA">
    <dif>
      La pli malvasta parto de la korpo
      inter la ripoj kaj kokso:
      <ekz>
        mi havis &ccirc;irka&ubreve; mia <tld/>o lar&gcirc;an zonon
        <fnt>
          <bib>Rob</bib>
          <lok>Parto III</lok>
        </fnt>;
      </ekz>
      <ekz>
        la virino <klr>[&#x2026;]</klr> rektigis sian elastan <tld/>on
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        subite &scirc;i eksentis, ke brako delikate &ccirc;irka&ubreve;prenas &scirc;ian <tld/>on
        <fnt>
          <bib>IK</bib>
          <lok>&Ccirc;aptiro IV</lok>
        </fnt>;
      </ekz>
      <ekz>
        li rigardis plensignife la tro diki&gcirc;intan <tld/>on de l' virino
        <fnt>
          <bib>Mizero</bib>
          <lok>II</lok>
        </fnt>;
      </ekz>
      <ekz>
        kun <tld/>o klinita pro la pezo de la kru&ccirc;o plena de akvo
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i rigardis sin en sia spegulo, ekzamenante <klr>[&#x2026;]</klr> la ondoliniojn de sia
        <tld/>o
        <fnt>
          <bib>ChL</bib>
          <lok>&Ccirc;apitro Na&ubreve;a</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="lumb.0o">lumbo</ref>
    </refgrp>
    <trd lng="ca">cintura</trd>
    <trdgrp lng="de">
      <trd><ofc>*</ofc>Taille</trd>,
      <trd>G&uuml;rtellinie</trd>,
      <trd>K&ouml;rpermitte</trd>
    </trdgrp>
    <trd lng="en"><ofc>*</ofc>waist</trd>
    <trd lng="es">cintura</trd>
    <trd lng="fr"><ofc>*</ofc>taille</trd>
    <trd lng="hu">der&eacute;k</trd>
    <trd lng="id">pinggang</trd>
    <trdgrp lng="pl">
      <trd><ofc>*</ofc>talia</trd>,
      <trd><ofc>*</ofc>figura</trd>,
      <trd>kibi&cacute;</trd>,
      <trd>stan</trd>
    </trdgrp>
    <trdgrp lng="sv">
      <trd>midja</trd>,
      <trd>liv</trd>
    </trdgrp>
  </snc>

<!-- tiun korpoparton oni kutime nomas torso a&ubreve; trunko:
  <snc>
    <dif>
      Parto de la homa korpo ekde kolo &gcirc;is koksoj:
      <ekz>
        &scirc;i rektigis sian elastan <tld/>on;
      </ekz>
      <ekz>
        bel<tld/>a.
      </ekz>
    </dif>
    <refgrp tip="sin">
      <ref cel="brust.0o">brusto</ref>,
      <ref cel="tors.0o">torso</ref>,
      <ref cel="bust.0o">busto</ref>.
    </refgrp>
    <trd lng="hu">fels&odblac;test</trd>
    <trdgrp lng="pl">
      <trd>tu&lstroke;&oacute;w</trd>,
      <trd>korpus</trd>
    </trdgrp>
    <trd lng="ro">corp</trd>
  </snc>
-->

  <ref tip="hom" cel="tali2.0o">talio (elemento)</ref>
  <trdgrp lng="be">
    <trd>&c_t;&c_a;&c_l;&c_ib;&c_ja;</trd>,
    <trd>&c_s;&c_t;&c_a;&c_n;</trd>
  </trdgrp>
  <trd lng="bo">&t_sa;&t_kata;&t_drengbu;&t_da;&t_tsheg;&t_pa;&t_tsheg;</trd>
  <trdgrp lng="cs">
    <trd>pas <klr>(t&ecaron;la)</klr></trd>,
    <trd>&zcaron;ivot</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x80F4; <pr>&#x3069;&#x3046;</pr></trd>,
    <trd>&#x80F4;&#x4F53; <pr>&#x3069;&#x3046;&#x305F;&#x3044;</pr></trd>,
    <trd>&#x8170;&#x56DE;&#x308A; <pr>&#x3053;&#x3057;&#x307E;&#x308F;&#x308A;</pr></trd>,
    <trd>&#x8170; <pr>&#x3053;&#x3057;</pr></trd>,
    <trd>&#x30A6;&#x30A8;&#x30B9;&#x30C8; <pr>&#x3046;&#x3048;&#x3059;&#x3068;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>taille</trd>,
    <trd>middel</trd>
  </trdgrp>
  <trd lng="ru"><ofc>*</ofc>&c_t;&c_a;&c_l;&c_i;&c_ja;</trd>
  <trdgrp lng="sk">
    <trd>driek</trd>,
    <trd>p&aacute;s</trd>
  </trdgrp>
  <trd lng="uk">&c_t;&c_a;&c_l;&c_ib;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#x8170;&#x80EF; <pr>y&amacron;oku&agrave;</pr></trd>,
    <trd>&#x8170;&#x90E8; <pr>y&amacron;ob&ugrave;</pr></trd>,
    <trd>&#x8170;&#x8EAB; <pr>y&amacron;osh&emacron;n</pr></trd>,
    <trd>&#x8170;&#x80A2; <pr>y&amacron;ozh&imacron;</pr></trd>,
    <trd>&#x8170;&#x9593; <pr>y&amacron;oji&amacron;n</pr></trd>,
    <trd>&#x8170;&#x95F4; <pr>y&amacron;oji&amacron;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="tali.0vesto">
  <kap><tld/>vesto</kap>
  <uzo tip="fak">TEKS</uzo>
  <snc mrk="tali.0vesto.TEKS">
    <dif>
      Vesto malsupreniranta nur &gcirc;is la <tld/>o:
      <ekz>
        la koroj &ccirc;e la tiel nomata bela sekso estas &ccirc;iam tre sentema <klr>[&#x2026;]</klr>
        loko, tute egale &ccirc;u ili trovi&gcirc;as sub silkaj a&ubreve; sub lanaj kaj katunaj
        <tld/>vestoj
        <fnt>
          <bib>Marta</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="boler.0o">bolero</ref>,
      <ref cel="kamizo.0o">kamizolo</ref>,
      <ref cel="korsaj.0o">korsa&jcirc;o</ref>,
      <ref cel="jak.0o">jako</ref>,
      <ref cel="brust.sur0ajxo">surbrusta&jcirc;o</ref>,
      <ref cel="vesxt.0o">ve&scirc;to</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_b;&c_l;&c_ju;&c_z;&c_a;</trd>
  <trdgrp lng="cs">
    <trd>halenka bl&uring;za</trd>,
    <trd>vesta do pasu</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Mieder</trd>,
    <trd>bauchfreise <ind>Top</ind></trd>,
    <trd>bauchfreies <ind>Oberteil</ind></trd>,
    <trd>Bolero</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x5A66;&#x4EBA;&#x7528;&#x80F4;&#x7740;  <pr>&#x3075;&#x3058;&#x3093;&#x3088;&#x3046;&#x3069;&#x3046;&#x3061;&#x3083;&#x304F;</pr></trd>,
    <trd>&#x30DC;&#x30C7;&#x30A3;&#x30B9;</trd>,
    <trd>&#x30B3;&#x30EB;&#x30B5;&#x30FC;&#x30B8;&#x30E5;</trd>
  </trdgrp>
  <trdgrp lng="pt">
   <trd>parte de cima</trd>
  </trdgrp>
  <trd lng="sk">vesta do p&aacute;su</trd>
  <trd lng="uk">&c_b;&c_l;&c_u;&c_z;&c_a;</trd>
</drv>
</art>
