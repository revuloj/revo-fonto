<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: tanganjik.xml,v 1.1 2026/08/06 14:58:52 afido Exp $">
    <kap>
      <rad>Tanganjik</rad>/o
    </kap>

<drv mrk="tanganjik.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc mrk="tanganjik.0o.lago">
    <dif>
      <ref tip="dif" cel="lag.Tanganjika_L0o">Tanganjika Lago</ref>:
      <ekz>
        el la sep fi&scirc;bredejoj en la lago <tld/>o nur unu
        estas uzata por fi&scirc;kaptado
        <fnt><aut>S. Zandandu Ntomono Zola</aut>,
        <vrk>Nutra memsufi&ccirc;o ser&ccirc;ata</vrk>, <bib>Monato</bib>,
        <lok>1999:10, p. 15a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="tanganjik.0o.teritorio">
    <dif>
      Iama nomo (1922 - 1964) de la kontinenta teritorio
      de Tanzanio kaj la insulo Mafio:
      <ekz>
        la nomo &leftquot;Tanzanio&rightquot; estas konscie kreita vorto el la komencaj silaboj de la du
        federaciaj subjektoj: <em>Tan</em>ganjiko kaj <em>Zan</em>zibaro
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=4142"
              >Tanzanio</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Tanganjika</trd>
  <trd lng="en">Tanganjika</trd>
</drv>

  </art>

