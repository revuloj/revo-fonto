<kap>
  <ofc>2</ofc>
  <rad>mikrofon</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="mikrof1.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Aparato, kiu transformas vo&ccirc;on a&ubreve; sonojn al elektra energio:
      <ekz>
        li ion kriegis en la <tld/>on
        <fnt>
          <bib>Metrop</bib>
        </fnt>;
      </ekz>
      <ekz>
        la oratoro <klr>[&#8230;]</klr> decidu &ccirc;u li parolos anta&ubreve; la <tld/>o a&ubreve; sen &gcirc;i
        <fnt>
          <bib>Ret</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        utilas anka&ubreve; <tld/>o, &ccirc;ar la programo permesas registri oniajn
        proprajn prononcekzercojn
        <fnt><aut>Franz Kruse</aut>:
          <vrk>Agrabla ekzercilo</vrk>,
          <bib>Monato</bib><lok>jaro 1996a, numero 10a,  p. 12a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_ib;&c_k;&c_r;&c_a;&c_f;&c_o;&c_n;</trd>
  <trd lng="ca">micr&ograve;fon</trd>
  <trd lng="cs">mikrofon</trd>
  <trd lng="de">Mikrofon</trd>
  <trd lng="en">microphone</trd>
  <trdgrp lng="fr">
    <trd>micro<klr> (microphone)</klr></trd>
  </trdgrp>
  <trd lng="hu">mikrofon</trd>
  <trd lng="ja">&#x30DE;&#x30A4;&#x30AF;&#x30ED;&#x30D5;&#x30A9;&#x30F3;</trd>
  <trd lng="kek">aatinob&#789;aal</trd>
  <trd lng="nl">microfoon</trd>
  <trd lng="pt">microfone</trd>
  <trd lng="ru">&c_m;&c_i;&c_k;&c_r;&c_o;&c_f;&c_o;&c_n;</trd>
  <trd lng="sk">mikrof&#xF3;n</trd>
  <trd lng="uk">&#x43C;&c_ib;&#x43A;&c_r;&#x43E;&c_f;&#x43E;&#x43D;</trd>
  <trdgrp lng="zh">
    <trd>&#x9EA5;&#x514B; <pr>m&#xE0;ik&#xE8;</pr></trd>,
    <trd>&#x9EA6;&#x514B; <pr>m&#xE0;ik&#xE8;</pr></trd>,
    <trd>&#x4F20;&#x58F0; <pr>chu&#xE1;nsh&emacron;ng</pr></trd>,
    <trd>&#x50B3;&#32882; <pr>chu&#xE1;nsh&emacron;ng</pr></trd>,
    <trd>&#x9EA5;&#x514B;&#x98A8; <pr>m&#xE0;ik&#xE8;f&emacron;ng</pr></trd>,
    <trd>&#x9EA6;&#x514B;&#x98CE; <pr>m&#xE0;ik&#xE8;f&emacron;ng</pr></trd>
  </trdgrp>
</drv>
