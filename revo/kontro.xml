<drv mrk="kontro.0isto">
  <kap>
    <tld/>isto
  </kap>
  <snc>
    <dif>
      Oficisto a&ubreve; dungito, kies precipa tasko estas <tld/>i:
      <ekz>
        la <tld/>istojn Izraelidojn, starigitajn super ili de la voktoj de Faraono, oni
        batadis, dirante: kial vi ne pretigis vian ordonitan nombron da brikoj
        <fnt>
          <bib>MT</bib>
          <lok>Eliro 5:14</lok>
        </fnt>;
      </ekz>
      <ekz>
        li faris el ili sepdek mil portistojn, okdek mil montajn &scirc;tonhakistojn, kaj tri
        mil sescent <tld/>istojn, por devigadi la popolon labori
        <fnt>
          <bib>MT</bib>
          <lok>II. Kroniko 2:18</lok>
        </fnt>;
      </ekz>
      <ekz>
        ju&gcirc;istojn kaj <tld/>istojn starigu al vi en &ccirc;iuj viaj urboj <klr>[&#8230;]</klr> kaj
        ili ju&gcirc;u la popolon per ju&gcirc;o justa
        <fnt>
          <bib>MT</bib>
          <lok>Readmono 16:18</lok>
        </fnt>;
      </ekz>
      <ekz>
        aviadilaj kra&scirc;oj okazas pro miskomprenoj inter pilotoj kaj flughavenaj
        <tld/>istoj
        <fnt>
          <aut>Garbhan MacAoidh</aut>
            <vrk><url ref="&Monato;/2000/007159.php">Flugilhavaj vortoj</url></vrk>
            <bib>Monato</bib>
            <lok>2000/10, p. 22</lok>
          </fnt>;
      </ekz>
      <ekz>
        estonte <tld/>istoj rajtos sen anta&ubreve;a anonco eniri domojn de pafistoj por vidi,
        &ccirc;u la mortigiloj estas la&ubreve;le&gcirc;e konservataj
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2009/009838.php">Kia konsekvenco!</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        financ<tld/>isto
        <fnt>
          <bib>Monato</bib>
          <aut>Stefan Maul</aut>
          <vrk><url ref="&Monato;/2010/010078.php">&Scirc;uldoj kaj kulpoj</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_k;&c_a;&c_n;&c_t;&c_r;&c_a;&c_l;&c_jo;&c_r;</trd>
