<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: simultan.xml,v 1.11 2026/09/19 12:29:10 revo Exp $">
<kap>
  <rad>simultan</rad>/a <fnt><bib>PVEF</bib></fnt>
</kap>
<drv mrk="simultan.0a">
  <kap><tld/>a</kap>
  <uzo tip="stl">RAR</uzo>
  <snc mrk="simultan.0a.KOMUNE">
    <dif>
      <ref tip="dif" cel="temp.sam0a.KOMUNE">Samtempa</ref>,
      sammomenta:
      <ekz>
        <tld/>a interpretado
        <fnt>
          <bib>EeP</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i estis <tld/>a interpretistino inter la &ccirc;ina kaj la japana lingvoj
        <fnt>
          <bib>Monato</bib>
          <aut>Isikawa Takasi</aut>
          <vrk><url ref="&Monato;/2014/011250.php"
              >Pli da subtenantoj, &ccirc;iam malpli da parolantoj</url></vrk>
          <lok>2014</lok>
        </fnt>;
      </ekz>
      <ekz>
        sentu tion nun, &ccirc;i sekunde, <tld/>e kun mi
        <fnt><aut>S. Larbar</aut>, <vrk>Karuseloj</vrk>,
        <lok>1987</lok></fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="parale.0a.komparata">paralela<sncref/></ref>,
      <ref cel="sinkron.0a">sinkrona</ref>
    </refgrp>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>samtempa</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_a;&c_d;&c_n;&c_a;&c_ch;&c_a;&c_s;&c_o;&c_v;&c_y;</trd>,
    <trd>&c_a;&c_d;&c_n;&c_a;&c_ch;&c_a;&c_s;&c_n;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>simult&aacute;nn&iacute;</trd>,
    <trd>soub&ecaron;&zcaron;n&yacute;</trd>,
    <trd>soudob&yacute;</trd>
  </trdgrp>
  <trd lng="de">simultan</trd>
  <trd lng="en">simultaneous</trd>
  <trd lng="fr">concomitant</trd>
  <trdgrp lng="pl">
    <trd>symultaniczny</trd>,
    <trd>jednoczesny</trd>
  </trdgrp>
  <trdgrp lng="sk">
    <trd>simult&aacute;nny</trd>,
    <trd>s&uacute;be&zcaron;n&yacute;</trd>,
    <trd>s&uacute;&ccaron;asn&yacute;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_o;&c_d;&c_n;&c_o;&c_ch;&c_a;&c_s;&c_n;&c_i;&c_j;</trd>,
    <trd>&c_s;&c_i;&c_n;&c_h;&c_r;&c_o;&c_n;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x5E73;&#x884C; <pr>p&iacute;ngx&iacute;ng</pr></trd>,
    <trd>&#x540C;&#x65F6; <pr>t&oacute;ngsh&iacute;</pr></trd>,
    <trd>&#x540C;&#x6642; <pr>t&oacute;ngsh&iacute;</pr></trd>,
    <trd>&#x4E00;&#x9762; <pr>y&imacron;mi&agrave;n</pr></trd>
  </trdgrp>
</drv>
</art>

