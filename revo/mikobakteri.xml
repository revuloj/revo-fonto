<drv mrk="mikobakteri.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BAK</uzo>
  <snc>
    <dif>
      Genro de bakterioj (<trd lng="la">Mycobacterium</trd>) bastonetformaj,
      t.e. <ref tip="super" cel="bacil.0o">bacilo</ref>,
      al kiu apartenas i.a. la ka&ubreve;zantoj de <ref cel="tuberk.0o">tuberkulozo</ref>
      kaj <ref cel="lepr.0o">lepro</ref>:
      <ekz>
        en 1890 <nom>Koch</nom> faris filtra&jcirc;on de sterilizita kulturo de tuberkulozaj <tld/>oj,
        kiun li nomis tuberkulino
        <fnt>
          <bib>Monato</bib>
          <aut>Vladimir Lemelev</aut>
          <vrk><url ref="&Monato;/2011/010389.php"
              >Dan&gcirc;era malamiko revenas</url></vrk>
          <lok>2011</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Mykobakterium</trd>
    <trd lng="en">mycobacterium</trd>
    <trd lng="fr">mycobacterium</trd>
  </snc>
</drv>

