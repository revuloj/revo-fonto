<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: klauxz.xml,v 1.17 2026/09/19 17:17:31 revo Exp $">
<kap>
  <rad>kla&ubreve;z</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="klauxz.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">JUR</uzo>
  <uzo tip="fak">EKON</uzo>
  <snc>
    <dif>
      Speciala rezervo, <ref cel="kondic1.0o.interkonsentitajxo">kondi&ccirc;o</ref>,
      enskribita en kontrakto, traktato, interkonsento, le&gcirc;a akto:
      <ekz>
        tiuj kontraktoj devas enhavi anka&ubreve; <tld/>ojn por la
        estonta liberigo de servoj<fnt><aut>Evgeni Georgiev</aut>:
        <vrk>Interkonsento pri komerca liberigo</vrk>,
        <bib>Monato</bib><lok>jaro 2002a, numero 2a, p. 13a</lok></fnt>;
      </ekz>
      <ekz>
        li jam faris testamenton anta&ubreve; ol forlasi la vila&gcirc;on, kun la <tld/>o rezervi al
        la &scirc;ildisto sumon proporcian al la tempo de lia servado
        <fnt>
          <aut>Miguel de Cervantes, trad. Fernando de Diego</aut>
          <vrk><url ref="https://www.verkoj.com/lauteme/klasika/don-kihot/"
              >La in&gcirc;enia kavaliro Don Ki&hcirc;oto el La Man&ccirc;a</url></vrk>
          <lok>&Ccirc;apitro 20</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="fak">MAT</uzo>
        Horn-<tld/>o <klr>(disjunkcia termo)</klr>.
      </ekz>
    </dif>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru (specifkondi&ccirc;a) <ke>kontraktero</ke>,
    <ke>paragrafo</ke>, <ke>normo</ke>, <ke>ero de kontrakto</ke>, <ke>kondi&ccirc;o</ke>.
  </rim>

  <trdgrp lng="be">
    <trd>&c_k;&c_l;&c_ja;&c_w;&c_z;&c_u;&c_l;&c_a;</trd>,
    <trd>&c_a;&c_g;&c_a;&c_v;&c_o;&c_r;&c_k;&c_a; <klr tip="amb">(&c_u; &c_ju;&c_r;&c_y;&c_d;&c_y;&c_ch;&c_n;&c_y;&c_m; &c_d;&c_a;&c_k;&c_u;&c_m;&c_e;&c_n;&c_mol;&c_c;&c_je;)</klr></trd>
  </trdgrp>
  <trd lng="ca">cl&agrave;usula</trd>
  <trd lng="de">Klausel</trd>
  <trd lng="en">clause</trd>
  <trd lng="es">cl&aacute;usula</trd>
  <trdgrp lng="fr">
    <trd>clause</trd>
  </trdgrp>
  <trd lng="nl">clausule</trd>
  <trdgrp lng="pl">
    <trd>klauzula</trd>,
    <trd>warunek</trd>,
    <trd>obostrzenie</trd>,
    <trd>zastrze&zdot;enie</trd>
  </trdgrp>
  <trd lng="ro">clauz&abreve;</trd>
  <trdgrp lng="ru">
    <trd>&c_o;&c_g;&c_o;&c_v;&c_o;&c_r;&c_k;&c_a; <klr>(&c_p;&c_u;&c_n;&c_k;&c_t; &c_z;&c_a;&c_k;&c_o;&c_n;&c_a;,
    &c_d;&c_o;&c_g;&c_o;&c_v;&c_o;&c_r;&c_a;, &c_z;&c_a;&c_v;&c_je;&c_shch;&c_a;&c_n;&c_i;&c_ja; &c_i; &c_t;.&c_p;.)</klr></trd>,
    <trd>&c_o;&c_g;&c_r;&c_a;&c_n;&c_i;&c_ch;&c_i;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_o;&c_je; &c_u;&c_s;&c_l;&c_o;&c_v;&c_i;&c_je;</trd>,
    <trd>&c_k;&c_l;&c_a;&c_u;&c_z;&c_u;&c_l;&c_a;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_z;&c_a;&c_s;&c_t;&c_je;&c_r;&c_je;&c_zh;&c_je;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_o;&c_b;&c_m;&c_je;&c_zh;&c_u;&c_v;&c_a;&c_l;&c_mol;&c_n;&c_a; &c_u;&c_m;&c_o;&c_v;&c_a;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#26465; <pr>ti&aacute;o</pr></trd>,
    <trd>&#26465;&#27454; <pr>ti&aacute;oku&#462;n</pr></trd>,
    <trd>&#30701;&#21477; <pr>du&#462;nj&ugrave;</pr></trd>
  </trdgrp>
</drv>
