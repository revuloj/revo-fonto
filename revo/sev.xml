<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: sev.xml,v 1.1 2026/08/01 19:25:11 afido Exp $">
    <kap>
      <rad>sev</rad>/o
      <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="sev.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">BOT</uzo>
    <dif>
      Akvo kun solvitaj substancoj transportata tra la ksilemaj kaj floemaj tuboj de vegeta&jcirc;oj:
      <ekz>
        alkaloidoj, &ccirc;efe nikotino, estas produktataj en radikoj, poste <tld/>o ilin
        transportas en la foliojn
        <fnt>
          <aut>Robert Molimard</aut>
          <vrk><url ref="https://libro.ee/file.php?id=508"
              >La fumado</url></vrk>
          <lok>Kion oni metas en cigaredojn? p. 64</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="sin" cel="limf.0o.BOT">limfo<sncref/></ref>
    <trdgrp lng="de">
      <trd>Xylemsaft</trd>,
      <trd>Phloemsaft</trd>,
      <trd>Baumsaft</trd>
    </trdgrp>
    <trd lng="en">sap</trd>
    <trd lng="fr">s&egrave;ve <klr>(botanique)</klr></trd>
    <trd lng="nl">sap</trd>
  </snc>
</drv>

  </art>


