<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kurilo.xml,v 1.5 2026/11/02 22:00:20 afido Exp $">
<kap>
    <rad>Kuril</rad>/oj <fnt><bib>PIV3</bib></fnt>
</kap>
<drv mrk="kurilo.0o">
  <kap><tld/>oj</kap>
  <snc mrk="kurilo.0o.SNC">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      <ref tip="super" cel="insul.0aro">Insularo</ref> en Azio, inter Kam&ccirc;atko kaj Japanujo,
      apartenanta al la Rusuja Federacio:
      <ekz>
        Sovetio (kaj poste Rusio) insistis, ke la lastaj du insuloj estas parto de <tld/>oj kaj
        redonos nur la du unuajn
        <fnt>
          <aut>Takasi Isikawa</aut>
          <vrk><url ref="&Monato;/2017/011848.php">Teritoria intertraktado inter Putin kaj
          Abe</url></vrk>
          <bib>Monato</bib>,
          <lok>2017/01, p. 7</lok>
        </fnt>;
      </ekz>
      <ekz>
        Sovetio <klr>[&#8230;]</klr> deklaris militon kontra&ubreve; Japanio kaj okupis la sudan Sa&hcirc;alenon, la
        <tld
        lit="k"/>ajn insulojn kaj kvar insulojn sude de ili
        <fnt>
          <aut>Takasi Isikawa</aut>
          <vrk><url ref="&Monato;/2021/012956.php">Vortumo malproksimigas pacon</url></vrk>
          <bib>Monato</bib>,
          <lok>2021/12, p. 14</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="ca">Kurils</trd>
  <trd lng="cv">K&c_u;&c_r;&c_i;&c_l; &c_u;&c_t;&c_r;&c_a;&c_v;&#1239;&c_s;&c_je;&c_m;</trd>
  <trd lng="de">Kurilen</trd>
  <trd lng="en">Kuril Islands</trd>
  <trd lng="ja">&#21315;&#23798;&#21015;&#23798; <pr>&#12385;&#12375;&#12414;&#12428;&#12387;&#12392;&#12358;</pr></trd>
  <trd lng="nl">Koerilen</trd>
  <trd lng="oc">illas <ind>Kuriles</ind></trd>
  <trd lng="ru">&c_K;&c_u;&c_r;&c_i;&c_l;&c_mol;&c_s;&c_k;&c_i;&c_je;
  &c_o;&c_s;&c_t;&c_r;&c_o;&c_v;&c_a;</trd>
</drv>
</art>

