<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: graf1.xml,v 1.18 2026/09/24 21:29:10 revo Exp $">
<kap>
  <rad>graf</rad>/o
</kap>

<drv mrk="graf1.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">MAT</uzo>
  <fnt><bib>MatVort</bib></fnt>
  <snc mrk="graf1.0o.grafeo">
    <ref tip="dif" cel="grafe.0o.strukturo">grafeo</ref>
    <trd lng="be">&c_g;&c_r;&c_a;&c_f; <klr>(&c_m;&c_a;&c_t;.)</klr></trd>
    <trd lng="ca">graf</trd>
    <trd lng="de">Graph</trd>
    <trd lng="en">graph</trd>
    <trd lng="es">grafo</trd>
    <trd lng="fr">graphe<klr tip="ind"> (sommets et ar&ecirc;tes)</klr></trd>
    <trd lng="hu">gr&aacute;f</trd>
    <trd lng="nl">graaf<klr tip="ind"> (wisk.)</klr></trd>
    <trd lng="pl">graf</trd>
    <trdgrp lng="pt">
      <trd>grafo</trd>,
      <trd>gr&aacute;fico</trd>
    </trdgrp>
    <trd lng="ru">&c_g;&c_r;&c_a;&c_f;</trd>
  </snc>
  <snc mrk="graf1.0o.grafikajxo">
    <uzo tip="stl">EVI</uzo>
    <dif>
      <ref tip="dif" cel="grafik.0ajxo.MAT">Grafika&jcirc;o</ref>:
      <ekz>
        oni povas desegni la <tld/>on de f, bildigante la valorojn de x la&ubreve; horizontala
        akso kaj la respondajn valorojn f(x) la&ubreve; vertikala akso
        <fnt>
          <aut>Jesper Lykke Jacobsen</aut>
          <vrk><url ref="https://www.verkoj.com/dn/IKU/IKU2021.pdf"
              >Fraktoj, Pri stranga funkcio</url></vrk>
          <lok>IKU, julio 2021, p. 22</lok>
        </fnt>.
      </ekz>
    </dif>
    <!-- Ne traduku EVI:
    <trd lng="be">&c_g;&c_r;&c_a;&c_f;&c_ib;&c_k;</trd>
    <trd lng="ca">gr&agrave;fic <klr>(subst.)</klr></trd>
    <trdgrp lng="pl">
      <trd>grafika</trd>,
      <trd>rysunek</trd>
    </trdgrp>
    -->
  </snc>
  <ref tip="hom" cel="graf.0o">grafo (nobelo)</ref>
  <trdgrp lng="cs">
    <trd>diagram</trd>,
    <trd>graf</trd>,
    <trd>grafick&eacute; zn&aacute;zorn&ecaron;n&iacute;</trd>
  </trdgrp>
  <trd lng="ja">&#x4F2F;&#x7235;  <pr>&#x306F;&#x304F;&#x3057;&#x3083;&#x304F;</pr></trd>
  <trd lng="ru">&c_g;&c_r;&c_a;&c_f;</trd>
  <trdgrp lng="sk">
    <trd>diagram</trd>,
    <trd>graf</trd>,
    <trd>krivka</trd>
  </trdgrp>
  <trd lng="uk">&c_g;&c_r;&c_a;&c_f;</trd>
</drv>
</art>

