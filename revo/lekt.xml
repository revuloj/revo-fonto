<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: lekt.xml,v 1.8 2026/08/06 14:34:48 revo Exp $">
<kap>
  <rad>lekt</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="lekt.0o">
  <kap><tld/>o</kap>
  <snc mrk="lekt.0o.MEBL">
    <dif>
      <ref tip="super" cel="kusx.0ejo.KOMUNE">Ku&scirc;ejo<sncref/></ref>,
      speco de <ref tip="vid" cel="sof.0o">sofo</ref>,
      sur kia la antikvaj mediteraneanoj de la helenisma-romia epoko ku&scirc;is dum man&gcirc;ado:
      <ekz>
        li ne sidis en la brakse&gcirc;o, sed duonku&scirc;is sur <tld/>o &ccirc;e malalta tableto,
        garnita je man&gcirc;a&jcirc;oj kaj vino
        <fnt><bib>MkM</bib> <lok>25</lok></fnt>;
      </ekz><ekz>
        pezakorpaj altkastuloj <klr>...</klr> ku&scirc;is sur speco de portebla <tld/>o
        <fnt>
          <aut>T. Steele</aut> <vrk>Konvinka Kamufla&jcirc;o</vrk> <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
    <adm>
      Pri la 2a ekzemplo:
      Mi ne legis &leftquot;Konvinkan kamufla&jcirc;on&rightquot;, sed mi suspektas ke tiu
      &leftquot;portebla lekto&rightquot; estas fakte &#8249;palankeno&#8250;, probale pro
      konfuzo inter la Latinaj &#8249;lectus (triclinaris)&#8250; = &#8249;lekto&#8250;
      kaj &#8249;lectica&#8250; (palankeno). &Ccirc;iel ajn, tiu ekzemplo malakordas
      kun la difino kaj estas malta&ubreve;ga. Mi rekomendas &gcirc;in forigi.
      <aut>Sergio Pokrovskij</aut>
    </adm>
  </snc>
  <rim num="1">
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>man&gcirc;olito</ke>.
  </rim>
  <rim num="2">
     Pli racie (radik&scirc;pare) estus germanmaniere  uzi la grekan
     <ctl>klinio</ctl> (&kappa;&lambda;&jota_ton;&ny;&eta;),  el kiu regule deriveblus
     &leftquot;<ref tip="malprt" cel="triklini.0o">tri&middot;klinio</ref>&rightquot; kaj <ctl>du&middot;klinio</ctl>.
     <aut>Sergio Pokrovskij</aut>
  </rim>
  <trdgrp lng="be">
    <trd>&c_l;&c_je;&c_k;&c_t;&c_u;&c_s;</trd>,
    <trd>&c_l;&c_o;&c_zh;&c_a;&c_k; <klr>(&c_d;&c_l;&c_ja; &c_b;&c_a;&c_l;&c_ja;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_ja;)</klr></trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>Kline</trd>,
    <trd>Speisesofa</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>lectus</trd>,
    <trd>&lstroke;o&zdot;e</trd>
  </trdgrp>
  <trdgrp lng="ro">
    <trd>lectus</trd>,
    <trd>pat</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_l;&c_o;&c_zh;&c_je;<klr> (&c_p;&c_i;&c_r;&c_sh;&c_je;&c_s;&c_t;&c_v;&c_je;&c_n;&c_n;&c_o;&c_je;)</klr></trd>,
    <trd>&c_k;&c_l;&c_i;&c_n;&c_i;&c_ja;</trd>,
    <trd>&c_l;&c_je;&c_k;&c_t;&c_u;&c_s;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_o;&c_b;&c_ib;&c_d;&c_n;&c_jeu; &c_l;&c_o;&c_zh;&c_je;</trd>,
    <trd>&c_k;&c_a;&c_n;&c_a;&c_p;&c_a;</trd>,
    <trd>&c_s;&c_o;&c_f;&c_a; (&c_d;&c_l;&c_ja; &c_b;&c_je;&c_n;&c_k;&c_je;&c_t;&c_u;&c_v;&c_a;&c_n;&c_n;&c_ja;)</trd>
  </trdgrp>
</drv>
</art>

