<drv mrk="vintr.0a">
  <kap><tld/>a</kap>
  <snc mrk="vintr.0a.KAL">
    <dif>
      Rilata al <tld/>o, konvena al <tld/>o:
      <ekz>
        <tld/>a nokto
        <fnt>
          <bib>Fab2</bib>
          <lok>Ne&gcirc;a re&gcirc;ino</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a domo
        <fnt>
          <bib>MT</bib>
          <lok>Jeremia 36:22</lok>
        </fnt>;
      </ekz>
      <ekz>
        palaj <tld/>aj sunradioj
        <fnt><bib>InfanTorent2</bib>, <lok>unua parto, &ccirc;apitro
        2a</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_z;&c_ib;&c_m;&c_o;&c_v;&c_y;</trd>
  <trd lng="ca">hivernal</trd>
  <trd lng="cs">zimn&iacute;</trd>
