<drv mrk="vintr.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="vintr.0o.KAL">
    <uzo tip="fak">KAL</uzo>
    <dif>
      En mezvarmaj landoj malvarma <ref tip="lst" cel="sezon.0o.KAL" lst="voko:sezonoj"
      val="4">sezono</ref>, post a&ubreve;tuno, anta&ubreve;
      printempo
      (la&ubreve; la gregoria
      kalendaro en la norda hemisfero de proksimume la 21a tago de
      decembro &gcirc;is la 21a de marto; en la suda de proksimume la 21a de
      junio &gcirc;is la 23a de septembro):
      <ekz>
        pasis la somero kaj la a&ubreve;tuno, sed jen venis la <tld/>o, la malvarma, longa
        <tld/>o
        <fnt>
          <bib>Fab1</bib>
          <lok>Elinjo-fingreto</lok>
        </fnt>;
      </ekz>
      <ekz>
        cikonioj iom post iom kolekti&gcirc;is, por ekflugi anta&ubreve; la <tld/>o al la varmaj
        landoj
        <fnt>
          <bib>Fab1</bib>
          <lok>Cikonioj</lok>
        </fnt>;
      </ekz>
      <ekz>
        estis <tld/>o kaj &ccirc;irka&ubreve;e ku&scirc;is blindige blanka ne&gcirc;o
        <fnt>
          <bib>Fab2</bib>
          <lok>Abio</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;iru rozojn en somero, &ccirc;ar en <tld/>o ili ne estos
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        kio ta&ubreve;gas por somero, ne ta&ubreve;gas por <tld/>o
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
  </snc>
