  <snc mrk="magnet.0o.materialo">
    <dif>
      <klr>(da&ubreve;ra)</klr> Objekto el materialo, kiu pro kunordo de la spinmomantoj de siaj elektronoj
      &ccirc;irka&ubreve; si kreas fortokampon kaj tiel altiras aliaj <tld/>ojn:
      <ekz>
        la fortolinioj de la <tld/>o
        <fnt>
          <bib>VaK</bib>
          <lok>Kvina &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o-resonanc-tomografio
        <fnt>
          <bib>Kon11</bib>
          <lok>Scienco</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        bona patrino, jen estas pli forta <tld/>o
        <fnt>
          <bib>Hamlet</bib>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[ili]</klr> aperas anka&ubreve; sur turista brikabrako: T-&ccirc;emizoj, kru&ccirc;oj,
        <tld/>oj por fridujo kaj bildpo&scirc;tkartoj
        <fnt>
          <bib>Monato</bib>
          <aut>Walter Klag</aut>
          <vrk><url ref="&Monato;/2015/011540.php">Ampolaj paretoj</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
