    </refgrp>
  </snc>
  <snc mrk="magnet.0o.elektromagneto">
    <uzo tip="fak">ELET</uzo>
    <dif>
      <klr>(elektra)</klr> Objekto, kiu per movataj elektraj &scirc;argoj kreas samspecan fortokampon;
      <ref tip="sin" cel="magnet.elektro0o">elektro<tld/>o</ref>:
      <ekz>
        la fizikistoj fandas malgrandan kvanton da purega cezio, de kiu ioma kvanto
        vapori&gcirc;as, per <tld/>o oni aliigas la energistaton de tiuj vapori&gcirc;intaj atomoj
        <fnt>
          <bib>Monato</bib>
          <vrk>Tempo: Pli ekzakte ne eblas: Radi-regata horlo&gcirc;o</vrk>
        </fnt>;
      </ekz>
      <ekz>
        tiuj <tld/>e levitaj veturiloj (t. n. maglevo) uzos altiran kaj forpu&scirc;an fortojn
        kreatajn de super-konduktanta <tld/>o en la vagonoj kun induktaj bobenoj sur
        la gvidaj vojmuroj
        <fnt>
          <bib>Monato</bib>
          <aut>Isikawa Takasi</aut>
          <vrk>E&ccirc; pli rapide</vrk>
          <lok>2014</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
