<drv mrk="magnet.elektro0a">
  <kap>elektro<tld/>a</kap>
  <uzo tip="fak">FIZ</uzo>
  <uzo tip="klr">(pri fenomenoj)</uzo>
  <snc>
    <dif>
      Rilatanta al reciproka efiko de elektra kurento sur <tld/>on
      a&ubreve; elektro<tld/>on, &ccirc;u per vario de la magneta alterno
      al la indukto de elektromotora forto, &ccirc;u de kurento:
      <ekz>
        la sama elektro<tld/>a &scirc;an&gcirc;i&gcirc;o okazas anka&ubreve;
        en la cerbo de paralizuloj, kvankam ili ne kapablas reale estigi
        tiajn movojn
        <fnt><aut>Gianfranco Cazzaro</aut>: <vrk>Nia cerbo "musos",
        &ccirc;u?</vrk>, <bib>Monato</bib><lok>jaro 1997a, numero 4a, p.
        14a</lok></fnt>.
      </ekz>
    </dif>
    <trd lng="en">electromagnetic</trd>
  </snc>
  <adm>
    Dubinda difino. <aut>MB</aut>
  </adm>
  <trd lng="be">&c_e;&c_l;&c_je;&c_k;&c_t;&c_r;&c_a;&c_m;&c_a;&c_g;&c_n;&c_ib;&c_t;&c_n;&c_y;</trd>
  <trd lng="de">elektromagnetisch</trd>
  <trd lng="es">electromagn&eacute;tico</trd>
  <trd lng="fr">&eacute;lectromagn&eacute;tique</trd>
  <trd lng="he">&alef;&lamed;&qof;&tet;&resh;&vav;&mem;&gimel;&nun;&tet;&yod;&tav;</trd>
  <trd lng="hu">elektrom&aacute;gneses</trd>
