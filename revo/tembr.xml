<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: tembr.xml,v 1.26 2026/07/28 15:03:51 revo Exp $">
<kap>
  <rad>tembr</rad>/o <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="tembr.0o">
  <kap><tld/>o</kap>
  <snc mrk="tembr.0o.MUZ">
    <uzo tip="fak">MUZ</uzo>
    <dif>
      Propra ecaro de sonoro varianta la&ubreve; speco
      kaj kvalito de la instrumento a&ubreve; de la vo&ccirc;o
      depende je la harmonoj, kiuj akompanas la fundamentan tonon:
      <ekz>
        ne nur &ccirc;iu el la diversaj muzikaj instrumentoj havas sian propran <tld/>on, sed
        anka&ubreve; &ccirc;iu unuopa instrumento de la sama kategorio
        <fnt>
          <bib>Ret</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        oni distingas la intensecon, la altecon, la <tld/>on kaj la flekseblecon de la
        vo&ccirc;o
        <fnt>
          <bib>Ret</bib>
          <lok>Dua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;e Persone la kantado <klr>[&#x2026;]</klr> estas sufi&ccirc;e originala kaj per sia modulado
        kaj <tld/>o
        <fnt>
          <bib>LOdE</bib>
          <lok>2003, &#x2116; 7 (105)</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Timbre</trd>
    <trd lng="pl">tembr</trd>
  </snc>
  <snc mrk="tembr.0o.FON">
    <uzo tip="fak">FON</uzo>
    <dif>
      Eco propra kaj distingiga de &ccirc;iu vokalo, ka&ubreve;zata de
      kombino de baza noto kun &gcirc;iaj harmonoj:
      <ekz>
        en la klasika latina, <klr>[&#x2026;]</klr> la mallongaj vokaloj &scirc;ajne diferencis anka&ubreve;
        <tld/>e de la respondaj vokaloj longaj
        <fnt>
          <bib>LAE</bib>
          <lok>2. Fonetiko</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Klangfarbe</trd>
    <trd lng="pl">barwa g&lstroke;osu</trd>
  </snc>
  <refgrp tip="sin">
    <ref cel="kolor.son0o">sonkoloro</ref>
  </refgrp>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Prefere diru <ke>tonkoloro</ke>, <ke>sonkvalito</ke>, <ke>sonnuanco</ke>.
  </rim>
  <trd lng="be">&c_t;&c_e;&c_m;&c_b;&c_a;&c_r;</trd>
  <trdgrp lng="cs">
    <trd>timbre</trd>,
    <trd>t&eacute;mbr</trd>,
    <trd>zabarven&iacute; hlasu</trd>
  </trdgrp>
  <trd lng="en">timbre</trd>
  <trd lng="es">timbre</trd>
  <trdgrp lng="fr">
    <trd>couleur musicale</trd>,
    <trd>timbre<klr> (sonore)</klr></trd>
  </trdgrp>
  <trdgrp lng="hu">
    <trd>hangsz&iacute;n</trd>,
    <trd>hang&aacute;rnyalat</trd>
  </trdgrp>
  <trd lng="ja">&#x97F3;&#x8272;  <pr>&#x306D;&#x3044;&#x308D;</pr></trd>
  <trd lng="nl">timbre</trd>
  <trdgrp lng="pt">
    <trd>timbre</trd>
  </trdgrp>
  <trd lng="ru">&c_t;&c_je;&c_m;&c_b;&c_r;</trd>
  <trdgrp lng="sk">
    <trd>sfarbenie hlasu</trd>,
    <trd>timbre</trd>,
    <trd>v&yacute;slovnosti</trd>
  </trdgrp>
  <trd lng="uk">&c_t;&c_je;&c_m;&c_b;&c_r;</trd>
  <trdgrp lng="zh">
    <trd>&#x97F3;&#x8CEA; <pr>y&imacron;nzh&igrave;</pr></trd>,
    <trd>&#x97F3;&#x8D28; <pr>y&imacron;nzh&igrave;</pr></trd>,
    <trd>&#x58F0;&#x7EBF; <pr>sh&emacron;ngxi&agrave;n</pr></trd>,
    <trd>&#x8072;&#x7DDA; <pr>sh&emacron;ngxi&agrave;n</pr></trd>,
    <trd>&#x97F3;&#x8272; <pr>y&imacron;ns&egrave;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="tembr.0igxi">
  <kap><tld/>i&gcirc;i</kap>
  <gra><vspec>ntr</vspec></gra>
  <snc mrk="tembr.0igxi.SON">
    <dif>
      Ricevi <tld/>on, apartan son-nuancon:
      <ekz>
        &scirc;ia vo&ccirc;o <tld/>i&gcirc;is de intenca maldelikateco
        <fnt>
          <aut>F. Ko&zcaron;&iacute;k, trad. J. Karen kaj J. Vondrou&scaron;ek</aut>,
          <vrk>La plej eminenta inter Pierotoj</vrk>,
          <lok>2001</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_n;&c_a;&c_b;&c_y;&c_v;&c_a;&c_c;&c_mol; <ind>&c_t;&c_e;&c_m;&c_b;&c_a;&c_r;</ind></trd>
  <trdgrp lng="de">
    <trd>sich <ind>einf&auml;rben</ind> <klr>(Stimme)</klr></trd>,
    <trd>eine <ind>Klangfarbe</ind> bekommen</trd>
  </trdgrp>
  <trd lng="fr">se <ind>colorer</ind><klr> (son)</klr></trd>
  <trd lng="pl">kolorowa&cacute;  <klr>(d&zacute;wi&eogonek;k)</klr></trd>
</drv>
</art>
