<vortaro>
  <art mrk="$Id: metastabil.xml,v 1.1 2026/11/21 19:45:09 afido Exp $">
    <kap>
      <rad>metastabil</rad>/a
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="metastabil.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">FIZ</uzo>
  <snc>
    <dif>
      Duon<ref tip="super" cel="stabil.0a">stabila</ref>, t.e. en stabila ekvilibro kontra&ubreve; nur malgrandaj &scirc;an&gcirc;oj:
      <ekz>
        la gama-kaduki&gcirc;o de ekscititaj <tld/>aj atomizomeroj
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=33259"
              >Radioaktiveco</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        molekuloj <klr>[&#x2026;]</klr> organikaj, kiuj en senoksigena atmosfero fari&gcirc;adis
        <tld/>aj
        <fnt>
          <bib>SR</bib>
          <aut>Cz. Biedulski</aut>
          <vrk>Biogenezo en la medio de prekambrio kaj kambrio</vrk>
          <lok>Scienca Revuo, nro 117/1976</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">metastabil</trd>
    <trd lng="en">metastable</trd>
    <trd lng="fr">m&eacute;tastable</trd>
  </snc>
</drv>

  </art>


