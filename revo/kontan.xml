<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kontan.xml,v 1.27 2026/09/25 23:20:26 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>kontant</rad>/a <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="kontan.0a">
  <kap><ofc>*</ofc><tld/>a</kap>
  <snc>
    <dif>
      En formo de moneroj kaj monbiletoj:
      <ekz>
        la eldonisto pagas al li <tld/>an monon
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Unua</lok>
        </fnt>;
      </ekz>
      <ekz>
        akiri <tld/>an monon en alia lando
        <fnt>
          <aut>R. Rotsaert</aut>,
          <vrk>Pagi ene de la E&ubreve;ropa Unio kostos malpli</vrk>,
          <bib>Monato</bib>,
          <lok>2002:2, p. 10a</lok>
        </fnt>;
      </ekz>
      <ekz>
        akiri <tld/>an monon per kreditkarto ofte multe kostas
        <fnt>
          <bib>Monato</bib>
          <aut>Roland Rotsaert</aut>
          <vrk><url ref="&Monato;/2006/008954.php"
              >SEPA: la fina fazo de la enkonduko de e&ubreve;ro</url></vrk>
          <lok>2006</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        vi akceptas por <tld/>a mono &#11005; La vortojn, kiuj vere ne enhavas &#11005; E&ccirc; plej
        malgrandan indon
        <klr>(sen kontrolo kredas la verecon de la dirita)</klr>
        <fnt>
          <bib>Hamlet</bib>
          <lok>Hamleto</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_n;&c_a;&c_ja;&c_w;&c_n;&c_y; <klr>(&c_p;&c_r;&c_a; &c_g;&c_r;&c_o;&c_sh;&c_y;)</klr></trd>
  <trd lng="bg">&c_b;&c_r;&c_o;&c_j;</trd>
  <trdgrp lng="cs">
    <trd>hotov&ecaron; plat&iacute;c&iacute;</trd>,
    <trd>okam&zcaron;it&ecaron; placen&yacute;</trd>
  </trdgrp>
  <trd lng="de">bar</trd>
  <trdgrp lng="en">
    <trd>paid in cash</trd>,
    <trd>cash</trd>
  </trdgrp>
  <trd lng="fa">&a_n;&a_q;&a_d;</trd>
  <trd lng="fr">comptant<klr> (adj.)</klr></trd>
  <trdgrp lng="id">
    <trd>tunai</trd>,
    <trd>kontan</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21363;&#26178;&#25173;&#12356;&#x306E;  <pr>&#x305D;&#x304F;&#12376;&#x306F;&#12425;&#12356;&#x306E;</pr></trd>,
    <trd>&#21363;&#x91D1;&#x306E;  <pr>&#x305D;&#x304F;&#x304B;&#x306D;&#x306E;</pr></trd>,
    <trd>&#x73FE;&#x91D1;&#x306E;  <pr>&#12370;&#12435;&#x304D;&#12435;&#x306E;</pr></trd>
  </trdgrp>
  <trd lng="nl">contant<klr tip="ind"> (bn.)</klr></trd>
  <trd lng="pl">got&oacute;wk&aogonek; p&lstroke;atny</trd>
  <trd lng="ro">numerar pl&abreve;tite</trd>
  <trd lng="ru">&c_n;&c_a;&c_l;&c_i;&c_ch;&c_n;&c_y;&c_j; <klr>(&c_o; &c_d;&c_je;&c_n;&c_mol;&c_g;&c_a;&c_h;)</klr></trd>
  <trd lng="sk">platiaci v hotovosti</trd>
  <trd lng="zh">&#x73B0;&#x91D1; <pr>xi&agrave;nj&imacron;n</pr></trd>
</drv>

<drv mrk="kontan.0e">
  <kap><tld/>e</kap>
  <snc mrk="kontan.0e.monere">
    <dif>
      Per moneroj kaj monbiletoj:
      <ekz>
        li alsendis iom da &gcirc;i <tld/>e, kaj la resta&jcirc;on kiel tukoj, &scirc;tofoj, lana&jcirc;oj,
        <fnt>
          <bib>Rob</bib>
          <lok>Parto I</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[&scirc;i]</klr> pagis la tutan sumon <tld/>e, kiam &scirc;i venis ricevi la &scirc;losilojn
        <fnt>
          <bib>ChR</bib>
          <lok>Veli morten</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Sara</nom> kostos al vi <klr>[&#8230;]</klr> dek talentojn jare, <tld/>e
        <fnt>
          <bib>Far1</bib>
          <lok>&Ccirc;apitro V</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="kontan.0e.EKON">
    <uzo tip="fak">EKON</uzo>
    <dif>
      En a&ccirc;eto, ne prokrastante inter akiro kaj pago.
    </dif>
    <refgrp tip="ant">
      <ref cel="kredit.0e">kredite</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_n;&c_a;&c_ja;&c_w;&c_n;&c_y;&c_m;&c_ib; <klr>(&c_p;&c_r;&c_a; &c_p;&c_l;&c_a;&c_c;&c_jo;&c_zh;)</klr></trd>
  <trd lng="bg">&c_b;&c_r;&c_o;&c_j;</trd>
  <trd lng="de">bar</trd>
  <trdgrp lng="en">
    <trd>paid in cash</trd>,
    <trd>paid immediately</trd>
  </trdgrp>
  <trdgrp lng="fa">
    <trd>&a_n;&a_q;&a_d;</trd>,
    <trd>&a_n;&a_q;&a_d;&a_A;&a_fathatan;</trd>
  </trdgrp>
  <trd lng="fr">comptant<klr> (adv.)</klr></trd>
  <trdgrp lng="id">
    <trd><baz>cara</baz>secara tunai</trd>,
    <trd><baz>cara</baz>secara kontan</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#21363;&#26178;&#25173;&#12356;&#12391;  <pr>&#x305D;&#x304F;&#12376;&#x306F;&#12425;&#12356;&#12391;</pr></trd>,
    <trd>&#21363;&#x91D1;&#12391;  <pr>&#x305D;&#x304F;&#x304B;&#x306D;&#12391;</pr></trd>,
    <trd>&#x73FE;&#x91D1;&#12391;  <pr>&#12370;&#12435;&#x304D;&#12435;&#12391;</pr></trd>
  </trdgrp>
  <trd lng="nl">contant<klr tip="ind"> (bw.)</klr></trd>
  <trdgrp lng="pl">
    <trd>got&oacute;wk&aogonek; p&lstroke;atne</trd>,
    <trd>w <ind>got&oacute;wce</ind></trd>
  </trdgrp>
  <trd lng="ro">pl&abreve;tit &icirc;n bani</trd>
</drv>

<drv mrk="kontan.0o">
  <kap><tld/>o</kap>
  <snc mrk="kontan.0o.EKON">
    <dif>
      Tuj disponebla mono:
      <ekz>
        li <klr>[&#8230;]</klr> ur&gcirc;e bezonas <tld/>on
        <fnt>
          <aut>Lao She, trad. Wang Chongfang</aut>,
          <vrk><url ref="http://edu.i-lo.tarnow.pl/esp/lern/librejo/0026/">
          Kamelo &Scirc;jangzi</url></vrk>,
          <lok>1988</lok>
        </fnt>;
      </ekz>
      <ekz>
        la rilato de la homoj inter si en &ccirc;iuj direktoj i&gcirc;as multe pli dependanta de la
        <tld/>o, ol de la frateco
        <fnt>
          <bib>VRA</bib>
          <lok>Gustav Hedenvind Eriksson</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_n;&c_a;&c_ja;&c_w;&c_n;&c_y;&c_ja; &c_g;&c_r;&c_o;&c_sh;&c_y;</trd>
  <trd lng="en">cash</trd>
  <trd lng="fr">argent comptant</trd>
  <trd lng="id">uang tunai</trd>
  <trdgrp lng="ja">
    <trd>&#21363;&#26178;&#25173;&#12356;  <pr>&#x305D;&#x304F;&#12376;&#12400;&#12425;&#12356;</pr></trd>,
    <trd>&#x73FE;&#x91D1;&#25173;&#12356;  <pr>&#12370;&#12435;&#x304D;&#12435;&#12400;&#12425;&#12356;</pr></trd>
  </trdgrp>
  <trd lng="pl">got&oacute;wka</trd>
  <trd lng="ro">numerar</trd>
  <trd lng="zh">&#x73B0;&#x91D1; <pr>xi&agrave;nj&imacron;n</pr></trd>
</drv>

</art>
