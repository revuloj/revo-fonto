<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: auxtor.xml,v 1.33 2026/09/08 08:59:34 revo Exp $">
<kap>
  <ofc>*</ofc><ofc>1</ofc><ofc>7</ofc>
  <rad>a&ubreve;tor</rad>/o <fnt><bib>JED</bib></fnt>
</kap>
<drv mrk="auxtor.0o">
  <kap><tld/>o</kap>
  <snc mrk="auxtor.0o.JUR">
    <dif>
      Verkinto (de libro a&ubreve; de scienca, literatura, belarta verko):
      <ekz>
        <nom>Przyjemski</nom> <klr>[&#x2026;]</klr> tu&scirc;ante &ccirc;iun libron per la fingro, diris la nomon de
        la <tld/>o kaj titolon de la verko
        <fnt>
          <bib>IK</bib>
          <lok>&Ccirc;aptiro III</lok>
        </fnt>;
      </ekz>
      <ekz>
        per <klr>[tiu satiro]</klr> la <tld/>o de <nom>Kandid</nom> disbatas la filozofian sistemon
        de <nom>Lajbnic</nom>
        <fnt>
          <bib>Kandid</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        tiujn &ccirc;i tri verkojn la <tld/>o de Esperanto rigardadis &ccirc;iam kiel le&gcirc;ojn
        <fnt>
          <bib>F</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la plano estis prudenta, sed la <tld/>oj faris unu eraron: ili ne anta&ubreve;sentis,
        ke en <nom>Ramzes</nom> dormis genia generalo
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro XVII</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="editor.0o">editoro</ref>
    </refgrp>
    <trd lng="bg">&c_a;&c_v;&c_t;&c_o;&c_r;</trd>
    <trdgrp lng="br">
      <trd>aozer</trd>,
      <trd>oberour</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Autor</trd>,
      <trd>Verfasser</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>&iacute;r&oacute;</trd>,
      <trd>szerz&odblac;</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd><baz>tulis</baz>penulis</trd>,
      <trd><baz>karang (2)</baz>pengarang</trd>
    </trdgrp>
    <trd lng="nl">auteur</trd>
    <trdgrp lng="zh">
      <trd>&#x8457;&#x4F5C;&#x6743;&#x4EBA; <pr>zh&ugrave;zu&ograve;qu&aacute;nr&eacute;n</pr></trd>,
      <trd>&#x8457;&#x4F5C;&#x6B0A;&#x4EBA; <pr>zh&ugrave;zu&ograve;qu&aacute;nr&eacute;n</pr></trd>,
      <trd>&#x4F5C;&#x8005; <pr>zu&ograve;zh&ecaron;</pr></trd>
    </trdgrp>
  </snc>
  <snc mrk="auxtor.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Farinto, kreinto, elpensinto:
      <ekz>
        li estas <tld/>o de sia propra
        malfeli&ccirc;o;
      </ekz>
      <ekz>
        direktante la rigardon al la <tld/>o kaj perfektiganto de la fido, Jesuo
        <fnt>
          <bib>NT</bib>
          <lok>Hebreoj 12:2</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Urheber</trd>,
      <trd>Sch&ouml;pfer</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>szerz&odblac;</trd>,
      <trd>okoz&oacute;</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd><baz>cipta</baz>pencipta</trd>,
      <trd><baz>cetus</baz>pencetus</trd>
    </trdgrp>
    <trdgrp lng="zh">
      <trd>&#x521B;&#x9020;&#x4E3B; <pr>chu&agrave;ngz&agrave;ozh&#x1D4;</pr></trd>,
      <trd>&#x5275;&#x9020;&#x4E3B; <pr>chu&agrave;ngz&agrave;ozh&#x1D4;</pr></trd>,
      <trd>&#x521B;&#x59CB;&#x8005; <pr>chu&agrave;ngsh&#x1D0;zh&ecaron;</pr></trd>,
      <trd>&#x5275;&#x59CB;&#x8005; <pr>chu&agrave;ngsh&#x1D0;zh&ecaron;</pr></trd>,
      <trd>&#x7740;&#x4F5C;&#x4EBA; <pr>zh&ugrave;zu&ograve;r&eacute;n</pr></trd>,
      <trd>&#x8457;&#x4F5C;&#x4EBA; <pr>zh&ugrave;zu&ograve;r&eacute;n</pr></trd>
    </trdgrp>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>verkinto</ke>,
    <ke><ref tip="sin" cel="kre.0into.iu">kreinto</ref></ke>.
  </rim>

  <trd lng="be">&c_a;&c_w;&c_t;&c_a;&c_r;</trd>
  <trd lng="bo">&t_ra;&t_tsata;&t_naro;&t_ma;&t_tsheg;&t_pa;&t_tsheg;&t_pa;&t_naro;&t_tsheg;</trd>
  <trd lng="en">author</trd>
  <trd lng="es">autor</trd>
  <trd lng="fr">auteur</trd>
  <trd lng="he">&mem;&#x5B0;&het;&#x5B7;&bet;&#x5BC;&#x5B5;&resh;</trd>
  <trd lng="it">autore</trd>
  <trdgrp lng="pl">
    <trd>autor</trd>,
    <trd>tw&oacute;rca</trd>
  </trdgrp>
  <trd lng="pt">autor</trd>
  <trd lng="ro">autor</trd>
  <trd lng="ru">&c_a;&c_v;&c_t;&c_o;&c_r;</trd>
  <trd lng="sk">autor</trd>
  <trd lng="uk">&c_a;&c_v;&c_t;&c_o;&c_r;</trd>
</drv>

<drv mrk="auxtor.0a">
  <kap><tld/>a</kap>
  <snc mrk="auxtor.0a.JUR">
    <dif>
      Rilata al a&ubreve;toro:
      <ekz>
        <ind><tld/>aj rajtoj</ind>;
        <trd lng="be">&c_a;&c_w;&c_t;&c_a;&c_r;&c_s;&c_k;&c_a;&c_je; &c_p;&c_r;&c_a;&c_v;&c_a;</trd>
        <trd lng="de">Urheberrechte</trd>
        <trd lng="es">derechos de autor</trd>
      </ekz>
      <ekz>
        bro&scirc;ureto, presita sen <tld/>a nomo
        <fnt>
          <bib>VivZam</bib>
          <lok>Vivo de Zamenhof</lok>
        </fnt>;
      </ekz>
      <ekz>
        Karaj kongresanoj! &Ccirc;io, kion mi diris, ne estas ia <tld/>a memfido,
        <klr>[sed&#x2026;]</klr>
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Sesa Kongreso Esperantista en Washington en la 15a de a&ubreve;gusto 1910</vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_a;&c_w;&c_t;&c_a;&c_r;&c_s;&c_k;&c_ib;</trd>
  <trdgrp lng="de">
    <trd>Autoren-</trd>,
    <trd>Verfasser-</trd>,
    <trd>Urheber-</trd>
  </trdgrp>
  <trd lng="hu">szerz&odblac;i</trd>
  <trd lng="id">autoral</trd>
  <trd lng="it">d'<ind>autore</ind></trd>
  <trd lng="nl">auteurs-</trd>
  <trdgrp lng="pl">
    <trd>autorski</trd>,
    <trd>pisarski</trd>
  </trdgrp>
  <trd lng="ru">&c_a;&c_v;&c_t;&c_o;&c_r;&c_s;&c_k;&c_i;&c_j;</trd>
  <trd lng="sk">autorsk&yacute;</trd>
  <trd lng="uk">&c_a;&c_v;&c_t;&c_o;&c_r;&c_s;&c_mol;&c_k;&c_i;&c_j;</trd>
</drv>

<drv mrk="auxtor.0i">
  <kap><tld/>i</kap>
  <gra><vspec>tr</vspec></gra>
  <snc mrk="auxtor.0i.JUR">
    <dif>
      Esti <tld/>o de,
      <ref tip="dif" cel="verk.0i">verki</ref>:
      <ekz>
        <ctl>La pupo</ctl> estas unu el la plej gravaj romanoj
        de la pola literaturo, <tld/>ita de <nom>Boles&lstroke;aw Prus</nom>
        <fnt>
          <aut>P. Fischer-Kotowski</aut>,
          <vrk><url ref="http://www.liberafolio.org/2016/12/28/libroj-de-la-jaro-2016/">,
          26 libroj de la jaro 2016</url></vrk>,
          <lok>libera folio, 2016-12-28</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;i kun<tld/>is kelkajn instrulibrojn
        <fnt>
          <bib>OIP</bib>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="br">sevel<klr tip="ind"> (un oberenn)</klr></trd>
    <trdgrp lng="de">
      <trd>schaffen</trd>,
      <trd>verfassen</trd>
    </trdgrp>
    <trd lng="en"><klr>to </klr>author</trd>
    <trdgrp lng="hu">
      <trd>szerez<klr tip="ind"> (m&udblac;vet)</klr></trd>,
      <trd>&iacute;r<klr tip="ind"> (m&udblac;vet)</klr></trd>
    </trdgrp>
    <trdgrp lng="it">
      <trd>scrivere<klr> (creare)</klr></trd>,
      <trd>creare<klr> (comporre)</klr></trd>,
      <trd>comporre<klr> (creare)</klr></trd>
    </trdgrp>
    <trd lng="nl">schrijven<klr tip="ind"> (v.boek)</klr></trd>
    <trdgrp lng="zh">
      <trd>&#x7DE8;&#x5BEB; <pr>bi&amacron;nxi&ecaron;</pr></trd>,
      <trd>&#x7F16;&#x5199; <pr>bi&amacron;nxi&ecaron;</pr></trd>,
      <trd>&#x64B0; <pr>zhu&agrave;n</pr></trd>,
      <trd>&#x8B54; <pr>zhu&agrave;n</pr></trd>,
      <trd>&#x7DE8;&#x8457; <pr>bi&amacron;nzh&ugrave;</pr></trd>,
      <trd>&#x7F16;&#x8457; <pr>bi&amacron;nzh&ugrave;</pr></trd>,
      <trd>&#x8457;&#x4F5C; <pr>zh&ugrave;zu&ograve;</pr></trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_b;&c_y;&c_c;&c_mol; <ind>&c_a;&c_w;&c_t;&c_a;&c_r;&c_a;&c_m;</ind></trd>,
    <trd>&c_s;&c_t;&c_v;&c_a;&c_r;&c_a;&c_c;&c_mol;</trd>
  </trdgrp>
  <trd lng="he">&lamed;&het;&bet;&resh;</trd>
  <trdgrp lng="id">
    <trd><baz>karang (2)</baz>mengarang</trd>,
    <trd><baz>susun</baz>menyusun</trd>,
    <trd><baz>cipta</baz>mencipta</trd>,
    <trd><baz>tulis</baz>menulis (karya)</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>stworzy&cacute;</trd>,
    <trd>by&cacute;  <ind>autorem</ind></trd>
  </trdgrp>
</drv>

<drv mrk="auxtor.0signo">
  <kap><tld/>signo</kap>
  <snc>
    <dif>
      Signo montranta la <tld/>on de iu tekstloko;
      <ref tip="sin" cel="refere.0o.bibliografia">referenco<sncref/></ref>.
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_z;&c_n;&c_a;&c_ch;&c_e;&c_n;&c_mol;&c_n;&c_je; <ind>&c_a;&c_w;&c_t;&c_a;&c_r;&c_a;</ind></trd>
  <trdgrp lng="de">
    <trd>Autorangabe</trd>,
    <trd>Verfasserangabe</trd>
  </trdgrp>
  <trd lng="he">&alef;&vav;&tav; &alef;&vav;&tet;&vav;&mem;&tet;&yod;</trd>
  <trd lng="hu">hivatkoz&aacute;s szerz&odblac;re</trd>
  <trdgrp lng="id">
    <trd>atribusi pengarang</trd>,
    <trd><baz>terang</baz>keterangan pengarang</trd>,
    <trd>atribusi penulis</trd>,
    <trd><baz>terang</baz>keterangan penulis</trd>
  </trdgrp>
  <trdgrp lng="pl">
    <trd>znak  <ind>autora</ind></trd>,
    <trd>referencja <ind>autorska</ind></trd>
  </trdgrp>
</drv>

<drv mrk="auxtor.kun0o">
  <kap>kun<tld/>o</kap>
  <snc mrk="auxtor.kun0o.JUR">
    <dif>
      Tiu, kiu parte verkis:
      <ekz>
        tutkoran dankon al la kun<tld/>oj, al la teknika redaktoro, al &ccirc;iuj kontribuintoj
        <fnt>
          <bib>EeP</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la subskribinto kiel &ccirc;efredaktoro klopodis, en amikaj diskutoj kun la du
        kun<tld/>oj <klr>[&#x2026;]</klr> forigi la malsamecojn
        <fnt>
          <bib>EeP</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        a &ccirc;efa oma&gcirc;o al la Manifesto de <nom>Rauma</nom> (1980) okazis <klr>[&#x2026;]</klr> kadre de
        seminario 20 jaroj post Ra&ubreve;mo preparita de <nom>Jouko Lindstedt</nom>, unu el la tri
        kun<tld/>oj de la dokumento
        <fnt>
          <bib>LOdE</bib>
          <lok>2001, &#x2116;1</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="zh">
      <trd>&#x5408;&#x7740;&#x8005; <pr>h&eacute;zhu&oacute;zh&ecaron;</pr></trd>,
      <trd>&#x5408;&#x8457;&#x8005; <pr>h&eacute;zhu&oacute;zh&ecaron;</pr></trd>,
      <trd>&#x5171;&#x540C;&#x57F7;&#x7B46;&#x8005; <pr>g&ograve;ngt&oacute;ngzh&iacute;b&#x1D0;zh&ecaron;</pr></trd>,
      <trd>&#x5171;&#x540C;&#x6267;&#x7B14;&#x8005; <pr>g&ograve;ngt&oacute;ngzh&iacute;b&#x1D0;zh&ecaron;</pr></trd>
    </trdgrp>
  </snc>
  <trd lng="be">&c_s;&c_a;&c_a;&c_w;&c_t;&c_a;&c_r;</trd>
  <trd lng="br">kenoberour</trd>
  <trdgrp lng="de">
    <trd>Co-Autor</trd>,
    <trd>Mitautor</trd>,
    <trd>Mitverfasser</trd>
  </trdgrp>
  <trd lng="en">co-author</trd>
  <trd lng="es">coautor</trd>
  <trd lng="fr">co-auteur</trd>
  <trd lng="hu">t&aacute;rsszerz&odblac;</trd>
  <trd lng="id"><baz>tulis</baz>penulis bersama</trd>
  <trd lng="it">co-autore</trd>
  <trd lng="nl">coauteur</trd>
  <trd lng="pl">wsp&oacute;&lstroke;autor</trd>
  <trd lng="ru">&c_s;&c_o;&c_a;&c_v;&c_t;&c_o;&c_r;</trd>
  <trd lng="sk">spoluautor</trd>
  <trd lng="uk">&c_s;&c_p;&c_ib;&c_v;&c_a;&c_v;&c_t;&c_o;&c_r;</trd>
</drv>
</art>
