  <trd lng="uk">&c_r;&c_je;&c_v;&c_ib;&c_z;&c_o;&c_r;</trd>
  <trdgrp lng="zh">
    <trd>&#23457;&#35745;&#21592; <pr>sh&ecaron;nj&igrave;yu&aacute;n</pr></trd>,
    <trd>&#23529;&#35336;&#21729; <pr>sh&ecaron;nj&igrave;yu&aacute;n</pr></trd>,
