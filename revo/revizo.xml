  </trdgrp>
  <trdgrp lng="cs">
    <trd>p&rcaron;ehl&iacute;&zcaron;itel</trd>,
    <trd>revizor</trd>
  </trdgrp>
  <trd lng="de">Revisor</trd>
  <trdgrp lng="en">
    <trd>government inspector</trd>,
    <trd>inspector-general</trd>
  </trdgrp>
  <trd lng="es">supervisor</trd>
  <trd lng="fr">r&eacute;viseur</trd>
  <trdgrp lng="hu">
    <trd>revizor</trd>,
    <trd>fel&uuml;gyel&odblac;</trd>,
    <trd>ellen&odblac;r</trd>
    </trdgrp>
  <trdgrp lng="ja">
    <trd>&#26908;&#23519;&#23448;  <pr>&#12369;&#12435;&#12373;&#12388;&#12363;&#12435;</pr></trd>,
    <trd>&#30435;&#26619;&#24441;  <pr>&#12363;&#12435;&#12373;&#12420;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="nl">revisor</trd>
  <trdgrp lng="pl">
    <trd>rewident</trd>,
    <trd>audytor</trd>
  </trdgrp>
  <trd lng="pt">inspetor geral</trd>
  <trdgrp lng="ro">
