<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: vign.xml,v 1.2 2026/10/05 05:29:42 afido Exp $">
    <kap>
      <rad>vign</rad>/o
      <fnt><bib>PIV2</bib></fnt>
    </kap>

<drv mrk="vign.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">BOT</uzo>
    <dif>
      <ref tip="lst" lst="voko:botanikaj_genroj" cel="genr.0o.BIO">Genro</ref> el familio
      <ref tip="malprt" cel="fabac.0oj">fabacoj</ref> (<trd lng="la">Vigna</trd>)
      parenca al fazeolo, el kiu kelkaj specioj estas kultivataj kiel legomo:
      <ekz>
        la 8-an de la 12-a monato la&ubreve; la &ccirc;ina luna kalendaro <klr>[&#x2026;]</klr> oni man&gcirc;as
        man&gcirc;a&jcirc;on el glueca rizo, jujuboj kaj <tld/>o (<nom>Vigna cylindrica</nom>)
        <fnt>
          <aut>Huang Fu</aut>
          <vrk><url ref="https://tempa.bitarkivo.org/gazetoj/ElPopolaChinio/ElPopolaChinio_2000_n02.pdf"
              >&leftquot;Karnavalo&rightquot; sur la Le&ubreve;sa Altebena&jcirc;o</url></vrk>
          <lok>El Popola &Ccirc;inio, 2/2000, p. 32</lok>
        </fnt>;
      </ekz>
      <ekz>
        la <trd lng="">okulvigno</trd> <klr>[&#x2026;]</klr> estas kultivata en Afriko, Latinameriko, sudorienta
        Azio kaj en la sudo de Usono
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=550932"
              >Okulvigno</url></lok>
        </fnt>;
        <trd lng="de">Augenbohne</trd>
        <trd lng="en">cowpea</trd>
      </ekz>
      <ekz>
        la asparaga <tld/>o <klr>[&#x2026;]</klr> produktas gu&scirc;ojn &gcirc;is a&ubreve;tuno, kondi&ccirc;e ke la
        gu&scirc;oj estas rikoltataj regule
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=552328"
              >Asparaga vigno</url></lok>
        </fnt>.
        <trd lng="de">Spargelbohne</trd>
        <trd lng="en">asparagus bean</trd>
        <trdgrp lng="fr">
          <trd>dolique asperge</trd>,
          <trd>haricot kilom&egrave;tre</trd>
        </trdgrp>
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/d/d0/BlackEyedPeas.JPG/250px-BlackEyedPeas.JPG"
      prm="CC BY-SA 3.0"
      >Grajnoj de okul<tld/>o (Vigna unguiculata subsp. unguiculata)
        <fnt>
          <aut>Toby Hudson, propra verko</aut>
          <lok><url ref="&WCW;/File:BlackEyedPeas.JPG"
              >https://commons.wikimedia.org/wiki/File:BlackEyedPeas.JPG</url></lok>
        </fnt>
    </bld>
    <ref tip="vid" cel="fab.rugxa0o.azia">ru&gcirc;a fabo</ref>
    <trd lng="de">Vigna</trd>
    <trd lng="en">Vigna</trd>
    <trd lng="fr">Vigna</trd>
    <trd lng="ja">&#x30B5;&#x30B5;&#x30B2;&#x5C5E; <pr>&#x3055;&#x3055;&#x3052;&#x305E;&#x304F;</pr></trd>
    <trd lng="zh">&#x8C47;&#x8C46;&#x5C5E; <pr>ji&amacron;ng d&ograve;u sh&#x1D4;</pr></trd>
  </snc>
</drv>

  </art>

