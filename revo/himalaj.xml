<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: himalaj.xml,v 1.23 2026/10/15 20:00:21 revo Exp $">
<kap><ofc>10</ofc>
  <rad>Himalaj</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="himalaj.H0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      La plej alta <ref tip="lst" cel="mont.0aro" lst="voko:montaroj">montaro</ref>
      de la tero, inter Tibeto norde kaj Indus-Ganga ebena&jcirc;o sude;
      en &gcirc;i fontas la &ccirc;efaj riveroj de la
      <ref tip="malprt" cel="azi.SudaA0o">Suda Azio</ref>:
      <ekz>
        <ctl>nun vi povas jam vidi la <tld/>on!</ctl> diris la
        Orienta vento, &leftquot;&gcirc;i estas la plej alta montaro en
        Azio <klr>[&#8230;]</klr>&rightquot;
        <fnt><bib>Fab1</bib>, <lok>&Gcirc;ardeno de la paradizo</lok>.</fnt>;
      </ekz>
      <ekz>
        li ekiris la vojon tra <tld/>oj al Tibeto
        <fnt>
          <bib>IKr</bib>
          <lok>La Miraklo De Purun Bhagat</lok>
        </fnt>;
      </ekz>
      <ekz>
        britaj alpismaj ekspedicioj en <tld/>o
        <fnt><aut>Evgeni Georgiev</aut>: <vrk><url ref="&Monato;/2000/007116.html">Sir Edmund
        Hillary: Vivo dedi&ccirc;e al la &scirc;erpoj</url></vrk>,
        <bib>Monato</bib><lok>2000/10, p.
        18</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_G;&c_ib;&c_m;&c_a;&c_l;&c_a;&c_ib;</trd>
  <trd lng="bg">&c_H;&c_i;&c_m;&c_a;&c_l;&c_a;&c_i;</trd>
  <trd lng="bo">&t_ha;&t_gigu;&t_tsheg;&t_ma;&t_tsheg;&t_la;&t_tsheg;&t_ya;&t_tsheg;</trd>
  <trd lng="ca">Him&agrave;laia</trd>
  <trdgrp lng="de">
    <trd>Himalayagebirge</trd>,
    <trd>Himalaya</trd>
  </trdgrp>
  <trd lng="en">Himalayas</trd>
  <trd lng="es">Himalaya</trd>
  <trd lng="fr">Himalaya</trd>
  <trd lng="hu">Himal&aacute;ja</trd>
  <trd lng="it">Himalaya</trd>
  <trd lng="ja">&#12498;&#12510;&#12521;&#12516;&#23665;&#33032; 
  <pr>&#12498;&#12510;&#12521;&#12516;&#12373;&#12435;&#12415;&#12419;&#12367;</pr></trd>
  <trd lng="nl">Himalaya</trd>
  <trd lng="pl">Himalaje</trd>
  <trd lng="pt">Himalaia</trd>
  <trd lng="ru">&c_G;&c_i;&c_m;&c_a;&c_l;&c_a;&c_i;</trd>
  <trd lng="uk">&c_g;&c_o;&c_r;&c_i; &c_G;&c_ib;&c_m;&c_a;&c_l;&c_a;&c_ji;</trd>
  <trdgrp lng="zh">
    <trd>&#21916;&#39340;&#25289;&#38597; <pr>X&#464;m&#462;l&amacron;y&#462;</pr></trd>,
    <trd>&#21916;&#39340;&#25289;&#38597; <pr>x&#464;m&#462;l&amacron;y&#462;</pr></trd>,
    <trd>&#21916;&#39340;&#25289;&#38597;&#23665; <pr>x&#464;m&#462;l&amacron;y&#462;sh&amacron;n</pr></trd>,
    <trd>&#21916;&#39340;&#25289;&#38597;&#23665;&#33032; <pr>x&#464;m&#462;l&amacron;y&#462;sh&amacron;nm&agrave;i</pr></trd>,
    <trd>&#21916;&#39340;&#25289;&#38597;&#23665; <pr>X&#464;m&#462;l&amacron;y&#462;sh&amacron;n</pr></trd>,
    <trd>&#21916;&#39340;&#25289;&#38597;&#23665;&#33032; <pr>X&#464;m&#462;l&amacron;y&#462;sh&amacron;nm&agrave;i</pr></trd>
  </trdgrp>
</drv>

<drv mrk="himalaj.0a">
  <kap>
    <tld lit="h"/>a
  </kap>
  <snc>
    <dif>
      Rilata al <tld/>o:
      <ekz>
        <ind><tld lit="h"/>a cedro</ind>
        <fnt>
          <bib>IKr</bib>
          <lok>La Miraklo De Purun Bhagat</lok>
        </fnt>;
        <trd lng="de">Himalaya-Zeder</trd>
        <trd lng="la">Cedrus deodara</trd>
      </ekz>
      <ekz>
        <tld lit="h"/>a urso
        <fnt>
          <bib>IKr</bib>
          <lok>La Miraklo De Purun Bhagat</lok>
        </fnt>;
      </ekz>
      <ekz>
        ni kune veturos la&ubreve; la serpentaj fervojoj per historia <tld lit="h"/>a
        lokomotivo &gcirc;is la urbeto Dar&gcirc;ilingo
        <fnt>
          <bib>Kon11</bib>
          <lok>Internacia Ekskurso &ccirc;e Katmando</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="ca">
    <trd>himalai&agrave;</trd>,
    <trd>de l&#8217;<ind>Him&agrave;laia</ind></trd>
  </trdgrp>
  <trd lng="de">Himalaya-</trd>
  <trd lng="nl">Himalayaans</trd>
</drv>

</art>
