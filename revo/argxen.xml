<drv mrk="argxen.0a">
  <kap><ofc>*</ofc><tld/>a</kap>
  <snc mrk="argxen.0a.KEM">
    <dif>
      El <tld/>o:
      <ekz>
        mi alportis <tld/>an vazon
        <fnt><bib>F</bib>, <lok>&FE; 19, la feino</lok></fnt>;
      </ekz>
      <ekz>
        mi donis mil <tld/>ajn monerojn al via frato
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 20:16</lok>
        </fnt>;
      </ekz>
      <ekz>
        lia surtuto estas ornamita per <tld/>a broda&jcirc;o
        <fnt>
          <bib>Fab2</bib>
          <lok>Dio de dormo</lok>
        </fnt>;
      </ekz>
      <ekz>
        dekduo da <tld/>aj kuleroj
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        <klr>[li]</klr> elprenis <tld/>a&jcirc;ojn kaj ora&jcirc;ojn
        kaj vestojn kaj donis al <nom>Rebeka</nom>
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 24:53</lok>
        </fnt>;
      </ekz>
      <ekz>
        por la kuracado de la konjunktivo mem ni <klr>[&#8230;]</klr> havas por nia dispono la
        nitran <tld/>on, kiun oni uzas por &scirc;mirado per peniko
        <fnt>
          <bib>FK</bib>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>d'<ind>argent</ind></trd>,
      <trd>de <ind>plata</ind></trd>
    </trdgrp>
    <trd lng="de">silbern</trd>
    <trd lng="en">silver</trd>
    <trd lng="es">de plata</trd>
    <trd lng="hu">ez&uuml;st</trd>
    <trd lng="id">... <ind>perak</ind></trd>
    <trd lng="sv">av <ind>silver</ind></trd>
    <trdgrp lng="zh">
    <trd>&#21547;&#37504; <pr>h&aacute;ny&iacute;n</pr></trd>,
    <trd>&#21547;&#38134; <pr>h&aacute;ny&iacute;n</pr></trd>
  </trdgrp>
</snc>
  <snc mrk="argxen.0a.FIG">
    <dif>
      Havanta econ, aspekton de <tld/>o:
      <ekz>
        belaj fi&scirc;oj kun <tld/>aj kaj oraj skvamoj
        <fnt><bib>Fab2</bib>, <lok>dio de dormo, Mardo</lok></fnt>;
      </ekz>
      <ekz>
        &scirc;iaj haroj estis <tld/>e blankaj kaj respektindaj
        <fnt>
          <bib>Fab2</bib>
          <lok>Avineto</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>a <ref tip="lst" cel="kolor.0o.propre" lst="voko:koloroj">koloro</ref>;
      </ekz>
      <ekz>
        <tld/>a sonoro, sono, brilo, rido.
      </ekz>
    </dif>
    <ref tip="super" cel="griz.0a">griza</ref>
    <ref tip="vid" cel="har.0aro">hararo</ref>
    <trdgrp lng="ca">
      <trd>argentat</trd>,
      <trd>platejat</trd>,
      <trd>argent&iacute;</trd>
    </trdgrp>
    <trd lng="de">silbrig</trd>
    <trd lng="en">silvery</trd>
    <trd lng="es">plateado</trd>
    <trd lng="hu">ez&uuml;st&ouml;s</trd>
    <trdgrp lng="id">
      <trd><baz>perak</baz>keperakan</trd>,
      <trd><baz>perak</baz>keperak-perakan</trd>
    </trdgrp>
    <trd lng="sv">silvrig</trd>
    <trdgrp lng="zh">
    <trd>&#20687;&#37504; <pr>xi&agrave;ngy&iacute;n</pr></trd>,
    <trd>&#20687;&#38134; <pr>xi&agrave;ngy&iacute;n</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="be">
    <trd>&c_s;&c_ja;&c_r;&c_e;&c_b;&c_r;&c_a;&c_n;&c_y;</trd>,
    <trd>&c_s;&c_r;&c_e;&c_b;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="bg">&c_s;&c_r;&c_je;&c_b;&c_malmol;&c_r;&c_je;&c_n;</trd>
  <trd lng="br">arc'hantel</trd>
  <trd lng="cs">st&rcaron;&iacute;brn&yacute;</trd>
  <trd lng="de">silbern</trd>
  <trd lng="fr">argent&eacute;</trd>
  <trd lng="he">&kaf;&samekh;&vav;&fpe;</trd>
  <trdgrp lng="ja">
    <trd>&#37504;&#12398;  <pr>&#12366;&#12435;&#12398;</pr></trd>,
    <trd>&#37504;&#33394;&#12398;  <pr>&#12366;&#12435;&#12356;&#12429;&#12398;</pr></trd>
  </trdgrp>
  <trd lng="nl">zilveren</trd>
  <trd lng="pl">srebrny</trd>
  <trd lng="ru">&c_s;&c_je;&c_r;&c_je;&c_b;&c_r;&c_ja;&c_n;&c_y;&c_j;</trd>
  <trd lng="sk">strieborn&yacute;</trd>
</drv>

<drv mrk="argxen.0i">
  <kap><tld/>i</kap>
  <snc mrk="argxen.0i.KEM">
    <gra><vspec>tr</vspec></gra>
    <dif>
      Tegi per maldika tavolo el <tld/>o:
      <ekz>
        granda <tld/>ita bastono
        <fnt><bib>Fab3</bib>, <lok>historio</lok></fnt>;
      </ekz>
      <ekz>
        <tld/>ita kulero.
      </ekz>
    </dif>
    <trd lng="br">arc'hanta&ntilde;<klr tip="ind"> (golei&ntilde; gant
    arc'hant)</klr></trd>
    <trdgrp lng="ca">
      <trd>argentar</trd>,
      <trd>platejar</trd>
    </trdgrp>
    <trd lng="de">versilbern</trd>
    <trdgrp lng="id">
      <trd><baz>lapis</baz>melapisi dgn perak</trd>,
      <trd><baz>perak</baz>memeraki</trd>
    </trdgrp>
  </snc>
  <snc mrk="argxen.0i.briligi">
    <gra><vspec>tr</vspec></gra>
    <dif>
      Briligi kiel <tld/>o:
      <ekz>
        <klr>[ili]</klr> evitis la lunan lumon, kiu <tld/>is la mezon de la lago
        <fnt>
          <bib>Mizero</bib>
          <lok>IX</lok>
        </fnt>;
      </ekz>
      <ekz>
        safirbluaj iridoj, kies delikataj petaloj estis kvaza&ubreve; <tld/>itaj de akva polvo
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        feli&ccirc;ulo, pro kiu la okulo de an&gcirc;elo <tld/>i&gcirc;as
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Kvara</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>argentar</trd>,
      <trd>platejar</trd>
    </trdgrp>
    <trd lng="de">versilbern</trd>
    <trd lng="id"><baz>perak</baz>memerakkan</trd>
  </snc>
  <snc mrk="argxen.0i.brili">
    <gra><vspec>ntr</vspec></gra>
    <dif>
      Brili kiel <tld/>o:
      <ekz>
        la &gcirc;ardeno komencis <tld/>i de la kvaronluma klingo
        <fnt>
          <bib>QuV</bib>
          <lok>&Ccirc;apitro XXXIX</lok>
        </fnt>;
      </ekz>
      <ekz>
        rivero Iskar <klr>[&#8230;]</klr> tie malsupre <tld/>is
        <fnt>
          <bib>Monato</bib>
          <aut>Julian Modest</aut>
          <vrk><url ref="&Monato;/2013/010962.php"
              >La iluziisto</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>brillar com l'argent</trd>,
      <trd>brillar com la plata</trd>
    </trdgrp>
    <trd lng="de">silbern <ind>gl&auml;nzen</ind></trd>
  </snc>
  <trd lng="be">&c_p;&c_a;&c_s;&c_je;&c_r;&c_a;&c_b;&c_r;&c_y;&c_c;&c_mol;</trd>
  <trd lng="bg">&c_p;&c_o;&c_s;&c_r;&c_je;&c_b;&c_r;&c_ja;&c_v;&c_a;&c_m;</trd>
  <trd lng="cs">post&rcaron;&iacute;b&rcaron;it</trd>
  <trd lng="en">silver-plate</trd>
  <trd lng="fr">argenter</trd>
  <trd lng="he">&lamed;&he;&kaf;&samekh;&yod;&fpe;</trd>
  <trdgrp lng="hu">
    <trd>ez&uuml;st&ouml;z</trd>,
    <trd>beez&uuml;st&ouml;z</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#37504;&#12513;&#12483;&#12461;&#12377;&#12427;  <pr>&#12366;&#12435;&#12417;&#12387;&#12365;&#12377;&#12427;</pr></trd>,
    <trd>&#37504;&#24373;&#12426;&#12395;&#12377;&#12427;
    <pr>&#12366;&#12435;&#12399;&#12426;&#12395;&#12377;&#12427;</pr></trd>
  </trdgrp>
  <trd lng="nl">verzilveren<klr tip="ind"> (zilver maken)</klr></trd>
  <trdgrp lng="pl">
    <trd>srebrzy&cacute;</trd>,
    <trd>posrebrza&cacute;</trd>
  </trdgrp>
  <trd lng="ru">&c_s;&c_je;&c_r;&c_je;&c_b;&c_r;&c_i;&c_t;&c_mol;</trd>
  <trd lng="sk">postriebri&tcaron;</trd>
  <trd lng="sv">f&ouml;rsilvra</trd>
</drv>

<drv mrk="argxen.0isto">
<kap><tld/>isto, <var><kap><tld/>a&jcirc;isto</kap></var></kap>
  <snc mrk="argxen.0isto.metiisto">
    <dif>
      Metiisto kiu faras a&jcirc;ojn el <tld/>o:
      <ekz>
        Demetrio, <tld/>a&jcirc;isto, kiu faradis ar&gcirc;entajn templetojn de Artemis, liveris al
        la metiistoj multe da okupo
        <fnt>
          <bib>NT</bib>
          <lok>La agoj 19:24</lok>
        </fnt>;
      </ekz>
      <ekz>
        la kesto devenas de la 17a jarcento kaj estas ellaborita de lokaj <tld/>istoj
        <fnt>
          <bib>Monato</bib>
          <aut>Bardhyl Selimi</aut>
          <vrk><url ref="&Monato;/2008/009424.php">Kesto-sugesto</url></vrk>
          <lok>2008</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_ju;&c_v;&c_e;&c_l;&c_ib;&c_r; <klr>(&c_ja;&c_k;&c_ib;
  &c_v;&c_y;&c_r;&c_a;&c_b;&c_l;&c_ja;&c_je; &c_s;&c_r;&c_e;&c_b;&c_n;&c_y;&c_ja;
  &c_r;&c_e;&c_ch;&c_y;)</klr></trd>
  <trd lng="ca">argenter</trd>
<trd lng="cs">st&rcaron;&iacute;brn&iacute;k</trd>
  <trd lng="de">Silberschmied</trd>
  <trd lng="en">silversmith</trd>
  <trd lng="es">platero</trd>
  <trd lng="he">&tsadi;&vav;&resh;&fpe;</trd>
  <trdgrp lng="id">
    <trd>pandai perak</trd>,
    <trd>tukang perak</trd>
  </trdgrp>
  <trd lng="nl">zilversmid</trd>
  <trd lng="pl">srebrnik</trd>
  <trd lng="sv">silversmed</trd>
</drv>

<drv mrk="argxen.viva0o">
  <kap>viva <tld/>o</kap>
  <snc mrk="argxen.viva0o.hidrargo">
    <uzo tip="stl">ARK</uzo>
    <dif>
      <ref tip="dif" cel="hidrar.0o.KEM">Hidrargo</ref>:
      <ekz>
        la kuraciloj estas: la viva <tld/>o, smeraldo kaj agato, nuksoj
        <fnt><bib>Far2</bib>, <lok>&ccirc;apitro 1a</lok></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="zh">
    <trd>&#27700;&#37504; <pr>shu&#464;y&iacute;n</pr></trd>,
    <trd>&#27700;&#38134; <pr>shu&#464;y&iacute;n</pr></trd>,
    <trd>&#27742; <pr>g&#466;ng</pr></trd>
  </trdgrp>
</snc>
  <trdgrp lng="ca">
    <trd>argent viu</trd>,
    <trd>mercuri</trd>
  </trdgrp>
