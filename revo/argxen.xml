    <uzo tip="fak">KEM</uzo>
    <dif>
      &Hcirc;emia <ref tip="lst" cel="elemen.0o.KEM" lst="voko:&hcirc;emiaj_elementoj" val="47">elemento</ref>
      kun atomnumero 47, atompezo 107,868; brila blanka valora
      metalo:
      <ekz>
        homa okulo <klr>[&#8230;]</klr> neniam sati&gcirc;as je <tld/>o kaj oro
        <fnt><bib>FK</bib>, <lok>2, fabeloj kaj legendoj, Aleksandro
        macedona, orienta historia legendo el V. Jabec</lok></fnt>.
      </ekz>
      <ekz>
        vort' en &gcirc;usta momento faras pli ol <tld/>o
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        kvarcent sikloj da <tld/>o, uzata en la komerco
        <fnt>
          <bib>MT</bib>
          <lok>Genezo 23:16</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FIG</uzo>
        parolo estas <tld/>o, oron similas silento
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        malgranda knabino per <tld/>osona vo&ccirc;o kantadis la plej &ccirc;armajn kantojn
