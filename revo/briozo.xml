<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: briozo.xml,v 1.2 2026/09/08 11:12:17 afido Exp $">
    <kap>
      <rad>briozo</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="briozo.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">ZOO</uzo>
  <snc>
    <dif>
      Plur&ccirc;ela tentaklohava besteto formanta en akvo koloniojn,
      iu el zoologia filumo <trd lng="la">Ectoprocta</trd>,
      sin. <trd lng="la">Bryozoa</trd> a&ubreve; <trd lng="la">Polyzoa</trd>:
      <ekz>
        surfunde vivantaj trilobitoj, bra&hcirc;iopodoj, e&hcirc;inodermoj, vermoj, gastropodoj,
        lamenbran&hcirc;uloj, hiolitoj, <tld/>oj
        <fnt>
          <aut>Josef Kavka</aut>
          <vrk><url ref="https://www.eventoj.hu/steb/miksitaj/sovagxsar/sovagxsar.htm"
              >La protektata naturparko Divok&aacute; &Scaron;&aacute;rka</url></vrk>
          <lok>1. Geologio kaj geomorfologio</lok>
        </fnt>;
      </ekz>
      <ekz>
        briozoa&jcirc;o <klr>[estas]</klr> la komuna strukturo de la <tld lit="B"/>oj, kiel
        ekzemple la bone konataj <ind>flustroj</ind>
        <fnt>
          <aut>Charles Darwin</aut>
          <vrk><url ref="https://www.eventoj.hu/steb/biologio/darwin/glosaro.html"
              >La Origino de la Specioj</url></vrk>
          <lok>Glosaro</lok>
        </fnt>.
        <trd lng="de">Bl&auml;ttermoostierchen</trd>
        <trd lng="nl">breedbladig mosdiertje</trd>
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/f/fc/Moostierchen_auf_Wangerooge_(solit&auml;r).jpg/500px-Moostierchen_auf_Wangerooge_(solit&auml;r).jpg"
      prm="CC0"
      >kolonio de <tld/>oj &ccirc;e la bordo de Wangerooge (ver&scirc;ajne Electra pilosa)
        <fnt>
          <aut>Rhetos, propra verko</aut>
          <lok><url ref="&WCW;/File:Moostierchen_auf_Wangerooge_(solit%C3%A4r).jpg"
              >https://commons.wikimedia.org/wiki/File:Moostierchen_auf_Wangerooge_(solit&auml;r).jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="de">Moostierchen</trd>
    <trd lng="en">Bryozoon</trd>
    <trd lng="ru">&c_m;&c_sh;&c_a;&c_n;&c_k;&c_a;</trd>
  </snc>
</drv>

  </art>

