<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: arid.xml,v 1.12 2026/07/29 17:32:59 revo Exp $">
<kap>
  <rad>arid</rad>/a <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="arid.0a">
  <kap><tld/>a</kap>
  <uzo tip="fak">GEOG</uzo>
  <uzo tip="fak">MET</uzo>
  <snc mrk="arid.0a.GEOG">
    <dif>
      <klr>(<ref tip="super" cel="klimat.0o">klimato</ref>, regiono)</klr>
      Vetere konstante <ref tip="super" cel="sek.0a.senakva">seka</ref> kaj sekve ne fekunda:
      <ekz>
        la <tld/>a nord-oriento de Brazilo
        <fnt>
          <bib>Monato</bib>
          <aut>Jozefo Lej&ccirc;</aut>
          <vrk><url ref="&Monato;/2011/010219.php"
              >Lulita de la anta&ubreve;ulo</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz>
      <ekz>
	antikva civilizacio, kiu <klr>[&#x2026;]</klr> disvolvis sukcesan agrikulturon en
        tiu <tld/>a regiono
        <fnt>
          <aut>Garbhan MacAoidh</aut>:
          <vrk><url ref="&Monato;/2002/pdf/monato200202.pdf#page=26">La ajmara</url></vrk>,
          <bib>Monato</bib>
          <lok>2002/02, p. 26-28</lok>
        </fnt>;
      </ekz>
      <ekz>
        la ekstreme <tld/>a dezerto, komenci&gcirc;anta ekde la Nord-Orienta urba limo de
        Jerusalemo
        <fnt>
          <bib>LOdE</bib>
          <lok>1999, No 11 (61)</lok>
        </fnt>;
      </ekz>
      <ekz>
        &scirc;afisto, kiu tra sia tuta vivo plantis arbojn por verdigi sian <tld/>an
        hejmareon en la suda Francio
        <fnt>
          <bib>Kon11</bib>
          <lok>Lando de Espero</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_a;&c_s;&c_u;&c_sh;&c_l;&c_ib;&c_v;&c_y;</trd>,
    <trd>&c_a;&c_r;&c_y;&c_d;&c_n;&c_y;</trd>
  </trdgrp>
  <trd lng="ca">&agrave;rid</trd>
  <trdgrp lng="cs">
    <trd>aridn&iacute;</trd>,
    <trd>pou&scaron;tn&iacute;</trd>,
    <trd>pustinn&yacute;</trd>,
    <trd>vyprahl&yacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
    <trd>arid</trd>,
    <trd>trocken <klr>(Klima)</klr></trd>
  </trdgrp>
  <trd lng="en">arid</trd>
  <trd lng="es">&aacute;rido</trd>
  <trdgrp lng="fr">
    <trd>aride</trd>
  </trdgrp>
  <trd lng="he">&tsadi;&#x5B8;&het;&#x5B4;&yod;&het;&#x5B7;</trd>
  <trdgrp lng="hu">
    <trd>kop&aacute;r</trd>,
    <trd>szikkadt</trd>
  </trdgrp>
  <trd lng="nl">droog</trd>
  <trdgrp lng="ru">
    <trd>&c_z;&c_a;&c_s;&c_u;&c_sh;&c_l;&c_i;&c_v;&c_y;&c_j;</trd>,
    <trd>&c_a;&c_r;&c_i;&c_d;&c_n;&c_y;&c_j;</trd>
  </trdgrp>
  <trd lng="sk">vyprahnut&yacute;</trd>
  <trdgrp lng="uk">
    <trd>&c_s;&c_u;&c_h;&c_i;&c_j;</trd>,
    <trd>&c_z;&c_a;&c_s;&c_u;&c_sh;&c_l;&c_i;&c_v;&c_i;&c_j;</trd>,
    <trd>&c_b;&c_je;&c_z;&c_v;&c_o;&c_d;&c_n;&c_i;&c_j;</trd>
  </trdgrp>
</drv>
</art>

