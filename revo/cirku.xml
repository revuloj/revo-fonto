<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: cirku.xml,v 1.8 2026/10/16 18:00:10 revo Exp $">
<kap>
  <rad>cirku</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="cirku.0o">
  <kap><tld/>o</kap>
  <snc mrk="cirku.0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <dif>
      <ref tip="lst" lst="voko:zoologiaj_genroj" cel="genr.0o.BIO">Genro</ref>
      el familio <ref tip="malprt" cel="akcipi1.0oj.ZOO">akcipitredoj</ref>
      (<trd lng="la">Circus</trd>) de rabobirdoj mezgrandaj, sveltaj kun longaj lar&gcirc;aj flugiloj:
      <ekz>
        li <klr>[&#x2026;]</klr> trinkis teon kaj rigardis al ili per malicaj,
        kiel de <tld/>o, okuloj
        <fnt>
          <aut>U. Karatkevi&ccirc;, trad. Z. Lapcionak</aut>,
          <vrk><url ref="http://zmila.at.tut.by/Libroportistoj.html">
          Libroportistoj</url></vrk>,
          <lok>2003</lok>
        </fnt>;
      </ekz>
      <ekz>
        sur Dnestro ni indikis nur 1 <tld/>on kaj 1 paron de fazanoj, krom kutimaj
        frugilegoj kaj kornikoj
        <fnt>
          <bib>LOdE</bib>
          <lok>2003, &#x2116; 3 (101)</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_m;&c_y;&c_sh;&c_a;&c_l;&c_o;&c_w;</trd>
    <trd lng="de">Weihe (Greifvogel)</trd>
    <trd lng="en">harrier</trd>
    <trd lng="fr">busard</trd>
    <trd lng="hu">r&eacute;tih&eacute;ja</trd>
    <trd lng="it">albanella</trd>
    <trd lng="nl">kiekendief</trd>
    <trd lng="pl">b&lstroke;otniak</trd>
    <trd lng="pt">tartaranh&atilde;o</trd>
    <trd lng="sv">(k&auml;rr)h&ouml;k</trd>
  </snc>
  <trd lng="uk">&c_l;&c_u;&c_n;&c_mol;</trd>
</drv>

<drv mrk="cirku.marcxa0o">
  <kap>mar&ccirc;a <tld/>o</kap>
  <snc mrk="cirku.marcxa0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <fnt>
       <aut>Wouter F. Pilger</aut>,
       <vrk>
         <url ref="http://www.xs4all.nl/~pilger/wfp/birdeou8.htm">
           Komunlingvaj nomoj de E&ubreve;ropaj birdoj</url>
       </vrk>
    </fnt>
    <dif>
      Specio de <ref tip="super" cel="cirku.0o.ZOO">cirkuo</ref>
      (<trd lng="la">Circus aeruginosus</trd>).
    </dif>
    <bld
      lok="&WCU;/thumb/6/69/2017.07.10.-12-Reichenwalde--Rohrweihe-Maennchen_im_Flug.jpg/500px-2017.07.10.-12-Reichenwalde--Rohrweihe-Maennchen_im_Flug.jpg"
      prm="CC BY-SA 4.0"
      >Mar&ccirc;a <tld/>a, Brandenburgo, Germanujo
        <fnt>
          <aut>Andreas Eichler, propra verko</aut>
          <lok><url ref="&WCW;/File:2017.07.10.-12-Reichenwalde--Rohrweihe-Maennchen_im_Flug.jpg"
              >https://commons.wikimedia.org/wiki/File:2017.07.10.-12-Reichenwalde--Rohrweihe-Maennchen_im_Flug.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_m;&c_y;&c_sh;&c_a;&c_l;&c_o;&c_w; &c_b;&c_a;&c_l;&c_o;&c_t;&c_n;&c_y;</trd>
    <trdgrp lng="ca">
      <trd>arpella<klr tip="amb"> (comuna)</klr></trd>,
      <trd>arpellot</trd>,
      <trd>capadella</trd>
    </trdgrp>
    <trd lng="de">Rohrweihe</trd>
    <trd lng="en"><klr>western </klr>marsh-<ind>harrier</ind></trd>
    <trd lng="pl">b&lstroke;otniak stawowy</trd>
    <trd lng="sv">brun <ind>k&auml;rrh&ouml;k</ind></trd>
  </snc>
</drv>

<drv mrk="cirku.blua0o">
  <kap>blua <tld/>o</kap>
  <snc mrk="cirku.blua0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <fnt>
       <aut>Wouter F. Pilger</aut>,
       <vrk>
         <url ref="http://www.xs4all.nl/~pilger/wfp/birdeou8.htm">
           Komunlingvaj nomoj de E&ubreve;ropaj birdoj</url>
       </vrk>
    </fnt>
    <dif>
      Specio de <ref tip="super" cel="cirku.0o.ZOO">cirkuo</ref>
      (<trd lng="la">Circus cyaneus</trd>):
      <ekz>
        bluaj <tld/>oj &ccirc;asas etajn mamulojn
        <fnt><bib>Viki</bib>, <lok>artikolo &leftquot;blua
        cirkuo&rightquot;,
        2009-06-14</lok></fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/b/bf/Circus_cyaneus%2C_Ballaugh_Curragh%2C_Isle_of_Man_1.jpg/500px-Circus_cyaneus%2C_Ballaugh_Curragh%2C_Isle_of_Man_1.jpg"
      prm="CC BY 2.0"
      >Blua <tld/>o, Mankinsulo
        <fnt>
          <aut>Isle of Man Government, Hen Harrier</aut>
          <lok><url ref="&WCW;/File:Circus_cyaneus,_Ballaugh_Curragh,_Isle_of_Man_1.jpg"
              >https://commons.wikimedia.org/wiki/File:Circus_cyaneus,_Ballaugh_Curragh,_Isle_of_Man_1.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_m;&c_y;&c_sh;&c_a;&c_l;&c_o;&c_w; &c_p;&c_a;&c_l;&c_ja;&c_v;&c_y;</trd>
    <trdgrp lng="ca">
      <trd>arpella p&agrave;l&middot;lida<klr tip="amb"> (comuna)</klr></trd>,
      <trd>esparver d'estany</trd>
    </trdgrp>
    <trd lng="de">Kornweihe</trd>
    <trd lng="en">hen <ind>harrier</ind></trd>
    <trd lng="la">Circus cyaneus</trd>
    <trd lng="pl">b&lstroke;otniak zbo&zdot;owy</trd>
    <trd lng="sv">bl&aring; <ind>k&auml;rrh&ouml;k</ind></trd>
  </snc>
</drv>

<drv mrk="cirku.griza0o">
  <kap>griza <tld/>o</kap>
  <snc mrk="cirku.griza0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <fnt>
       <aut>Wouter F. Pilger</aut>,
       <vrk>
         <url ref="http://www.xs4all.nl/~pilger/wfp/birdeou8.htm">
           Komunlingvaj nomoj de E&ubreve;ropaj birdoj</url>
       </vrk>
    </fnt>
    <dif>
      Specio de <ref tip="super" cel="cirku.0o.ZOO">cirkuo</ref>
      (<trd lng="la">Circus pygargus</trd>).
    </dif>
    <bld
      lok="&WCU;/thumb/c/c4/Flickr_-_don_macauley_-_Bird_015.jpg/500px-Flickr_-_don_macauley_-_Bird_015.jpg"
      prm="CC BY-SA 2.0"
      >Griza <tld/>o, Kenjo
        <fnt>
          <aut>Donald Macauley, Flickr: IMG_9250</aut>
          <lok><url ref="&WCW;/File:Flickr_-_don_macauley_-_Bird_015.jpg"
              >https://commons.wikimedia.org/wiki/File:Flickr_-_don_macauley_-_Bird_015.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_m;&c_y;&c_sh;&c_a;&c_l;&c_o;&c_w;
    &c_p;&c_o;&c_p;&c_l;&c_a;&c_w;&c_n;&c_y;</trd>
    <trdgrp lng="ca">
      <trd>arpella cendrosa</trd>,
      <trd>esparver cendr&oacute;s</trd>
    </trdgrp>
    <trd lng="de">Wiesenweihe</trd>
    <trd lng="en">montagu's <ind>harrier</ind></trd>
    <trd lng="pl">b&lstroke;otniak &lstroke;&aogonek;kowy</trd>
    <trd lng="sv">&auml;ngsh&ouml;k</trd>
  </snc>
</drv>
</art>

