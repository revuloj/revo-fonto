<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: cxial.xml,v 1.21 2026/08/04 03:53:14 revo Exp $">
  <kap>
  <ofc>*</ofc> <ofc>7</ofc>
  <rad>&ccirc;ial</rad>
  <fnt> <bib>JED</bib></fnt>
</kap>
<drv mrk="cxial.0">
  <kap><ofc>*</ofc><tld/></kap>
  <gra><vspec>adv.</vspec></gra>
  <snc>
    <dif>
      Pro &ccirc;ia motivo, &ccirc;ia ka&ubreve;zo:
      <ekz>
        tio estas <tld/> konsilinda;
      </ekz>
      <ekz>
        oni <tld/> mal&scirc;topas vinbotelojn
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2013/010963.php"
              >Post tostado, korka recikligo</url></vrk>
          <lok>2013</lok>
        </fnt>;
      </ekz>
      <ekz>
        vi restu almena&ubreve; unu jaron &ndash; Kial do? &ndash; &Ccirc;ar vi povas tiel bele rakonti &ndash; Nur
        tial? &ndash; Ne, <tld/>! &ndash; mi diris &ndash; Mi estis &gcirc;is nun tiel sola
        <fnt>
          <bib>IdO</bib>
          <lok>Unua Parto</lok>
        </fnt>;
      </ekz>
      <ekz>
        la instancoj <tld/> sciigu al virinoj, ke ili povas akiri helpon, <klr>[&#x2026;]</klr>
        okaze de perforta mistrakto
        <fnt>
          <bib>Monato</bib>
          <aut>Ivo Durwael</aut>
          <vrk><url ref="&Monato;/2012/010808.php"
              >Rajtoj pri ritoj</url></vrk>
          <lok>2012</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_p;&c_a; &c_w;&c_s;&c_ja;&c_l;&c_ja;&c_k;&c_a;&c_j;
  <ind>&c_p;&c_r;&c_y;&c_ch;&c_y;&c_n;&c_je;</ind></trd>
  <trdgrp lng="de">
     <trd>aus jedem beliebigen Grund</trd>
  </trdgrp>
  <trd lng="fr">pour toute <ind>raison</ind></trd>
  <trd lng="he">&mem;&kaf;&lamed; &samekh;&yod;&bet;&he; &shin;&he;&yod;&alef;</trd>
  <trdgrp lng="hu">
     <trd>minden&eacute;rt <klr tip="ind"> (ok)</klr></trd>,
     <trd>minden <ind>okn&aacute;l</ind> fogva</trd>,
     <trd>minden <ind>miatt</ind></trd>
  </trdgrp>
  <trd lng="ja">&#x3042;&#x3089;&#x3086;&#x308B;&#x7406;&#x7531;&#x3067;  <pr>&#x3042;&#x3089;&#x3086;&#x308B;&#x308A;&#x3086;&#x3046;&#x3067;</pr></trd>
  <trdgrp lng="pl">
    <trd>z ka&zdot;dego <ind>powodu</ind></trd>,
    <trd>w ka&zdot;dym <ind>przypadku</ind></trd>,
    <trd>w ka&zdot;dym <ind>wypadku</ind></trd>,
    <trd>tak czy owak</trd>,
    <trd>tak czy siak</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>por qualquer motivo</trd>,
    <trd>por todos os motivos</trd>
  </trdgrp>
  <trd lng="ro">pentru tot felul de motive</trd>
  <trd lng="ru">&c_p;&c_o; &c_v;&c_s;&c_ja;&c_k;&c_o;&c_j;
  &c_p;&c_r;&c_i;&c_ch;&c_i;&c_n;&c_je;</trd>
  <trd lng="sv">av alla <ind>sk&auml;l</ind></trd>
  <trd lng="uk">&c_ib;&c_z; &c_u;&c_s;&c_ja;&c_k;&c_o;&c_ji; &c_p;&c_r;&c_i;&c_ch;&c_i;&c_n;&c_i;</trd>
</drv>
</art>
