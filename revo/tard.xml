<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: tard.xml,v 1.3 2026/11/06 06:32:44 afido Exp $">
<kap>
    <rad>tard</rad>/e <fnt><bib>PIV1</bib></fnt>
</kap>
<drv mrk="tard.0e0tempe">
  <kap><tld/>e</kap>
  <snc>
    <dif>
      <ref tip="dif" cel="fru.mal0e">Malfrue</ref>:
      <ekz>
        en la regno de Napolo, kie lastatempe trovi&gcirc;is la <tld lit="t"/>e pentanta amiko
        <fnt>
        <bib>DonKihxoto</bib>,
        <lok>La in&gcirc;enia hidalgo don Quijote de La Mancha</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;ar ne pla&ccirc;as al mi dependi de favoroj, tial, ke ili alvenas <tld lit="t"/>e, mise a&ubreve; neniam
        <fnt>
        <bib>DonKihxoto</bib>,
        <lok>La in&gcirc;enia hidalgo don Quijote de La Mancha</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">sp&auml;ter</trd>
  <trd lng="uk">&c_p;&c_ib;&c_z;&c_n;&c_o;</trd>
</drv>

<drv mrk="tard.0a">
  <kap><tld/>a</kap>
  <snc>
    <dif>
      <ref tip="dif" cel="fru.mal0a">Malfrua</ref>:
      <ekz>
        kiuj iras al siaj konkubinoj kaj arogas al si la rajton frapi la pordon kaj eniri en la
        domon en ajna horo, e&ccirc; en la plej <tld lit="t"/>a
        <fnt>
        <bib>DonKihxoto</bib>,
        <lok>La in&gcirc;enia hidalgo don Quijote de La Mancha</lok>
        </fnt>;
      </ekz>
      <ekz>
        iom da misfarto, eble ne pro la dibo&ccirc;ado dum la Esperantogrupa kunsido, sed pro <tld
        lit="t"/>a influo de la &ccirc;ernobila eksplodo
        <fnt>
        <bib>Monato</bib>,
        <lok>Artikoloj el Monato 2012-2018</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">sp&auml;ter</trd>
  <trdgrp lng="uk">
    <trd>&c_p;&c_ib;&c_z;&c_n;&c_ib;&c_j; <klr>(m.)</klr></trd>,
    <trd>&c_p;&c_ib;&c_z;&c_n;&c_ja; <klr>(f.)</klr></trd>,
    <trd>&c_p;&c_ib;&c_z;&c_n;&c_jeu; <klr>(n.)</klr></trd>
  </trdgrp>
</drv>
</art>

