<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: maja.xml,v 1.14 2026/10/26 16:00:19 revo Exp $">
  <kap><ofc>10</ofc><rad>maja</rad>/o <fnt><bib>PIV2</bib></fnt></kap>

<drv mrk="maja.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">HIS</uzo>
  <snc mrk="maja.0o.ano">
    <dif>
      Ano de la <ref tip="malprt" cel="indian.0a">indiana</ref>
      etno, kiu havis de la 3a &gcirc;is la 10a jc potencan regnon en
      Mezameriko:
      <ekz>
        &scirc;i estis virino <klr>[&#8230;]</klr> kun plena, vigla viza&gcirc;o
        kun profundaj brunaj okuloj, agleca nazo kiu konvenus por
        <tld/>o
        <fnt>
          <aut>Donald J. Harlow</aut>:
          <vrk><url
          ref="http://donh.best.vwh.net/Esperanto/Literaturo/Noveloj/Ne_ordinara_ter.html">Ne
          ordinara ter'</url></vrk>.
        </fnt>;
      </ekz>
    <ekz>
      konsideritaj estas anka&ubreve; kalendaroj <klr>[&#8230;]</klr> de <tld/>oj kaj <ref
      cel="aztek.0o">azteko</ref>j
      <fnt>
        <bib>Monato</bib>
        <aut>Anna kaj Mati Pentus</aut>
        <vrk><url ref="&Monato;/2003/008070.html">Franda&jcirc;o por scivolemuloj</url></vrk>
        <lok>2003</lok>
      </fnt>.
    </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_ja; <klr tip="amb">(&c_ib;&c_n;&c_d;&c_y;&c_ja;&c_n;)</klr></trd>
  <trd lng="ca">maia</trd>
  <trd lng="cs">Maya</trd>
  <trd lng="de">Maya</trd>
  <trd lng="en">Maya</trd>
  <trd lng="fr">Maya<klr> (subst.)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#12510;&#12516;&#20154;  <pr>&#12510;&#12516;&#12376;&#12435;</pr></trd>,
    <trd>&#12510;&#12516;&#26063;  <pr>&#12510;&#12516;&#12382;&#12367;</pr></trd>
  </trdgrp>
  <trd lng="oc">maia</trd>
  <trd lng="pl">Maj <klr>(indianin)</klr></trd>
  <trd lng="ro">Maya</trd>
  <trd lng="ru">&c_m;&c_a;&c_j;&c_ja;<klr> (&c_i;&c_n;&c_d;&c_je;&c_je;&c_c;)</klr></trd>
  <trd lng="sk">May</trd>
  <trd lng="uk">&c_m;&c_a;&c_j;&c_ja;</trd>
  <trdgrp lng="zh">
    <trd>&#29595;&#38597;&#25991;&#26126; <pr>m&#462;y&#462;w&eacute;nm&iacute;ng</pr></trd>,
    <trd>&#29802;&#38597;&#25991;&#26126; <pr>m&#462;y&#462;w&eacute;nm&iacute;ng</pr></trd>,
    <trd>&#29595;&#38597;&#20154; <pr>M&#462;y&#462;r&eacute;n</pr></trd>,
    <trd>&#29802;&#38597;&#20154; <pr>M&#462;y&#462;r&eacute;n</pr></trd>,
    <trd>&#39340;&#38597;&#25991;&#26126; <pr>m&#462;y&#462;w&eacute;nm&iacute;ng</pr></trd>,
    <trd>&#39532;&#38597;&#25991;&#26126; <pr>m&#462;y&#462;w&eacute;nm&iacute;ng</pr></trd>
  </trdgrp>
</drv>

<drv mrk="maja.0a">
  <kap><ofc>10</ofc><tld/>a</kap>
  <uzo tip="fak">HIS</uzo>
  <snc mrk="maja.0a.rilata">
    <dif>
      Rilata al la <tld/>oj:
      <ekz>
        la <tld/>a lingvo, kalendaro;
      </ekz>
      <ekz>
        ekzistas anka&ubreve; lingvoj kiel la celtala (<tld/>a lingvo el centra Ameriko), kiu
        havas pli ol 100 poziciajn verbojn
        <fnt>
          <bib>Monato</bib>
          <aut>Kirilo Brosch</aut>
          <vrk><url ref="&Monato;/2011/010485.php">Spaco kaj lingvo &ccirc;u facila afero?</url></vrk>
          <lok>2011</lok>
        </fnt>;
      </ekz><ekz>
        oni fojfoje e&ccirc; a&ubreve;dis, ke la mondo alproksimi&gcirc;as al sia
        fino, la&ubreve; (miskomprenita) <tld/>a profeta&jcirc;o
        <fnt>
          <aut>Roberto Pigro</aut>:
          <vrk>&Gcirc;is la tero tremas</vrk>.
          <bib>Monato</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_a;&c_ja;&c_n;&c_s;&c_k;&c_ib;</trd>
  <trd lng="ca">maia</trd>
  <trdgrp lng="en">
    <trd>Maya</trd>, <trd>Mayan</trd>
  </trdgrp>
  <trd lng="fr">maya<klr> (adj.)</klr></trd>
  <trd lng="oc">maia</trd>
  <trd lng="pl">maj&oacute;w</trd>
  <trd lng="ru">&c_m;&c_a;&c_j;&c_ja;<klr> (&c_r;&c_o;&c_d;. &c_p;&c_a;&c_d;. &c_v;
  &c_z;&c_n;&c_a;&c_ch;.
  &c_p;&c_r;&c_i;&c_l;&c_a;&c_g;&c_a;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_o;&c_g;&c_o;)</klr></trd>
</drv>

</art>

