    <trd>&#26837;&#27354;&#27833; <pr>z&omacron;ngl&#472;y&oacute;u</pr></trd>
  </trdgrp>
</snc>
  <trd lng="ca">oli de palma</trd>
  <trd lng="cs">palmov&yacute; olej</trd>
  <trd lng="cv">&c_p;&c_a;&c_l;&c_mol;&c_m;&c_a; &#1195;&#1233;&c_v;&#1239;<baz>&#1195;&c_u;</baz></trd>
  <trd lng="ja">&#12516;&#12471;&#27833;  <pr>&#12516;&#12471;&#12422;</pr></trd>
