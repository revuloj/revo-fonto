<drv mrk="ole.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="ole.0o.KOMUNE">
    <dif>
      Grasa flua&jcirc;o el besta (baleno, foko), vegeta&jcirc;a (lino,
      nukso) a&ubreve;
      &scirc;tona (nafto, skisto) origino, uzata por nutrado, medicino,
      lumigado, arto, industrio...:
      <ekz>
        <tld/>o de olivoj, de nuksoj, de migdaloj
        <fnt>
          <bib>FK</bib>
          <lok>Fundamenta Krestomatio de la lingvo Esperanto</lok>
        </fnt>;
      </ekz>
      <ekz>
        fi&scirc;a <tld/>o
        <fnt>
          <bib>Mizero</bib>
          <lok>XI</lok>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o por lumigado
        <klr>(uzata por sakramentoj)</klr>
        <fnt>
          <bib>MT</bib>
          <lok>Eliro 25:6</lok>
        </fnt>;, butero de kokosoj
      </ekz>
      <ekz>
        sankta <tld/>o
        <fnt>
          <bib>MT</bib>
          <lok>Eliro 25:6</lok>
        </fnt>;
      </ekz>
      <ekz>
        elpistita <tld/>o
        <fnt>
          <bib>MT</bib>
          <lok>Eliro 29:40</lok>
        </fnt>;
      </ekz>
      <ekz>
        <uzo tip="stl">FRAZ</uzo>
        <ind>enver&scirc;i <tld/>on en la fajron</ind>
        <klr>(pliakrigi konflikton)</klr>
        <fnt>
          <bib>ElektFab</bib>
          <lok>Pa&scirc;tistino de anseroj apud puto</lok>
        </fnt>.
        <trdgrp lng="ca">
          <trd>afegir <ind>llenya</ind> al foc</trd>,
          <trd>tirar <ind>llenya</ind> al foc</trd>,
          <trd>posar <ind>llenya</ind> al foc</trd>,
          <trd>atiar el foc</trd>,
          <trd>donar <ind>peix</ind> al gat</trd>,
          <trd>enverinar el vesper</trd>
        </trdgrp>
        <trd lng="de"><ind>&Ouml;l</ind> ins Feuer gie&szlig;en</trd>
        <trd lng="fr">verser de l'huile sur le feu</trd>
      </ekz>
    </dif>
  </snc>
  <rim mrk="ole.0o.RIM_HOM">
    <ref tip="hom" cel="ole1.0o">Oleo</ref> anka&ubreve; estas
    nomo de arbo-genro.
  </rim>
