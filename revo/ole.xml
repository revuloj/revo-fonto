    <trd lng="id"><ind>minyak</ind> sawit</trd>
    <trd lng="pl">olej palmowy</trd>
    <trd lng="pt">azeite de dend&ecirc;</trd>    <trdgrp lng="zh">
    <trd>&#26837;&#27016;&#27833; <pr>z&omacron;ngl&uacute;:y&oacute;u</pr></trd>,
    <trd>&#26837;&#27354;&#27833; <pr>z&omacron;ngl&uacute;:y&oacute;u</pr></trd>,
