<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: vici.xml,v 1.25 2026/09/18 20:52:54 revo Exp $">
<kap>
  <rad>vici</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="vici.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">BOT</uzo>
  <snc mrk="vici.0o.genro">
    <dif>
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:botanikaj_genroj">Genro</ref> el familio <ref
      tip="malprt" cel="fabac.0oj">fabacoj</ref>
      (<trd lng="la">Vicia</trd>), de kiu kelkaj specioj estas kulturataj,
      ekzemple la <ref tip="sub" cel="fab.0o">fabo</ref>:
      <ekz>
        <ind>Birda vicio</ind>
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=21277">Birda vicio</url></lok>
        </fnt>;
        <trd lng="de">Vogelwicke</trd>
        <trd lng="la">Vicia cracca</trd>
      </ekz>
      <ekz>
        kiam la malsato vere postulas, kaj nenio alia trovi&gcirc;as por man&gcirc;i, anka&ubreve; la
        <tld/>oj <klr>(<nom>Vicia sativa</nom>, itale: <nac>veccia</nac>)</klr>
        fari&gcirc;as bongustegaj
        <fnt>
          <aut>Carlo Collodi, trad. Giuseppe Croatini</aut>
          <vrk><url ref="https://eduinf.waw.pl/esp/lern/librejo/0072/0023.php"
              >La Aventuroj De Pinokjo</url></vrk>
          <lok>&Ccirc;apitro 23</lok>
        </fnt>!
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_v;&c_ib;&c_k;&c_a;</trd>
  <trd lng="ca">g&egrave;nere Vicia</trd>
  <trd lng="cs">vikev</trd>
  <trd lng="de">Wicke</trd>
  <trd lng="en">vetch</trd>
  <trd lng="fr">vesce</trd>
  <trd lng="hu">b&uuml;kk&ouml;ny</trd>
  <trd lng="ja">&#x30BD;&#x30E9;&#x30DE;&#x30E1;</trd>
  <trd lng="nl">wikke</trd>
  <trd lng="pl">wyka</trd>
  <trd lng="ru">&c_v;&c_i;&c_k;&c_a;</trd>
  <trdgrp lng="sk">
    <trd>vika</trd>,
    <trd>&lcaron;adn&iacute;k k&racute;mny</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_v;&c_i;&c_k;&c_a;</trd>,
    <trd>&c_g;&c_o;&c_r;&c_o;&c_sh;&c_o;&c_k;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x8587; <pr>w&eacute;i</pr></trd>,
    <trd>&#x91CE;&#x8C4C;&#x8C46; <pr>y&ecaron;w&amacron;nd&ograve;u</pr></trd>
  </trdgrp>
</drv>
</art>
