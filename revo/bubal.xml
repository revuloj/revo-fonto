<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: bubal.xml,v 1.31 2026/09/16 07:39:44 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>bubal</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="bubal.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="bubal.0o.ZOO">
    <uzo tip="fak">ZOO</uzo>
    <dif>
      Peza kvarpiedulo, simila al bovo, kun grandaj kornoj,
      &scirc;atanta akvejojn, hejma en Azio kaj en Afriko,
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:zoologiaj_genroj">genro</ref> el familio
      <ref tip="malprt" cel="boved.0oj">bovedoj</ref>
      (<trd lng="la">Bubalus</trd>):
      <ekz>
        estis preska&ubreve; nokto-mezo kiam li sukcesis kapti la
        <tld/>inon, kun helpo de kvar a&ubreve; kvin vila&gcirc;anoj
        <fnt>
          <aut>Guru Prasad Mainali, trad. R. Manandhar</aut>,
          <vrk><url
          ref="http://razeno.blogspot.com/2008/03/pajlo-fajro.html">Pajlo-fajro</url></vrk>,
          <lok>Razeno blogas Esperante..., 2008-03-04</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Amerika <ref cel="bizon.0o">bizono</ref> ofte estas misnomita &#x201A;<tld/>o&#x2018;.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/2/26/Asian_water_buffalo_(Bubalus_bubalis)_with_cattle_egret.jpg/500px-Asian_water_buffalo_(Bubalus_bubalis)_with_cattle_egret.jpg"
      prm="CC BY-SA 4.0"
      >Azia <tld/>o (Bubalus bubalis) kun egreto, Srilanko
        <fnt>
          <aut>Charles J. Sharp, propra verko</aut>
          <lok><url ref="&WCW;/File:Asian_water_buffalo_(Bubalus_bubalis)_with_cattle_egret.jpg"
              >https://commons.wikimedia.org/wiki/File:Asian_water_buffalo_(Bubalus_bubalis)_with_cattle_egret.jpg</url></lok>
        </fnt>
    </bld>
    <trd lng="be">&c_b;&c_u;&c_j;&c_v;&c_a;&c_l;</trd>
    <trd lng="bg">&c_b;&c_i;&c_v;&c_o;&c_l;</trd>
    <trd lng="br">bual</trd>
    <trd lng="ca">b&uacute;fal</trd>
    <trd lng="de">B&uuml;ffel</trd>
    <trd lng="en">buffalo</trd>
    <trd lng="es">b&uacute;falo</trd>
    <trd lng="fr">buffle</trd>
    <trd lng="hu">bivaly</trd>
    <trd lng="nl">buffel</trd>
    <trd lng="pl">baw&oacute;&lstroke;</trd>
    <trd lng="pt">b&uacute;falo</trd>
    <trd lng="ru">&c_b;&c_u;&c_j;&c_v;&c_o;&c_l;</trd>
    <trd lng="zh">&#x6C34;&#x725B; <pr>shu&#x1D0;ni&uacute;</pr></trd>
  </snc>
  <trd lng="cs">buvol</trd>
  <trdgrp lng="he">
    <trd>&tav;&#x5B0;&alef;&vav;&#x5B9;</trd>,
    <trd>&bet;&vav;&pe;&alef;&lamed;&vav;</trd>
  </trdgrp>
  <trd lng="ja">&#x30B9;&#x30A4;&#x30AE;&#x30E5;&#x30A6;</trd>
  <trd lng="sk">byvol</trd>
  <trd lng="uk">&c_b;&c_u;&c_j;&c_v;&c_ib;&c_l;</trd>
</drv>
</art>
