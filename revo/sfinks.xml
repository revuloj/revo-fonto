<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: sfinks.xml,v 1.27 2026/11/06 18:00:21 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>sfinks</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="sfinks.0o">
  <kap><tld/>o</kap>
  <snc mrk="sfinks.0o.MIT">
    <dif>
      Mita <ref tip="super" cel="monstr.0o.BIO">monstro</ref> kun leona
      korpo kaj homa kapo:
    </dif>
    <subsnc mrk="sfinks.0o.MIT_egipta">
      <uzo tip="fak">MIT</uzo>
      <dif>
        &Ccirc;e la antikvaj egiptanoj, figurata en ku&scirc;a sinteno,
        simbolanta la sunon:
        <ekz>
          sur blanka kalka monteto estis klare videbla silueto de
          <tld/>o
          <fnt><bib>Far2</bib>, <lok>&ccirc;apitro 19a</lok></fnt>.
        </ekz>
      </dif>
      <trd lng="hu">szfinx</trd>
    </subsnc>
    <subsnc mrk="sfinks.0o.MIT_greka">
      <uzo tip="fak">MIT</uzo>
      <dif>
        &Ccirc;e la antikvaj grekoj kun virina brusto kaj kapo,
        forglutanta tiujn, kiuj ne kapablis diveni la enigmojn
        proponitajn de &gcirc;i.
      </dif>
      <trd lng="hu">Szphinx</trd>
    </subsnc>
    <trd lng="pl">Sfinks</trd>
  </snc>
  <snc mrk="sfinks.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <uzo tip="stl">RAR</uzo>
    <dif>
      Homo, kies pensojn kaj sentojn oni ne povas diveni:
      <ekz>
        miaj kolegoj similis al <tld/>o
        <fnt>
          <bib>VaK</bib>
          <lok>Sesa &Ccirc;apitro</lok>
        </fnt>;
      </ekz>
      <ekz>
        jes, &ndash; respondis li, &ndash; kaj la <tld/>o estas vi
        <fnt>
          <bib>PatrojFiloj</bib>
          <lok>VII</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iu kadavro estas la <tld/>o de la senmorteco
        <fnt>
          <bib>Fab1</bib>
          <lok>Galo&scirc;oj de feli&ccirc;o</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="hu">
      <trd>titokzatos alak</trd>,
      <trd>kif&uuml;rk&eacute;szhetetlen ember</trd>
    </trdgrp>
    <trd lng="pl">sfinks</trd>
  </snc>
  <trd lng="be">&c_s;&c_f;&c_ib;&c_n;&c_k;&c_s;</trd>
  <trd lng="ca">esfinx</trd>
  <trdgrp lng="cs">
    <trd>sfinga</trd>,
    <trd>sfinx</trd>
  </trdgrp>
  <trd lng="de">Sphinx</trd>
  <trd lng="en">sphinx</trd>
  <trd lng="es">esfinge</trd>
  <trd lng="fr">sphinx</trd>
  <trdgrp lng="ja">
    <trd>&#12473;&#12501;&#12451;&#12531;&#12463;&#12473;</trd>,
    <trd>&#35598;&#12417;&#12356;&#12383;&#20154;&#29289;  <pr>&#12394;&#12382;&#12417;&#12356;&#12383;&#12376;&#12435;&#12406;&#12388;</pr></trd>
  </trdgrp>
  <trd lng="nl">sfinx</trd>
  <trd lng="oc">esfinx</trd>
  <trd lng="ru">&c_s;&c_f;&c_i;&c_n;&c_k;&c_s;</trd>
  <trdgrp lng="sk">
    <trd>sfinga</trd>,
    <trd>sfinx</trd>
  </trdgrp>
  <trd lng="uk">&c_s;&c_f;&c_ib;&c_n;&c_k;&c_s;</trd>
  <trdgrp lng="zh">
    <trd>&#20154;&#22836;&#29422;&#36523; <pr>r&eacute;nt&oacute;ush&imacron;sh&emacron;n</pr></trd>,
    <trd>&#20154;&#38957;&#29509;&#36523; <pr>r&eacute;nt&oacute;ush&imacron;sh&emacron;n</pr></trd>,
    <trd>&#29422;&#36523;&#20154;&#38754;&#20687; <pr>sh&imacron;sh&emacron;nr&eacute;nmi&agrave;nxi&agrave;ng</pr></trd>,
    <trd>&#29509;&#36523;&#20154;&#38754;&#20687; <pr>sh&imacron;sh&emacron;nr&eacute;nmi&agrave;nxi&agrave;ng</pr></trd>,
    <trd>&#26031;&#33452;&#20811;&#26031; <pr>s&imacron;f&emacron;nk&egrave;s&imacron;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="sfinks.0a">
  <kap><tld/>a</kap>
  <snc mrk="sfinks.0a.FIG">
    <dif>
      (pri mieno) <ref cel="enigm.0a">Enigma</ref>,
      <ref cel="penetr.ne0ebla">nepenetrebla</ref>:
      <ekz>
        plu silenta, li prezentas al ili nur sian revkaptitan esprimon, kun <tld/>a
        rideto
        <fnt>
          <bib>ChM</bib>
          <lok>14</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="hermetik.0a.malklara">hermetika<sncref/></ref>,
      <ref cel="mister.0a">mistera</ref>
    </refgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_z;&c_a;&c_g;&c_a;&c_d;&c_k;&c_a;&c_v;&c_y;</trd>,
    <trd>&c_t;&c_a;&c_ja;&c_m;&c_n;&c_ib;&c_ch;&c_y;</trd>
  </trdgrp>
  <trdgrp lng="ca">
    <trd>d&#8217;<ind>esfinx</ind></trd>,
    <trd>enigm&agrave;tic</trd>,
    <trd>inescrutable</trd>
  </trdgrp>
  <trd lng="cs">z&aacute;hadn&yacute; <klr>(p&rcaron;enes.)</klr></trd>
  <trd lng="de">sphinxgleich</trd>
  <trd lng="en">sphinx-like</trd>
  <trdgrp lng="hu">
    <trd>titokzatos</trd>,
    <trd>kif&uuml;rk&eacute;szhetetlen</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#12473;&#12501;&#12451;&#12531;&#12463;&#12473;&#12398;</trd>,
    <trd>&#12394;&#12382;&#12398;</trd>
  </trdgrp>
  <trd lng="nl">raadselachtig</trd>
  <trdgrp lng="pl">
    <trd>tajemniczy</trd>,
    <trd>nieodgadniony</trd>
  </trdgrp>
  <trd lng="sk">z&aacute;hadn&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#24847;&#20041;&#28145;&#36828; <pr>y&igrave;y&igrave;sh&emacron;nyu&#462;n</pr></trd>,
    <trd>&#24847;&#32681;&#28145;&#36960; <pr>y&igrave;y&igrave;sh&emacron;nyu&#462;n</pr></trd>,
    <trd>&#33707;&#26126;&#20854;&#22937; <pr>m&ograve;m&iacute;ngq&iacute;mi&agrave;o</pr></trd>,
    <trd>&#33707;&#27979;&#39640;&#28145; <pr>m&ograve;c&egrave;g&amacron;osh&emacron;n</pr></trd>,
    <trd>&#33707;&#28204;&#39640;&#28145; <pr>m&ograve;c&egrave;g&amacron;osh&emacron;n</pr></trd>,
    <trd>&#22823;&#24785;&#19981;&#35299;&#30340; <pr>d&agrave;hu&ograve;b&ugrave;ji&ecaron;de</pr></trd>,
    <trd>&#26497;&#28145; <pr>j&iacute;sh&emacron;n</pr></trd>,
    <trd>&#26997;&#28145; <pr>j&iacute;sh&emacron;n</pr></trd>,
    <trd>&#31070;&#31192;&#33707;&#27979; <pr>sh&eacute;nm&igrave;m&ograve;c&egrave;</pr></trd>,
    <trd>&#31070;&#31192;&#33707;&#28204; <pr>sh&eacute;nm&igrave;m&ograve;c&egrave;</pr></trd>,
    <trd>&#33707;&#21517;&#20854;&#22937;&#30340; <pr>m&ograve;m&iacute;ngq&iacute;mi&agrave;ode</pr></trd>,
    <trd>&#33707;&#21517;&#20854;&#22937; <pr>m&ograve;m&iacute;ngq&iacute;mi&agrave;o</pr></trd>
  </trdgrp>
</drv>
</art>
