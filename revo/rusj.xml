<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: rusj.xml,v 1.11 2026/11/18 07:22:32 afido Exp $">
<kap>
    <rad>Rusj</rad>/o <fnt><bib>Viki</bib></fnt>
</kap>
<drv mrk="rusj.0o">
  <kap><tld/>o</kap>
  <snc mrk="rusj.0o.SNC">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      <ref tip="dif" cel="kiev.0aRegno">Kieva Regno</ref>:
      <ekz>
        en la epoko de Kieva <tld lit="R"/>o (t.e. 9a &ndash; 12a jarcentoj) ekzistis nek ukraina, nek
        belorusa, nek rusa popoloj, sed unusola <tld lit="r"/>a popolo
        <fnt>
          <aut>Libuk</aut>
          <vrk><url ref="&Monato;/1987/monato198706.pdf#page=10">Konflikta jubileo</url></vrk>
          <bib>Monato</bib>
          <lok>1987/06, p. 10</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>M. Hru&scirc;evskij</nom> estas a&ubreve;toro de 6-voluma &leftquot;Historio de ukraina literaturo&rightquot;,
        10-voluma &leftquot;Historio de Ukrainio-<tld lit="R"/>o&rightquot;, kiuj estis en Sovetio kritikataj pro la
        naciismo kaj
        malpermesitaj (forigitaj de &ccirc;iuj bibliotekoj)
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/wiki/Mi%C4%A5ajlo_Hru%C5%9Devskij">Mi&hcirc;ajlo
          Hru&scirc;evskij</url></lok>
        </fnt>;
      </ekz>
      <ekz>
        tute ne interesas moskvajn oficialulojn la konsideroj de honestaj rusaj historiistoj,
        parolantaj pri tio, ke la nordaj provincoj de Kieva <tld lit="R"/>o (t.e. la nuna teritorio
        de Rusio) estis kristanigitaj nur jarojn poste
        <fnt>
          <aut>Libuk</aut>
          <vrk><url ref="&Monato;/1987/monato198706.pdf#page=10">Konflikta jubileo</url></vrk>
          <bib>Monato</bib>
          <lok>1987/06, p. 10</lok>
        </fnt>;
      </ekz>
      <ekz>
        pri la orient-e&ubreve;ropa regiono kaj regno, kie mezepoke lo&gcirc;is la orientaj slavoj kaj kies unua
        centro estis Kijivo, estas uzata la nomo <tld lit="R"/>o, por ne konfuzi &gcirc;in kun la moderna
        Rusio
        <fnt>
          <aut>Jouko Lindstedt</aut>
          <vrk><url ref="https://www.liberafolio.org/2024/01/09/ukrainio-vekigis/">Ukrainio
          veki&gcirc;is</url></vrk>
          <bib>LibFol</bib>
        </fnt>;
      </ekz>
      <ekz>
        Rusio estas kiel ido de Kijiva <tld lit="R"/>o &ndash; sed nun granda fi&scirc;o volas man&gcirc;i malgrandan
        fi&scirc;on
        <fnt>
          <aut>Jukka Pietil&auml;inen</aut>
          <vrk><url
          ref="https://www.liberafolio.org/2022/08/13/kovtonjuk-rakontis-pri-la-situacio-en-ukrainio/">Kovtonjuk
          rakontis pri la milito en Ukrainio</url></vrk>
          <bib>LibFol</bib>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="ruten.0ujo">Rutenujo</ref>,
      <ref cel="ukrajn.U0ujo">Ukrainujo</ref>,
      <ref cel="belorus.B0ujo">Belorusujo</ref>,
      <ref cel="rus.R0ujo">Rusujo</ref>
    </refgrp>
  </snc>
  <trd lng="be">&c_R;&c_u;&c_s;&c_mol;</trd>
  <trd lng="de">Rus</trd>
  <trd lng="en">Rus'</trd>
  <trd lng="es">Rus</trd>
  <trdgrp lng="fr">
    <trd>Rus'</trd>,
    <trd>Rous</trd>
  </trdgrp>
  <trd lng="it">Rus'</trd>
  <trd lng="ja">&#12523;&#12540;&#12471;</trd>
  <trd lng="ko">&#47336;&#49828;</trd>
  <trd lng="nl">Roes'</trd>
  <trd lng="pl">Ru&sacute;</trd>
  <trd lng="uk">&c_R;&c_u;&c_s;&c_mol;</trd>
</drv>
</art>
