<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: rusj.xml,v 1.5 2026/10/30 23:44:11 afido Exp $">
<kap>
    <rad>Rusj</rad>/o <fnt><bib>Viki</bib></fnt>
</kap>
<drv mrk="rusj.0o">
  <kap><tld/>o</kap>
  <snc mrk="rusj.0o.SNC">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      <ref tip="dif" cel="kiev.0aRegno">Kieva Regno</ref>:
      <ekz>
        en la epoko de kieva <tld lit="R"/>o (t.e. 9a &ndash; 12a jarcentoj) ekzistis nek ukraina, nek
        belorusa, nek rusa popoloj, sed unusola <tld lit="r"/>a popolo
        <fnt>
          <bib>Monato</bib>
          <lok>1987/06, p. 10</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>M. Hru&scirc;evskij</nom> estas a&ubreve;toro de 6-voluma &leftquot;Historio de ukraina literaturo&rightquot;,
        10-voluma &leftquot;Historio de Ukrainio-<tld lit="R"/>o&rightquot;, kiuj estis en Sovetio kritikataj pro la
        naciismo kaj
        malpermesitaj (forigitaj de &ccirc;iuj bibliotekoj)
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/wiki/Mi%C4%A5ajlo_Hru%C5%9Devskij">Mi&hcirc;ajlo
          Hru&scirc;evskij</url></lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_R;&c_u;&c_s;&c_mol;</trd>
  <trd lng="de">Rus</trd>
  <trd lng="en">Rus'</trd>
  <trd lng="es">Rus</trd>
  <trdgrp lng="fr">
    <trd>Rus'</trd>,
    <trd>Rous</trd>
  </trdgrp>
  <trd lng="it">Rus'</trd>
  <trd lng="ja">&#12523;&#12540;&#12471;</trd>
  <trd lng="ko">&#47336;&#49828;</trd>
  <trd lng="pl">Ru&sacute;</trd>
  <trd lng="uk">&c_R;&c_u;&c_s;&c_mol;</trd>
</drv>
</art>

