<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: sxiruk.xml,v 1.7 2026/10/04 15:20:30 revo Exp $">
<kap>
  <rad>&scirc;iruk</rad>/o
</kap>
<drv mrk="sxiruk.0o">
  <kap><tld/>o</kap>
  <snc mrk="sxiruk.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      Dol&ccirc;a <ref tip="super" cel="sup.0o.KUI">supo</ref> el ru&gcirc;aj
      faboj kun mo&ccirc;ipecoj, en Japanujo &scirc;ate trinkata inter
      &ccirc;efman&gcirc;oj:
      <ekz>
        li haste englutis porcion da <tld/>o kaj mendis plu
        <fnt><aut>Ueyama M.</aut>, <vrk>Pardonon!</vrk>, <lok>l'
        omnibuso, 1970</lok></fnt>;
      </ekz>
      <ekz>
        o&scirc;iruko a&ubreve; <tld/>o <klr>[&#x2026;]</klr> estas
        japana dol&ccirc;a&jcirc;o
        <fnt><bib>Viki</bib>, <lok>artikolo &leftquot;Oshiruko&rightquot;,
        2007-08-24</lok></fnt>.
      </ekz>
    </dif>
    <bld
      lok="&WCU;/thumb/d/de/Shiruko(Zenzai)4.JPG/330px-Shiruko(Zenzai)4.JPG"
      prm="CC BY-SA 3.0"
      ><tld/>o kun mocioj
        <fnt>
          <aut>Tomomarusan, propra verko</aut>
          <lok><url ref="&WCW;/File:Shiruko(Zenzai)4.JPG"
              >https://commons.wikimedia.org/wiki/File:Shiruko(Zenzai)4.JPG</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_s;&c_ib;&c_r;&c_u;&c_k;&c_a; <klr>(&c_ja;&c_p;&c_o;&c_n;&c_s;&c_k;&c_ib; &c_s;&c_u;&c_p;)</klr></trd>
  <trd lng="de">Shiruko</trd>
  <trdgrp lng="en">
    <trd>shiruko</trd>,
    <trd> red bean soup</trd>, <trd>azuki bean soup</trd>
  </trdgrp>
  <trd lng="fr">shiruko</trd>
  <trdgrp lng="it">
    <trd>shiruko</trd>,
    <trd>oshiruko</trd>
  </trdgrp>
  <trd lng="ja">&#x6C41;&#x7C89; <pr>&#x3057;&#x308B;&#x3053;</pr></trd>
  <trd lng="pl">shiruko  <klr>(japo&nacute;ska zupa fasolowa)</klr></trd>
  <trd lng="pt">shiruko</trd>
</drv>
</art>

