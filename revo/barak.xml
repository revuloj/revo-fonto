<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: barak.xml,v 1.23 2026/08/05 17:52:59 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>barak</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="barak.0o">
  <kap><tld/>o</kap>
  <snc>
    <dif>
      Provizora konstruo, plej ofte el ligno, por lo&gcirc;igi
      soldatojn, laboristojn, malsanulojn, rifu&gcirc;intojn:
      <ekz>
        serio da longaj <tld/>oj starigitaj paralele
        <fnt>
          <bib>ChB</bib>
          <lok>17</lok>
        </fnt>;
      </ekz>
      <ekz>
        kiam mi preteriris anta&ubreve; unu el tiaj <tld/>oj,
        mi eka&ubreve;dis interne la&ubreve;tan kriadon
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        ni devis ur&gcirc;e <klr>[&#x2026;]</klr> konstrui &gcirc;is la komenco de la vintro sanitarejon,
        bakejon, banejon kaj <tld/>on por la divizio
        <fnt>
          <bib>Monato</bib>
          <aut>Lena Karpunina</aut>
          <vrk><url ref="&Monato;/2004/008350.html"
              >Tiu tago</url></vrk>
          <lok>2004</lok>
        </fnt>;
      </ekz>
      <ekz>
        ili lo&gcirc;is en <tld/>oj kune kun la dombestoj
        <fnt>
          <bib>Monato</bib>
          <aut>Bardhyl Selimi</aut>
          <vrk><url ref="&Monato;/2015/011511.php"
              >Batalo kontra&ubreve; la malri&ccirc;eco</url></vrk>
          <lok>2015</lok>
        </fnt>.
      </ekz>
    </dif>
    <refgrp tip="vid">
      <ref cel="bud.0o">budo</ref>,
      <ref cel="kaban.0o">kabano</ref>,
      <ref cel="kajut.0o">kajuto</ref>
    </refgrp>
    <trd lng="be">&c_b;&c_a;&c_r;&c_a;&c_k;</trd>
    <trd lng="de">Baracke</trd>
    <trd lng="en">barracks</trd>
    <trd lng="es">barraca</trd>
    <trd lng="fr">baraque <klr tip="ind">(construction
    provisoire)</klr></trd>
    <trd lng="hu">barakk</trd>
    <trd lng="nl">barak</trd>
    <trd lng="pl">barak</trd>
    <trd lng="ru">&c_b;&c_a;&c_r;&c_a;&c_k;</trd>
    <trd lng="sv">barack</trd>
  </snc>
  <trdgrp lng="cs">
    <trd>bar&aacute;k</trd>,
    <trd>provizorn&iacute; staven&iacute;</trd>,
    <trd>ubytovna</trd>
  </trdgrp>
  <trd lng="he">&tsadi;&resh;&yod;&fpe;</trd>
  <trdgrp lng="ja">
    <trd>&#x30D0;&#x30E9;&#x30C3;&#x30AF;</trd>,
    <trd>&#x4EEE;&#x5C0F;&#x5C4B;  <pr>&#x304B;&#x308A;&#x3054;&#x3084;</pr></trd>
  </trdgrp>
  <trd lng="sk">barak</trd>
    <trd lng="th">&#xE40;&#xE1E;&#xE34;&#xE07;&#xE2D;&#xE32;&#xE28;&#xE31;&#xE22;&#xE0A;&#xE31;&#xE48;&#xE27;&#xE04;&#xE23;&#xE32;&#xE27;</trd>
  <trdgrp lng="uk">
    <trd>&c_b;&c_a;&c_r;&c_a;&c_k;</trd>,
    <trd>&c_t;&c_a;&c_b;&c_ib;&c_r;&c_n;&c_a; &c_b;&c_u;&c_d;&c_ib;&c_v;&c_l;&c_ja;</trd>
  </trdgrp>
</drv>
</art>
