<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: sahar.xml,v 1.19 2026/11/04 12:03:58 revo Exp $">
<kap><ofc>10</ofc>
    <rad>Sahar</rad>/o <fnt><bib>Far1</bib></fnt>
</kap>
<drv mrk="sahar.0o">
  <kap><tld/>o</kap>
  <snc mrk="sahar.0o.GEOG">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      Granda, tre varma, sabla kaj &scirc;tona <ref tip="lst" lst="voko:regionoj"
      cel="dezert.0o">dezerto</ref>
      en norda <ref tip="malprt" cel="afrik.A0o">Afriko</ref>:
      <ekz>
        dezerta intermonto, kiaj ekzistas &ccirc;ie en <tld/>o
        <fnt>
          <bib>Far1</bib>
          <lok>Anta&ubreve;parolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        la&ubreve; la konstitucio de <ind>Okcidenta <tld/>o</ind>, la nunaj &scirc;tataj strukturoj kaj &ccirc;iuj
        institucioj estas provizoraj, kaj ili devos esti rekonstruataj tuj post la plena
        sendependi&gcirc;o de la lando
        <fnt>

          <aut>Maksat Kudajbergen</aut>
          <vrk><url ref="&Monato;/2024/013471.php">Evitenda
          evoluo</url></vrk>
          <bib>Monato</bib>
          <lok>2024/04, p. 6</lok>
        </fnt>;
        <trd lng="de">Westsahara</trd>
        <trd lng="en">Western Sahara</trd>
        <trd lng="es">Sahara Occidental</trd>
        <trd lng="fr">Sahara occidental</trd>
        <trd lng="nl">Westelijke Sahara</trd>
        <trd lng="ro">Sahara Occidental&abreve;</trd>
      </ekz>

      <ekz>
        la afrika regiono Sahelo, sude de la dezerto <tld/>o
        <fnt>

          <aut>Roland Rotsaert</aut>
          <vrk><url ref="&Monato;/2005/008698.php">Evitenda
          evoluo</url></vrk>
          <bib>Monato</bib>
          <lok>2005/11, p. 13</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_S;&c_a;&c_h;&c_a;&c_r;&c_a;</trd>
  <trd lng="bg">&c_S;&c_a;&c_h;&c_a;&c_r;&c_a;</trd>
  <trd lng="ca">el <ind>S&agrave;hara</ind></trd>
  <trd lng="cs">Sahara</trd>
  <trd lng="de">Sahara</trd>
  <trd lng="en">Sahara</trd>
  <trd lng="es">Sahara</trd>
  <trd lng="fr">Sahara</trd>
  <trd lng="it">Sahara</trd>
  <trd lng="ja">&#x30B5;&#x30CF;&#x30E9;&#30722;&#x6F20;  <pr>&#x30B5;&#x30CF;&#x30E9;&#12373;&#12400;&#x304F;</pr></trd>
  <trd lng="nl">Sahara</trd>
  <trd lng="pl">Sahara</trd>
  <trdgrp lng="pt">
  <trd>Saara<klr> (Braz.)</klr></trd>
  <trd>Sara<klr> (Port.)</klr></trd>
  </trdgrp>
  <trd lng="ro">Sahara</trd>
  <trd lng="ru">&c_S;&c_a;&c_h;&c_a;&c_r;&c_a;</trd>
  <trd lng="sk">Sahara</trd>
  <trd lng="uk">&#x43F;&c_u;&c_s;&c_t;&c_je;&#x43B;&#x44F; &c_S;&c_a;&c_h;&c_a;&c_r;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#25746;&#x54C8;&#x62C9; <pr>S&amacron;h&amacron;l&amacron;</pr></trd>,
    <trd>&#25746;&#x54C8;&#x62C9;&#x6C99;&#x6F20; <pr>S&amacron;h&amacron;l&amacron;Sh&amacron;m&#xF2;</pr></trd>
  </trdgrp>
</drv>
</art>

