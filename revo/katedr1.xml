<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: katedr1.xml,v 1.24 2026/09/21 19:22:11 revo Exp $">
<kap>
  <ofc>2</ofc>
  <rad>katedral</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="katedr1.0o">
  <kap><ofc>2</ofc><tld/>o</kap>
  <snc mrk="katedr1.0o.KRI">
    <uzo tip="fak">KRI</uzo>
    <dif>
      Episkopa <ref tip="super" cel="pregx.0ejo">pre&gcirc;ejo</ref>:
      <ekz>
        <klr>[la]</klr> <tld/>o de &Ccirc;artro
        <fnt>
          <bib>Kon11</bib>
          <lok>&Ccirc;efartikolo</lok>
        </fnt>;
      </ekz>
      <ekz>
        penetris al li la sonoj de orgeno <klr>[&#x2026;]</klr> tial li eniris en la grandan
        <tld/>on
        <fnt>
          <bib>Fab3</bib>
          <lok>Sub la saliko</lok>
        </fnt>;
      </ekz>
      <ekz>
        la hebreoj lo&gcirc;is inter la <tld/>o kaj la bordo de Majno
        <fnt>
          <bib>RBa</bib>
          <lok>&Ccirc;apitro II</lok>
        </fnt>;
      </ekz>
      <ekz>
        la malaltaj konturoj de l&#x2019; antikva Peter-Pa&ubreve;l-fortika&jcirc;o, el kies mezo la
        Peter-Pa&ubreve;l-<tld/>o levas sian gracian turon
        <fnt>
          <bib>Voja&gcirc;Imp</bib>
          <lok>En Peterburgo</lok>
        </fnt>;
      </ekz>
      <ekz>
        okazis koncerto sur la placo apud la granda strasburga katedralo
        <fnt>
          <bib>Kon11</bib>
          <lok>Aktive, interjunulare (Kirill Novi&ccirc;enko)</lok>
        </fnt>.
      </ekz>
    </dif>
    <ref tip="sin" cel="pregx.katedra_0ejo">katedra pre&gcirc;ejo</ref>
    <trd lng="en">cathedral<klr> (church with episcopal
      chair)</klr></trd>
    <trd lng="nl">kathedraal</trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_k;&c_a;&c_t;&c_e;&c_d;&c_r;&c_a;</trd>,
    <trd>&c_k;&c_a;&c_t;&c_e;&c_d;&c_r;&c_a;&c_l;&c_mol;&c_n;&c_y; &c_s;&c_a;&c_b;&c_o;&c_r;</trd>
  </trdgrp>
  <trd lng="bg">&c_k;&c_a;&c_t;&c_je;&c_d;&c_r;&c_a;&c_l;&c_a;</trd>
  <trd lng="br">iliz-veur</trd>
  <trd lng="ca">catedral</trd>
  <trdgrp lng="de">
   <trd>Dom</trd>,
   <trd>M&uuml;nster</trd>,
   <trd>Kathedrale</trd>
  </trdgrp>
  <trd lng="es">catedral</trd>
  <trd lng="fa">&f_k;&a_l;&f_y;&a_s;&a_A;&f_y; &a_j;&a_A;&a_m;&a_ayn;</trd>
  <trd lng="fr">cath&eacute;drale</trd>
  <trdgrp lng="hu">
   <trd>sz&eacute;kesegyh&aacute;z</trd>,
   <trd>katedr&aacute;lis</trd>,
   <trd>d&oacute;m</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x53F8;&#x6559;&#x5EA7;&#x8056;&#x5802;  <pr>&#x3057;&#x304D;&#x3087;&#x3046;&#x3056;&#x305B;&#x3044;&#x3069;&#x3046;</pr></trd>,
    <trd>&#x5927;&#x8056;&#x5802;  <pr>&#x3060;&#x3044;&#x305B;&#x3044;&#x3069;&#x3046;</pr></trd>
  </trdgrp>
  <trd lng="pl">katedra <klr> (ko&sacute;ci&oacute;&lstroke;)</klr></trd>
  <trd lng="ro">catedral&abreve;</trd>
  <trd lng="ru">&c_k;&c_a;&c_f;&c_je;&c_d;&c_r;&c_a;&c_l;&c_mol;&c_n;&c_y;&c_j; <ind>&c_s;&c_o;&c_b;&c_o;&c_r;</ind></trd>
  <trd lng="uk">&c_k;&c_a;&c_f;&c_je;&c_d;&c_r;&c_a;&c_l;&c_mol;&c_n;&c_i;&c_j; &c_s;&c_o;&c_b;&c_o;&c_r;</trd>
  <trdgrp lng="zh">
    <trd>&#x5EA7;&#x5802; <pr>zu&ograve;t&aacute;ng</pr></trd>,
    <trd>&#x5927;&#x6559;&#x5802; <pr>d&agrave;ji&agrave;ot&aacute;ng</pr></trd>,
    <trd>&#x4E3B;&#x6559;&#x5EA7;&#x5802; <pr>zh&#x1D4;ji&agrave;ozu&ograve;t&aacute;ng</pr></trd>
  </trdgrp>
</drv>
</art>
