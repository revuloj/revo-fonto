    <trd lng="nl">object</trd>
    <trd lng="ru">&c_o;&c_b;&c_malmol;&c_je;&c_k;&c_t;</trd>
  </snc>
  <snc mrk="objekt.0o.GRA">
    <uzo tip="fak">GRA</uzo>
    <dif>
