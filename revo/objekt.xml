<art mrk="$Id: objekt.xml,v 1.115 2026/09/18 18:00:22 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>objekt</rad>/o <fnt><bib>UV</bib></fnt>
</kap>
<drv mrk="objekt.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <snc mrk="objekt.0o.ajxo">
    <dif>
      &Ccirc;io, kio estas videbla, tu&scirc;ebla, perceptebla per
      sentumoj; <ref tip="super" cel="ajx.0o">a&jcirc;o</ref>:
      <ekz>
        sur la tablo ku&scirc;as diversaj <tld/>oj;
      </ekz><ekz>
        &scirc;i prenis siajn ru&gcirc;ajn &scirc;uojn, la plej karan
        <tld/>on, kiun &scirc;i posedis
        <fnt><bib>Fab2</bib> <lok>Ne&gcirc;a re&gcirc;ino</lok></fnt>;
      </ekz><ekz>
        dom<tld/>oj
        <klr>(mebloj)</klr>
        <fnt> <bib>MT</bib>  <lok>&Neh; 13:8</lok></fnt>;
      </ekz><ekz>
        valoron de <tld/>o ni ekkonas post difekto
        <fnt><bib>PrV</bib></fnt>;
      </ekz><ekz>
        en &ccirc;iu <tld/>o trovi&gcirc;as difekto
        <fnt><bib>PrV</bib></fnt>;
      </ekz><ekz>
        la artikolo <em>la</em> estas uzata <klr>[&#8230;]</klr> kiam ni parolas pri
        personoj a&ubreve; <tld/>oj konataj
        <fnt><bib>F</bib> <lok>&FE; 27</lok></fnt>;
      </ekz><ekz>
        aliaj portis similan <tld/>aron en grandaj paka&jcirc;oj sur la dorso
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Urbo de Imperiestroj</lok>
        </fnt>;
      </ekz><ekz>
        neidentigita fluganta <tld/>o
        <klr>(vd <ref tip="sub" cel="nif.0o">nifo</ref>)</klr>
        <fnt>
          <bib>Monato</bib>
          <aut>Gilbert Ledon</aut>
          <vrk><url ref="&Monato;/2003/008040.html">Kvina povo</url></vrk>
        </fnt>.
      </ekz>
    </dif>
    <rim>
      Kvankam en tiu lasta ekzemplo kaj plej ofte oni kontrastigas la
      <tld/>ojn kun la personoj, estas okazoj, kie objekto povas signifi
      anka&ubreve; personon:
      <ekz>
        sub tri <tld/>oj tremas la tero kaj kvar &gcirc;i ne povas porti: sklavon, kiam li
        fari&gcirc;is re&gcirc;o, malsa&gcirc;ulon, kiam li tro sati&gcirc;is de pano, malamatan virinon,
        kiam &scirc;i edzini&gcirc;is kaj sklavinon, kiam &scirc;i elpelis sian sinjorinon
        <fnt>
          <bib>MT</bib>   <lok>&Sen; 30:21</lok> </fnt>.
      </ekz>
    </rim>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_a;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_r;&c_e;&c_ch;</trd>,
      <trd>&c_a;&c_b;'&c_je;&c_k;&c_t;</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Sache</trd>,
      <trd>Ding</trd>,
      <trd> <ofc>*</ofc>Gegenstand</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>t&aacute;rgy</trd>,
      <trd>dolog</trd>
    </trdgrp>
    <trdgrp lng="nl">
      <trd>voorwerp</trd>,
      <trd>object</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd> <ofc>*</ofc>&c_p;&c_r;&c_je;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_v;&c_je;&c_shch;&c_mol;</trd>,
      <trd>&c_o;&c_b;&c_malmol;&c_je;&c_k;&c_t;</trd>
    </trdgrp>
  </snc>
  <snc>
    <dif>
      &Ccirc;io ajn abstrakta, kio estas konceptebla de la spirito;
      <ref tip="sin" cel="afer.0o.cxio">afero</ref>:
      <ekz>
        lingvo internacia kaj lingvo tutmonda estas du tute malsamaj
        <tld/>oj
        <fnt><bib>EE</bib></fnt>;
      </ekz><ekz>
        la tutan nian civilizon ni dankas nur al unu <tld/>o, al la
        posedado de lingvo
        <fnt><bib>EE</bib></fnt>;
      </ekz><ekz>
        kun scienca aplombo ili kredigas, kvaza&ubreve; lingvo estus <tld/>o
        natura, organa
        <fnt><bib>EE</bib></fnt>;
      </ekz><ekz>
        ili parolis pri multaj <tld/>oj
        <fnt><bib>FK</bib></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_a;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_r;&c_e;&c_ch;</trd>,
      <trd>&c_s;&c_p;&c_r;&c_a;&c_v;&c_a;</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Sache</trd>,
      <trd>Aff&auml;re</trd>
    </trdgrp>
    <trd lng="hu">dolog</trd>
    <trd lng="nl">ding</trd>
    <trdgrp lng="ru">
      <trd> <ofc>*</ofc>&c_p;&c_r;&c_je;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_v;&c_je;&c_shch;&c_mol;</trd>,
      <trd>&c_d;&c_je;&c_l;&c_o;</trd>
    </trdgrp>
  </snc>
  <snc mrk="objekt.0o.temo">
    <dif>
      <ref tip="dif" cel="tem.0o">Temo</ref>:
      <ekz>
        la <tld/>o de la leciono, de la diskuto;
      </ekz><ekz>
        <klr>[multajn]</klr> leterojn <klr>[&#8230;]</klr> ni ricevis pri tiu &ccirc;i <tld/>o
        <fnt>
          <bib>OV</bib>
          <vrk><url ref="https://tekstaro.com/t?nomo=originala-verkaro"
              >Pri nia literaturo</url></vrk>
          <lok>II.93. El La Esperantisto 1895, n.3, p.34&ndash;38.</lok>
        </fnt>;
      </ekz><ekz>
        la legita <tld/>o
        <klr>(<tld/>o de legado)</klr>
        <fnt><bib>FK</bib></fnt>;
      </ekz><ekz>
        kiujn <klr>[&#8230;]</klr> <tld/>ojn vi povas kaj deziras instrui
        <fnt><bib>Marta</bib></fnt>?
      </ekz><ekz>
        decidi la enkondukon de Esperanto en lernejojn, kiel nedeviga
        <tld/>o de la instruado;
      </ekz><ekz>
        la plejmulto de tiuj &ccirc;i talentaj publikaj paroloj havas por <tld/>o E&ubreve;ropon,
        Azion kaj Afrikon
        <fnt><bib>FK</bib></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_a;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_t;&c_e;&c_m;&c_a;</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Thema</trd>
    </trdgrp>
    <trd lng="hu">t&eacute;ma</trd>
    <trd lng="nl">voorwerp</trd>
    <trd lng="ru"> <ofc>*</ofc>&c_p;&c_r;&c_je;&c_d;&c_m;&c_je;&c_t;</trd>
  </snc>
  <snc mrk="objekt.0o.deago">
    <dif>
      &Ccirc;io, kio estigas ian senton, kio liveras okazon al ia ago:
      <ekz>
        <tld/>o de mokoj
        <fnt><bib>EE</bib></fnt>;
      </ekz><ekz>
        mi faros ilin <tld/>o de honto
        <fnt>
          <bib>MT</bib> <lok>&Jer; 24:9</lok></fnt>;
      </ekz><ekz>
        la infanoj estis <tld/>o de plej zorga flegado;
      </ekz><ekz>
        <tld/>o de deziro, de intereso;
      </ekz><ekz>
        <nom>Babel</nom> fari&gcirc;is <tld/>o de teruro inter la popoloj
        <fnt><bib>MT</bib> <lok>&Jer; 51:41</lok></fnt>;
      </ekz><ekz>
        &scirc;in hontigis la kompato, kies <tld/>o &scirc;i estis
        <fnt><bib>Marta</bib></fnt>;
      </ekz><ekz>
        la inda <tld/>o de la admiro de du grandaj nacioj;
      </ekz><ekz>
        tiu granda poeto estis <tld/>o de multaj monumentoj;
      </ekz><ekz>
        du malgrandaj &ccirc;ambraj hundetoj fari&gcirc;is la escepta <tld/>o de &scirc;ia amo kaj
        aldoniteco
        <fnt><bib>FK</bib></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_p;&c_r;&c_a;&c_d;&c_m;&c_je;&c_t;</trd>,
      <trd>&c_a;&c_b;'&c_je;&c_k;&c_t;</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Objekt</trd>,
      <trd>Zielscheibe</trd>,
      <trd>&ouml;ffentliche Person</trd>
    </trdgrp>
    <trd lng="hu">t&aacute;rgy</trd>
    <trd lng="nl">voorwerp</trd>
    <trd lng="ru">&c_o;&c_b;&c_malmol;&c_je;&c_k;&c_t;</trd>
  </snc>
  <snc mrk="objekt.0o.FIL">
    <uzo tip="fak">FIL</uzo>
    <dif>
      La ekstera a&jcirc;o, kiu estas pensata de la pensanta
      <ref tip="ant" cel="subjek.0o.FIL">subjekto</ref>:
      <ekz>
        la ideo, kiun ni havas pri iu afero povas esti ne konforma al sia  <tld/>o.
      </ekz>
    </dif>
    <trd lng="be">&c_a;&c_b;'&c_je;&c_k;&c_t;</trd>
    <trdgrp lng="de">
