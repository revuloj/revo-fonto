<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: galban.xml,v 1.9 2026/10/31 12:00:19 revo Exp $">
<kap>
  <rad>galban</rad>/o <fnt><bib>PIV1</bib></fnt>
</kap>

<drv mrk="galban.0o">
  <kap><tld/>o</kap>
  <snc mrk="galban.0o.PAR">
    <dif>
      Blanka gumo el la herbo ferulo, kuraca substanco kaj ingredienco de
      <ref tip="malprt" cel="incens.0o.rezino">incenso</ref>:
      <ekz>
        prenu al vi aroma&jcirc;on: balzamon kaj stakton kaj <tld/>on bonodoran
        <fnt><bib>MT</bib>, <lok>&Eli; 30:34</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_g;&c_a;&c_l;&c_mol;&c_b;&c_a;&c_n;</trd>
  <trd lng="ca">g&agrave;lban</trd>
  <trd lng="cs">galb&aacute;nov&aacute; prysky&rcaron;ice</trd>
  <trd lng="de">Galbanharz</trd>
  <trd lng="fr">galbanum</trd>
  <trd lng="pl">galbanum  <klr>(gumo&zdot;ywica)</klr></trd>
  <trd lng="pt">g&aacute;lbano</trd>
  <trd lng="sk">galbanov&aacute; &zcaron;ivica</trd>
  <trd lng="uk">&c_g;&c_a;&c_l;&c_mol;&c_b;&c_a;&c_n;&nbsp;(&c_r;&c_o;&c_s;&c_l;&c_i;&c_n;&c_n;&c_a;
  &c_s;&c_m;&c_o;&c_l;&c_a;)</trd>
</drv>
</art>

