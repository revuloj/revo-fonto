    <trd lng="de">Kleptokratie</trd>
    <trd lng="en">kleptocracy</trd>
    <trd lng="fr">kleptocratie</trd>
    <trd lng="ru">&c_k;&c_l;&c_je;&c_p;&c_t;&c_o;&c_k;&c_r;&c_a;&c_t;&c_i;&c_ja;</trd>
