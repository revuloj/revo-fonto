<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: madon.xml,v 1.22 2026/08/02 13:50:16 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>madon</rad>/o
<fnt><bib>JED</bib></fnt></kap>

<drv mrk="madon.0o">
  <kap>
    <tld/>o
  </kap>
  <snc mrk="madon.0o.KAT">
    <uzo tip="fak">KAT</uzo>
    <dif>
      La <ref tip="dif" cel="di.0patrino">Dipatrino</ref>:
      <ekz>
        en la dramo, la <tld/>o en halucino/vizio aperas al <nom>Beatrice</nom>
        <fnt>
          <bib>Monato</bib>
          <aut>Donald Broadribb</aut>
          <vrk><url ref="&Monato;/2004/008131.html"
              >Bone prezentita dramo malkvietiga</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Maria</trd>,
      <trd>Heilige <ind>Jungfrau</ind></trd>,
      <trd>Heilige <ind>Mutter</ind></trd>,
      <trd>Mutter <ind>Gottes</ind></trd>,
      <trd>Muttergottes</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd><klr>&sacute;wi&eogonek;ta </klr>Madonna</trd>,
      <trd>Matka Boska</trd>,
      <trd>Bozia<klr> (dziec.)</klr></trd>
    </trdgrp>
    <trdgrp lng="pt">
      <trd>madona <klr>(rel.)</klr></trd>,
      <trd>Virgem Maria</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_b;&c_o;&c_g;&c_o;&c_m;&c_a;&c_t;&c_je;&c_r;&c_mol;</trd>,
      <trd>&c_b;&c_o;&c_g;&c_o;&c_r;&c_o;&c_d;&c_i;&c_c;&c_a;</trd>
    </trdgrp>
  </snc>
  <snc mrk="madon.0o.BELA">
    <uzo tip="fak">BELA</uzo>
    <dif>
      Okcidenta bildo a&ubreve; skulptita figuro prezentanta la
      Dipatrinon:
      <ekz>
        post pli longa tempo tiuj eternaj <tld/>oj sufi&ccirc;ege
        tedis al mi
        <fnt><bib>Fab4</bib>, <lok>&leftquot;Bela&rightquot;</lok></fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Marienfigur</trd>,
      <trd>Bildnis der Heiligen <ind>Jungfrau</ind></trd>
    </trdgrp>
    <trd lng="ru">&c_m;&c_a;&c_d;&c_o;&c_n;&c_n;&c_a;</trd>
  </snc>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: Anka&ubreve; eblas diri <ke>dipatrino</ke>,
    <ke>sankta patrino</ke>; (pri pentra&jcirc;oj) anka&ubreve; eblas diri
    <ke>dipatrinbildo</ke>, <ke>virgulinbildo</ke>.
  </rim>
  <trdgrp lng="be">
    <trd>&c_m;&c_a;&c_d;&c_o;&c_n;&c_a;</trd>,
    <trd>&c_b;&c_a;&c_g;&c_a;&c_r;&c_o;&c_d;&c_z;&c_ib;&c_c;&c_a;</trd>,
    <trd>&c_m;&c_a;&c_c;&c_ib; &c_b;&c_o;&c_zh;&c_a;&c_ja;</trd>
  </trdgrp>
  <trd lng="br">Itron Varia</trd>
  <trd lng="ca">Mare de D&eacute;u</trd>
  <trd lng="cs">Madona</trd>
  <trd lng="de">Madonna</trd>
  <trd lng="en">Madonna</trd>
  <trd lng="hu">madonna</trd>
  <trd lng="nl">Madonna</trd>
  <trdgrp lng="pl">
    <trd>Madonna</trd>,
    <trd>Matka Boska</trd>,
    <trd>Bozia<klr> (dziec.)</klr></trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x5723;&#x6BCD;&#x50CF; <pr>sh&egrave;ngm&#x1D4;xi&agrave;ng</pr></trd>,
    <trd>&#x8056;&#x6BCD;&#x50CF; <pr>sh&egrave;ngm&#x1D4;xi&agrave;ng</pr></trd>,
    <trd>&#x5723;&#x6BCD;&#x50CF; <pr>sh&ecaron;ngm&#x1D4;xi&agrave;ng</pr></trd>,
    <trd>&#x8056;&#x6BCD;&#x50CF; <pr>sh&ecaron;ngm&#x1D4;xi&agrave;ng</pr></trd>,
    <trd>&#x5723;&#x6BCD;&#x739B;&#x5229;&#x4E9A; <pr>sh&egrave;ngm&#x1D4;m&#x1CE;l&igrave;y&agrave;</pr></trd>,
    <trd>&#x8056;&#x6BCD;&#x746A;&#x5229;&#x4E9E; <pr>sh&egrave;ngm&#x1D4;m&#x1CE;l&igrave;y&agrave;</pr></trd>
  </trdgrp>
</drv>
