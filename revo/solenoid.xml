<vortaro>
  <art mrk="$Id: solenoid.xml,v 1.1 2026/11/23 08:07:22 afido Exp $">
    <kap>
      <rad>solenoid</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="solenoid.0o">
  <kap><tld/>o</kap>
  <snc>
    <uzo tip="fak">FIZ</uzo><uzo tip="fak">ELE</uzo>
    <dif>
      Cilindra <ref tip="super" cel="boben.0o.ELE">bobeno</ref> konsiderinde pli longa ol lar&gcirc;a
      kaj tiel kreanta homogenan magnetkampon:
      <ekz>
        la unusola baterio <klr>[&#x2026;]</klr> estas konektita al la cirkvito de mikrofono
        tra bar<tld/>o, kiu tralasas la elektran kurenton el la baterio, sed baras la
        alternan kurenton de la mikrofono
        <fnt>
          <bib>SR</bib>
          <aut>Karlo Juh&aacute;sz</aut>
          <vrk>Historio de la telefonaparatoj</vrk>
          <lok>Scienca Revuo, nro 133/1978</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Solenoid</trd>
    <trd lng="en">solenoid</trd>
    <trd lng="fr">sol&eacute;no&iuml;de <klr>(physique)</klr></trd>
    <trd lng="it">solenoide</trd>
    <trd lng="ru">&c_s;&c_o;&c_l;&c_je;&c_n;&c_o;&c_i;&c_d;</trd>
    <trd lng="uk">&c_s;&c_o;&c_l;&c_je;&c_n;&c_o;&c_ji;&c_d;</trd>
  </snc>
</drv>

  </art>


