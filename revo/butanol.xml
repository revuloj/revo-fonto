<vortaro>
  <art mrk="$Id: butanol.xml,v 1.1 2026/11/23 08:07:24 afido Exp $">
    <kap>
      <rad>butanol</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="butanol.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">KEM</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="alkoho.0o.KEM">Alkoholo</ref>, <frm>C<sub>4</sub>H<sub>9</sub>-OH</frm>,
      kies molekuloj konsistas el kvar karbonatomoj, iu el kvar tiaj izomeroj:
      <ekz>
        uzado por la kromatografio de miksa&jcirc;o <tld/>o &ndash; acetata acido &ndash; akvo en rilatoj
        4:1:5
        <fnt>
          <bib>SR</bib>
          <aut>B. V. Tokarev</aut>
          <vrk>Formi&gcirc;o de l'aminacidoj dum interago de dioksido de karbono kun amoniakato de kalcio</vrk>
          <lok>Scienca Revuo, nro 108/1974</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Butanol</trd>
    <trd lng="en">butanol</trd>
    <trd lng="fr">butanol</trd>
    <trd lng="ru">&c_b;&c_u;&c_t;&c_a;&c_n;&c_o;&c_l;</trd>
  </snc>
</drv>

  </art>


