<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: kaskad.xml,v 1.27 2026/08/03 07:40:33 revo Exp $">
<kap>
  <rad>kaskad</rad>/o <fnt><bib>JED</bib></fnt>
</kap>

<drv mrk="kaskad.0o">
  <kap><tld/>o</kap>
  <snc mrk="kaskad.0o.akvofalo">
    <dif>
      Plur&scirc;tupa <ref tip="super" cel="fal.akvo0o">akvofalo</ref>:
      <ekz>
        fontano en la mezo de la salono ver&scirc;is grandegan <tld/>on de pulvorigita akvo
        <fnt>
          <bib>FdO</bib>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>cascada</trd>,
      <trd>salt d&#x2019;aigua</trd>,
      <trd>saltant</trd>,
      <trd>sallent</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Kaskade</trd>,
      <trd>Stufenwasserfall</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>l&eacute;pcs&odblac;s v&iacute;zes&eacute;s</trd>,
      <trd>zuhatag</trd>
    </trdgrp>
  </snc>
  <snc mrk="kaskad.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      <ref cel="cxen.0o.FIG">&Ccirc;eno</ref> de rapide sinsekvaj eventoj:
      <ekz>
        <tld/>o de klarigoj
        <fnt>
          <bib>OIP</bib>
          <lok>Ombro sur interna pejza&gcirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        la kantado de la birdoj <tld/>e plenigis la aeron per vibrantaj tonoj
        <fnt>
          <bib>InfanTorent2</bib>
          <lok>Unua Parto</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="ca">
      <trd>cascada</trd>,
      <trd>allau</trd>,
      <trd>reguitzell</trd>,
      <trd>tirallonga</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Kaskade</trd>,
      <trd>Schwall</trd>
    </trdgrp>
    <trdgrp lng="hu">
      <trd>&ouml;z&ouml;n</trd>,
      <trd>zuhatag</trd>
    </trdgrp>
  </snc>
  <snc mrk="kaskad.0o.TEK">
    <uzo tip="fak">TEK</uzo>
    <dif>
      Me&hcirc;anismo el sinsekve kunligitaj samtipaj aparatoj ks,
      transdonantaj ion de unu al la sekva:
      <ekz>
        <ind><tld/>a</ind> sistemo,
        <trd lng="ca">en <ind>cascada</ind></trd>
        <trdgrp lng="fr">
          <trd>de <ind>cascade</ind></trd>,
          <trd>en <ind>cascade</ind></trd>,
          <trd>cascad&eacute;</trd>
        </trdgrp>
      </ekz>
      <ekz>
        <tld/>a konekto, amplifilo;
      </ekz>
      <ekz>
        la programo Horizonto de E&ubreve;ropa Komisiono, financas liberan programaron en
        E&ubreve;ropo per <tld/>a financa mekanismo
        <fnt>
          <vrk><url ref="https://kde.org/eo/announcements/2024_ngi_openletter/"
              >KDE subskribas peticion ur&gcirc;anta E&ubreve;ropan Union da&ubreve;rigi financadon de libera programaro</url></vrk>
          <lok>20. Julio 2024 </lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Kaskade</trd>,
      <trd>Batterie</trd>
    </trdgrp>
    <trd lng="hu">kaszk&aacute;d</trd>
  </snc>
  <ref tip="vid" cel="stafet.0o">stafeto</ref>
  <rim>
    La&ubreve; <fnt><bib>BL</bib></fnt>: (la&ubreve; la senco) prefere diru <ke>akvofalo</ke>, <ke>serio</ke>.
  </rim>
  <adm>
    &Scirc;ajnas al mi, ke la senco TEK koncernas nur la adjektivon.
    <aut>MB</aut>
  </adm>
  <trd lng="be">&c_k;&c_a;&c_s;&c_k;&c_a;&c_d;</trd>
  <trd lng="bg">&c_k;&c_a;&c_s;&c_k;&c_a;&c_d;&c_a;</trd>
  <trd lng="bo">&t_ba;&t_ba;&t_sa;&t_tsheg;&t_cha;&t_shabchu;&t_tsheg;</trd>
  <trdgrp lng="cs">
    <trd>kask&aacute;da</trd>,
    <trd>pe&rcaron;ej</trd>,
    <trd>slap</trd>,
    <trd>vodop&aacute;d</trd>
  </trdgrp>
  <trd lng="de">Kaskade</trd>
  <trd lng="en">cascade</trd>
  <trd lng="es">cascada</trd>
  <trdgrp lng="fr">
    <trd>cascade</trd>,
    <trd>avalanche<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>chapelet<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>d&eacute;luge<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>kyrielle<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>ribambelle<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>succession<klr tip="ind"> (suite ininterrompue)</klr></trd>,
    <trd>suite ininterrompue</trd>,
    <trd>torrent<klr tip="ind"> (suite ininterrompue)</klr></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x6EDD;  <pr>&#x305F;&#x304D;</pr></trd>,
    <trd>&#x6B21;&#x3005;&#x3068;&#x8D77;&#x3053;&#x308B;&#x3053;&#x3068;  <pr>&#x3064;&#x304E;&#x3064;&#x304E;&#x3068;&#x304A;&#x3053;&#x308B;&#x3053;&#x3068;</pr></trd>
  </trdgrp>
  <trd lng="nl">cascade</trd>
  <trd lng="pl">kaskada</trd>
  <trd lng="ro">cascad&abreve;</trd>
  <trd lng="ru">&c_k;&c_a;&c_s;&c_k;&c_a;&c_d;</trd>
  <trdgrp lng="sk">
    <trd>kask&aacute;da</trd>,
    <trd>perej</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_k;&c_a;&c_s;&c_k;&c_a;&c_d;</trd>,
    <trd>&c_v;&c_o;&c_d;&c_o;&c_s;&c_p;&c_a;&c_d;</trd>,
    <trd>&c_p;&c_o;&c_r;&c_o;&c_g;&c_i; (&c_r;&c_ib;&c_ch;&c_k;&c_o;&c_v;&c_ib;)</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#x5C0F;&#x7011;&#x5E03; <pr>xi&#x1CE;op&ugrave;b&ugrave;</pr></trd>,
    <trd>&#x7D1A;&#x806F; <pr>j&iacute;li&aacute;n</pr></trd>
  </trdgrp>
</drv>

<drv mrk="kaskad.0i">
  <kap>
    <tld/>i
  </kap>
  <snc>
    <dif>
      Aperi en rapida sinsekvo kvaza&ubreve; falanta <tld/>akvo:
      <ekz>
        liaj frazoj <tld/>as sen transiri la randon de &gcirc;entileco
        <fnt>
          <bib>OIP</bib>
          <lok>Ombro sur interna pejza&gcirc;o</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">kaskadieren</trd>
  <trd lng="en">cascade</trd>
</drv>

</art>
