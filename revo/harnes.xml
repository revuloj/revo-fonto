<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
  <art mrk="$Id: harnes.xml,v 1.1 2026/10/24 18:46:20 afido Exp $">
    <kap>
      <rad>harnes</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="harnes.0o">
  <kap><tld/>o</kap>
  <snc mrk="harnes.0o.TEKS">
    <uzo tip="fak">TEKS</uzo>
    <dif>
      Parto de <ref tip="malprt" cel="teks.0ilo">teksilo</ref>, per kiu oni alterne
      levas kaj mallevas la varperojn:
      <ekz>
        kerno de la <tld/>o estas la varperingoj, kiuj &ccirc;irka&ubreve;as la unuopajn varperojn,
        ebligante ilin levadi kaj mallevadi; <klr>[&#x2026;]</klr>
        ekzistas du specoj de <tld/>oj: <tld/>oj foliaj por malpli komplikaj plektoj kaj
        <tld/>oj &jcirc;akardaj por teksa&jcirc;oj komplike plektitaj (florumitaj)
        <fnt>
          <aut>Marie Bartovsk&aacute;</aut>
          <vrk><url ref="https://scienca-revuo.info/article/1079"
              >Tredo, tretado, ligo</url></vrk>
          <lok>Scienca Revuo, 1975 n-ro 116, artikolo 1079</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Schaftwerk <klr>(Webstuhl)</klr></trd>,
      <trd>Geschirr <klr>(Webstuhl)</klr></trd>
    </trdgrp>
    <trd lng="en">harness</trd>
    <trd lng="ru">&c_r;&c_je;&c_m;&c_i;&c_z;&c_k;&c_a;</trd>
    <trd lng="sv">solvskaft</trd>
  </snc>
</drv>

  </art>


