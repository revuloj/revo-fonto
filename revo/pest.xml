<kap>
  <ofc>*</ofc>
  <rad>pest</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="pest.0o">
  <kap><ofc>*</ofc><tld/>o</kap>
  <uzo tip="fak">MED</uzo>
  <snc>
    <dif>
      Epidemia <ref tip="lst" cel="san.mal0o" lst="voko:malsanoj">malsano</ref> 
      devena de Oriento kaj preska&ubreve; &ccirc;iam mortiga:
      <ekz>
        dek junaj virinoj kaj viroj, fu&gcirc;intaj kamparen 
        pro la <tld/>o, kiu paralizis Florencon en
        la jaro 1348.
      </ekz>
    </dif>
    <refgrp tip="sin">
      <ref cel="hxoler.0o">&hcirc;olero</ref>.
    </refgrp>
  </snc>
  <trd lng="be">&c_ch;&c_u;&c_m;&c_a;</trd>
  <trd lng="bg">&c_ch;&c_u;&c_m;&c_a;</trd>
  <trd lng="br">bosenn<klr tip="ind"> (kle&ntilde;ved)</klr></trd>
  <trd lng="ca">pesta</trd>
  <trdgrp lng="cs">
    <trd>mor</trd>,
    <trd>pestis</trd>
  </trdgrp>
  <trd lng="de">Pest</trd>
  <trdgrp lng="en">
    <trd>pest</trd>,
    <trd>pestilence</trd>,
    <trd>plague</trd>
  </trdgrp>
  <trd lng="es">peste<klr tip="amb"> (med.)</klr></trd>
  <trd lng="fr">peste</trd>
  <trd lng="hu">pestis</trd>
  <trd lng="id">pes</trd>
  <trdgrp lng="ja">
    <trd>&#12506;&#12473;&#12488;  <pr>&#12410;&#12377;&#12392;</pr></trd>,
    <trd>&#30123;&#30149;  <pr>&#12360;&#12365;&#12403;&#12423;&#12358;</pr></trd>,
    <trd>&#24746;&#30123;  <pr>&#12354;&#12367;&#12360;&#12365;</pr></trd>,
    <trd>&#26377;&#23475;&#12394;&#20154;&#29289;  <pr>&#12422;&#12358;&#12364;&#12356;&#12394;&#12376;&#12435;&#12406;&#12388;</pr></trd>,
    <trd>&#23475;&#34411;  <pr>&#12364;&#12356;&#12385;&#12421;&#12358;</pr></trd>
  </trdgrp>
  <trd lng="nl">pest</trd>
  <trdgrp lng="pl">
    <trd>d&zdot;uma</trd>,
    <trd>czarna &sacute;mier&cacute;</trd>,
    <trd>m&oacute;r</trd>,
    <trd>zaraza morowa</trd>
  </trdgrp>
  <trd lng="pt">peste <klr tip="ind">(doen&ccedil;a)</klr></trd>
  <trd lng="ru">&c_ch;&c_u;&c_m;&c_a;</trd>
  <trd lng="sk">mor</trd>
  <trdgrp lng="uk">
    <trd>&c_ch;&c_u;&c_m;&c_a;</trd>,
    <trd>&c_m;&c_o;&c_r;</trd>
  </trdgrp>
  <trdgrp lng="zh">
    <trd>&#30112; <pr>l&igrave;</pr></trd>,
    <trd>&#30296; <pr>l&igrave;</pr></trd>,
    <trd>&#33146;&#40736;&#30123; <pr>xi&agrave;nsh&#468;y&igrave;</pr></trd>
  </trdgrp>
</drv>
</art>
