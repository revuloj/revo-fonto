<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: arden.xml,v 1.4 2026/10/16 07:07:49 afido Exp $">
<kap>
    <rad>Arden</rad>/oj <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="arden.0o">

  <kap><tld/>oj</kap>
  <snc mrk="arden.0o.SNC">
    <uzo tip="fak">GEOG</uzo>
    <dif>
      <ref tip="lst" lst="voko:montaroj" cel="mont.0aro">Montaro</ref> en la nord-oriento de
      Francujo kaj sud-oriento de Belgujo:
      <ekz>
        <nom>Josephine Overeem</nom> <klr>[...]</klr> volis malfermi informadocentron en la belgaj
        <tld lit="A"/>oj
        <fnt>
        <aut>Ivo Durwael</aut>
        <vrk><url ref="&Monato;/2004/008236.html">La rikolto de la nova tempo</url></vrk>
        <bib>Monato</bib>
        <lok>2004</lok>
        </fnt>;
      </ekz>
      <ekz>
        en <nom>Septon-Durbuy</nom>, Belgio, urbeto en la regiono de <tld/>oj, trovi&gcirc;as &ccirc;arma
        griz&scirc;tona
        kastelo, kiu dum multaj jarcentoj havis diversajn lo&gcirc;antojn kaj funkciojn
        <fnt>
          <aut>Bob L. Garmoyer</aut>
          <vrk>Spirita programo dum la tuta jaro</vrk>
          <bib>Monato</bib>
          <lok>1999/06, p. 13</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Ardennen</trd>
  <trd lng="en">Ardennes</trd>
  <trd lng="fr">Ardenne</trd>
  <trd lng="nl">Ardennen</trd>
  <trd lng="ro">Ardeni</trd>
</drv>

<drv mrk="arden.0a">
  <kap>
    <tld lit="a"/>a
  </kap>
  <snc>
    <dif>
      Rilata al la montaro a&ubreve; la regiono &ccirc;e <tld lit="A"/>oj:
      <ekz>
        la a&ccirc;etantoj <klr>[...]</klr> viglas en la belga <tld lit="a"/>a loko <nom>Martelange</nom>
       <fnt>
          <aut>Hansjorg Kindler</aut>
          <vrk>Kontrabando prosperas</vrk>
          <bib>Monato</bib>
          <lok>1983/04, p. 24</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="de">Ardenner</trd>
  <trd lng="nl">Ardens</trd>
</drv>
</art>

