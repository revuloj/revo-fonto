<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">

<vortaro>
<art mrk="$Id: kilimangxar.xml,v 1.3 2026/09/16 07:42:27 afido Exp $">
    <kap>
      <rad>Kiliman&gcirc;ar</rad>/o
      <fnt><bib>PIV1</bib></fnt>
    </kap>

<drv mrk="kilimangxar.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo>
  <snc>
    <dif>
      La plej alta <ref tip="lst" lst="voko:montoj" cel="mont.0o.GEOG">monto</ref> (5895&#x202F;m)
      en Afriko, en la nordoriento de <ref tip="malprt" cel="tanzani.T0o">Tanzanio</ref>:
      <ekz>
        <tld/>o, la tegmento de Afriko
        <fnt>
          <bib>Kon11</bib>
          <lok>Voja&gcirc;o</lok>
        </fnt>;
      </ekz>
      <ekz>
        post <tld/>o mi decidis provi surgrimpi Akonkagvon
        <fnt>
          <bib>Kon11</bib>
          <lok>70-a jari&gcirc;o de la Esperanto-flago super Akonkagvo</lok>
        </fnt>;
      </ekz>
      <ekz>
        <nom>Greenpeaks</nom> alvokas nun de sur la pinto de <tld/>o &ccirc;iujn alpistojn por kunlaboro
        kaj subteno de la tutmonda klimatprotekta kampanjo
        <fnt>
          <bib>Monato</bib>
          <aut>Evgeni Georgiev</aut>
          <vrk><url ref="&Monato;/2010/009962.php"
              >A&ubreve;straj alpistoj sur Kiliman&gcirc;aro: konvencio pri klimata protektado
              postulata</url></vrk>
          <lok>2010</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Kilimandscharo</trd>
    <trd lng="en">Kilimanjaro</trd>
    <trd lng="fr">Kilimandjaro</trd>
    <trd lng="ru">&c_K;&c_i;&c_l;&c_i;&c_m;&c_a;&c_n;&c_d;&c_zh;&c_a;&c_r;&c_o;</trd>
  </snc>
<trd lng="id">Kilimanjaro</trd>
</drv>

  </art>

