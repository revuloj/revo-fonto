  <trd lng="hu">Odera</trd>
  <trd lng="ja">&#12458;&#12540;&#12487;&#12523;&#24029;
    <pr>&#12458;&#12540;&#12487;&#12523;&#12363;&#12431;</pr></trd>
  <trd lng="lat">Viadrus</trd>
  <trd lng="nl">Oder</trd>
  <trd lng="oc">Oder</trd>
  <trd lng="pl">Odra</trd>
  <trdgrp lng="pt">
