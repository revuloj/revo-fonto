<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: cxajot.xml,v 1.12 2026/09/13 11:43:38 revo Exp $">
<kap>
  <rad>&ccirc;ajot</rad>/o <fnt><bib>PIV2</bib></fnt>
</kap>
<drv mrk="cxajot.0o">
  <kap><tld/>o</kap>
  <snc mrk="cxajot.0o.BOT">
    <uzo tip="fak">BOT</uzo>
    <dif>
      Liano el varmaj landoj kultivata pro la frukto,
      <ref tip="lst" cel="genr.0o.BIO" lst="voko:botanikaj_genroj">genro</ref> el familio
      <ref tip="super" cel="kukurb1.0oj.BOT">kukurbacoj</ref>
      (<trd lng="la">Sechium edule</trd>).
    </dif>
    <bld
      lok="&WCU;/thumb/7/7f/Sechium_edule_143-8738.jpg/500px-Sechium_edule_143-8738.jpg"
      prm="PD"
      >botanika tabulo de <tld/>(uj)o (Sechium edule)
        <fnt>
          <aut>M.S. del., J.N.Fitch lith., Curtis's Botanical Magazine, Londono, vol. 143</aut>
          <lok><url ref="&WCW;/File:Sechium_edule_143-8738.jpg"
              >https://commons.wikimedia.org/wiki/File:Sechium_edule_143-8738.jpg</url></lok>
        </fnt>
    </bld>
     <trdgrp lng="it">
      <trd>chayote</trd>,
      <trd>sechio</trd>,
      <trd>sechium edule</trd>
    </trdgrp>
  </snc>
  <snc mrk="cxajot.0o.KUI">
    <uzo tip="fak">KUI</uzo>
    <dif>
      Frukto de <tld/>planto, pugnogranda, helflava a&ubreve; helverda,
      kun la&ubreve;longaj malrektaj sulkoj kaj unusola kerno, kuirebla
      kiel <ref tip="super" cel="legom.0o.KUI">legomo</ref>:
      <ekz>
        <tld/>o <klr>[&#x2026;]</klr> estas piroforma kun faldetoj
        <fnt><bib>Viki</bib>,
        <lok>artikolo &leftquot;&ccirc;ajoto&rightquot;,
        2007-09-21</lok></fnt>;
      </ekz>
      <ekz>
        ili rikoltis <klr>[&#x2026;]</klr> <tld/>on <klr>[&#x2026;]</klr> kaj papajon
        <fnt>
          <aut>J. L. Mu&ntilde;oz</aut>,
          <vrk>
          <url ref="http://www.geocities.com/skarabo_2000/mayas.htm">
          La Majaoj</url></vrk>,
          <lok>[vidita en 2008-01]</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="it">
      <trd>chayote</trd>,
      <trd>sechio</trd>,
      <trd>sechium edule</trd>,
      <trd><ind>patata</ind> spinosa<klr> (pop.)</klr></trd>,
      <trd><ind>melanzana</ind> spinosa<klr> (pop.)</klr></trd>,
      <trd><ind>zucchina</ind> spinosa<klr> (pop.)</klr></trd>,
      <trd><ind>melanzana</ind> americana<klr> (pop.)</klr></trd>,
      <trd><ind>lingua</ind> di lupo<klr> (pop.)</klr></trd>
    </trdgrp>
  </snc>
  <rim>
    En <fnt><bib>PIV2</bib></fnt> <tld/>o ankora&ubreve; nomas planton, dum
    la interreta eldono jam enkondukas <tld/>ujo, kio pli konvenas
    kun la uzo de la nomo por la frukto.
    <aut>Wolfram Diestel</aut>
  </rim>
  <trdgrp lng="be">
    <trd>&c_ch;&c_a;&c_jo;&c_t; &c_ja;&c_d;&c_o;&c_m;&c_y;</trd>,
    <trd>&c_m;&c_e;&c_k;&c_s;&c_y;&c_k;&c_a;&c_n;&c_s;&c_k;&c_ib; <ind>&c_a;&c_g;&c_u;&c_r;&c_o;&c_k;</ind></trd>
  </trdgrp>
  <trd lng="de">Chayote</trd>
  <trdgrp lng="en">
    <trd>chayote</trd>,
    <trd>chocho</trd>,
    <trd>christophine</trd>,
    <trd>merliton</trd>
  </trdgrp>
  <trdgrp lng="es">
    <trd>chayota</trd>,
    <trd>chayote</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>chayote</trd>,
    <trd>chouchou<klr> (l&eacute;gume)</klr></trd>,
    <trd>christophine<klr> (l&eacute;gume)</klr></trd>
  </trdgrp>
  <trdgrp lng="id">
    <trd>labu siam</trd>,
    <trd>jipang</trd>,
    <trd>welok</trd>
  </trdgrp>
  <trd lng="ja">&#x30CF;&#x30E4;&#x30C8;&#x30A6;&#x30EA;</trd>
  <trd lng="pl">kolczoch<klr> jadalny</klr></trd>
  <trd lng="pt">chuchu</trd>
  <trdgrp lng="uk">
    <trd>&c_ch;&c_a;&c_j;&c_o;&c_t;</trd>,
    <trd>&c_m;&c_je;&c_k;&c_s;&c_i;&c_k;&c_a;&c_n;&c_s;&c_mol;&c_k;&c_i;&c_j; &c_o;&c_g;&c_ib;&c_r;&c_o;&c_k;</trd>
  </trdgrp>
  <trd lng="zh">&#x4F5B;&#x624B;&#x74DC; <pr>f&oacute;sh&#x1D2;ugu&amacron;</pr></trd>
</drv>
</art>

