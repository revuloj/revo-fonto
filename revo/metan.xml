<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: metan.xml,v 1.22 2026/08/10 13:40:56 revo Exp $">
<kap>
  <rad>metan</rad>/o
  <fnt><bib>PV</bib></fnt>
</kap>
<drv mrk="metan.0o">
  <kap>
    <tld/>o
  </kap>
  <snc>
  <uzo tip="fak">KEM</uzo>
    <dif>
      Senkolora <ref tip="super" cel="gas.0o">gaso</ref>, saturita
      hidrokarbido, kiu eli&gcirc;as el mar&ccirc;oj kaj kies flamo brulas flave:
      <ekz>
        longda&ubreve;ra kresko de industriaj ellasoj de forcejaj gasoj (&ccirc;efe karbondioksido,
        sed anka&ubreve; <tld/>o kaj iuj aliaj gasoj) povas draste altigi la tutmondan avera&gcirc;an
        temperaturon
        <fnt>
          <bib>Monato</bib>
          <aut>Vladimir Lemelev</aut>
          <vrk><url ref="&Monato;/2007/009243.php">Epidemiaj sekvoj en E&ubreve;ropo</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        per modernaj teknikoj de spektroskopio, ili mezuris la atmosferon, graviton,
        &ccirc;eeston de fero kaj aliaj elemento, kaj de gasoj kiel <tld/>o kaj tiel plu
        <fnt>
          <bib>Monato</bib>
          <aut>Albisturo Kvinke</aut>
          <vrk><url ref="&Monato;/2010/009731.php">Tajg kaj Tomas</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        por ekstrakti pli multe da nafto kaj gaso (kemie: metano, CH<sub>4</sub>),
        oni de post 1947 disrompas &scirc;tonaron per akvo kaj granda premo,
        tra la fendoj, kiuj tiel ekestas, fluidoj ja povas eli&gcirc;i
        <fnt>
          <bib>Monato</bib>
          <aut>Werner Fuss</aut>
          <vrk><url ref="&Monato;/2014/011348.php">Novtipa gasminado: &ccirc;u vere dan&gcirc;era?</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_e;&c_t;&c_a;&c_n;</trd>
  <trd lng="bg">&c_m;&c_je;&c_t;&c_a;&c_n;</trd>
  <trd lng="ca">met&agrave;</trd>
  <trdgrp lng="de">
    <trd>Methan</trd>,
    <trd>Methangas</trd>,
    <trd>Grubengas</trd>,
    <trd>Sumpfgas</trd>
  </trdgrp>
  <trd lng="en">methane</trd>
  <trd lng="fr">m&eacute;thane</trd>
  <trdgrp lng="hu">
    <trd>met&aacute;n</trd>,
    <trd>mocs&aacute;rg&aacute;z</trd>
  </trdgrp>
  <trd lng="ja">&#x30E1;&#x30BF;&#x30F3;</trd>
  <trd lng="nl">methaan</trd>
  <trd lng="pt">metano</trd>
  <trdgrp lng="ru">
    <trd>&c_m;&c_je;&c_t;&c_a;&c_n;</trd>,
    <trd>&c_b;&c_o;&c_l;&c_o;&c_t;&c_n;&c_y;&c_j; &c_g;&c_a;&c_z;</trd>
  </trdgrp>
  <trd lng="sk">met&aacute;n</trd>
  <trd lng="uk">&#x43C;&c_je;&c_t;&c_a;&#x43D;</trd>
  <trdgrp lng="zh">
    <trd>&#x6CBC;&#x6C14; <pr>zh&#x1CE;oq&#xEC;</pr></trd>,
    <trd>&#x6CBC;&#x6C23; <pr>zh&#x1CE;oq&#xEC;</pr></trd>,
    <trd>&#30002;&#x70F7; <pr>ji&#x1CE;w&#xE1;n</pr></trd>
  </trdgrp>
</drv>
</art>
