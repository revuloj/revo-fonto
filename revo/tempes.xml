    <trd>tempestad</trd>
  </trdgrp>
  <trd lng="fr">temp&ecirc;te</trd>
  <trd lng="hu">vihar</trd>
  <trd lng="id">badai</trd>
  <trd lng="it">temporale</trd>
  <trdgrp lng="ja">
    <trd>&#x66B4;&#x98A8;&#x96E8;  <pr>&#x307C;&#12358;&#12405;&#12358;&#12358;</pr></trd>,
    <trd>&#x66B4;&#x98A8;  <pr>&#x307C;&#12358;&#12405;&#12358;</pr></trd>
