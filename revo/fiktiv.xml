<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: fiktiv.xml,v 1.24 2026/09/21 12:44:11 revo Exp $">
<kap>
  <ofc>1</ofc>
  <rad>fiktiv</rad>/a
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="fiktiv.0a">
  <kap><tld/>a</kap>
  <snc mrk="fiktiv.0a.falsa">
    <dif>
      Nereala, &scirc;ajna, trompa, malvera, neekzitanta:
      <ekz>
        En la listo estas multe da <tld/>aj membroj
        <fnt><bib>VdE</bib></fnt>;
      </ekz><ekz>
        <tld/>aj kontoj de bilanco
        <fnt><bib>VdE</bib></fnt>;
      </ekz><ekz>
        Mi ja skribis tute alian nomon de la forsendinto kaj <tld/>an adreson
        <fnt>
          <aut>Zde&ncaron;ek JIROTKA, tr. Josef CHVOSTA</aut>:
          <vrk>La reguloj &scirc;an&gcirc;i&gcirc;is</vrk>
          <lok>la nica literatura revuo 6/2 (n-ro 32).</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="fiktiv.0a.kvazauxa">
    <dif>
      Nereala, kvaza&ubreve;a, konvencia, supozita:
      <ekz>
        <tld lit="F"/>a estas la supozita komparo, se &gcirc;i esprimas troigon,
        neebla&jcirc;on, a&ubreve; ion evidente ne-faktan: li staris konsternite,
        kvaza&ubreve; la &ccirc;ielo estus falinta sur lin
        <fnt><bib>PAG</bib></fnt>;
      </ekz><ekz>
        konsideri la judojn kiel realan nacion, ne <tld/>an
        <fnt>
          <aut>Josef MEISL, tr. N.Z. MAIMON</aut>: <vrk>Hilelismo</vrk>
          <lok>la nica literatura revuo n-ro 5/4</lok>
        </fnt>;
      </ekz><ekz>
        la <tld/>a rekto, kunliganta la Sunon kaj la Teron, kiuj
        samrapide kuras sur sia orbito
        <fnt>
          <aut>Rejt&odblac; Jen&odblac;, tr. L&aacute;szl&oacute; BAL&Aacute;ZS</aut>:
          <vrk><url
 ref="http://royallib.ru/book/Rejt_Jen/Fred_la_Malpura_intervenas.html"
 >Fred la malpura intervenas</url></vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="fiktiv.0a.fikcia">
    <dif>
      <ref tip="dif" cel="fikci.0a">Fikcia</ref>:
      <ekz>
        ekzistas &ccirc;irka&ubreve; ducent dek verkoj de li,
        kiuj, kvankam la plejmulto estas <tld/>aj,
        ka&ubreve;zis tre viveman impreson
        <fnt>
          <aut>D. Defo, trad. A. Krafft</aut>,
          <vrk><url ref="&Gutenberg;files/11511/11511-0.txt">
          Robinsono Kruso</url></vrk>,
          <lok>1908</lok>
        </fnt>;
      </ekz><ekz>
        <tld/>aj poemoj de reala Lojko <klr>[&#8230;]</klr> permesas pli profunde eksenti la
        odoron de tiu epoko
        <fnt>
          <bib>Monato</bib>
          <aut>Nikolao Gudskov</aut>
          <vrk><url ref="&Monato;/2004/008392.html">Reveno de heroo</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_f;&c_ib;&c_k;&c_t;&c_y;&c_w;&c_n;&c_y;</trd>
  <trd lng="ca">fictici</trd>
  <trdgrp lng="cs">
    <trd>fiktivn&iacute;</trd>,
    <trd>imagin&aacute;rn&iacute;</trd>
  </trdgrp>
  <trdgrp lng="de">
   <trd>fiktiv</trd>,
   <trd>ausgedacht</trd></trdgrp>
  <trd lng="en">fictitious</trd>
  <trd lng="es">ficticio</trd>
  <trdgrp lng="fr">
    <trd>fictif</trd>,
    <trd>fictionnel</trd>
  </trdgrp>
  <trdgrp lng="hu">
     <trd>fikt&iacute;v</trd>,
     <trd>kital&aacute;lt</trd>
   </trdgrp>
  <trd lng="nl">fictief</trd>
  <trdgrp lng="pl">
    <trd>zmy&sacute;lony</trd>,
    <trd>fikcyjny</trd>,
    <trd>urojony</trd>
  </trdgrp>
  <trd lng="pt">fict&iacute;cio</trd>
  <trd lng="ru">&c_f;&c_i;&c_k;&c_t;&c_i;&c_v;&c_n;&c_y;&c_j;</trd>
  <trd lng="sk">neskuto&ccaron;n&yacute;</trd>
  <trdgrp lng="uk">
    <trd>&c_f;&c_ib;&#x43A;&c_t;&c_i;&c_v;&#x43D;&c_i;&c_j;</trd>,
    <trd>&#x43C;&#x43D;&c_i;&#x43C;&c_i;&c_j;</trd>,
    <trd>&c_u;&#x44F;&c_v;&#x43D;&c_i;&c_j;</trd>,
    <trd>&c_v;&c_i;&c_g;&c_a;&c_d;&c_a;&#x43D;&c_i;&c_j;</trd>
  </trdgrp>
  <trd lng="zh">&#x865A;&#26500; <pr>x&#x16B;g&#xF2;u</pr></trd>
</drv>
</art>
