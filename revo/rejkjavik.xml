<vortaro>
  <art mrk="$Id: rejkjavik.xml,v 1.11 2026/10/26 14:00:22 afido Exp $">
    <kap><ofc>10</ofc>
      <rad>Rejkjavik</rad>/o
    </kap>

<drv mrk="rejkjavik.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      La <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&ccirc;efurbo</ref>
      de <ref tip="malprt" cel="island.I0o">Islando</ref>  situo:  (<frm>64&#730;08&minute;N
      21&#730;56&minute;W</frm>):
      <ekz>
        en <tld/>o ni renkontis norvegan esperantiston, kiu plendis, ke islandanoj
        konstante respondas angle, kiam li alparolas ilin en la nova norvega, kiu
        estas speco de simpligita islanda
        <fnt>

          <aut>Garvan Makaj'</aut>
          <vrk><url ref="&Monato;/2015/011315.php">La islanda: revo de ne plu juna
          lernemulo</url></vrk>
          <bib>Monato</bib>
          <lok>2015</lok>
        </fnt>;
      </ekz>
      <ekz>
        la 98-a UK en <tld/>o
        <fnt>
          <vrk><url ref="https://www.youtube.com/watch?v=tm-JLxHZP6Y">98-a UK en Rejkjaviko: la nova
          Estraro sin prezentas</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iuj domoj en <tld/>o estas varmigataj per elsubtera varma akvo anka&ubreve; en la
        somero
        <fnt>
          <vrk><url ref="&CRI;98uk/rejkjaviko.pdf">98-a Universala Kongreso de Esperanto</url></vrk>
          <lok>dua bulteno</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_R;&c_e;&c_j;&c_k;&#8217;&c_ja;&c_v;&c_ib;&c_k;</trd>
    <trd lng="de">Reykjav&iacute;k</trd>
    <trd lng="en">Reykjav&iacute;k</trd>
    <trd lng="fr">Reykjavik</trd>
    <trd lng="nl">Reykjavik</trd>
    <trd lng="pl">Reykjavik</trd>
    <trd lng="ro">Reykjav&iacute;k</trd>
    <trd lng="uk">&c_R;&c_je;&c_j;&c_k;&#8217;&c_ja;&c_v;&c_ib;&c_k; (&c_s;&c_t;&c_o;&c_l;&c_i;&c_c;&c_ja;)</trd>
  </snc>
  <trd lng="ca">Reykjav&iacute;k</trd>
  <trd lng="cv">&c_R;&c_je;&c_j;&c_k;&c_mol;&c_ja;&c_v;&c_i;&c_k;</trd>
  <trd lng="ja">&#12524;&#12452;&#12461;&#12515;&#12499;&#12463;</trd>
  <trd lng="oc">Reykjav&iacute;k</trd>
  <trdgrp lng="zh">
    <trd>&#38647;&#20811;&#38597;&#26410;&#20811;
    <pr>L&eacute;ik&egrave;y&#462;w&egrave;ik&egrave;</pr></trd>,
    <trd>&#38647;&#20811;&#38597;&#32173;&#20811;
    <pr>L&eacute;ik&egrave;y&#462;w&eacute;ik&egrave;</pr></trd>,
    <trd>&#38647;&#20811;&#38597;&#32500;&#20811;
    <pr>L&eacute;ik&egrave;y&#462;w&eacute;ik&egrave;</pr></trd>
  </trdgrp>
</drv>

