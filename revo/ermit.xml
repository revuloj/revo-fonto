<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: ermit.xml,v 1.31 2026/10/04 16:00:19 revo Exp $">
<kap>
  <ofc>*</ofc>
  <rad>ermit</rad>/o
<fnt><bib>UV</bib></fnt></kap>
<drv mrk="ermit.0o">
  <kap>
    <ofc>*</ofc><tld/>o
  </kap>
  <snc mrk="ermit.0o.REL">
    <uzo tip="fak">REL</uzo>
    <dif>
      Piulo vivanta en soleco:
      <ekz>
        li iris al <tld/>o, kiu estis konata kiel piulo
        <fnt>
          <bib>ElektFab</bib>
          <lok>Kamarado Gaja</lok>
        </fnt>;
      </ekz>
      <ekz>
        li iom post iom aparti&gcirc;is de &ccirc;iuj homoj kaj fari&gcirc;is <tld/>o
        <fnt>
          <bib>Fab4</bib>
          <lok>Turgardisto Ole</lok>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;u li estas princo, kavaliro, profeto, a&ubreve; eble simpla <tld/>o
        <fnt>
          <bib>Far2</bib>
          <lok>&Ccirc;apitro XXIII</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="be">&c_p;&c_u;&c_s;&c_t;&c_e;&c_l;&c_mol;&c_n;&c_ib;&c_k;</trd>
    <trdgrp lng="ca">
      <trd>ermit&agrave;</trd>,
      <trd>eremita</trd>,
      <trd>anacoreta</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Eremit</trd>,
      <trd>Klausner</trd>,
      <trd>Einsiedler</trd>
    </trdgrp>
    <trdgrp lng="fr">
      <trd>anachor&egrave;te</trd>
    </trdgrp>
    <trdgrp lng="id">
      <trd>eremit</trd>,
      <trd><baz>tapa</baz>petapa</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>eremita</trd>,
      <trd>pustelnik</trd>
    </trdgrp>
    <trdgrp lng="pt">
      <trd>eremita</trd>,
      <trd>ermit&atilde;o</trd>,
      <trd>anacoreta</trd>
    </trdgrp>
    <trd lng="ru">&c_o;&c_t;&c_sh;&c_je;&c_l;&c_mol;&c_n;&c_i;&c_k;</trd>
    <trdgrp lng="zh">
    <trd>&#23665;&#20154; <pr>sh&amacron;nr&eacute;n</pr></trd>,
    <trd>&#38544;&#23621;&#32773; <pr>y&#464;nj&#363;zh&ecaron;</pr></trd>,
    <trd>&#38544;&#22763; <pr>y&#464;nsh&igrave;</pr></trd>,
    <trd>&#34892;&#32773; <pr>x&iacute;ngzh&ecaron;</pr></trd>
  </trdgrp>
</snc>
  <snc mrk="ermit.0o.FIG">
    <uzo tip="stl">FIG</uzo>
    <dif>
      Homo, kiu sisteme evitas la aliajn, kaj izole vivas:
      <ekz>
        ili surteri&gcirc;is anta&ubreve; la kavernlo&gcirc;ejo de la ge<tld/>oj
        <fnt>
          <aut>Michael Ende, trad. Wolfram Diestel</aut>
          <vrk>La Sen&ccirc;esa Rakonto</vrk>
          <lok>La Vo&ccirc;o de la Kvieto</lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="be">
      <trd>&c_s;&c_a;&c_m;&c_o;&c_t;&c_n;&c_ib;&c_k;</trd>,
      <trd>&c_a;&c_d;&c_z;&c_ib;&c_n;&c_o;&c_t;&c_n;&c_ib;&c_k;</trd>
    </trdgrp>
    <trdgrp lng="ca">
      <trd>ermit&agrave;</trd>,
      <trd>solitari</trd>
    </trdgrp>
    <trdgrp lng="de">
      <trd>Einsiedler</trd>,
      <trd>Einzelg&auml;nger</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>samotnik</trd>,
      <trd>pustelnik</trd>
    </trdgrp>
    <trdgrp lng="zh">
    <trd>&#29420;&#34892;&#20384; <pr>d&uacute;x&iacute;ngxi&aacute;</pr></trd>,
    <trd>&#23396;&#29420;&#30340;&#20154; <pr>g&#363;d&uacute;der&eacute;n</pr></trd>
  </trdgrp>
</snc>
  <trd lng="bo">&#3942;&#3986;&#3964;&#3928;&#3851;&#3910;&#3962;&#3923;&#3851;</trd>
  <trd lng="en">hermit</trd>
  <trdgrp lng="es">
    <trd>ermita&ntilde;o</trd>,
    <trd>anacoreta</trd>
  </trdgrp>
  <trdgrp lng="fr">
    <trd>ermite</trd>,
    <trd>solitaire<klr tip="ind"> (subst.)</klr></trd>
  </trdgrp>
  <trd lng="hu">remete</trd>
  <trdgrp lng="ja">
    <trd>&#38560;&#32773;  <pr>&#12356;&#12435;&#12376;&#12419;</pr></trd>,
    <trd>&#38560;&#20462;&#22763;  <pr>&#12363;&#12367;&#12375;&#12421;&#12358;&#12375;</pr></trd>,
    <trd>&#19990;&#25448;&#12390;&#20154;  <pr>&#12424;&#12377;&#12390;&#12403;&#12392;</pr></trd>
  </trdgrp>
  <trdgrp lng="nl">
    <trd>eremiet</trd>,
    <trd>heremiet</trd>,
    <trd>kluizenaar</trd>
  </trdgrp>
  <trdgrp lng="pt">
    <trd>eremita</trd>,
    <trd>ermit&atilde;o</trd>,
    <trd>solit&aacute;rio</trd>
  </trdgrp>
  <trdgrp lng="ru">
    <trd>&c_o;&c_t;&c_sh;&c_je;&c_l;&c_mol;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_z;&c_a;&c_t;&c_v;&c_o;&c_r;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_a;&c_n;&c_a;&c_h;&c_o;&c_r;&c_je;&c_t;</trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_p;&c_u;&c_s;&c_t;&c_je;&c_l;&c_mol;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_s;&c_a;&c_m;&c_ib;&c_t;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_s;&c_a;&c_m;&c_ib;&c_t;&c_n;&c_i;&c_k;</trd>,
    <trd>&c_v;&c_ib;&c_d;&c_l;&c_ju;&c_d;&c_n;&c_i;&c_k;</trd>
  </trdgrp>
</drv>

<drv mrk="ermit.0ejo">
  <kap>
    <tld/>ejo
  </kap>
  <snc>
    <dif>
      Loko, kie vivas unu a&ubreve; pluraj <tld/>oj:
      <ekz>
        <tld/>ejon kun la necesaj vivrimedoj oni en granda urbo povas trovi nur sur la pre&gcirc;eja turo
        <fnt>
          <bib>Fab4</bib>
          <lok>Turgardisto Ole</lok>
        </fnt>;
      </ekz>
      <ekz>
        la Davidova <tld/>ejo estas mona&hcirc;ejo apud Moskvo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=53122">Davidova ermitejo</url></lok>
        </fnt>.
      </ekz>
    </dif>
    <trdgrp lng="de">
      <trd>Eremitage</trd>,
      <trd>Klause</trd>,
      <trd>Einsiedelei</trd>
    </trdgrp>
    <trd lng="en">hermitage</trd>
    <trd lng="es">ermita</trd>
    <trd lng="fr">ermitage</trd>
    <trd lng="hu">remetelak</trd>
    <trdgrp lng="nl">
      <trd>kluizenaarswoning</trd>,
      <trd>ermitage</trd>,
      <trd>hermitage</trd>
    </trdgrp>
    <trdgrp lng="pl">
      <trd>pustelnia</trd>,
      <trd>ustronie</trd>
    </trdgrp>
    <trdgrp lng="pt">
      <trd>eremit&eacute;rio</trd>,
      <trd>ermit&eacute;rio</trd>,
      <trd>ermit&aacute;gio</trd>
    </trdgrp>
    <trdgrp lng="ru">
      <trd>&c_m;&c_je;&c_s;&c_t;&c_o;
      &c_u;&c_je;&c_d;&c_i;&c_n;&c_je;&c_n;&c_i;&c_ja;</trd>;
      <trd>&c_s;&c_k;&c_i;&c_t;</trd>,
      <trd>&c_p;&c_u;&c_s;&c_t;&c_y;&c_n;&c_mol;</trd>
    </trdgrp>
  </snc>
  <trdgrp lng="be">
    <trd>&c_a;&c_d;&c_a;&c_s;&c_o;&c_b;&c_l;&c_je;&c_n;&c_a;&c_je;
    <ind>&c_m;&c_je;&c_s;&c_c;&c_a;</ind></trd>,
    <trd>&c_m;&c_je;&c_s;&c_c;&c_a; &c_s;&c_a;&c_m;&c_o;&c_t;&c_y;</trd>,
    <trd>&c_p;&c_u;&c_s;&c_t;&c_e;&c_ch;&c_a;</trd>,
    <trd>&c_s;&c_k;&c_ib;&c_t;</trd>
  </trdgrp>
  <trd lng="ca">ermita</trd>
  <trd lng="he">&mem;&nun;&zayin;&resh;</trd>
  <trd lng="id"><baz>tapa</baz>pertapaan</trd>
  <trdgrp lng="ja">
    <trd>&#38560;&#32773;&#12398;&#20303;&#12414;&#12356;  <pr>&#12363;&#12367;&#12375;&#12419;&#12398;&#12377;&#12414;&#12356;</pr></trd>,
    <trd>&#38560;&#12428;&#23478;  <pr>&#12363;&#12367;&#12428;&#12364;</pr></trd>,
    <trd>&#24245;  <pr>&#12356;&#12362;&#12426;</pr></trd>
  </trdgrp>
  <trdgrp lng="uk">
    <trd>&c_m;&c_ib;&c_s;&c_c;&c_je; &c_u;&c_s;&c_a;&c_m;&c_ib;&c_t;&c_n;&c_je;&c_n;&c_n;&c_ja;</trd>,
    <trd>&c_s;&c_k;&c_i;&c_t;</trd>,
    <trd>&c_p;&c_u;&c_s;&c_t;&c_i;&c_n;&c_mol;</trd>
  </trdgrp>
</drv>

<drv mrk="ermit.0ludo">
  <kap>
    <tld/>ludo <fnt> <bib>PIV1</bib></fnt>
  </kap>
  <uzo tip="fak">SPO</uzo>
  <snc>
    <dif>
      <ref tip="super" cel="kart.0ludo">Kartludo</ref>, ludata ordinare sola:
      <ekz>
        en matematiko kaj ludoteorio, bulgara <tld/>ludo estas hazarda kartludo
        <fnt>
          <bib>Viki</bib>
          <lok><url ref="https://eo.wikipedia.org/?curid=257985">Bulgara ermitludo</url></lok>
        </fnt>;
      </ekz>
    </dif>
    <trd lng="be">&c_p;&c_a;&c_s;&c_mol;&c_ja;&c_n;&c_s;</trd>
    <trd lng="de">Patience</trd>
    <trd lng="en">solitaire</trd>
    <trd lng="es">solitario</trd>
    <trd lng="fr">solitaire<klr tip="ind"> (jeu)</klr></trd>
    <trd lng="hu">paszi&aacute;nsz</trd>
    <trd lng="nl">patience</trd>
    <trd lng="pl">samotnik</trd>
    <trd lng="ru">&c_p;&c_a;&c_s;&c_mol;&c_ja;&c_n;&c_s;</trd>
  </snc>
  <trd lng="ca">solitari<klr tip="amb"> (joc)</klr></trd>
  <trd lng="id">Solitaire<klr tip="amb"> (permainan)</klr></trd>
  <trdgrp lng="ja">
    <trd>&#12477;&#12522;&#12486;&#12451;&#12450;</trd>,
    <trd>&#12477;&#12522;&#12486;&#12540;&#12523;</trd>
  </trdgrp>
  <trd lng="uk">&c_p;&c_a;&c_s;&c_mol;&c_ja;&c_n;&c_s;</trd>
</drv>
</art>
