<?xml version="1.0"?>
<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
<art mrk="$Id: cedrat.xml,v 1.23 2026/08/04 03:53:15 revo Exp $">
<kap>
<rad>cedrat</rad>/o
<fnt><bib>PVEF</bib></fnt></kap>
<drv mrk="cedrat.0o">
  <kap><tld/>o
  <fnt><bib>Viki</bib>, <lok><url ref="&Viki;/cedrato">cedrato</url></lok></fnt></kap>
  <snc>
   <uzo tip="fak">BOT</uzo>
    <dif>
      Frukto de <tld/>ujo:
      <ekz>
	kandita <tld/>&scirc;elo;
      </ekz>
      <ekz>
        <klr>[oni]</klr> prezentis al ili plurajn specojn da &scirc;orbetoj, <klr>[&#x2026;]</klr>
        punktitajn per &scirc;eloj de konfitita <tld/>o
        <fnt>
          <bib>Kandid</bib>
          <lok>&Ccirc;apitro XXX</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_c;&c_e;&c_d;&c_r;&c_a;&c_t;
    <klr tip="amb">(&c_p;&c_l;&c_o;&c_d;)</klr></trd>
  <trdgrp lng="ca">
    <trd>cedrat</trd>,
    <trd>poncem</trd>
  </trdgrp>
  <trd lng="cs">cedr&aacute;t plod</trd>
  <trdgrp lng="de">
    <trd>Zitronatzitrone</trd>,
    <trd>Zedratzitrone</trd>
  </trdgrp>
  <trd lng="el">&kappa;&jota_ton;&tau;&rho;&omikron;</trd>
  <trd lng="fr">c&eacute;drat</trd>
  <trdgrp lng="hu">
    <trd>keser&udblac; <ind>citrom</ind></trd>,
    <trd>citron&aacute;t</trd>,
    <trd>cedr&aacute;t</trd></trdgrp>
  <trdgrp lng="it">
    <trd>cedro<klr> (agrume)</klr></trd>,
    <trd>citro</trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30B7;&#x30C8;&#x30ED;&#x30F3;</trd>,
    <trd>&#x30D6;&#x30B7;&#x30E5;&#x30AB;&#x30F3;</trd>
  </trdgrp>
  <trd lng="pl">cedrat</trd>
  <trd lng="pt">cidra</trd>
  <trd lng="ru">&c_c;&c_je;&c_d;&c_r;&c_a;&c_t;</trd>
  <trd lng="sk">cedr&aacute;tov&eacute; ovocie</trd>
  <trdgrp lng="sv">
    <trd>suckatcitron</trd>,
    <trd>cedrat</trd>,
    <trd>s&ouml;tcitron</trd>
  </trdgrp>
  <trd lng="uk">&c_c;&c_je;&c_d;&c_r;&c_a;&c_t;</trd>
</drv>

<drv mrk="cedrat.0ujo">
  <kap><tld/>ujo,
  <var><kap><tld/>arbo</kap></var>
  <fnt><bib>Viki</bib>, <lok><url ref="&Viki;/cedrato">cedrato</url></lok></fnt></kap>
  <snc mrk="cedrat.0ujo.BOT">
   <uzo tip="fak">BOT</uzo>
    <dif>
      Specio de <ref tip="super" cel="citrus.0o">citruso</ref>
      (<trd lng="la">Citrus medica</trd>).
    </dif>
    <bld
      lok="&WCU;/thumb/e/ef/Chinesische_Zedrat_Zitrone.jpg/330px-Chinesische_Zedrat_Zitrone.jpg"
      prm="CC BY-SA 3.0"
      >bran&ccirc;o kun floroj kaj fruktoj de &Ccirc;ina <tld/>ujo
        <fnt>
          <aut>Foto: Johann Werfring, http://wienwiki.wienerzeitung.at/WIENWIKI/index.php/Datei:Chinesische_Zedrat_Zitrone.jpg</aut>
          <lok><url ref="&WCW;/File:Chinesische_Zedrat_Zitrone.jpg"
              >https://commons.wikimedia.org/wiki/File:Chinesische_Zedrat_Zitrone.jpg</url></lok>
        </fnt>
    </bld>
  </snc>
  <trd lng="be">&c_c;&c_e;&c_d;&c_r;&c_a;&c_t;
    <klr tip="amb">(&c_d;&c_r;&c_e;&c_v;&c_a;)</klr></trd>
  <trdgrp lng="ca">
    <trd>cedrater</trd>,
    <trd>poncemer</trd>
  </trdgrp>
  <trdgrp lng="cs">
    <trd>cedr&aacute;t</trd>,
    <trd>citron&iacute;k l&eacute;&ccaron;iv&yacute;</trd>
  </trdgrp>
  <trd lng="de">Zedratbaum</trd>
  <trd lng="el">&kappa;&jota;&tau;&rho;&jota;&alfa_ton;</trd>
  <trd lng="fr">c&eacute;dratier</trd>
  <trdgrp lng="hu">
    <trd>keser&udblac; <ind>citromfa</ind></trd>,
    <trd>citron&aacute;tfa</trd>,
    <trd>cedr&aacute;tfa</trd></trdgrp>
  <trdgrp lng="it">
    <trd>cedro<klr> (albero dell'agrume)</klr></trd>,
    <trd>citro<klr> (albero)</klr></trd>
  </trdgrp>
  <trdgrp lng="ja">
    <trd>&#x30B7;&#x30C8;&#x30ED;&#x30F3;</trd>,
    <trd>&#x30D6;&#x30B7;&#x30E5;&#x30AB;&#x30F3;</trd>
  </trdgrp>
  <trd lng="pl">cedrat</trd>
  <trd lng="pt">cidreira</trd>
  <trd lng="sk">cedr&aacute;t</trd>
  <trd lng="sv">cedrattr&auml;d</trd>
</drv>
</art>

