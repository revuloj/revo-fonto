<!DOCTYPE vortaro SYSTEM "../dtd/vokoxml.dtd">
<vortaro>
  <art mrk="$Id: helsink.xml,v 1.12 2026/10/26 14:00:22 afido Exp $">
    <kap><ofc>10</ofc>
      <rad>Helsink</rad>/o
    </kap>

<drv mrk="helsink.0o">
  <kap><tld/>o</kap>
  <uzo tip="fak">GEOG</uzo><uzo tip="fak">POL</uzo>
  <snc>
    <dif>
      La <ref tip="lst" lst="voko:&ccirc;efurboj" cel="urb.cxef0o.POL">&ccirc;efurbo</ref>
      de <ref tip="malprt" cel="finn.F0lando">Finnlando</ref>:
      situo:  (<frm>60&#730;10&minute; N  24&#730;56&minute; E</frm>):
      <ekz>
        <nom>Halonen</nom> estas ne nur la unua ina prezidanto de Finnlando,
        sed anka&ubreve; la unua, kiu naski&gcirc;is en la &ccirc;efurbo <tld/>o
        <fnt>
       <aut>JSL</aut>
          <vrk><url ref="&Monato;/2000/006901.php">Novtipa prezidanto</url></vrk>
          <bib>Monato</bib>
          <lok>2000/04, p. 9</lok>
        </fnt>;
      </ekz>
      <ekz>
        Berlino pasintjare e&ccirc; bojkotis EU-konferencojn sub prezidado de Finnlando, &ccirc;ar
        <tld/>o rifuzis disponigi interpretistojn por la germana lingvo
        <fnt>
          <aut>Stefan Maul</aut>
            <vrk><url ref="&Monato;/2000/007185.html">Lingvopakto</url></vrk>
            <bib>Monato</bib>
            <lok>2000/12, p. 7</lok>
          </fnt>;
      </ekz>
      <ekz>
        la venonta ASEM-pintokonferenco okazos en 2006 en la finna &ccirc;efurbo <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Marko Naoki Lins</aut>
          <vrk><url ref="&Monato;/2004/008465.html">&Ccirc;u e&ubreve;rop-azia bloko kontra&ubreve;
          Usono?</url></vrk>
          <lok>2004</lok>
        </fnt>.
      </ekz>
    </dif>
    <trd lng="de">Helsinki</trd>
    <trd lng="en">Helsinki</trd>
    <trd lng="fr">Helsinki</trd>
    <trd lng="nl">Helsinki</trd>
    <trd lng="pl">Helsinki</trd>
  </snc>
  <trdgrp lng="be">
    <trd>&c_H;&c_e;&c_l;&c_mol;&c_s;&c_y;&c_n;&c_k;&c_ib;</trd>,
    <trd>&c_G;&c_e;&c_l;&c_mol;&c_s;&c_y;&c_n;&c_k;&c_ib;</trd>
  </trdgrp>
  <trd lng="ca">H&egrave;lsinki</trd>
  <trd lng="cv">&c_H;&c_je;&c_l;&c_mol;&c_s;&c_i;&c_n;&c_k;&c_i;</trd>
  <trd lng="ja">&#12504;&#12523;&#12471;&#12531;&#12461;</trd>
  <trd lng="oc">Helsinki</trd>
  <trd lng="uk">&c_G;&c_je;&c_l;&c_mol;&c_s;&c_ib;&c_n;&c_k;&c_ib;</trd>
  <trdgrp lng="zh">
    <trd>&#36203;&#23572;&#36763;&#22522; <pr>h&egrave;&ecaron;rx&#299;nj&#299;</pr></trd>,
    <trd>&#36203;&#23572;&#36763;&#22522; <pr>H&egrave;&ecaron;rx&#299;nj&#299;</pr></trd>
  </trdgrp>
</drv>
</art>

