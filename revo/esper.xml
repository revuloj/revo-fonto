<drv mrk="esper.0o">
  <kap><tld/>o</kap>
  <snc mrk="esper.0o.ado">
    <dif>
      Ago <tld/>i:
      <ekz>
        meti sian <tld/>on sur la Eternulo
        <fnt><bib>MT</bib>, <lok>&Psa; 40:4</lok></fnt>;
      </ekz>
      <ekz>
        mi havas ankora&ubreve; <tld/>on
        <fnt>
          <bib>MT</bib>
          <lok>Rut 1:12</lok>
        </fnt>;
      </ekz>
      <ekz>
        mi perdis la <tld/>on
        <fnt><bib>MT</bib>, <lok>&Jes; 57:10</lok></fnt>;
      </ekz>
      <ekz>
        <tld/>o logas, <tld/>o mensogas
        <fnt><bib>PrV</bib></fnt>;
      </ekz>
      <ekz>
        de atendo kaj <tld/>o pereis multaj sur la tero
        <fnt>
          <bib>PrV</bib>
        </fnt>;
      </ekz>
      <ekz>
        <tld/>o panon ne donas
        <fnt><bib>PrV</bib></fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="esper.0o.sento">
    <dif>
      Io, kion oni esperas:
      <ekz>
        mi ne povas doni al vi e&ccirc; la plej malgrandan <tld/>on ricevi lokon kune kun la
        infano
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        li multe parolis <klr>[&#8230;]</klr> pri detruitaj <tld/>oj
        <fnt>
          <bib>Rabistoj</bib>
          <lok>Akto Dua</lok>
        </fnt>;
      </ekz>
      <ekz>
        montri <klr>[&#8230;]</klr> sian plej vivan simpation <klr>[&#8230;]</klr> al via celo kaj
        <tld/>oj
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Kvina Kongreso Esperantista en Barcelona en la 6a de septembro
          1909</vrk>
        </fnt>;
      </ekz>
      <ekz>
        ni havas plenan <tld/>on, ke post nia nuna kongreso <klr>[&#8230;]</klr> nia afero &ccirc;i
        tie ekfloros ne malpli potence
        <fnt>
          <bib>Paroloj</bib>
          <vrk>Parolado anta&ubreve; la Kvara Kongreso Esperantista en Dresden en la 17a de a&ubreve;gusto
          1908</vrk>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="esper.0o.priesperajxo">
    <dif>
      Persono a&ubreve; afero, pri kiu oni multe <tld/>as:
      <ekz>
        la sola filo, la <ref cel="gxoj.0o.kauxzo">&gcirc;ojo</ref>
        de la gepatroj kaj ilia <tld/>o por la estonteco
        <fnt>
          <bib>Fab4</bib>
          <lok>Infano en la tombo</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
    <trd>&c_n;&c_a;&c_d;&c_z;&c_je;&c_ja;</trd>,
    <trd>&c_s;&c_p;&c_a;&c_d;&c_z;&c_ja;&c_v;&c_a;&c_n;&c_mol;&c_n;&c_je;</trd>
