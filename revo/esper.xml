<drv mrk="esper.0iga">
  <kap><tld/>iga</kap>
  <snc mrk="esper.0iga.KOMUNE">
    <dif>
      Donanta <tld/>ojn, promesplena, bona&ubreve;gura:
      <ekz>
        <klr>[&scirc;iaj]</klr> okuloj <klr>[&#8230;]</klr> anta&ubreve; momento esprimis <tld/>igan
        meditadon
        <fnt>
          <bib>Marta</bib>
        </fnt>;
      </ekz>
      <ekz>
        komence de januaro okazis <tld/>iga evento
        <fnt>
       <aut>Zofia Banet-Fornalowa/pg</aut>
          <vrk><url ref="&Monato;/2000/006882.php">Kiam orkestro fari&gcirc;as orkesto</url></vrk>
          <bib>Monato</bib>
          <lok>2000/05, p. 12</lok>
        </fnt>.
      </ekz>
      <ekz>
        libera programaro estas nova kaj <tld/>iga fenomeno
        <fnt>
          <aut>D. E. Rogers</aut>
          <vrk><url ref="&Monato;/2004/008269.html">Libera programaro: nova rimedo
          komerci</url></vrk>
          <bib>Monato</bib>
          <lok>2004/04, p. 12</lok>
        </fnt>;
      </ekz>
      <ekz>
