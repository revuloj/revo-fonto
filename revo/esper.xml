<drv mrk="esper.sen0a">
  <kap>sen<tld/>a</kap>
  <snc mrk="esper.sen0a.PSI">
    <dif>
      <klr>(iu)</klr> Kiu ne a&ubreve; ne plu <tld/>as, aflikti&gcirc;as:
      <ekz>
        li &gcirc;emis simile al sen<tld/>a animo
        <fnt>
          <bib>Fab4</bib>
          <lok>La vento rakontas pri Valdemaro Doe kaj pri liaj filinoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        tremanta de frosto la kompatinda knabineto trenadis sin <klr>[&#8230;]</klr> jam tute
        sen<tld/>a
        <fnt>
          <bib>Fab2</bib>
          <lok>Knabineto kun alumetoj</lok>
        </fnt>;
      </ekz>
      <ekz>
        la sen<tld/>aj fratinoj ser&ccirc;is lin en la tuta urbo
        <fnt>
          <aut>A. Niemojewski, trad. Kabe</aut>,
          <vrk>En Kvieta Vespero</vrk>,
          <lok>Internacia Krestomatio</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <snc mrk="esper.sen0a.objektive">
    <dif>
      <klr>(io)</klr> Sen<tld/>iga, kiu ne havas &scirc;ancojn de sukceso;
      <ref tip="vid" cel="perspe.sen0a.FIG">senperspektiva</ref>:
      <ekz>
        sen<tld/>a ser&ccirc;ado
        <fnt>
          <aut>Zofia Banet-Fornalowa</aut>
          <vrk><url ref="&Monato;/2003/008093.html">Li semis bonon kaj
          belon</url></vrk>
          <bib>Monato</bib>
          <lok>2003/09, p. 18</lok>
        </fnt>;
      </ekz>
      <ekz>
        sen<tld/>a utopia&jcirc;o
        <fnt>
          <aut>Garbhan MacAoidh</aut>
          <vrk><url ref="&Monato;/2004/008394.html">La angla, &ccirc;u troja
          &ccirc;evalo?</url></vrk>
          <bib>Monato</bib>
          <lok>2004/10, p. 20</lok>
        </fnt>;
      </ekz>
      <ekz>
        estas afero sen<tld/>a, kion mi povas fari?
        <fnt><aut>S. Engholm</aut>,
        <vrk>Vivo vokas</vrk>,
        <lok>1946</lok></fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_b;&c_je;&c_z;&c_n;&c_a;&c_d;&c_z;&c_je;&c_j;&c_n;&c_y;</trd>
  <trd lng="ca">desesperat</trd>
  <trd lng="cs">beznad&ecaron;jn&yacute;</trd>
  <trd lng="de">hoffnungslos</trd>
  <trd lng="fr">d&eacute;sesp&eacute;r&eacute;<klr> (adj.)</klr></trd>
  <trd lng="id">putus asa</trd>
  <trdgrp lng="pl">
    <trd>beznadziejny</trd>,
    <trd>zrozpaczony</trd>
  </trdgrp>
  <trd lng="sk">bezn&aacute;dejn&yacute;</trd>
  <trdgrp lng="zh">
    <trd>&#26080;&#26395; <klr>(w&uacute; w&agrave;ng)</klr></trd>
    <trd>&#32477;&#26395; <klr>(ju&eacute; w&agrave;ng)</klr></trd>
  </trdgrp>
</drv>
