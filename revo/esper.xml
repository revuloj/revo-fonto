<drv mrk="esper.mal0o">
  <kap>mal<tld/>o</kap>
  <snc mrk="esper.mal0o.KOMUNE">
    <dif>
      La sento, la animstato de mal<tld/>anto:
      <ekz>
        mal<tld/>o min kaptas, kiam mi rigardas la
        malgrasi&gcirc;intan viza&gcirc;on de mia infano
        <fnt><bib>Marta</bib></fnt>;
      </ekz>
      <ekz>
        &scirc;i havis nenion, al kio &scirc;i povus alkro&ccirc;i&gcirc;i, kaj &scirc;i falis en senfundan abismon de
        mal<tld/>o
        <fnt>
          <bib>Fab4</bib>
          <lok>Infano en la tombo</lok>
        </fnt>;
      </ekz>
      <ekz>
        en la mal<tld/>o &scirc;i ku&scirc;i&gcirc;is, por eltrinki la lagon, kaj tio por homo estas ja ne
        ebla
        <fnt>
          <bib>Fab3</bib>
          <lok>Historio de unu patrino</lok>
        </fnt>;
      </ekz>
      <ekz>
        tute sola tie mi frenezi&gcirc;us de mal<tld/>o
        <fnt>
          <bib>IK</bib>
        </fnt>;
      </ekz>
      <ekz>
        krio de mal<tld/>o
        <fnt>
          <aut>Charles Dickens, tr. &Z;</aut>:
          <vrk>La batalo de l' vivo</vrk>. <lok>1891</lok>
        </fnt>;
      </ekz>
      <ekz>
        lacaj de la sendanka laborado, ni kun mal<tld/>o kaj apatio lasus fali la manojn
        <fnt>
          <bib>EE</bib>
        </fnt>;
      </ekz>
      <ekz>
        malanta&ubreve;e mizero, anta&ubreve;e mal<tld/>o
        <fnt>
          <bib>PrV</bib>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trdgrp lng="be">
