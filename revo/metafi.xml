<vortaro>
<art mrk="$Id: metafi.xml,v 1.27 2026/10/31 10:00:19 revo Exp $">
<kap>
   <ofc>1</ofc>
   <rad>metafizik</rad>/o
<fnt><bib>JED</bib></fnt></kap>
<drv mrk="metafi.0o">
   <kap>
     <tld/>o
   </kap>
   <snc>
     <dif>
       Parto de la <ref tip="malprt" cel="filozo1.0o.FIL">filozofio</ref>,
       kiu studas la unuajn <ref cel="kauxz.0o.FIL">ka&ubreve;zo</ref>jn kaj
       <ref cel="princi.0o.praelemento">principo</ref>jn de &ccirc;io, kiuj estas neesploreblaj
       per la metodoj de la pozitivaj sciencoj:
      <ekz>
        mi ne a&ubreve;dacas komenti liajn poemojn: mi estas homo malproksima de <tld/>o, kiu
        e&ccirc; nebone scias, kio estas tio
        <fnt>
          <bib>Monato</bib>
          <aut>Boris Kolker</aut>
          <vrk><url ref="&Monato;/2003/007812.html">Estas dan&gcirc;ere esti poeto</url></vrk>
        </fnt>;
      </ekz>
      <ekz>
        &ccirc;iu scienca pensado estas bazita sur la observado de simila&jcirc;oj kaj diferencoj
        <klr>[&#8230;]</klr>, anka&ubreve; <tld/>o devas trovi sian originon en tia hipotezo de
        analogioj
        <fnt>
          <bib>Monato</bib>
          <aut>Edward Kusters</aut>
          <vrk><url ref="&Monato;/2006/009100.php">Alfred Nobel: nobelo inter la sciencistoj kaj
          lingvistoj</url></vrk>
        </fnt>.
      </ekz>
     </dif>
  </snc>
  <trd lng="be">&c_m;&c_e;&c_t;&c_a;&c_f;&c_ib;&c_z;&c_y;&c_k;&c_a;</trd>
  <trd lng="ca">metaf&iacute;sica</trd>
  <trd lng="cv">&c_m;&c_je;&c_t;&c_a;&c_f;&c_i;&c_z;&c_i;&c_k;&c_a;</trd>
   <trd lng="de">Metaphysik</trd>
  <trd lng="en">metaphysics</trd>
  <trd lng="es">metaf&iacute;sica</trd>
  <trd lng="fr">m&eacute;taphysique</trd>
  <trd lng="hu">metafizika</trd>
  <trd lng="ja">&#24418;&#32780;&#19978;&#23398;  <pr>&#12369;&#12356;&#12376;&#12376;&#12423;&#12358;&#12364;&#12367;</pr></trd>
  <trd lng="nl">metafysica</trd>
  <trd lng="oc">metafisica</trd>
   <trd lng="pl">metafizyka</trd>
  <trd lng="pt">metaf&iacute;sica</trd>
  <trd lng="ru">&c_m;&c_je;&c_t;&c_a;&c_f;&c_i;&c_z;&c_i;&c_k;&c_a;</trd>
  <trd lng="sk">metafyzika</trd>
  <trd lng="uk">&c_m;&c_je;&c_t;&c_a;&c_f;&c_ib;&c_z;&c_i;&c_k;&c_a;</trd>
  <trdgrp lng="zh">
    <trd>&#24418;&#32780;&#19978;&#23398; <pr>x&iacute;ng&eacute;rsh&agrave;ngxu&eacute;</pr></trd>,
    <trd>&#24418;&#32780;&#19978;&#23416; <pr>x&iacute;ng&eacute;rsh&agrave;ngxu&eacute;</pr></trd>
  </trdgrp>
</drv>

<drv mrk="metafi.0a">
  <kap>
    <tld/>a
  </kap>
  <snc>
    <dif>
      Koncernanta <tld/>on; ne spertebla, ne perceptebla;
      <ref cel="natur.super0a">supernatura</ref>:
      <ekz>
        li kredeble ankora&ubreve; plu da&ubreve;rigus siajn metafizikajn konsideradojn, se &scirc;i ne
        rimarkus post li apud la pordo <klr>[&#8230;]</klr> sinjoro<klr>[n]</klr> en funebro
        <fnt>
          <bib>BdV</bib>
          <lok>La Batalo de l' Vivo</lok>
        </fnt>;
      </ekz>
      <ekz>
        oficiro, <klr>[&#8230;]</klr> kies edukiteco, tamen, ne transiris la limojn de lia
        profesio, estis fanfarone skeptika pri <tld/>aj aferoj
        <fnt>
          <bib>MrA</bib>
          <lok>&Ccirc;apitro IX</lok>
        </fnt>;
      </ekz>
      <ekz>
        matematika teoriado ankora&ubreve; estis parto de <tld/>aj studoj
        <fnt>
          <bib>Rsp</bib>
          <lok>Parto Sep</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_m;&c_e;&c_t;&c_a;&c_f;&c_ib;&c_z;&c_y;&c_ch;&c_n;&c_y;</trd>
  <trd lng="ca">metaf&iacute;sic</trd>
  <trd lng="de">metaphysisch</trd>
  <trd lng="en">metaphysical</trd>
  <trd lng="es">metaf&iacute;sico</trd>
  <trd lng="fr">m&eacute;taphysique</trd>
  <trdgrp lng="ja">
    <trd>&#24418;&#32780;&#19978;&#23398;&#12398;  <pr>&#12369;&#12356;&#12376;&#12376;&#12423;&#12358;&#12364;&#12367;&#12398;</pr></trd>,
    <trd>&#24418;&#32780;&#19978;&#12398;  <pr>&#12369;&#12356;&#12376;&#12376;&#12423;&#12358;&#12398;</pr></trd>,
    <trd>&#12365;&#12431;&#12417;&#12390;&#25277;&#35937;&#30340;&#12394; 
    <pr>&#12365;&#12431;&#12417;&#12390;&#12385;&#12421;&#12358;&#12375;&#12423;&#12358;&#12390;&#12365;&#12394;</pr></trd>
  </trdgrp>
  <trd lng="oc">metafisic</trd>
  <trd lng="pl">metafizyczny</trd>
  <trd lng="zh">&#24418;&#19978; <pr>x&iacute;ngsh&agrave;ng</pr></trd>
</drv>
</art>
