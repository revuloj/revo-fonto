<art mrk="$Id: insulin.xml,v 1.19 2026/10/02 12:08:40 revo Exp $">
<kap>
  <ofc>9</ofc><rad>insulin</rad>/o <fnt><bib>SPV</bib></fnt>
</kap>
<drv mrk="insulin.0o">
  <kap><tld/>o</kap>
  <snc mrk="insulin.0o.MED">
    <uzo tip="fak">KEM</uzo>
    <uzo tip="fak">MED</uzo>
    <dif>
      <ref tip="super" cel="hormon.0o">Hormono</ref>,
      kiu reguligas la karbonhidratan
      <ref tip="vid" cel="metabol.0o">metabolon</ref>:
      <ekz>
        programoj <klr>[&#x2026;]</klr> helpas la pacienton nombri karbonhidratojn ene de
        diversaj nutra&jcirc;oj a&ubreve; preskribas la necesan kvanton de <tld/>o por injekti
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2015/011367.php"
              >Noviga apliko je dispono de kuracistoj kaj pacientoj</url></vrk>
          <lok>2015</lok>
        </fnt>;
      </ekz>
      <ekz>
        statinoj povas male pliigi (kvankam ete) kromajn okazojn de diabeto (tipo 2),
        &ccirc;ar ili &scirc;ajnas provoki iuspecan reziston al <tld/>o
        <fnt>
          <bib>Monato</bib>
          <aut>Roberto Pigro</aut>
          <vrk><url ref="&Monato;/2013/011124.php"
              >Atentu la koron</url></vrk>
          <lok>2013</lok>
        </fnt>.
      </ekz>
    </dif>
  </snc>
  <trd lng="be">&c_ib;&c_n;&c_s;&c_u;&c_l;&c_ib;&c_n;</trd>
  <trd lng="ca">insulina</trd>
  <trd lng="cs">inzul&iacute;n</trd>
  <trd lng="cv">&c_i;&c_n;&c_s;&c_u;&c_l;&c_i;&c_n;</trd>
  <trd lng="de">Insulin</trd>
  <trd lng="en">insulin</trd>
  <trd lng="es">insulina</trd>
  <trd lng="fa">&a_A;&a_n;&a_s;&a_w;&a_l;&f_y;&a_n;</trd>
  <trd lng="fr">insuline</trd>
  <trd lng="hu">inzulin</trd>
  <trdgrp lng="ja">
    <trd>&#x30A4;&#x30F3;&#x30B7;&#x30E5;&#x30EA;&#x30F3;</trd>,
    <trd>&#x30A4;&#x30F3;&#x30B9;&#x30EA;&#x30F3;</trd>
  </trdgrp>
  <trd lng="nl">insuline</trd>
  <trd lng="pl">insulina</trd>
  <trd lng="pt">insulina</trd>
  <trd lng="ru">&c_i;&c_n;&c_s;&c_u;&c_l;&c_i;&c_n;</trd>
  <trd lng="sk">inzul&iacute;n</trd>
  <trd lng="uk">&c_ib;&c_n;&c_s;&c_u;&c_l;&c_ib;&c_n;</trd>
  <trd lng="zh">&#x80F0;&#x5C9B;&#x7D20; <pr>y&iacute;d&#x1CE;os&ugrave;</pr></trd>
</drv>
</art>
